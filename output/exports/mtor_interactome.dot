digraph mTOR {
  graph [rankdir=TB, splines=true, overlap=false, nodesep=0.25, ranksep=0.9, fontname="Helvetica", label="mTOR signalling interactome", labelloc=t, fontsize=18];
  node [style="filled", fontname="Helvetica", fontsize=9, penwidth=0.6, color="#898781"];
  edge [fontname="Helvetica", fontsize=7, penwidth=0.9, arrowsize=0.7, color="#898781"];
  "AKG" [label="alpha-Ketoglutarate", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="TCA-cycle intermediate produced by glutaminolysis; promotes GTP loading of RagB and lysosomal mTORC1 translocation, reportedly through prolyl hydroxylase activity."];
  "AMINO_ACIDS" [label="Amino acids (pool)", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Products of autophagolysosomal protein degradation that replenish lysosomal and cytosolic pools and reactivate mTORC1, making the autophagy-mTORC1 system oscillatory rather than switch-like."];
  "AMINO_ACID_STARVATION" [label="Amino-acid starvation", shape=invtrapezium, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Deprivation of one or more amino acids; beyond Rag/GATOR sensing it activates GCN2 via uncharged tRNA, driving ATF4-dependent Sestrin2 induction that sustains mTORC1 suppression."];
  "ARGININE" [label="Arginine", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Amino acid sensed in the cytosol by CASTOR1 and in the lysosomal lumen by SLC38A9; both routes converge on the Rag heterodimer."];
  "CHOLESTEROL" [label="Cholesterol (lysosomal)", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Lysosomal sterol pool that activates mTORC1 through an SLC38A9-NPC1 signalling complex; this arm is an emerging mechanism."];
  "GDP" [label="GDP", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Guanine nucleotide whose binding to RagC/D is required for the active, mTORC1-recruiting configuration of the Rag heterodimer."];
  "GLUTAMINE" [label="Glutamine", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Most abundant free amino acid; signals to mTORC1 both through Rag-independent Arf1-dependent routes and through glutaminolytic production of alpha-ketoglutarate."];
  "GTP" [label="GTP", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Guanine nucleotide whose binding to RagA/B produces the Raptor-binding competent state of the heterodimer."];
  "LEUCINE" [label="Leucine", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Branched-chain essential amino acid and the most potent single amino-acid activator of mTORC1; the ligand at the centre of the competing Sestrin2, LARS1, SAR1B and lysosomal-efflux sensing models."];
  "METHIONINE" [label="Methionine", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Essential amino acid and a well-established longevity-modifying dietary variable; signals to mTORC1 indirectly through its conversion to S-adenosylmethionine."];
  "SAM" [label="S-adenosylmethionine", shape=diamond, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Universal methyl donor whose cellular concentration tracks methionine availability; the direct ligand of SAMTOR."];
  "VAR_NPRL2_LOF" [label="NPRL2 loss-of-function variants", shape=invtriangle, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Loss-of-function NPRL2 variants removing the catalytic arginine-finger subunit of GATOR1, causing GATOR1-related focal epilepsy with cortical dysplasia."];
  "ANDROGEN" [label="Androgens", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Testosterone/DHT; via the androgen receptor increase mTORC1 activity in prostate cancer cells; AR and PI3K–AKT are reciprocally cross-regulated in PTEN-deficient prostate cancer."];
  "ESTROGEN" [label="Estrogen (17β-estradiol)", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Steroid hormone; via ERα engages non-genomic PI3K–AKT signalling and promotes survival/metastasis of TSC2-null cells (relevant to lymphangioleiomyomatosis)."];
  "IGF1" [label="IGF-1", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Insulin-like growth factor 1; growth-hormone-dependent ligand of IGF-1R that activates PI3K–AKT and mTORC1 (muscle hypertrophy, growth)."];
  "INFLAMMATION" [label="Chronic inflammation", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Inflammatory (NF-κB-axis) signalling that activates IKKβ, suppressing TSC1 and raising mTORC1 activity; proposed link between inflammation and anabolic dysregulation of ageing tissue."];
  "INSULIN" [label="Insulin", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Pancreatic β-cell peptide hormone; principal physiological ligand of INSR, driving IRS–PI3K–AKT signalling to TSC2/PRAS40 and thus mTORC1."];
  "LEPTIN" [label="Leptin", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Adipose-derived satiety hormone whose anorectic action requires intact hypothalamic mTOR signalling."];
  "MECHANICAL_LOAD" [label="Mechanical load", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Resistance exercise / eccentric contraction / stretch; activates mTORC1 in muscle through PLD–PA, membrane perturbation and focal-adhesion signalling, largely independently of ERK and PI3K."];
  "RESISTANCE_EXERCISE" [label="Resistance exercise / mechanical overload", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Mechanical loading of skeletal muscle (resistance exercise, overload, chronic stimulation) that activates mTORC1 through phospholipase D-derived phosphatidic acid, membrane perturbation and focal adhesion signalling."];
  "TNF" [label="TNFα", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Inflammatory cytokine that activates IKK-beta, which phosphorylates and suppresses TSC1, raising mTORC1 output; a molecular link between chronic inflammation and anabolic dysregulation."];
  "VAR_TBC1D7_LOF" [label="TBC1D7 loss of function", shape=invtriangle, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Biallelic truncating TBC1D7 variants causing macrocephaly/megalencephaly with intellectual disability and elevated mTORC1 signalling in patient cells."];
  "WNT" [label="Wnt ligands", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Canonical Wnt signalling inhibits GSK3, removing GSK3-dependent activation of TSC2 and thereby stimulating mTORC1 independently of β-catenin."];
  "A769662" [label="A-769662", shape=hexagon, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Thienopyridone direct AMPK activator binding the ADaM site at the alpha-kinase/beta-CBM interface; beta1-selective; allosterically activates AMPK and protects Thr172 from dephosphorylation."];
  "ADP" [label="ADP", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Adenosine diphosphate; binds AMPK gamma CBS sites and protects pThr172 from dephosphorylation without allosteric activation; physiologically relevant because cellular ADP exceeds AMP."];
  "AICAR" [label="AICAR (acadesine)", shape=hexagon, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Cell-permeable nucleoside converted to ZMP, an AMP mimetic that binds AMPK gamma and activates AMPK; classical experimental AMPK activator with known off-target effects."];
  "AMP" [label="AMP", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Adenosine monophosphate; rises disproportionately when ATP falls (adenylate kinase equilibrium) and is the primary low-energy signal that allosterically activates AMPK and promotes net Thr172 phosphorylation."];
  "ATP" [label="ATP", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Adenosine triphosphate; competes with AMP/ADP for AMPK gamma nucleotide sites, keeping AMPK inactive when energy charge is high."];
  "CALCIUM" [label="Ca2+ (cytosolic calcium)", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Lysosomal calcium released through TRPML1 into a local microdomain, activating calcineurin adjacent to the lysosomal surface."];
  "CALORIC_RESTRICTION" [label="Caloric restriction", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Sustained reduction in energy intake that lowers mTORC1 signalling; its effect on hepatic mTOR signalling is time-of-day dependent, so feeding schedule confounds comparison between dietary-restriction studies."];
  "DNA_DAMAGE" [label="DNA damage", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Genotoxic stress (ionising radiation, etoposide, ROS) activating ATM/ATR-CHK2 and p53; p53 transcriptional targets (sestrins, REDD1, PTEN, TSC2, AMPK beta1) collectively suppress mTORC1."];
  "ENERGY_STRESS" [label="Energy stress (high AMP/ATP)", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Any state in which ATP consumption exceeds production (glucose deprivation, hypoxia, mitochondrial inhibition, exercise), raising AMP/ADP:ATP and engaging the LKB1-AMPK checkpoint on mTORC1."];
  "ER_STRESS" [label="ER stress (unfolded protein response)", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Endoplasmic-reticulum stress; one of the two mechanisms (with suppressed autophagy) by which chronic mTORC1 hyperactivation drives beta-cell dedifferentiation and failure."];
  "EXERCISE" [label="Exercise", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Physical activity; endurance/contractile activity activates muscle AMPK (energy turnover), while resistance loading activates muscle mTORC1 through phosphatidic acid and mechanotransduction - opposite inputs by modality."];
  "FBP" [label="Fructose-1,6-bisphosphate", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Glycolytic intermediate whose concentration reports glucose availability. FBP occupancy of aldolase prevents the apo-aldolase conformation that nucleates the lysosomal v-ATPase–Ragulator–AXIN–LKB1 platform, so falling FBP activates AMPK before any change in the AMP:ATP ratio."];
  "GLUCOSE" [label="Glucose", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Principal energy substrate; glucose sufficiency is relayed to mTORC1 through Rag GTPases (largely AMPK-independent, DHAP proposed as the sensed glycolytic intermediate) and keeps AMPK inactive by sustaining ATP and FBP."];
  "GLUCOSE_DEPRIVATION" [label="Glucose deprivation", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Glucose withdrawal; activates AMPK through AMP/ADP rise and through an AMP-independent aldolase-FBP route at the lysosome, inhibits mTORC1 via Rag GTPases and HK2-Raptor binding, and induces REDD1 via ATF4."];
  "GLYCOGEN" [label="Glycogen", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Storage polysaccharide sensed directly by the carbohydrate-binding module of the AMPK β-subunit; branched glycogen with single α-1,6 branch points inhibits AMPK, coupling cellular carbohydrate reserves to the energy-sensing arm upstream of mTORC1."];
  "HYPOXIA" [label="Hypoxia", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Low oxygen tension; inhibits mTORC1 through HIF-1-driven REDD1 induction and TSC activation, through AMPK activation secondary to falling ATP, and through BNIP3-Rheb binding."];
  "OXIDATIVE_STRESS" [label="Oxidative stress (ROS)", shape=invtrapezium, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Reactive oxygen species (H2O2, mitochondrial ROS); activate cytoplasmic ATM-LKB1-AMPK, a peroxisomal TSC pool and AMPK (directly or via ATP depletion), collectively repressing mTORC1 and inducing autophagy."];
  "VAR_STRADA_LOF" [label="STRADA biallelic loss of function", shape=invtriangle, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Homozygous 7-kb LYK5/STRADA deletion (Old Order Mennonite founder) or other biallelic loss; impairs LKB1-AMPK signalling and causes PMSE syndrome with neuronal mTORC1 hyperactivation."];
  "LYSOSOMAL_STRESS" [label="Lysosomal stress", shape=invtrapezium, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Lysosomal damage or stress that triggers TRPML1-mediated local calcium release and calcineurin-dependent TFEB dephosphorylation. Together with mTORC1 inhibition, it is a trigger of TFEB nuclear entry."];
  "LIGHT" [label="Light (photic input)", shape=invtrapezium, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Photic signal reaching the suprachiasmatic nucleus via the retinohypothalamic tract; the dominant entraining stimulus for the central clock and an acute activator of SCN signalling cascades including mTORC1."];
  "SLEEP_DEPRIVATION" [label="Sleep deprivation", shape=invtrapezium, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Acute sleep loss"];
  "VAR_BMAL1_LOF" [label="Bmal1 loss of function (Bmal1-null)", shape=invtriangle, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Germline deletion of Bmal1 in mice: arrhythmic behaviour, elevated mTORC1 activity in multiple tissues and premature ageing phenotypes whose lifespan cost is substantially corrected by rapamycin."];
  "VAR_PER2_LOF" [label="PER2 loss of function (Per2-null)", shape=invtriangle, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Per2-deficient allele; the genetic test of PER2-dependent restraint of mTORC1 reported with reference [662]."];
  "AGEING" [label="Ageing", shape=invtrapezium, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Chronological ageing as an input: raises basal mTORC1 tone while attenuating acute responsiveness, impairs stress-responsive autophagy and drives immunosenescence."];
  "EXERCISE_RESISTANCE" [label="Resistance exercise / mechanical overload", shape=invtrapezium, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Mechanical loading of skeletal muscle; activates mTORC1 through phospholipase D-derived phosphatidic acid, membrane perturbation and focal adhesion signalling, and is the stimulus whose protein-synthetic response rapamycin blocks in humans."];
  "MTORC2_ACTIVATOR" [label="Small-molecule mTORC2 activator", shape=hexagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Unnamed small molecule reported in [280] to raise mTORC2 activity; enhances L-LTP and long-term memory in wild-type animals and reverses age-associated memory impairment in mice and flies."];
  "VAR_CLASS_DISTAL_NETWORK" [label="Distal-network lesion class", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Lesions raising flux into a branched network in which mTORC1 is one effector among several and AKT retains output to GSK3beta, FOXO and MDM2."];
  "VAR_CLASS_PROXIMAL_BRAKE" [label="Proximal-brake lesion class", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Lesions acting on or immediately above the kinase that remove a constitutive restraint and leave mTORC1 as the sole effector, creating genuine dependency."];
  "VAR_DEPDC5_LOF" [label="DEPDC5 loss-of-function", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Germline heterozygous loss-of-function variant in the GATOR1 component DEPDC5; in an open-label case series the three patients with DEPDC5 truncating/LoF variants responded to everolimus, whereas a DEPDC5 missense variant responded less and the single NPRL3 patient worsened."];
  "VAR_MTOR_E1799K" [label="MTOR E1799K", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Recurrent germline MTOR gain-of-function substitution accounting for roughly half of Smith–Kingsmore syndrome cases."];
  "VAR_MTOR_GOF" [label="MTOR gain-of-function (somatic mosaic)", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Germline activating MTOR substitutions causing Smith–Kingsmore syndrome (E1799K accounts for roughly half of cases); patient variants dampen cellular circadian amplitude as well as driving overgrowth and epilepsy."];
  "VAR_NPRL3_LOF" [label="NPRL3 loss-of-function", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Heterozygous germline loss of a GATOR1 subunit causing familial focal epilepsy; the single reported NPRL3 patient worsened on everolimus."];
  "VAR_STK11_LOF" [label="STK11 (LKB1) loss-of-function", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Germline (Peutz-Jeghers syndrome) or somatic (lung adenocarcinoma, cervical cancer) STK11 inactivation; removes AMPK Thr172 phosphorylation under energy stress and deregulates mTORC1."];
  "VAR_TSC1_LOF" [label="TSC1 loss-of-function", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Loss-of-function alteration of TSC1, a proximal-brake lesion; identified in exceptional responders to everolimus in urothelial carcinoma and present in roughly 8% of bladder cancers."];
  "VAR_TSC2_LOF" [label="TSC2 loss-of-function", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Germline (+ second hit) or somatic TSC2 loss; abolishes Rheb GAP activity; tuberous sclerosis, LAM, PEComa (AMPECT response enriched); proximal-brake lesion."];
  "ALPELISIB" [label="Alpelisib", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="PI3K-alpha-selective inhibitor; SOLAR-1 demonstrated benefit in a population prospectively selected for PIK3CA mutation, an example of genomic selection succeeding upstream of the mTOR node."];
  "APITOLISIB" [label="Apitolisib", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Dual class I PI3K and mTOR kinase inhibitor; clinical development limited by metabolic and general toxicity rather than by lack of target engagement."];
  "AZD8055" [label="AZD8055", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Potent, selective, orally bioavailable ATP-competitive mTOR kinase inhibitor active against both complexes; the chemical precursor of vistusertib."];
  "CAPIVASERTIB" [label="Capivasertib", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="ATP-competitive pan-AKT inhibitor; CAPItello-291 demonstrated benefit in AKT-pathway-altered breast cancer, the second upstream node at which genomic selection succeeded."];
  "CYCLOSPORINE" [label="Cyclosporine A", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Cyclic peptide immunosuppressant that binds cyclophilin A; the complex inhibits calcineurin. Comparator for the diabetogenic risk of mTOR inhibitors after transplantation."];
  "DACTOLISIB" [label="Dactolisib", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Imidazoquinoline dual pan-PI3K and mTOR kinase inhibitor developed partly to pre-empt feedback reactivation of AKT; limited clinically by a toxicity ceiling."];
  "DEXAMETHASONE" [label="Dexamethasone (topical)", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Corticosteroid used as a mouthwash to prevent rapalog-associated stomatitis (SWISH trial)."];
  "EVEROLIMUS" [label="Everolimus", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="First-generation allosteric rapalog, a 40-O-(2-hydroxyethyl) derivative of sirolimus. Pharmacokinetics (node attributes, not edges): oral bioavailability approximately 30%, half-life near 30 h; CYP3A4 and P-glycoprotein substrate, with brain accumulation restricted by ABCB1. Used at immunosuppressiv"];
  "KU0063794" [label="KU-0063794", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Selective ATP-competitive mTOR tool inhibitor that blocks both complexes without inhibiting related PI3K-family kinases at comparable concentrations."];
  "METFORMIN" [label="Metformin", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Biguanide antidiabetic; inhibits mitochondrial complex I (raising AMP/ADP), binds PEN2 to activate lysosomal AMPK at low doses, and also inhibits mTORC1 independently of AMPK via Rag GTPases and p53-REDD1."];
  "NAB_SIROLIMUS" [label="nab-Sirolimus", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Nanoparticle albumin-bound intravenous formulation of sirolimus, approved for advanced malignant perivascular epithelioid cell tumour on the AMPECT trial, where response was enriched in TSC2-mutant tumours."];
  "OSI027" [label="OSI-027", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="ATP-competitive mTOR kinase inhibitor with activity against mTORC1 and mTORC2; evaluated in early-phase oncology studies."];
  "PP242" [label="PP242", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="ATP-competitive mTOR active-site tool inhibitor used to define the rapamycin-resistant outputs of mTORC1 and mTORC2."];
  "RAPALINK1" [label="RapaLink-1", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="First bi-steric mTOR inhibitor: a rapamycin (FKBP12-binding) moiety tethered to an ATP-site moiety, achieving mTORC1 selectivity through FKBP12-mediated avidity and overcoming FRB resistance mutations."];
  "RAPAMYCIN" [label="Rapamycin (sirolimus)", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="First-generation allosteric rapalog. Binds FKBP12 with sub- to low-nanomolar affinity; the binary complex engages the FRB domain of assembled mTORC1. Pharmacokinetics (node attributes, not edges): oral bioavailability approximately 14% for the tablet formulation, terminal half-life near 62 h; CYP3A4"];
  "RIDAFOROLIMUS" [label="Ridaforolimus", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Non-prodrug rapalog with a phosphine oxide substituent at C43; investigated in sarcoma and other solid tumours but not approved."];
  "RMC5552" [label="RMC-5552", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Bi-steric mTORC1-selective inhibitor that fully suppresses 4E-BP1; phase 1 reported a complete response in PTEN/PIK3CA-altered endometrial cancer with treatment-related hyperglycaemia in only 4% of patients."];
  "RTB101" [label="RTB101", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="ATP-competitive PI3K/mTOR inhibitor (BEZ235/dactolisib) studied at low doses for immune function in older adults; the phase 3 respiratory-illness endpoint was not met."];
  "SAPANISERTIB" [label="Sapanisertib", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Second-generation ATP-competitive mTOR kinase inhibitor active against both mTORC1 and mTORC2, including the rapamycin-resistant 4E-BP1 sites."];
  "TACROLIMUS" [label="Tacrolimus (FK506)", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Macrolide immunosuppressant that binds FKBP12; the FKBP12-FK506 complex inhibits calcineurin rather than mTOR. Also used topically as mouthwash prophylaxis against mTOR-inhibitor mucositis."];
  "TEMSIROLIMUS" [label="Temsirolimus", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="First-generation rapalog given intravenously as a prodrug converted to sirolimus. CYP3A4 and P-glycoprotein substrate. Approved for advanced poor-prognosis renal cell carcinoma on the basis of the Global ARCC trial; also used as CCI-779 in preclinical neurodegeneration models."];
  "TORIN1" [label="Torin1", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="ATP-competitive mTOR kinase inhibitor that fully suppresses rapamycin-resistant 4E-BP1 Thr37/Thr46 phosphorylation and TOP mRNA translation."];
  "TORIN2" [label="Torin2", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Second-generation ATP-competitive mTOR kinase inhibitor and tool compound"];
  "VAR_FRB_RESISTANCE" [label="mTOR FRB resistance mutation", shape=invtriangle, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Substitutions in the FRB domain (the Ser2035 contact in the original yeast and mammalian studies; M2327I in a patient relapsing on a rapalog) that abolish FKBP12-rapamycin binding and confer resistance."];
  "VISTUSERTIB" [label="Vistusertib", shape=hexagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Second-generation ATP-competitive mTOR kinase inhibitor from the AZD8055 programme, with improved pharmaceutical properties; evaluated in several solid-tumour indications."];
  "CASTOR1" [label="CASTOR1", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Cellular arginine sensor for mTORC1; binds arginine through tandem ACT domains and in the apo state sequesters GATOR2."];
  "CASTOR2" [label="CASTOR2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="CASTOR paralogue that heterodimerises with CASTOR1 and binds GATOR2 but does not itself bind arginine with high affinity."];
  "EIF2AK4" [label="GCN2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Kinase activated by uncharged tRNA on amino-acid deprivation; drives ATF4 translation and thereby SESN2 induction, providing a slower transcriptional arm of amino-acid sensing."];
  "LARS1" [label="Leucyl-tRNA synthetase 1 (LARS1)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Cytoplasmic leucyl-tRNA synthetase proposed to act as a leucine-responsive RagD GAP; the assignment is contested because the yeast orthologue acts on the RagA/B counterpart with opposite polarity."];
  "MAT2A" [label="MAT2A (methionine adenosyltransferase 2A)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Enzyme converting methionine and ATP into S-adenosylmethionine; it generates the ligand actually sensed by SAMTOR, so methionine availability reaches mTORC1 only through MAT2A-produced SAM."];
  "NPC1" [label="NPC1", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Lysosomal cholesterol export protein that physically associates with SLC38A9; its loss traps cholesterol in the lumen and hyperactivates mTORC1."];
  "OGT" [label="O-GlcNAc transferase (OGT)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Sole enzyme adding O-linked GlcNAc from UDP-GlcNAc; the hexosamine pathway flux it reports is the proposed means by which glucose gates LARS1 function."];
  "SAMTOR" [label="SAMTOR", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="S-adenosylmethionine sensor (Kd about 7 uM) that, unlike Sestrin2 and CASTOR1, acts directly on the GATOR1-KICSTOR assembly, linking dietary methionine to mTORC1."];
  "SAR1B" [label="SAR1B", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="COPII-associated small GTPase reported to bind leucine and regulate mTORC1; a single-laboratory finding awaiting independent replication."];
  "SESN1" [label="Sestrin1", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Sestrin family member that binds GATOR2 and is a p53 target; expressed in a tissue-restricted pattern that may determine which leucine-sensing mechanism dominates in a given tissue."];
  "SESN2" [label="Sestrin2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Stress-inducible sestrin transcribed by p53 (DNA damage) and ATF4 (ER stress, amino-acid starvation via GCN2); apo-Sestrin2 sequesters GATOR2 to inhibit mTORC1 and was reported to activate AMPK; also a leucine sensor."];
  "SESN3" [label="Sestrin3", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Third Sestrin paralogue that also binds GATOR2; differential tissue expression across SESN1/2/3 underlies context-dependent leucine sensing."];
  "SLC1A5" [label="SLC1A5 (ASCT2)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Plasma-membrane glutamine importer whose accumulated glutamine is the exchange substrate that drives LAT1-mediated leucine uptake."];
  "SLC38A9" [label="SLC38A9", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Lysosomal transceptor: reports luminal arginine through its N-terminal domain, exports leucine and other essential amino acids to the cytosol, and cooperates with NPC1 to couple lysosomal cholesterol to mTORC1."];
  "SLC3A2" [label="SLC3A2 (CD98 heavy chain)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Heavy chain that disulphide-bonds to SLC7A5 to form the functional LAT1 transporter."];
  "SLC7A5" [label="SLC7A5 (LAT1 light chain)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Bidirectional plasma-membrane antiporter that couples glutamine efflux to leucine influx, supplying the cytosolic leucine pool read by the sensors."];
  "V_ATPASE" [label="Lysosomal v-ATPase", shape=box, style="filled,rounded", fillcolor="#cde2fb", color="#2a78d6", tooltip="Vacuolar H+-ATPase that acidifies the lysosome and undergoes amino-acid-dependent conformational change, relaying luminal amino-acid content outward to Ragulator - the inside-out sensing mechanism."];
  "AR" [label="Androgen receptor", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Nuclear receptor whose activation raises mTORC1 output and cyclin D translation in prostate cancer; reciprocal feedback with PI3K–AKT (PTEN loss)."];
  "EGFR" [label="EGFR", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Epidermal growth factor receptor; activates PI3K mainly via GAB1 (and ERBB3 heterodimers) and Ras via GRB2–SOS; frequently amplified/mutated in cancer."];
  "ESR1" [label="Estrogen receptor α", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Nuclear receptor phosphorylated by S6K1 at Ser167, giving ligand-independent transcriptional activity."];
  "IGF1R" [label="IGF-1 receptor", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Receptor tyrosine kinase for IGF-1. Reported to be tyrosine-phosphorylated and activated by the intrinsic tyrosine kinase activity of mTOR within mTORC2, constituting a feed-forward arm from mTORC2 back onto the receptor tier. NOTE: this node may already exist in the growth_factor_input module; the "];
  "INSR" [label="Insulin receptor", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="α2β2 receptor tyrosine kinase; insulin binding triggers β-subunit autophosphorylation and IRS recruitment. Target of Grb10-mediated mTORC1 feedback."];
  "IRS1" [label="IRS-1", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Insulin receptor substrate 1; tyrosine-phosphorylated docking protein whose pYXXM motifs recruit p85–PI3K. Inhibitory serine phosphorylation by S6K1 is the classical mTORC1 negative-feedback arm."];
  "NF1" [label="Neurofibromin (NF1)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Ras GAP; its loss raises Ras·GTP and ERK/RSK input to TSC2. NF1 loss is a recurrent cancer lesion in this pathway."];
  "PHOSPHATIDIC_ACID" [label="Phosphatidic acid", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Phospholipase D product that binds the FRB domain of mTOR in competition with FKBP12-rapamycin and promotes complex stability and signalling; a mechanical/nutrient-responsive lipid input."];
  "PI3K" [label="Class I PI3K (p110α/p85)", shape=box, style="filled,rounded", fillcolor="#fde1d6", color="#eb6834", tooltip="Class IA phosphoinositide 3-kinase: p110α catalytic (PIK3CA) with p85 regulatory subunit; converts PIP2 to PIP3 on RTK/IRS/Ras input. PIK3CA hotspot mutations are frequent distal-network cancer lesions."];
  "PIK3R1" [label="p85α (PIK3R1)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Regulatory subunit of class IA PI3K; stabilises p110, restrains its basal activity via nSH2/iSH2 contacts, and relieves that inhibition when its SH2 domains bind pYXXM motifs."];
  "PIP2" [label="PI(4,5)P2", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Phosphatidylinositol 4,5-bisphosphate; plasma-membrane substrate of class I PI3K and product of PTEN."];
  "PIP3" [label="PI(3,4,5)P3", shape=diamond, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Phosphatidylinositol-3,4,5-trisphosphate generated by PI3K; bound by the mSin1 PH domain, relieving its autoinhibition of mTORC2 and recruiting the complex to the plasma membrane."];
  "PLD1" [label="Phospholipase D1", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Phospholipase D isoform generating phosphatidic acid after mechanical stimulation of muscle; proposed mechanical input to mTORC1."];
  "PTEN" [label="PTEN", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="PIP3 3-phosphatase and tumour suppressor; the main negative regulator of PI3K–AKT. Loss (prostate, GBM, endometrium) raises PIP3/AKT flux; it acts as a distal-network lesion."];
  "RAS" [label="Ras (K/H/N-Ras)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Small GTPase activated by RTK–GRB2–SOS; Ras·GTP recruits RAF (ERK cascade) and binds the p110α RBD; its pathway converges on TSC2 and Raptor to raise mTORC1 output."];
  "RTK" [label="Receptor tyrosine kinases (generic)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Growth-factor receptors (EGFR, ERBB2, PDGFR, MET, FGFR etc.) whose autophosphorylated tyrosines recruit PI3K (directly or via adaptors) and GRB2–SOS to Ras. Amplification converges on PI3K in cancer."];
  "ALDOA" [label="Aldolase A", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Glycolytic aldolase acting as a glucose sensor: when not occupied by fructose-1,6-bisphosphate it signals through the lysosomal v-ATPase to assemble the AXIN-LKB1-AMPK module and suppress Ragulator-dependent mTORC1 activation."];
  "ATP6AP1" [label="ATP6AP1 (v-ATPase accessory subunit 1)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Accessory subunit of the lysosomal v-ATPase and the binding partner of PEN2 in the low-dose metformin route; the PEN2–ATP6AP1 interaction inhibits v-ATPase and triggers lysosomal AMPK activation without a fall in cellular ATP."];
  "AXIN1" [label="AXIN1", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Scaffold that, under low energy or glucose, tethers LKB1 to AMPK (AXIN-AMPK-LKB1 complex) and to v-ATPase-Ragulator at the lysosome, while blocking Ragulator GEF activity toward RagA/B to switch mTORC1 off."];
  "CAB39" [label="MO25-alpha (CAB39)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Armadillo-repeat scaffold that binds the C-terminus of STRADA and stabilises the LKB1-STRADA-MO25 heterotrimer, increasing LKB1 activity about 10-fold beyond STRADA alone."];
  "CAMKK2" [label="CaMKK2 (CaMKK-beta)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Ca2+/calmodulin-dependent kinase kinase that phosphorylates AMPK Thr172 in response to rises in cytosolic Ca2+, independently of LKB1 and of the AMP:ATP ratio."];
  "EGLN1" [label="PHD2 (EGLN1)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Prolyl-4-hydroxylase domain protein 2, the principal cellular oxygen sensor. Uses O2 and 2-oxoglutarate to hydroxylate HIF-1α at Pro402/Pro564, creating the pVHL recognition site; hypoxia inactivates it, stabilising HIF-1α and inducing REDD1 and BNIP3."];
  "EIF2AK3" [label="PERK (EIF2AK3)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="ER-resident eIF2alpha kinase activated by unfolded proteins (BiP release); phosphorylates eIF2alpha Ser51 to launch the integrated stress response and ATF4 translation."];
  "LKB1_COMPLEX" [label="LKB1-STRADA-MO25 complex", shape=box, style="filled,rounded", fillcolor="#fde1d6", color="#eb6834", tooltip="Heterotrimeric, constitutively active AMPK upstream kinase complex; AMP binding to AMPK gamma makes AMPK a better substrate rather than activating LKB1 itself. Also recruited to lysosomes by AXIN under glucose starvation."];
  "MITOCHONDRIAL_COMPLEX_I" [label="Mitochondrial complex I (NADH dehydrogenase)", shape=box, style="filled,rounded", fillcolor="#fde1d6", color="#eb6834", tooltip="Entry point of the respiratory chain (approximately 45 subunits); its inhibition by metformin/phenformin or by hypoxia-limited respiration lowers ATP and raises AMP/ADP, activating AMPK."];
  "PEN2" [label="PEN2 (PSENEN)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Gamma-secretase subunit identified as the direct low-dose metformin binding protein; metformin-bound PEN2 engages ATP6AP1 to inhibit v-ATPase, triggering AXIN-LKB1 recruitment and lysosomal AMPK activation."];
  "PEX5" [label="PEX5 (peroxisomal import receptor)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Peroxisomal targeting-signal receptor reported to bind TSC1/TSC2 and localise a TSC complex pool to peroxisomes, where ROS activate TSC2 to repress mTORC1 and trigger autophagy."];
  "STK11" [label="LKB1 (STK11)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Constitutively active master upstream kinase that phosphorylates AMPK Thr172 (and 12 AMPK-related kinases); requires STRADA and MO25 for activity and cytoplasmic localisation. Tumour suppressor lost in Peutz-Jeghers syndrome."];
  "STRADA" [label="STRAD-alpha (STRADA)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Pseudokinase that binds the LKB1 kinase domain, induces its active conformation and retains LKB1 in the cytoplasm. Biallelic loss causes PMSE syndrome with impaired LKB1-AMPK signalling and neuronal mTORC1 hyperactivation."];
  "GLS" [label="glutaminase", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Mitochondrial glutaminase catalysing the first step of glutaminolysis (glutamine to glutamate), upstream of glutamate dehydrogenase and of alpha-ketoglutarate-dependent Rag GTP loading."];
  "VAR_NF1_LOF" [label="NF1 loss-of-function", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Loss of the Ras GAP neurofibromin, raising RAS-ERK-RSK flux onto the TSC complex; one of the lesions enrolled in the negative everolimus basket study."];
  "VAR_PIK3CA_GOF" [label="PIK3CA activating mutation", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Helical (E542K, E545K) and kinase (H1047R/L) hotspot gain-of-function mutations in ~30–40% of breast and 30% of endometrial cancers; distal-network lesion."];
  "VAR_PTEN_LOF" [label="PTEN loss", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Loss of the PIP3 phosphatase; roughly 30% of prostate, 40% of glioblastoma and 35% of endometrial cancers, and germline in PTEN hamartoma tumour syndrome."];
  "VAR_RTK_AMP" [label="Receptor tyrosine kinase amplification", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Amplification of receptor tyrosine kinases converging on PI3K; distal-network lesion with low predicted mTORC1 dependency."];
  "ABCB1" [label="ABCB1 (P-glycoprotein)", shape=ellipse, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="ATP-binding cassette efflux transporter at the gut and blood-brain barrier; sirolimus and everolimus are substrates, which limits oral bioavailability and CNS exposure."];
  "CYP3A4" [label="CYP3A4", shape=ellipse, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Principal oxidative metabolising enzyme for sirolimus and everolimus; the basis of extensive drug-drug interaction potential and of therapeutic drug monitoring in transplantation."];
  "FKBP12" [label="FKBP12", shape=ellipse, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="12 kDa peptidyl-prolyl isomerase immunophilin; its yeast orthologue FPR1 emerged from the original rapamycin-resistance screen. Binds rapamycin, and the binary complex then engages the mTOR FRB domain."];
  "FKBP12_RAPAMYCIN" [label="FKBP12-rapamycin complex", shape=box, style="filled,rounded", fillcolor="#fbd9d8", color="#e34948", tooltip="Binary complex of rapamycin with its intracellular receptor FKBP12; this composite surface, not either partner alone, is the species that binds the FRB domain of mTOR and inhibits mTORC1."];
  "PPIA" [label="Cyclophilin A (PPIA)", shape=ellipse, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="The cyclosporine-cyclophilin A binary complex inhibits calcineurin; cyclophilin A has no role in rapalog action. Required to represent why cyclosporine causes post-transplant diabetes by a mechanism distinct from that of sirolimus."];
  "ARF1" [label="Arf1", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="ADP-ribosylation factor 1, required for glutamine-induced activation of mTORC1 by a route that does not require the Rag GTPases."];
  "C12ORF66" [label="C12orf66", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="KICSTOR subunit required for the integrity of the KICSTOR-GATOR1 assembly."];
  "DEPDC5" [label="DEPDC5", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Largest GATOR1 subunit; binds the Rag heterodimer through its SABA/SHEN domains and inhibits mTORC1 independently of catalysis. Loss-of-function variants cause familial focal epilepsy."];
  "FLCN" [label="Folliculin (FLCN)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Tumour suppressor with a longin GAP domain; with FNIP1/2 provides the GAP activity for RagC/D. Mutated in Birt-Hogg-Dube syndrome."];
  "FLCN_FNIP" [label="FLCN-FNIP complex", shape=box, style="filled,rounded", fillcolor="#cde2fb", color="#2a78d6", tooltip="GTPase-activating complex for RagC/D; drives the heterodimer into the RagA/B.GTP-RagC/D.GDP state and is required in particular for mTORC1 phosphorylation of TFEB/TFE3."];
  "FNIP1" [label="FNIP1", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Folliculin-interacting protein that heterodimerises with FLCN to form the active RagC/D GAP; also reported to bind AMPK."];
  "FNIP2" [label="FNIP2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Paralogue of FNIP1 that forms an equivalent FLCN-FNIP2 GAP complex."];
  "GATOR1" [label="GATOR1 (DEPDC5-NPRL2-NPRL3)", shape=box, style="filled,rounded", fillcolor="#cde2fb", color="#2a78d6", tooltip="Trimeric GTPase-activating protein for RagA/B and therefore a negative regulator of mTORC1, active when amino acids are scarce; a tumour suppressor and the locus of familial focal epilepsies."];
  "GATOR2" [label="GATOR2", shape=box, style="filled,rounded", fillcolor="#cde2fb", color="#2a78d6", tooltip="Octameric positive regulator of mTORC1 containing WDR24, WDR59, MIOS, SEH1L and SEC13; acts by inhibiting GATOR1 and is the common hub on which the Sestrin and CASTOR sensors converge."];
  "ITFG2" [label="ITFG2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="KICSTOR subunit required for assembly of the scaffold that localises GATOR1 to the lysosome."];
  "KICSTOR" [label="KICSTOR", shape=box, style="filled,rounded", fillcolor="#cde2fb", color="#2a78d6", tooltip="Tetrameric scaffold (KPTN, ITFG2, C12orf66, SZT2) that recruits GATOR1 to the lysosomal surface and is required for nutrients to regulate mTORC1; non-redundant in humans."];
  "KPTN" [label="KPTN (kaptin)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="KICSTOR subunit; biallelic loss causes a macrocephaly-intellectual disability syndrome consistent with mTORC1 disinhibition."];
  "LAMTOR1" [label="LAMTOR1 (p18)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Lipid-anchored Ragulator subunit whose N-terminal myristoylation and palmitoylation tether the entire complex to the lysosomal membrane; also contacts the v-ATPase."];
  "LAMTOR2" [label="LAMTOR2 (p14)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Roadblock-domain Ragulator subunit; forms a heterodimer with LAMTOR3 that contacts the Rag roadblock domains."];
  "LAMTOR3" [label="LAMTOR3 (MP1)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Roadblock-domain Ragulator subunit partnering LAMTOR2; originally characterised as a MEK1/ERK scaffold."];
  "LAMTOR4" [label="LAMTOR4 (C7orf59)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Roadblock-domain Ragulator subunit forming a heterodimer with LAMTOR5 that engages the Rag GTPase roadblock domains."];
  "LAMTOR5" [label="LAMTOR5 (HBXIP)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Roadblock-domain Ragulator subunit partnering LAMTOR4 within the pentameric complex."];
  "MIOS" [label="MIOS", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="GATOR2 subunit (missing oocyte homologue) whose beta-propeller forms part of the binding surface for the amino-acid sensors Sestrin2 and CASTOR1."];
  "NPRL2" [label="NPRL2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="GATOR1 subunit carrying the longin domain that supplies the catalytic arginine finger for GAP activity toward RagA/B."];
  "NPRL3" [label="NPRL3", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="GATOR1 subunit bridging NPRL2 and DEPDC5 and contributing to Rag binding; mutated in focal epilepsy."];
  "RAB1A" [label="Rab1A", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Golgi-resident Rab GTPase reported to be required for amino-acid-dependent mTORC1 activation and to interact with Rheb; amplified in colorectal cancer."];
  "RAGULATOR" [label="Ragulator (LAMTOR1-5)", shape=box, style="filled,rounded", fillcolor="#cde2fb", color="#2a78d6", tooltip="Lysosomal pentamer anchoring the Rag heterodimer and acting as RagA/B GEF; with v-ATPase it also docks AXIN-LKB1 for lysosomal AMPK activation under glucose starvation, serving as a catabolism/anabolism switch."];
  "RNF152" [label="RNF152", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Lysosome-associated RING-finger E3 ligase reported to K63-ubiquitinate Rheb, increasing its affinity for TSC2 and restraining Rheb–mTORC1 in the absence of growth factors."];
  "RUVBL1" [label="RUVBL1 (Pontin)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="AAA+ ATPase that, with RUVBL2, joins the TTT (Tel2-Tti1-Tti2) complex to form the TTT-RUVBL1/2 co-chaperone promoting mTORC1 dimerisation and lysosomal localisation."];
  "RUVBL2" [label="RUVBL2 (Reptin)", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="AAA+ ATPase partner of RUVBL1 in the TTT-RUVBL1/2 module that chaperones newly synthesised PIKKs including mTOR."];
  "SEC13" [label="SEC13", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="WD40 GATOR2 subunit also found in the COPII coat and the nuclear pore complex; a structural element of GATOR2."];
  "SEH1L" [label="SEH1L", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="WD40 GATOR2 subunit shared with the nuclear pore Nup107-160 complex; stabilises the GATOR2 assembly."];
  "SH3BP4" [label="SH3BP4", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="SH3-domain binding protein that interacts with the inactive Rag heterodimer under amino-acid starvation and prevents formation of the active, mTORC1-recruiting state."];
  "SKP2" [label="SKP2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="SCF E3 ligase substrate-recognition subunit reported to K63-ubiquitinate RagA, promoting GATOR1 binding as a brake on amino-acid-driven mTORC1 hyperactivation."];
  "SZT2" [label="SZT2", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Very large KICSTOR subunit that binds GATOR1 directly and dictates GATOR control of mTORC1; biallelic mutation causes an infantile encephalopathy with epilepsy and dysmorphic corpus callosum."];
  "VAR_FLCN_LOF" [label="FLCN loss-of-function", shape=invtriangle, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Germline loss-of-function variants in folliculin, abolishing RagC/D GAP activity and dysregulating mTORC1 in a tissue-dependent rather than uniformly increased manner."];
  "VAR_SZT2_LOF" [label="SZT2 loss-of-function (biallelic)", shape=invtriangle, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Biallelic SZT2 loss-of-function variants that disable the KICSTOR scaffold; the clinical proof that this scaffold is non-redundant in humans."];
  "WDR24" [label="WDR24", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="GATOR2 subunit with a beta-propeller and zinc-finger; required for GATOR2 to relieve GATOR1 inhibition and part of the sensor-binding surface."];
  "WDR59" [label="WDR59", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="GATOR2 subunit with beta-propeller and RING-like domains; contributes to the GATOR2 scaffold that contacts GATOR1."];
  "AKT" [label="AKT (PKB)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Central PI3K effector held in check by mTORC1-driven feedback (S6K1-IRS-1, Grb10, S6K1-Rictor); relief of this feedback on mTORC1 inhibition produces the clinically important AKT rebound."];
  "AKT3" [label="AKT3", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Brain-enriched AKT isoform; somatic mosaic activating AKT3 variants confined to malformed cortex cause hemimegalencephaly and focal cortical dysplasia type II."];
  "CSNK1A1" [label="CK1alpha", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Priming kinase that phosphorylates mTOR-primed DEPTOR to create the βTrCP degron; the missing step between mTORC1 phosphorylation of DEPTOR and its βTrCP-dependent destruction."];
  "DGKZ" [label="DGKζ (diacylglycerol kinase ζ)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Diacylglycerol kinase whose PLD-independent production of phosphatidic acid is required for mechanical-load activation of mTORC1 in skeletal muscle."];
  "ERK" [label="ERK1/2", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Photic signal transducer in SCN neurons; the MEK–ERK arm that couples light to mTORC1 activity (S6K1 and 4E-BP1 phosphorylation) in the central clock. Shared node — likely already defined in growth_factor_input."];
  "FARNESYLTRANSFERASE" [label="Farnesyltransferase", shape=box, style="filled,rounded", fillcolor="#fde1d6", color="#eb6834", tooltip="Prenylates the Rheb CAAX motif (Cys181); farnesylation is required for Rheb membrane localisation and mTORC1 activation."];
  "GRB2" [label="GRB2", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="SH2–SH3 adaptor that binds phosphotyrosines on activated receptor tyrosine kinases (directly on EGFR; via SHC or IRS-1 for the insulin and IGF-1 receptors) and brings the Ras GEF SOS1 to the membrane."];
  "GSK3B" [label="GSK3β", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Constitutively active kinase inhibited by AKT at Ser9; one of the AKT substrates that remains substantially phosphorylated when AKT carries Thr308 alone. Also phosphorylates Rictor, feeding back onto mTORC2."];
  "HERC1" [label="HERC1", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="HECT/RLD-domain E3 ubiquitin ligase reported to bind and ubiquitinate TSC2 when TSC2 is not protected by TSC1."];
  "IKBKB" [label="IKKβ", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Inhibitor of NF-kB kinase beta; downstream of TNF it phosphorylates TSC1 Ser487/Ser511, suppressing TSC1 and activating mTORC1 and VEGF-driven angiogenesis."];
  "MAPK14" [label="p38α MAPK", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Stress-activated MAPK; one of the two upstream activators of MNK1 and therefore of eIF4E Ser209 phosphorylation."];
  "MAPKAPK2" [label="MK2", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Kinase whose translation is controlled by mTOR; MK2 stabilises SASP transcripts via ZFP36L1, the second documented translational route from mTORC1 to the SASP."];
  "MEK" [label="MEK1/2", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Dual-specificity MAP2Ks that phosphorylate ERK1/2 on the TEY motif."];
  "PDK1" [label="PDK1", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="3-Phosphoinositide-dependent kinase 1; constitutively active PH-domain kinase that phosphorylates the activation loop of AKT (Thr308), RSK (NTKD) and S6K1 once PIP3 brings substrate and kinase together."];
  "PHLPP" [label="PHLPP1/2", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="PH-domain leucine-rich repeat protein phosphatases that dephosphorylate AKT Ser473 (hydrophobic motif), terminating mTORC2-dependent AKT activation."];
  "PP2A" [label="PP2A (B55α holoenzyme)", shape=box, style="filled,rounded", fillcolor="#fde1d6", color="#eb6834", tooltip="Protein phosphatase 2A; the B55α-containing holoenzyme dephosphorylates AKT Thr308, opposing PDK1."];
  "PRKDC" [label="DNA-PKcs", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="DNA-dependent protein kinase catalytic subunit; alternative, mTORC2-independent AKT Ser473 kinase after DNA double-strand breaks."];
  "RAF" [label="RAF kinases", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Ras-effector MAP3Ks that phosphorylate and activate MEK1/2."];
  "RSK" [label="p90 RSK", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="p90 ribosomal S6 kinase downstream of ERK; phosphorylates Raptor at an activating cluster and contributes to DEPTOR phosphodegron formation, linking RAS-pathway activation to mTORC1 output."];
  "SOS1" [label="SOS1 (Son of sevenless 1)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Ras guanine-nucleotide exchange factor held by GRB2 and relocated to activated receptors, where it loads Ras with GTP."];
  "TBC1D7" [label="TBC1D7", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Third subunit of the TSC complex (1 copy per 2:2 TSC1–TSC2); bridges TSC1 coiled-coils and stabilises TSC1–TSC2 association."];
  "TPT1" [label="TCTP", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Translationally controlled tumour protein; proposed Rheb GEF in Drosophila, not supported by later biochemical work (contested)."];
  "TSC1" [label="TSC1 (hamartin)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Scaffold subunit of the TSC complex stabilising TSC2; phosphorylated at Ser487/Ser511 by IKK-beta, which suppresses the complex and raises mTORC1 under TNF/inflammatory signalling."];
  "TSC2" [label="TSC2 (tuberin)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="GAP subunit of the TSC1-TSC2-TBC1D7 complex acting on Rheb. Activated by AMPK (Ser1387/Ser1345) and GSK3 phosphorylation, released from 14-3-3 by REDD1, inhibited by AKT/ERK/RSK phosphorylation; a p53 transcriptional target."];
  "TSC_COMPLEX" [label="TSC complex (TSC1–TSC2–TBC1D7)", shape=box, style="filled,rounded", fillcolor="#fde1d6", color="#eb6834", tooltip="Rheb GAP complex; recruited to the lysosomal surface in a Rag-dependent manner on amino-acid withdrawal, providing a second arm of amino-acid control over mTORC1 that acts on Rheb rather than on recruitment."];
  "AMPK" [label="AMPK (AMP-activated protein kinase)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Second catalytic α-subunit isoform of AMPK, carrying the activation-loop Thr172. Predominant α-isoform in skeletal muscle, heart and liver and the isoform most relevant to exercise, metformin and the inhibitory mTORC1 phosphorylation at Ser345."];
  "ATM" [label="ATM kinase", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="PIKK-family DNA-damage sensor kinase (activated by MRN at double-strand breaks and, independently, by direct oxidation under ROS); phosphorylates p53 Ser15 and signals via LKB1-AMPK-TSC2 to repress mTORC1."];
  "BNIP3" [label="BNIP3", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="HIF-1-induced BH3-only mitochondrial protein mediating hypoxic mitophagy; reported to bind Rheb and reduce its GTP loading, inhibiting mTORC1 independently of TSC2."];
  "DDIT4" [label="REDD1 (DDIT4)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Stress-induced inhibitor of mTORC1 acting through the TSC complex; its transcript is rhythmically expressed in mouse peripheral tissues, offering a candidate clock-to-mTORC1 transcriptional route."];
  "EIF2S1" [label="eIF2alpha (EIF2S1)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Alpha subunit of eIF2; Ser51 phosphorylation by PERK/GCN2/PKR/HRI lowers ternary-complex availability, repressing global initiation while selectively increasing ATF4 translation."];
  "PPM1A" [label="PP2Cα (PPM1A)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Mg2+/Mn2+-dependent protein phosphatase 2C family member that dephosphorylates AMPK Thr172 and terminates AMPK signalling; AMP binding to the γ-subunit protects Thr172 from this dephosphorylation, which is a major component of allosteric AMPK activation."];
  "PRKAB1" [label="AMPK beta1 (scaffold subunit)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Beta subunit of AMPK: myristoylated scaffold bridging alpha and gamma, carries the carbohydrate-binding module (glycogen sensing) and forms the ADaM drug-binding site with the alpha kinase domain. beta2 (PRKAB2) is the muscle paralogue."];
  "PRKAG1" [label="AMPK gamma1 (nucleotide-sensing subunit)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Gamma subunit of AMPK with four CBS motifs binding AMP, ADP or ATP competitively at sites 1 and 3; occupancy by AMP/ADP drives allosteric activation and protects pThr172 from phosphatases. gamma2/gamma3 paralogues exist."];
  "TP53" [label="p53", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Stress-activated transcription factor; after DNA damage or AMPK phosphorylation (Ser15) induces SESN1/2, DDIT4, PTEN, TSC2 and AMPK beta1, forming a coordinated brake on IGF-1/AKT/mTORC1 signalling."];
  "VHL" [label="pVHL (VHL)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Substrate-recognition component of the CUL2–elongin BC E3 ubiquitin ligase that binds prolyl-hydroxylated HIF-1α and targets it for proteasomal degradation in normoxia."];
  "CDC37" [label="Cdc37", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Kinase-specific Hsp90 co-chaperone that delivers client protein kinases, including PIKK-family members, to the Hsp90 cycle."];
  "HSP90AA1" [label="Hsp90", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="ATP-dependent chaperone that, with the TTT/R2TP machinery and the kinase-specific co-chaperone Cdc37, matures newly synthesised mTOR; Hsp90 inhibition destabilises mTOR and reduces mTORC1 signalling."];
  "TELO2" [label="Tel2", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Core subunit of the TTT (Tel2-Tti1-Tti2) co-chaperone module that binds nascent PIKKs including mTOR and, with R2TP/Hsp90, governs their folding, stability and assembly into complexes."];
  "TTI1" [label="Tti1", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Tel2-interacting protein 1; with Tel2 and Tti2 forms the TTT module required for mTOR protein stability and for assembly of both mTORC1 and mTORC2."];
  "TTI2" [label="Tti2", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Third TTT subunit; biallelic TTI2 variants cause intellectual disability, consistent with a non-redundant role in PIKK stability in humans."];
  "TTT_COMPLEX" [label="TTT complex (Tel2-Tti1-Tti2)", shape=box, style="filled,rounded", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Trimeric PIKK-dedicated co-chaperone that works with R2TP/Hsp90 to fold newly synthesised mTOR and promote its incorporation into mTORC1 and mTORC2."];
  "PIK3C3" [label="VPS34", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Class III PI3-kinase proposed as an amino-acid-responsive activator of mTORC1 in parallel with the Rag route; the assignment conflicts with its established pro-autophagic role and is contested."];
  "PER2" [label="PER2 (Period 2)", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Negative-limb clock protein. Beyond transcriptional repression of CLOCK–BMAL1, PER2 binds TSC1 and recruits it to the mTORC1 complex, suppressing mTORC1 in a time-of-day-dependent manner."];
  "VAR_AKT1_GOF" [label="AKT1 activating mutation", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="PH-domain E17K substitution causing constitutive membrane localisation and activation of AKT1 (breast, colorectal, ovarian cancers); distal-network lesion."];
  "VAR_AKT3_GOF" [label="AKT3 activating mutation", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Somatic mosaic gain-of-function AKT3 variants confined to malformed cortex cause hemimegalencephaly and focal cortical dysplasia type II."];
  "VAR_NF2_LOF" [label="NF2 loss of function", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Loss-of-function NF2 (merlin) variant; co-occurred with the TSC1 lesion in the index everolimus exceptional responder and was one of the five selection genes in the negative prospective basket study."];
  "LYSOSOME" [label="Lysosome", shape=component, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Organelle whose cytosolic surface is the platform for mTORC1 activation and whose lumen is the compartment sampled by the inside-out amino-acid sensing machinery; its dysfunction is an upstream cause of mTOR dysregulation."];
  "RAG_HETERODIMER" [label="Rag GTPase heterodimer (RagA/B-RagC/D)", shape=box, style="filled,rounded", fillcolor="#cde2fb", color="#2a78d6", tooltip="Obligate heterodimer recruiting mTORC1 to the lysosome; relays glucose as well as amino-acid sufficiency to mTORC1 largely independently of AMPK, and mediates AMPK-independent mTORC1 inhibition by metformin."];
  "RRAGA" [label="RagA", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Rag GTPase that, loaded with GTP, confers Raptor binding on the heterodimer. Target of GATOR1 GAP activity and of Ragulator/SLC38A9 GEF activity."];
  "RRAGB" [label="RagB", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Paralogue of RagA with equivalent function; GTP-loaded RagB binds Raptor and is the substrate of GATOR1 GAP activity."];
  "RRAGC" [label="RagC", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Rag GTPase that must be GDP-loaded for the active heterodimer configuration; substrate of the FLCN-FNIP GAP and determinant of substrate-specific mTORC1 signalling to TFEB."];
  "RRAGD" [label="RagD", shape=ellipse, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Paralogue of RagC; GDP-loaded RagD supports the active heterodimer. Proposed substrate of LARS1 GAP activity in the contested leucine-sensing model."];
  "FKBP8" [label="FKBP38 (FKBP8)", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Proposed endogenous mTORC1 inhibitor displaced by Rheb·GTP; the model is contested because independent laboratories did not reproduce it."];
  "RHEB" [label="Rheb", shape=ellipse, style="filled", fillcolor="#fde1d6", color="#eb6834", tooltip="Small GTPase resident on lysosomal/endomembrane surfaces; GTP-loaded Rheb binds the mTOR kinase domain and allosterically activates it, making lysosomal co-localisation the point of pathway convergence."];
  "AKT1S1" [label="PRAS40", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Substoichiometric mTORC1 inhibitor carrying its own TOS motif; competes with substrates for the Raptor recognition surface. AKT phosphorylation at Thr246 releases it, giving feed-forward derepression by growth factors."];
  "CUL1" [label="Cullin-1", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Scaffold subunit of the SCF E3 ubiquitin ligase that degrades DEPTOR."];
  "DEPTOR" [label="DEPTOR", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Tandem DEP-domain plus PDZ-domain inhibitory subunit of both mTORC1 and mTORC2; binds the mTOR FAT region. Phosphorylated by active mTOR and by S6K1/RSK/CK1alpha, then degraded via SCF-betaTrCP, so active mTOR removes its own brake."];
  "FBXW11" [label="beta-TrCP2 (FBXW11)", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Second beta-TrCP paralogue; redundant with BTRC as the substrate-recognition subunit for the DEPTOR phosphodegron."];
  "SCF_BTRC" [label="SCF(beta-TrCP) E3 ubiquitin ligase", shape=box, style="filled,rounded", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Cullin-RING ligase (SKP1-CUL1-RBX1 with the F-box receptor beta-TrCP1/2) that recognises the phosphodegron of DEPTOR and targets it for proteasomal destruction, creating a positive-feedback loop on mTOR activity."];
  "SKP1" [label="SKP1", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Adaptor linking CUL1 to the F-box protein beta-TrCP in the SCF ligase acting on DEPTOR."];
  "MAM_ER_MITOCHONDRIA" [label="Mitochondria-associated ER membranes", shape=component, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="ER–mitochondria contact sites hosting a distinct pool of mTORC2–AKT signalling that controls MAM integrity, calcium transfer and mitochondrial physiology."];
  "PLASMA_MEMBRANE" [label="Plasma membrane", shape=component, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Site at which PIP3 is generated and to which PIP3 recruits both mTORC2 (via the mSin1 PH domain) and its membrane-targeted substrate AKT."];
  "ATP_SITE" [label="mTOR kinase ATP cleft", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Nucleotide-binding cleft of the bilobed mTOR kinase domain"];
  "CRIM_DOMAIN" [label="mSin1 CRIM domain", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Conserved-region-in-the-middle domain of mSin1; its acidic loop engages the basic surface of the AGC-kinase N-lobe and is the principal distal docking site (~75 A from the catalytic cleft) for Akt, SGK1 and PKC."];
  "ETV7" [label="ETV7", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="ETS-family transcription factor reported as the defining subunit of a putative third, rapamycin-insensitive mTOR assembly (mTORC3) in cancer cells. Described by a single laboratory and not widely replicated, so the evidence remains weak."];
  "FATC_DOMAIN" [label="mTOR FATC domain", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Extreme C-terminal FATC domain; packs against the kinase domain and is indispensable for catalytic activity - deletion of even a single residue abolishes mTOR kinase function."];
  "FAT_DOMAIN" [label="mTOR FAT domain", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="FRAP-ATM-TRRAP domain, the alpha-helical clamp that wraps the kinase domain and holds it in a partially inactive conformation; the FAT-kinase interface is the target of activating cancer mutations and of Rheb-induced conformational change."];
  "FRB_DOMAIN" [label="FRB domain of mTOR", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="~100-residue four-helix bundle between the FAT and kinase domains of mTOR forming the binding site for the FKBP12-rapamycin binary complex; solvent-exposed in mTORC1 and occluded by Rictor-mSin1 in mTORC2."];
  "HEAT_REPEATS" [label="mTOR N-HEAT/M-HEAT solenoid", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="N-terminal alpha-solenoid of mTOR (horn and bridge), ~20 HEAT repeats; forms the mTORC1/mTORC2 dimer interface, the Raptor- and Rictor-binding surface and, together with the FAT domain, the Rheb-binding site."];
  "KINASE_DOMAIN" [label="mTOR kinase domain (PIKK)", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="PI3K-like catalytic domain of mTOR with a deeply recessed active-site cleft walled by the FRB domain, the LBE (mLST8-binding element) and the activation loop; the catalytic unit of both complexes."];
  "MAPKAP1" [label="mSin1", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="522-residue mTORC2 subunit with four regions: N-terminal Rictor-binding segment, central CRIM domain that docks AGC substrates, a Ras-binding domain, and a C-terminal PH domain that binds PIP3 and autoinhibits the complex."];
  "MLST8" [label="mLST8 (GbetaL)", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="WD40 beta-propeller shared by both complexes; contacts the mTOR kinase domain near the activation loop and stabilises the catalytic conformation."];
  "MTOR" [label="mTOR", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="2549-residue ~289 kDa PIKK-family Ser/Thr kinase (1p36.22). N-HEAT/M-HEAT solenoid, FAT domain, FRB, bilobed kinase domain, C-terminal FATC required for catalysis; deep substrate cleft partially occluded by an inhibitory element."];
  "MTORC1" [label="mTORC1", shape=box, style="filled,rounded", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Rapamycin-sensitive mTOR complex 1 (mTOR, Raptor, mLST8, PRAS40, DEPTOR); the convergence point of energy, oxygen and stress inputs via TSC-Rheb, Raptor phosphorylation and Rag GTPases; phosphorylates ULK1 Ser757 and AMPK alpha2 Ser345."];
  "MTORC2" [label="mTORC2", shape=box, style="filled,rounded", fillcolor="#d2f3e5", color="#1baf7a", tooltip="~1.0 MDa homodimer of mTOR, mLST8, Rictor and mSin1 with substoichiometric Protor-1/2 and DEPTOR; FRB occluded by Rictor-mSin1, hence acutely rapamycin-insensitive. Phosphorylates AGC kinases via distal docking."];
  "MTORC3" [label="mTORC3 (putative)", shape=box, style="filled,rounded", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Putative third mTOR assembly containing ETV7, reported to be rapamycin-insensitive and to drive proliferation in cancer cells. Single-laboratory description, not widely replicated, so the evidence remains weak."];
  "PH_DOMAIN" [label="mSin1 PH domain", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="C-terminal pleckstrin-homology domain of mSin1; in the basal state it folds back onto the mTOR kinase domain and suppresses catalysis, and binding of PtdIns(3,4,5)P3 releases this autoinhibition at the plasma membrane."];
  "PRR5" [label="Protor-1", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Accessory mTORC2 subunit binding Rictor; dispensable for complex assembly but implicated in efficient mTORC2-dependent SGK1 activation, notably in kidney."];
  "PRR5L" [label="Protor-2", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Accessory Rictor-binding mTORC2 subunit, paralogue of Protor-1; its degradation has been linked to enhanced mTORC2-dependent PKCδ phosphorylation and cell migration."];
  "RAIP_MOTIF" [label="RAIP motif", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="N-terminal sequence of 4E-BP1 that binds Raptor and cooperates with the C-terminal TOS motif in substrate recruitment."];
  "RBD_DOMAIN" [label="mSin1 Ras-binding domain", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Ras-binding domain of mSin1, which engages Ras-family GTPases and couples Ras signalling to mTORC2; its functional contribution remains incompletely resolved."];
  "RICTOR" [label="Rictor", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Defining, rapamycin-insensitive subunit of mTORC2; binds mSin1 through its N-terminal region, contributes to steric occlusion of the FRB domain, and forms part of the N-terminal mooring that engages the Akt kinase C-lobe."];
  "RPTOR" [label="Raptor", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="1335-residue defining subunit of mTORC1: N-terminal caspase-like domain (non-proteolytic), HEAT-like central region, C-terminal WD40 beta-propeller. Wraps the mTOR N-HEAT solenoid and presents the outward-facing TOS-motif substrate surface."];
  "TOS_MOTIF" [label="TOS motif (TOR signalling motif)", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Five-residue F [DE] [IML] [DE] [LI] motif (S6K1 FDIDL, 4E-BP1 FEMDI, PRAS40 FVMDE, HIF-1alpha) that docks substrates and PRAS40 onto Raptor and so onto mTORC1; mutation of the motif abolishes mTORC1-dependent phosphorylation."];
  "MCOLN1" [label="TRPML1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Lysosomal cation channel releasing local Ca2+ on mTORC1 inhibition or lysosomal stress, activating calcineurin; itself a CLEAR-network target gene, forming a feed-forward loop with TFEB."];
  "MAPKAP1_ISOFORM5" [label="mSin1 isoform 5 (mSin1.5, PH-domain-less)", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Splice isoform of mSin1 lacking the C-terminal PH domain; assembles an mTORC2 species whose AKT Ser473 kinase activity is not gated by insulin/PIP3 (Frias et al. 2006)."];
  "VAR_MTOR_FAT_GOF" [label="MTOR FAT-domain hotspot variants", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Activating MTOR substitutions in the FAT domain, including A1459P, C1483Y and E1799K; effects on substrate phosphorylation and inhibitor binding vary by variant."];
  "VAR_MTOR_KINASE_GOF" [label="MTOR kinase-domain hotspot variants", shape=invtriangle, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Activating substitutions in the MTOR kinase domain, including S2215Y and E2419K. FRB resistance substitutions such as F2108L are a distinct class."];
  "BTRC" [label="betaTrCP", shape=ellipse, style="filled", fillcolor="#d2f3e5", color="#1baf7a", tooltip="F-box substrate-recognition subunit of the SCF E3 ubiquitin ligase; binds phosphodegron-bearing DEPTOR and directs its polyubiquitination and proteasomal destruction."];
  "EIF4EBP1" [label="4E-BP1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Translational repressor of eIF4E, phosphorylated hierarchically by mTORC1 (Thr37/Thr46 first, then Thr70 and Ser65). Thr37/Thr46 are the rapamycin-resistant sites that define the limits of rapalog pharmacology."];
  "EIF4EBP2" [label="4E-BP2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="4E-BP paralogue predominant in brain; mTORC1 substrate sharing 4E-BP1 phosphosites; its loss enhances LTP yet produces autism-like behaviour via excess eIF4E-dependent translation."];
  "LARP1" [label="LARP1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="La-related protein 1; DM15 domain binds the m7G cap and adjacent 5'TOP motif when mTORC1 is inactive, excluding eIF4F; mTORC1 phosphorylation releases TOP mRNAs. Also binds Raptor and PABP and stabilises TOP mRNAs."];
  "MAF1" [label="MAF1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Conserved RNA polymerase III repressor; mTORC1 phosphorylation at Ser60, Ser68 and Ser75 inactivates it, derepressing tRNA and 5S rRNA transcription."];
  "PPP2CA" [label="PP2A", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Protein phosphatase 2A catalytic subunit; associates with S6K1 and dephosphorylates S6K1 Thr389 and TIF-IA Ser199 when mTORC1 is inhibited by rapamycin."];
  "RPS6KB1" [label="S6K1 (p70 S6 kinase 1)", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="AGC kinase activated by mTORC1 (Thr389) and PDK1 (Thr229); phosphorylates rpS6, eIF4B, PDCD4, SKAR, eEF2K, UBF, CBP80, mTOR Ser2448 and IRS-1. Controls cell size; fully rapamycin-sensitive."];
  "RPS6KB2" [label="S6K2 (p70 S6 kinase 2)", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="S6K1 paralogue activated by mTORC1 at Thr388; predominantly nuclear; principal rpS6 kinase in S6K1-null cells; S6K1/S6K2 double knockout is perinatally lethal."];
  "RRN3" [label="TIF-IA (RRN3)", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Pol I transcription initiation factor bridging initiation-competent Pol I to SL1; mTOR-dependent Ser44 phosphorylation and rapamycin-induced Ser199 dephosphorylation control its activity and nucleolar localisation."];
  "UBTF" [label="UBF", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Upstream binding factor; HMG-box nucleolar transcription factor binding rDNA, recruiting SL1 and Pol I; its C-terminal activation domain is phosphorylated in an mTOR/S6K1-dependent manner."];
  "AMBRA1" [label="AMBRA1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Beclin-1-interacting autophagy activator and scaffold for TRAF6-mediated ULK1 ubiquitylation; mTORC1 phosphorylation holds it inactive, coupling nutrient status to ULK1 stability."];
  "ATG101" [label="ATG101", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="HORMA-domain subunit of the ULK1 initiation complex that stabilises ATG13 and is required for autophagy initiation."];
  "ATG13" [label="ATG13", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Adaptor subunit of the ULK1 initiation complex, bridging ULK1 and FIP200; phosphorylated by mTORC1 as part of layered repression of phagophore initiation."];
  "ATG14" [label="ATG14L", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Autophagy-specific targeting subunit of the class III PI3K complex I; phosphorylated by mTORC1 (inhibitory) and by ULK1 at Ser29 (activating), setting VPS34 lipid-kinase activity at the phagophore."];
  "EP300" [label="p300", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Acetyltransferase that acetylates ATG proteins to suppress autophagy and acetylates lipogenic regulators; phosphorylated by mTORC1, coupling nutrient status to acetylation-dependent autophagy and lipid output."];
  "GRB10" [label="Grb10", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Adaptor stabilised by mTORC1 phosphorylation that inhibits insulin and IGF-1 receptor signalling; a second feedback brake lost when mTORC1 is pharmacologically inhibited."];
  "LPIN1" [label="Lipin1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Phosphatidate phosphatase and nuclear SREBP antagonist; mTORC1 phosphorylation retains it in the cytoplasm, which is how mTORC1 controls nuclear SREBP activity."];
  "PPP3" [label="calcineurin", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Calcium- and calmodulin-dependent serine/threonine phosphatase; the target of the FKBP12-FK506 and cyclophilin-cyclosporine complexes, and not a target of the FKBP12-rapamycin complex."];
  "RB1CC1" [label="FIP200", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Scaffold subunit of the ULK1 initiation complex, required for phagophore nucleation and for ULK1 kinase activity and stability."];
  "RUBCNL" [label="Pacer", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Rubicon-like autophagy enhancer that promotes autophagosome-lysosome fusion by engaging HOPS and STX17; reported mTORC1 substrate linking nutrient status to maturation."];
  "STAT3" [label="STAT3", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Transcription factor whose Ser727 transactivation-domain phosphorylation is rapamycin-sensitive and mTOR-dependent, linking mTORC1 to inflammatory and metabolic transcription."];
  "TFE3" [label="TFE3", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="MiT/TFE-family paralogue of TFEB, phosphorylated by mTORC1 at equivalent sites (Ser321) and similarly retained in the cytoplasm by 14-3-3."];
  "TFEB" [label="TFEB", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Master transcription factor of the autophagy–lysosome (CLEAR) programme, inhibited by mTORC1-dependent phosphorylation and cytoplasmic retention; reported to feed back onto peripheral clock gene expression."];
  "ULK1" [label="ULK1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Autophagy-initiating kinase (ULK1-ATG13-FIP200-ATG101). Activated by AMPK phosphorylation (Ser317/Ser555/Ser777) and inhibited by mTORC1 Ser757 phosphorylation, which disrupts ULK1-AMPK binding; feeds back on AMPK."];
  "UVRAG" [label="UVRAG", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Beclin-1 partner in class III PI3K complex II that promotes autophagosome and endosome maturation; mTORC1 phosphorylation at Ser498 restrains this maturation step."];
  "WIPI2" [label="WIPI2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="PI(3)P effector that recruits the ATG12-ATG5-ATG16L1 conjugation machinery to the phagophore; mTORC1 phosphorylation promotes its ubiquitin-dependent degradation."];
  "ARHGEF3" [label="XPLN (ARHGEF3)", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Rho-family guanine nucleotide exchange factor reported as an endogenous mTORC2 inhibitor that binds Rictor and suppresses AKT Ser473 phosphorylation, GEF-independently. HGNC symbol not asserted here."];
  "PKC" [label="Protein kinase C (generic)", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="PKC family; mTORC2 supports maturation of selected isoforms through turn-motif/TOR-interaction-motif priming. Hydrophobic-motif phosphorylation can occur by PKC autophosphorylation."];
  "PRKCA" [label="PKCα", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Conventional PKC isoform phosphorylated cotranslationally by ribosome-associated mTORC2 at turn and hydrophobic motifs, a requirement for its folding and stability."];
  "PRKCB" [label="PKCβII", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Conventional PKC isoform whose turn motif (Thr641) and hydrophobic motif (Ser660) are mTORC2-dependent priming sites required for a stable, signalling-competent enzyme."];
  "PRKCD" [label="PKCδ", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Novel PKC isoform whose turn- and hydrophobic-motif phosphorylation by mTORC2 supports its stability and its contribution to migration signalling."];
  "PRKCE" [label="PKCε", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Novel PKC isoform among the mTORC2-primed PKCs; priming-site phosphorylation is required for maturation and stability."];
  "PRKCZ" [label="PKCζ", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Atypical PKC; mTORC2-dependent turn-motif phosphorylation supports its stability, and as part of the Par3–Par6–aPKC module it establishes epithelial apicobasal polarity."];
  "SGK1" [label="SGK1", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Serum- and glucocorticoid-induced kinase 1; mTORC2 substrate at hydrophobic-motif Ser422, governing distal nephron ion transport through ENaC, Na+/K+-ATPase and CLC-K, and phosphorylating NDRG1."];
  "RIBOSOME" [label="Ribosome", shape=box, style="filled,rounded", fillcolor="#d2f3e5", color="#1baf7a", tooltip="Translating ribosome; a minor subset of mTORC2 associates with it, which both activates mTORC2 in a growth-factor-responsive manner and permits cotranslational turn-motif phosphorylation of nascent AGC kinases."];
  "BRF1" [label="Brf1 (TFIIIB)", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="TFIIIB subunit required to recruit Pol III to tRNA and 5S promoters; direct binding target of MAF1-mediated repression."];
  "CCND1" [label="Cyclin D1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="G1 cyclin encoded by a structured-5'UTR mRNA whose translation is eIF4E/4E-BP-dependent; a key oncogenic output of mTORC1."];
  "EEF2" [label="eEF2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="GTPase catalysing ribosomal translocation during elongation; Thr56 phosphorylation by eEF2K prevents ribosome binding and halts elongation."];
  "EEF2K" [label="eEF2 kinase", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Ca2+/calmodulin-dependent alpha-kinase that phosphorylates eEF2 Thr56 to slow elongation; inhibited by S6K1/RSK phosphorylation at Ser366 and by mTOR-dependent Ser78 phosphorylation."];
  "EIF3" [label="eIF3 complex", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Multisubunit 43S preinitiation-complex factor that scaffolds inactive S6K1 and recruits mTORC1 upon stimulation; bridged to eIF4F through eIF4G and bound by phospho-eIF4B."];
  "EIF4A1" [label="eIF4A1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="DEAD-box RNA helicase of eIF4F that unwinds structured 5'UTRs; stimulated by eIF4B and inhibited by PDCD4."];
  "EIF4B" [label="eIF4B", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="RNA-binding cofactor that stimulates eIF4A helicase activity; S6K1/RSK phosphorylation at Ser422 enhances its recruitment to eIF3/preinitiation complexes and translation of structured 5'UTRs such as c-Myc."];
  "EIF4E" [label="eIF4E", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Cap-binding subunit of eIF4F and rate-limiting factor for cap-dependent translation; the point at which BMAL1-dependent and 4E-BP1-dependent circadian translational control converge."];
  "EIF4F" [label="eIF4F complex", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Cap-binding initiation complex (eIF4E, eIF4G, eIF4A) whose assembly is gated by 4E-BP phosphorylation; drives selective translation of cyclin D1, c-Myc, VEGF, HIF-1alpha and Mcl-1 mRNAs."];
  "EIF4G1" [label="eIF4G1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Scaffold of eIF4F binding eIF4E (via the YxxxxLPhi motif shared with 4E-BPs), eIF4A, eIF3, PABP and MNK; carries rapamycin-sensitive C-terminal phosphosites."];
  "EXON_JUNCTION_COMPLEX" [label="Exon junction complex", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Protein complex deposited upstream of exon-exon junctions during splicing; SKAR-dependent recruitment of S6K1 couples splicing to enhanced translation of spliced mRNAs."];
  "GTF3C" [label="TFIIIC", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Pol III promoter-recognition factor for tRNA and 5S genes; reported to associate with mTOR, which is found at tRNA and 5S rRNA genes."];
  "HIF1A" [label="HIF-1alpha", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Oxygen-labile transcription factor stabilised under hypoxia (loss of PHD/VHL-dependent degradation). Upstream of mTORC1 it induces REDD1 (DDIT4) and BNIP3; downstream it is an mTORC1 translational target (feedback)."];
  "MCL1" [label="Mcl-1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Anti-apoptotic BCL-2 family protein whose translation is 4E-BP/eIF4E-dependent; mediates mTORC1-dependent survival."];
  "MKNK1" [label="MNK1/2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="MAP kinase-interacting kinases activated by ERK/p38; dock on eIF4G to phosphorylate eIF4E Ser209, an mTORC1-independent modulation of eIF4E oncogenic activity."];
  "MYC" [label="c-Myc", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Transcription factor with structured-5'UTR mRNA translated in an eIF4F/eIF4B-dependent manner downstream of mTORC1; master transcriptional driver of ribosome biogenesis genes."];
  "NCBP1" [label="CBP80 (NCBP1)", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="80 kDa subunit of the nuclear cap-binding complex bound to mRNAs during the pioneer round of translation; reported S6K1 substrate and S6K1/SKAR-associated factor on spliced mRNAs."];
  "PABPC1" [label="PABP", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Cytoplasmic poly(A)-binding protein 1; binds LARP1 and eIF4G, linking the 3' poly(A) tail to cap-dependent initiation and TOP mRNA stability."];
  "PDCD4" [label="PDCD4", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Programmed cell death 4; tumour suppressor whose MA3 domains bind eIF4A and block helicase activity; S6K1 phosphorylation at Ser67 creates a betaTrCP degron, triggering proteasomal degradation."];
  "POLR1" [label="RNA polymerase I", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Nucleolar polymerase transcribing the 47S pre-rRNA; recruited to rDNA by UBF/SL1 and TIF-IA under mTORC1 control."];
  "POLR3" [label="RNA polymerase III", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Polymerase transcribing tRNA and 5S rRNA genes; recruited by TFIIIB/TFIIIC and repressed by dephosphorylated MAF1."];
  "PRE_RRNA_47S" [label="47S pre-rRNA", shape=parallelogram, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Pol I primary transcript processed into 18S, 5.8S and 28S rRNAs; its synthesis is the rate-limiting, mTORC1-scaled step of ribosome biogenesis."];
  "RPS6" [label="Ribosomal protein S6", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="40S ribosomal protein phosphorylated by S6K1/2 at Ser235/236/240/244 (and by RSK at Ser235/236). Phosphorylation determines cell size and glucose homeostasis; its classical role in TOP mRNA translation is no longer accepted."];
  "RRNA_5S" [label="5S rRNA", shape=parallelogram, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Pol III-transcribed ribosomal RNA incorporated into the 60S subunit; transcription repressed by MAF1 and derepressed by mTORC1."];
  "SKAR" [label="SKAR (POLDIP3)", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="S6K1 Aly/REF-like target; exon-junction-complex component phosphorylated by S6K1 (Ser383/Ser385) that recruits active S6K1 to newly spliced mRNAs to enhance pioneer-round translation."];
  "SL1_TIF_IB" [label="SL1/TIF-IB (TBP–TAF1A/TAF1B/TAF1C)", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Promoter selectivity factor of RNA polymerase I: a TBP-containing complex (TAF1A/TAF1B/TAF1C) that, together with UBF, nucleates the pre-initiation complex at the rDNA promoter. RRN3/TIF-IA bridges initiation-competent Pol I to promoter-bound SL1, which is the step at which the mTORC1–TIF-IA input i"];
  "TOP_MRNA" [label="5'TOP mRNAs", shape=parallelogram, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="mRNAs with a 5'-terminal oligopyrimidine motif encoding ribosomal proteins, elongation factors and PABP; translationally repressed by LARP1 (and 4E-BPs) when mTORC1 is inactive."];
  "TRNA" [label="tRNA", shape=parallelogram, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Pol III-transcribed transfer RNAs whose supply is scaled with ribosome production via mTORC1-MAF1 signalling."];
  "VEGFA" [label="VEGF-A", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Angiogenic growth factor transcriptionally induced by HIF-1alpha and translationally dependent on eIF4E, linking mTORC1 output to the tumour angiogenic programme."];
  "ACACA" [label="Acetyl-CoA carboxylase 1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="SREBP1 target catalysing the committed, rate-limiting carboxylation of acetyl-CoA to malonyl-CoA in de novo lipogenesis."];
  "ATF4" [label="ATF4", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Integrated-stress-response transcription factor translated when eIF2alpha is phosphorylated; induces DDIT4 (REDD1) and SESN2, inhibiting mTORC1 under ER stress, energy stress and amino-acid starvation. Also an mTORC1 output."];
  "ATG16L1_COMPLEX" [label="ATG12–ATG5–ATG16L1 complex", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="E3-like conjugation machinery recruited to PI3P-positive phagophores by WIPI2; lipidates LC3/GABARAP proteins onto the expanding autophagosomal membrane."];
  "ATG9A" [label="ATG9A", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="The only transmembrane core autophagy protein; a lipid scramblase delivered in vesicles that seed the phagophore, trafficked under ULK1 control."];
  "BECN1" [label="Beclin-1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Core subunit of class III PI3K complexes; ULK1 phosphorylation at Ser14 activates VPS34 lipid-kinase output for phagophore nucleation."];
  "CAD" [label="CAD", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Trifunctional pyrimidine-synthesis enzyme; included here as an S6K1 substrate (Ser1859) to complete the S6K1 substrate set. Cross-reference to the metabolism module."];
  "CEBPB" [label="C/EBPβ (CEBPB)", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Rhythmically expressed transcription factor that times the autophagy gene programme in liver; provides a mechanistic basis for rhythmic autophagic flux."];
  "FASN" [label="Fatty acid synthase", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="one of the lipogenic genes induced downstream of mTORC1–SREBP1."];
  "G6PD" [label="G6PD", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Rate-limiting enzyme of the oxidative pentose phosphate pathway, induced through SREBP downstream of mTORC1; supplies NADPH and ribose-5-phosphate."];
  "GLUD1" [label="glutamate dehydrogenase", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Mitochondrial enzyme converting glutamate to alpha-ketoglutarate for TCA anaplerosis; activated downstream of mTORC1-S6K1 through repression of SIRT4."];
  "HK2" [label="hexokinase 2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Mitochondria-associated hexokinase; an mTORC1/HIF-1 transcriptional output that, when free of glucose-6-phosphate during glucose deprivation, binds Raptor via a TOS-like motif and inhibits mTORC1 to promote autophagy."];
  "HMGCR" [label="HMG-CoA reductase", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Rate-limiting enzyme of the mevalonate pathway and the principal SREBP2 target gene; the statin target, and the effector through which mTORC1–SREBP2 drives cholesterol synthesis."];
  "IL1A" [label="IL-1alpha", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Interleukin-1 alpha; mTORC1-dependent translation of IL1A is one of the two defined mechanisms by which mTORC1 is required for the senescence-associated secretory phenotype."];
  "LDHA" [label="LDHA", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Lactate dehydrogenase A, induced by HIF-1alpha; regenerates NAD+ by converting pyruvate to lactate and sustains aerobic glycolysis."];
  "MTHFD2" [label="MTHFD2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Mitochondrial bifunctional methylenetetrahydrofolate dehydrogenase/cyclohydrolase of the folate cycle; ATF4-dependent induction couples one-carbon units to purine synthesis."];
  "NADPH" [label="NADPH", shape=diamond, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Reduced nicotinamide adenine dinucleotide phosphate; reductant generated by the oxidative pentose phosphate pathway and consumed by fatty-acid and sterol synthesis. It is a product of the mTORC1-SREBP-G6PD arm."];
  "NRF1" [label="Nuclear respiratory factor 1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Transcription factor coactivated by PGC-1α that induces nuclear-encoded respiratory chain subunits and TFAM, supplying the missing mechanistic step between the YY1–PGC-1α complex and mitochondrial biogenesis."];
  "PFKFB3" [label="PFKFB3", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Bifunctional kinase/phosphatase producing fructose-2,6-bisphosphate, the allosteric activator of PFK1; induced by HIF-1alpha downstream of mTORC1."];
  "PI3P" [label="Phosphatidylinositol 3-phosphate (PI3P)", shape=diamond, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Lipid product of the VPS34 (PIK3C3) complex I on the nascent phagophore; the signal that recruits PROPPIN/WIPI effectors and nucleates autophagosome formation."];
  "PIK3C3_COMPLEX_I" [label="Class III PI3K complex I", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Autophagy-specific VPS34-Beclin-1-ATG14L-VPS15 complex that produces PI(3)P at the nascent phagophore."];
  "PIK3C3_COMPLEX_II" [label="PI3KC3 complex II (VPS34–Beclin-1–UVRAG)", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="UVRAG-containing class III PI3K complex, distinguished from ATG14L-containing complex I; acts in autophagosome maturation and endosomal trafficking rather than phagophore nucleation."];
  "PKM2" [label="PKM2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="M2 splice isoform of pyruvate kinase favoured in proliferating cells; its low-activity state permits accumulation of glycolytic intermediates for biosynthesis."];
  "PPARG" [label="PPARgamma", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Master adipogenic transcription factor; the PPARgamma programme is an adipose mTORC1-dependent output alongside adipogenesis."];
  "PPARGC1A" [label="PGC-1alpha", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Transcriptional coactivator of mitochondrial biogenesis and oxidative metabolism; its interaction with YY1 requires mTOR activity."];
  "RIBOSE_5_PHOSPHATE" [label="Ribose-5-phosphate", shape=diamond, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Pentose phosphate pathway product supplying the ribose backbone for de novo purine and pyrimidine nucleotide synthesis."];
  "SCD" [label="Stearoyl-CoA desaturase 1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="SREBP1 target introducing the Δ9 double bond into saturated fatty acyl-CoAs, required for membrane phospholipid and triglyceride synthesis."];
  "SIRT4" [label="SIRT4", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Mitochondrial sirtuin that ADP-ribosylates and inhibits glutamate dehydrogenase; its expression is repressed downstream of mTORC1, de-repressing glutamine anaplerosis."];
  "SLC2A1" [label="GLUT1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Facilitative glucose transporter induced by HIF-1alpha, raising glucose uptake downstream of mTORC1."];
  "SREBF1" [label="SREBP1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Membrane-bound transcription factor whose proteolytic processing and nuclear accumulation are promoted by mTORC1; drives fatty-acid synthesis genes and G6PD."];
  "SREBF2" [label="SREBP2", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="SREBP isoform controlling the sterol biosynthetic gene programme (HMGCR, HMGCS1, LDLR); mTOR is required for its transcriptional output, partly through rapamycin-resistant mechanisms."];
  "TFAM" [label="Mitochondrial transcription factor A", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Nuclear-encoded mtDNA packaging and transcription factor. Its translation is 4E-BP-sensitive, making it a concrete effector of the 4E-BP arm of mitochondrial biogenesis."];
  "YWHA" [label="14-3-3", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Phosphoserine/threonine-binding adaptor family; binds AMPK-phosphorylated Raptor, S6K1-phosphorylated Rictor and Thr246-phosphorylated PRAS40, translating phosphorylation of core subunits into sequestration or inhibition."];
  "YY1" [label="YY1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Zinc-finger transcription factor that partners PGC-1alpha at mitochondrial gene promoters in an mTOR-dependent, rapamycin-sensitive manner."];
  "ZFP36L1" [label="ZFP36L1", shape=ellipse, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="AU-rich-element RNA-binding protein that degrades cytokine transcripts; MK2 phosphorylation inactivates it, permitting SASP cytokine accumulation."];
  "ATP1A1" [label="Na+/K+-ATPase (α1)", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Basolateral sodium pump providing the driving force for transepithelial sodium reabsorption; stimulated downstream of SGK1."];
  "BAD" [label="BAD", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Pro-apoptotic BH3-only protein; phosphorylation at human Ser99 (mouse Ser136) promotes 14-3-3 binding and suppresses its apoptotic activity."];
  "CDKN1B" [label="p27 (CDKN1B)", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Cyclin-dependent kinase inhibitor; a FOXO1 transcriptional target. Elevated p27 accompanies nuclear FOXO1 accumulation in Rictor-null beta-cells and contributes to the reduced beta-cell mass seen on mTORC2 loss."];
  "CLCNK" [label="CLC-K chloride channels", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Basolateral renal chloride channels (with barttin) required for transepithelial salt transport; positively regulated by SGK1."];
  "FOXO1" [label="FOXO1", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Forkhead transcription factor; AKT phosphorylation (markedly enhanced by Ser473) causes 14-3-3 binding and nuclear exclusion, suppressing gluconeogenic and pro-apoptotic transcription."];
  "FOXO3" [label="FOXO3a", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Forkhead transcription factor driving pro-apoptotic and stress-response genes; one of the AKT substrates whose phosphorylation depends disproportionately on mTORC2-mediated Ser473 phosphorylation."];
  "GCK" [label="Glucokinase", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Hepatic hexokinase IV; induced downstream of hepatic mTORC2–AKT signalling and the entry point for hepatic glycolytic flux."];
  "GLUCONEOGENESIS" [label="Hepatic gluconeogenesis", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Hepatic de novo glucose production driven by FOXO1-dependent transcription; restrained by hepatic mTORC2 through AKT-mediated FOXO1 suppression."];
  "MDM2" [label="MDM2 (E3 ubiquitin ligase)", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="E3 ubiquitin ligase and principal negative regulator of p53. AKT phosphorylates MDM2 at Ser166/Ser186, promoting its nuclear entry and p53 turnover; this is the survival arm of AKT output biased by mTORC2-dependent Ser473 phosphorylation."];
  "MLXIPL" [label="ChREBP", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Carbohydrate-response element-binding protein; adipose mTORC2 drives ChREBP-dependent de novo lipogenesis, with consequences for hepatic glucose metabolism."];
  "NDRG1" [label="NDRG1", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="N-myc downstream-regulated gene 1 product; SGK1 substrate at Thr346/356/366 and the standard cellular readout of mTORC2–SGK1 activity."];
  "NEDD4L" [label="Nedd4-2", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="HECT-domain E3 ubiquitin ligase that ubiquitinates ENaC subunits and promotes their retrieval from the apical membrane; inactivated by SGK1 phosphorylation and 14-3-3 binding."];
  "RAC1" [label="Rac1", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Rho-family GTPase driving branched actin polymerisation, lamellipodia and dendritic spine remodelling; activated downstream of mTORC2 via Tiam1 and downstream of PKC signalling."];
  "RHOA" [label="RhoA", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Rho-family GTPase controlling stress fibres, actomyosin contractility and adhesion; part of the Rho-family signalling affected when mTORC2-dependent PKC protein is lost."];
  "SCNN1" [label="ENaC", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Epithelial sodium channel of the aldosterone-sensitive distal nephron; principal effector through which mTORC2–SGK1 sets sodium reabsorption and blood pressure."];
  "SLC2A4" [label="GLUT4", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Insulin-responsive glucose transporter of muscle and adipose tissue; its translocation to the plasma membrane is the proximate step in insulin-stimulated glucose uptake."];
  "TBC1D4" [label="AS160 (TBC1D4)", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Rab GAP that restrains GLUT4 vesicle translocation; AKT phosphorylation at Thr642 creates a 14-3-3 site and relieves this restraint, permitting insulin-stimulated glucose uptake."];
  "TIAM1" [label="Tiam1", shape=ellipse, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Rac1-specific guanine nucleotide exchange factor; the mTORC2 effector through which forebrain mTORC2 drives actin polymerisation required for consolidation of long-term memory."];
  "BMAL1" [label="BMAL1 (ARNTL)", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Core clock bHLH-PAS transcription factor; heterodimerises with CLOCK to drive E-box transcription. Also a negative regulator of mTORC1 and, when phosphorylated by S6K1, a promoter of rhythmic cap-dependent translation."];
  "CLOCK" [label="CLOCK", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Core clock bHLH-PAS transcription factor and obligate BMAL1 partner; the CLOCK–BMAL1 heterodimer drives E-box-dependent transcription of Per, Cry and many metabolic output genes."];
  "CLOCK_BMAL1" [label="CLOCK–BMAL1 heterodimer", shape=box, style="filled,rounded", fillcolor="#d6ead6", color="#008300", tooltip="Positive limb transcription factor of the mammalian clock; binds E-boxes to activate Per1/Per2, Cry1/Cry2 and clock-controlled output genes, and is repressed by the PER–CRY complex it induces."];
  "CRY1" [label="CRY1 (Cryptochrome 1)", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Negative-limb clock protein; partners PER to repress CLOCK–BMAL1. Its stability is set by AMPK-dependent phosphorylation and FBXL3-mediated degradation, making it an energy-sensitive clock node."];
  "CSNK1E" [label="Casein kinase 1ε (CSNK1E)", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="PER-directed kinase controlling PER2 stability and nuclear entry; the node through which AMPK (an mTOR-pathway energy sensor) reaches the clock."];
  "NR1D1" [label="REV-ERBα (NR1D1)", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Nuclear receptor of the accessory clock loop; CLOCK–BMAL1 target that represses Bmal1 transcription through RORE elements, generating the antiphase BMAL1 rhythm."];
  "PER1" [label="PER1 (Period 1)", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Negative-limb clock protein and immediate-early photic response gene in the SCN; its light-induced expression is attenuated by mTOR inhibition, linking mTOR to phase shifting."];
  "PER_CRY_COMPLEX" [label="PER–CRY repressor complex", shape=box, style="filled,rounded", fillcolor="#d6ead6", color="#008300", tooltip="Heteromeric PER–CRY complex of the negative limb; formed in the cytoplasm, enters the nucleus and represses CLOCK–BMAL1."];
  "VIP" [label="VIP (vasoactive intestinal peptide)", shape=ellipse, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Neuropeptide of SCN core neurons required for synchrony and rhythmicity of the SCN network; its translation in the SCN is under 4E-BP1 control and therefore sensitive to mTORC1 activity."];
  "ABETA" [label="Amyloid-beta", shape=ellipse, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Aggregation-prone peptide whose brain burden falls with autophagy induction; rapamycin lowers it in 3xTg-AD mice when given before substantial pathology."];
  "HTT" [label="Huntingtin (polyQ)", shape=ellipse, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Polyglutamine-expanded huntingtin, an autophagy substrate reduced by rapamycin or CCI-779 in fly and mouse models."];
  "SNCA" [label="alpha-Synuclein", shape=ellipse, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Aggregation-prone synaptic protein cleared by macroautophagy."];
  "CAP_DEPENDENT_TRANSLATION" [label="Cap-dependent translation", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="eIF4F-dependent initiation on 5'-capped mRNAs, preferentially affecting transcripts with structured 5' UTRs; only partially suppressed by rapalogs because Thr37/Thr46 of 4E-BP1 resist them."];
  "CELL_GROWTH" [label="Cell growth (mass/size)", shape=octagon, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Increase in cell mass and size driven by the S6K-rpS6 axis and ribosome biogenesis; distinct from proliferation, which depends on the 4E-BP arm."];
  "PHENO_CELL_PROLIFERATION" [label="Cell proliferation", shape=octagon, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="mTORC1-dependent proliferation controlled by the 4E-BP-eIF4E arm (cyclin D1, c-Myc translation) rather than by S6K-dependent cell growth."];
  "PROTEIN_SYNTHESIS" [label="Protein synthesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="mTORC1-dependent anabolic response of skeletal muscle to loading and to essential amino acids; blocked in humans by acute rapamycin, and the basis of the anabolic-resistance concern in older adults."];
  "RIBOSOME_BIOGENESIS" [label="Ribosome biogenesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Coordinated production of rRNA (Pol I), 5S rRNA and tRNA (Pol III) and ribosomal proteins (Pol II/TOP translation) scaled by mTORC1 and S6K1."];
  "ADIPOGENESIS" [label="adipogenesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Differentiation and lipid-storage programme of adipocytes requiring mTORC1; adipocyte Raptor deletion impairs adipogenesis and reduces fat mass."];
  "AUTOPHAGIC_LYSOSOME_REFORMATION" [label="Autophagic lysosome reformation", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Tubulation and scission of autolysosomes that regenerates functional lysosomes at the end of an autophagic cycle; it requires mTOR reactivation driven by degradation-derived amino acids [686]. This reactivation is the mechanistic basis of the oscillatory behaviour of mTORC1 activity during prolonged"];
  "AUTOPHAGY" [label="autophagy", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Macroautophagic sequestration and lysosomal degradation of cytoplasmic material; one of the two principal catabolic arms repressed by mTORC1, and the arm with greatest consequence in post-mitotic tissue."];
  "CHOLESTEROL_SYNTHESIS" [label="cholesterol synthesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="SREBP2-driven sterol biosynthetic programme requiring mTOR activity; partially rapamycin-resistant at the transcriptional level."];
  "CLEAR_NETWORK" [label="CLEAR gene network", shape=tab, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Coordinated Lysosomal Expression And Regulation network of approximately 470 lysosomal and autophagy genes driven by TFEB/TFE3 through a palindromic E-box promoter motif."];
  "GLUTAMINE_ANAPLEROSIS" [label="glutamine anaplerosis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Replenishment of TCA-cycle intermediates from glutamine-derived alpha-ketoglutarate, supported downstream of mTORC1 by the S6K1-GDH axis and by c-Myc."];
  "GLUTATHIONE_SYNTHESIS" [label="glutathione synthesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="ATF4-dependent production of glutathione downstream of mTORC1, linking growth signalling to redox buffering alongside protein synthesis."];
  "GLYCOLYSIS" [label="glycolysis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Glycolytic flux; supported by hepatic mTORC2 via AKT and glucokinase, and required (with glutaminolysis) for effector T-cell metabolic reprogramming."];
  "LIPOGENESIS" [label="de novo lipogenesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="SREBP1-driven fatty-acid synthesis downstream of mTORC1; in liver it is the basis of mTORC1-associated steatosis and of rapalog-associated dyslipidaemia."];
  "LYSOSOME_BIOGENESIS" [label="lysosomal biogenesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="TFEB/TFE3-driven expansion of lysosomal number and degradative capacity through the CLEAR network; suppressed by mTORC1."];
  "MITOCHONDRIAL_BIOGENESIS" [label="mitochondrial biogenesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Expansion of mitochondrial mass and oxidative capacity supported by 4E-BP-dependent translation of nuclear-encoded mitochondrial mRNAs and by the YY1-PGC-1alpha transcriptional complex."];
  "ONE_CARBON_METABOLISM" [label="one-carbon/folate metabolism", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Mitochondrial tetrahydrofolate cycle supplying formyl and methyl units for nucleotide synthesis and methylation reactions; coupled to mTORC1 through ATF4-MTHFD2."];
  "PENTOSE_PHOSPHATE_PATHWAY" [label="pentose phosphate pathway", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Oxidative branch activated through SREBP-driven G6PD expression; supplies NADPH for reductive biosynthesis and ribose-5-phosphate for nucleotides."];
  "PURINE_SYNTHESIS" [label="de novo purine synthesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Purine nucleotide production driven by mTORC1 through ATF4-dependent control of the mitochondrial tetrahydrofolate cycle."];
  "PYRIMIDINE_SYNTHESIS" [label="de novo pyrimidine synthesis", shape=box, style="filled,rounded", fillcolor="#fff0c2", color="#eda100", tooltip="Pyrimidine nucleotide production stimulated acutely by the S6K1-CAD Ser1859 axis downstream of mTORC1."];
  "SASP" [label="senescence-associated secretory phenotype", shape=octagon, style="filled", fillcolor="#fff0c2", color="#eda100", tooltip="Pro-inflammatory secretome of senescent cells, which requires mTORC1-driven translation (IL1A; MAPKAPK2); rapamycin suppresses the SASP without eliminating senescent cells, an example of geroprotective benefit without causal primacy."];
  "ACTIN_CYTOSKELETON" [label="Actin cytoskeleton", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Actin filament organisation and polymerisation; the founding mTORC2-dependent output, driven through Rho-family GTPases, PKC isoforms and Tiam1–Rac1."];
  "CELL_ADHESION" [label="Cell adhesion", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Cell–matrix and cell–cell adhesion dynamics downstream of PKC and Rho-family signalling, reduced in mTORC2-deficient cells."];
  "CELL_MIGRATION" [label="Cell migration", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Directed cell motility dependent on cytoskeletal remodelling; impaired when mTORC2-dependent PKC protein and Rho-family signalling are lost."];
  "CELL_SURVIVAL" [label="Cell survival signalling", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Anti-apoptotic programme sustained by AKT phosphorylation of BAD and of FOXO transcription factors; the arm of AKT output most dependent on mTORC2-mediated Ser473 phosphorylation."];
  "EPITHELIAL_POLARITY" [label="Epithelial polarity", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Apicobasal organisation of epithelial sheets, established largely through atypical PKC in the Par3–Par6 module and therefore dependent on mTORC2-mediated PKC maturation."];
  "GLUCOSE_UPTAKE" [label="Insulin-stimulated glucose uptake", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="GLUT4-mediated glucose entry into muscle and adipose tissue following insulin; reduced by adipose Rictor deletion and by chronic mTORC2 loss."];
  "ION_TRANSPORT" [label="Distal nephron ion transport", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Transepithelial sodium, potassium and chloride handling in the distal nephron, set by SGK1-dependent regulation of ENaC, the Na+/K+-ATPase and CLC-K channels."];
  "LIPOLYSIS" [label="Lipolysis", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Hydrolysis of stored triacylglycerol in adipocytes. An adipose mTORC2-dependent output alongside insulin-stimulated glucose uptake; adipocyte Rictor deletion alters lipid handling."];
  "LTP_LATE_PHASE" [label="Late-phase LTP (L-LTP)", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Protein-synthesis-dependent late phase of hippocampal long-term potentiation and the long-term memory that depends on it; rapamycin-sensitive, whereas early-phase LTP and short-term memory are spared."];
  "MYELINATION" [label="CNS myelination", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Formation and maintenance of oligodendrocyte myelin sheaths in the central nervous system. Oligodendrocyte-lineage deletion separates the complexes: Raptor loss causes persistent hypomyelination, Rictor loss has modest and largely transient effects, and only the double mutant impairs oligodendrocyte"];
  "TH2_DIFFERENTIATION" [label="Th2 effector differentiation", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Differentiation of naive CD4+ T cells into Th2 effector cells. Selectively dependent on Rictor-mTORC2, in contrast to Th1/Th17 differentiation, which depends on Rheb-mTORC1."];
  "TREG_DIFFERENTIATION" [label="Foxp3+ regulatory T cell differentiation", shape=box, style="filled,rounded", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Differentiation of naive CD4+ T cells into Foxp3+ regulatory T cells. Restrained by both mTOR complexes; loss of mTOR kinase activity promotes it, which is the basis of preferential Treg expansion under rapamycin."];
  "CIRCADIAN_CLOCK" [label="Circadian clock (transcription–translation feedback loop)", shape=box, style="filled,rounded", fillcolor="#d6ead6", color="#008300", tooltip="Cell-autonomous ~24 h oscillator built from the CLOCK–BMAL1 activator limb and the PER/CRY repressor limb; entrained centrally by light and peripherally by feeding, and reciprocally coupled to mTORC1."];
  "GLUTAMINOLYSIS" [label="Glutaminolysis", shape=box, style="filled,rounded", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Glutamine catabolism supporting anaplerosis; part of the metabolic reprogramming of effector T-cell activation that requires both mTOR complexes."];
  "INSULIN_SECRETION" [label="Insulin secretion", shape=box, style="filled,rounded", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Glucose-stimulated insulin release from pancreatic beta-cells. Insulin secretion and beta-cell survival are the mTORC2-dependent outputs of the beta-cell; reduced secretion is part of the mechanism of rapamycin-associated NODAT."];
  "KETOGENESIS" [label="Ketogenesis", shape=box, style="filled,rounded", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Hepatic production of ketone bodies during fasting; a liver mTORC1-dependent output. mTORC1 suppresses fasting ketogenesis via PPARalpha/NCoR1."];
  "DISEASE_BHD" [label="Birt-Hogg-Dube syndrome", shape=octagon, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Autosomal dominant syndrome of fibrofolliculomas, pulmonary cysts with pneumothorax and renal tumours caused by FLCN loss."];
  "DISEASE_GATOR1_EPILEPSY" [label="GATOR1-related focal epilepsy (FFEVF)", shape=octagon, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Familial focal epilepsies caused by heterozygous loss-of-function variants in DEPDC5, NPRL2 or NPRL3, with elevated SUDEP risk; everolimus titrated to troughs of 5-15 ng/mL gave genotype-dependent, mixed results in small open-label series. Graded emerging, in explicit contrast to established everoli"];
  "DISEASE_SZT2_ENCEPHALOPATHY" [label="SZT2-related developmental and epileptic encephalopathy", shape=octagon, style="filled", fillcolor="#cde2fb", color="#2a78d6", tooltip="Infantile encephalopathy with epilepsy, intellectual disability, macrocephaly and a dysmorphic corpus callosum, caused by biallelic SZT2 mutations."];
  "PHENO_AGE_MEMORY_IMPAIRMENT" [label="Age-associated memory impairment", shape=octagon, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Decline in long-term memory with age; reversed in mice and flies by a small molecule that raises mTORC2 activity, which also enhances L-LTP in wild-type animals."];
  "PHENO_BODY_GROWTH" [label="Whole-body growth", shape=octagon, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Organismal body size and growth trajectory. Adipose-tissue mTORC2 negatively controls whole-body growth, so adipocyte Rictor deletion increases body size - a direction of effect opposite to the usual anabolic framing of mTOR signalling."];
  "PHENO_GLUCOSE_INTOLERANCE" [label="Glucose intolerance / insulin resistance", shape=octagon, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Impaired systemic glucose handling arising chiefly from mTORC2 loss: liver-specific Rictor deletion produces a type-2-diabetes-like phenotype, and chronic rapamycin reproduces it pharmacologically."];
  "PHENO_HYPOTENSION" [label="Hypotension", shape=octagon, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Low systemic arterial pressure resulting from impaired distal nephron sodium reabsorption. Reported together with salt wasting on renal mTORC2 loss, downstream of failed SGK1-dependent activation of ENaC, Na+/K+-ATPase and CLC-K."];
  "PHENO_LONG_TERM_MEMORY" [label="Long-term memory consolidation", shape=octagon, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Persistent memory formation requiring late-phase LTP; selectively impaired by forebrain Rictor deletion while short-term memory is spared."];
  "PHENO_SALT_WASTING" [label="Salt wasting and hypotension", shape=octagon, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Distal-nephron phenotype of renal mTORC2 loss, mediated by failure of SGK1-dependent ENaC and Na+/K+-ATPase regulation; the predicted electrolyte disturbance of mTORC2 inhibition in kidney."];
  "TISSUE_BETA_CELL" [label="Pancreatic β-cell", shape=folder, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Islet cell type in which both complexes are required; β-cell Rictor deletion causes mild hyperglycaemia with reduced β-cell mass, lower AKT Ser473 phosphorylation and nuclear FOXO1 accumulation."];
  "TISSUE_CNS_NEURON" [label="CNS neuron", shape=folder, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Forebrain neurons in which mTORC2 supports actin-dependent consolidation of long-term memory and spine density; the only tissue where mTORC2 loss produces a cognitive rather than metabolic deficit."];
  "TISSUE_HEART" [label="Cardiomyocyte", shape=folder, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Cardiac muscle cell in which mTORC2 is cytoprotective during ischaemia–reperfusion through AKT-dependent anti-apoptotic signalling, so that dual inhibitors are predicted to be more cardiotoxic."];
  "TISSUE_KIDNEY_TUBULE" [label="Renal tubule (distal nephron)", shape=folder, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Aldosterone-sensitive distal nephron, where mTORC2–SGK1 signalling governs sodium handling; tubular mTORC2 loss produces salt wasting and hypotension."];
  "TISSUE_SKELETAL_MUSCLE" [label="Skeletal muscle", shape=folder, style="filled", fillcolor="#fbe0eb", color="#e87ba4", tooltip="Tissue in which mTORC1 is dominant and mTORC2 largely dispensable: muscle-specific Rictor deletion is close to phenotypically silent while Raptor deletion causes dystrophy."];
  "DISEASE_SKS" [label="Smith–Kingsmore syndrome", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Germline gain-of-function MTOR mTORopathy with macrocephaly, intellectual disability and seizures; its phenotype has been extended to include sleep–wake and circadian disturbance, hyperphagia and hyperactivity."];
  "PHENO_CIRCADIAN_AMPLITUDE" [label="Cellular circadian amplitude", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Amplitude of the cellular circadian oscillation, dampened by pathogenic MTOR variants in Smith-Kingsmore syndrome and improved by low-dose rapamycin in engineered U2OS cells expressing SKS-associated MTOR variants."];
  "PHENO_CIRCADIAN_BEHAVIOUR_ABNORMALITY" [label="Circadian behavioural abnormality", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Disrupted period, phase or consolidation of locomotor rhythms in rodent models of mTOR hyperactivation; rescued by reducing Bmal1 gene dosage, implicating BMAL1 proteostasis as the mediating lesion."];
  "PHENO_CIRCADIAN_PERIOD" [label="Circadian period length", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Free-running period of molecular and behavioural rhythms; lengthened by mTOR inhibition in SCN explants, fibroblasts and mice [484]."];
  "PHENO_DELAYED_SLEEP_WAKE_PHASE_DISORDER" [label="Delayed sleep–wake phase disorder", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Circadian rhythm sleep disorder in which habitual sleep onset and offset are shifted substantially later than conventional times; precipitated in some Smith–Kingsmore patients by high-dose rapamycin."];
  "PHENO_HYPERACTIVITY" [label="Hyperactivity", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Recognised feature of Smith–Kingsmore syndrome in the same cohort [361], reported alongside sleep–wake disturbance."];
  "PHENO_HYPERPHAGIA" [label="Hyperphagia", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Recognised feature of Smith–Kingsmore syndrome in the 28-individual cohort [361]; mechanistically expected from hypothalamic mTORC1 nutrient sensing."];
  "PHENO_PHOTIC_ENTRAINMENT" [label="Photic entrainment", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Light-induced phase shifting and re-entrainment of behavioural rhythms; an mTOR-modulated output [79,484]."];
  "PHENO_PREMATURE_AGEING" [label="Premature ageing phenotype", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Accelerated age-related pathology (cataracts, organ atrophy, shortened lifespan) seen in Bmal1-null mice and attributed in part to unrestrained mTORC1 signalling."];
  "PHENO_SLEEP_WAKE_DISTURBANCE" [label="Sleep–wake disturbance", shape=octagon, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Disturbed sleep timing, maintenance and quality; a recognised feature of Smith–Kingsmore syndrome and a proposed monitoring endpoint for mTOR-directed therapy."];
  "SCN" [label="Suprachiasmatic nucleus", shape=folder, style="filled", fillcolor="#d6ead6", color="#008300", tooltip="Hypothalamic master pacemaker; receives retinal photic input, synchronises peripheral clocks, and depends on VIP signalling for network synchrony. mTOR signalling here modulates photic entrainment and central clock function."];
  "DISEASE_AD" [label="Alzheimer's disease", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Target of the autophagy-based mTOR-inhibition rationale; supported by 3xTg-AD mouse data but with no controlled human efficacy data - the ERAP phase IIa study of weekly oral rapamycin uses FDG-PET cerebral glucose metabolism as its primary outcome."];
  "DISEASE_ANGIOMYOLIPOMA" [label="Renal angiomyolipoma", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="TSC-associated (or sporadic LAM-associated) renal tumour; EXIST-2 indication, with 42% of everolimus-treated patients achieving at least 50% reduction."];
  "DISEASE_BREAST_CANCER" [label="HR+/HER2- advanced breast cancer", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Hormone receptor-positive, HER2-negative advanced breast cancer progressing on an aromatase inhibitor; the single disease in which the mTOR, PI3K and AKT nodes have been tested in separate randomised trials."];
  "DISEASE_CANCER" [label="Cancer (advanced solid tumours)", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Mixed population of advanced solid tumours, 58% carrying pathogenic mTOR-pathway variants, enrolled in the first-in-human bi-steric inhibitor study."];
  "DISEASE_ENDOMETRIAL_CANCER" [label="Endometrial carcinoma", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Carcinoma with PIK3CA mutation in roughly 30% and PTEN loss in roughly 35% of cases; site of the complete response to RMC-5552."];
  "DISEASE_FCD2" [label="Focal cortical dysplasia type II", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Cortical malformation from somatic mosaic activating variants confined to the dysplastic cortex, with drug-resistant focal epilepsy treated surgically."];
  "DISEASE_FSGS" [label="Focal segmental glomerulosclerosis", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Glomerular scarring produced in mice by podocyte Tsc1 deletion, the upper limb of the podocyte Goldilocks requirement."];
  "DISEASE_GLIOBLASTOMA" [label="Glioblastoma", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="PTEN is lost in approximately 40% of glioblastomas, the highest frequency of PTEN loss among these tumour types."];
  "DISEASE_HD" [label="Huntington's disease", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Polyglutamine expansion disorder; mTOR inhibition by rapamycin or the ester analogue CCI-779 (temsirolimus) induces autophagy and reduces polyglutamine toxicity in fly and mouse models."];
  "DISEASE_HME" [label="Hemimegalencephaly", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Hemispheric brain enlargement with severe epilepsy from somatic mosaic activation of MTOR, PIK3CA or AKT3; mTOR inhibition investigational."];
  "DISEASE_LAM" [label="Lymphangioleiomyomatosis", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Progressive cystic lung disease driven by TSC2-deficient smooth-muscle-like cells, sporadic or TSC-associated; an approved sirolimus indication."];
  "DISEASE_NET" [label="Neuroendocrine tumour", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Well-differentiated pancreatic, gastrointestinal and lung neuroendocrine tumours; a lineage dependency without a defined pathway lesion, treated with everolimus on RADIANT-3 and RADIANT-4."];
  "DISEASE_PD" [label="Parkinson's disease", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Alpha-synuclein proteinopathy; rapamycin protects against neuron death in in vitro and in vivo models, with autophagic clearance as the proposed mechanism. Preclinical only."];
  "DISEASE_PECOMA" [label="Malignant PEComa", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Malignant PEComa; the nab-sirolimus indication from AMPECT, with response enriched in TSC2-mutant tumours."];
  "DISEASE_PHTS" [label="PTEN hamartoma tumour syndrome", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Germline PTEN loss spanning Cowden and Bannayan-Riley-Ruvalcaba syndromes, with hamartomas, macrocephaly and elevated breast, thyroid and endometrial cancer risk."];
  "DISEASE_PJS" [label="Peutz-Jeghers syndrome", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Germline STK11 (LKB1) loss causing hamartomatous gastrointestinal polyposis, mucocutaneous pigmentation and elevated cancer risk."];
  "DISEASE_PKD" [label="Polycystic kidney disease", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Cystic kidney disease in which elevated mTORC1 activity contributes to cyst growth; trials limited by dose-related toxicity rather than absent rationale."];
  "DISEASE_PMSE" [label="PMSE syndrome", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Polyhydramnios, megalencephaly and symptomatic epilepsy syndrome; autosomal recessive STRADA loss with impaired LKB1-AMPK signalling and mTORC1 hyperactivation; rapamycin reduces seizures (preclinical and small clinical evidence)."];
  "DISEASE_PROS" [label="PIK3CA-related overgrowth spectrum", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Mosaic somatic PIK3CA activating variants causing segmental overgrowth (CLOVES, megalencephaly-capillary malformation, isolated macrodactyly)"];
  "DISEASE_PROSTATE_CANCER" [label="Prostate carcinoma", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="PTEN is lost in approximately 30% of prostate cancers."];
  "DISEASE_PROTEUS" [label="Proteus syndrome", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Mosaic overgrowth disorder caused by the somatic activating AKT1 E17K variant"];
  "DISEASE_RCC" [label="Renal cell carcinoma", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Clear-cell renal carcinoma; an approved rapalog indication in which benefit plausibly runs through HIF-dependent translation and the angiogenic programme rather than a cell-autonomous mTORC1 dependency."];
  "DISEASE_SEGA" [label="Subependymal giant cell astrocytoma", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="TSC-associated low-grade glioneuronal tumour; the EXIST-1 indication, with roughly 35% of everolimus-treated patients achieving at least 50% volume reduction versus 0% on placebo."];
  "DISEASE_TSC" [label="Tuberous sclerosis complex", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Germline TSC1 or TSC2 loss with somatic second hits producing SEGA, angiomyolipoma, LAM and epilepsy; the indication in which the rapalog mechanistic rationale is fully borne out."];
  "DISEASE_UROTHELIAL_CARCINOMA" [label="Urothelial carcinoma", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Bladder cancer providing the exceptional-responder evidence for proximal-brake dependency, with TSC1 mutations in roughly 8% of a 109-tumour series."];
  "PHENO_ANABOLIC_RESISTANCE" [label="Anabolic resistance", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Blunted muscle protein synthesis response to amino acids and loading in ageing muscle, with elevated basal signalling and attenuated acute response: a compressed dynamic range."];
  "PHENO_ASTROCYTE_PROLIFERATION" [label="Astrocyte proliferation", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Reactive astrocytosis accompanying microglial Tsc1 deletion, alongside reduced synapse density and early-onset spontaneous recurrent seizures."];
  "PHENO_AUTISM_LIKE_BEHAVIOUR" [label="Autism-like behaviour", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Social-interaction and repetitive-behaviour deficits produced by 4E-BP2 loss, demonstrating that excessive as well as deficient translational signalling is deleterious in neurons."];
  "PHENO_BETA_CELL_FAILURE" [label="Beta-cell dedifferentiation and failure", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Initial expansion of mass and secretion under chronic mTORC1 hyperactivation followed by dedifferentiation through ER stress and suppressed autophagy."];
  "PHENO_BETA_CELL_MASS" [label="Beta-cell mass and maturation", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Functional beta-cell number and maturity; impaired by beta-cell Raptor deletion and reduced, with elevated p27, by beta-cell Rictor deletion."];
  "PHENO_CARDIAC_HYPERTROPHY" [label="Physiological cardiac hypertrophy", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Adaptive cardiomyocyte growth supported by mTORC1; sustained activity instead contributes to maladaptive remodelling."];
  "PHENO_CARDIOPROTECTION" [label="Cardiomyocyte cytoprotection", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="AKT-dependent anti-apoptotic protection of cardiomyocytes during ischaemia-reperfusion, supplied by mTORC2."];
  "PHENO_CD8_MEMORY" [label="CD8 memory T cell quantity and quality", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Number and functional quality of memory CD8 T cells generated after acute viral infection; enhanced rather than suppressed by low-dose rapamycin, T cell-intrinsically and across species."];
  "PHENO_CELLULAR_SENESCENCE" [label="Cellular senescence", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Stable cell-cycle arrest with an inflammatory secretome; rapamycin attenuates the consequences of senescence without eliminating senescent cells, so efficacy of an intervention does not establish causal primacy."];
  "PHENO_CYTOPENIA" [label="Cytopenia", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Anaemia, neutropenia and thrombocytopenia on rapalogs, attributed to the proliferative requirement for mTORC1 in haematopoiesis."];
  "PHENO_DILATED_CARDIOMYOPATHY" [label="Dilated cardiomyopathy", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Fatal phenotype of complete cardiomyocyte mTOR deletion, marking the lower bound of the cardiac therapeutic window."];
  "PHENO_FAT_MASS" [label="Fat mass", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Whole-body adiposity; reduced in adipocyte-specific Raptor-null mice, which are lean with enhanced mitochondrial respiration."];
  "PHENO_FOOD_INTAKE" [label="Food intake", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Hypothalamic (arcuate nucleus) control of feeding; intracerebroventricular leucine and leptin suppress food intake through mTORC1, rapamycin abolishes that suppression, and rapamycin partially corrects the hyperphagic obesity of POMC-neuron Tsc1 deletion."];
  "PHENO_HEPATIC_STEATOSIS" [label="Hepatic steatosis", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Hepatic triglyceride accumulation driven by SREBP1c lipogenesis under hyperinsulinaemia; paradoxically prevented by liver-specific Tsc1 deletion."];
  "PHENO_HYPERPHAGIC_OBESITY" [label="Hyperphagic obesity", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Overeating with weight gain produced by Tsc1 deletion in POMC neurons and partially corrected by rapamycin; mechanistically expected in Smith-Kingsmore syndrome."];
  "PHENO_HYPERTRIGLYCERIDAEMIA" [label="Hypertriglyceridaemia and hypercholesterolaemia", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Dose-related elevation of triglycerides and cholesterol on mTOR inhibitors, reflecting altered hepatic and adipose lipid handling by both complexes."];
  "PHENO_IMMUNOSENESCENCE" [label="Immunosenescence", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Thymic involution, naive repertoire contraction, PD-1+ exhausted-like cells and inflammaging; the most productive clinical testing ground for geroprotection."];
  "PHENO_INSULIN_RESISTANCE" [label="Peripheral insulin resistance", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Reduced insulin-stimulated glucose disposal in peripheral tissues. Distinct from direct beta-cell toxicity: chronic mTORC2 loss produces peripheral insulin resistance, and the two mechanisms together account for rapamycin-associated new-onset diabetes at immunosuppressive exposures."];
  "PHENO_ISG_EXPRESSION" [label="Interferon-stimulated antiviral gene expression", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Upregulation of interferon-stimulated antiviral genes reported with RTB101 plus low-dose everolimus; the mechanistic correlate of the reduced laboratory-confirmed respiratory infections in that phase 2b."];
  "PHENO_LEAN_MASS" [label="Lean tissue mass", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Fat-free body mass"];
  "PHENO_LIFESPAN_EXTENSION" [label="Lifespan extension", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Increase in median and maximal lifespan in genetically heterogeneous mice given encapsulated rapamycin from 600 days of age, reproduced across three sites and dose- and sex-dependent."];
  "PHENO_MALADAPTIVE_REMODELLING" [label="Maladaptive cardiac remodelling", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Pathological hypertrophic remodelling driven by sustained mTORC1 activity, distinct from the physiological hypertrophy that mTORC1 also supports; attenuated by partial inhibition in multiple models."];
  "PHENO_MICROGLIAL_ACTIVATION" [label="Amoeboid phagocytic microglial phenotype", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Amoeboid, highly proliferative and phagocytic microglial state produced by Tsc1 loss, notably without a pro-inflammatory cytokine signature."];
  "PHENO_MUSCLE_ATROPHY" [label="Denervation muscle atrophy", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Loss of myofibre mass after denervation; prevented by constitutively active AKT, establishing sufficiency of the AKT-mTOR arm for maintenance of muscle mass."];
  "PHENO_MUSCLE_DYSTROPHY" [label="Muscular dystrophy (Raptor-null)", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Progressive dystrophy with impaired oxidative capacity and shortened lifespan after muscle-specific Raptor deletion; the phenotype against which near-silent Rictor deletion is contrasted."];
  "PHENO_MUSCLE_HYPERTROPHY" [label="Load-induced muscle hypertrophy", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Hypertrophic growth of skeletal muscle in response to IGF-1, mechanical overload or chronic stimulation; mTORC1 is necessary and sufficient and rapamycin blocks it, which is the basis of the anabolic-resistance safety concern for chronic geroprotective dosing."];
  "PHENO_MYELINATION" [label="Myelination", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Formation and thickness of myelin sheaths; requires oligodendrocyte mTORC1, with spinal cord affected more than corpus callosum."];
  "PHENO_NEURODEGENERATION" [label="Neurodegeneration", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Progressive neuronal loss with ubiquitin-positive inclusions and motor deficits, produced by neural Atg5 or Atg7 deletion alone."];
  "PHENO_OLIGODENDROCYTE_DIFFERENTIATION" [label="Oligodendrocyte differentiation", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Maturation of oligodendrocyte precursors; impaired only in the Raptor/Rictor double mutant, indicating that mTORC2 contributes but is not rate-limiting while mTORC1 remains intact."];
  "PHENO_OSTEOBLAST_DIFFERENTIATION" [label="Osteoblast differentiation", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Bone-forming cell differentiation requiring mTOR signalling."];
  "PHENO_OSTEOCLAST_DIFFERENTIATION" [label="Osteoclast differentiation", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Bone-resorbing cell differentiation also requiring mTOR, which is why the net skeletal effect of inhibition is context-dependent."];
  "PHENO_PD1_T_CELLS" [label="PD-1+ CD4 and CD8 T cell fraction", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Accumulation of PD-1-positive CD4 and CD8 T cells with age; fractions fell in older adults given low-dose everolimus before influenza vaccination."];
  "PHENO_PROTEINURIA" [label="Proteinuria", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Urinary protein loss on mTOR inhibitors, reflecting the podocyte requirement for mTORC1 and disrupted podocyte autophagic flux."];
  "PHENO_RAPALOG_SENSITIVITY" [label="Rapalog sensitivity", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Tumour responsiveness to allosteric mTORC1 inhibition; predicted by proximal-brake lesions as enrichment rather than individual prediction, and not by distal-network lesions."];
  "PHENO_SARCOPENIA" [label="Sarcopenia", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Age-related loss of muscle mass and function; the predicted consequence of chronic mTOR inhibition in skeletal muscle, and the central safety question for geroscience dosing."];
  "PHENO_SEIZURES" [label="Spontaneous recurrent seizures", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Epileptic seizures; the shared endpoint of the mTORopathies and of microglial Tsc1 loss, with elevated SUDEP risk in GATOR1 epilepsies."];
  "PHENO_SPINE_DENSITY" [label="Dendritic spine density", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Density of dendritic spines, which falls when forebrain mTORC2 activity and Tiam1–Rac1-dependent actin polymerisation are reduced."];
  "PHENO_SUDEP" [label="Sudden unexpected death in epilepsy", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Elevated risk carried by the GATOR1-related familial focal epilepsies, which is part of why mTOR-directed therapy in this group is being pursued on limited evidence."];
  "PHENO_TH1_TH17" [label="Th1 and Th17 differentiation", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Effector CD4 lineages requiring Rheb-mTORC1; their suppression is part of the immunosuppressive action of rapalogs."];
  "PHENO_TREG_EXPANSION" [label="Regulatory T cell expansion", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Preferential survival and expansion of CD4+CD25+Foxp3+ regulatory T cells under mTOR inhibition, while effector differentiation is blocked; the basis of the immunosuppressive use of rapamycin."];
  "PHENO_T_CELL_SURVIVAL" [label="T-cell survival signalling", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="AKT-dependent survival output; the second mTORC2-dependent arm in T lymphocytes alongside Th2 differentiation."];
  "PHENO_VACCINE_RESPONSE" [label="Influenza vaccine antibody response", shape=octagon, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Placebo-corrected rise in haemagglutination-inhibition titre after influenza vaccination in adults aged 65 and over; the endpoint demonstrating an inverted-U dose-response to mTOR inhibition."];
  "TISSUE_ADIPOSE" [label="Adipose tissue", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Tissue in which adipocyte Rictor deletion reduces insulin-stimulated glucose uptake, alters ChREBP-driven lipogenesis and lipid handling, and negatively controls whole-body growth."];
  "TISSUE_BONE" [label="Bone", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Skeletal tissue; mTOR signalling is required for both osteoblast and osteoclast differentiation, so the net effect of inhibition is context-dependent."];
  "TISSUE_HAEMATOPOIETIC" [label="Haematopoietic compartment", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Marrow progenitor compartment whose proliferative mTORC1 requirement accounts for rapalog cytopenias; TSC-mTOR signalling also sets stem-cell quiescence."];
  "TISSUE_HYPOTHALAMUS" [label="Hypothalamic arcuate neuron", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Arcuate neurons in which mTORC1 acts as a nutrient sensor rather than a growth regulator, integrating leucine and leptin into control of food intake."];
  "TISSUE_KIDNEY_PODOCYTE" [label="Kidney podocyte", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Glomerular epithelial cell with a calibrated Goldilocks requirement: both Tsc1 deletion and Raptor deletion produce injury and proteinuria."];
  "TISSUE_LIVER" [label="Liver", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Tissue in which the two complexes act in opposite directions on glucose output: mTORC1 drives SREBP1c lipogenesis while mTORC2 restrains gluconeogenesis through AKT–FOXO1."];
  "TISSUE_MICROGLIA" [label="Microglia", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Resident CNS macrophage; Tsc1 deletion restricted to microglia produces an amoeboid proliferative phagocytic phenotype and severe early-onset seizures."];
  "TISSUE_OLIGODENDROCYTE" [label="Oligodendrocyte", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Oligodendrocyte-lineage cells of the CNS. Conditional deletion cleanly separates the two complexes: mTORC1 is rate-limiting for myelination, mTORC2 contributes but is not rate-limiting while mTORC1 remains intact. The requirement is regional, spinal cord being affected more than corpus callosum."];
  "TISSUE_ORAL_EPITHELIUM" [label="Oral epithelium", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="Rapidly renewing mucosal epithelium whose mTORC1 dependence accounts for rapalog stomatitis and the dose-limiting mucositis of bi-steric agents."];
  "TISSUE_T_LYMPHOCYTE" [label="T lymphocyte", shape=folder, style="filled", fillcolor="#e0dcf5", color="#4a3aa7", tooltip="T lymphocyte compartment. The only tissue in which inhibition of the pathway produces the desired rather than an adverse effect: partial mTORC1 inhibition expands Tregs and enhances CD8 memory, which is the basis of rapalog immunosuppression and of the immune-function geroscience hypothesis."];
  "DISEASE_ALLOGRAFT_REJECTION" [label="Renal allograft rejection", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Alloimmune destruction of a transplanted kidney; the first approved indication for sirolimus, given at continuous immunosuppressive exposures with trough monitoring."];
  "DISEASE_NODAT" [label="New-onset diabetes after transplantation", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Diabetes arising at immunosuppressive mTOR-inhibitor exposures; mechanistically beta-cell toxicity plus mTORC2-dependent peripheral insulin resistance"];
  "PHENO_AMYLOID_BETA" [label="Brain amyloid-beta burden", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Cerebral amyloid-beta accumulation, reduced by rapamycin in 3xTg-AD mice in an autophagy-dependent manner and largely only when treatment precedes substantial pathology."];
  "PHENO_ANGIOMYOLIPOMA" [label="Renal angiomyolipoma", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="TSC-associated renal tumour; 42% of patients achieved at least 50% reduction on everolimus (EXIST-2)."];
  "PHENO_CNS_DRUG_EXPOSURE" [label="CNS drug exposure", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Concentration of an mTOR inhibitor achieved in brain relative to blood; restricted and saturable for sirolimus and everolimus, so central and peripheral exposure-response relationships do not coincide."];
  "PHENO_FATIGUE" [label="Fatigue", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Treatment-related fatigue, reported in 42% of patients in the RMC-5552 first-in-human dose-escalation study."];
  "PHENO_HYPERCHOLESTEROLAEMIA" [label="Hypercholesterolaemia", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Elevated plasma cholesterol during mTOR-inhibitor therapy; occurs alongside hypertriglyceridaemia and is attributed to altered hepatic and adipose lipid handling (mTORC2 and mTORC1)."];
  "PHENO_HYPERGLYCAEMIA" [label="Hyperglycaemia", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Elevated blood glucose on mTOR inhibitors, attributed chiefly to mTORC2 loss (peripheral insulin resistance) with a beta-cell contribution"];
  "PHENO_IMPAIRED_WOUND_HEALING" [label="Impaired wound healing", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Delayed surgical healing and lymphocele formation on mTOR inhibitors, attributed to suppressed angiogenesis and fibroblast proliferation; managed by perioperative interruption."];
  "PHENO_INFECTION" [label="Infection", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Increased infection risk at immunosuppressive exposures, following from suppression of effector lymphocyte expansion; dose- and schedule-dependent and not seen consistently at low intermittent exposures."];
  "PHENO_NAUSEA" [label="Nausea", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Treatment-related nausea, the second most frequent adverse event (44%) in the RMC-5552 first-in-human dose-escalation study."];
  "PHENO_PNEUMONITIS" [label="Non-infectious pneumonitis", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Non-infectious interstitial lung inflammation in roughly 5-15% of oncology patients receiving everolimus; the most serious and least mechanistically understood rapalog toxicity."];
  "PHENO_PROTEIN_AGGREGATES" [label="Misfolded protein aggregates", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Aggregation-prone substrates cleared by macroautophagy (alpha-synuclein, polyglutamine-expanded huntingtin), reduced by rapamycin or temsirolimus in fly and mouse models."];
  "PHENO_RESPIRATORY_INFECTION" [label="Respiratory tract infection", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Respiratory infections in older adults; ascertainment differs between participant-reported events in the phase 2a study and laboratory-confirmed events in phase 2b."];
  "PHENO_SEGA" [label="Subependymal giant cell astrocytoma", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="TSC-associated brain tumour; approximately 35% of patients achieved at least 50% volume reduction on everolimus versus 0% on placebo (EXIST-1)."];
  "PHENO_STOMATITIS" [label="Stomatitis / mucositis", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Painful oral ulceration affecting roughly 30-60% of patients on rapalogs and 49% in the RMC-5552 phase 1 study; reflects mTORC1 dependence of renewing oral epithelium and is largely preventable."];
  "PHENO_SYMPTOMATIC_RESPIRATORY_ILLNESS" [label="Clinically symptomatic respiratory illness", shape=octagon, style="filled", fillcolor="#fbd9d8", color="#e34948", tooltip="Self-reported symptomatic respiratory illness; the subjective phase 3 endpoint that RTB101 monotherapy failed to meet in 1024 older adults."];
