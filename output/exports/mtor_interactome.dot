  "AKG" -> "RAG_HETERODIMER" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Alpha-ketoglutarate promotes GTP loading of RagB and lysosomal translocation of mTORC1, reportedly through prolyl hydroxylase activity"];
  "AMINO_ACIDS" -> "FLCN" [arrowhead=odot, color="#898781", style=solid, tooltip="Amino-acid withdrawal recruits folliculin to lysosomes, where it binds RagA and is held in an inactive lysosomal complex; amino-acid restoration releases it and licenses RagC/D GTP hydrolysis, supporting Rag-dependent recruitment of mTORC1."];
  "AMINO_ACIDS" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Amino-acid sufficiency promotes translocation of mTORC1 from a diffuse cytosolic pool to the lysosomal surface, where it encounters its proximate activator Rheb.GTP"];
  "AMINO_ACIDS" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Autophagy-derived amino acids reactivate mTORC1, so the autophagy-mTORC1 system oscillates rather than behaving as a switch"];
  "AMINO_ACIDS" -> "V_ATPASE" [arrowhead=odot, color="#898781", style=solid, tooltip="Luminal amino acids act through the v-ATPase, in a manner requiring its ATP hydrolysis, to weaken its interaction with Ragulator at the V1 sector without changing lysosomal pH; this conformational relay is the first step of inside-out signalling to the Rag GTPases."];
  "AMINO_ACID_STARVATION" -> "EIF2AK4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Uncharged tRNAs accumulating during amino-acid deprivation bind the GCN2 HisRS-like domain, relieving autoinhibition and activating the kinase."];
  "ARGININE" -> "CASTOR1" [arrowhead=tee, color="#d03b3b", style=solid, label="ACT2-ACT4 interface pocket", tooltip="Arginine binds CASTOR1 with a dissociation constant of about 30 µM in a pocket at the interface of its ACT2 and ACT4 domains, triggering a conformational change that releases GATOR2."];
  "ARGININE" -> "SLC38A9" [arrowhead=normal, color="#0ca30c", style=solid, label="substrate pocket in the transmembrane bundle", tooltip="Arginine binds the SLC38A9 transmembrane pocket; the cytosolic N terminus relays amino-acid availability to Rag-associated machinery."];
  "CHOLESTEROL" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Net effect of the SLC38A9-NPC1 signalling complex: lysosomal cholesterol sufficiency promotes mTORC1 activation independently of amino acids"];
  "CHOLESTEROL" -> "SLC38A9" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="SLC38A9 senses lysosomal cholesterol through conserved cholesterol-responsive motifs in its transmembrane region; this sterol input, separable from arginine sensing, drives Rag-dependent recruitment and activation of mTORC1."];
  "GDP" -> "RRAGC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="RagC/D must be GDP-loaded for the asymmetric, mTORC1-competent configuration; RagC.GTP yields the inactive heterodimer"];
  "GDP" -> "RRAGD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="RagD-GDP, generated by FLCN-FNIP GAP activity, is the configuration that together with RagA/B-GTP makes the heterodimer competent to recruit mTORC1"];
  "GLUTAMINE" -> "AKG" [arrowhead=vee, color="#898781", style=solid, tooltip="Glutaminolysis converts glutamine via glutamate to alpha-ketoglutarate, the metabolite that links anaplerotic flux to Rag loading"];
  "GLUTAMINE" -> "ARF1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Glutamine activates mTORC1 through an Arf1-dependent route that persists in RagA/B-deficient cells and requires the v-ATPase; this arm runs in parallel with Rag-dependent glutamine inputs such as glutaminolysis."];
  "GLUTAMINE" -> "GLUTAMINE_ANAPLEROSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glutamine supplies carbon, via glutamate and alpha-ketoglutarate, and nitrogen for TCA-cycle anaplerosis in proliferating cells."];
  "GTP" -> "RRAGA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="GTP loading of RagA/B is the nucleotide state that confers Raptor binding on the heterodimer; the reciprocal state releases mTORC1 to the cytosol"];
  "GTP" -> "RRAGB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="GTP loading of RagB (the RagA paralogue) generates the signalling-competent RagB-GTP state that binds the Raptor claw"];
  "LEUCINE" -> "GLUD1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Leucine allosterically activates glutamate dehydrogenase (GLUD1), increasing conversion of glutamate to alpha-ketoglutarate during glutaminolysis."];
  "LEUCINE" -> "LARS1" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="Leucyl-tRNA synthetase was proposed to act as an intracellular leucine sensor, coupling leucine charging status to mTORC1"];
  "LEUCINE" -> "SAR1B" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Leucine binds SAR1B and causes it to dissociate from GATOR2, relieving SAR1B-mediated inhibition of mTORC1; without leucine, SAR1B binds GATOR2 and inhibits mTORC1."];
  "LEUCINE" -> "SESN1" [arrowhead=tee, color="#d03b3b", style=dashed, label="C-terminal leucine-binding pocket", tooltip="Sestrin1 binds leucine to a similar extent as Sestrin2, through the C-terminal pocket conserved between them, and leucine releases endogenous Sestrin1 from GATOR2."];
  "LEUCINE" -> "SESN2" [arrowhead=tee, color="#d03b3b", style=solid, label="C-terminal leucine-binding pocket", tooltip="Free leucine binds Sestrin2 with a dissociation constant of approximately 20 uM through a C-terminal pocket, disrupting its grip on GATOR2"];
  "LEUCINE" -> "PHENO_FOOD_INTAKE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Intracerebroventricular leucine raises hypothalamic S6K1 phosphorylation and suppresses food intake and body weight; rapamycin abolishes the effect."];
  "LEUCINE" -> "PROTEIN_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="The protein-feeding dose-response shifts rightward with age, so a per-meal leucine threshold of roughly 3-4 g is proposed to maximise synthesis in older adults."];
  "LEUCINE" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr389", tooltip="An oral bolus of roughly 3.4 g free leucine acutely stimulates human muscle protein synthesis and raises S6K1 Thr389 phosphorylation, which remains elevated for about 90 minutes."];
  "METHIONINE" -> "SAM" [arrowhead=vee, color="#898781", style=solid, tooltip="Methionine is converted to S-adenosylmethionine, so SAM concentration reports dietary methionine availability to the SAMTOR arm"];
  "SAM" -> "SAMTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="SAM binds SAMTOR with a Kd of approximately 7 uM; binding relieves SAMTOR-promoted GATOR1 activity"];
  "VAR_NPRL2_LOF" -> "DISEASE_GATOR1_EPILEPSY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="NPRL2 loss of function causes familial focal epilepsy of the GATOR1 spectrum through unopposed RagA/B-GTP loading and mTORC1 hyperactivity, with a focal cortical malformation in a minority of patients. In a small open-label series of NPRL2- and NPRL3-related epilepsy, add-on everolimus reduced seizu"];
  "VAR_NPRL2_LOF" -> "NPRL2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss-of-function NPRL2 variants remove the catalytic arginine-finger subunit, abolishing GATOR1 GAP activity toward RagA/B."];
  "VAR_NPRL2_LOF" -> "GATOR1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Heterozygous NPRL2 loss impairs the GATOR1 GAP for RagA/B and raises mTORC1 activity."];
  "VAR_NPRL2_LOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="GATOR1 loss (DEPDC5, NPRL2, NPRL3) belongs to the proximal-brake class and is somatic."];
  "ANDROGEN" -> "AR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Testosterone/DHT bind the androgen receptor, driving its nuclear and non-genomic activity."];
  "ESTROGEN" -> "ESR1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="17β-estradiol binds ERα, enabling both genomic transcription and rapid non-genomic signalling to PI3K–AKT."];
  "IGF1" -> "IGF1R" [arrowhead=normal, color="#0ca30c", style=solid, label="Tyr1131, Tyr1135, Tyr1136 (β-subunit autophosphorylation)", tooltip="IGF-1 binding to IGF-1R induces β-subunit autophosphorylation and IRS/Shc docking; shares the IRS–PI3K–AKT route to TSC2/mTORC1 with insulin."];
  "INFLAMMATION" -> "IKBKB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic inflammatory signalling activates the IKK complex (IKKβ), which besides NF-κB engages TSC1; proposed link between inflammation and anabolic dysregulation of ageing tissue."];
  "INSULIN" -> "INSR" [arrowhead=normal, color="#0ca30c", style=solid, label="Tyr1158, Tyr1162, Tyr1163 (β-subunit autophosphorylation)", tooltip="Insulin binds the INSR α-subunit ectodomain, triggering β-subunit trans-autophosphorylation and creating docking sites for IRS proteins and Shc."];
  "INSULIN" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Insulin and IGF-1 receptor engagement activates class I PI3K through IRS proteins, generating the PIP3 signal upstream of mTORC2."];
  "LEPTIN" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The anorectic action of leptin requires intact hypothalamic mTOR signalling, making mTORC1 a nutrient and adiposity sensor rather than a growth regulator here."];
  "LEPTIN" -> "PHENO_FOOD_INTAKE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The anorectic action of leptin requires intact hypothalamic mTOR signalling."];
  "MECHANICAL_LOAD" -> "DGKZ" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Eccentric contraction or stretch increases DGKζ-dependent PA synthesis; DGKζ overexpression is sufficient to induce fibre hypertrophy."];
  "MECHANICAL_LOAD" -> "PLD1" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="Mechanical stretch and eccentric contraction were reported to raise phosphatidic acid in skeletal muscle through phospholipase D, independently of ERK and PI3K; later work from the same laboratory found that phospholipase D activity does not rise with loading and that the mechanically induced phosph"];
  "MECHANICAL_LOAD" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Eccentric contractions increase TSC2 RxRxxS/T-motif phosphorylation and move TSC2 away from the lysosome while mTOR associates with it; responsible kinase not defined."];
  "RESISTANCE_EXERCISE" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Resistance exercise and mechanical overload activate mTORC1 in skeletal muscle, and rapamycin blocks the contraction-induced rise in human muscle protein synthesis. The proximal mechanism involves a rise in phosphatidic acid together with membrane perturbation and focal-adhesion signalling, but the "];
  "TNF" -> "IKBKB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TNF-alpha engagement of TNFR1 activates the IKK complex, including IKK-beta, through the receptor-proximal adaptors TRADD, TRAF2 and TAK1; the relationship is indirect rather than a direct contact between TNF-alpha and IKK-beta."];
  "VAR_TBC1D7_LOF" -> "TBC1D7" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Biallelic truncating TBC1D7 variants destabilise the TSC complex and increase mTORC1 activity, causing macrocephaly/megalencephaly with intellectual disability."];
  "WNT" -> "GSK3B" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Canonical Wnt signalling (Dishevelled/LRP6–Axin) inhibits GSK3, preventing TSC2 Ser1337/1341 phosphorylation and thereby activating mTORC1 independently of β-catenin."];
  "A769662" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="A-769662 binds the ADaM site between the alpha kinase domain and beta1 carbohydrate-binding module, allosterically activating AMPK and protecting pThr172; beta1-selective, no AMP mimicry."];
  "ADP" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="ADP binds the AMPK gamma-subunit nucleotide sites and protects phospho-Thr172 from dephosphorylation without causing allosteric activation."];
  "AICAR" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="AICAR is taken up and phosphorylated to ZMP, an AMP mimetic that binds the AMPK gamma subunit, allosterically activating AMPK and promoting Thr172 phosphorylation; has AMPK-independent effects."];
  "AMP" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="AMP binds CBS sites 1 and 3 of the gamma subunit, allosterically activating AMPK (2-5 fold), promoting Thr172 phosphorylation by LKB1 and protecting pThr172 from phosphatases."];
  "ATP" -> "AMPK" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Mg-free ATP competes with AMP/ADP for the gamma-subunit CBS sites; at high energy charge ATP occupancy keeps AMPK in the inactive, phosphatase-accessible state."];
  "CALCIUM" -> "CAMKK2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ca2+/calmodulin binding relieves CaMKK2 autoinhibition, enabling it to phosphorylate AMPK (and CaMKI/IV)."];
  "CALCIUM" -> "PPP3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Local lysosomal Ca2+ binds calmodulin and activates calcineurin adjacent to the lysosomal surface"];
  "CALORIC_RESTRICTION" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Reduced energy intake lowers cellular energy charge and insulin, reported to increase AMPK activity in liver and muscle, converging with metformin and exercise on the AMPK-TSC2/Raptor brake on mTORC1."];
  "CALORIC_RESTRICTION" -> "CIRCADIAN_CLOCK" [arrowhead=odot, color="#898781", style=solid, tooltip="Restricted feeding is the dominant entraining cue for peripheral oscillators, shifting the phase of hepatic circadian gene expression by up to twelve hours while leaving the suprachiasmatic clock unchanged, and caloric restriction likewise reprograms hepatic clock gene expression."];
  "CALORIC_RESTRICTION" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Caloric restriction lowers hepatic mTORC1 activity at some times of day while having no effect, or the opposite effect, at others, so the measured response depends on when liver is sampled relative to the feeding schedule."];
  "DNA_DAMAGE" -> "ATM" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser1981", tooltip="DNA double-strand breaks recruit MRN, which activates ATM by intermolecular autophosphorylation (Ser1981) and dimer dissociation."];
  "DNA_DAMAGE" -> "TP53" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser15, Ser20", tooltip="Genotoxic stress activates ATM/ATR and CHK2, which phosphorylate p53 at Ser15 and Ser20, weakening MDM2 binding and stabilising p53; p53 then induces mTORC1-suppressing target genes, including SESN1 and SESN2."];
  "ENERGY_STRESS" -> "AMP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="When ATP consumption exceeds production, adenylate kinase (2 ADP <-> ATP + AMP) amplifies the AMP rise so AMP:ATP changes roughly as the square of ADP:ATP, making AMP the sensitive low-energy signal."];
  "ENERGY_STRESS" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Energy stress (rising AMP/ADP:ATP) activates AMPK through gamma-subunit nucleotide binding and LKB1-dependent Thr172 phosphorylation; AMPK then inhibits mTORC1 via TSC2 and Raptor."];
  "ENERGY_STRESS" -> "DDIT4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Energy stress (2-deoxyglucose, glucose deprivation) induces REDD1 through ATF4; REDD1 is required for mTORC1 inhibition in this setting, partly independently of AMPK."];
  "ER_STRESS" -> "EIF2AK3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Unfolded-protein load releases BiP/GRP78 from the PERK luminal domain; PERK dimerises and autophosphorylates, launching the integrated stress response."];
  "EXERCISE" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Contractile activity raises AMP/ADP:ATP and creatine/phosphocreatine turnover in muscle fibres, increasing LKB1-dependent AMPK Thr172 phosphorylation in an intensity-dependent manner."];
  "EXERCISE" -> "ENERGY_STRESS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Muscle contraction consumes ATP faster than oxidative phosphorylation replenishes it, so ADP and, through adenylate kinase, AMP rise, and this energy-stress state activates AMPK in proportion to exercise intensity."];
  "FBP" -> "ALDOA" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="FBP occupancy of aldolase prevents the apo-aldolase conformation; on glucose withdrawal FBP falls, apo-aldolase forms and nucleates the lysosomal v-ATPase–Ragulator–AXIN–LKB1 platform that activates AMPK before any measurable change in the AMP:ATP ratio."];
  "GLUCOSE" -> "LARS1" [arrowhead=odot, color="#898781", style=dashed, tooltip="Glucose starvation induces OGT-dependent O-GlcNAcylation of LARS1 at Ser1042, which blocks LARS1 binding to RagD and promotes ULK1 phosphorylation of its leucine-binding site, so LARS1 relays leucine to mTORC1 only when glucose is available."];
  "GLUCOSE" -> "FBP" [arrowhead=vee, color="#898781", style=solid, tooltip="Glycolytic flux converts glucose to fructose-1,6-bisphosphate, so FBP concentration tracks glucose availability and serves as the proximal signal in the aldolase-dependent glucose-sensing route."];
  "GLUCOSE" -> "RAG_HETERODIMER" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Glucose sufficiency is relayed to mTORC1 through the Rag GTPases largely independently of AMPK (constitutively active RagA mice lose glucose sensing); glycolytic DHAP has been proposed as the sensed metabolite."];
  "GLUCOSE" -> "GLYCOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glucose supplies carbon for glycolysis after phosphorylation to glucose-6-phosphate."];
  "GLUCOSE_DEPRIVATION" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Withdrawal of glucose activates AMPK through LKB1-dependent phosphorylation of Thr172: the canonical route follows the fall in ATP and the rise in AMP and ADP, while a parallel route in which unoccupied aldolase senses the loss of fructose-1,6-bisphosphate has been reported to act before adenine nuc"];
  "GLUCOSE_DEPRIVATION" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Glucose withdrawal suppresses mTORC1 even in AMPK-null cells, so an AMPK-independent arm operates in parallel with the LKB1-AMPK route; the proposed effectors, Rag-GTPase-dependent release of mTORC1 from the lysosome and hexokinase-II binding to Raptor, each rest on a single report."];
  "GLUCOSE_DEPRIVATION" -> "RAG_HETERODIMER" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Glucose withdrawal shifts the Rag heterodimer to its inactive nucleotide state, releasing mTORC1 from the lysosomal surface; mice expressing GTP-locked RagA cannot execute this switch and die of neonatal glucose-starvation failure."];
  "GLYCOGEN" -> "PRKAB1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="The carbohydrate-binding module of the AMPK β-subunit binds glycogen, and branched glycogen with exposed α-1,6 branch points inhibits AMPK activity and Thr172 phosphorylation, so cellular carbohydrate reserves restrain the energy-stress arm independently of the AMP:ATP ratio."];
  "HYPOXIA" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Limited oxidative phosphorylation lowers ATP and raises AMP/ADP, activating LKB1-AMPK, which phosphorylates TSC2 and Raptor; a REDD1-independent arm of hypoxic mTORC1 inhibition."];
  "HYPOXIA" -> "DDIT4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hypoxia induces REDD1 (via HIF-1 and, under severe hypoxia/ER stress, ATF4); REDD1 is required for hypoxic mTORC1 inhibition, which is lost in REDD1-/- and TSC2-/- cells."];
  "HYPOXIA" -> "EGLN1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Falling O2 tension limits the prolyl-hydroxylase reaction, inactivating PHD2 and allowing HIF-1α to escape hydroxylation and degradation; this is the molecular basis of the HIF-1α stabilisation that drives REDD1 and BNIP3 induction."];
  "HYPOXIA" -> "HIF1A" [arrowhead=normal, color="#0ca30c", style=solid, label="Pro402, Pro564", tooltip="Low O2 blocks PHD-mediated prolyl hydroxylation of HIF-1alpha; VHL no longer binds, ubiquitination ceases and HIF-1alpha accumulates to drive hypoxia-responsive genes including DDIT4 and BNIP3."];
  "HYPOXIA" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hypoxia suppresses mTORC1 by two indirect routes: HIF-1alpha-dependent induction of REDD1 with consequent TSC activation, which proceeds without AMPK or LKB1, and, when hypoxia is severe enough to lower ATP, activation of AMPK."];
  "OXIDATIVE_STRESS" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="H2O2/mitochondrial ROS increase AMPK Thr172 phosphorylation; proposed direct oxidation of AMPK alpha Cys299/Cys304 versus indirect activation through ATP depletion and AMP/ADP rise."];
  "OXIDATIVE_STRESS" -> "ATM" [arrowhead=normal, color="#0ca30c", style=solid, label="Cys2991", tooltip="H2O2 oxidises ATM Cys2991, forming disulfide-linked active dimers independently of DNA breaks and MRN; this cytoplasmic ATM pool drives the LKB1-AMPK-TSC2 response to ROS."];
  "OXIDATIVE_STRESS" -> "TSC_COMPLEX" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="ROS act on a peroxisome-localised TSC1-TSC2 pool, activating TSC2 GAP activity to suppress Rheb-GTP and mTORC1 and to induce autophagy (pexophagy)."];
  "VAR_STRADA_LOF" -> "DISEASE_PMSE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Autosomal recessive STRADA loss causes polyhydramnios, megalencephaly and symptomatic (intractable) epilepsy through impaired LKB1-AMPK signalling and mTORC1 hyperactivation; rapamycin reduces seizures."];
  "VAR_STRADA_LOF" -> "DISEASE_PMSE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Autosomal recessive STRADA loss impairs LKB1-AMPK signalling and causes PMSE syndrome with megalencephaly and intractable epilepsy."];
  "VAR_STRADA_LOF" -> "LKB1_COMPLEX" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Biallelic STRADA loss removes the pseudokinase subunit required for LKB1 activity and cytoplasmic localisation, so the LKB1–STRADα–MO25 heterotrimer cannot assemble and LKB1–AMPK signalling is impaired."];
  "VAR_STRADA_LOF" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of LKB1-AMPK restraint in STRADA-null neurons produces constitutive mTORC1 hyperactivity, the shared mechanism of the mTORopathies; rapamycin rescues aberrant cortical lamination and heterotopia in STRADA-depleted preclinical models, and the human experience is a small open-label series reporti"];
  "VAR_STRADA_LOF" -> "STRADA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Biallelic STRADA (LYK5) deletion removes the LKB1 pseudokinase activator; LKB1 is mislocalised/inactive, AMPK Thr172 phosphorylation falls and neuronal mTORC1 becomes hyperactive."];
  "VAR_STRADA_LOF" -> "STK11" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Biallelic STRADA loss impairs LKB1-AMPK signalling, removing energy-stress restraint of mTORC1 in PMSE syndrome."];
  "LYSOSOMAL_STRESS" -> "MCOLN1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Lysosomal stress, including oxidative stress sensed directly by TRPML1 (MCOLN1), opens this lysosomal Ca2+ channel; the released Ca2+ activates calcineurin, which dephosphorylates TFEB and drives its nuclear translocation independently of mTORC1 inhibition."];
  "LIGHT" -> "EIF4EBP1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Light drives mTORC1-dependent inhibitory phosphorylation of 4E-BP1 in the SCN, releasing eIF4E and de-repressing translation of Vip and other mRNAs required for entrainment"];
  "LIGHT" -> "ERK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Photic input to SCN neurons activates the MEK–ERK cascade during the phase-shifting window, the proximal step preceding mTORC1 activation"];
  "LIGHT" -> "MKNK1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Light activates MNK1 via ERK in SCN neurons, linking photic input to eIF4E phosphorylation"];
  "LIGHT" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Photic stimulation during the subjective night acutely raises mTORC1 pathway activity in SCN neurons (increased phospho-S6K1 and phospho-4E-BP1), gating the translational response to light."];
  "SLEEP_DEPRIVATION" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Sleep loss increases 4E-BP2-mediated repression of cap-dependent translation in hippocampal neurons; restoring translation initiation rescues the memory deficit"];
  "SLEEP_DEPRIVATION" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Acute sleep deprivation suppresses mTORC1-dependent signalling in hippocampus, reducing cap-dependent protein synthesis required for memory consolidation"];
  "VAR_BMAL1_LOF" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss of BMAL1 removes the S6K1-phosphorylated BMAL1 species from the translation-initiation machinery, reducing cap-dependent protein synthesis and abolishing its diurnal rhythm"];
  "VAR_BMAL1_LOF" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline Bmal1 deletion removes the clock-dependent restraint on mTORC1, producing constitutively increased mTORC1 signalling across tissues."];
  "VAR_BMAL1_LOF" -> "PHENO_CIRCADIAN_BEHAVIOUR_ABNORMALITY" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Halving Bmal1 gene dosage rescues the circadian behavioural abnormalities caused by mTOR hyperactivation, indicating that excess rather than deficient BMAL1 protein mediates them."];
  "VAR_BMAL1_LOF" -> "PHENO_PREMATURE_AGEING" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Bmal1-null mice develop premature ageing phenotypes attributed in part to the unrestrained mTORC1 signalling that accompanies loss of the clock's positive limb."];
  "VAR_BMAL1_LOF" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr389", tooltip="Bmal1-null tissues show constitutively elevated mTORC1 output, read out as increased S6K1 Thr389 phosphorylation and downstream S6 phosphorylation"];
  "VAR_PER2_LOF" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of PER2 removes the TSC1-delivery mechanism, elevating mTORC1 activity and flattening its time-of-day dependence"];
  "AGEING" -> "AUTOPHAGY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Age-associated elevation of basal mTOR activity with impaired stress-responsive autophagy contributes to accumulation of misfolded aggregates."];
  "AGEING" -> "MTORC1" [arrowhead=odot, color="#898781", style=dashed, tooltip="The acute mTORC1 response of aged muscle to amino acids and to loading is attenuated; basal post-absorptive signalling has been reported as elevated in some studies and unchanged in others, so the dynamic range appears compressed rather than uniformly reduced."];
  "AGEING" -> "PHENO_ANABOLIC_RESISTANCE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ageing muscle shows a blunted protein-synthesis response to amino acids and loading, from reduced mTORC1 sensitivity, impaired perfusion and splanchnic extraction."];
  "AGEING" -> "PHENO_IMMUNOSENESCENCE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ageing produces thymic involution, contraction of the naive repertoire, accumulation of PD-1+ exhausted-like cells and the low-grade inflammation of inflammaging."];
  "AGEING" -> "PHENO_VACCINE_RESPONSE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Age-associated decline in immune function is the premise of the three trials that define the geroprotective evidence base."];
  "EXERCISE_RESISTANCE" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Resistance exercise activates mTORC1 through phospholipase D-derived phosphatidic acid, mechanically induced membrane perturbation and focal adhesion signalling."];
  "MTORC2_ACTIVATOR" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Pharmacological activation of mTORC2 with A-443654 raises hydrophobic-motif phosphorylation of its substrates in mouse and fly; the compound is not selective for mTORC2, and no directly acting, selective mTORC2 agonist has been independently validated."];
  "MTORC2_ACTIVATOR" -> "PHENO_AGE_MEMORY_IMPAIRMENT" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Raising mTORC2 activity enhances L-LTP and long-term memory in wild-type animals and reverses age-associated memory impairment in both mice and flies."];
  "VAR_CLASS_DISTAL_NETWORK" -> "PHENO_RAPALOG_SENSITIVITY" [arrowhead=odot, color="#898781", style=solid, tooltip="Distal-network lesions do not predict rapalog benefit: BOLERO-2 benefit was independent of PIK3CA genotype, while selection succeeded at PI3K (SOLAR-1) and AKT (CAPItello-291)."];
  "VAR_CLASS_PROXIMAL_BRAKE" -> "PHENO_RAPALOG_SENSITIVITY" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Proximal-brake lesions identify a population enriched for mTORC1 dependency: exceptional responders in urothelial and renal carcinoma, but a negative prospective basket study."];
  "VAR_DEPDC5_LOF" -> "DEPDC5" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Truncating and missense DEPDC5 variants disrupt the Rag-binding subunit of GATOR1, so the complex can no longer be recruited to and act on RagA/B; missense variants are often hypomorphic rather than null."];
  "VAR_DEPDC5_LOF" -> "DISEASE_GATOR1_EPILEPSY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline heterozygous DEPDC5 loss of function disinhibits RagA/B and produces mTORC1 hyperactivity in the cortical lesion, causing familial focal epilepsy with variable foci and elevated risk of sudden unexpected death in epilepsy."];
  "VAR_DEPDC5_LOF" -> "GATOR1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Heterozygous DEPDC5 loss reduces GATOR1 GAP activity toward RagA/B, so mTORC1 remains lysosomally recruited when amino acids are scarce."];
  "VAR_DEPDC5_LOF" -> "PHENO_RAPALOG_SENSITIVITY" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="In an open-label series of five patients treated with everolimus titrated to troughs of 5-15 ng/mL, the three with DEPDC5 loss-of-function variants showed substantial seizure reduction, while a DEPDC5 missense variant gave a smaller response."];
  "VAR_DEPDC5_LOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="GATOR1 component loss removes a direct restraint on mTORC1 recruitment and so belongs to the proximal-brake class."];
  "VAR_DEPDC5_LOF" -> "EVEROLIMUS" [arrowhead=odot, color="#898781", style=dashed, tooltip="Genotype within the GATOR1 complex appears to influence everolimus response in the familial focal epilepsies: in an open-label series, patients with DEPDC5 loss-of-function variants showed substantial seizure reduction, a patient with a DEPDC5 missense variant responded less, and the single NPRL3 pa"];
  "VAR_MTOR_E1799K" -> "DISEASE_SKS" [arrowhead=normal, color="#0ca30c", style=solid, label="E1799K", tooltip="Germline MTOR gain-of-function causes Smith-Kingsmore syndrome with macrocephaly, intellectual disability and seizures; E1799K accounts for roughly half of cases."];
  "VAR_MTOR_E1799K" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, label="E1799K", tooltip="The recurrent germline E1799K substitution increases mTOR kinase activity, with raised mTOR signalling in patient-derived cells that is suppressed by rapamycin; it is the most common variant in Smith-Kingsmore syndrome, accounting for roughly half of reported cases."];
  "VAR_MTOR_GOF" -> "DISEASE_SKS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline activating MTOR substitutions cause Smith–Kingsmore syndrome; the recurrent E1799K change accounts for roughly half of reported cases."];
  "VAR_MTOR_GOF" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline gain-of-function MTOR variants (E1799K accounting for roughly half of cases) hyperactivate mTORC1, the proximate cause of both the somatic and the circadian features of Smith–Kingsmore syndrome"];
  "VAR_MTOR_GOF" -> "PHENO_CIRCADIAN_AMPLITUDE" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="SKS-associated MTOR variants reduced circadian reporter amplitude in engineered U2OS cells."];
  "VAR_MTOR_GOF" -> "DISEASE_FCD2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Somatic mosaic activating MTOR variants confined to the malformed cortex cause focal cortical dysplasia type II with drug-resistant focal epilepsy."];
  "VAR_MTOR_GOF" -> "DISEASE_HME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Somatic mosaic MTOR activation also causes hemimegalencephaly, the more severe end of the same mosaic malformation spectrum as FCD type II."];
  "VAR_MTOR_GOF" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Somatic mosaic activating MTOR variants confined to malformed cortex raise kinase activity in the affected cell lineage only."];
  "VAR_MTOR_GOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Activating MTOR variants act at the kinase itself. Depending on the variant, they can enhance mTORC1 and/or mTORC2 outputs."];
  "VAR_MTOR_GOF" -> "EVEROLIMUS" [arrowhead=odot, color="#898781", style=dashed, tooltip="Activating FAT- and kinase-domain MTOR variants raise kinase activity two- to ten-fold and were present in exceptional responders, including concurrent E2014K and E2419K in a urothelial complete responder treated with everolimus and pazopanib."];
  "VAR_NPRL3_LOF" -> "DISEASE_GATOR1_EPILEPSY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="NPRL3 loss of function causes familial focal epilepsy of the GATOR1 spectrum through unopposed RagA/B-GTP loading and mTORC1 hyperactivity in the cortical lesion. Responses to add-on everolimus have differed between series: the single NPRL3 patient in the first case series worsened, whereas all four"];
  "VAR_NPRL3_LOF" -> "NPRL3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss-of-function NPRL3 variants destabilise the GATOR1 heterotrimer and abolish its GAP activity toward RagA/B."];
  "VAR_NPRL3_LOF" -> "GATOR1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Heterozygous NPRL3 loss impairs the GATOR1 GAP for RagA/B and raises mTORC1 activity."];
  "VAR_NPRL3_LOF" -> "PHENO_RAPALOG_SENSITIVITY" [arrowhead=odot, color="#898781", style=dashed, tooltip="One NPRL3 participant worsened in the 2023 series; the 2025 NPRL2/NPRL3 series instead reported improvement in all four participants."];
  "VAR_NPRL3_LOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="GATOR1 loss (DEPDC5, NPRL2, NPRL3) belongs to the proximal-brake class and is somatic."];
  "VAR_STK11_LOF" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss-of-function STK11/LKB1 lesions abolish energy-stress-induced Thr172 phosphorylation of AMPK, removing both the TSC2-GAP and the Raptor Ser792 brakes, so mTORC1 is no longer restrained when ATP falls; Ca2+-driven Thr172 phosphorylation by CaMKK2 is retained, and growth-factor and amino-acid cont"];
  "VAR_STK11_LOF" -> "STK11" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Germline (Peutz-Jeghers) or somatic STK11 inactivation abolishes AMPK Thr172 phosphorylation under energy stress; the TSC2/Raptor checkpoints fail and mTORC1 is deregulated in LKB1-null cells and tumours."];
  "VAR_STK11_LOF" -> "AMPK" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="LKB1 loss removes the principal activating kinase of AMPK, withdrawing AMPK-mediated restraint of mTORC1 via TSC2 and Raptor Ser792."];
  "VAR_STK11_LOF" -> "DISEASE_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of STK11 is listed among the recurrent alterations in the pathway landscape, and STK11 was one of the five selection genes in the negative prospective everolimus basket study."];
  "VAR_STK11_LOF" -> "DISEASE_PJS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline STK11 (LKB1) loss causes Peutz-Jeghers syndrome, with hamartomatous polyposis attributable in part to withdrawn AMPK restraint of mTORC1."];
  "VAR_TSC1_LOF" -> "TSC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="TSC1 loss destabilises TSC2 and abolishes Rheb-GAP activity → constitutive mTORC1 activation; basis of tuberous sclerosis; proximal-brake lesion predicting rapalog sensitivity."];
  "VAR_TSC1_LOF" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of the TSC complex removes GAP activity toward Rheb, producing the constitutive mTOR hyperactivation of the paradigmatic genetic mTORopathy model used to study BMAL1 proteostasis"];
  "VAR_TSC1_LOF" -> "PHENO_CIRCADIAN_BEHAVIOUR_ABNORMALITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR hyperactivation in the TSC-null model produces circadian behavioural abnormalities that are rescued by reducing Bmal1 gene dosage"];
  "VAR_TSC1_LOF" -> "DISEASE_FSGS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Podocyte Tsc1 deletion produces focal segmental glomerulosclerosis, the upper limb of the podocyte Goldilocks requirement for calibrated mTORC1 activity."];
  "VAR_TSC1_LOF" -> "DISEASE_TSC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline TSC1 loss with a somatic second hit produces constitutive mTORC1 activation in lesional tissue: cortical tubers, SEGA, angiomyolipoma and epilepsy."];
  "VAR_TSC1_LOF" -> "DISEASE_UROTHELIAL_CARCINOMA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Whole-genome sequencing of a durable everolimus complete responder found loss-of-function TSC1; TSC1 mutations occurred in roughly 8% of 109 further bladder cancers."];
  "VAR_TSC1_LOF" -> "PHENO_HEPATIC_STEATOSIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Liver-specific Tsc1 deletion constitutively activates mTORC1 yet protects against diet-induced steatosis, because S6K1-IRS-1 feedback suppresses hepatic insulin signalling and SREBP1c."];
  "VAR_TSC1_LOF" -> "PHENO_HYPERPHAGIC_OBESITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Tsc1 deletion in POMC neurons produces hyperphagic obesity, the converse manipulation to hypothalamic leucine sensing."];
  "VAR_TSC1_LOF" -> "PHENO_RAPALOG_SENSITIVITY" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Whole-genome sequencing of a durable complete responder to everolimus identified a loss-of-function TSC1 mutation; TSC1 mutations were then found in approximately 8% of a further 109 bladder cancers and correlated with everolimus sensitivity and time on treatment."];
  "VAR_TSC1_LOF" -> "PHENO_SEIZURES" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Tsc1 deletion restricted to microglia produces severe early-onset spontaneous recurrent seizures, showing epileptogenesis is not cell-autonomous to neurons."];
  "VAR_TSC1_LOF" -> "RHEB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TSC1 loss destabilises the TSC complex and abolishes TSC2 GAP activity toward Rheb, so Rheb-GTP accumulates and mTORC1 is constitutively activated."];
  "VAR_TSC1_LOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="TSC1 loss impairs the TSC complex and releases Rheb-dependent mTORC1 signalling."];
  "VAR_TSC1_LOF" -> "EVEROLIMUS" [arrowhead=odot, color="#898781", style=dotted, tooltip="TSC1 loss of function was identified in an exceptional everolimus responder and correlated with sensitivity and time on treatment in 109 further bladder cancers; prospective basket testing was negative."];
  "VAR_TSC2_LOF" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="TSC2 loss abolishes the asparagine-thumb GAP activity toward Rheb → constitutive mTORC1 activation; basis of TSC, LAM and PEComa (AMPECT response enriched in TSC2-mutant tumours)."];
  "VAR_TSC2_LOF" -> "DISEASE_FCD2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TSC1 and TSC2 act alongside MTOR, PIK3CA and AKT3 in focal cortical dysplasia type II, through somatic mosaic activation confined to the malformed cortex."];
  "VAR_TSC2_LOF" -> "DISEASE_LAM" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TSC2-deficient smooth-muscle-like cells with constitutive mTORC1 activity drive the cystic lung destruction of LAM, sporadic or TSC-associated."];
  "VAR_TSC2_LOF" -> "DISEASE_TSC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline TSC2 loss of function with a somatic second hit abolishes TSC2 GAP activity toward Rheb, producing constitutive mTORC1 activation in lesional tissue, the molecular basis of tuberous sclerosis complex."];
  "VAR_TSC2_LOF" -> "PHENO_OSTEOBLAST_DIFFERENTIATION" [arrowhead=odot, color="#898781", style=solid, tooltip="Tsc2 acts as a molecular checkpoint controlling osteoblast development and glucose homeostasis."];
  "VAR_TSC2_LOF" -> "PHENO_RAPALOG_SENSITIVITY" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="In AMPECT, response to nab-sirolimus in malignant PEComa was enriched in TSC2-mutant tumours."];
  "VAR_TSC2_LOF" -> "RHEB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TSC2 loss removes the asparagine-thumb GAP that accelerates Rheb GTP hydrolysis roughly 100-fold, producing constitutive Rheb-GTP and mTORC1 activation."];
  "VAR_TSC2_LOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="TSC2 loss removes the Rheb GTPase-activating function that normally restrains mTORC1."];
  "VAR_TSC2_LOF" -> "NAB_SIROLIMUS" [arrowhead=odot, color="#898781", style=dashed, tooltip="Response to albumin-bound sirolimus in malignant PEComa was strongly enriched in TSC2-mutant tumours, the clearest somatic example of a proximal-brake lesion enriching for rapalog benefit without establishing dependency in an individual tumour."];
  "ALPELISIB" -> "PI3K" [arrowhead=tee, color="#d03b3b", style=solid, label="ATP site of p110α", tooltip="p110α-selective ATP-competitive inhibitor; with fulvestrant improved PFS from 5.7 to 11.0 months in PIK3CA-mutant HR+ advanced breast cancer (SOLAR-1)."];
  "ALPELISIB" -> "PI3K" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PI3K-alpha-selective inhibitor used in SOLAR-1."];
  "ALPELISIB" -> "PI3K" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Alpelisib selectively inhibits the p110-alpha catalytic subunit at the ATP site, lowering PIP3 and hence AKT and downstream mTORC1 activation."];
  "ALPELISIB" -> "DISEASE_BREAST_CANCER" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="SOLAR-1 added alpelisib to fulvestrant and improved PFS from 5.7 to 11.0 months in a population prospectively selected for PIK3CA mutation: genomic selection succeeds at the PI3K node."];
  "ALPELISIB" -> "DISEASE_BREAST_CANCER" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Added to fulvestrant in a population prospectively selected for PIK3CA mutation, alpelisib improved progression-free survival from 5.7 to 11.0 months: biomarker selection succeeds at the PI3K node."];
  "APITOLISIB" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Apitolisib inhibits mTOR at the ATP site alongside class I PI3K, abolishing output of both complexes."];
  "APITOLISIB" -> "PI3K" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Class I PI3K inhibition lowers PIP3 and therefore both AKT recruitment and mSin1-dependent mTORC2 activation. In a randomised comparison with everolimus in renal cell carcinoma, apitolisib produced shorter progression-free survival and markedly more high-grade hyperglycaemia and rash, illustrating t"];
  "AZD8055" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr37, Thr46", tooltip="AZD8055 reduces phosphorylation of 4E-BP1 at Thr37/Thr46, thereby favouring its repressive interaction with eIF4E."];
  "AZD8055" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="AZD8055 is a potent, selective, orally bioavailable ATP-competitive mTOR inhibitor active against both complexes, with antitumour activity in vitro and in vivo."];
  "AZD8055" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="ATP-competitive occupancy of the catalytic cleft inhibits mTORC2 as well as mTORC1, abolishing AKT Ser473 phosphorylation."];
  "CAPIVASERTIB" -> "AKT" [arrowhead=tee, color="#d03b3b", style=solid, label="ATP site", tooltip="Pan-AKT ATP-competitive inhibitor; with fulvestrant improved PFS from 3.1 to 7.3 months in AKT-pathway-altered HR+ breast cancer (CAPItello-291)."];
  "CAPIVASERTIB" -> "AKT" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="ATP-competitive pan-AKT inhibitor used in CAPItello-291."];
  "CAPIVASERTIB" -> "AKT" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Capivasertib is an ATP-competitive pan-AKT inhibitor, blocking both the mTORC1-directed arm (through TSC2 and PRAS40) and the mTORC1-independent outputs to GSK3-beta, FOXO and MDM2."];
  "CAPIVASERTIB" -> "DISEASE_BREAST_CANCER" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="CAPItello-291 added capivasertib to fulvestrant and improved PFS from 3.1 to 7.3 months in tumours with AKT-pathway alterations: genomic selection also succeeds at the AKT node."];
  "CAPIVASERTIB" -> "DISEASE_BREAST_CANCER" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Added to fulvestrant in AKT-pathway-altered tumours, capivasertib improved progression-free survival from 3.1 to 7.3 months: selection also succeeds at the AKT node, but not at mTOR."];
  "CYCLOSPORINE" -> "DISEASE_NODAT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Calcineurin inhibitors block calcineurin-NFAT signalling in the pancreatic beta cell, reducing insulin secretion and beta-cell mass and producing new-onset diabetes after transplantation, with tacrolimus carrying the higher risk of the two agents. This mechanism is distinct from the direct beta-cell"];
  "CYCLOSPORINE" -> "PPIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cyclosporine binds cyclophilin A rather than FKBP12; the drug-immunophilin binary complex is the active species. This is the structural reason cyclosporine does not compete with rapamycin for FKBP12 whereas tacrolimus does."];
  "CYCLOSPORINE" -> "PPP3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Cyclosporine acts through cyclophilin A rather than FKBP12, but the resulting complex inhibits the same calcineurin phosphatase, giving the shared NFAT-dependent beta-cell toxicity of the class."];
  "DACTOLISIB" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The imidazoquinoline scaffold occupies the ATP site of mTOR as well as of PI3K, giving simultaneous blockade of both nodes of the axis."];
  "DACTOLISIB" -> "PI3K" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Dual blockade of class I PI3K was intended to pre-empt the receptor tyrosine kinase-driven AKT rebound that follows mTOR inhibition, but met the same toxicity ceiling."];
  "DEXAMETHASONE" -> "PHENO_STOMATITIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Prophylactic dexamethasone mouthwash started together with everolimus reduced grade 2 or higher stomatitis far below the incidence reported in earlier everolimus trials without prophylaxis, although the comparison was with historical rates in a single-arm trial. Mucositis nevertheless remains dose-l"];
  "EVEROLIMUS" -> "DISEASE_ANGIOMYOLIPOMA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="42% of everolimus-treated patients achieved at least 50% angiomyolipoma reduction (EXIST-2)."];
  "EVEROLIMUS" -> "DISEASE_BREAST_CANCER" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="BOLERO-2 added everolimus to exemestane in HR-positive, HER2-negative advanced breast cancer progressing on an aromatase inhibitor, improving median PFS from 2.8 to 6.9 months by investigator assessment; overall survival 31.0 versus 26.6 months did not reach significance."];
  "EVEROLIMUS" -> "DISEASE_BREAST_CANCER" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Added to exemestane, everolimus improved median progression-free survival from 2.8 to 6.9 months; the benefit was independent of PIK3CA genotype and overall survival did not reach significance."];
  "EVEROLIMUS" -> "DISEASE_NET" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="RADIANT-3 improved PFS from 4.6 to 11.0 months in advanced pancreatic neuroendocrine tumours and RADIANT-4 from 3.9 to 11.0 months in non-functional GI and lung NETs; the disease depends on secretory and translational programmes governed by 4E-BP and TOP mRNA control."];
  "EVEROLIMUS" -> "DISEASE_NET" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Progression-free survival improved from 4.6 to 11.0 months in pancreatic and from 3.9 to 11.0 months in non-functional gastrointestinal and lung neuroendocrine tumours, diseases dependent on 4E-BP and TOP mRNA control."];
  "EVEROLIMUS" -> "DISEASE_SEGA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Approximately 35% of everolimus-treated patients achieved at least 50% SEGA volume reduction versus 0% on placebo (EXIST-1)."];
  "EVEROLIMUS" -> "DISEASE_TSC" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Everolimus is approved for TSC-associated SEGA, renal angiomyolipoma and refractory focal seizures on the basis of the EXIST programme; biallelic inactivation of a direct mTORC1 restraint in lesions driven by nothing else is the condition under which a rapalog does what its mechanism predicts."];
  "EVEROLIMUS" -> "DISEASE_TSC" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="In TSC, biallelic loss of a direct mTORC1 restraint makes the lesion fully mTORC1-dependent: roughly 35% achieved SEGA volume reduction, 42% angiomyolipoma reduction and 30-40% seizure reduction."];
  "EVEROLIMUS" -> "PHENO_PD1_T_CELLS" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="PD-1+ CD4 and CD8 T cell fractions fell in the 218-participant everolimus vaccine-response trial, alongside the improvement in haemagglutination-inhibition titre."];
  "EVEROLIMUS" -> "PHENO_PD1_T_CELLS" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="In the 218-participant vaccine trial, PD-1-positive CD4 and CD8 T cell fractions fell during six weeks of low-dose everolimus, consistent with partial mTORC1 inhibition reversing features of T cell exhaustion in immunosenescence."];
  "EVEROLIMUS" -> "PHENO_PNEUMONITIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Non-infectious pneumonitis occurs in approximately 5-15% of oncology patients; the most serious and least mechanistically understood rapalog toxicity, with the implicated complex unclear."];
  "EVEROLIMUS" -> "PHENO_PNEUMONITIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Non-infectious pneumonitis occurs in roughly 5-15% of oncology patients; the mechanism is incompletely understood and probably immune-mediated, with no clear complex attribution."];
  "EVEROLIMUS" -> "DISEASE_GATOR1_EPILEPSY" [arrowhead=odot, color="#898781", style=dashed, tooltip="Small uncontrolled series reported variable responses: the 2023 series included one NPRL3 worsening; in 2025 all four NPRL2/NPRL3 participants improved, including two with seizure freedom."];
  "EVEROLIMUS" -> "DISEASE_RCC" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="In renal cell carcinoma progressing after VEGFR-directed therapy, everolimus extended median progression-free survival from 1.9 to 4.9 months in the final analysis of RECORD-1, without an overall survival benefit, consistent with a cytostatic effect on HIF-dependent translation and the angiogenic pr"];
  "EVEROLIMUS" -> "DISEASE_UROTHELIAL_CARCINOMA" [arrowhead=odot, color="#898781", style=dashed, tooltip="Exceptional-responder literature: a durable complete remission in metastatic urothelial carcinoma with a loss-of-function TSC1 mutation alongside an NF2 nonsense mutation, with TSC1 mutations subsequently found in about 8% of 109 further bladder cancers and correlated with everolimus sensitivity; a "];
  "EVEROLIMUS" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser65, Thr70", tooltip="Everolimus lowers mTORC1-dependent phosphorylation of 4E-BP1 and so favours sequestration of eIF4E, but suppression is site-selective: Ser65 and Thr70, which require prior priming and sustained mTORC1 activity, are suppressed, whereas the priming sites Thr37 and Thr46 remain largely phosphorylated. "];
  "EVEROLIMUS" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The 40-O-(2-hydroxyethyl) substitution alters pharmacokinetics but not mechanism: everolimus acts only as an FKBP12 binary complex engaging the FRB of mTORC1."];
  "EVEROLIMUS" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="As the FKBP12 complex, everolimus restricts substrate access to assembled mTORC1; S6K1 Thr389 is fully suppressed while 4E-BP1 Thr37/Thr46 is not."];
  "EVEROLIMUS" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Kinetic rather than absolute selectivity: with prolonged exposure the FKBP12-rapalog complex captures newly synthesised mTOR before its incorporation into mTORC2, so chronic dosing inhibits mTORC2 in many cell types even though preassembled mTORC2 is spared acutely."];
  "EVEROLIMUS" -> "PHENO_ANGIOMYOLIPOMA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="42% of patients achieved at least 50% angiomyolipoma volume reduction in EXIST-2, in TSC-associated or sporadic lymphangioleiomyomatosis-associated disease."];
  "EVEROLIMUS" -> "PHENO_HYPERGLYCAEMIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hyperglycaemia under everolimus has two contributions with different complex attribution: impaired beta-cell insulin secretion, which follows mTORC1 inhibition, and peripheral insulin resistance, which follows the mTORC2 inhibition that develops with prolonged exposure. mTORC2 is the more heavily im"];
  "EVEROLIMUS" -> "PHENO_RESPIRATORY_INFECTION" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="In the 264-participant phase 2a trial, six weeks of BEZ235 plus low-dose everolimus reduced participant-reported infections during one year of follow-up."];
  "EVEROLIMUS" -> "PHENO_SEGA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Allosteric mTORC1 inhibition in lesions with biallelic inactivation of a direct mTORC1 restraint; approximately 35% of patients achieved at least 50% SEGA volume reduction versus 0% on placebo in the EXIST programme."];
  "EVEROLIMUS" -> "PHENO_SEIZURES" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Adjunctive everolimus reduced treatment-resistant focal-onset seizures, with 30-40% of patients achieving at least 50% seizure reduction in EXIST-3."];
  "EVEROLIMUS" -> "PHENO_STOMATITIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Stomatitis affects roughly 30-60% of patients depending on indication and reflects the mTORC1 dependence of the rapidly renewing oral epithelium; it is dose-limiting in several oncology regimens."];
  "EVEROLIMUS" -> "RPS6KB1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr389", tooltip="Allosteric mTORC1 inhibition abolishes phosphorylation of the S6K1 hydrophobic motif; S6K1 suppression by rapalogs is complete, in contrast to the partial suppression of 4E-BP1."];
  "KU0063794" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="KU-0063794 is an ATP-competitive mTOR inhibitor selective over related PI3K-family kinases, blocking both complexes; used to attribute effects to mTOR rather than to PI3K."];
  "KU0063794" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Specific ATP-competitive mTOR inhibition blocks both complexes, including AKT Ser473 phosphorylation by mTORC2."];
  "METFORMIN" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Metformin activates AMPK indirectly: inhibition of mitochondrial complex I raises AMP and ADP relative to ATP, and at low, clinically relevant concentrations a lysosomal route through PEN2, the v-ATPase, AXIN and LKB1 has been reported by a single laboratory. LKB1 is required for the hepatic effect."];
  "METFORMIN" -> "MITOCHONDRIAL_COMPLEX_I" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Metformin accumulates in mitochondria and mildly inhibits complex I (NADH dehydrogenase), lowering ATP production and raising AMP/ADP:ATP, the proximal trigger for AMPK activation."];
  "METFORMIN" -> "PEN2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Low-dose metformin binds PEN2, which then engages ATP6AP1 to inhibit v-ATPase, triggering AXIN-LKB1 recruitment to Ragulator and lysosomal AMPK activation without a change in AMP:ATP."];
  "METFORMIN" -> "RAG_HETERODIMER" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Metformin inhibits mTORC1 independently of AMPK and TSC2 in a Rag GTPase-dependent manner; constitutively active Rag mutants blunt the effect, suggesting interference with Rag-mediated lysosomal recruitment."];
  "METFORMIN" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Metformin lowers mTORC1 activity indirectly and does not bind mTOR. One route is AMPK-dependent, through phosphorylation of Raptor at Ser792 and enhancement of TSC2 GAP activity; a second is AMPK-independent, requires the Rag GTPases and was demonstrated in cells lacking AMPK or TSC2. Because of the"];
  "NAB_SIROLIMUS" -> "DISEASE_PECOMA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="AMPECT established nab-sirolimus in advanced malignant PEComa, with response enriched in TSC2-mutant tumours."];
  "NAB_SIROLIMUS" -> "DISEASE_PECOMA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Albumin-bound sirolimus produced durable responses in advanced malignant PEComa, with response strongly enriched in TSC2-mutant tumours."];
  "NAB_SIROLIMUS" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The albumin-bound nanoparticle alters delivery and tumour exposure only; the released sirolimus acts through FKBP12 on the FRB of mTORC1 as usual."];
  "NAB_SIROLIMUS" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Nanoparticle albumin-bound sirolimus delivers sirolimus, which via FKBP12 engages the FRB domain of assembled mTORC1."];
  "OSI027" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="OSI-027 binds the mTOR ATP site and suppresses both mTORC1 and mTORC2 signalling, including 4E-BP1 phosphorylation resistant to rapamycin."];
  "OSI027" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Selective ATP-competitive mTOR kinase inhibitor with activity against both mTORC1 and mTORC2."];
  "PP242" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PP242 occupies the mTOR ATP site and inhibits both complexes; it defined the rapamycin-resistant outputs of mTORC1 alongside Torin1."];
  "PP242" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Active-site inhibition blocks rapamycin-resistant outputs of mTORC1 and also inhibits mTORC2, abolishing AKT Ser473 phosphorylation."];
  "RAPALINK1" -> "ATP_SITE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The tethered ATP-site moiety delivers complete catalytic inhibition once the molecule is anchored through FKBP12, so inhibition does not depend on the allosteric effect alone."];
  "RAPALINK1" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The rapamycin end of the bi-steric molecule recruits FKBP12; the resulting avidity for the FRB-bearing complex is what confers mTORC1 selectivity on an otherwise non-selective ATP-site warhead."];
  "RAPALINK1" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="FKBP12-RapaLink-1 engages the FRB domain, providing the anchoring half of the bi-steric mechanism."];
  "RAPALINK1" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Bivalent engagement of FRB and the ATP cleft on the same mTOR protomer gives an avidity-driven potency far above either moiety alone."];
  "RAPALINK1" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Bivalent engagement gives complete mTORC1 suppression and retains activity against FRB resistance mutations that abolish rapalog binding, establishing the bi-steric concept."];
  "RAPALINK1" -> "PHENO_CNS_DRUG_EXPOSURE" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="RapaLink-1 crosses the blood-brain barrier and accumulates in intracranial tumour tissue to a degree the first- and second-generation agents do not, which is the basis of its preclinical activity in glioblastoma models."];
  "RAPALINK1" -> "VAR_FRB_RESISTANCE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="RapaLink-1 tethers rapamycin to an ATP-competitive mTOR inhibitor, so that FKBP12-rapamycin anchoring at the FRB domain delivers the active-site moiety with high avidity. Potency is therefore retained against FRB-domain substitutions such as A2034V and F2108L, which weaken FKBP12-rapamycin binding a"];
  "RAPAMYCIN" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rapamycin has no direct activity on mTOR; it first binds the immunophilin FKBP12 and the binary complex is the active species. The yeast FPR1 screen established this genetically."];
  "RAPAMYCIN" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rapamycin binds the FKBP12 immunophilin with low-nanomolar affinity; the binary complex, not free drug, is the inhibitory species, so FKBP12 is obligatory for all rapalog action."];
  "RAPAMYCIN" -> "FKBP12_RAPAMYCIN" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Rapamycin is the drug half of the composite inhibitor; neither partner alone binds FRB with meaningful affinity."];
  "RAPAMYCIN" -> "FKBP12_RAPAMYCIN" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Rapamycin contributes the second half of the composite surface, its effector domain projecting away from FKBP12 to contact the FRB domain of mTOR."];
  "RAPAMYCIN" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapalogs suppress cap-dependent translation only partially. With FKBP12-rapamycin bound to the FRB domain, phosphorylation of 4E-BP1 at Ser65 and Thr70 is blocked while Thr37 and Thr46 remain largely phosphorylated, so eIF4F assembly continues at a substantial rate. The limitation is structural rath"];
  "RAPAMYCIN" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser65, Thr70", tooltip="Rapamycin blocks phosphorylation of the late 4E-BP1 sites Ser65 and Thr70 while largely sparing the priming sites Thr37 and Thr46, so binding of 4E-BP1 to eIF4E is only partly restored and cap-dependent translation continues. The limitation is structural rather than a matter of dose."];
  "RAPAMYCIN" -> "EIF4EBP1" [arrowhead=odot, color="#898781", style=solid, label="Thr37, Thr46", tooltip="Thr37/Thr46 phosphorylation is relatively rapamycin-resistant in many experimental settings, limiting restoration of 4E-BP1-mediated repression of eIF4E."];
  "RAPAMYCIN" -> "RIBOSOME_BIOGENESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapamycin lowers activating Ser44 phosphorylation of TIF-IA/RRN3 and raises the inhibitory Ser199 site, blocks the S6K1-dependent phosphorylation of the UBF carboxy-terminal activation domain, and relieves mTORC1 repression of MAF1 — collapsing Pol I 47S pre-rRNA synthesis and Pol III tRNA/5S output"];
  "RAPAMYCIN" -> "RPS6KB1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr389", tooltip="FKBP12-rapamycin bound to the mTORC1 FRB domain abolishes S6K1 Thr389 phosphorylation completely, in contrast to its partial effect on 4E-BP1. This makes Thr389 the pharmacodynamic marker of mTORC1 engagement and the readout against which partial pathway inhibition is judged in dosing studies."];
  "RAPAMYCIN" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Prolonged rapamycin exposure inhibits mTORC2 because FKBP12–rapamycin captures newly synthesised mTOR before assembly; mTORC1 selectivity is kinetic, not absolute."];
  "RAPAMYCIN" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Chronic dosing lowers mTORC2 output, including AKT Ser473, in many but not all cell types, by blocking assembly of new complexes; selectivity for mTORC1 is therefore kinetic rather than absolute."];
  "RAPAMYCIN" -> "PHENO_GLUCOSE_INTOLERANCE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic rapamycin exposure disrupts mTORC2 and causes insulin resistance, an effect uncoupled from its longevity benefit."];
  "RAPAMYCIN" -> "PHENO_GLUCOSE_INTOLERANCE" [arrowhead=odot, color="#898781", style=dashed, tooltip="Intermittent dosing allows mTORC2 to recover between doses; preclinical data and low-exposure human cohorts without dysglycaemia support this but no powered trial has tested it."];
  "RAPAMYCIN" -> "CIRCADIAN_CLOCK" [arrowhead=odot, color="#898781", style=solid, tooltip="Pharmacological mTOR inhibition lengthens circadian period and alters amplitude in central and peripheral clocks, so mTOR activity sets clock pace as well as responding to it."];
  "RAPAMYCIN" -> "PHENO_CIRCADIAN_AMPLITUDE" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Low-dose rapamycin improved circadian reporter amplitude in engineered U2OS cells expressing SKS-associated MTOR variants."];
  "RAPAMYCIN" -> "PHENO_CIRCADIAN_AMPLITUDE" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Low-dose rapamycin improved circadian reporter amplitude in engineered U2OS cells expressing SKS-associated MTOR variants."];
  "RAPAMYCIN" -> "PHENO_CIRCADIAN_PERIOD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rapamycin lengthens the free-running circadian period, the specific readout behind the general statement that mTOR inhibition modulates central and peripheral clock function"];
  "RAPAMYCIN" -> "PHENO_DELAYED_SLEEP_WAKE_PHASE_DISORDER" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="High-dose rapamycin precipitated delayed sleep–wake phase disorder in some Smith–Kingsmore patients, whereas low doses improved sleep: dose and timing interact with sleep architecture."];
  "RAPAMYCIN" -> "PHENO_DELAYED_SLEEP_WAKE_PHASE_DISORDER" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Higher-dose rapamycin precipitated delayed sleep-wake phase disorder in some Smith-Kingsmore patients, the mirror image of the low-dose benefit on circadian amplitude."];
  "RAPAMYCIN" -> "PHENO_LIFESPAN_EXTENSION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rapamycin substantially extends the lifespan of Bmal1-null mice, the key in vivo evidence that their shortened lifespan is mTORC1-dependent."];
  "RAPAMYCIN" -> "PHENO_LIFESPAN_EXTENSION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Encapsulated rapamycin begun at 600 days of age extended median and maximal lifespan of genetically heterogeneous mice at three independent sites, raising the age at 90% mortality by 9% in males and 14% in females; a threefold higher dose of 42 ppm increased median lifespan by 23% in males and 26% i"];
  "RAPAMYCIN" -> "PHENO_LIFESPAN_EXTENSION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Encapsulated rapamycin begun at 600 days of age raised age at 90% mortality by 9% in male and 14% in female genetically heterogeneous mice at three independent sites; a threefold higher dietary dose of 42 ppm raised median lifespan by 23% in males and 26% in females, and late-life intermittent regim"];
  "RAPAMYCIN" -> "PHENO_PREMATURE_AGEING" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Pharmacological mTORC1 inhibition reverses the consequences of unrestrained mTORC1 in Bmal1-null animals, delaying their premature-ageing phenotypes and substantially extending lifespan"];
  "RAPAMYCIN" -> "PHENO_SLEEP_WAKE_DISTURBANCE" [arrowhead=odot, color="#898781", style=dashed, tooltip="Uncontrolled SKS observations linked rapamycin exposure to altered sleep; improvement after dose reduction included concomitant suvorexant in the detailed case."];
  "RAPAMYCIN" -> "ABETA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapamycin reduces brain amyloid-beta and improves cognition in 3xTg-AD mice, with benefit dependent on intact autophagy and on early initiation."];
  "RAPAMYCIN" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Pharmacological mTOR inhibition induces autophagy and accelerates clearance of misfolded aggregates in cellular and animal models; this is the whole basis of the neurodegeneration rationale."];
  "RAPAMYCIN" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Relieving mTORC1 repression of ULK1 and TFEB induces autophagy and accelerates clearance of amyloid-beta, alpha-synuclein and polyglutamine aggregates in cellular and animal models."];
  "RAPAMYCIN" -> "DISEASE_AD" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Rapamycin reduces brain amyloid-beta and improves cognition in 3xTg-AD mice, with benefit dependent on intact autophagy and largely confined to treatment initiated before substantial pathology accumulates."];
  "RAPAMYCIN" -> "DISEASE_CANCER" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Sirolimus-class agents have real but largely cytostatic antitumour activity: albumin-bound sirolimus is approved for advanced malignant perivascular epithelioid cell tumour, with response enriched in TSC2-mutant tumours, while no randomised trial of a rapalog in a solid tumour has shown a significan"];
  "RAPAMYCIN" -> "DISEASE_HD" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Rapamycin or CCI-779 reduces aggregates and improves outcomes in fly and mouse models of Huntington's disease."];
  "RAPAMYCIN" -> "DISEASE_NODAT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="In kidney transplant recipients without pre-existing diabetes sirolimus was independently associated with new-onset diabetes, adjusted hazard ratios roughly 1.4-1.7."];
  "RAPAMYCIN" -> "DISEASE_NODAT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="In kidney transplant recipients without pre-existing diabetes, sirolimus was independently associated with new-onset diabetes across regimens, with adjusted hazard ratios of roughly 1.4-1.7."];
  "RAPAMYCIN" -> "DISEASE_PD" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Rapamycin protects dopaminergic neurons in cellular and rodent models of Parkinson disease; in those models protection tracked with blocked production of the stress protein RTP801/REDD1 and preserved AKT phosphorylation, whereas the catalytic inhibitor Torin1 was not protective. Enhanced autophagic "];
  "RAPAMYCIN" -> "DISEASE_PMSE" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Rapamycin prevents seizures after depletion of STRADA in models of PMSE, with support from preclinical work and small clinical series."];
  "RAPAMYCIN" -> "HTT" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTOR inhibition with rapamycin or CCI-779 induces autophagy and reduces polyglutamine-expanded huntingtin aggregates and toxicity in fly and mouse models."];
  "RAPAMYCIN" -> "INSULIN_SECRETION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Direct beta-cell toxicity of rapamycin: reduced insulin secretion, disturbed calcium handling and mitochondrial dysfunction; one of the two components of NODAT alongside mTORC2-dependent peripheral insulin resistance."];
  "RAPAMYCIN" -> "LTP_LATE_PHASE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapamycin blocks L-LTP while sparing the early phase, which is the pharmacological demonstration that the late phase is protein-synthesis dependent."];
  "RAPAMYCIN" -> "PHENO_CARDIAC_HYPERTROPHY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTORC1 drives the adaptive growth of cardiomyocytes, so partial inhibition blunts physiological hypertrophy; the same inhibition attenuates pathological hypertrophy in multiple models and regresses established pressure-overload hypertrophy, so the adaptive and maladaptive arms are not separable phar"];
  "RAPAMYCIN" -> "PHENO_CD8_MEMORY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Low-dose rapamycin during acute viral infection enhances the quantity and functional quality of memory CD8 T cells, T cell-intrinsically and across infection models."];
  "RAPAMYCIN" -> "PHENO_CD8_MEMORY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Low-dose rapamycin given during acute viral infection increases both the quantity and the functional quality of memory CD8 T cells, T cell-intrinsically and across infection models and in primates."];
  "RAPAMYCIN" -> "PHENO_CYTOPENIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cytopenias follow from the proliferative requirement for mTORC1 in haematopoiesis."];
  "RAPAMYCIN" -> "PHENO_CYTOPENIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Haematopoietic progenitors require mTORC1 for proliferation, so suppression produces anaemia, thrombocytopenia and neutropenia; dose reduction is the standard response."];
  "RAPAMYCIN" -> "PHENO_HYPERGLYCAEMIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hyperglycaemia at immunosuppressive exposures reflects hepatic, adipose and beta-cell physiology, chiefly through loss of mTORC2 signalling."];
  "RAPAMYCIN" -> "PHENO_HYPERGLYCAEMIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic exposure raises glucose through combined beta-cell dysfunction and mTORC2-dependent peripheral insulin resistance; attribution is mTORC2 greater than mTORC1."];
  "RAPAMYCIN" -> "PHENO_HYPERPHAGIC_OBESITY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapamycin partially corrects the hyperphagic obesity of POMC-neuron Tsc1 deletion."];
  "RAPAMYCIN" -> "PHENO_HYPERPHAGIC_OBESITY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hypothalamic mTORC1 acts as a nutrient sensor in the arcuate nucleus: rapamycin abolishes the anorectic response to intracerebroventricular leucine and partially corrects the hyperphagic obesity produced by Tsc1 deletion in POMC neurons. This raises the possibility that part of the metabolic toxicit"];
  "RAPAMYCIN" -> "PHENO_HYPERTRIGLYCERIDAEMIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hypertriglyceridaemia and hypercholesterolaemia on mTOR inhibitors reflect altered hepatic and adipose lipid handling, with both complexes implicated."];
  "RAPAMYCIN" -> "PHENO_HYPERTRIGLYCERIDAEMIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Altered hepatic and adipose lipid handling under inhibition of both complexes raises triglycerides and cholesterol in a dose-related manner; monitoring and statin therapy are the usual mitigation."];
  "RAPAMYCIN" -> "PHENO_LEAN_MASS" [arrowhead=odot, color="#898781", style=dashed, tooltip="In PEARL, lean tissue mass increased rather than decreased in women on 10 mg weekly compounded rapamycin; a secondary, sex-restricted finding at very low exposure."];
  "RAPAMYCIN" -> "PHENO_LEAN_MASS" [arrowhead=odot, color="#898781", style=dashed, tooltip="In the PEARL trial, lean tissue mass increased rather than decreased in women receiving 10 mg weekly compounded rapamycin, against the anabolic-resistance concern that chronic mTORC1 inhibition should reduce muscle mass in older adults."];
  "RAPAMYCIN" -> "PHENO_PROTEINURIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="urinalysis monitoring is the stated mitigation."];
  "RAPAMYCIN" -> "PHENO_PROTEINURIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Podocytes require mTORC1 for maintenance and autophagic flux, so inhibition can produce proteinuria; urinalysis monitoring is the recommended surveillance."];
  "RAPAMYCIN" -> "PHENO_SARCOPENIA" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="Chronic mTORC1 inhibition is predicted to impair the anabolic response of skeletal muscle and to promote sarcopenia; acute rapamycin blocks the contraction-induced rise in human muscle protein synthesis, whereas intermittent low-dose exposure has not produced measurable muscle loss and was associate"];
  "RAPAMYCIN" -> "PHENO_STOMATITIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rapalog stomatitis follows from mTORC1 dependence of renewing oral epithelium and is substantially preventable with topical dexamethasone or tacrolimus prophylaxis."];
  "RAPAMYCIN" -> "PHENO_STOMATITIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of mTORC1-dependent renewal in oral epithelium produces aphthous-type ulceration in roughly 30-60% of patients, the commonest dose-limiting rapalog toxicity in oncology."];
  "RAPAMYCIN" -> "PHENO_TREG_EXPANSION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rapamycin expands regulatory T cells preferentially, which is the basis of its immunosuppressive use."];
  "RAPAMYCIN" -> "PHENO_TREG_EXPANSION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR inhibition blocks Th1, Th2 and Th17 differentiation while permitting Foxp3+ regulatory T cell differentiation and expansion, which underlies the immunosuppressive use of the drug."];
  "RAPAMYCIN" -> "SASP" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapamycin suppresses the SASP without eliminating senescent cells, so a drug can give geroprotective benefit by attenuating consequences of a process it did not cause."];
  "RAPAMYCIN" -> "SNCA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Alpha-synuclein is degraded by both macroautophagy and the proteasome, and mTOR inhibition with rapamycin induces autophagy and lowers alpha-synuclein levels in cell models; rapamycin also protects dopaminergic neurons in rodent models of Parkinson disease."];
  "RAPAMYCIN" -> "AKT" [arrowhead=odot, color="#898781", style=solid, label="Ser473, Thr308", tooltip="Two opposing effects: relief of S6K1-IRS-1 feedback raises PI3K-dependent Thr308 signalling, while prolonged mTORC2 depletion lowers Ser473. Net direction depends on exposure duration and cell type."];
  "RAPAMYCIN" -> "DISEASE_ALLOGRAFT_REJECTION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Suppression of mTORC1-dependent effector lymphocyte expansion prevents renal allograft rejection; this was the first approved indication and is given at continuous, trough-monitored exposures."];
  "RAPAMYCIN" -> "DISEASE_LAM" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Sirolimus stabilises lung function in lymphangioleiomyomatosis, whose lesional cells carry biallelic TSC2 inactivation with constitutive mTORC1 activation as the principal driver; it also reduces serum VEGF-D and improves symptoms."];
  "RAPAMYCIN" -> "GRB10" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTORC1 phosphorylation stabilises Grb10, an inhibitor of insulin and IGF-1 receptor signalling; drug-induced loss of that stabilisation removes a second brake on upstream flux."];
  "RAPAMYCIN" -> "IRS1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Inhibiting mTORC1 removes S6K1-mediated inhibitory serine phosphorylation of IRS-1, stabilising it and restoring insulin- and IGF-1-driven PI3K output: the feedback arm of AKT rebound."];
  "RAPAMYCIN" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Acute inhibition is complex-selective because only mTORC1 presents an accessible FRB; suppression is substrate-selective, complete for S6K1 and incomplete for 4E-BP1."];
  "RAPAMYCIN" -> "PHENO_AMYLOID_BETA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapamycin reduces brain amyloid-beta and improves cognition in 3xTg-AD mice, with benefit dependent on intact autophagy and largely confined to treatment initiated before substantial pathology accumulates."];
  "RAPAMYCIN" -> "PHENO_HYPERCHOLESTEROLAEMIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Inhibition of mTOR raises plasma cholesterol alongside triglycerides through reduced lipoprotein lipase activity, increased adipose lipolysis and impaired clearance of apolipoprotein B-containing lipoproteins; the effect is dose-related at therapeutic exposures and is managed by lipid monitoring and"];
  "RAPAMYCIN" -> "PHENO_IMPAIRED_WOUND_HEALING" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Suppressed angiogenesis and fibroblast proliferation delay surgical healing, which is why planned perioperative interruption is advised before elective surgery."];
  "RAPAMYCIN" -> "PHENO_INFECTION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Suppression of effector lymphocyte expansion raises infection risk at immunosuppressive exposures; dose, schedule and vaccination timing are the available levers."];
  "RAPAMYCIN" -> "PHENO_INSULIN_RESISTANCE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Prolonged dosing disrupts mTORC2 in liver, muscle and adipose tissue, producing insulin resistance that is mechanistically separable from the longevity benefit in mice."];
  "RAPAMYCIN" -> "PHENO_MUSCLE_HYPERTROPHY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rapamycin blocks hypertrophy in response to IGF-1, mechanical overload and chronic stimulation, and blocks the contraction-induced rise in human muscle protein synthesis, showing that mTORC1 activity is required for load-induced muscle growth."];
  "RAPAMYCIN" -> "PHENO_PNEUMONITIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Non-infectious pneumonitis occurs in roughly 5-15% of oncology patients treated with rapalogs and is the most serious and least well understood toxicity of the class. It is probably immune-mediated rather than a direct consequence of mTORC1 blockade in lung epithelium, and management rests on vigila"];
  "RAPAMYCIN" -> "PHENO_PROTEIN_AGGREGATES" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Induction of macroautophagy accelerates clearance of alpha-synuclein and polyglutamine-expanded huntingtin, reducing aggregate burden and improving outcomes in fly and mouse models."];
  "RAPAMYCIN" -> "PROTEIN_SYNTHESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Acute rapamycin blocks the contraction-induced rise in human muscle protein synthesis, and mTORC1 activation is required for the response to essential amino acids."];
  "RIDAFOROLIMUS" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ridaforolimus binds FKBP12, and the binary complex engages the exposed FRB domain of assembled mTORC1, inhibiting the kinase allosterically as for the other first-generation rapalogs."];
  "RIDAFOROLIMUS" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="FKBP12-ridaforolimus complex binds the exposed FRB domain of assembled mTORC1 and sterically restricts substrate access."];
  "RMC5552" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser65, Thr37, Thr46, Thr70", tooltip="RMC-5552 tethers an FKBP12-rapamycin moiety to an ATP-site moiety; FKBP12-mediated avidity confers mTORC1 selectivity while the ATP-site moiety blocks catalysis. Phosphorylation of 4E-BP1 at all four sites, including the rapamycin-resistant priming sites Thr37 and Thr46, is therefore suppressed, and"];
  "RMC5552" -> "RPS6KB1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr389", tooltip="The bi-steric design tethers an FKBP12-rapamycin moiety to an ATP-site moiety; FKBP12-mediated avidity confers mTORC1 selectivity while the ATP-site moiety delivers complete catalytic inhibition, so both S6K1 Thr389 and 4E-BP1 are fully suppressed while mTORC2 is relatively spared."];
  "RMC5552" -> "DISEASE_ENDOMETRIAL_CANCER" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Complete response ongoing beyond six months, with clearance of pathway variants from circulating tumour DNA, in a patient with PTEN- and PIK3CA-altered endometrial cancer; 58% of enrolled patients carried pathogenic mTOR-pathway variants."];
  "RMC5552" -> "DISEASE_ENDOMETRIAL_CANCER" [arrowhead=odot, color="#898781", style=dashed, tooltip="One patient with PTEN- and PIK3CA-altered endometrial cancer achieved a complete response ongoing beyond six months, with clearance of pathway variants from circulating tumour DNA."];
  "RMC5552" -> "ATP_SITE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The ATP-competitive moiety occupies the kinase cleft, delivering complete catalytic inhibition of the FRB-anchored complex and thereby full suppression of both S6K1 and 4E-BP1 while mTORC2 is relatively spared."];
  "RMC5552" -> "DISEASE_CANCER" [arrowhead=odot, color="#898781", style=dashed, tooltip="In 57 patients with advanced solid tumours, disease control was reached in 64% at active doses and one PTEN- and PIK3CA-altered endometrial cancer achieved a complete response with clearance of variants from ctDNA."];
  "RMC5552" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The bi-steric agent carries an FKBP12-rapamycin moiety tethered by a linker to an ATP-site moiety; FKBP12 binding supplies the avidity that confers mTORC1 selectivity."];
  "RMC5552" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The FKBP12-bound moiety engages the exposed FRB domain of assembled mTORC1, anchoring the molecule and delivering the tethered ATP-site moiety to the kinase cleft of the same protomer."];
  "RMC5552" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="RMC-5552 was designed for mTORC1 selectivity with complete pathway suppression, exploiting FKBP12-mediated avidity for the complex whose FRB is exposed."];
  "RMC5552" -> "MTORC2" [arrowhead=odot, color="#898781", style=dashed, tooltip="mTORC2 is relatively spared because engagement depends on an accessible FRB; the clinical correlate is treatment-related hyperglycaemia in only 4% despite complete mTORC1 blockade."];
  "RMC5552" -> "PHENO_FATIGUE" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Treatment-related fatigue in 42% of patients in the first-in-human dose-escalation study."];
  "RMC5552" -> "PHENO_HYPERGLYCAEMIA" [arrowhead=odot, color="#898781", style=dashed, tooltip="Treatment-related hyperglycaemia occurred in only 4% and was not dose-limiting despite complete mTORC1 pathway suppression: the dissociation of efficacy from metabolic toxicity predicted by mTORC2 sparing."];
  "RMC5552" -> "PHENO_NAUSEA" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Second most frequent treatment-related adverse event (44%) in the 57-patient first-in-human dose-escalation study."];
  "RMC5552" -> "PHENO_STOMATITIS" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Mucositis occurred in 49% of 57 patients and grade 3 mucositis was dose-limiting at 10 mg or above, making it the characteristic limitation of the bi-steric generation."];
  "RTB101" -> "PHENO_ISG_EXPRESSION" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Expression of interferon-stimulated antiviral genes rose in older adults given RTB101 with low-dose everolimus for six weeks in a 264-participant phase 2a trial, the arm in which infection rates over the following year were also lower."];
  "RTB101" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="RTB101 (BEZ235/dactolisib) is an ATP-competitive PI3K/mTOR inhibitor. At the low exposures studied in older adults, the intended pharmacodynamic effect was preferential TORC1 inhibition."];
  "RTB101" -> "PHENO_RESPIRATORY_INFECTION" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="In the 264-participant phase 2a trial, six weeks of RTB101 with low-dose everolimus reduced participant-reported infections during one year of follow-up."];
  "RTB101" -> "PHENO_SYMPTOMATIC_RESPIRATORY_ILLNESS" [arrowhead=odot, color="#898781", style=solid, tooltip="The 1024-participant phase 3 trial did not meet its clinically symptomatic respiratory-illness endpoint. Phase 2b had found a signal for laboratory-confirmed infections with RTB101 monotherapy, while its combination comparison was not significant."];
  "RTB101" -> "PI3K" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="BEZ235 inhibits class I PI3K at sufficient concentrations; this biochemical target profile does not demonstrate substantial PI3K inhibition at the low doses used in the ageing trials."];
  "SAPANISERTIB" -> "AKT" [arrowhead=odot, color="#898781", style=solid, label="Ser473, Thr308", tooltip="ATP-competitive mTOR inhibition regulates AKT biphasically. Catalytic blockade of mTORC2 abolishes Ser473 phosphorylation and suppresses AKT activity acutely; relief of S6K1-IRS-1 and Grb10 feedback then drives receptor tyrosine kinase-dependent PI3K signalling, so Thr308 phosphorylation and AKT act"];
  "SAPANISERTIB" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser65, Thr37, Thr46, Thr70", tooltip="ATP-competitive occupancy of the mTOR kinase cleft suppresses phosphorylation of all four principal 4E-BP1 sites, including Thr37 and Thr46, which allosteric rapalogs leave largely intact. Hypophosphorylated 4E-BP1 is the active form, so eIF4E is sequestered and cap-dependent translation of mRNAs wi"];
  "SAPANISERTIB" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Occupying the ATP cleft blocks catalysis outright, suppressing all mTORC1 outputs including the rapamycin-resistant 4E-BP1 Thr37/Thr46 sites."];
  "SAPANISERTIB" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Because the kinase cleft is identical in both complexes and is not occluded by Rictor or mSin1, ATP-competitive agents abolish mTORC2 output including AKT Ser473."];
  "SAPANISERTIB" -> "PHENO_HYPERGLYCAEMIA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Complete inhibition of both complexes adds mTORC2-dependent hyperglycaemia and insulin resistance to the rapalog toxicity profile, which is the toxicity ceiling that limited this generation."];
  "SAPANISERTIB" -> "PHENO_INSULIN_RESISTANCE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Catalytic inhibition of mTORC2 removes AKT Ser473 phosphorylation in liver, adipose tissue and skeletal muscle. Reduced AKT output releases FOXO1-driven hepatic gluconeogenesis and impairs insulin-stimulated glucose uptake, so insulin resistance and hyperglycaemia are added to the metabolic profile "];
  "SAPANISERTIB" -> "RPS6KB1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr389", tooltip="ATP-competitive inhibition of the mTOR catalytic site abolishes phosphorylation of S6K1 at the Thr389 hydrophobic motif completely, in contrast with the partial and substrate-selective suppression achieved by allosteric agents."];
  "TACROLIMUS" -> "DISEASE_NODAT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Calcineurin inhibition in the pancreatic beta cell impairs insulin secretion and promotes beta-cell apoptosis, which is the principal mechanism of new-onset diabetes after transplantation in tacrolimus-based regimens."];
  "TACROLIMUS" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="FK506 binds the same immunophilin as rapamycin but presents a different effector surface, so the FKBP12-FK506 complex engages calcineurin rather than the FRB of mTOR."];
  "TACROLIMUS" -> "FKBP12_RAPAMYCIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="FK506 and rapamycin compete for the same FKBP12 binding pocket, so co-exposure antagonises formation of the mTORC1-inhibitory complex: a pharmacodynamic interaction relevant to combined regimens."];
  "TACROLIMUS" -> "PHENO_STOMATITIS" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Topical tacrolimus mouthwash prophylaxis reduced mucositis from 65% to 31% in the 8-12 mg cohorts of the RMC-5552 phase 1 study; systemic exposure is not the object."];
  "TACROLIMUS" -> "PPP3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The FKBP12-FK506 complex binds and inhibits the calcineurin phosphatase, blocking NFAT dephosphorylation and IL-2 transcription; this is a distinct mechanism from mTOR inhibition."];
  "TEMSIROLIMUS" -> "DISEASE_RCC" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Temsirolimus improved overall survival versus interferon-alpha in the Global ARCC trial in poor-prognosis advanced renal cell carcinoma."];
  "TEMSIROLIMUS" -> "FKBP12" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Temsirolimus binds FKBP12, and the binary complex engages the exposed FRB domain of assembled mTORC1 by the same allosteric mechanism as the parent macrolide."];
  "TEMSIROLIMUS" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Temsirolimus binds FKBP12 and the binary complex engages the exposed FRB domain of assembled mTORC1, sterically restricting substrate access; it is given intravenously as an ester prodrug converted to sirolimus, which contributes much of the effect in vivo."];
  "TEMSIROLIMUS" -> "PHENO_PROTEIN_AGGREGATES" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="CCI-779 (temsirolimus), the soluble ester analogue of rapamycin, induces autophagy and reduces polyglutamine aggregate burden and toxicity in fly and mouse models of Huntington disease."];
  "TEMSIROLIMUS" -> "RAPAMYCIN" [arrowhead=vee, color="#898781", style=solid, tooltip="Temsirolimus is given intravenously as an ester prodrug and is hydrolysed to sirolimus, which accounts for much of its systemic exposure and activity."];
  "TORIN1" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="ATP-competitive occupancy of the mTOR kinase cleft suppresses the rapamycin-resistant 4E-BP1 Thr37/Thr46 sites, so 4E-BP1 remains eIF4E-bound, eIF4F does not assemble, and cap-dependent initiation is blocked far more completely than with rapamycin."];
  "TORIN1" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser65, Thr37, Thr46, Thr70", tooltip="By occupying the ATP site of mTOR, Torin1 blocks phosphorylation of 4E-BP1 at all four sites, including the priming sites Thr37 and Thr46 that resist rapamycin, and cellular phosphatases then remove the existing phosphates. Hypophosphorylated 4E-BP1 sequesters eIF4E, so the activation of the repress"];
  "TORIN1" -> "RPS6KB1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr389", tooltip="ATP-competitive mTOR inhibition abolishes S6K1 Thr389 phosphorylation together with the rapamycin-resistant outputs of mTORC1, so mTORC1 signalling is suppressed completely rather than partially. The effect on S6K1 is indirect, through inhibition of the mTOR kinase."];
  "TORIN1" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Torin1 inhibits mTORC1 catalysis directly at the ATP site and was the tool compound that revealed rapamycin-resistant mTORC1 functions."];
  "TORIN1" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Torin1 blocks mTORC2 as well, abolishing AKT Ser473 phosphorylation, and is used experimentally to separate complex-selective from pan-mTOR effects."];
  "TORIN2" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Torin2 occupies the mTOR ATP-binding cleft and inhibits both complexes, including the rapamycin-resistant 4E-BP1 sites. It is more potent and more orally bioavailable than Torin1 but also inhibits the related PIKK family members ATM, ATR and DNA-PK, so selectivity for mTOR is incomplete at higher co"];
  "VAR_FRB_RESISTANCE" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser2035", tooltip="Substitution of the critical serine contact in the FRB domain of human mTOR, Ser2035, abolishes docking of the FKBP12-rapamycin complex while leaving kinase activity intact. FRB substitutions selected under prolonged rapamycin exposure, Ala2034Val and Phe2108Leu, confer rapalog resistance by the sam"];
  "VISTUSERTIB" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Vistusertib competes with ATP at the mTOR kinase cleft, inhibiting mTORC1 and mTORC2; it was selected from the AZD8055 series for improved pharmaceutical properties."];
  "VISTUSERTIB" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Vistusertib occupies the mTOR ATP cleft, which is common to both complexes, and therefore suppresses mTORC1 output completely, including the 4E-BP1 phosphorylation sites that allosteric agents leave only partly suppressed."];
  "VISTUSERTIB" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Because the ATP site is shared by both complexes and is not occluded by Rictor or mSin1, vistusertib inhibits mTORC2 as completely as mTORC1, abolishing AKT Ser473 phosphorylation; this is the source of the added metabolic toxicity of the ATP-competitive class."];
  "VISTUSERTIB" -> "PHENO_HYPERGLYCAEMIA" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Complete inhibition of mTORC2 by ATP-competitive agents produces hyperglycaemia through combined beta-cell dysfunction and peripheral insulin resistance, with mTORC2 contributing more than mTORC1; this metabolic ceiling limited clinical development of the class."];
  "CASTOR1" -> "GATOR2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Apo-CASTOR1 sequesters GATOR2, performing for arginine the function Sestrin2 performs for leucine"];
  "CASTOR2" -> "CASTOR1" [arrowhead=odot, color="#898781", style=solid, tooltip="CASTOR2 heterodimerises with CASTOR1; the heterodimer binds GATOR2 but CASTOR2 itself does not confer high-affinity arginine binding"];
  "CASTOR2" -> "GATOR2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="CASTOR2 binds GATOR2 as part of the CASTOR1-CASTOR2 heterodimer, contributing to arginine-regulated control of the hub"];
  "EIF2AK4" -> "EIF2S1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser51", tooltip="GCN2 phosphorylates eIF2alpha Ser51 during amino-acid starvation, reducing global translation initiation and inducing ATF4, which transcribes SESN2 to sustain mTORC1 suppression."];
  "LARS1" -> "RRAGD" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="LARS1 was reported to act as a leucine-dependent GAP for RagD, driving it to the GDP state that supports mTORC1 recruitment"];
  "MAT2A" -> "SAM" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="MAT2A converts methionine and ATP into S-adenosylmethionine, the metabolite bound by SAMTOR, and acute MAT2A loss attenuates methionine sensing by mTORC1 in cultured cells; MAT2A is the extrahepatic isoform, whereas MAT1A predominates in adult liver."];
  "NPC1" -> "SLC38A9" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="NPC1 associates with SLC38A9 and exports lysosomal cholesterol; loss of NPC1 traps cholesterol in the lumen and hyperactivates mTORC1 through this complex"];
  "OGT" -> "LARS1" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser1042", tooltip="OGT O-GlcNAcylates LARS1 at Ser1042 during glucose starvation, which blocks LARS1 binding to RagD and promotes ULK1 phosphorylation of its leucine-binding site, lowering leucine-induced mTORC1 activity."];
  "SAMTOR" -> "GATOR1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Unlike Sestrin2 and CASTOR1, apo-SAMTOR acts directly on GATOR1, promoting its activity and so inhibiting mTORC1 when SAM is low"];
  "SAMTOR" -> "KICSTOR" [arrowhead=odot, color="#898781", style=solid, tooltip="SAMTOR engages the GATOR1-KICSTOR assembly rather than GATOR2, which is why the methionine arm bypasses the Sestrin/CASTOR hub"];
  "SAR1B" -> "GATOR2" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="In the absence of leucine SAR1B binds GATOR2 and blocks its inhibition of GATOR1, keeping mTORC1 off; leucine binding to SAR1B dissociates the SAR1B-GATOR2 complex."];
  "SAR1B" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Leucine-bound SAR1B was reported to regulate mTORC1 activity; the downstream connection to the Rag machinery is not firmly established"];
  "SESN1" -> "GATOR2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Sestrin1 interacts with GATOR2 in the same way as Sestrin2, contributing to negative regulation of the amino-acid sensing pathway"];
  "SESN1" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="Sestrin1, like sestrin2, promotes AMPK activation and downstream TSC2 phosphorylation, forming the p53-dependent feedback loop that suppresses mTORC1 after genotoxic stress."];
  "SESN2" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Sestrins have been reported to activate AMPK and so to inhibit mTORC1 through TSC2, a route independent of GATOR2 sequestration; the molecular basis is undefined and Sestrin2 still suppresses mTORC1 in AMPK-null cells."];
  "SESN2" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="Sestrin1/2 were reported to bind AMPK (and TSC2) and promote AMPK-mediated TSC2 phosphorylation, mediating p53-dependent mTORC1 inhibition after genotoxic stress."];
  "SESN2" -> "GATOR2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Apo-Sestrin2 binds GATOR2 across the WDR24 and SEH1L beta-propellers, with auxiliary contacts to MIOS, preventing GATOR2 from inhibiting GATOR1 so RagA/B remain GDP-bound and mTORC1 leaves the lysosome; leucine binding (Kd approximately 20 microM) releases GATOR2."];
  "SESN2" -> "RRAGA" [arrowhead=tee, color="#d03b3b", style=dotted, tooltip="Alternative model in which Sestrin2 acts as a guanine-nucleotide dissociation inhibitor for RagA/B, locking them in the GDP state, rather than acting only by sequestering GATOR2. Published results conflict with the GATOR2-sequestration-only model."];
  "SESN2" -> "WDR24" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Sestrin2 binds the WDR24-SEH1L region of GATOR2; MIOS is the principal CASTOR1-binding subunit."];
  "SESN3" -> "GATOR2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Sestrin3 also binds GATOR2 and negatively regulates the amino-acid sensing pathway upstream of mTORC1"];
  "SLC1A5" -> "GLUTAMINE" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="SLC1A5 (ASCT2) is an obligatory sodium-dependent antiporter for glutamine; in the original model its uptake supplies the intracellular glutamine that LAT1 effluxes to drive leucine import, although later work finds ASCT2 dispensable for glutamine accumulation and mTORC1 activation when SNAT1 and SNA"];
  "SLC38A9" -> "AMINO_ACIDS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Arginine-activated SLC38A9 effluxes essential amino acids from the lysosomal lumen into the cytosol, which is how protein taken up by macropinocytosis or autophagy becomes usable nutrient; loss of SLC38A9 traps these amino acids in the lysosome."];
  "SLC38A9" -> "LEUCINE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SLC38A9 effluxes leucine and other essential amino acids from the lysosomal lumen in an arginine-dependent manner, supplying the cytosolic pool read by Sestrin2"];
  "SLC38A9" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Node-level summary: SLC38A9 activates mTORC1 through luminal arginine sensing and through lysosomal efflux of leucine and other essential amino acids; the cholesterol-sensing arm it shares with NPC1 is less firmly established and is carried separately."];
  "SLC38A9" -> "NPC1" [arrowhead=odot, color="#898781", style=dashed, tooltip="SLC38A9 and NPC1 physically associate in the lysosomal cholesterol-sensing pathway. This binding edge does not assert inhibition of NPC1 transport by SLC38A9."];
  "SLC38A9" -> "RAGULATOR" [arrowhead=odot, color="#898781", style=solid, tooltip="SLC38A9 co-assembles with Ragulator and the Rag GTPases as part of the lysosomal amino-acid sensing machinery; this contact positions the transceptor, while the arginine-dependent activating signal is exerted on the Rag GTPases."];
  "SLC38A9" -> "RAG_HETERODIMER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Arginine-bound SLC38A9 binds the Rag-Ragulator complex and signals amino-acid sufficiency, promoting mTORC1 recruitment"];
  "SLC38A9" -> "RRAGA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SLC38A9 acts as a non-canonical GEF for RagA, accelerating GDP release and favouring the GTP-loaded, Raptor-binding state"];
  "SLC3A2" -> "SLC7A5" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SLC3A2 (4F2hc/CD98 heavy chain) is disulphide-bonded to the SLC7A5 light chain; the heavy chain is required for surface delivery and transport function of the LAT1 heterodimer."];
  "SLC7A5" -> "GLUTAMINE" [arrowhead=odot, color="#898781", style=solid, tooltip="LAT1/4F2hc is an obligatory antiporter: it effluxes intracellular glutamine in exchange for extracellular leucine, so SLC1A5-mediated glutamine uptake is the driving force for leucine import. This coupling is why glutamine deprivation blunts leucine-driven mTORC1 activation."];
  "SLC7A5" -> "LEUCINE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="LAT1 imports leucine at the plasma membrane in obligatory exchange for efflux of intracellular glutamine, setting the cytosolic leucine concentration seen by the sensors"];
  "V_ATPASE" -> "AMINO_ACIDS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The proton gradient generated by the v-ATPase drives amino-acid efflux from the lysosomal lumen; lysosomal metabolomics shows v-ATPase- and mTOR-dependent control of lysosomal amino-acid export, placing the pump upstream of SLC38A9-dependent efflux as well as of the inside-out Ragulator signal."];
  "V_ATPASE" -> "RAGULATOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The v-ATPase relays luminal amino-acid content outward by regulating Ragulator GEF activity toward RagA/B - the inside-out sensing mechanism"];
  "V_ATPASE" -> "RAG_HETERODIMER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="v-ATPase function is required for amino acids to drive the Rag heterodimer into its active nucleotide configuration and recruit mTORC1"];
  "AR" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Androgen/AR signalling raises mTORC1 activity and cyclin D translation in prostate cancer cells; AR and PI3K–AKT are reciprocally cross-inhibitory in PTEN-null prostate cancer."];
  "EGFR" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Indirect. EGFR carries no high-affinity p85-binding motif of its own, so EGF-stimulated PI3K and AKT signalling is relayed through the docking protein GAB1 and, in EGFR-ERBB3 heterodimers, through the pYXXM motifs of ERBB3."];
  "ESR1" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Non-genomic: ligand-bound ERα binds p85α and activates PI3K–AKT; in TSC2-null cells estrogen enhances survival and pulmonary metastasis via ERK/mTORC1 signalling."];
  "IGF1R" -> "IRS1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="IGF-1R kinase tyrosine-phosphorylates IRS-1 (and IRS-2) YXXM motifs, recruiting p85–PI3K; mechanistically parallel to INSR."];
  "INSR" -> "IRS1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Activated INSR kinase phosphorylates IRS-1 on multiple tyrosines in YXXM motifs, generating SH2-docking sites for p85–PI3K and GRB2."];
  "IRS1" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Phospho-YXXM motifs on IRS-1 engage the SH2 domains of p85, relieving p85 inhibition of p110 and bringing PI3K to membrane PI(4,5)P2."];
  "IRS1" -> "SREBF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Indirect effect: insulin signalling through IRS-1, PI3K and AKT is a required positive input to hepatic SREBP1c expression and processing. In liver-specific Tsc1-deficient mice, S6K1-mediated inhibitory phosphorylation of IRS-1 suppresses this input and SREBP1c, protecting against diet-induced steat"];
  "NF1" -> "RAS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Neurofibromin's GAP-related domain accelerates Ras GTP hydrolysis; NF1 loss raises Ras·GTP and ERK/RSK input to TSC2 and Raptor."];
  "PHOSPHATIDIC_ACID" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, label="FRB domain (Arg2109)", tooltip="Phosphatidic acid binds the mTOR FRB domain, the surface also engaged by the FKBP12-rapamycin complex, and stimulates mTORC1; the Arg2109 dependence rests on mutagenesis in the original report, and displacement of DEPTOR has been described by one group."];
  "PHOSPHATIDIC_ACID" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Phospholipase D-generated phosphatidic acid transmits mechanical activation to mTOR, by an ERK-independent mechanism consistent with direct activation."];
  "PHOSPHATIDIC_ACID" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="PA is reported to be required for assembly/stability of both mTORC1 and mTORC2 and to oppose rapamycin at the FRB domain."];
  "PI3K" -> "PIP3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Class I PI3K phosphorylates the 3-OH of PI(4,5)P2 to generate PI(3,4,5)P3 at the plasma membrane."];
  "PI3K" -> "PIP3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Class I PI3K, activated by receptor tyrosine kinase engagement, converts PIP2 to PIP3."];
  "PI3K" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Growth-factor signalling through PI3K has been reported to promote association of mTORC2 with the ribosome as an activating input; this step comes from a single line of work, while the reproduced growth-factor input is direct PIP3 binding to the mSin1 PH domain, which relieves autoinhibition and rec"];
  "PIK3R1" -> "PI3K" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="p85 nSH2 and iSH2 contact the p110α helical and C2 domains to restrain basal lipid-kinase activity; pY-peptide binding to nSH2 releases this (the contacts disrupted by E545K/H1047R)."];
  "PIK3R1" -> "PI3K" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="p85α (nSH2–iSH2–cSH2) constitutively binds the p110 adaptor-binding domain, stabilising the catalytic subunit and forming the class IA heterodimer."];
  "PIP2" -> "PIP3" [arrowhead=vee, color="#898781", style=solid, tooltip="PI(4,5)P2 is 3-phosphorylated by PI3K to PI(3,4,5)P3; the reaction is reversed by the 3-phosphatase PTEN."];
  "PIP3" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PIP3 (and PI(3,4)P2) binding to the AKT PH domain recruits AKT to the membrane and relieves PH–kinase autoinhibition, exposing Thr308 to PDK1."];
  "PIP3" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="AKT PH domain", tooltip="PIP3 recruits AKT to the plasma membrane through its PH domain, which is prerequisite for both Thr308 and Ser473 phosphorylation."];
  "PIP3" -> "MAPKAP1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PIP3 binding to the mSin1 C-terminal PH domain relieves its autoinhibitory fold-back onto mTOR and recruits mTORC2 to the plasma membrane where AKT resides."];
  "PIP3" -> "MAPKAP1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The C-terminal PH domain of mSin1 binds PIP3, which releases the PH domain from mTOR and derepresses the kinase."];
  "PIP3" -> "MAPKAP1" [arrowhead=normal, color="#0ca30c", style=solid, label="mSin1 PH domain", tooltip="PIP3 binds the mSin1 PH domain and releases it from mTOR, relieving autoinhibition of the kinase."];
  "PIP3" -> "PDK1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The PDK1 PH domain binds PIP3 and PI(3,4)P2, holding PDK1 at the plasma membrane where PIP3-recruited AKT becomes accessible. PDK1 is catalytically active without stimulation and its own distribution changes little on growth-factor treatment, so the lipid governs substrate access, although phosphoin"];
  "PIP3" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PIP3 binding by mSin1 simultaneously relieves autoinhibition and recruits mTORC2 to the plasma membrane, co-localising it with membrane-targeted AKT."];
  "PIP3" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PIP3 binding simultaneously recruits mTORC2 to the plasma membrane, co-localising it with its membrane-targeted substrate AKT."];
  "PIP3" -> "PH_DOMAIN" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PtdIns(3,4,5)P3 generated by PI3K binds the mSin1 PH domain and pulls it off the kinase domain, relieving autoinhibition and simultaneously anchoring mTORC2 at the plasma membrane where Akt is recruited."];
  "PLD1" -> "PHOSPHATIDIC_ACID" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PLD1 hydrolyses phosphatidylcholine to phosphatidic acid and choline."];
  "PTEN" -> "PIP3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PTEN 3-phosphatase hydrolyses PIP3 back to PI(4,5)P2, terminating PDK1/AKT membrane recruitment; the dominant negative regulator of the PI3K–AKT–mTORC1 axis."];
  "PTEN" -> "PIP3" [arrowhead=tee, color="#d03b3b", style=solid, label="D3 phosphate", tooltip="PTEN dephosphorylates PIP3 to PIP2, terminating the lipid signal that relieves mSin1 autoinhibition and recruits mTORC2 and AKT."];
  "RAS" -> "MAPKAP1" [arrowhead=odot, color="#898781", style=dotted, tooltip="GTP-bound H-Ras and K-Ras (predominantly KRAS4A) bind the atypical Ras-binding domain of mSin1. Oncogenic Ras was reported to promote mTORC2 activity at the plasma membrane, but a Sin1 mutant unable to bind Ras supports normal mTORC2 assembly and activity in cells and mice, and Sin1 overexpression w"];
  "RAS" -> "MAPKAP1" [arrowhead=odot, color="#898781", style=dotted, tooltip="GTP-bound H-Ras and K-Ras (predominantly KRAS4A) bind the atypical Ras-binding domain of mSin1. Oncogenic Ras was reported to promote mTORC2 activity at the plasma membrane, but a Sin1 mutant unable to bind Ras supports normal mTORC2 assembly and activity in cells and mice, and Sin1 overexpression w"];
  "RAS" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ras·GTP binds the p110α Ras-binding domain, allosterically activating PI3K and coupling RTK/Ras signalling to PIP3 production."];
  "RAS" -> "RAF" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ras·GTP binds the RAF Ras-binding and cysteine-rich domains, recruiting RAF to the membrane where dimerisation and phosphorylation activate it."];
  "RTK" -> "GRB2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Receptor autophosphorylation creates phosphotyrosine docking sites bound by the GRB2 SH2 domain (directly on EGFR; via SHC or IRS-1 for the insulin and IGF-1 receptors), bringing the GRB2–SOS1 complex to the membrane."];
  "RTK" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ligand-activated RTKs autophosphorylate; pYXXM sites (directly or via IRS/GAB adaptors) recruit p85–p110 to the membrane, activating class I PI3K."];
  "ALDOA" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="FBP-unoccupied aldolase alters v-ATPase-Ragulator conformation, permitting AXIN-LKB1 docking and lysosomal AMPK Thr172 phosphorylation without an AMP rise; FBP-bound aldolase blocks the assembly."];
  "AXIN1" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="AMP binding to the AMPK gamma subunit drives AXIN to tether LKB1 to AMPK, and under glucose starvation the AXIN-LKB1-AMPK complex docks on the lysosomal v-ATPase-Ragulator, allowing LKB1 to phosphorylate AMPK Thr172."];
  "AXIN1" -> "STK11" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Under low energy, AMP-bound AMPK, AXIN and LKB1 assemble into a complex in which AXIN tethers LKB1 to AMPK, enhancing Thr172 phosphorylation; AXIN knockdown in mouse liver impairs AMPK activation after starvation."];
  "CAB39" -> "LKB1_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="MO25-alpha (or MO25-beta) is the scaffold subunit of the LKB1 heterotrimer."];
  "CAB39" -> "STK11" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="MO25-alpha binds the STRADA C-terminal WEF motif and the LKB1 kinase domain, stabilising the heterotrimer and increasing LKB1 activity about 10-fold beyond STRADA alone."];
  "CAMKK2" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr172", tooltip="CaMKK-beta phosphorylates AMPK Thr172 in response to rises in cytosolic Ca2+ (e.g. ionophores, hormones), independently of LKB1 and without a change in AMP:ATP."];
  "EGLN1" -> "HIF1A" [arrowhead=tee, color="#d03b3b", style=solid, label="Pro402, Pro564", tooltip="In normoxia PHD2 hydroxylates HIF-1α at Pro402 and Pro564 using O2 as co-substrate, creating the pVHL-binding degron; the reaction rate is limited by oxygen tension, which is what makes HIF-1α an oxygen sensor."];
  "EIF2AK3" -> "EIF2S1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser51", tooltip="PERK phosphorylates eIF2alpha Ser51, trapping eIF2B and reducing ternary-complex formation; global initiation falls while ATF4 translation rises."];
  "LKB1_COMPLEX" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr172", tooltip="The constitutively active LKB1–STRADα–MO25 heterotrimer is the upstream kinase that phosphorylates the AMPK activation loop at Thr172; STRADα and MO25 are required for LKB1 catalytic competence and cytoplasmic localisation."];
  "MITOCHONDRIAL_COMPLEX_I" -> "ATP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Complex I oxidises NADH and pumps protons, sustaining the proton-motive force that ATP synthase uses, so complex I activity is required for maximal oxidative ATP production rather than converting a substrate into ATP. Biguanide inhibition of complex I therefore lowers ATP and raises AMP and ADP, the"];
  "PEN2" -> "ATP6AP1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Metformin-bound PEN2 binds the v-ATPase accessory subunit ATP6AP1 and inhibits the lysosomal v-ATPase, triggering AXIN–LKB1-dependent activation of lysosomal AMPK at clinically relevant metformin concentrations and without a fall in cellular ATP."];
  "PEX5" -> "TSC2" [arrowhead=odot, color="#898781", style=dashed, tooltip="PEX5, the peroxisomal targeting-signal receptor, binds TSC2 and localises a pool of the TSC complex to the peroxisome, where it suppresses Rheb in response to reactive oxygen species; TSC1 is recognised by the partner receptor PEX19."];
  "STK11" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr172", tooltip="LKB1 (with STRADA/MO25) phosphorylates the AMPK alpha activation-loop Thr172; AMP bound to the gamma subunit makes AMPK a better substrate and protects pThr172, so net phosphorylation rises with AMP/ATP."];
  "STK11" -> "LKB1_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="LKB1 is the catalytic subunit of the LKB1-STRADA-MO25 heterotrimer, the constitutively active upstream kinase of AMPK."];
  "STRADA" -> "LKB1_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="STRAD-alpha (or STRAD-beta) is the pseudokinase subunit of the LKB1 heterotrimer required for its activity and cytoplasmic localisation."];
  "STRADA" -> "STK11" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The pseudokinase STRAD-alpha binds the LKB1 kinase domain and, together with MO25, stabilises the catalytically active conformation and anchors LKB1 in the cytoplasm where AMPK is phosphorylated; STRAD-alpha alone gives only partial activation."];
  "GLS" -> "AKG" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glutaminase hydrolyses glutamine to glutamate and ammonia, the first step of glutaminolysis; glutamate is then converted to alpha-ketoglutarate by GLUD1 or transaminases, so GLS is required for, but does not itself produce, alpha-ketoglutarate from glutamine."];
  "GLS" -> "GLUTAMINE_ANAPLEROSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glutaminase converts glutamine to glutamate, the entry step that permits GDH-dependent anaplerosis"];
  "VAR_NF1_LOF" -> "NF1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss of neurofibromin removes Ras-GAP activity, raising Ras·GTP and MAPK/RSK input to TSC2 and Raptor."];
  "VAR_NF1_LOF" -> "DISEASE_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of NF1 is listed among the recurrent alterations in the PI3K-AKT-mTOR landscape in cancer."];
  "VAR_NF1_LOF" -> "RAS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of the Ras GAP neurofibromin raises RAS-ERK-RSK signalling, which converges on the TSC complex and so raises mTORC1 output."];
  "VAR_PIK3CA_GOF" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, label="E542K, E545K, H1047L, H1047R", tooltip="Helical-domain mutations escape p85 nSH2 inhibition; kinase-domain H1047R increases membrane binding; both raise PIP3 and AKT–mTORC1 flux (distal-network lesion)."];
  "VAR_PIK3CA_GOF" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, label="E542K, E545K, H1047L, H1047R", tooltip="Helical (E542K, E545K) and kinase (H1047R/L) hotspot mutations raise PI3K catalytic output and hence PIP3 production."];
  "VAR_PIK3CA_GOF" -> "DISEASE_BREAST_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Activating PIK3CA mutations are present in roughly 30-40% of breast cancers and define the population in which alpelisib improved progression-free survival."];
  "VAR_PIK3CA_GOF" -> "DISEASE_ENDOMETRIAL_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Activating PIK3CA mutations occur in roughly 30% of endometrial cancers; a PTEN- and PIK3CA-altered endometrial cancer gave the first complete response to RMC-5552."];
  "VAR_PIK3CA_GOF" -> "DISEASE_FCD2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Somatic mosaic PIK3CA activation is an alternative genotype of focal cortical dysplasia type II, converging on the same mTORC1 hyperactivation."];
  "VAR_PIK3CA_GOF" -> "DISEASE_HME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hemimegalencephaly is caused by de novo somatic mutations in components of the PI3K-AKT3-mTOR pathway, including PIK3CA."];
  "VAR_PIK3CA_GOF" -> "DISEASE_PROS" [arrowhead=normal, color="#0ca30c", style=solid, label="E542K, E545K, H1047R", tooltip="Mosaic somatic PIK3CA activating variants cause the PIK3CA-related overgrowth spectrum (CLOVES, megalencephaly-capillary malformation, isolated macrodactyly), the non-neoplastic counterpart of the somatic mosaicism described for FCD type II and hemimegalencephaly."];
  "VAR_PIK3CA_GOF" -> "VAR_CLASS_DISTAL_NETWORK" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="PIK3CA mutation raises flux into a branched network in which mTORC1 is one effector among several, the defining property of the distal-network class."];
  "VAR_PIK3CA_GOF" -> "ALPELISIB" [arrowhead=odot, color="#898781", style=solid, tooltip="PIK3CA hotspot mutation was the prospective selection criterion in SOLAR-1 and predicts benefit, in contrast to its failure to predict rapalog benefit in the same disease."];
  "VAR_PTEN_LOF" -> "PTEN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PTEN loss removes PIP3 hydrolysis and raises AKT activity; it is a frequent distal-network lesion in prostate, glioblastoma and endometrial cancer."];
  "VAR_PTEN_LOF" -> "DISEASE_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss-of-function PTEN alterations are among the most common lesions of prostate cancer, glioblastoma and endometrial carcinoma, and raise flux through the PI3K-AKT network without creating dependency on the mTOR node."];
  "VAR_PTEN_LOF" -> "DISEASE_ENDOMETRIAL_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PTEN is one of the most frequently mutated genes in endometrioid endometrial carcinoma, and a patient with PTEN- and PIK3CA-altered endometrial cancer had a complete response to the mTORC1-selective inhibitor RMC-5552 that was ongoing beyond six months."];
  "VAR_PTEN_LOF" -> "DISEASE_GLIOBLASTOMA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PTEN is one of the most frequently inactivated tumour suppressors in glioblastoma, where loss-of-function mutations and deletions are common."];
  "VAR_PTEN_LOF" -> "DISEASE_PHTS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Germline PTEN loss causes the PTEN hamartoma tumour syndromes, including Cowden syndrome, with hamartomas, macrocephaly and elevated breast, thyroid and endometrial cancer risk."];
  "VAR_PTEN_LOF" -> "DISEASE_PROSTATE_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PTEN is frequently inactivated in prostate cancer through mutation or deletion, raising flux through the PI3K-AKT pathway."];
  "VAR_PTEN_LOF" -> "PIP3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of the PIP3 3-phosphatase PTEN allows PIP3 to accumulate, raising flux through PDK1 and AKT into the branched distal network."];
  "VAR_PTEN_LOF" -> "VAR_CLASS_DISTAL_NETWORK" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="PTEN loss raises network flux while AKT retains mTORC1-independent output to GSK3beta, FOXO and MDM2, so no mTOR-node dependency is created."];
  "VAR_RTK_AMP" -> "RTK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Receptor tyrosine kinase gene amplification increases ligand-dependent and -independent PI3K recruitment; distal-network lesion converging on PI3K."];
  "VAR_RTK_AMP" -> "PI3K" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Receptor tyrosine kinase amplification converges on PI3K, raising network flux without creating dependency on the mTOR node specifically."];
  "VAR_RTK_AMP" -> "VAR_CLASS_DISTAL_NETWORK" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Receptor tyrosine kinase amplification converges on PI3K and belongs among the distal-network alterations."];
  "ABCB1" -> "EVEROLIMUS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Everolimus is an ABCB1 (P-glycoprotein) substrate; brain accumulation is restricted by ABCB1 and rises when the transporter is absent or pharmacologically inhibited."];
  "ABCB1" -> "EVEROLIMUS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Everolimus is an ABCB1 substrate; brain accumulation is restricted by the transporter and rises when it is absent or pharmacologically inhibited."];
  "ABCB1" -> "PHENO_CNS_DRUG_EXPOSURE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Sirolimus and everolimus are ABCB1 substrates; brain accumulation of everolimus rises when the transporter is absent or pharmacologically inhibited."];
  "ABCB1" -> "PHENO_CNS_DRUG_EXPOSURE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Efflux at the blood-brain barrier shields the CNS from systemic exposure but equally limits target engagement wherever the brain is the therapeutic object, decoupling central from peripheral exposure."];
  "ABCB1" -> "RAPAMYCIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Sirolimus is an ABCB1 substrate, so central and peripheral exposure-response relationships cannot be assumed to coincide; a dose titrated to whole-blood S6K1 phosphorylation is not thereby titrated in brain."];
  "ABCB1" -> "RAPAMYCIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="P-glycoprotein effluxes sirolimus at the apical membrane of enterocytes, which together with first-pass CYP3A metabolism keeps oral bioavailability low: approximately 14% for the oral solution, with tablet exposure about 27% higher and not bioequivalent to it. The same transporter handling underlies"];
  "ABCB1" -> "TEMSIROLIMUS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Temsirolimus and the sirolimus it yields are P-glycoprotein substrates, so efflux limits their distribution into tissues, most consequentially across the blood-brain barrier. Because temsirolimus is administered intravenously, intestinal efflux does not contribute to its systemic exposure."];
  "CYP3A4" -> "EVEROLIMUS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Everolimus is likewise a CYP3A4 substrate, giving extensive interaction potential with azoles, macrolides, rifampicin and anticonvulsants and requiring exposure-guided dosing."];
  "CYP3A4" -> "PHENO_CNS_DRUG_EXPOSURE" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="In mice, CYP3A acts together with plasma carboxylesterase to clear everolimus systemically and so sets the blood concentration from which central exposure derives; restriction of brain penetration itself is attributed chiefly to P-glycoprotein at the blood-brain barrier."];
  "CYP3A4" -> "RAPAMYCIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="CYP3A4 in gut and liver demethylates and hydroxylates sirolimus, so CYP3A4 inducers and inhibitors shift its exposure several-fold; whole-blood trough monitoring, commonly in the range of 5-15 ng/mL in transplantation, is therefore standard."];
  "CYP3A4" -> "TEMSIROLIMUS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Temsirolimus is cleared principally by hepatic CYP3A4, which hydroxylates and demethylates it, so CYP3A4 inhibitors and inducers markedly alter its exposure. The drug is given intravenously, so no intestinal first-pass step contributes, and its principal active metabolite sirolimus arises by hydroly"];
  "FKBP12" -> "FKBP12_RAPAMYCIN" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="FKBP12, a peptidyl-prolyl isomerase, is the intracellular receptor for rapamycin and contributes one half of the composite surface that binds FRB. Inhibition of mTOR is a gain of function of the drug-immunophilin complex, not a consequence of blocking isomerase activity."];
  "FKBP12_RAPAMYCIN" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The composite FKBP12-rapamycin surface wedges into the FRB domain adjacent to the catalytic cleft, narrowing substrate access; this gain-of-function mechanism explains why rapamycin is an allosteric, substrate-selective inhibitor rather than an ATP-competitive one."];
  "FKBP12_RAPAMYCIN" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The FKBP12-rapamycin binary complex engages the four-helix FRB bundle, forming the ternary complex resolved crystallographically."];
  "FKBP12_RAPAMYCIN" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The ternary structure shows the drug sandwiched between FKBP12 and a hydrophobic FRB cleft; neither protein contacts the other substantially, so binding is strictly drug-dependent."];
  "FKBP12_RAPAMYCIN" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="With prolonged exposure the drug-immunophilin complex captures newly synthesised mTOR before it is incorporated into mTORC2, depleting the complex rather than inhibiting the assembled one."];
  "FKBP12_RAPAMYCIN" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Docking on the exposed FRB of assembled mTORC1 sterically restricts access of substrates to the already deep catalytic cleft rather than abolishing catalysis, giving partial, substrate-selective inhibition."];
  "PPIA" -> "PPP3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The cyclosporine-cyclophilin A complex binds and inhibits calcineurin, converging on the same target as the tacrolimus-FKBP12 complex; neither free immunophilin inhibits the phosphatase."];
  "ARF1" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Arf1 is required for glutamine-induced mTORC1 activation and lysosomal translocation by a route that does not require the Rag GTPases"];
  "C12ORF66" -> "KICSTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="C12orf66 is one of the four subunits of the KICSTOR scaffold"];
  "DEPDC5" -> "GATOR1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="DEPDC5 is the largest of the three GATOR1 subunits and provides the principal Rag-binding surface"];
  "DEPDC5" -> "RAG_HETERODIMER" [arrowhead=odot, color="#898781", style=dashed, tooltip="DEPDC5 binds GTP-loaded RagA with high affinity in an inhibitory mode that restrains, rather than stimulates, GATOR1-mediated GTP hydrolysis; catalysis is executed through weaker NPRL2-NPRL3 contacts, and the DEPDC5 mode is proposed to keep GATOR1 from becoming hyperactive."];
  "FLCN" -> "FLCN_FNIP" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Folliculin supplies the longin GAP domain of the FLCN-FNIP heterodimer"];
  "FLCN_FNIP" -> "RRAGC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="FLCN-FNIP is the GAP for RagC, driving it to the GDP state required for the active heterodimer; unlike GATOR1 this GAP activity is positive for mTORC1"];
  "FLCN_FNIP" -> "RRAGD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="FLCN-FNIP acts with the same polarity on RagD, the RagC paralogue, promoting the GDP state that supports mTORC1 recruitment"];
  "FLCN_FNIP" -> "TFEB" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="FLCN-FNIP loads RagC/D with GDP, which is specifically required for mTORC1 to phosphorylate TFEB at Ser211 and keep it cytoplasmic; FLCN loss therefore leaves TFEB nuclear while S6K1 and 4E-BP1 phosphorylation are preserved."];
  "FNIP1" -> "AMPK" [arrowhead=odot, color="#898781", style=dashed, tooltip="FNIP1 was identified through its interaction with both folliculin and AMPK, suggesting the FLCN-FNIP module also reads energy status"];
  "FNIP1" -> "FLCN_FNIP" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="FNIP1 heterodimerises with folliculin to form the catalytically competent RagC/D GAP"];
  "FNIP2" -> "FLCN_FNIP" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="FNIP2 is the paralogue of FNIP1 and forms an equivalent FLCN-FNIP2 GAP complex"];
  "GATOR1" -> "RRAGA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="GATOR1 is the GTPase-activating protein for RagA, driving GTP hydrolysis and so releasing mTORC1 from the lysosome; it is active when amino acids are scarce"];
  "GATOR1" -> "RRAGB" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="GATOR1 acts with equivalent GAP polarity on RagB, the RagA paralogue, making it a negative regulator of mTORC1 recruitment"];
  "GATOR2" -> "GATOR1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="GATOR2 is a positive regulator of mTORC1 that acts by inhibiting GATOR1; the molecular basis of that inhibition remains incompletely defined"];
  "ITFG2" -> "KICSTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="ITFG2 is one of the four subunits of the KICSTOR scaffold"];
  "KICSTOR" -> "GATOR1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="KICSTOR recruits GATOR1 to the lysosomal surface; without it GATOR1 cannot reach its Rag substrate and nutrients fail to regulate mTORC1"];
  "KICSTOR" -> "LYSOSOME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The KICSTOR scaffold localises to the lysosomal surface and is the platform that positions GATOR1 there"];
  "KPTN" -> "KICSTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="KPTN is one of the four subunits of the KICSTOR scaffold"];
  "LAMTOR1" -> "LYSOSOME" [arrowhead=normal, color="#0ca30c", style=solid, label="Cys3/Cys4 (palmitoylation), Gly2 (myristoylation)", tooltip="N-terminal myristoylation and palmitoylation of LAMTOR1 anchor Ragulator, and with it the Rag heterodimer, to the lysosomal membrane"];
  "LAMTOR1" -> "RAGULATOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="LAMTOR1 wraps around the LAMTOR2-5 roadblock heterodimers and supplies the membrane anchor of the pentameric complex"];
  "LAMTOR1" -> "V_ATPASE" [arrowhead=odot, color="#898781", style=solid, tooltip="LAMTOR1 (p18) binds the v-ATPase directly, contacting V0 subunit d1 and V1 subunit D, and so physically couples the proton pump to the Ragulator-Rag module; amino acids weaken the Ragulator interaction with the V1 sector."];
  "LAMTOR2" -> "RAGULATOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="LAMTOR2 forms a roadblock heterodimer with LAMTOR3 within Ragulator"];
  "LAMTOR3" -> "RAGULATOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="LAMTOR3 partners LAMTOR2 in the Ragulator roadblock core"];
  "LAMTOR4" -> "RAGULATOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="LAMTOR4 forms a roadblock heterodimer with LAMTOR5 that directly contacts the Rag roadblock domains"];
  "LAMTOR5" -> "RAGULATOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="LAMTOR5 partners LAMTOR4 in the Ragulator roadblock core"];
  "MIOS" -> "GATOR2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="MIOS is a beta-propeller subunit of the octameric GATOR2 assembly"];
  "NPRL2" -> "GATOR1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="NPRL2 contributes the longin domain that carries the catalytic residue for GAP activity toward RagA/B"];
  "NPRL2" -> "RRAGA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="NPRL2 is the catalytic subunit of the GATOR1 GAP: its Arg78 acts as the arginine finger, inserting into the RagA nucleotide pocket to stimulate GTP hydrolysis."];
  "NPRL3" -> "GATOR1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="NPRL3 bridges NPRL2 and DEPDC5 to complete the trimeric GATOR1 assembly"];
  "RAB1A" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Rab1A is required for amino-acid-stimulated mTORC1 activation and interacts with Rheb on Golgi membranes; it is amplified and oncogenic in colorectal cancer"];
  "RAGULATOR" -> "FLCN_FNIP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rag-Ragulator provides the lysosomal docking site for FLCN-FNIP; during starvation FLCN is held inactive on RagA.GDP until amino acids are resupplied"];
  "RAGULATOR" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Structural work defines the Ragulator-Rag assembly as the platform onto which mTORC1 docks at the lysosomal surface"];
  "RAGULATOR" -> "RAG_HETERODIMER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The pentameric Ragulator clamps the Rag roadblock domains against the lysosomal membrane, providing the anchor without which the Rags cannot deliver mTORC1"];
  "RAGULATOR" -> "RRAGA" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="Ragulator was reported to act as a guanine nucleotide exchange factor for RagA/B (Bar-Peled 2012), but later reconstitution found that it chiefly triggers GTP release from RagC, with SLC38A9 acting as the GEF for RagA."];
  "RAGULATOR" -> "AXIN1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Under glucose starvation v-ATPase-Ragulator recruits AXIN-LKB1 to the lysosomal surface next to lysosomal AMPK; AXIN simultaneously blocks Ragulator GEF activity toward RagA/B, releasing mTORC1 from the lysosome."];
  "RNF152" -> "RRAGA" [arrowhead=tee, color="#d03b3b", style=dashed, label="Lys142, Lys220, Lys230, Lys244", tooltip="The lysosomal E3 ligase RNF152 attaches K63-linked ubiquitin chains to RagA in an amino-acid-sensitive manner, creating a docking site that recruits GATOR1 and so promotes RagA GTP hydrolysis and mTORC1 inactivation."];
  "RNF152" -> "RHEB" [arrowhead=tee, color="#d03b3b", style=dashed, label="Lys8", tooltip="The lysosomal E3 ligase RNF152 mono-ubiquitinates Rheb at Lys8, increasing its affinity for the TSC complex and suppressing mTORC1; EGF stimulation acts through AKT-phosphorylated USP4, which deubiquitinates Rheb and releases it from the complex."];
  "RUVBL1" -> "TTT_COMPLEX" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="RUVBL1 (Pontin) binds the Tel2-Tti1-Tti2 module as part of the R2TP co-chaperone, whose PIH1D1 subunit recognises CK2-phosphorylated Tel2. The ATP-dependent TTT-RUVBL1/2 assembly is needed for mTOR stability, mTORC1 dimerisation and mTORC1 binding to the Rag GTPases."];
  "RUVBL1" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Energy-replete conditions drive TTT-RUVBL1/2 assembly, which promotes mTORC1 dimerisation and lysosomal localisation; energy stress dissociates the module and the dimer, coupling nutrient state to the oligomeric state of the complex."];
  "RUVBL2" -> "TTT_COMPLEX" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="RUVBL2 (Reptin) binds the Tel2-Tti1-Tti2 module together with RUVBL1 as part of the R2TP co-chaperone, whose PIH1D1 subunit recognises CK2-phosphorylated Tel2. The ATP-dependent TTT-RUVBL1/2 assembly is needed for mTOR stability, mTORC1 dimerisation and mTORC1 binding to the Rag GTPases."];
  "SEC13" -> "GATOR2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="SEC13, also a COPII and nuclear-pore component, is a structural subunit of GATOR2"];
  "SEH1L" -> "GATOR2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="SEH1L, a WD40 protein shared with the nuclear pore complex, is a structural subunit of GATOR2"];
  "SH3BP4" -> "RAG_HETERODIMER" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Under amino-acid starvation SH3BP4 binds the inactive Rag heterodimer and prevents formation of the active, mTORC1-recruiting configuration"];
  "SKP2" -> "RRAGA" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="SCF-SKP2 attaches K63-linked ubiquitin chains to RagA and promotes GATOR1 recruitment, a negative feedback that limits amino-acid-dependent mTORC1 hyperactivation."];
  "SZT2" -> "GATOR1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SZT2 binds GATOR1 directly and dictates GATOR control of mTORC1 signalling, acting as the pivotal contact within the scaffold"];
  "SZT2" -> "GATOR2" [arrowhead=odot, color="#898781", style=dashed, tooltip="SZT2 not only nucleates KICSTOR but also contacts GATOR2, bringing GATOR1 and GATOR2 into one lysosomal supercomplex so that the sensor branch and the GAP branch are physically coupled."];
  "SZT2" -> "KICSTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="SZT2 is the very large fourth subunit around which the KICSTOR scaffold assembles"];
  "VAR_FLCN_LOF" -> "DISEASE_BHD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of folliculin causes Birt-Hogg-Dube syndrome with fibrofolliculomas, pulmonary cysts and renal tumours"];
  "VAR_FLCN_LOF" -> "DISEASE_BHD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of FLCN causes Birt-Hogg-Dube syndrome, in which mTORC1 signalling is dysregulated tissue-dependently rather than uniformly increased."];
  "VAR_FLCN_LOF" -> "FLCN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Germline FLCN loss abolishes RagC/D GAP activity, dysregulating mTORC1 in a tissue-dependent rather than uniformly increased manner"];
  "VAR_FLCN_LOF" -> "TFEB" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser211", tooltip="Without FLCN GAP activity RagC/D remains GTP-bound, so mTORC1 cannot phosphorylate TFEB at Ser211 even though it phosphorylates S6K1 and 4E-BP1 normally, and TFEB accumulates constitutively in the nucleus; removing TFEB rescues the renal phenotype of kidney-specific Flcn-knockout mice, indicating th"];
  "VAR_FLCN_LOF" -> "FLCN_FNIP" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="FLCN loss removes the GAP for RagC/D; mTORC1 signalling is consequently dysregulated in a tissue-dependent rather than uniformly increased manner."];
  "VAR_SZT2_LOF" -> "DISEASE_SZT2_ENCEPHALOPATHY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Biallelic SZT2 mutations cause infantile encephalopathy with epilepsy and dysmorphic corpus callosum - the clinical proof that KICSTOR is non-redundant in humans"];
  "VAR_SZT2_LOF" -> "DISEASE_SZT2_ENCEPHALOPATHY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Biallelic SZT2 mutations cause a neurodevelopmental syndrome with epilepsy through loss of KICSTOR-dependent GATOR1 recruitment."];
  "VAR_SZT2_LOF" -> "KICSTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Biallelic SZT2 loss-of-function disables the scaffold, preventing GATOR1 recruitment and producing nutrient-insensitive mTORC1 activity"];
  "VAR_SZT2_LOF" -> "KICSTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Biallelic SZT2 loss disables the KICSTOR scaffold required for GATOR1 lysosomal recruitment, the clinical proof that the scaffold is non-redundant in humans."];
  "WDR24" -> "GATOR1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Within GATOR2, WDR24 is the subunit most strictly required for GATOR2 to inhibit GATOR1 and hence for amino-acid-dependent mTORC1 activation."];
  "WDR24" -> "GATOR2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="WDR24 is one of the five named subunits of the octameric GATOR2 assembly"];
  "WDR59" -> "GATOR2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="WDR59 is a beta-propeller/RING-like subunit of the octameric GATOR2 assembly"];
  "AKT" -> "AKT1S1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr246", tooltip="AKT phosphorylates PRAS40 Thr246, promoting 14-3-3 binding and release of PRAS40 from Raptor; feed-forward derepression of mTORC1 by growth factors."];
  "AKT" -> "AKT1S1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr246", tooltip="AKT phosphorylates PRAS40 at Thr246, releasing it from Raptor and derepressing mTORC1 - the feed-forward arm of growth-factor input, parallel to AKT inactivation of TSC2."];
  "AKT" -> "BAD" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser99 (human; Ser136 in mouse numbering)", tooltip="AKT phosphorylates BAD at Ser99, creating a 14-3-3 binding site that sequesters BAD and prevents it from neutralising BCL-XL; this survival output is favoured by Ser473-phosphorylated AKT."];
  "AKT" -> "BAD" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser99 (human; Ser136 in mouse)", tooltip="AKT phosphorylates BAD to promote 14-3-3 binding and reduce its pro-apoptotic activity."];
  "AKT" -> "FOXO1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser256, Ser319, Thr24", tooltip="AKT phosphorylation of FOXO1 creates 14-3-3 sites and excludes it from the nucleus; output markedly enhanced by mTORC2-dependent Ser473 phosphorylation."];
  "AKT" -> "FOXO1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser256, Ser319, Thr24", tooltip="Ser473 phosphorylation markedly enhances AKT activity toward FOXO1; phosphorylated FOXO1 binds 14-3-3 and is excluded from the nucleus."];
  "AKT" -> "FOXO1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser256, Ser319, Thr24", tooltip="Ser473-dependent AKT activity phosphorylates FOXO1, excluding it from the nucleus and suppressing gluconeogenic gene expression; this is the step through which hepatic mTORC2 restrains gluconeogenesis."];
  "AKT" -> "FOXO3" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser253, Ser315, Thr32", tooltip="AKT phosphorylates FOXO3a at three sites, promoting 14-3-3 binding and cytoplasmic retention, suppressing pro-apoptotic transcription."];
  "AKT" -> "FOXO3" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser253, Ser315, Thr32", tooltip="FOXO3a phosphorylation by AKT is strongly Ser473-dependent, producing 14-3-3 binding and nuclear exclusion of a pro-apoptotic transcriptional programme."];
  "AKT" -> "GSK3B" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser9", tooltip="AKT phosphorylates GSK3β Ser9 (GSK3α Ser21), creating a pseudosubstrate that inhibits the kinase; an mTORC1-independent AKT output retained with Thr308-only phosphorylation."];
  "AKT" -> "GSK3B" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser9", tooltip="AKT phosphorylated only at Thr308 retains substantial activity toward GSK3β, so this output is largely independent of mTORC2."];
  "AKT" -> "GSK3B" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser9", tooltip="AKT retains mTORC1-independent output to GSK3beta; this is the stated reason distal-network lesions raise pathway flux without making the tumour dependent on the mTOR node."];
  "AKT" -> "MDM2" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser166, Ser186", tooltip="AKT phosphorylates MDM2 Ser166/Ser186, promoting nuclear translocation and p53 ubiquitination; an mTORC1-independent AKT output."];
  "AKT" -> "MDM2" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser166, Ser186", tooltip="AKT phosphorylates MDM2, promoting nuclear entry and p53 turnover; part of the mTORC1-independent AKT output retained in distal-network lesions."];
  "AKT" -> "MDM2" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser166, Ser186", tooltip="AKT retains mTORC1-independent output to MDM2, and thus to p53, one of several branches showing that mTORC1 is only one effector downstream of AKT."];
  "AKT" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser1130, Ser1132, Ser939, Ser981, Thr1462", tooltip="AKT phosphorylates TSC2 at five sites, Ser939 and Thr1462 being dominant, creating 14-3-3 binding sites; the demonstrated consequence is release of the TSC complex from the lysosomal membrane where Rheb resides, so Rheb·GTP accumulates. Stable dissociation of TSC1 from TSC2 remains poorly supported."];
  "AKT" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser939, Thr1462", tooltip="AKT phosphorylates and inactivates TSC2, permitting Rheb·GTP accumulation; this output is largely retained by Thr308-only AKT."];
  "AKT" -> "TSC_COMPLEX" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Insulin/AKT-dependent TSC2 phosphorylation releases the TSC complex from lysosomal membranes, physically separating the Rheb GAP from Rheb."];
  "AKT" -> "AMPK" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser487 (human AMPK alpha1; Ser485 in rat)", tooltip="AKT phosphorylates the AMPK alpha1 ST-loop at human Ser487, reducing subsequent Thr172 phosphorylation by upstream kinases."];
  "AKT" -> "MAPKAP1" [arrowhead=normal, color="#0ca30c", style=dotted, label="Thr86", tooltip="AKT phosphorylates mSin1 at Thr86, which one laboratory found to enhance mTORC2 activity toward AKT Ser473 and so create positive feedback. Another laboratory found that Thr86 and Thr398 phosphorylation, triggered by S6K or AKT depending on cell context, dissociates mSin1 from mTORC2 and suppresses "];
  "AKT" -> "MTOR" [arrowhead=odot, color="#898781", style=dotted, label="Ser2448", tooltip="Akt phosphorylates mTOR on Ser2448 downstream of PI3K; the site is a widely used activity biomarker but its functional consequence is disputed, and S6K1 phosphorylates the same residue, so the kinase assignment itself is contested."];
  "AKT" -> "TBC1D4" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr642", tooltip="AKT phosphorylates the Rab GAP AS160, creating a 14-3-3 site that relieves its restraint on GLUT4 storage vesicles."];
  "AKT" -> "PHENO_MUSCLE_ATROPHY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Constitutively active AKT prevents denervation-induced atrophy in vivo."];
  "AKT" -> "PHENO_MUSCLE_HYPERTROPHY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Constitutively active AKT produces massive skeletal-muscle hypertrophy, establishing sufficiency of the AKT-mTOR arm for load-independent growth."];
  "CSNK1A1" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="After mTOR-mediated priming, CK1alpha phosphorylates DEPTOR to complete the phosphodegron recognised by the SCF-betaTrCP ubiquitin ligase."];
  "DGKZ" -> "PHOSPHATIDIC_ACID" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="DGKζ phosphorylates diacylglycerol to phosphatidic acid; the mechanically induced rise in PA and mTORC1 activity in muscle depends on DGKζ rather than on PLD."];
  "ERK" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=dashed, label="Ser696, Ser8, Ser863", tooltip="ERK1/2 phosphorylate Raptor at Ser8/Ser696/Ser863 (proline-directed), promoting Ras-dependent mTORC1 activation."];
  "ERK" -> "RSK" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser363, Thr359, Thr573 (CTKD)", tooltip="ERK docks on the RSK C-terminus and phosphorylates the CTKD activation loop and linker; CTKD then autophosphorylates the hydrophobic motif (Ser380), creating the PDK1 docking site."];
  "ERK" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser540, Ser664", tooltip="ERK phosphorylates TSC2 (Ser664 principal), dissociating TSC1–TSC2 and functionally inactivating the complex; links Ras/MAPK activation to mTORC1."];
  "ERK" -> "RRN3" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser633", tooltip="ERK phosphorylates TIF-IA at Ser633, required for Pol I transcription and cell growth; an mTORC1-independent input to rRNA synthesis."];
  "ERK" -> "UBTF" [arrowhead=normal, color="#0ca30c", style=dashed, label="Thr117, Thr201", tooltip="ERK1/2 phosphorylates UBF at Thr117 and Thr201 within HMG boxes 1 and 2, which prevents these boxes from binding DNA and alters UBF-induced rDNA architecture. This mediates the immediate activation of Pol I transcription by growth factors such as EGF."];
  "ERK" -> "TFEB" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser142", tooltip="ERK2 phosphorylates TFEB at Ser142 under nutrient-replete conditions, favouring cytoplasmic retention of TFEB and limiting expression of its lysosomal and autophagy target genes."];
  "ERK" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="MEK–ERK signalling couples photic stimulation to mTORC1 in the SCN: MEK inhibition blocks the light-induced rise in S6K1 and 4E-BP1 phosphorylation"];
  "FARNESYLTRANSFERASE" -> "RHEB" [arrowhead=normal, color="#0ca30c", style=solid, label="Cys181 (CAAX)", tooltip="Farnesylation of the Rheb CAAX motif (Cys181) is required for endomembrane/lysosomal localisation and hence for mTORC1 activation."];
  "GRB2" -> "SOS1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The GRB2 SH3 domains bind the proline-rich C-terminus of SOS1 constitutively; receptor engagement relocates the GRB2–SOS1 complex to the plasma membrane next to Ras."];
  "GSK3B" -> "TSC2" [arrowhead=normal, color="#0ca30c", style=dashed, label="Ser1337, Ser1341", tooltip="After AMPK priming at Ser1345, GSK3 phosphorylates TSC2 Ser1341/Ser1337, further activating TSC2; Wnt inhibits GSK3 and thereby relieves TSC2 to activate mTORC1, integrating Wnt and energy signals."];
  "GSK3B" -> "RICTOR" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser1235", tooltip="During ER stress, GSK-3beta phosphorylates Rictor at Ser1235, which interferes with binding of AKT to mTORC2 and lowers AKT Ser473 phosphorylation."];
  "HERC1" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="HERC1 E3 ligase binds and ubiquitinates TSC2 not protected by TSC1, promoting its degradation."];
  "IKBKB" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="IKK-beta phosphorylates and suppresses TSC1, disinhibiting Rheb and therefore raising mTORC1 activity; this is one plausible molecular link between chronic inflammation and the anabolic dysregulation of ageing tissue."];
  "IKBKB" -> "TSC1" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser487, Ser511", tooltip="IKK-beta phosphorylates TSC1 Ser487/Ser511, suppressing TSC1 and the TSC complex so Rheb-GTP and mTORC1 activity rise; links inflammation to tumour angiogenesis and anabolic dysregulation."];
  "MAPK14" -> "MAPKAPK2" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser272, Thr222, Thr334", tooltip="Stress-activated p38 MAPK phosphorylates and activates MK2."];
  "MAPKAPK2" -> "TSC2" [arrowhead=odot, color="#898781", style=dashed, label="Ser1210", tooltip="MK2 phosphorylates TSC2 Ser1210, enhancing 14-3-3 binding; the net effect on Rheb-GAP activity and mTORC1 output is not firmly established."];
  "MAPKAPK2" -> "ZFP36L1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="MK2 phosphorylates ZFP36L1, inactivating its degradation of AU-rich-element-containing cytokine transcripts"];
  "MAPKAPK2" -> "SASP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="MK2-dependent phosphorylation of the RNA-binding protein ZFP36L1 relieves degradation of SASP transcripts."];
  "MEK" -> "ERK" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr185/Tyr187 (ERK2, MAPK1), Thr202/Tyr204 (ERK1, MAPK3)", tooltip="Dual-specificity MEK1/2 phosphorylate both residues of the ERK TEY activation-loop motif, Thr202 and Tyr204 in ERK1 and Thr185 and Tyr187 in ERK2, activating the kinases."];
  "PDK1" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr308", tooltip="PDK1 phosphorylates the AKT activation loop at Thr308 once both are PIP3-bound; required for activity and, with Ser473, for full activation."];
  "PDK1" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr308", tooltip="PDK1 phosphorylates the AKT activation loop; AKT requires this together with Ser473 for full activity."];
  "PDK1" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr229", tooltip="After mTORC1 phosphorylates the S6K1 hydrophobic motif (Thr389), PDK1 phosphorylates the activation loop at Thr229 (p70 numbering), completing S6K1 activation."];
  "PDK1" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr229", tooltip="After Thr389 priming, PDK1 phosphorylates the S6K1 activation loop at Thr229, completing kinase activation."];
  "PDK1" -> "RSK" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser227 (RSK2 NTKD activation loop)", tooltip="PDK1, recruited to the phospho-Ser386 hydrophobic motif, phosphorylates the NTKD activation loop, completing RSK activation."];
  "PHLPP" -> "AKT" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser473", tooltip="PHLPP1/2 directly dephosphorylate the AKT hydrophobic motif Ser473, terminating mTORC2-dependent activation and promoting apoptosis."];
  "PP2A" -> "AKT" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr308", tooltip="The B55α-containing PP2A holoenzyme dephosphorylates AKT Thr308, opposing PDK1 and restraining AKT output to TSC2/PRAS40."];
  "PRKDC" -> "AKT" [arrowhead=normal, color="#0ca30c", style=dashed, label="Ser473", tooltip="After DNA double-strand breaks DNA-PKcs phosphorylates AKT Ser473 independently of mTORC2, promoting survival signalling."];
  "RAF" -> "MEK" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser218 (MEK1), Ser222 (MEK1)", tooltip="RAF phosphorylates MEK1 Ser218/Ser222 (MEK2 Ser222/Ser226) in the activation segment."];
  "RSK" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=dashed, label="Ser719, Ser721, Ser722", tooltip="RSK phosphorylates Raptor at Ser719/721/722, increasing mTORC1 kinase activity downstream of oncogenic Ras/MAPK independently of TSC2."];
  "RSK" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=dashed, label="Ser719, Ser721, Ser722", tooltip="RSK phosphorylates Raptor at an activating serine cluster downstream of oncogenic MAPK signalling, raising mTORC1 output independently of TSC."];
  "RSK" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser1798", tooltip="RSK phosphorylates TSC2 C-terminal Ser1798 (and in vitro Ser939/Thr1462), inhibiting GAP function; the route by which phorbol esters and activated Ras raise mTORC1."];
  "RSK" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="RSK1, activated downstream of ERK, was reported to phosphorylate the DEPTOR betaTrCP degron after growth-factor stimulation, promoting DEPTOR degradation and relieving mTOR inhibition."];
  "RSK" -> "EEF2K" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser366", tooltip="p90RSK1 phosphorylates eEF2K at the same Ser366 site as S6K1, providing ERK-pathway control of elongation."];
  "RSK" -> "EIF4B" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser422", tooltip="RSK phosphorylates the same eIF4B Ser422 site as S6K1, so mTORC1 and Ras-ERK pathways converge on eIF4B."];
  "RSK" -> "RPS6" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser235, Ser236", tooltip="Ras-ERK-activated RSK phosphorylates rpS6 at Ser235/236 independently of mTORC1, promoting cap-binding-complex assembly."];
  "RSK" -> "RRN3" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser649", tooltip="RSK phosphorylates TIF-IA at Ser649, cooperating with ERK Ser633 phosphorylation to activate Pol I transcription."];
  "SOS1" -> "RAS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SOS1 catalyses GDP→GTP exchange on membrane-anchored Ras; Ras·GTP then engages RAF and the p110α Ras-binding domain."];
  "TBC1D7" -> "TSC_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="One TBC1D7 subunit bridges the TSC1 coiled-coils in the 2:2:1 TSC1-TSC2-TBC1D7 assembly, which is the form that carries Rheb-GAP activity."];
  "TBC1D7" -> "TSC_COMPLEX" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TBC1D7 binding to the TSC1 coiled-coil stabilises the TSC1-TSC2 association that presents the Rheb-GAP domain; its depletion weakens that association and reduces Rheb-GAP activity, raising mTORC1 signalling, without lowering TSC2 levels or altering TSC2 localisation to the lysosome."];
  "TPT1" -> "RHEB" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="TCTP was proposed as a Rheb guanine-nucleotide exchange factor in Drosophila; subsequent biochemical studies found no GEF activity."];
  "TSC1" -> "TSC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TSC1 binding blocks HERC1-mediated ubiquitination of TSC2, stabilising tuberin; TSC2 protein is unstable without hamartin."];
  "TSC1" -> "TSC_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Two TSC1 (hamartin) copies form the coiled-coil scaffold of the 2:2:1 arch-shaped TSC1–TSC2–TBC1D7 complex."];
  "TSC2" -> "RHEB" [arrowhead=tee, color="#d03b3b", style=solid, label="Asn1643 (TSC2 asparagine thumb)", tooltip="TSC2 GAP domain accelerates Rheb GTP hydrolysis ~100-fold via an asparagine-thumb mechanism, converting Rheb·GTP to inactive Rheb·GDP; Rheb has no established GEF."];
  "TSC2" -> "TSC_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Two TSC2 (tuberin) copies supply the Rheb-GAP domains presented at the apex of the arch."];
  "TSC_COMPLEX" -> "RHEB" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The TSC1–TSC2–TBC1D7 complex (2:2:1) presents the TSC2 GAP domain at its apex to lysosomal Rheb and accelerates GTP hydrolysis ~100-fold; in the absence of insulin the complex is held on the lysosome through Rheb and is released when AKT phosphorylates TSC2."];
  "TSC_COMPLEX" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="The TSC1–TSC2 complex physically associates with mTORC2 and promotes its activity toward AKT, independently of its Rheb GAP function."];
  "AMPK" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Activated AMPK inhibits mTORC1 by two routes: phosphorylation of TSC2, which enhances its GAP activity toward Rheb, and direct phosphorylation of Raptor at Ser722 and Ser792, which creates 14-3-3 binding sites and imposes a metabolic checkpoint."];
  "AMPK" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="During acute energetic stress AMPK phosphorylates mTOR and Rictor within mTORC2, increasing mTORC2 activity toward AKT Ser473 and promoting cell survival, independently of its inhibition of mTORC1."];
  "AMPK" -> "RPTOR" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser722, Ser792", tooltip="AMPK directly phosphorylates Raptor at two conserved serines, creating 14-3-3 binding sites that reduce mTORC1 kinase activity; imposes a metabolic checkpoint (G2/M arrest) independent of TSC2."];
  "AMPK" -> "RPTOR" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser722, Ser792", tooltip="AMPK phosphorylates Raptor at Ser722/Ser792, directly inhibiting mTORC1 in parallel with its action on TSC2 and imposing a metabolic checkpoint."];
  "AMPK" -> "TP53" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser15", tooltip="Glucose deprivation-activated AMPK phosphorylates p53 Ser15, initiating a p53-dependent metabolic checkpoint (cell-cycle arrest) and transcription of sestrins, REDD1, PTEN and TSC2 that feed back on mTORC1."];
  "AMPK" -> "TSC2" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser1387, Thr1271", tooltip="Under energy stress AMPK phosphorylates TSC2 at Thr1271 and Ser1387, enhancing its GAP activity toward Rheb and lowering Rheb-GTP; this is required for energy-stress inhibition of mTORC1 and protects cells from apoptosis during energy deprivation."];
  "AMPK" -> "ULK1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="AMPK associates with ULK1 in a nutrient-dependent manner; the association is required for AMPK-mediated activating phosphorylation of ULK1 and is disrupted when mTORC1 phosphorylates ULK1 at Ser757 (mouse numbering; Ser758 in human ULK1)."];
  "AMPK" -> "ULK1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser317, Ser555, Ser777", tooltip="Under glucose starvation AMPK binds and phosphorylates ULK1 at multiple sites, activating it to initiate autophagy/mitophagy; this is prevented when mTORC1 phosphorylates ULK1 Ser757."];
  "AMPK" -> "ULK1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser317, Ser555, Ser777", tooltip="Energy-stress-activated AMPK phosphorylates ULK1 at activating sites, initiating autophagy and mitophagy; blocked when mTORC1 has marked Ser757"];
  "AMPK" -> "CRY1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser71", tooltip="AMPK phosphorylates CRY1, promoting FBXL3-dependent ubiquitination and degradation; this destabilises the clock's negative limb and entrains the oscillator to cellular energy state."];
  "AMPK" -> "CSNK1E" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser389", tooltip="AMPK phosphorylates casein kinase 1ε at Ser389, increasing its activity toward PER2; a second route (besides CRY1) by which cellular energy status reaches the clock"];
  "ATM" -> "AMPK" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Indirect relay: ROS-activated cytoplasmic ATM acts through LKB1 to increase AMPK Thr172 phosphorylation, and AMPK then phosphorylates TSC2, represses mTORC1 and induces autophagy; the response is lost in ATM-deficient cells, and no direct phosphorylation of AMPK by ATM has been shown."];
  "ATM" -> "STK11" [arrowhead=odot, color="#898781", style=dashed, label="Thr366", tooltip="ATM phosphorylates LKB1 at Thr366 (Thr363 in mouse) in response to ionising radiation and oxidative stress; the modification does not change LKB1 catalytic activity in vitro, but a non-phosphorylatable LKB1 mutant failed to restore ROS-induced mTORC1 repression in LKB1-deficient cells."];
  "ATM" -> "TP53" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser15", tooltip="ATM phosphorylates p53 Ser15 (and CHK2, which phosphorylates Ser20), weakening MDM2 binding and stabilising/activating p53 after DNA damage."];
  "BNIP3" -> "RHEB" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Hypoxia-induced BNIP3 binds Rheb directly and lowers Rheb-GTP levels in a manner requiring its N-terminal domain, contributing to mTORC1 inhibition in hypoxia."];
  "DDIT4" -> "TSC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="REDD1-dependent mTORC1 inhibition requires TSC2 in the cited models. This functional relationship does not establish direct REDD1 binding to 14-3-3 or direct stimulation of TSC2 catalysis."];
  "DDIT4" -> "YWHA" [arrowhead=tee, color="#d03b3b", style=dotted, tooltip="Direct REDD1 binding to 14-3-3 and displacement of TSC2 were proposed, but a subsequent structural and biochemical study did not detect REDD1-14-3-3 binding."];
  "EIF2S1" -> "ATF4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Phospho-eIF2alpha lowers ternary-complex availability; delayed reinitiation after uORF1 bypasses the inhibitory uORF2 so the ATF4 coding sequence is translated (integrated stress response)."];
  "PPM1A" -> "AMPK" [arrowhead=tee, color="#d03b3b", style=dashed, label="Thr172", tooltip="PP2C-family phosphatases dephosphorylate AMPK Thr172 and switch the kinase off; AMP, and roughly ten-fold less potently ADP, binds the gamma-subunit CBS sites and protects Thr172 from dephosphorylation. This protection is distinct from the direct allosteric activation of the already phosphorylated k"];
  "PRKAB1" -> "AMPK" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Scaffolding beta subunit (beta1 or beta2) bridging alpha and gamma; its C-terminus binds both, its CBM binds glycogen and contributes to the ADaM drug site."];
  "PRKAG1" -> "AMPK" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Regulatory gamma subunit (gamma1/2/3) whose four tandem CBS motifs form two Bateman domains with three occupied adenine-nucleotide sites: one holds AMP almost permanently, two exchange AMP, ADP and ATP, and one site remains unoccupied, conferring energy sensing on the heterotrimer."];
  "TP53" -> "DDIT4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="p53 (and p63) bind the DDIT4/REDD1 promoter and induce it after DNA damage; REDD1 then releases TSC2 from 14-3-3 to suppress mTORC1."];
  "TP53" -> "PRKAB1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="p53 transcriptionally induces the AMPK β1 regulatory subunit, raising AMPK heterotrimer abundance as part of the same transcriptional programme that induces sestrins, TSC2 and PTEN."];
  "TP53" -> "PTEN" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="p53 binds a PTEN promoter element and induces PTEN; higher PTEN lowers PIP3-AKT, relieving AKT inhibition of TSC2 and reducing mTORC1 as one arm of the coordinated p53-mTOR response."];
  "TP53" -> "SESN1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="p53 binds response elements in SESN1 (PA26) and induces it after DNA damage; Sestrin1 contributes to p53-dependent mTORC1 suppression via GATOR2 binding and AMPK."];
  "TP53" -> "SESN2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="p53 induces SESN2 (Hi95) after genotoxic stress; Sestrin2 then inhibits mTORC1, principally by sequestering GATOR2, linking DNA damage to growth arrest."];
  "TP53" -> "TSC2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="p53 transcriptionally induces TSC2 in a stress-, cell-type- and tissue-specific manner, raising Rheb-GAP capacity and reinforcing mTORC1 suppression after genotoxic stress."];
  "VHL" -> "HIF1A" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="pVHL, the substrate-recognition subunit of a CUL2–elongin BC E3 ligase, binds prolyl-hydroxylated HIF-1α and polyubiquitinates it for proteasomal degradation; VHL loss in clear-cell renal carcinoma produces constitutive HIF signalling."];
  "CDC37" -> "HSP90AA1" [arrowhead=odot, color="#898781", style=solid, tooltip="Cdc37 binds the N-terminal nucleotide-binding domain of Hsp90, holds its lid open and inserts an arginine into the ATP pocket. This arrests the ATPase cycle while a client kinase is loaded."];
  "HSP90AA1" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hsp90 acts with TTT/R2TP in maturing newly synthesised mTOR; Hsp90 inhibition destabilises mTOR and reduces mTORC1 signalling."];
  "TELO2" -> "TTI1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Tel2 binds Tti1 (and Tti2) to form the TTT module; loss of any subunit destabilises the others and lowers the steady-state level of all PIKKs including mTOR."];
  "TELO2" -> "TTT_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Tel2 binds the Tti1-Tti2 subcomplex through a conserved surface patch to form the TTT co-chaperone, which works with Hsp90 on newly synthesised PIKKs, including mTOR, to support their assembly into functional complexes."];
  "TTI1" -> "TTT_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Tti1 binds Tel2 and Tti2 to form the TTT module and, with Tel2, is required for mTOR stability and for assembly of mTORC1 and mTORC2."];
  "TTI2" -> "TTT_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="loss of any one subunit destabilises the others."];
  "TTT_COMPLEX" -> "RAG_HETERODIMER" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Under nutrient sufficiency the TTT-RUVBL1/2 complex promotes mTORC1 dimerisation and its localisation to the Rag-Ragulator platform; energy stress disassembles it"];
  "TTT_COMPLEX" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The TTT module binds nascent mTOR and, with R2TP/Hsp90, supports its folding; TTT depletion lowers mTOR protein and collapses signalling through both complexes."];
  "TTT_COMPLEX" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Knockdown of Tti1 or Tel2 disassembles mTORC1 and mTORC2 as well as lowering mTOR levels, and Tel2 with Hsp90 is required to incorporate newly made mTOR into both complexes. This indicates a role in complex assembly beyond protein stabilisation."];
  "TTT_COMPLEX" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The same TTT-dependent assembly requirement applies to mTORC2, whose integrity falls on Tti1-Tel2 depletion."];
  "PIK3C3" -> "PIK3C3_COMPLEX_I" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="VPS34 is the catalytic lipid kinase of class III PI3K complex I, generating PI(3)P at the phagophore"];
  "PER2" -> "CLOCK_BMAL1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PER2 acts within the PER–CRY repressor to inhibit CLOCK–BMAL1-driven transcription, setting the phase at which its own TSC1-dependent repression of mTORC1 occurs."];
  "PER2" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="By recruiting TSC1 to the mTORC1 complex, PER2 suppresses mTORC1 activity in a time-of-day-dependent manner; the most direct clock-to-mTORC1 mechanism described."];
  "PER2" -> "PER_CRY_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="PER2 heterodimerises with CRY proteins to form the PER–CRY repressor complex of the negative limb"];
  "PER2" -> "RPTOR" [arrowhead=odot, color="#898781", style=dashed, tooltip="PER2 engages the mTORC1 holocomplex (Raptor-containing) and scaffolds TSC1 onto it, which is how the TSC1 GAP arm is delivered to mTORC1 rather than acting only through the cytosolic TSC complex"];
  "PER2" -> "TSC1" [arrowhead=odot, color="#898781", style=solid, tooltip="PER2 binds TSC1 and acts as a scaffold delivering it to the mTORC1 complex; the interaction is time-of-day dependent, tracking the circadian abundance of PER2."];
  "VAR_AKT1_GOF" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="E17K", tooltip="AKT1 E17K in the PH domain increases PIP3-independent membrane association and constitutive Thr308/Ser473 phosphorylation."];
  "VAR_AKT1_GOF" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Activating AKT1 alteration raises AKT output, which includes mTORC1-independent signalling to GSK3beta, FOXO and MDM2."];
  "VAR_AKT1_GOF" -> "DISEASE_PROTEUS" [arrowhead=normal, color="#0ca30c", style=solid, label="E17K", tooltip="A mosaic somatic AKT1 c.49G>A (E17K) activating variant causes Proteus syndrome, present in affected tissues and absent from unaffected tissues of the same individuals."];
  "VAR_AKT1_GOF" -> "VAR_CLASS_DISTAL_NETWORK" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="PIK3CA, PTEN, AKT1 and receptor tyrosine kinase amplification make up the distal-network class."];
  "VAR_AKT3_GOF" -> "AKT3" [arrowhead=normal, color="#0ca30c", style=solid, label="E17K", tooltip="Somatic mosaic activating AKT3 variants confined to malformed cortex drive mTORC1 hyperactivation causing hemimegalencephaly / focal cortical dysplasia type II."];
  "VAR_AKT3_GOF" -> "AKT3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Somatic mosaic AKT3 activation raises pathway output in the affected cortical lineage."];
  "VAR_AKT3_GOF" -> "DISEASE_FCD2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="AKT3 is among the genes of focal cortical dysplasia type II, acting through somatic mosaic activation."];
  "VAR_AKT3_GOF" -> "DISEASE_HME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Somatic mosaic AKT3 activation causes hemimegalencephaly with hemispheric enlargement and severe epilepsy."];
  "VAR_NF2_LOF" -> "PHENO_RAPALOG_SENSITIVITY" [arrowhead=odot, color="#898781", style=dotted, tooltip="An NF2 nonsense mutation co-occurred with the TSC1 lesion in the index everolimus exceptional responder, and NF2 was one of five selection genes in the prospective basket study that did not demonstrate meaningful single-agent activity."];
  "LYSOSOME" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 is activated on the cytosolic face of the lysosomal membrane, which is the point at which nutrient, growth-factor and stress information is spatially integrated"];
  "LYSOSOME" -> "RHEB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rheb resides on lysosomal/endomembrane surfaces, so mTORC1 can only meet GTP-loaded Rheb after Rag-dependent recruitment; cytosolic mTORC1 is effectively Rheb-free"];
  "RAG_HETERODIMER" -> "FLCN_FNIP" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="During amino-acid starvation Rag-Ragulator traps FLCN-FNIP2 in the inactive lysosomal folliculin complex (LFC), holding FLCN's catalytic arginine finger away from the RagC nucleotide pocket; amino-acid refeeding releases the complex and licenses RagC/D GTP hydrolysis. This checkpoint explains why FL"];
  "RAG_HETERODIMER" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The active Rag configuration tethers mTORC1 to the lysosomal surface; cryo-EM defines how mTORC1 docks onto the Rag-Ragulator assembly"];
  "RAG_HETERODIMER" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rag-mediated docking tethers mTORC1 to the lysosomal surface where Rheb-GTP is available; without it the complex remains diffusely cytosolic and cannot be activated."];
  "RAG_HETERODIMER" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="RagA/B.GTP-RagC/D.GDP binds Raptor directly; this interaction is the physical basis of amino-acid-dependent mTORC1 localisation"];
  "RAG_HETERODIMER" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="RagA/B-GTP with RagC/D-GDP binds Raptor directly; the reciprocal nucleotide configuration releases it. The Rag-Raptor contact is a docking point, not an allosteric activator."];
  "RAG_HETERODIMER" -> "TFEB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The Rag GTPases recruit TFEB (and MITF family members) to the lysosomal surface, which is the prerequisite for their phosphorylation by mTORC1"];
  "RAG_HETERODIMER" -> "TFEB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Amino-acid-loaded Rag GTPases recruit TFEB and MITF to the lysosomal surface, which is required for mTORC1 to phosphorylate them"];
  "RRAGA" -> "RAG_HETERODIMER" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="RagA forms the obligate heterodimer with RagC or RagD through paired roadblock domains"];
  "RRAGA" -> "RRAGC" [arrowhead=odot, color="#898781", style=solid, tooltip="Intersubunit crosstalk: the nucleotide state of one Rag biases the nucleotide state and GAP accessibility of its partner, enabling rapid switching with amino-acid availability"];
  "RRAGB" -> "RAG_HETERODIMER" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="RagB is the functional paralogue of RagA and occupies the same position in the obligate heterodimer"];
  "RRAGC" -> "RAG_HETERODIMER" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="RagC pairs with RagA/B through roadblock-domain contacts to form the obligate heterodimer"];
  "RRAGC" -> "TFEB" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser211", tooltip="Phosphorylation of TFEB by mTORC1 requires RagC/D in its GDP state, making TFEB a substrate-specific output of the FLCN arm rather than of Rheb-driven mTORC1 activity"];
  "RRAGD" -> "RAG_HETERODIMER" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="RagD is the functional paralogue of RagC within the obligate heterodimer"];
  "FKBP8" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=dotted, tooltip="FKBP38 was proposed to bind the mTOR FRB region and hold mTORC1 inactive until displaced by Rheb·GTP."];
  "RHEB" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="GTP-loaded Rheb binds the N-HEAT, M-HEAT and FAT regions of mTOR, distal to the catalytic cleft, and allosterically realigns the FAT and kinase domains into a catalytically competent active site; lysosomal recruitment alone is insufficient for activation."];
  "RHEB" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rheb·GTP binds the mTOR N-HEAT/FAT region, realigning FAT and kinase domains (DFG motif, αC helix) into a catalytically competent state; needed after Rag-mediated lysosomal recruitment."];
  "RHEB" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rheb-GTP binding realigns the N-HEAT, FAT and kinase domains, correcting the misaligned active site; this allosteric step is the proximate activation of lysosomal mTORC1."];
  "RHEB" -> "FKBP8" [arrowhead=tee, color="#d03b3b", style=dotted, tooltip="Rheb·GTP was proposed to bind FKBP38 and release it from mTOR, de-repressing mTORC1."];
  "RHEB" -> "PLD1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Rheb·GTP binds and stimulates PLD1 in a GTP-dependent manner, providing a parallel phosphatidic-acid route to mTORC1 activation."];
  "RHEB" -> "RAF" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Rheb·GTP binds the N-terminal region of B-Raf/C-Raf, reducing kinase activity and B-Raf–C-Raf heterodimerisation; an mTOR-independent crosstalk that dampens ERK output when TSC is lost."];
  "RHEB" -> "FAT_DOMAIN" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="GTP-loaded Rheb binds the N-terminal portions of the N-HEAT, M-HEAT and FAT domains about 60 Å from the kinase active site; the resulting movement twists the FAT clamp and realigns the DFG motif and alphaC helix into a catalytically competent active site."];
  "RHEB" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rheb-GTP binds across the mTOR N-HEAT, M-HEAT and FAT regions rather than at the catalytic cleft and activates the kinase allosterically [672]; earlier biochemical mapping localised the interaction to the kinase region [364]."];
  "RHEB" -> "PHENO_TH1_TH17" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rheb-mTORC1 is required for Th1 and Th17 differentiation, with Rheb as the upstream element of this arm."];
  "AKT1S1" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, label="Phe129 (TOS motif)", tooltip="PRAS40 TOS motif occupies the Raptor substrate pocket and its N-terminal segment contacts mTOR, blocking S6K1/4E-BP1 access; substoichiometric mTORC1 component."];
  "AKT1S1" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Structural work on the Rheb-bound complex shows PRAS40 occupying the substrate path, lowering mTORC1 output in the basal, growth-factor-deprived state."];
  "AKT1S1" -> "MTORC1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="PRAS40 is a substoichiometric mTORC1 subunit, associating through Raptor rather than contributing structurally to the dimer."];
  "AKT1S1" -> "RPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PRAS40 presents its own TOS motif to the Raptor substrate pocket and competes with S6K1 and 4E-BP1 for access, acting as a direct inhibitor of substrate binding."];
  "CUL1" -> "SCF_BTRC" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Cullin-1 is the scaffold of the SCF(beta-TrCP) ligase."];
  "DEPTOR" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="DEPTOR engages the FAT region of mTOR through its PDZ domain, suppressing kinase output toward substrates of both complexes."];
  "DEPTOR" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="DEPTOR binding restrains mTORC1; its loss raises S6K1 and 4E-BP1 phosphorylation, and its overexpression in myeloma suppresses mTORC1 while relieving feedback onto PI3K-AKT."];
  "DEPTOR" -> "MTORC1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="DEPTOR associates substoichiometrically with mTORC1 as an inhibitory subunit."];
  "DEPTOR" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="DEPTOR is a substoichiometric inhibitory subunit of mTORC2 as well as of mTORC1."];
  "DEPTOR" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="DEPTOR binds mTORC2 and restrains its kinase activity, so DEPTOR loss increases phosphorylation of AKT Ser473 and SGK1. DEPTOR overexpression nevertheless activates AKT indirectly, by suppressing mTORC1 and relieving its feedback inhibition of PI3K."];
  "FBXW11" -> "SCF_BTRC" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="beta-TrCP2 (FBXW11) is redundant with BTRC as the receptor for the DEPTOR phosphodegron."];
  "SCF_BTRC" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser286, Ser287, Ser291", tooltip="mTOR phosphorylates DEPTOR at Ser293 and Ser299 (and Thr295), priming CK1alpha to phosphorylate the Ser286/Ser287/Ser291 degron, which SCF(beta-TrCP) binds, polyubiquitinates and sends for proteasomal degradation. Active mTOR thereby removes its own inhibitor in a positive-feedback loop."];
  "SKP1" -> "SCF_BTRC" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="SKP1 adapts the F-box protein beta-TrCP to the CUL1 scaffold."];
  "ATP_SITE" -> "MTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="The ATP-binding cleft lies in the bilobed kinase domain of mTOR and is identical in mTORC1 and mTORC2, which is why agents that occupy it inhibit both complexes, unlike allosteric agents acting at the FRB domain."];
  "CRIM_DOMAIN" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The mSin1 CRIM domain is a ubiquitin-like fold whose acidic loop binds AGC-kinase substrates at a site distal to the catalytic cleft; the basic surface of the AKT kinase N-lobe engages this loop about 75 Å from the mTOR active site. CRIM-dependent recruitment also applies to SGK and PKC, although di"];
  "CRIM_DOMAIN" -> "MAPKAP1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="The CRIM domain is the central substrate-recruitment module of mSin1."];
  "ETV7" -> "MTOR" [arrowhead=odot, color="#898781", style=dashed, tooltip="ETV7 is reported to interact with mTOR in the cytoplasm and to assemble a putative third complex, mTORC3, that lacks core mTORC1 and mTORC2 subunits and keeps mTOR activity in the presence of rapamycin. Tumour cells that lose this complex become rapamycin-sensitive."];
  "ETV7" -> "MTORC3" [arrowhead=none, color="#898781", style=dashed, arrowhead=none, tooltip="The ETS repressor ETV7 is reported to nucleate the putative third complex and to confer rapamycin insensitivity on it."];
  "ETV7" -> "MTORC3" [arrowhead=none, color="#898781", style=dashed, arrowhead=none, tooltip="ETV7 is reported as the defining subunit of a putative third mTOR assembly, designated mTORC3, which is rapamycin-insensitive and supports proliferation in cancer cells."];
  "FATC_DOMAIN" -> "KINASE_DOMAIN" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The C-terminal FATC motif is integral to the kinase domain and packs against the activation loop and the mLST8-binding element. Deleting the conserved C-terminal residues, or substituting a conserved tryptophan within them, nearly abolishes mTOR kinase activity."];
  "FATC_DOMAIN" -> "MTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Extreme C-terminal FATC domain, the last structural element of mTOR, packing against the catalytic core."];
  "FAT_DOMAIN" -> "KINASE_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The FAT clamp holds the kinase domain in a partially closed, low-activity conformation by distorting the active site; hyperactivating cancer mutations cluster at this FAT-kinase interface and Rheb binding relieves the restraint."];
  "FAT_DOMAIN" -> "MTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="The FAT (FRAP-ATM-TRRAP) alpha-helical domain wraps around the kinase domain and is a defining feature of the PIKK family."];
  "FRB_DOMAIN" -> "KINASE_DOMAIN" [arrowhead=odot, color="#898781", style=solid, tooltip="FRB sits at the entrance of the deep catalytic cleft and acts as a gatekeeper: its rapamycin-binding surface contacts substrates and gives them access to the recessed active site. FKBP12-rapamycin bound at FRB therefore restricts substrate access without occupying the ATP site."];
  "FRB_DOMAIN" -> "MTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="The ~100-residue four-helix FRB bundle lies between the FAT and kinase domains of the mTOR polypeptide and forms the drug-binding surface."];
  "FRB_DOMAIN" -> "MTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="The four-helix FRB domain lies between the FAT and kinase domains, above the substrate cleft, which is why an occupant of this site obstructs substrate entry."];
  "HEAT_REPEATS" -> "MTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="The N-terminal HEAT repeats, arranged as N-HEAT (horn) and M-HEAT (bridge) segments, fold into an elongated alpha-solenoid. The solenoid contributes to the dimer interface and provides the docking surface for Raptor in mTORC1 and Rictor in mTORC2."];
  "KINASE_DOMAIN" -> "MTOR" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="PI3K-like catalytic domain carrying the ATP site in a deeply recessed cleft; it is the catalytic unit shared by mTORC1, mTORC2 and the putative mTORC3."];
  "MAPKAP1" -> "AKT" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="mTORC2 selects AKT by distal docking: the basic surface of the AKT kinase N-lobe engages an acidic loop of the mSin1 CRIM domain and the C-lobe a Rictor–mSin1 mooring ~75 Å from the active site; residues flanking Ser473 are dispensable, and prior engagement of pThr450 by the same N-lobe residues bui"];
  "MAPKAP1" -> "AKT" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="The basic surface of the Akt kinase N-lobe engages an acidic loop of the mSin1 CRIM domain ~75 A from the catalytic site; specificity is structural, not local sequence around Ser473."];
  "MAPKAP1" -> "AKT" [arrowhead=normal, color="#0ca30c", style=dashed, label="mSin1 CRIM domain acidic loop", tooltip="An acidic loop of the mSin1 CRIM domain engages the basic AKT N-lobe surface ~75 Å from the catalytic site, encoding substrate choice by distal docking rather than local sequence."];
  "MAPKAP1" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="mSin1 is a defining mTORC2 subunit; its N-terminal segment binds Rictor and it is required for complex integrity and kinase activity toward Akt."];
  "MAPKAP1" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="mSin1 binds Rictor through its N-terminal segment and maintains Rictor–mTOR complex integrity; its loss abolishes AKT Ser473 phosphorylation."];
  "MAPKAP1" -> "PKC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Sin1-dependent recruitment delivers PKC isoforms to mTORC2; mSin1 interface changes shift the balance of AGC substrates phosphorylated."];
  "MAPKAP1" -> "PKC" [arrowhead=normal, color="#0ca30c", style=dashed, label="mSin1 CRIM domain", tooltip="mSin1 CRIM-dependent recruitment of AGC kinases extends to protein kinase C isoforms; mTORC2 substrate preference among AGC kinases is modulated by subtle Rictor-mSin1 interface changes."];
  "MAPKAP1" -> "RICTOR" [arrowhead=normal, color="#0ca30c", style=solid, label="mSin1 N-terminal Rictor-binding segment", tooltip="The N-terminal region of mSin1 binds Rictor; the interface maintains complex integrity and its subtle variation modulates which AGC kinase is preferred."];
  "MAPKAP1" -> "SGK1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The mSin1 CRIM domain recruits AGC-kinase substrates generally; different AGC kinases are differentially sensitive to perturbation of mSin1."];
  "MAPKAP1" -> "SGK1" [arrowhead=normal, color="#0ca30c", style=solid, label="mSin1 CRIM domain", tooltip="The central CRIM domain of mSin1 recruits AGC-kinase substrates generally, not AKT alone; Sin1-dependent recruitment is required for mTORC2 to phosphorylate SGK1, and different AGC kinases are differentially sensitive to perturbation of mSin1."];
  "MAPKAP1" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mSin1 contributes with Rictor to occlusion of the FRB domain in assembled mTORC2."];
  "MAPKAP1" -> "MTOR" [arrowhead=tee, color="#d03b3b", style=solid, label="mSin1 PH domain", tooltip="In the basal state the mSin1 PH domain folds back onto the mTOR kinase domain and autoinhibits mTORC2. PIP3 binding to the PH domain relieves this autoinhibition and recruits the complex to the plasma membrane."];
  "MLST8" -> "KINASE_DOMAIN" [arrowhead=odot, color="#898781", style=solid, tooltip="mLST8 docks onto the LBE (mLST8-binding element) of the kinase domain, adjacent to the active site, in both mTORC1 and mTORC2."];
  "MLST8" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The mLST8 WD40 beta-propeller docks on the kinase domain near the activation loop and stabilises the catalytic conformation."];
  "MLST8" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mLST8 contacts the kinase domain near the activation loop and stabilises the catalytic conformation."];
  "MLST8" -> "MTORC1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="mLST8 is present at two copies per mTORC1 dimer, its WD40 propeller abutting the kinase domain near the activation loop."];
  "MLST8" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mLST8 deletion phenocopies Rictor rather than Raptor loss: mTORC2 signalling to Akt-FOXO and PKCalpha fails while S6K1 signalling is preserved."];
  "MLST8" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="mLST8 is a stoichiometric mTORC2 subunit contacting the kinase domain; unlike in mTORC1 its loss abolishes complex function."];
  "MLST8" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="WD40 β-propeller abutting the kinase domain near the activation loop"];
  "MTOR" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR self-associates through the N-terminal HEAT repeat region, producing the obligate head-to-head dimer seen in both mTORC1 and mTORC2 cryo-EM reconstructions."];
  "MTOR" -> "MTOR" [arrowhead=odot, color="#898781", style=solid, label="Ser2481", tooltip="mTOR autophosphorylates Ser2481 in the C-terminal region adjacent to FATC; the mark reports intrinsic catalytic activity of assembled mTORC1 and mTORC2 rather than driving it."];
  "MTOR" -> "MTORC1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Two mTOR protomers form the catalytic core of the ~1.1 MDa mTORC1 homodimer, facing one another across a dimer interface with the kinase domains at the obtuse vertices."];
  "MTOR" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="mTOR supplies the catalytic subunit of the ~1.0 MDa mTORC2 homodimer, resolved by cryo-EM at 3.2 A."];
  "MTOR" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Two mTOR protomers form the catalytic core of the ~1.0 MDa mTORC2 homodimer, resolved by cryo-EM at 3.2 Å."];
  "MTOR" -> "MTORC3" [arrowhead=none, color="#898781", style=dashed, arrowhead=none, tooltip="mTOR is reported to form an ETV7-containing assembly lacking Raptor and Rictor that retains activity in the presence of rapamycin."];
  "MTOR" -> "MTORC3" [arrowhead=none, color="#898781", style=dashed, arrowhead=none, tooltip="mTOR is the catalytic subunit of the putative ETV7-containing mTORC3 assembly."];
  "MTOR" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser863", tooltip="mTOR phosphorylates Raptor at Ser863 within the complex, a rapamycin-sensitive intracomplex event that primes further multisite phosphorylation and supports mTORC1 activity."];
  "MTOR" -> "GTF3C" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="mTOR associates with TFIIIC and is detected at tRNA and 5S rRNA genes, positioning it to target the repressor MAF1 at Pol III promoters."];
  "MTOR" -> "POLR1" [arrowhead=odot, color="#898781", style=dashed, tooltip="Chromatin immunoprecipitation detects a nuclear pool of mTOR at rDNA and tRNA gene promoters, in a manner that depends on growth signals and is sensitive to rapamycin. This suggests chromatin-level control of Pol I and Pol III transcription, but a direct contact between mTOR and the polymerase has n"];
  "MTOR" -> "SCN" [arrowhead=odot, color="#898781", style=solid, tooltip="mTOR signalling modulates central clock function in the suprachiasmatic nucleus and shapes the magnitude of photic entrainment, linking the kinase to phase control of behaviour."];
  "MTOR" -> "PHENO_DILATED_CARDIOMYOPATHY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Deletion of mTOR in the adult mouse myocardium causes a fatal dilated cardiomyopathy with cardiomyocyte apoptosis and accumulation of 4E-BP1, marking the lower bound of the cardiac therapeutic window for mTOR inhibition."];
  "MTOR" -> "PHENO_LIFESPAN_EXTENSION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Mice with genetically reduced mTOR expression live longer and show a segmental, tissue-specific slowing of ageing, indicating that the lifespan effect of rapamycin reflects on-target mTOR inhibition rather than an off-target drug action."];
  "MTOR" -> "PHENO_OLIGODENDROCYTE_DIFFERENTIATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR signalling is required for oligodendrocyte differentiation and myelination. Loss of Raptor delays the onset of myelination, reduces sheath thickness and impairs differentiation in a region-dependent manner, most severely in spinal cord, whereas loss of Rictor has modest effects and combined los"];
  "MTOR" -> "PHENO_OSTEOBLAST_DIFFERENTIATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Bone requires mTOR signalling for osteoblast differentiation."];
  "MTOR" -> "PHENO_OSTEOCLAST_DIFFERENTIATION" [arrowhead=odot, color="#898781", style=dotted, tooltip="The role of mTOR in osteoclast differentiation is unsettled: rapamycin suppresses RANKL-driven osteoclastogenesis in culture, whereas deletion of Raptor in osteoclast precursors has been reported to enhance differentiation and low-dose rapamycin can increase bone resorption in vivo. The net skeletal"];
  "MTOR" -> "PHENO_TREG_EXPANSION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Deletion of mTOR in naive T cells favoured Foxp3-positive regulatory differentiation in the tested mouse model."];
  "MTOR" -> "TISSUE_BONE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Bone requires mTOR signalling for both osteoblast and osteoclast differentiation, so the net effect of inhibition is context-dependent and cannot be predicted from cell-autonomous data alone."];
  "MTOR" -> "TISSUE_T_LYMPHOCYTE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="T cell-specific mTOR deletion abrogates Th1, Th2 and Th17 differentiation while promoting Foxp3+ regulatory T cell differentiation."];
  "MTORC1" -> "AKT1S1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser183, Ser212, Ser221", tooltip="mTORC1 phosphorylates its own inhibitor PRAS40 (Ser183, Ser212, Ser221), weakening its binding to Raptor and reinforcing growth-factor-driven derepression."];
  "MTORC1" -> "GRB10" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser501, Ser503", tooltip="mTORC1 phosphorylates and stabilises Grb10, increasing its abundance."];
  "MTORC1" -> "GRB10" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser476, Ser501, Ser503", tooltip="Direct mTORC1 phosphorylation stabilises Grb10 protein; identified by unbiased phosphoproteomics as a core mTORC1 substrate"];
  "MTORC1" -> "GRB10" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1-dependent phosphorylation of Grb10 stabilises the protein against degradation and raises its steady-state level; stabilised Grb10 binds and desensitises the insulin and IGF-1 receptors, forming one of the negative-feedback brakes on upstream signalling."];
  "MTORC1" -> "AMPK" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser345", tooltip="mTORC1 phosphorylates AMPK alpha2 Ser345 (Raptor-dependent) under nutrient stress, suppressing AMPK activity and promoting proliferation: a reciprocal brake opposing AMPK inhibition of mTORC1."];
  "MTORC1" -> "ULK1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser757", tooltip="In nutrient sufficiency mTORC1 phosphorylates ULK1 at Ser757 (mouse numbering; human Ser758), disrupting the ULK1-AMPK interaction and preventing AMPK-mediated activating phosphorylation at Ser317, Ser555 and Ser777; AMPK and mTORC1 therefore toggle autophagy initiation."];
  "MTORC1" -> "ULK1" [arrowhead=tee, color="#d03b3b", style=dotted, label="Ser637", tooltip="ULK1 Ser637 (mouse numbering; human Ser638) is dephosphorylated during nutrient starvation and its phosphorylation falls with mTOR inhibition, but the same site is also assigned to AMPK, so the responsible kinase is unresolved."];
  "MTORC1" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Active mTOR phosphorylates DEPTOR in the linker between its DEP and PDZ domains. This primes the degron for CK1alpha and marks DEPTOR for betaTrCP-dependent degradation, so active mTOR removes its own brake."];
  "MTORC1" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Through 4E-BP phosphorylation and the S6K1-eIF4B/PDCD4/eEF2K axis, mTORC1 stimulates cap-dependent initiation and elongation. The effect is selective rather than global, and the most mTORC1-sensitive mRNAs, mainly TOP and TOP-like transcripts, depend chiefly on the 4E-BPs."];
  "MTORC1" -> "EEF2K" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser78", tooltip="Rapamycin-sensitive phosphorylation of eEF2K at Ser78 (adjacent to the calmodulin-binding site) impairs calmodulin binding and eEF2K activity; direct kinase not definitively identified."];
  "MTORC1" -> "EIF3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Growth factors and nutrients recruit mTOR-Raptor to the eIF3 preinitiation complex, where mTORC1 phosphorylates S6K1 and 4E-BP1 through dynamic protein interchange."];
  "MTORC1" -> "EIF4EBP1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr37, Thr46", tooltip="mTORC1 first phosphorylates priming sites Thr37/Thr46; these are largely rapamycin-resistant, which is the structural reason rapalogs incompletely suppress cap-dependent translation."];
  "MTORC1" -> "EIF4EBP1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser65, Thr70", tooltip="After Thr37/46 priming, mTORC1 phosphorylates Thr70 then Ser65 in a TOS-dependent, rapamycin-sensitive manner, lowering eIF4E affinity by orders of magnitude and releasing eIF4E."];
  "MTORC1" -> "EIF4EBP2" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser65, Thr37, Thr46, Thr70", tooltip="mTORC1 phosphorylates 4E-BP2 at Thr37, Thr46, Ser65 and Thr70, the residues equivalent to the 4E-BP1 sites, in a rapamycin-sensitive manner that releases eIF4E. Loss of both 4E-BP1 and 4E-BP2 makes TOP and TOP-like mRNA translation resistant to mTOR inhibition."];
  "MTORC1" -> "EIF4G1" [arrowhead=odot, color="#898781", style=dashed, label="Ser1108, Ser1148, Ser1192", tooltip="Serum-stimulated, rapamycin-sensitive phosphorylation of the eIF4GI C-terminal region; direct kinase and functional consequence not firmly established."];
  "MTORC1" -> "LARP1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTORC1 phosphorylates a C-terminal cluster of LARP1 sites adjacent to the DM15 region, weakening cap/TOP binding and releasing TOP mRNAs for eIF4F-dependent translation."];
  "MTORC1" -> "MAF1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser60, Ser68, Ser75", tooltip="mTORC1 directly phosphorylates the Pol III repressor MAF1 at Ser60/68/75 in a rapamycin-sensitive manner, inactivating it and derepressing tRNA and 5S rRNA transcription."];
  "MTORC1" -> "RIBOSOME_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 coordinates Pol I (TIF-IA/UBF), Pol III (MAF1) and Pol II/TOP-mRNA (LARP1) outputs so that rRNA, tRNA and ribosomal-protein pools scale together."];
  "MTORC1" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=dotted, label="Ser371", tooltip="mTOR phosphorylates the S6K1 turn motif at Ser371 in vitro. Ser371 phosphorylation is required for Thr389 phosphorylation and for intrinsic kinase activity."];
  "MTORC1" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr389", tooltip="Raptor-TOS-recruited S6K1 is phosphorylated by mTORC1 on hydrophobic-motif Thr389, creating the docking site that permits PDK1 activation-loop phosphorylation."];
  "MTORC1" -> "RPS6KB2" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr388", tooltip="mTORC1 drives rapamycin-sensitive phosphorylation of Thr388 in the S6K2 hydrophobic motif, the equivalent of S6K1 Thr389. A phosphomimetic Thr388Glu substitution makes S6K2 fully active and resistant to rapamycin."];
  "MTORC1" -> "ADIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte Raptor deletion impairs adipogenesis and reduces fat mass with enhanced mitochondrial respiration, placing mTORC1 upstream of the storage programme"];
  "MTORC1" -> "ADIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte Raptor deletion impairs adipogenesis and reduces fat mass with enhanced mitochondrial respiration; the PPARgamma programme is the mTORC1 output of adipose tissue."];
  "MTORC1" -> "AKT" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Through S6K1-IRS-1 and Grb10, active mTORC1 restrains PI3K-AKT; relief of both brakes on mTORC1 inhibition produces rebound AKT activation"];
  "MTORC1" -> "AMBRA1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser52", tooltip="mTORC1 phosphorylates AMBRA1, preventing AMBRA1-TRAF6-mediated ULK1 ubiquitylation, self-association and activation"];
  "MTORC1" -> "ATF4" [arrowhead=tee, color="#d03b3b", style=dotted, tooltip="In proliferating cells with high mTORC1 activity, ATF4 (CREB2) protein has been reported to undergo proteasome-dependent degradation, lowering SIRT4 transcription and thereby relieving SIRT4-mediated inhibition of glutamate dehydrogenase."];
  "MTORC1" -> "ATF4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 raises ATF4 protein by translational control independent of eIF2alpha phosphorylation, balancing amino-acid supply against demand"];
  "MTORC1" -> "ATG13" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTORC1 phosphorylates ATG13 within the ULK1 initiation complex, contributing to layered repression of phagophore initiation"];
  "MTORC1" -> "ATG14" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser223, Ser3, Ser383, Ser440, Thr233", tooltip="mTOR phosphorylates ATG14 at five mapped sites, suppressing the ATG14-containing VPS34 complex; mutation of all five sites reduces this inhibition."];
  "MTORC1" -> "AUTOPHAGIC_LYSOSOME_REFORMATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Amino acids released by completed autolysosomal degradation reactivate mTOR, and this reactivation is required for autophagic lysosome reformation, the tubulation and scission of autolysosomal membranes that regenerates functional lysosomes and terminates the autophagic cycle."];
  "MTORC1" -> "AUTOPHAGY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Through phosphorylation of ULK1 at Ser758 (Ser757 in mouse) and of ATG13, ATG14L and AMBRA1, mTORC1 imposes layered repression of phagophore initiation."];
  "MTORC1" -> "CHOLESTEROL_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR is required for expression of the sterol biosynthetic gene programme through SREBP2"];
  "MTORC1" -> "EP300" [arrowhead=normal, color="#0ca30c", style=dashed, label="Ser2271, Ser2279, Ser2291, Ser2315", tooltip="mTORC1 directly phosphorylates the acetyltransferase p300, increasing its activity toward autophagy and lipogenic substrates"];
  "MTORC1" -> "GLUTAMINE_ANAPLEROSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 represses SIRT4 transcription by promoting proteasomal degradation of CREB2 (ATF4), relieving SIRT4-mediated inhibition of glutamate dehydrogenase and increasing entry of glutamine-derived alpha-ketoglutarate into the TCA cycle."];
  "MTORC1" -> "GLYCOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glycolytic flux rises through cap-dependent translation of HIF-1alpha and consequent induction of GLUT1, HK2, PFKFB3, PKM2 and LDHA"];
  "MTORC1" -> "GLYCOLYSIS" [arrowhead=odot, color="#898781", style=dashed, tooltip="mTOR signalling contributes to metabolic adaptation during T-cell activation; the contribution of this complex depends on lineage and stimulation conditions."];
  "MTORC1" -> "HIF1A" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 raises HIF-1alpha synthesis through 4E-BP1/eIF4E- and S6K1-dependent cap-dependent translation of HIF1A mRNA, including under normoxia in TSC-deficient cells. Separately, a TOR signalling (TOS) motif in HIF-1alpha binds Raptor and is required for full HIF-1alpha transcriptional activity, a pr"];
  "MTORC1" -> "IL1A" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR-dependent translation raises IL-1alpha, which drives NF-kB-dependent amplification of the senescence-associated secretory phenotype"];
  "MTORC1" -> "IL1A" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR promotes IL1A translation, which drives the pro-tumorigenic senescence-associated secretory phenotype; one of the two defined mechanisms behind the mTORC1 requirement for SASP."];
  "MTORC1" -> "IRS1" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser636, Ser639", tooltip="mTORC1 has been reported to phosphorylate IRS-1 directly at Ser636/Ser639, with Raptor acting as a scaffold, in a rapamycin-sensitive manner; phosphorylation of these serines next to the Tyr632 PI3K-binding motif impairs IRS-1-associated PI3K activation and contributes to nutrient-induced insulin re"];
  "MTORC1" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="De novo lipogenesis proceeds through SREBP1, with mTORC1 acting both by phosphorylating Lipin1 and by promoting SREBP processing"];
  "MTORC1" -> "LPIN1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser106, Ser472", tooltip="mTORC1 phosphorylates Lipin1 and retains it in the cytoplasm, preventing its nuclear entry; Lipin1 is a direct mTORC1 substrate"];
  "MTORC1" -> "LYSOSOME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 reactivation during prolonged starvation terminates autophagy and drives autophagic lysosome reformation, regenerating the lysosomal pool"];
  "MTORC1" -> "LYSOSOME_BIOGENESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="By holding TFEB and TFE3 out of the nucleus, mTORC1 suppresses CLEAR-driven expansion of the lysosomal compartment"];
  "MTORC1" -> "MITOCHONDRIAL_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Mitochondrial biogenesis is supported through 4E-BP-dependent translation of mitochondrial mRNAs and the YY1-PGC-1alpha axis"];
  "MTORC1" -> "MYC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 raises c-Myc protein by phosphorylating 4E-BP1 and releasing eIF4E for cap-dependent translation of MYC mRNA, whose structured 5′ untranslated region makes it highly eIF4F-dependent."];
  "MTORC1" -> "PENTOSE_PHOSPHATE_PATHWAY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The oxidative pentose phosphate pathway is activated through SREBP-driven G6PD expression downstream of mTORC1"];
  "MTORC1" -> "PPARG" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Amino-acid-dependent, rapamycin-sensitive mTOR kinase activity is required for the transactivation activity of PPARgamma during adipocyte differentiation; rapamycin disrupts the C/EBPalpha–PPARgamma positive feedback loop, and the PPARgamma ligand troglitazone reverses this block."];
  "MTORC1" -> "PPARG" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 activity increases PPARG mRNA and protein expression during adipocyte differentiation; rapamycin lowers PPARgamma and C/EBPalpha expression and impairs adipogenesis."];
  "MTORC1" -> "PURINE_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Purine synthesis is driven through ATF4-dependent induction of MTHFD2 and control of the mitochondrial tetrahydrofolate cycle"];
  "MTORC1" -> "PYRIMIDINE_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Pyrimidine synthesis is stimulated acutely by the mTORC1-S6K1-CAD Ser1859 axis, coupling growth signalling to nucleotide supply"];
  "MTORC1" -> "RUBCNL" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser157", tooltip="mTORC1 phosphorylates Pacer, blocking its engagement of HOPS and STX17 and thereby autophagosome-lysosome fusion; also couples to lipid metabolism"];
  "MTORC1" -> "SASP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1-driven translation is required for the senescence-associated secretory phenotype; rapamycin suppresses the SASP without eliminating senescent cells"];
  "MTORC1" -> "SASP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1-driven translation is required for the senescence-associated secretory phenotype, through IL1A and MAPKAPK2 translation."];
  "MTORC1" -> "SIRT4" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="mTORC1 represses SIRT4 expression by promoting proteasomal degradation of CREB2, de-repressing glutamate dehydrogenase"];
  "MTORC1" -> "SREBF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 promotes SREBP1 processing and nuclear accumulation, both by phosphorylating Lipin1 and by supporting proteolytic maturation"];
  "MTORC1" -> "SREBF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hepatic mTORC1 promotes SREBP1c processing and activity, driving the lipogenic programme of the liver."];
  "MTORC1" -> "SREBF2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR activity is required for SREBP2-dependent sterol biosynthetic gene expression; part of this transcriptional profile is rapamycin-resistant"];
  "MTORC1" -> "STAT3" [arrowhead=normal, color="#0ca30c", style=dashed, label="Ser727", tooltip="Rapamycin-sensitive, mTOR-dependent phosphorylation of the STAT3 transactivation domain at Ser727 enhances STAT3 transcriptional output"];
  "MTORC1" -> "TFE3" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser321", tooltip="mTORC1 phosphorylates TFE3 at the site equivalent to TFEB Ser211, creating a 14-3-3 site and enforcing cytoplasmic retention"];
  "MTORC1" -> "TFEB" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser142", tooltip="Phosphorylation at Ser142 acts with Ser211 to restrain TFEB nuclear translocation and CLEAR-network output"];
  "MTORC1" -> "TFEB" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser211", tooltip="Phosphorylation at Ser211 creates a 14-3-3 binding site that retains TFEB in the cytoplasm and prevents nuclear import"];
  "MTORC1" -> "TFEB" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser122", tooltip="mTORC1 also phosphorylates TFEB at Ser122; a phosphomimetic Ser122 substitution keeps TFEB cytoplasmic after mTORC1 inhibition even when Ser211 is dephosphorylated, and blocks Torin1-induced lysosomal biogenesis."];
  "MTORC1" -> "UVRAG" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser498", tooltip="mTORC1 phosphorylates UVRAG at Ser498, enhancing RUBCN binding and suppressing UVRAG-dependent autophagosome and endosome maturation"];
  "MTORC1" -> "WIPI2" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser395", tooltip="mTORC1 phosphorylation of WIPI2 promotes its HUWE1-dependent ubiquitination and degradation, limiting recruitment of the ATG16L1 conjugation machinery"];
  "MTORC1" -> "YY1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR associates with YY1 and is required for the YY1-PGC-1alpha interaction at mitochondrial gene promoters; rapamycin disrupts the complex"];
  "MTORC1" -> "BMAL1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="mTOR hyperactivation raises BMAL1 protein abundance by increasing its translation and altering its degradation and nuclear localisation, producing abnormal timekeeping in constant conditions and exaggerated responses to phase resetting; halving Bmal1 gene dosage rescues the circadian behaviour."];
  "MTORC1" -> "PER1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="mTOR inhibition attenuates light-induced PER1 (and PER2) expression in the SCN and blunts photic phase shifts, indicating mTORC1-dependent amplification of the entrainment signal."];
  "MTORC1" -> "PHENO_CIRCADIAN_BEHAVIOUR_ABNORMALITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR hyperactivation in a paradigmatic mTORopathy model produces circadian behavioural abnormalities downstream of aberrant BMAL1 proteostasis."];
  "MTORC1" -> "PHENO_CIRCADIAN_PERIOD" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTOR activity sets free-running period: genetic or pharmacological reduction of mTOR signalling lengthens the period of molecular and behavioural rhythms in SCN explants, peripheral cells and mice"];
  "MTORC1" -> "PHENO_PHOTIC_ENTRAINMENT" [arrowhead=odot, color="#898781", style=solid, tooltip="mTOR signalling in the suprachiasmatic nucleus modulates central clock function and the magnitude of light-induced phase shifts and re-entrainment"];
  "MTORC1" -> "DISEASE_CANCER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The PI3K-AKT-mTOR axis is the most frequently altered growth-promoting pathway in human cancer, with activating lesions in roughly 30-50% of tumours depending on type and sequencing depth."];
  "MTORC1" -> "DISEASE_PKD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Elevated mTORC1 activity contributes to cyst growth in polycystic kidney disease; trials were limited by dose-related toxicity rather than by absence of rationale."];
  "MTORC1" -> "ER_STRESS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic mTORC1 hyperactivation drives beta-cell dedifferentiation and failure through ER stress and suppressed autophagy."];
  "MTORC1" -> "GLUTAMINOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 supports the glutaminolytic reprogramming that accompanies effector T-cell activation, alongside the glycolytic switch, acting through Myc-dependent glutaminase expression and increased glutamine anaplerosis."];
  "MTORC1" -> "INSULIN_SECRETION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic mTORC1 hyperactivation initially expands beta-cell mass and insulin secretion, before dedifferentiation and failure supervene."];
  "MTORC1" -> "KETOGENESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hepatic mTORC1 suppresses fasting-induced ketogenesis by promoting nuclear retention of NCoR1 and thereby inhibiting PPARalpha."];
  "MTORC1" -> "LTP_LATE_PHASE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR-dependent dendritic translation underlies the late protein-synthesis-dependent phase of LTP; rapamycin blocks L-LTP while sparing the early phase."];
  "MTORC1" -> "MAPKAPK2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="mTOR promotes 4E-BP1-dependent translation of MAPKAPK2 (MK2) in senescent cells; MK2 phosphorylates the RNA-binding protein ZFP36L1 and blocks its degradation of SASP transcripts, sustaining the secretory phenotype."];
  "MTORC1" -> "PHENO_ASTROCYTE_PROLIFERATION" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Microglial Tsc1 deletion is accompanied by astrocyte proliferation and severe early-onset spontaneous recurrent seizures, without a pro-inflammatory cytokine signature."];
  "MTORC1" -> "PHENO_BETA_CELL_FAILURE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic mTORC1 hyperactivation initially expands beta-cell mass and secretion but leads to dedifferentiation and failure through ER stress and suppressed autophagy."];
  "MTORC1" -> "PHENO_BETA_CELL_MASS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Beta-cell-specific Raptor deletion impairs beta-cell mass and functional maturation."];
  "MTORC1" -> "PHENO_CARDIAC_HYPERTROPHY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cardiac mTORC1 supports physiological hypertrophy, yet sustained activity contributes to maladaptive remodelling, which partial inhibition attenuates in multiple models."];
  "MTORC1" -> "PHENO_FAT_MASS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte Raptor-null mice are lean with enhanced mitochondrial respiration, so adipose mTORC1 supports fat accumulation."];
  "MTORC1" -> "PHENO_FOOD_INTAKE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Intracerebroventricular leucine raises hypothalamic S6K1 phosphorylation and suppresses food intake and body weight; rapamycin abolishes the effect."];
  "MTORC1" -> "PHENO_HEPATIC_STEATOSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SREBP1c-dependent lipogenesis driven by hepatic mTORC1 contributes to steatosis when insulin is chronically elevated."];
  "MTORC1" -> "PHENO_INSULIN_RESISTANCE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic mTORC1 activation in obesity drives insulin resistance through S6K1-IRS-1 feedback and through lipotoxicity from constrained adipose storage capacity."];
  "MTORC1" -> "PHENO_LIFESPAN_EXTENSION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Reduced TOR signalling extends lifespan in Saccharomyces cerevisiae, Caenorhabditis elegans and Drosophila melanogaster, so TOR activity limits lifespan."];
  "MTORC1" -> "PHENO_MALADAPTIVE_REMODELLING" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Sustained mTORC1 activity contributes to maladaptive cardiac remodelling, in contrast to the physiological hypertrophy the same complex supports, and partial inhibition attenuates pathological hypertrophy in several models."];
  "MTORC1" -> "PHENO_MICROGLIAL_ACTIVATION" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Microglial Tsc1 loss produces an amoeboid, highly proliferative and phagocytic phenotype without a pro-inflammatory cytokine signature, with reduced synapse density."];
  "MTORC1" -> "PHENO_MUSCLE_DYSTROPHY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Muscle-specific Raptor deletion produces progressive dystrophy, impaired oxidative capacity and shortened lifespan, so intact mTORC1 restrains the dystrophic phenotype; muscle-specific Rictor deletion is close to phenotypically silent."];
  "MTORC1" -> "PHENO_MUSCLE_HYPERTROPHY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 activity is required for load-induced hypertrophy: rapamycin blocks the hypertrophic response to IGF-1, mechanical overload and chronic stimulation. Sustained mTORC1 activation is not by itself sufficient, since constitutive activation by Tsc1 deletion in muscle fails to produce hypertrophy a"];
  "MTORC1" -> "PHENO_MYELINATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Oligodendrocyte-lineage Raptor loss delays myelination onset and produces persistent hypomyelination with reduced sheath thickness, regionally worse in spinal cord."];
  "MTORC1" -> "PHENO_PROTEINURIA" [arrowhead=odot, color="#898781", style=solid, tooltip="Podocytes require a calibrated level of mTORC1 activity: Raptor deletion in podocytes causes injury and proteinuria, while podocyte Tsc1 deletion causes proteinuric glomerulosclerosis, so both insufficient and excessive activity damage the filtration barrier."];
  "MTORC1" -> "PHENO_SPINE_DENSITY" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Microglia-restricted Tsc1 deletion reduces synapse density alongside an amoeboid, highly proliferative and phagocytic microglial phenotype; the effect of pathway hyperactivation on synapses is therefore not cell-autonomous to neurons."];
  "MTORC1" -> "PHENO_TH1_TH17" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rheb-mTORC1 is required for Th1 and Th17 differentiation; T cell-specific mTOR deletion abrogates Th1, Th2 and Th17 differentiation altogether."];
  "MTORC1" -> "PHENO_TREG_EXPANSION" [arrowhead=odot, color="#898781", style=solid, tooltip="In naive mouse CD4 cells without exogenous TGF-beta, combined inhibition of mTORC1 and mTORC2 promotes Foxp3 induction while inhibition of either complex alone is insufficient; established regulatory T cells conversely require mTORC1 for their metabolic programme and suppressive function."];
  "MTORC1" -> "TISSUE_ADIPOSE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte-specific Raptor deletion impairs adipogenesis and reduces fat mass with enhanced mitochondrial respiration"];
  "MTORC1" -> "TISSUE_BETA_CELL" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Beta-cell-specific Raptor deletion impairs beta-cell mass, functional maturation and insulin processing."];
  "MTORC1" -> "TISSUE_CNS_NEURON" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTOR-dependent dendritic translation underlies the late, protein-synthesis-dependent phase of LTP"];
  "MTORC1" -> "TISSUE_HAEMATOPOIETIC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Proliferating haematopoietic progenitors require mTORC1, which accounts for the cytopenias seen during rapalog therapy. Restraint of mTORC1 by the TSC complex is conversely required to keep haematopoietic stem cells quiescent: Tsc1 deletion drives stem cells out of quiescence, increases mitochondria"];
  "MTORC1" -> "TISSUE_HEART" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cardiac mTORC1 supports physiological hypertrophy; only the mTORC2 arm of the cardiomyocyte row was encoded."];
  "MTORC1" -> "TISSUE_HYPOTHALAMUS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="In the arcuate nucleus mTORC1 operates as a nutrient sensor, which makes the hyperphagia of Smith-Kingsmore syndrome mechanistically expected rather than incidental."];
  "MTORC1" -> "TISSUE_KIDNEY_PODOCYTE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Podocyte Raptor deletion produces injury and proteinuria while Tsc1 deletion causes glomerulosclerosis: a calibrated rather than monotonic requirement."];
  "MTORC1" -> "TISSUE_LIVER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hepatic mTORC1 drives insulin-stimulated SREBP1c-dependent lipogenesis and restrains fasting ketogenesis."];
  "MTORC1" -> "TISSUE_MICROGLIA" [arrowhead=odot, color="#898781", style=dashed, tooltip="Pathway hyperactivation in the microglial compartment drives astrocyte proliferation and seizures, a non-neuronal contribution to the mTORopathies."];
  "MTORC1" -> "TISSUE_OLIGODENDROCYTE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Oligodendrocyte-lineage Raptor loss delays onset of myelination and produces persistent hypomyelination with reduced sheath thickness, whereas Rictor loss has modest and largely transient effects; the requirement is regional, with spinal cord affected more than corpus callosum."];
  "MTORC1" -> "TISSUE_ORAL_EPITHELIUM" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rapidly renewing oral epithelium depends on mTORC1, which is why stomatitis affects roughly 30-60% of treated patients depending on indication and is substantially preventable with topical dexamethasone or tacrolimus prophylaxis."];
  "MTORC1" -> "TISSUE_SKELETAL_MUSCLE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Muscle-specific Raptor deletion produces progressive dystrophy, impaired oxidative capacity and shortened lifespan, establishing mTORC1 as the dominant complex in muscle."];
  "MTORC1" -> "TISSUE_T_LYMPHOCYTE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Both complexes are required for the glycolytic and glutaminolytic reprogramming of effector T cell activation, so partial inhibition is the pharmacological objective."];
  "MTORC2" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser473", tooltip="mTORC2 phosphorylates the hydrophobic motif Ser473; AKT docks on the mSin1 CRIM domain ~75 Å from the active site. Ser473 selectively enhances activity toward FOXO1/3 and BAD over GSK3β/TSC2."];
  "MTORC2" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr450", tooltip="Cotranslational, constitutive turn-motif phosphorylation at Thr450 by ribosome-associated mTORC2 is required for AKT folding and stability."];
  "MTORC2" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr450", tooltip="Ribosome-associated mTORC2 phosphorylates the turn motif of nascent AKT cotranslationally, which is required for folding and stability of the newly synthesised polypeptide."];
  "MTORC2" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser473", tooltip="mTORC2 is the hydrophobic-motif kinase for Akt: phosphorylation of Ser473 completes activation-loop-dependent activation and sets Akt substrate selectivity (notably toward FOXO)."];
  "MTORC2" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr450", tooltip="Turn-motif phosphorylation at Thr450 is constitutive and occurs cotranslationally on ribosome-associated mTORC2; it is required for folding and stability of nascent AKT."];
  "MTORC2" -> "AKT" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser473", tooltip="mTORC2 is the hydrophobic-motif (PDK2) kinase for AKT; with PDK1-mediated Thr308 it gives full AKT activity."];
  "MTORC2" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="DEPTOR is phosphorylated by mTORC2 as well as mTORC1, which likewise promotes its degradation and relieves inhibition of the complex."];
  "MTORC2" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Active mTOR phosphorylates its own inhibitory subunit DEPTOR, marking it for degradation — a self-amplifying loop in which active mTOR removes its own brake."];
  "MTORC2" -> "PKC" [arrowhead=normal, color="#0ca30c", style=solid, label="TOR-interaction motif (isoform-dependent), turn motif", tooltip="mTORC2 supports PKC maturation by priming selected isoforms; subsequent hydrophobic-motif phosphorylation can be autophosphorylation."];
  "MTORC2" -> "PKC" [arrowhead=normal, color="#0ca30c", style=solid, label="TOR-interaction motif (isoform-dependent), turn motif", tooltip="mTORC2 primes selected PKC isoforms for maturation; PDK1 phosphorylation and hydrophobic-motif autophosphorylation follow."];
  "MTORC2" -> "ACTIN_CYTOSKELETON" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Control of the actin cytoskeleton was the founding mTORC2 phenotype, defined by the rapamycin-insensitive, raptor-independent Rictor–mTOR complex."];
  "MTORC2" -> "BAD" [arrowhead=tee, color="#d03b3b", style=dashed, label="via AKT Ser473", tooltip="Ser473 phosphorylation markedly enhances AKT activity toward BAD, biasing mTORC2 output toward survival signalling."];
  "MTORC2" -> "CDKN1B" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss of mTORC2 in beta-cells lowers AKT Ser473 phosphorylation and permits nuclear FOXO1 accumulation, with a consequent rise in p27 protein and reduced beta-cell mass; the step is indirect and was scored at the protein level."];
  "MTORC2" -> "CDKN1B" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Beta-cell Rictor deletion elevates p27, contributing to the imbalance between beta-cell proliferation and cell size."];
  "MTORC2" -> "CELL_SURVIVAL" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="By supplying Ser473, mTORC2 biases AKT output toward survival and transcriptional programmes (FOXO, BAD) rather than toward its metabolic substrates."];
  "MTORC2" -> "FOXO1" [arrowhead=tee, color="#d03b3b", style=solid, label="via AKT Ser473", tooltip="Ser473 phosphorylation is substrate-selective rather than globally activating: AKT phosphorylated only at Thr308 retains substantial activity toward GSK3-beta and TSC2, whereas Ser473 markedly enhances activity toward FOXO1. mTORC2 therefore specifically suppresses FOXO1."];
  "MTORC2" -> "FOXO1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Beta-cell Rictor deletion reduces AKT Ser473 phosphorylation and produces nuclear FOXO1 accumulation."];
  "MTORC2" -> "FOXO3" [arrowhead=tee, color="#d03b3b", style=solid, label="via AKT Ser473", tooltip="Ser473 phosphorylation markedly enhances AKT activity toward FOXO3a, so mTORC2 loss de-represses FOXO3a-dependent transcription."];
  "MTORC2" -> "GCK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hepatic mTORC2 supports glycolysis through AKT-dependent glucokinase expression."];
  "MTORC2" -> "GLUCONEOGENESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hepatic mTORC2, acting through AKT-mediated FOXO1 suppression, restrains gluconeogenesis; liver-specific Rictor deletion produces glucose intolerance."];
  "MTORC2" -> "GLUCONEOGENESIS" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser473", tooltip="Hepatic mTORC2 acts through AKT-mediated FOXO1 suppression to restrain gluconeogenesis; the complexes therefore act in opposite directions on hepatic glucose output."];
  "MTORC2" -> "GLUCOSE_UPTAKE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte Rictor deletion reduces insulin-stimulated glucose uptake; mTORC2 output through AKT is the limiting arm."];
  "MTORC2" -> "GLUCOSE_UPTAKE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte Rictor deletion reduces insulin-stimulated glucose uptake while altering lipid handling and body growth."];
  "MTORC2" -> "IGF1R" [arrowhead=normal, color="#0ca30c", style=dashed, label="receptor tyrosine residues", tooltip="The intrinsic tyrosine kinase activity of mTOR within mTORC2 has been reported to phosphorylate and activate the type I IGF receptor and the insulin receptor, constituting a feed-forward arm from mTORC2 back onto the receptor tier that would amplify PI3K-PIP3 input to mTORC2 itself."];
  "MTORC2" -> "INSULIN_SECRETION" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Insulin secretion and beta-cell survival depend on mTORC2 in the islet, so both complexes are required there, unlike the opposing arrangement in liver and adipose tissue; reduced insulin output contributes to the dysglycaemia seen at immunosuppressive exposures of mTOR inhibitors."];
  "MTORC2" -> "LIPOLYSIS" [arrowhead=odot, color="#898781", style=solid, tooltip="Lipolysis and insulin-stimulated glucose uptake are the adipose outputs that depend on mTORC2; adipocyte Rictor deletion alters lipid handling, and pharmacological inhibition is expected to produce altered lipid handling and hypertriglyceridaemia."];
  "MTORC2" -> "LTP_LATE_PHASE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Forebrain Rictor deletion selectively impairs L-LTP while leaving early-phase LTP intact; mTORC1 supports the translational component, mTORC2 the structural one."];
  "MTORC2" -> "LTP_LATE_PHASE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Forebrain Rictor deletion selectively impairs L-LTP while sparing early-phase LTP; the mechanism is Tiam1-Rac1-dependent actin polymerisation, not translational control."];
  "MTORC2" -> "MAM_ER_MITOCHONDRIA" [arrowhead=odot, color="#898781", style=dashed, tooltip="A distinct mTORC2–AKT pool resides at ER–mitochondria contact sites and controls MAM integrity, Ca2+ transfer and mitochondrial physiology."];
  "MTORC2" -> "MLXIPL" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipose mTORC2 drives ChREBP-dependent de novo lipogenesis, with consequences for hepatic glucose metabolism."];
  "MTORC2" -> "MLXIPL" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipose-tissue mTORC2 regulates ChREBP-driven de novo lipogenesis, with consequences for hepatic glucose metabolism."];
  "MTORC2" -> "MTOR" [arrowhead=odot, color="#898781", style=solid, label="Ser2481", tooltip="mTOR autophosphorylates at Ser2481 within the assembled complex; in mTORC2 this autophosphorylation is a complex-specific readout of intrinsic catalytic activity and is rapamycin-insensitive under acute treatment, unlike the mTORC1-associated pool."];
  "MTORC2" -> "MYELINATION" [arrowhead=odot, color="#898781", style=solid, tooltip="Oligodendrocyte-lineage Rictor deletion has modest and largely transient effects on myelination, whereas Raptor loss causes persistent hypomyelination; only the raptor/rictor double mutant impairs oligodendrocyte differentiation itself, indicating that mTORC2 contributes but is not rate-limiting whi"];
  "MTORC2" -> "PHENO_AGE_MEMORY_IMPAIRMENT" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="A small molecule that raises mTORC2 activity reverses age-associated long-term memory impairment in aged mice and flies, and enhancing mTORC2-dependent actin polymerisation likewise improves long-term memory."];
  "MTORC2" -> "PHENO_BODY_GROWTH" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTORC2 in adipose tissue negatively controls whole-body growth, so adipocyte Rictor deletion increases body size - a direction of effect opposite to the usual anabolic framing of the pathway."];
  "MTORC2" -> "PHENO_BODY_GROWTH" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Adipose-specific Rictor deletion increases whole-body growth, so adipose mTORC2 negatively controls somatic growth."];
  "MTORC2" -> "PHENO_GLUCOSE_INTOLERANCE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss of mTORC2 removes AKT-dependent FOXO1 suppression and insulin-stimulated glucose uptake, producing glucose intolerance and peripheral insulin resistance."];
  "MTORC2" -> "PHENO_GLUCOSE_INTOLERANCE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss of hepatic mTORC2 disinhibits gluconeogenesis and reduces glucokinase-dependent glycolysis, producing glucose intolerance; this is the chief source of rapalog dysglycaemia."];
  "MTORC2" -> "PHENO_HYPOTENSION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Renal mTORC2 loss causes salt wasting and hypotension through failure of SGK1-dependent activation of ENaC, the Na+/K+-ATPase and CLC-K in the distal nephron."];
  "MTORC2" -> "PHENO_INSULIN_RESISTANCE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Chronic mTORC2 loss produces peripheral insulin resistance, which is distinct from direct beta-cell toxicity; the two together account for new-onset diabetes after transplantation at immunosuppressive exposures."];
  "MTORC2" -> "PHENO_INSULIN_RESISTANCE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Chronic mTORC2 loss produces peripheral insulin resistance, the second mechanistic arm of rapalog-associated diabetes alongside direct beta-cell toxicity."];
  "MTORC2" -> "PHENO_LONG_TERM_MEMORY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Conditional Rictor deletion in the postnatal murine forebrain selectively impairs long-term memory while sparing short-term memory; conversely, a compound that raises mTORC2 activity converts early-phase into late-phase potentiation, enhances long-term memory in wild-type animals and reverses age-as"];
  "MTORC2" -> "PHENO_SALT_WASTING" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Renal mTORC2 loss abolishes SGK1-dependent ENaC and Na+/K+-ATPase regulation, causing salt wasting and hypotension."];
  "MTORC2" -> "PHENO_SALT_WASTING" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="mTORC2 phosphorylates SGK1 at Ser422, which controls ENaC, the Na+/K+-ATPase, CLC-K and NDRG1; renal mTORC2 loss causes salt wasting and hypotension."];
  "MTORC2" -> "PHENO_SPINE_DENSITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Spine density falls when forebrain mTORC2 activity and Tiam1–Rac1-dependent actin polymerisation are reduced."];
  "MTORC2" -> "PHENO_SPINE_DENSITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Spine density falls when forebrain mTORC2 activity is reduced, consistent with an actin-dependent structural mechanism."];
  "MTORC2" -> "PLASMA_MEMBRANE" [arrowhead=odot, color="#898781", style=solid, tooltip="A PIP3-gated pool of mTORC2 operates at the plasma membrane, where AKT is recruited by the same lipid."];
  "MTORC2" -> "PRKCA" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr638 (turn motif)", tooltip="mTORC2-dependent priming supports maturation of this PKC isoform. Hydrophobic-motif phosphorylation is not assigned as a direct mTORC2 reaction."];
  "MTORC2" -> "PRKCB" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr641 (turn motif)", tooltip="mTORC2-dependent priming supports maturation of this PKC isoform. Hydrophobic-motif phosphorylation is not assigned as a direct mTORC2 reaction."];
  "MTORC2" -> "PRKCD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC2 phosphorylates the turn and hydrophobic motifs of the novel isoform PKCδ, supporting its stability and migration signalling."];
  "MTORC2" -> "PRKCE" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="PKCε is among the novel PKC isoforms whose mTORC2-dependent priming-site phosphorylation is required for maturation and stability."];
  "MTORC2" -> "PRKCZ" [arrowhead=normal, color="#0ca30c", style=solid, label="turn motif", tooltip="mTORC2 phosphorylates the turn motif of the atypical isoform PKCζ, regulating its stability and activity."];
  "MTORC2" -> "SGK1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser422", tooltip="mTORC2 phosphorylates the SGK1 hydrophobic motif, which is required for SGK1 activity."];
  "MTORC2" -> "SREBF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hepatic mTORC2 supports lipogenesis through SREBP1c and glycolysis through glucokinase; the effect on SREBP1c is relayed by AKT and no direct action of the complex on the transcription factor has been shown."];
  "MTORC2" -> "SREBF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hepatic mTORC2 phosphorylates AKT at Ser473, and AKT-dependent glucokinase induction and SREBP1c processing drive lipogenesis; SREBP1 is therefore an indirect output of this complex, and the same transcription factor is driven by both complexes in liver."];
  "MTORC2" -> "TH2_DIFFERENTIATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rictor-mTORC2 is required for Th2 differentiation, whereas Rheb-mTORC1 is required for Th1 and Th17; both complexes are additionally required for the glycolytic and glutaminolytic reprogramming of effector activation."];
  "MTORC2" -> "TIAM1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Conditional Rictor deletion in the postnatal forebrain lowers Tiam1 levels and Tiam1-dependent Rac1 activation; the step between the complex and Tiam1 is undefined."];
  "MTORC2" -> "TIAM1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Forebrain mTORC2 promotes Rac1 activation through Tiam1 and the resulting actin polymerisation in dendritic spines, rather than acting through translational control; conditional Rictor deletion in postnatal forebrain selectively impairs late-phase LTP and long-term memory while sparing early-phase L"];
  "MTORC2" -> "TISSUE_ADIPOSE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte Rictor deletion reduces insulin-stimulated glucose uptake, alters lipid handling and negatively controls whole-body growth."];
  "MTORC2" -> "TISSUE_ADIPOSE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Adipocyte Rictor deletion alters lipid handling and whole-body growth; as in liver the complexes diverge, so net metabolic effect depends on drug selectivity and exposure."];
  "MTORC2" -> "TISSUE_BETA_CELL" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="β-cell Rictor deletion causes mild hyperglycaemia with reduced β-cell mass, decreased AKT Ser473 phosphorylation, nuclear FOXO1 accumulation and elevated p27."];
  "MTORC2" -> "TISSUE_CNS_NEURON" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Conditional deletion of Rictor in the postnatal murine forebrain reduces mTORC2 activity and selectively impairs late-phase long-term potentiation and long-term memory while sparing early-phase potentiation and short-term memory; the mechanism is Tiam1–Rac1-dependent actin polymerisation with reduce"];
  "MTORC2" -> "TISSUE_HEART" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cardiomyocyte mTORC2 limits apoptosis and tissue loss after ischaemic injury through AKT-dependent anti-apoptotic signalling, complementing the mTORC1 contribution to physiological growth, so agents that ablate both complexes are predicted to be more cardiotoxic than mTORC1-selective ones."];
  "MTORC2" -> "TISSUE_KIDNEY_TUBULE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC2-dependent SGK1 activity governs ion handling in the distal nephron and therefore sodium balance and blood pressure; renal mTORC2 loss causes salt wasting and hypotension."];
  "MTORC2" -> "TISSUE_LIVER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hepatic mTORC2 restrains gluconeogenesis and supports glycolysis and lipogenesis; liver-specific Rictor deletion gives a type-2-diabetes-like phenotype."];
  "MTORC2" -> "TISSUE_LIVER" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Liver-specific Rictor deletion produces glucose intolerance and a phenotype reminiscent of type 2 diabetes, so hepatic mTORC2 is required for normal glucose handling."];
  "MTORC2" -> "TISSUE_OLIGODENDROCYTE" [arrowhead=odot, color="#898781", style=solid, tooltip="mTORC2 contributes to oligodendrocyte differentiation but is not rate-limiting while mTORC1 is intact; the deficit becomes apparent only in the raptor/rictor double mutant."];
  "MTORC2" -> "TISSUE_OLIGODENDROCYTE" [arrowhead=odot, color="#898781", style=solid, tooltip="Rictor loss has modest, largely transient effects; only the double mutant impairs differentiation, so mTORC2 contributes but is not rate-limiting while mTORC1 is intact."];
  "MTORC2" -> "TISSUE_SKELETAL_MUSCLE" [arrowhead=odot, color="#898781", style=solid, tooltip="Muscle-specific Rictor deletion is close to phenotypically silent, in contrast to Raptor deletion, which causes dystrophy; the residual mTORC2 contribution is limited to loss of AKT Ser473 phosphorylation and a modest fall in insulin-stimulated glucose uptake."];
  "MTORC2" -> "TISSUE_T_LYMPHOCYTE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC2 supports Th2 effector differentiation and AKT-dependent survival in T lymphocytes; with mTORC1 it governs the metabolic reprogramming of effector activation and restrains Treg commitment."];
  "MTORC2" -> "TREG_DIFFERENTIATION" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Loss of total mTOR kinase activity abrogates Th1, Th2 and Th17 differentiation and favours Foxp3 induction, which underlies the preferential expansion of regulatory T cells under rapamycin; restraint of regulatory T cell differentiation is best documented for the AKT–mTORC1 arm, while deletion of Ri"];
  "MTORC2" -> "GLYCOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hepatic mTORC2 supports glycolysis via AKT and glucokinase; loss produces a phenotype reminiscent of type 2 diabetes."];
  "MTORC2" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Liver-specific Rictor deletion reduces glycolysis and lipogenesis; hepatic mTORC2 activates both through AKT, glucokinase and SREBP1c."];
  "MTORC2" -> "PHENO_BETA_CELL_MASS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Beta-cell Rictor deletion causes mild hyperglycaemia with reduced beta-cell mass, decreased AKT Ser473 phosphorylation, nuclear FOXO1 accumulation and elevated p27."];
  "MTORC2" -> "PHENO_CARDIOPROTECTION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cardiomyocyte mTORC2 is cytoprotective in myocardial ischaemia through AKT-dependent anti-apoptotic signalling: loss of Rictor increases cardiomyocyte apoptosis and infarct damage, whereas shifting signalling from mTORC1 towards mTORC2 reduces it."];
  "MTORC2" -> "PHENO_HYPERGLYCAEMIA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Beta-cell Rictor deletion causes mild hyperglycaemia, so intact beta-cell mTORC2 restrains it"];
  "MTORC2" -> "PHENO_TREG_EXPANSION" [arrowhead=odot, color="#898781", style=dashed, tooltip="Loss of both mTOR complexes in CD4 T cells favours Foxp3+ regulatory T cell differentiation; an independent contribution of mTORC2 to this restraint, acting through AKT, is supported but less consistently than the mTORC1 arm."];
  "MTORC2" -> "PHENO_T_CELL_SURVIVAL" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC2 phosphorylates AKT at Ser473 in activated T lymphocytes, supporting AKT-dependent survival signalling alongside Th2 differentiation."];
  "PH_DOMAIN" -> "KINASE_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="In the basal state the mSin1 PH domain folds back onto the mTOR kinase domain and suppresses catalysis; this is the autoinhibited resting conformation of mTORC2."];
  "PH_DOMAIN" -> "MAPKAP1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="C-terminal PH domain of mSin1, the PIP3-binding and autoinhibitory element."];
  "PRR5" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Protor-1 joins mTORC2 substoichiometrically through Rictor; it is accessory rather than required for assembly."];
  "PRR5" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Protor-1 binds Rictor as a substoichiometric accessory subunit of mTORC2."];
  "PRR5" -> "RICTOR" [arrowhead=odot, color="#898781", style=solid, tooltip="Protor-1 was identified as a Rictor-binding protein and enters mTORC2 through that contact rather than through mTOR."];
  "PRR5" -> "SGK1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Protor-1 knockout mice show reduced mTORC2-dependent SGK1 activation and NDRG1 phosphorylation in kidney, with AKT signalling preserved."];
  "PRR5" -> "SGK1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Protor-1 is required for efficient mTORC2-mediated SGK1 activation, an effect most evident in kidney."];
  "PRR5L" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Protor-2, the PRR5 paralogue, associates substoichiometrically with mTORC2 via Rictor."];
  "PRR5L" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Protor-2 binds Rictor as a substoichiometric accessory subunit of mTORC2."];
  "PRR5L" -> "RICTOR" [arrowhead=odot, color="#898781", style=solid, tooltip="Protor-2 (PRR5L), the paralogue of Protor-1, binds Rictor and thereby associates with mTORC2 without being required for complex integrity or kinase activity; a binding site shared with Protor-1 and strictly exclusive binding of the two paralogues have not been mapped."];
  "PRR5L" -> "PRKCD" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Protor-2 acts within mTORC2 to restrain phosphorylation of PKC-delta by the complex; its degradation downstream of G-alpha-12 permits PKC-delta phosphorylation and promotes cell migration, with no evidence of direct binding to the kinase."];
  "RAIP_MOTIF" -> "EIF4EBP1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="4E-BP1 contains an N-terminal RAIP motif (Arg-Ala-Ile-Pro) that, together with the C-terminal TOS motif, is required for efficient mTORC1-dependent multisite phosphorylation; NMR places its contact on Raptor at a site separate from the TOS pocket."];
  "RAIP_MOTIF" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=dotted, tooltip="NMR shows that the N-terminal RAIP motif of 4E-BP1 binds Raptor at a site separate from the TOS-binding pocket, so that the two motifs tether 4E-BP1 by avidity and orient its phosphoacceptor region toward the kinase site; mutation of either motif abolishes Raptor co-immunoprecipitation of 4E-BP1."];
  "RBD_DOMAIN" -> "MAPKAP1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="mSin1 contains a Raf-like, atypical Ras-binding domain between its CRIM and PH domains that binds GTP-loaded H-Ras and K-Ras."];
  "RICTOR" -> "AKT" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="The Akt kinase C-lobe engages an N-terminal mooring formed jointly by mSin1 and Rictor, completing the distal docking surface that selects the substrate."];
  "RICTOR" -> "AKT" [arrowhead=normal, color="#0ca30c", style=dashed, label="N-terminal mooring (mSin1/Rictor)", tooltip="The AKT C-lobe engages an N-terminal mooring formed jointly by mSin1 and Rictor, completing the bipartite docking that positions Ser473 at the active site."];
  "RICTOR" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="In the assembled mTORC2 cryo-EM structures Rictor packs against the FRB bundle, sterically denying access to the FKBP12-rapamycin complex."];
  "RICTOR" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rictor packs against the FRB domain, occluding the FKBP12–rapamycin binding surface; this is the structural basis for rapamycin insensitivity of preassembled mTORC2."];
  "RICTOR" -> "FRB_DOMAIN" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Cryo-EM shows Rictor, together with mSin1, covering the FRB surface of mTOR within mTORC2, which is the structural basis for the rapamycin insensitivity of preassembled mTORC2."];
  "RICTOR" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rictor binds the mTOR N-HEAT solenoid and is required for mTORC2 assembly and integrity; with mSin1 it occludes the FRB domain and forms the N-terminal mooring that docks the AKT C-lobe, whereas the mSin1 CRIM domain provides the principal substrate-docking surface."];
  "RICTOR" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Rictor is the defining stoichiometric subunit of mTORC2, binding the mTOR solenoid and bridging to mSin1."];
  "RICTOR" -> "MTORC2" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Rictor is the defining subunit that distinguishes mTORC2 from mTORC1 and is raptor-independent."];
  "RICTOR" -> "RPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Rictor, with mSin1, occupies a surface on the mTOR N-HEAT solenoid that overlaps the Raptor footprint, so Raptor and Rictor binding to mTOR are mutually exclusive and the two complexes partition a common mTOR pool."];
  "RPTOR" -> "AKT1S1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PRAS40 carries a bona fide TOS motif read by the same Raptor pocket as substrate TOS motifs, which is why it behaves as a competitive rather than allosteric inhibitor."];
  "RPTOR" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Raptor binds the C-terminal TOS motif of 4E-BP1 and, according to NMR data, the N-terminal RAIP motif at a separate site, tethering 4E-BP1 so that its phosphoacceptor region is presented to the mTOR active site."];
  "RPTOR" -> "HIF1A" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha carries a TOS motif recognised by Raptor, coupling mTORC1 directly to hypoxia-responsive transcription."];
  "RPTOR" -> "HIF1A" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha carries a TOS motif recognised by the Raptor substrate pocket, the same surface that reads the S6K1, 4E-BP1 and PRAS40 motifs; Raptor binding through this motif is required for mTORC1-dependent HIF-1alpha activity."];
  "RPTOR" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Raptor wraps the N-HEAT solenoid and projects a substrate-recognition surface outward; because the mTOR cleft is deep and partially occluded, recruitment by Raptor is obligatory, not incidental."];
  "RPTOR" -> "MTORC1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Raptor is the defining stoichiometric subunit of mTORC1, two copies per dimer, wrapped around the N-HEAT solenoid of each mTOR protomer."];
  "RPTOR" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Raptor recognises the S6K1 TOR signalling motif, consensus Phe-Asp/Glu-Phi-Asp/Glu-Phi, and this binding is required for mTORC1 to phosphorylate the kinase."];
  "RPTOR" -> "ULK1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Raptor binds ULK1 in a nutrient-dependent manner, incorporating mTORC1 into the ULK1-ATG13-FIP200 complex and presenting ULK1 for inhibitory phosphorylation at Ser758 (Ser757 in mouse)."];
  "RPTOR" -> "ULK1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Raptor mediates the nutrient-dependent association of mTORC1 with the ULK1-ATG13-FIP200 complex, presenting ULK1 for inhibitory phosphorylation at Ser758 (Ser757 in mouse), which prevents its activation by AMPK; the net effect of the interaction on ULK1 is inhibitory."];
  "RPTOR" -> "LARP1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="LARP1 co-purifies with Raptor/mTORC1; the interaction positions LARP1 for mTORC1-dependent phosphorylation and is sensitive to mTORC1 activity."];
  "TOS_MOTIF" -> "AKT1S1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="PRAS40 carries its own TOS motif (FVMDE, Phe129), which is required for Raptor binding and lets PRAS40 occupy the Raptor substrate-docking site in competition with S6K1 and 4E-BP1. PRAS40 is also itself an mTORC1 substrate at Ser183."];
  "TOS_MOTIF" -> "EIF4EBP1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="4E-BP1 carries a C-terminal TOS motif (FEMDI) required for Raptor binding and for efficient multisite phosphorylation by mTORC1."];
  "TOS_MOTIF" -> "HIF1A" [arrowhead=none, color="#898781", style=dashed, arrowhead=none, tooltip="HIF-1alpha is reported to carry an N-terminal TOS motif (Phe99) through which it binds Raptor. Mutating this motif impairs hypoxic HIF activity and p300/CBP binding."];
  "TOS_MOTIF" -> "RPS6KB1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="S6K1 carries an N-terminal TOS motif (FDIDL) that is necessary for Raptor binding and for Thr389 phosphorylation."];
  "TOS_MOTIF" -> "RPTOR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Raptor recognises the five-residue TOS motif of its clients; point mutation of the motif's phenylalanine abolishes binding to Raptor and mTORC1-dependent phosphorylation, which is the molecular basis of substrate selection by mTORC1."];
  "MCOLN1" -> "CALCIUM" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TRPML1 releases lysosomal Ca2+ into a local microdomain on mTORC1 inhibition or lysosomal stress"];
  "MCOLN1" -> "LYSOSOME" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="TRPML1 is a channel resident in the lysosomal membrane, placing the Ca2+-calcineurin-TFEB step on the lysosomal surface"];
  "MAPKAP1_ISOFORM5" -> "MTORC2" [arrowhead=none, color="#898781", style=dashed, arrowhead=none, tooltip="mSin1 splice isoforms assemble distinct mTORC2 species; the isoform lacking the C-terminal PH domain yields a complex not gated by PIP3."];
  "VAR_MTOR_FAT_GOF" -> "DISEASE_RCC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Activating MTOR mutations are increasingly recognised in renal cell carcinoma, clustering in FAT and kinase domains."];
  "VAR_MTOR_FAT_GOF" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, label="A1459P, C1483Y, E1799K", tooltip="Cancer-associated FAT-domain MTOR substitutions can increase mTOR signalling; the magnitude and substrate profile vary among variants."];
  "VAR_MTOR_FAT_GOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Activating MTOR variants act on the kinase itself and so belong to the proximal-brake class."];
  "VAR_MTOR_KINASE_GOF" -> "DISEASE_RCC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Activating MTOR mutations occur in renal cell carcinoma; domain assignment and functional activation must be established for each variant."];
  "VAR_MTOR_KINASE_GOF" -> "DISEASE_UROTHELIAL_CARCINOMA" [arrowhead=normal, color="#0ca30c", style=dashed, label="E2419K", tooltip="Activating kinase-domain MTOR substitutions are recognised in urothelial carcinoma; a patient with a complete response to everolimus plus pazopanib carried two concurrent activating variants, E2014K and E2419K, shown to be activating in vitro."];
  "VAR_MTOR_KINASE_GOF" -> "MTOR" [arrowhead=normal, color="#0ca30c", style=solid, label="E2419K, S2215Y", tooltip="Selected MTOR kinase-domain substitutions increase signalling. E2419K was functionally activating in a urothelial cancer exceptional responder; F2108L is an FRB resistance mutation, not a kinase-domain activating substitution."];
  "VAR_MTOR_KINASE_GOF" -> "VAR_CLASS_PROXIMAL_BRAKE" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Activating MTOR variants in both the FAT and kinase domains belong to the proximal-brake class and are somatic."];
  "BTRC" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="SCF-betaTrCP binds the phosphorylated DEPTOR degron and polyubiquitinates it, committing the inhibitory subunit to proteasomal degradation."];
  "BTRC" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Growth-factor-induced phosphorylation of the DEPTOR degron, primed by mTOR (or by S6K1 and RSK1) and completed by casein kinase 1 alpha, creates a betaTrCP binding site; SCF-betaTrCP then ubiquitinates DEPTOR and targets it for proteasomal degradation, so active mTOR removes its own inhibitor."];
  "BTRC" -> "SCF_BTRC" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="beta-TrCP1 is the F-box substrate-receptor subunit of the SCF ligase that destroys DEPTOR."];
  "BTRC" -> "PDCD4" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="SCF-betaTrCP recognises the phospho-Ser67 degron of PDCD4 and ubiquitinates it for proteasomal degradation after growth-factor stimulation."];
  "EIF4EBP1" -> "EIF4E" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hypophosphorylated 4E-BP1 binds the dorsal surface of eIF4E through the canonical YXXXXLΦ motif shared with eIF4G and through a secondary site, sequestering eIF4E from eIF4F. Multisite phosphorylation releases eIF4E; in the paralogue 4E-BP2, phosphorylation of Thr37 and Thr46 folds the protein into "];
  "EIF4EBP1" -> "EIF4F" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="4E-BP1 and eIF4G share the eIF4E-binding motif, so 4E-BP1 binding to eIF4E is mutually exclusive with eIF4G and blocks eIF4F assembly on the cap."];
  "EIF4EBP1" -> "PHENO_CELL_PROLIFERATION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="4E-BPs mediate mTORC1 control of proliferation but not cell size: 4E-BP1/2-null cells are resistant to the antiproliferative effect of mTORC1 inhibition."];
  "EIF4EBP1" -> "TOP_MRNA" [arrowhead=tee, color="#d03b3b", style=dotted, tooltip="Ribosome profiling attributes TOP mRNA sensitivity to mTORC1 largely to 4E-BPs, whereas LARP1 studies show 4E-BP-independent repression; both arms likely contribute."];
  "EIF4EBP1" -> "HIF1A" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hypophosphorylated 4E-BP1 sequesters eIF4E and suppresses translation of the structured-5'UTR HIF1A mRNA; mTORC1 phosphorylation relieves this"];
  "EIF4EBP1" -> "MITOCHONDRIAL_BIOGENESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="4E-BPs restrain translation of nuclear-encoded mitochondrial mRNAs including TFAM and mitochondrial ribosomal proteins; mTORC1 phosphorylation relieves this"];
  "EIF4EBP1" -> "MYC" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hypophosphorylated 4E-BP1 binds eIF4E and restrains cap-dependent translation of MYC mRNA, whose structured 5′ untranslated region makes it highly dependent on eIF4F; mTORC1 phosphorylation of 4E-BP1 releases eIF4E and raises c-Myc protein."];
  "EIF4EBP1" -> "TFAM" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="4E-BP restrains translation of nuclear-encoded mitochondrial mRNAs including TFAM and respiratory chain components; mTORC1-dependent 4E-BP phosphorylation relieves this."];
  "EIF4EBP1" -> "VEGFA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Hypophosphorylated 4E-BP1 sequesters eIF4E and suppresses translation of VEGFA mRNA, which has a long structured 5′ untranslated region; mTORC1 phosphorylation of 4E-BP1 relieves this, adding a translational arm to HIF-1alpha-dependent VEGFA transcription."];
  "EIF4EBP1" -> "PHENO_PHOTIC_ENTRAINMENT" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="4E-BP1 restrains entrainment: Eif4ebp1-null mice show accelerated re-entrainment to a shifted light schedule and larger photic phase shifts, mirroring their elevated VIP levels"];
  "EIF4EBP1" -> "VIP" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="4E-BP1 represses translation of Vip mRNA in SCN neurons; 4E-BP1 loss raises VIP levels, accelerating re-entrainment and increasing network synchrony."];
  "EIF4EBP2" -> "EIF4E" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="4E-BP2, the predominant brain 4E-BP, restrains eIF4F formation; its loss enhances LTP, impairs memory and produces autism-like behaviour via excess eIF4E-dependent translation."];
  "EIF4EBP2" -> "LTP_LATE_PHASE" [arrowhead=odot, color="#898781", style=solid, tooltip="4E-BP2 represses cap-dependent translation at the synapse: in its absence a single train that normally yields only early-phase potentiation induces late-phase LTP, so the induction threshold falls, yet late-phase LTP elicited by repeated high-frequency trains is impaired and hippocampus-dependent me"];
  "EIF4EBP2" -> "PHENO_AUTISM_LIKE_BEHAVIOUR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Loss of the translational repressor 4E-BP2 produces autism-like behaviour with an increased excitation-to-inhibition ratio, the upper arm of the neuronal requirement for calibrated translational signalling; the accompanying synaptic phenotype is a lowered threshold for late-phase LTP rather than uni"];
  "LARP1" -> "EIF4E" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The C-terminal DM15 region of LARP1 binds the m7G cap and the adjacent 5'TOP pyrimidine tract at the same time. This occludes the cap from eIF4E and excludes eIF4F from TOP mRNAs when mTORC1 is inactive."];
  "LARP1" -> "EIF4F" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Cap occupancy by LARP1 sterically excludes eIF4E/eIF4F from TOP mRNAs."];
  "LARP1" -> "PABPC1" [arrowhead=odot, color="#898781", style=solid, tooltip="LARP1 associates with PABP and poly(A) tails, linking 3' and 5' ends of TOP mRNAs and contributing to their stability and mTORC1-responsive translation."];
  "LARP1" -> "RIBOSOME_BIOGENESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="LARP1 represses TOP mRNAs, which encode the ribosomal proteins and several elongation factors, and so indirectly limits the protein arm of ribosome biogenesis. Relief of this repression on mTORC1 activation lets ribosomal-protein supply scale with the Pol I rRNA and Pol III tRNA and 5S arms."];
  "LARP1" -> "TOP_MRNA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="When mTORC1 is inactive, the LARP1 DM15 domain binds the m7G cap and adjacent 5'TOP motif, repressing translation of ribosomal-protein and elongation-factor mRNAs."];
  "LARP1" -> "TOP_MRNA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Independently of translational repression, LARP1 (with 40S subunits) protects TOP mRNAs from decay; LARP1 depletion lowers TOP mRNA abundance."];
  "MAF1" -> "BRF1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="MAF1 binds the TFIIIB subunit BRF1 and inhibits de novo assembly of TFIIIB-DNA complexes on Pol III promoters, which impairs Pol III recruitment."];
  "MAF1" -> "POLR1" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Mammalian MAF1 also represses Pol I transcription, at least partly indirectly, by repressing transcription of TBP, the TATA-binding protein that Pol I initiation complexes require. No direct contact between MAF1 and Pol I has been shown."];
  "MAF1" -> "POLR3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Dephosphorylated MAF1 binds the Pol III clamp, rearranging the enzyme to prevent TFIIIB-dependent recruitment and closed-complex formation on tRNA and 5S promoters."];
  "PPP2CA" -> "RPS6KB1" [arrowhead=tee, color="#d03b3b", style=dashed, label="Thr389", tooltip="PP2A associates with S6K1 and dephosphorylates it when mTORC1 is inhibited by rapamycin; mTORC1 activity restrains PP2A action on S6K1."];
  "PPP2CA" -> "RRN3" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser44", tooltip="PP2A dephosphorylates the activating Ser44 site of TIF-IA/RRN3, reducing Pol I transcription; phosphatase inhibition attenuates rapamycin-induced Ser44 dephosphorylation."];
  "RPS6KB1" -> "IRS1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser1101, Ser307, Ser636, Ser639", tooltip="S6K1 phosphorylates IRS-1 on inhibitory serines, uncoupling it from INSR/PI3K and promoting its degradation — blunting PI3K–AKT output (negative feedback)."];
  "RPS6KB1" -> "IRS1" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser1101, Ser307, Ser636, Ser639", tooltip="S6K1 phosphorylates IRS-1 on inhibitory serines, promoting its degradation and blunting PI3K-AKT output from the insulin receptor."];
  "RPS6KB1" -> "DEPTOR" [arrowhead=tee, color="#d03b3b", style=dotted, tooltip="S6K1, together with RSK1, was reported to phosphorylate the DEPTOR betaTrCP degron (Ser286, Ser287, Ser291) after growth-factor stimulation, promoting SCF-betaTrCP-dependent DEPTOR degradation. Another laboratory found that S6K inhibition or knockdown does not change DEPTOR turnover and attributed d"];
  "RPS6KB1" -> "MAPKAP1" [arrowhead=tee, color="#d03b3b", style=dotted, label="Thr398, Thr86", tooltip="S6K1 phosphorylates mSin1 at Thr86 and Thr398, impairing mTORC2 complex integrity and suppressing downstream AKT signalling."];
  "RPS6KB1" -> "MAPKAP1" [arrowhead=tee, color="#d03b3b", style=dotted, label="Thr398, Thr86", tooltip="S6K1-dependent mSin1 Thr86/Thr398 phosphorylation was reported to disrupt mTORC2 and reduce AKT Ser473 phosphorylation."];
  "RPS6KB1" -> "MTOR" [arrowhead=odot, color="#898781", style=solid, label="Ser2448", tooltip="S6K1 phosphorylates mTOR at Ser2448 in the negative regulatory domain; the site is a convenient activity marker but has no demonstrated effect on catalysis."];
  "RPS6KB1" -> "RICTOR" [arrowhead=tee, color="#d03b3b", style=dotted, label="Thr1135", tooltip="mTORC1-activated S6K1 directly phosphorylates Rictor at Thr1135, creating a 14-3-3 binding site without altering mTORC2 assembly or in vitro kinase activity. Two studies found that a T1135A mutant raises AKT Ser473 phosphorylation, indicating feedback inhibition, whereas two others saw no major chan"];
  "RPS6KB1" -> "RICTOR" [arrowhead=tee, color="#d03b3b", style=dotted, label="Thr1135", tooltip="mTORC1-activated S6K1 directly phosphorylates Rictor at Thr1135, creating a 14-3-3 binding site without altering mTORC2 assembly or in vitro kinase activity. Two studies found that a T1135A mutant raises AKT Ser473 phosphorylation, indicating feedback inhibition, whereas two others saw no major chan"];
  "RPS6KB1" -> "RICTOR" [arrowhead=tee, color="#d03b3b", style=dotted, label="Thr1135", tooltip="mTORC1-activated S6K1 directly phosphorylates Rictor at Thr1135, creating a 14-3-3 binding site without altering mTORC2 assembly or in vitro kinase activity. Two studies found that a T1135A mutant raises AKT Ser473 phosphorylation, indicating feedback inhibition, whereas two others saw no major chan"];
  "RPS6KB1" -> "CELL_GROWTH" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="S6K1 deletion yields small mice and cells; S6Ks control cell size (growth) whereas 4E-BPs control proliferation downstream of mTORC1."];
  "RPS6KB1" -> "EEF2K" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser366", tooltip="S6K1 phosphorylates eEF2 kinase at Ser366, reducing its activity at physiological Ca2+ and thereby lowering eEF2 Thr56 phosphorylation and accelerating elongation."];
  "RPS6KB1" -> "EIF4B" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser422", tooltip="S6K1 phosphorylates eIF4B at Ser422 in a rapamycin-sensitive manner, enhancing eIF4B recruitment to the preinitiation complex and eIF4A helicase stimulation on structured 5'UTRs."];
  "RPS6KB1" -> "NCBP1" [arrowhead=odot, color="#898781", style=dashed, tooltip="S6K1 phosphorylates CBP80, the large subunit of the nuclear cap-binding complex, at residues that are also phosphorylated in cells in a growth-factor-dependent, rapamycin-sensitive manner, and S6K1 is found together with SKAR on CBP80-bound spliced mRNAs."];
  "RPS6KB1" -> "PDCD4" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser67", tooltip="S6K1 phosphorylates PDCD4 at Ser67, creating a phosphodegron for betaTrCP-mediated ubiquitination and proteasomal degradation, relieving eIF4A inhibition."];
  "RPS6KB1" -> "PDK1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr389", tooltip="Phosphorylation of the S6K1 hydrophobic motif at Thr389 by mTORC1 creates a docking site for the PIF pocket of PDK1, which then phosphorylates the S6K1 activation loop at Thr229. The mTORC1 and PDK1 inputs to S6K1 are therefore sequential rather than independent."];
  "RPS6KB1" -> "RIBOSOME_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="S6K activity controls a ribosome-biogenesis transcriptional programme (rRNA processing factors, Pol I/III cofactors) in addition to rDNA transcription."];
  "RPS6KB1" -> "RPS6" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser235, Ser236, Ser240, Ser244", tooltip="Active S6K1 phosphorylates 40S ribosomal protein S6 in ordered fashion (Ser236 first); phosphorylation influences cell size and glucose homeostasis."];
  "RPS6KB1" -> "RPS6KB1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The C-terminal autoinhibitory pseudosubstrate domain restrains S6K1; proline-directed phosphorylation (Ser411/Thr421/Ser424) relieves it, allowing Thr389/Thr229 phosphorylation."];
  "RPS6KB1" -> "SKAR" [arrowhead=odot, color="#898781", style=solid, label="Ser383, Ser385", tooltip="S6K1, but not S6K2, binds SKAR and phosphorylates it at Ser383 and Ser385 in response to insulin and other mitogens, in a rapamycin-sensitive manner. Depletion of SKAR reduces cell size, but the functional consequence of these two phosphorylations has not been determined."];
  "RPS6KB1" -> "UBTF" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="S6K1 activity is required for mTOR-dependent phosphorylation of the UBF carboxy-terminal activation domain, which enhances UBF binding to SL1 and Pol I transcription of rDNA. Rapamycin causes rapid dephosphorylation of this domain, and a constitutively active, rapamycin-resistant S6K1 reverses it. D"];
  "RPS6KB1" -> "CAD" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser1859", tooltip="S6K1 phosphorylates CAD at Ser1859, promoting its oligomerisation and raising flux through the first three steps of de novo pyrimidine synthesis"];
  "RPS6KB1" -> "SREBF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="S6K1 is required for insulin-stimulated proteolytic processing of SREBP-1c, providing an S6K1-dependent limb of mTORC1 lipogenic output"];
  "RPS6KB1" -> "BMAL1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser42", tooltip="S6K1 phosphorylates BMAL1, licensing its association with the translational machinery and so coupling nutrient status and mTORC1 activity to rhythmic cap-dependent translation."];
  "RPS6KB1" -> "PHENO_INSULIN_RESISTANCE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Chronic mTORC1 activation in obesity contributes to insulin resistance through S6K1-mediated inhibitory phosphorylation of IRS-1, and through lipotoxic consequences of constrained storage capacity."];
  "RPS6KB1" -> "PHENO_LIFESPAN_EXTENSION" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Germline deletion of S6K1 extends median lifespan by about 19% in female mice, with no significant effect in males, placing one mTORC1 substrate arm within the longevity mechanism."];
  "RPS6KB2" -> "RPS6" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser235, Ser236, Ser240, Ser244", tooltip="S6K2 phosphorylates rpS6 redundantly with S6K1 and is the principal rpS6 kinase in S6K1-null cells; residual Ser235/236 in double knockouts derives from RSK."];
  "RRN3" -> "POLR1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TIF-IA binds initiation-competent Pol I and bridges it to the SL1 promoter-selectivity factor at the rDNA promoter."];
  "RRN3" -> "SL1_TIF_IB" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="RRN3/TIF-IA binds both Pol I and the TAF1B subunit of promoter-bound SL1/TIF-IB, bridging initiation-competent polymerase to the rDNA promoter. This bridging step is the point at which the mTORC1 input on TIF-IA Ser44 is converted into pre-initiation complex formation."];
  "UBTF" -> "POLR1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="UBF binds the rDNA promoter and enhancer, recruits SL1 and stabilises Pol I preinitiation complexes; its activity is mTOR/S6K1-dependent."];
  "AMBRA1" -> "PIK3C3_COMPLEX_I" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="AMBRA1 binds Beclin-1 and promotes the activity of the autophagy-specific class III PI3K complex I; it is a regulatory partner of the complex rather than one of its core subunits, which are VPS34, VPS15, Beclin-1 and ATG14L."];
  "AMBRA1" -> "ULK1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Released AMBRA1 recruits TRAF6 to catalyse K63-linked ULK1 ubiquitylation, promoting ULK1 self-association, stability and activity"];
  "ATG101" -> "ULK1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="ATG101 binds ATG13 through HORMA-domain interaction, stabilising it within the initiation complex"];
  "ATG13" -> "ULK1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="ATG13 bridges ULK1 and FIP200 and is required for complex integrity and ULK1 activity"];
  "ATG14" -> "PIK3C3_COMPLEX_I" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="ATG14L is the subunit that targets the VPS34 complex to the autophagy initiation site, defining complex I"];
  "EP300" -> "AUTOPHAGY" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="p300-mediated acetylation of ATG proteins (ATG5, ATG7, ATG12, LC3) suppresses autophagosome formation; p300 depletion induces autophagy"];
  "EP300" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="p300 acetylates lipogenic regulators to promote de novo lipid synthesis, providing an acetylation-dependent limb of mTORC1 lipid output"];
  "GRB10" -> "IGF1R" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Grb10 binds and desensitises the IGF-1 receptor in the same manner as INSR."];
  "GRB10" -> "IGF1R" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Grb10 binds and desensitises the IGF-1 receptor, extending the feedback brake to IGF-1 signalling"];
  "GRB10" -> "INSR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Stabilised Grb10 binds the activated insulin receptor kinase (SH2/BPS domains), desensitising receptor signalling to IRS/PI3K."];
  "GRB10" -> "INSR" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Stabilised Grb10 binds the insulin receptor and desensitises downstream signalling, independently of the S6K1-IRS-1 arm"];
  "LPIN1" -> "SREBF1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="When mTORC1 is inactive, dephosphorylated lipin 1 enters the nucleus and lowers nuclear SREBP protein abundance, SREBP promoter activity and SREBP target-gene expression; mTORC1 phosphorylation keeps lipin 1 cytoplasmic and relieves this inhibition. Direct binding or sequestration of SREBP by lipin "];
  "PPP3" -> "TFEB" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser142, Ser211", tooltip="Calcineurin dephosphorylates TFEB, releasing 14-3-3 and permitting nuclear entry and CLEAR-network transcription"];
  "RB1CC1" -> "ULK1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="FIP200 is the scaffold subunit of the ULK1 initiation complex and is required for ULK1 stability and phagophore nucleation"];
  "RUBCNL" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Pacer (RUBCNL) promotes autophagosome maturation by engaging STX17 and the HOPS tethering complex and by relieving Rubicon-mediated inhibition of VPS34."];
  "TFE3" -> "CLEAR_NETWORK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TFE3 binds the same CLEAR elements as TFEB and drives lysosomal and autophagy gene expression, providing partial redundancy"];
  "TFEB" -> "CLEAR_NETWORK" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear TFEB binds CLEAR E-box elements and drives approximately 470 lysosomal and autophagy genes coordinately"];
  "TFEB" -> "MCOLN1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="MCOLN1 is itself a CLEAR target gene, so TFEB activation raises TRPML1 expression and amplifies the Ca2+-calcineurin input back onto TFEB"];
  "TFEB" -> "RRAGD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TFEB drives RRAGD expression, increasing Rag-dependent lysosomal recruitment of mTORC1 - a transcriptional feed-forward loop onto mTORC1"];
  "TFEB" -> "CIRCADIAN_CLOCK" [arrowhead=odot, color="#898781", style=dashed, tooltip="TFEB and TFE3, the mTORC1-controlled transcription factors of the autophagy–lysosome programme, feed back onto peripheral clock gene expression, coupling catabolic state to the clock."];
  "ULK1" -> "AMPK" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="ULK1 phosphorylates all three AMPK subunits (several Ser/Thr sites on alpha1, beta2, gamma1), reducing AMPK activity: a negative feedback loop terminating the autophagy-inducing signal."];
  "ULK1" -> "RPTOR" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser792, Ser855, Ser859", tooltip="ULK1 phosphorylates Raptor strongly at Ser855 and Ser859 and moderately at Ser792, which hinders 4E-BP1 docking on Raptor and lowers mTORC1 output toward S6K1 and 4E-BP1."];
  "ULK1" -> "ATG13" [arrowhead=odot, color="#898781", style=solid, tooltip="Activated ULK1 phosphorylates its complex partner ATG13 at several sites within the initiation complex; the modification accompanies autophagy induction and promotes ATG13 recruitment to damaged mitochondria during mitophagy, but it is not known to activate ATG13 itself."];
  "ULK1" -> "ATG14" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser29", tooltip="ULK1 phosphorylates ATG14L at Ser29, stimulating VPS34 activity in the autophagy-specific complex and opposing the inhibitory mTORC1 marks"];
  "ULK1" -> "ATG9A" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="ULK1/Atg1 phosphorylates ATG9 to control its trafficking to and from the phagophore assembly site, a required step for membrane delivery during autophagosome formation."];
  "ULK1" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="ULK1 kinase activity initiates phagophore formation; it is the principal node through which nutrient and energy status gate autophagy"];
  "ULK1" -> "BECN1" [arrowhead=normal, color="#0ca30c", style=solid, label="Ser14", tooltip="ULK1 phosphorylates Beclin-1 at Ser14, activating VPS34 lipid-kinase activity within autophagy-specific class III PI3K complexes"];
  "ULK1" -> "RB1CC1" [arrowhead=odot, color="#898781", style=solid, tooltip="Active ULK1 phosphorylates FIP200 within the initiation complex; the modification accompanies autophagy induction, although a specific requirement for it in phagophore nucleation has not been demonstrated."];
  "UVRAG" -> "PIK3C3_COMPLEX_II" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="UVRAG defines VPS34 complex II, mutually exclusive with ATG14L."];
  "WIPI2" -> "ATG16L1_COMPLEX" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="WIPI2 binds ATG16L1 directly and recruits the ATG12–ATG5–ATG16L1 conjugation machinery to PI3P-positive phagophores, licensing LC3 lipidation."];
  "ARHGEF3" -> "MTORC2" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="XPLN binds Rictor and suppresses mTORC2-mediated AKT Ser473 phosphorylation independently of its Rho GEF activity."];
  "PKC" -> "ACTIN_CYTOSKELETON" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Loss of mTORC2-primed PKC protein produces cytoskeletal defects, the mechanistic link between mTORC2 and actin organisation."];
  "PKC" -> "CELL_ADHESION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PKC-dependent Rho-family signalling supports adhesion dynamics, which fail when mTORC2 priming is lost."];
  "PKC" -> "CELL_MIGRATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Reduced PKC protein in mTORC2-deficient cells impairs migration."];
  "PKC" -> "EPITHELIAL_POLARITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC2-dependent PKC activity is required for epithelial apicobasal polarity; mTORC2-deficient cells show polarity defects."];
  "PKC" -> "RAC1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Loss of mTORC2 lowers PKC protein and activity and reduces Rho-family signalling, of which Rac1 is a member; a direct action of PKC on Rac1, plausibly through Rac guanine-nucleotide exchange factors, has not been established, and Rac1 has also been reported to act upstream of mTOR."];
  "PKC" -> "RHOA" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="mTORC2-deficient cells lose PKC protein and show Rho-pathway and actomyosin defects; the connection from PKC to RhoA is inferred from this phenotype rather than demonstrated as a direct activating step."];
  "PRKCZ" -> "EPITHELIAL_POLARITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Atypical PKC activity within the Par3–Par6–aPKC module specifies the apical domain by phosphorylating Par3, Lgl and Par1; PKC-iota/lambda and PKC-zeta act redundantly in mammalian epithelia, and their mTORC2-dependent stability links the complex to polarity."];
  "SGK1" -> "ATP1A1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SGK1 signalling increases Na+/K+-ATPase activity and surface abundance, maintaining the basolateral gradient for transepithelial sodium transport; the alpha1 subunit has not been shown to be a direct substrate of the kinase."];
  "SGK1" -> "CLCNK" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Coexpression of SGK1 increases CLC-K/barttin chloride channel activity in heterologous systems, which would complete the transcellular salt transport route; phosphorylation of the channel or of barttin has not been demonstrated."];
  "SGK1" -> "FOXO3" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser315, Thr32", tooltip="SGK1 phosphorylates FOXO3a at Thr32 and Ser315, promoting 14-3-3 binding and nuclear exclusion. SGK1 and AKT phosphorylate overlapping but non-identical sites, so SGK1 provides a parallel, AKT-independent route from mTORC2 to FOXO suppression."];
  "SGK1" -> "NDRG1" [arrowhead=normal, color="#0ca30c", style=solid, label="Thr346, Thr356, Thr366", tooltip="SGK1 phosphorylates NDRG1, the standard cellular readout of mTORC2–SGK1 pathway activity."];
  "SGK1" -> "NEDD4L" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="SGK1 phosphorylates Nedd4-2, creating 14-3-3 binding sites that prevent it from ubiquitinating ENaC."];
  "SGK1" -> "SCNN1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SGK1 raises ENaC surface expression and open probability chiefly indirectly, by phosphorylating Nedd4-2 and relieving ubiquitin-dependent channel retrieval; direct phosphorylation of the channel alpha subunit has been reported in heterologous expression systems and may contribute to the rise in open"];
  "SGK1" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=dashed, label="Ser939", tooltip="SGK1 phosphorylates TSC2 at a site overlapping the AKT site, relieving TSC complex GAP activity toward Rheb and sustaining mTORC1 activity independently of AKT."];
  "SGK1" -> "ION_TRANSPORT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SGK1 stimulates sodium reabsorption in the distal nephron, chiefly by phosphorylating NEDD4-2 and so stabilising the epithelial sodium channel at the apical membrane, and it additionally supports Na+/K+-ATPase and CLC-K-dependent transport, with consequences for blood pressure."];
  "RIBOSOME" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="A minor subset of mTORC2 associates with ribosomes; the association is PI3K- and growth-factor-responsive and constitutes an activating input to the complex."];
  "RIBOSOME" -> "MTORC2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="A minor subset of mTORC2 associates with ribosomes; this association activates the complex and provides a growth-factor-responsive input."];
  "RIBOSOME" -> "PROTEIN_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ribosome abundance sets translational capacity; mTORC1-driven ribosome biogenesis is therefore a prerequisite for sustained anabolic protein synthesis."];
  "BRF1" -> "POLR3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TFIIIB (Brf1-containing) recruits Pol III to TFIIIC-bound tRNA and 5S genes and is the main target of growth-regulated Pol III control."];
  "CCND1" -> "PHENO_CELL_PROLIFERATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cyclin D1 partners CDK4/6 to phosphorylate RB and drive the G1/S transition, linking eIF4F-dependent cyclin D1 translation to cell-cycle entry."];
  "EEF2" -> "PROTEIN_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="eEF2 catalyses GTP-dependent ribosomal translocation; relief of eEF2K by S6K1 therefore increases elongation rate."];
  "EEF2K" -> "EEF2" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr56", tooltip="eEF2K phosphorylates eEF2 at Thr56 in the GTP-binding domain, preventing eEF2 from binding the ribosome and halting translocation."];
  "EIF3" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Inactive S6K1 is bound to eIF3; Thr389 phosphorylation by eIF3-recruited mTORC1 releases S6K1 to phosphorylate rpS6 and eIF4B at the preinitiation complex."];
  "EIF4A1" -> "EIF4F" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="eIF4A is the DEAD-box helicase subunit of eIF4F that unwinds 5'UTR secondary structure for 43S scanning."];
  "EIF4B" -> "EIF3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ser422-phosphorylated eIF4B shows increased association with eIF3, integrating it into the 43S preinitiation complex."];
  "EIF4B" -> "EIF4A1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="eIF4B is a cofactor that stimulates eIF4A ATPase and RNA-helicase activity, promoting unwinding of structured 5' untranslated regions during scanning."];
  "EIF4B" -> "MYC" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="eIF4B stimulates eIF4A helicase activity on structured 5'UTRs. Its depletion selectively reduces translation of c-Myc mRNA, together with other structured-5'UTR mRNAs such as Cdc25C, ODC, Bcl-2 and XIAP."];
  "EIF4E" -> "EIF4EBP1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Binding to eIF4E protects hypophosphorylated 4E-BP1 from ubiquitination by the KLHL25-CUL3 ligase. When eIF4E is depleted, hypophosphorylated 4E-BP1 is degraded while hyperphosphorylated 4E-BP1 is spared, so 4E-BP1 levels track eIF4E abundance."];
  "EIF4E" -> "EIF4F" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="eIF4E binds the m7G cap and nucleates eIF4F assembly by recruiting eIF4G."];
  "EIF4E" -> "EIF4G1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="eIF4E recruits the eIF4G scaffold through the canonical YXXXXLΦ eIF4E-binding motif, nucleating eIF4F assembly on the cap. The 4E-BPs carry the same motif and engage the same dorsal surface of eIF4E, so their binding excludes eIF4G."];
  "EIF4E" -> "PHENO_CELL_PROLIFERATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Released eIF4E drives the proliferative translational programme (cyclin D1, c-Myc, Mcl-1); eIF4E overexpression is transforming in vivo and the proliferative output of mTORC1 is specifically 4E-BP/eIF4E-dependent rather than S6K-dependent."];
  "EIF4E" -> "PER1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Ser209-phosphorylated eIF4E promotes translation of Per1 mRNA in the SCN, converting a light pulse into a rise in PER protein and hence a phase shift"];
  "EIF4E" -> "PER2" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="eIF4E-dependent translational control also governs Per2 protein output in the SCN, coupling translation-initiation state to the negative limb"];
  "EIF4F" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Assembled eIF4F recruits the 43S complex to capped mRNAs; its availability is rate-limiting for cap-dependent initiation."];
  "EIF4F" -> "CCND1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cyclin D1 mRNA has a structured 5'UTR whose translation is preferentially sensitive to eIF4E availability and 4E-BP status."];
  "EIF4F" -> "HIF1A" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Release of eIF4E from the 4E-BPs downstream of mTORC1 increases eIF4F-dependent translation of HIF-1α mRNA. This raises expression of the HIF-1 glycolytic targets GLUT1, hexokinase 2, PFKFB3, PKM2 and LDHA."];
  "EIF4F" -> "MCL1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1 promotes survival through 4E-BP/eIF4E-dependent translation of Mcl-1 mRNA."];
  "EIF4F" -> "MYC" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="c-Myc mRNA (structured 5'UTR) is translated in an eIF4F/eIF4A-dependent manner downstream of mTORC1-4E-BP signalling."];
  "EIF4F" -> "VEGFA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="VEGF mRNA translation is eIF4E-sensitive, linking the 4E-BP arm to angiogenesis."];
  "EIF4G1" -> "EIF3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="eIF4G-eIF3 interaction bridges cap-bound eIF4F to the 43S preinitiation complex; insulin stimulates this association in an mTOR-dependent manner."];
  "EIF4G1" -> "EIF4F" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="eIF4G is the eIF4F scaffold binding eIF4E, eIF4A, eIF3, PABP and MNK."];
  "EIF4G1" -> "MKNK1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="MNK docks on the C-terminus of eIF4G to phosphorylate eIF4E; 4E-BP sequestration of eIF4E therefore also prevents Ser209 phosphorylation."];
  "GTF3C" -> "BRF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TFIIIC bound to the internal promoter recruits TFIIIB (BRF1-TBP-BDP1) to the upstream region, and TFIIIB in turn loads Pol III. tRNA genes use a type 2 A-box/B-box promoter, whereas 5S rRNA genes use a type 1 promoter at which TFIIIC binding also requires TFIIIA."];
  "HIF1A" -> "BNIP3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1 binds a hypoxia-response element in the BNIP3 promoter, strongly inducing BNIP3 under hypoxia (mitophagy, Rheb binding)."];
  "HIF1A" -> "DDIT4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1 binds hypoxia-response elements in the REDD1/RTP801 (DDIT4) promoter, rapidly inducing REDD1 mRNA and protein under hypoxia."];
  "HIF1A" -> "HK2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha induces hexokinase 2, committing imported glucose to glycolysis as glucose-6-phosphate"];
  "HIF1A" -> "LDHA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha induces LDHA, regenerating NAD+ and sustaining high glycolytic flux with lactate export"];
  "HIF1A" -> "PFKFB3" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha induces PFKFB3, raising fructose-2,6-bisphosphate and allosterically activating PFK1"];
  "HIF1A" -> "PKM2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha raises PKM2 expression; the M2 isoform supports the biosynthetic rather than purely catabolic use of glycolytic carbon"];
  "HIF1A" -> "SLC2A1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha binds hypoxia-response elements in the SLC2A1 promoter, raising GLUT1 expression and glucose uptake"];
  "HIF1A" -> "VEGFA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HIF-1alpha, with HIF-1beta (ARNT), binds a hypoxia-response element in the VEGFA 5′-flanking region and induces VEGFA transcription."];
  "MKNK1" -> "EIF4E" [arrowhead=odot, color="#898781", style=solid, label="Ser209", tooltip="ERK/p38-activated MNK1/2 phosphorylate eIF4E Ser209; dispensable for global translation but promotes tumorigenesis and translation of select mRNAs."];
  "MYC" -> "BRF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="c-Myc binds TFIIIB through BRF1 and is recruited to tRNA and 5S rRNA genes, directly activating Pol III transcription independently of its Pol II target genes."];
  "MYC" -> "RIBOSOME_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="c-Myc, itself translated in a 4E-BP/eIF4B-dependent manner, transcriptionally induces ribosomal-protein genes, Pol I/III cofactors (UBF, TIF-IA, Brf1) and rRNA processing factors."];
  "MYC" -> "GLS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="c-Myc transcriptionally represses miR-23a and miR-23b, relieving their repression of the glutaminase transcript and raising glutaminase protein, which increases conversion of glutamine to glutamate."];
  "PABPC1" -> "EIF4G1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Poly(A)-binding protein bound to the 3' poly(A) tail binds the N-terminal region of eIF4G. This circularises the mRNA and stimulates 43S recruitment and cap-dependent initiation."];
  "PDCD4" -> "EIF4A1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PDCD4 MA3 domains bind eIF4A, blocking its helicase activity and its interaction with eIF4G, thereby suppressing translation of structured-5'UTR mRNAs."];
  "PDCD4" -> "EIF4G1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The tandem MA3 domains of PDCD4 bind eIF4A at the surface that eIF4G uses. PDCD4 therefore both inhibits eIF4A helicase activity and prevents eIF4A from being incorporated into eIF4F through eIF4G."];
  "PDCD4" -> "PHENO_CELL_PROLIFERATION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="PDCD4 suppresses neoplastic transformation and inhibits eIF4A-dependent translation of mRNAs with structured 5'UTRs. Its S6K1- and βTrCP-dependent degradation after mitogenic stimulation is required for the full rise in protein synthesis and cell growth after mTORC1 activation, so its effect on prol"];
  "POLR1" -> "PRE_RRNA_47S" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Pol I transcribes the rDNA repeats into the 47S pre-rRNA, the rate-limiting step of ribosome biogenesis coordinated by mTORC1."];
  "POLR3" -> "RRNA_5S" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Pol III transcribes 5S rRNA genes under MAF1/mTORC1 control, supplying the 60S subunit component."];
  "POLR3" -> "TRNA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Pol III transcribes tRNA genes; output rises when mTORC1 phosphorylates and inactivates MAF1."];
  "PRE_RRNA_47S" -> "RIBOSOME" [arrowhead=vee, color="#898781", style=solid, tooltip="47S pre-rRNA is processed into 18S, 5.8S and 28S rRNAs and assembled with ribosomal proteins in the nucleolus into 40S and 60S subunits."];
  "RPS6" -> "CELL_GROWTH" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="rpS6 phosphorylation is a determinant of cell size: phospho-null rpS6 knock-in mice have smaller cells (notably beta-cells) and impaired glucose homeostasis."];
  "RPS6" -> "RIBOSOME" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="rpS6 (eS6) is a 40S small-subunit ribosomal protein located near the mRNA/tRNA binding site."];
  "RRNA_5S" -> "RIBOSOME" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="5S rRNA is incorporated with RPL5/RPL11 into the 60S large subunit central protuberance."];
  "SKAR" -> "EXON_JUNCTION_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="SKAR (Aly/REF-like) is deposited with the exon junction complex on newly spliced mRNAs."];
  "SKAR" -> "RPS6KB1" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="SKAR recruits activated S6K1 to newly spliced messenger ribonucleoproteins carrying the exon junction complex, which was reported to raise the translation efficiency of spliced relative to unspliced transcripts."];
  "SL1_TIF_IB" -> "POLR1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SL1/TIF-IB (TBP plus TAF1A/TAF1B/TAF1C) binds the rDNA core promoter and, together with UBF, nucleates the Pol I pre-initiation complex; no Pol I initiation occurs without it."];
  "TOP_MRNA" -> "RIBOSOME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TOP mRNAs encode essentially all ribosomal proteins plus eEF1A, eEF2 and PABP; their mTORC1/LARP1-controlled translation scales ribosomal-protein supply with rRNA synthesis."];
  "TRNA" -> "PROTEIN_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="tRNA supply, scaled with ribosome production via mTORC1-MAF1, is required for elongation capacity."];
  "ACACA" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Acetyl-CoA carboxylase 1 supplies malonyl-CoA, the rate-limiting substrate for fatty acid synthase."];
  "ATF4" -> "DDIT4" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="ATF4, induced through eIF2alpha phosphorylation, is necessary and sufficient for transcriptional induction of REDD1 (DDIT4) during ER stress, and together with C/EBP-beta drives REDD1 expression during oxidative stress; REDD1 then suppresses mTORC1 through TSC2."];
  "ATF4" -> "SESN2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="ATF4 induces SESN2 transcription downstream of GCN2 during amino-acid deprivation and during ER stress; the induced Sestrin2 is required to sustain mTORC1 repression by keeping mTORC1 off the lysosome."];
  "ATF4" -> "GLUTATHIONE_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1-driven ATF4 promotes glutathione synthesis alongside protein synthesis, coupling anabolic signalling to redox buffering"];
  "ATF4" -> "MTHFD2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="ATF4 induces the mitochondrial folate-cycle enzyme MTHFD2, the step through which mTORC1 couples one-carbon metabolism to purine supply"];
  "ATF4" -> "SIRT4" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="ATF4 (CREB2) drives SIRT4 transcription; mTORC1 represses SIRT4 indirectly by promoting proteasome-dependent degradation of ATF4."];
  "ATG16L1_COMPLEX" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The ATG12–ATG5–ATG16L1 complex acts as the E3-like ligase that conjugates LC3/GABARAP proteins to phagophore phosphatidylethanolamine, a step required for autophagosome expansion and closure."];
  "BECN1" -> "PIK3C3_COMPLEX_I" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Beclin-1 is the core coiled-coil subunit of the autophagy-specific class III PI3K complex"];
  "BECN1" -> "PIK3C3_COMPLEX_II" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="Beclin-1 is shared between VPS34 complexes I and II; complex II substitutes UVRAG for ATG14L and functions in autophagosome maturation and endosomal trafficking."];
  "CAD" -> "PYRIMIDINE_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="CAD catalyses the committed early steps of de novo pyrimidine synthesis, producing dihydroorotate from glutamine and bicarbonate"];
  "CEBPB" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="C/EBPβ binds and activates autophagy gene promoters, generating the daily rhythm of autophagic flux in liver"];
  "FASN" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Fatty acid synthase performs the iterative condensation producing palmitate, the committed output of de novo lipogenesis."];
  "G6PD" -> "NADPH" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glucose-6-phosphate dehydrogenase catalyses the first and rate-limiting oxidative step of the pentose phosphate pathway, reducing NADP+ to NADPH. This is the specific enzymatic step by which the SREBP–G6PD arm supplies reducing equivalents."];
  "G6PD" -> "PENTOSE_PHOSPHATE_PATHWAY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="G6PD catalyses the rate-limiting oxidative step, supplying NADPH for reductive biosynthesis and ribose-5-phosphate for nucleotides"];
  "GLUD1" -> "AKG" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glutamate dehydrogenase catalyses the glutamate-to-alpha-ketoglutarate step that makes glutaminolysis an input to lysosomal mTORC1 activation"];
  "GLUD1" -> "GLUTAMINE_ANAPLEROSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glutamate dehydrogenase converts glutamate to alpha-ketoglutarate, feeding glutamine carbon into the TCA cycle"];
  "HK2" -> "RPTOR" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="During glucose deprivation hexokinase-II, lacking bound glucose-6-phosphate, binds Raptor through a TOS-like motif and inhibits mTORC1, promoting protective autophagy; G6P binding prevents the interaction."];
  "HK2" -> "GLYCOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hexokinase 2 converts glucose to glucose-6-phosphate at the entry to glycolysis; glucose-6-phosphate can also feed other pathways."];
  "HMGCR" -> "CHOLESTEROL_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="HMG-CoA reductase catalyses the rate-limiting conversion of HMG-CoA to mevalonate, committing carbon to sterol synthesis."];
  "IL1A" -> "SASP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Cell-surface IL-1alpha signals through IL1R-NF-kB to sustain the pro-inflammatory secretory programme of senescent cells"];
  "IL1A" -> "SASP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="IL-1alpha acts upstream of the IL1 receptor-NF-kB arm that sustains the SASP transcriptional programme."];
  "LDHA" -> "GLYCOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="LDHA converts pyruvate to lactate with NAD+ regeneration, permitting sustained aerobic glycolytic flux"];
  "MTHFD2" -> "ONE_CARBON_METABOLISM" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="MTHFD2 drives the mitochondrial tetrahydrofolate cycle, generating formyl units used for nucleotide synthesis"];
  "MTHFD2" -> "PURINE_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Formyl-tetrahydrofolate produced by the MTHFD2-dependent cycle supplies carbon to the purine ring, demonstrated by metabolic tracing"];
  "NADPH" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="De novo fatty acid and sterol synthesis consume NADPH as the reductant, which couples the pentose phosphate arm to the lipogenic arm."];
  "NRF1" -> "TFAM" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="NRF1 induces TFAM expression, coupling the nuclear transcriptional programme to mitochondrial DNA replication and transcription."];
  "PFKFB3" -> "GLYCOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Fructose-2,6-bisphosphate produced by PFKFB3 allosterically activates PFK1, the principal flux-controlling step"];
  "PI3P" -> "WIPI2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="WIPI2 is a PROPPIN-family PI3P effector whose recruitment to the phagophore depends on direct PI3P binding through its beta-propeller."];
  "PIK3C3_COMPLEX_I" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PI(3)P generated by complex I recruits WIPI proteins and the ATG conjugation machinery, committing the phagophore to elongation"];
  "PIK3C3_COMPLEX_I" -> "PI3P" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The ATG14L-containing VPS34 complex phosphorylates phosphatidylinositol at the 3-position to generate PI3P on the nascent phagophore."];
  "PIK3C3_COMPLEX_II" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="UVRAG-containing class III PI3K complex II is implicated in late autophagy, with UVRAG engaging the class C Vps/HOPS tethering complex to promote autophagosome fusion with late endosomes and lysosomes. This maturation function is genetically separable from UVRAG binding to Beclin-1, so whether it re"];
  "PKM2" -> "GLYCOLYSIS" [arrowhead=odot, color="#898781", style=solid, tooltip="PKM2 catalyses the final glycolytic step; its regulated low-activity state diverts upstream intermediates into biosynthesis"];
  "PPARG" -> "ADIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PPARgamma is the master transcriptional driver of adipocyte differentiation and lipid-storage gene expression"];
  "PPARGC1A" -> "MITOCHONDRIAL_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PGC-1alpha coactivates the nuclear transcriptional programme for mitochondrial biogenesis and oxidative metabolism"];
  "PPARGC1A" -> "NRF1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="PGC-1alpha coactivates NRF1 on the promoters of nuclear-encoded respiratory and mitochondrial biogenesis genes."];
  "RIBOSE_5_PHOSPHATE" -> "PURINE_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ribose-5-phosphate is converted to PRPP, the committed substrate for de novo purine synthesis; links the pentose phosphate arm to the ATF4–MTHFD2 purine arm."];
  "RIBOSE_5_PHOSPHATE" -> "PYRIMIDINE_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Ribose-5-phosphate is converted to PRPP, which UMP synthase uses to convert orotate to OMP before decarboxylating it to UMP; this step lies downstream of CAD and DHODH and links the pentose phosphate arm to the S6K1–CAD pyrimidine arm."];
  "SIRT4" -> "GLUD1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="SIRT4 ADP-ribosylates glutamate dehydrogenase and inhibits it; its repression downstream of mTORC1 releases the enzyme"];
  "SLC2A1" -> "GLUCOSE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="GLUT1 mediates facilitative glucose import across the plasma membrane, raising intracellular glucose availability"];
  "SREBF1" -> "ACACA" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear SREBP1 induces acetyl-CoA carboxylase 1, catalysing the committed step of de novo lipogenesis."];
  "SREBF1" -> "FASN" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear SREBP1 induces fatty acid synthase, one of the lipogenic target genes whose induction defines the mTORC1–SREBP1 arm."];
  "SREBF1" -> "G6PD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SREBP-dependent induction of G6PD activates the oxidative pentose phosphate pathway downstream of mTORC1"];
  "SREBF1" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear SREBP1 induces ACC, FASN and SCD1, driving de novo fatty-acid synthesis"];
  "SREBF1" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SREBP1c induces the lipogenic gene programme (FASN, ACC, SCD1)."];
  "SREBF1" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="SREBP1c induces the lipogenic enzyme battery; this is the arm through which hepatic mTORC1 contributes to steatosis under hyperinsulinaemic conditions."];
  "SREBF1" -> "SCD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear SREBP1 induces stearoyl-CoA desaturase 1, required for monounsaturated fatty acid supply to membrane lipid and triglyceride synthesis."];
  "SREBF2" -> "CHOLESTEROL_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear SREBP2 induces HMGCR, HMGCS1 and LDLR, driving the sterol biosynthetic and uptake programme"];
  "SREBF2" -> "HMGCR" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear SREBP2 induces HMG-CoA reductase and other mevalonate pathway genes; mTOR activity is required for full expression of this sterol biosynthetic programme."];
  "TFAM" -> "MITOCHONDRIAL_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="TFAM packages mitochondrial DNA and activates its transcription; its loss abolishes mtDNA maintenance and oxidative phosphorylation, making it a required effector of mitochondrial biogenesis."];
  "YWHA" -> "AKT1S1" [arrowhead=tee, color="#d03b3b", style=solid, label="Thr246", tooltip="pThr246-PRAS40 binds 14-3-3, which displaces PRAS40 from Raptor/mTORC1 and so derepresses substrate access."];
  "YWHA" -> "TSC2" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser1210, Ser939, Ser981, Thr1462", tooltip="14-3-3 binds AKT-phosphorylated TSC2 at Ser939 and Thr1462, with Ser981 and the MK2-generated site Ser1210 also contributing, and partitions TSC2 into the cytosol away from the membrane compartment where it acts on Rheb; whether TSC1-TSC2 association is lost or the intact complex is displaced from t"];
  "YWHA" -> "RPTOR" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser722, Ser792", tooltip="14-3-3 docks onto AMPK-phosphorylated Raptor (pSer722/pSer792), suppressing mTORC1 activity toward S6K1/4E-BP1 under energy stress."];
  "YWHA" -> "TFE3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Phosphorylated TFE3 is bound by 14-3-3 and held in the cytoplasm, mirroring the TFEB mechanism"];
  "YWHA" -> "TFEB" [arrowhead=tee, color="#d03b3b", style=solid, label="Ser211", tooltip="14-3-3 binds phospho-Ser211 TFEB, masking its nuclear localisation signal and sequestering it in the cytoplasm"];
  "YWHA" -> "FOXO1" [arrowhead=tee, color="#d03b3b", style=solid, label="phospho-Ser256, phospho-Thr24", tooltip="14-3-3 dimers bind FOXO1 after AKT phosphorylates it at Thr24 and Ser256 (binding needs both sites). Binding impairs DNA binding and shifts FOXO1 to the cytoplasm, contributing to insulin- and growth factor-induced silencing of FOXO1 target genes."];
  "YWHA" -> "FOXO3" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Phosphorylation of FOXO3a by AKT or SGK1 creates 14-3-3 binding sites; 14-3-3 binding drives nuclear exclusion and cytoplasmic retention, terminating FOXO3a-dependent transcription."];
  "YWHA" -> "NEDD4L" [arrowhead=tee, color="#d03b3b", style=solid, label="SGK1-phosphorylated Ser/Thr motifs", tooltip="SGK1 phosphorylation of NEDD4-2 creates 14-3-3 binding sites; 14-3-3 binding sequesters the ligase away from ENaC, preventing PY-motif ubiquitination and increasing channel surface density."];
  "YWHA" -> "RICTOR" [arrowhead=odot, color="#898781", style=solid, label="Thr1135", tooltip="S6K1-phosphorylated Thr1135 of Rictor recruits 14-3-3 proteins to Rictor and mTORC2. Whether this binding restrains mTORC2 signalling to AKT is unresolved."];
  "YY1" -> "MITOCHONDRIAL_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The YY1-PGC-1alpha complex drives transcription of nuclear-encoded mitochondrial genes, supporting oxidative capacity"];
  "YY1" -> "PPARGC1A" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="YY1 and PGC-1alpha form a transcriptional complex on mitochondrial gene promoters whose assembly depends on mTOR activity"];
  "ZFP36L1" -> "SASP" [arrowhead=tee, color="#d03b3b", style=dashed, tooltip="Active ZFP36L1 degrades SASP cytokine mRNAs; its MK2-dependent inactivation permits their accumulation"];
  "ATP1A1" -> "ION_TRANSPORT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The basolateral sodium pump sustains the electrochemical gradient that drives transepithelial reabsorption."];
  "BAD" -> "CELL_SURVIVAL" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Unphosphorylated BAD neutralises BCL-XL and promotes apoptosis; its AKT-dependent sequestration is one arm of mTORC2-supported survival signalling."];
  "CLCNK" -> "ION_TRANSPORT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="CLC-K channels provide the basolateral chloride exit required for net salt transport."];
  "FOXO1" -> "GLUCONEOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear FOXO1 drives the hepatic gluconeogenic transcriptional programme; AKT-dependent exclusion is how insulin suppresses glucose output."];
  "FOXO1" -> "GLUCONEOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Nuclear FOXO1 drives gluconeogenic gene expression; it is inactivated by AKT once mTORC2 has phosphorylated AKT at Ser473."];
  "GCK" -> "GLYCOLYSIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Glucokinase phosphorylates glucose to glucose-6-phosphate, committing hepatic glucose to glycolytic flux."];
  "MDM2" -> "CELL_SURVIVAL" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="AKT phosphorylates MDM2 and promotes its nuclear translocation, where it drives p53 ubiquitination and degradation, removing p53-dependent apoptotic and cell-cycle-arrest output."];
  "MLXIPL" -> "LIPOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="ChREBP activates glucose-responsive lipogenic transcription in adipocytes."];
  "NEDD4L" -> "SCNN1" [arrowhead=tee, color="#d03b3b", style=solid, label="N-terminal cytoplasmic lysines of the ENaC subunits", tooltip="The WW domains of Nedd4-2 bind PY motifs in the cytoplasmic C-termini of the ENaC subunits, and the ligase conjugates ubiquitin to lysines in their N-terminal tails, driving channel retrieval and degradation and lowering apical sodium conductance."];
  "RAC1" -> "ACTIN_CYTOSKELETON" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rac1·GTP drives branched actin polymerisation in dendritic spines."];
  "RAC1" -> "LTP_LATE_PHASE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rac1-driven actin polymerisation is the structural arm of L-LTP, distinct from the mTORC1-dependent translational arm."];
  "RAC1" -> "PHENO_SPINE_DENSITY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Spine density falls with loss of the mTORC2-Tiam1-Rac1 actin-polymerisation arm."];
  "SCNN1" -> "ION_TRANSPORT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="ENaC provides the rate-limiting apical entry step for sodium reabsorption in the aldosterone-sensitive distal nephron."];
  "SLC2A4" -> "GLUCOSE_UPTAKE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="GLUT4 translocation to the plasma membrane is the proximate step in insulin-stimulated glucose uptake."];
  "TBC1D4" -> "SLC2A4" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="AS160 GAP activity keeps its Rab substrates GDP-loaded and retains GLUT4 vesicles intracellularly until AKT phosphorylation relieves it."];
  "TIAM1" -> "RAC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Tiam1 is a Rac1-specific GEF, loading Rac1 with GTP; GEF polarity is positive."];
  "TIAM1" -> "RAC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Tiam1 is the Rac1 guanine-nucleotide exchange factor through which mTORC2 drives actin polymerisation in the consolidation of long-term memory."];
  "BMAL1" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Rhythmically phosphorylated BMAL1 associates with the cap-binding machinery and promotes cap-dependent translation, which would confer a circadian rhythm on bulk protein synthesis independently of its transcriptional output."];
  "BMAL1" -> "CLOCK_BMAL1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="BMAL1 is the obligate bHLH-PAS partner of CLOCK; the heterodimer is the DNA-binding unit that drives E-box transcription."];
  "BMAL1" -> "EIF4E" [arrowhead=odot, color="#898781", style=solid, tooltip="S6K1-phosphorylated BMAL1 associates with the cap-binding translation machinery, acting as a rhythmic accessory factor at eIF4F rather than only as a transcription factor."];
  "BMAL1" -> "MTORC1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="BMAL1 acts as a negative regulator of mTORC1; Bmal1-null tissues show elevated mTORC1 activity, placing the clock's positive limb upstream of the kinase."];
  "CLOCK" -> "CLOCK_BMAL1" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="CLOCK heterodimerises with BMAL1 through their PAS domains to form the positive-limb transcription factor of the mammalian oscillator."];
  "CLOCK_BMAL1" -> "CRY1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="CLOCK–BMAL1 drives E-box-dependent transcription of Cry1, which then returns to repress the heterodimer — the core delayed negative feedback loop."];
  "CLOCK_BMAL1" -> "DDIT4" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Ddit4 (REDD1), a TSC-dependent inhibitor of mTORC1, is rhythmically expressed in mouse peripheral tissues, offering a candidate transcriptional route from the clock to mTORC1 restraint."];
  "CLOCK_BMAL1" -> "NR1D1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="CLOCK–BMAL1 drives rhythmic transcription of Nr1d1 (Rev-erbα) through E-boxes, initiating the accessory stabilising loop"];
  "CLOCK_BMAL1" -> "PER1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="CLOCK–BMAL1 heterodimer binds E-boxes in the Per1 promoter and drives its rhythmic transcription"];
  "CLOCK_BMAL1" -> "PER2" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="CLOCK–BMAL1 binds E-boxes in the Per2 promoter to drive its rhythmic transcription, generating the PER2 oscillation that times TSC1 recruitment to mTORC1."];
  "CRY1" -> "CLOCK_BMAL1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="CRY1 binds the CLOCK–BMAL1 heterodimer on DNA and blocks its transactivation, closing the negative limb of the feedback loop."];
  "CRY1" -> "PER_CRY_COMPLEX" [arrowhead=none, color="#898781", style=solid, arrowhead=none, tooltip="CRY1 is the repressive subunit of the PER–CRY complex; PER proteins control its nuclear entry and stability"];
  "CSNK1E" -> "PER2" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="CK1ε phosphorylation creates the phosphodegron that targets PER2 for ubiquitin-dependent degradation, shortening PER2 half-life and advancing clock phase"];
  "NR1D1" -> "BMAL1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="REV-ERBα represses Bmal1 transcription through RORE elements, generating the antiphase BMAL1 rhythm that sets the timing of BMAL1-dependent mTORC1 restraint"];
  "PER_CRY_COMPLEX" -> "CLOCK_BMAL1" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="The nuclear PER–CRY complex binds CLOCK–BMAL1 and represses its transactivation, closing the core negative feedback loop"];
  "VIP" -> "PHENO_PHOTIC_ENTRAINMENT" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="VIP-mediated coupling between SCN neurons is required for network synchrony and for normal entrainment of behavioural rhythms to light"];
  "VIP" -> "SCN" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="VIP signalling through VPAC2 receptors is required for synchrony and sustained rhythmicity among SCN neurons; it is the route by which 4E-BP1-dependent translation reaches network behaviour."];
  "ABETA" -> "DISEASE_AD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Progressive accumulation and aggregation of amyloid-beta is a defining neuropathological feature of Alzheimer's disease and is causally sufficient in the autosomal dominant forms caused by APP and presenilin mutations, although its primacy in sporadic disease remains debated; this aggregate burden i"];
  "HTT" -> "DISEASE_HD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Polyglutamine-expanded huntingtin aggregation drives Huntington's disease pathology."];
  "SNCA" -> "DISEASE_PD" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Alpha-synuclein is the aggregating protein of the synucleinopathies and is cleared by macroautophagy and the proteasome, which is the route that mTOR inhibition is intended to engage in Parkinson disease models."];
  "CAP_DEPENDENT_TRANSLATION" -> "PROTEIN_SYNTHESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1-dependent translation is selective (structured-5'UTR and TOP mRNAs) rather than global, so mTORC1 inhibition only partly reduces bulk protein synthesis."];
  "CAP_DEPENDENT_TRANSLATION" -> "SASP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="mTORC1-driven translation of IL1A and MAPKAPK2 mRNAs is required for the senescence-associated secretory phenotype; rapamycin suppresses SASP without clearing senescent cells."];
  "PROTEIN_SYNTHESIS" -> "CELL_GROWTH" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Net protein accumulation from enhanced initiation, elongation and ribosome supply drives increase in cell mass."];
  "RIBOSOME_BIOGENESIS" -> "RIBOSOME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Coordinated rRNA transcription/processing, ribosomal-protein translation and nucleolar assembly produce mature 40S/60S subunits."];
  "AUTOPHAGIC_LYSOSOME_REFORMATION" -> "LYSOSOME" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Autophagic lysosome reformation regenerates the lysosomal pool consumed during autophagy, closing the amino-acid/mTORC1 oscillatory loop."];
  "AUTOPHAGY" -> "AMINO_ACIDS" [arrowhead=vee, color="#898781", style=solid, tooltip="Completed autophagolysosomal degradation replenishes the lysosomal and cytosolic amino-acid pools"];
  "AUTOPHAGY" -> "AMINO_ACIDS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Completed autophagolysosomal degradation of cytoplasmic protein replenishes free amino acid pools"];
  "AUTOPHAGY" -> "MTORC1" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Amino acids liberated by autophagic degradation reactivate mTORC1, making the system oscillatory rather than switch-like, a feature with implications for drug kinetics."];
  "AUTOPHAGY" -> "ABETA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Pharmacological mTOR inhibition induces autophagy and accelerates clearance of amyloid-beta in cellular and animal models."];
  "AUTOPHAGY" -> "HTT" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Polyglutamine-expanded huntingtin is cleared by macroautophagy; rapamycin or CCI-779 reduces aggregates and improves outcomes in model organisms."];
  "AUTOPHAGY" -> "PHENO_BETA_CELL_FAILURE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Suppressed autophagy is one of the two named mechanisms (with ER stress) through which chronic mTORC1 activation produces beta-cell dedifferentiation and failure."];
  "AUTOPHAGY" -> "PHENO_NEURODEGENERATION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Neural-specific deletion of Atg5 or Atg7 alone, with no disease mutant present, causes progressive motor deficits, ubiquitin-positive inclusions and neurodegeneration."];
  "AUTOPHAGY" -> "SNCA" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Alpha-synuclein is degraded by both macroautophagy and the proteasome, and mTOR inhibition with rapamycin lowers its levels in cells and is neuroprotective in cellular and animal models of Parkinson's disease; the fly and mouse aggregate-clearance data obtained with rapamycin and CCI-779 come from p"];
  "CLEAR_NETWORK" -> "AUTOPHAGY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="CLEAR target genes include core autophagy genes, so TFEB activation raises autophagic flux as well as lysosomal capacity"];
  "CLEAR_NETWORK" -> "LYSOSOME_BIOGENESIS" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Coordinate induction of lysosomal hydrolases, membrane proteins and v-ATPase subunits expands lysosomal number and degradative capacity"];
  "PENTOSE_PHOSPHATE_PATHWAY" -> "NADPH" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The oxidative arm of the pentose phosphate pathway, activated by SREBP-driven G6PD expression downstream of mTORC1, generates NADPH."];
  "PENTOSE_PHOSPHATE_PATHWAY" -> "RIBOSE_5_PHOSPHATE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The pentose phosphate pathway generates ribose-5-phosphate, the pentose backbone for nucleotide synthesis."];
  "ACTIN_CYTOSKELETON" -> "LTP_LATE_PHASE" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Actin polymerisation, not translational control, is the mTORC2-dependent requirement for late-phase LTP."];
  "ION_TRANSPORT" -> "PHENO_HYPOTENSION" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="SGK1-driven distal nephron sodium reabsorption sustains extracellular volume and blood pressure; its failure produces salt wasting and hypotension."];
  "LTP_LATE_PHASE" -> "PHENO_LONG_TERM_MEMORY" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Rictor deletion impairs long-term memory alongside L-LTP while sparing short-term memory."];
  "CIRCADIAN_CLOCK" -> "AUTOPHAGY" [arrowhead=odot, color="#898781", style=solid, tooltip="Autophagic and lysosomal flux are under circadian control, so the magnitude of any mTORC1-dependent autophagy readout depends on sampling time — a confounder rarely addressed."];
  "CIRCADIAN_CLOCK" -> "CAP_DEPENDENT_TRANSLATION" [arrowhead=odot, color="#898781", style=solid, tooltip="The clock imposes a daily rhythm on translation initiation and ribosome biogenesis, including rhythmic TOP mRNA translation driven by rhythmic mTORC1–S6K1 activity and by S6K1-phosphorylated BMAL1"];
  "CIRCADIAN_CLOCK" -> "CEBPB" [arrowhead=odot, color="#898781", style=solid, tooltip="Rhythmic expression of C/EBPβ is one clock output that times the hepatic autophagy gene programme"];
  "CIRCADIAN_CLOCK" -> "MTORC1" [arrowhead=odot, color="#898781", style=solid, tooltip="mTORC1 activity is itself rhythmic: PER2-dependent restraint operates in a time-of-day-dependent manner and the response of hepatic mTOR signalling to caloric restriction varies with time of day, so any mTORC1-dependent readout depends on sampling time"];
  "CIRCADIAN_CLOCK" -> "RPS6KB1" [arrowhead=odot, color="#898781", style=solid, label="Thr389", tooltip="S6K1 phosphorylation and downstream ribosome biogenesis oscillate over the day in liver, so mTORC1 output is itself a rhythmic variable rather than a constant baseline."];
  "CIRCADIAN_CLOCK" -> "TFEB" [arrowhead=odot, color="#898781", style=dashed, tooltip="Feeding- and clock-driven rhythms in mTORC1 activity impose a daily rhythm on TFEB/TFE3 nuclear translocation, coupling the lysosomal–autophagic programme to time of day"];
  "DISEASE_GATOR1_EPILEPSY" -> "PHENO_SUDEP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The GATOR1-related familial focal epilepsies account for a substantial proportion of familial focal epilepsy and carry elevated risk of sudden unexpected death in epilepsy."];
  "DISEASE_SKS" -> "PHENO_HYPERACTIVITY" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Hyperactivity reported alongside sleep–wake disturbance and hyperphagia as a recognised feature of the extended Smith–Kingsmore phenotype"];
  "DISEASE_SKS" -> "PHENO_HYPERPHAGIA" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Hyperphagia emerged as a recognised feature in a cohort of 28 individuals carrying nine pathogenic MTOR variants; it is mechanistically expected from hypothalamic mTORC1 nutrient sensing rather than incidental."];
  "DISEASE_SKS" -> "PHENO_SLEEP_WAKE_DISTURBANCE" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="In a cohort of 28 individuals carrying nine pathogenic MTOR variants, sleep–wake disturbance emerged as a recognised feature alongside hyperphagia and hyperactivity."];
  "DISEASE_SKS" -> "PHENO_FOOD_INTAKE" [arrowhead=normal, color="#0ca30c", style=dashed, tooltip="Hyperphagia and hyperactivity are recognised features in a cohort of 28 individuals with nine pathogenic MTOR variants, as hypothalamic nutrient sensing predicts."];
  "DISEASE_FCD2" -> "PHENO_SEIZURES" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Focal cortical dysplasia type II presents with drug-resistant focal epilepsy; management is surgical, with mTOR inhibition investigational."];
  "DISEASE_HME" -> "PHENO_SEIZURES" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Hemimegalencephaly presents with hemispheric enlargement and severe epilepsy."];
  "DISEASE_TSC" -> "PHENO_SEIZURES" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="Epilepsy is a core feature of tuberous sclerosis complex alongside cortical tubers, SEGA, angiomyolipoma and LAM; refractory focal seizures are an approved everolimus indication."];
  "PHENO_ANABOLIC_RESISTANCE" -> "PROTEIN_SYNTHESIS" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Anabolic resistance is defined as a blunted muscle protein-synthesis response to amino acids and to loading; mechanism is multifactorial (reduced sensitivity of the mTORC1 machinery, impaired postprandial perfusion and amino-acid delivery, splanchnic extraction)."];
  "PHENO_CELLULAR_SENESCENCE" -> "SASP" [arrowhead=normal, color="#0ca30c", style=solid, tooltip="The SASP is the secretory programme of senescent cells; the distinction matters because rapamycin suppresses the secretome without removing the cells."];
  "PHENO_IMMUNOSENESCENCE" -> "PHENO_VACCINE_RESPONSE" [arrowhead=tee, color="#d03b3b", style=solid, tooltip="Thymic involution, contraction of the naive repertoire, accumulation of PD-1+ exhausted-like cells and inflammaging together degrade the response to vaccination, which is why vaccine response became the testing ground for geroprotective mTOR inhibition."];
}
