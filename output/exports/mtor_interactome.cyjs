   {
    "data": {
     "source": "MTORC1",
     "target": "PHENO_HEPATIC_STEATOSIS",
     "interaction": "physiological_output",
     "effect": "activates",
     "mechanism": "SREBP1c-dependent lipogenesis driven by hepatic mTORC1 contributes to steatosis when insulin is chronically elevated.",
     "evidence": "established",
     "sites": [],
     "refs": [
      212,
      326,
      677
     ],
     "context": "liver, hyperinsulinaemia",
     "direction": "pathophysiological",
     "notes": "Hepatic mTORC1 is required for insulin-induced SREBP1c and lipogenesis, but mTORC1 activation alone is not sufficient: liver Tsc1 deletion lowers Akt signalling and protects against diet-induced steatosis, so intact Akt signalling, which also suppresses Insig2a, is required alongside it.",
     "module": "tissue_physiology_disease",
     "sign": 1,
     "key": "physiological_output:6f8b0c803c6a256c"
    }
   },
