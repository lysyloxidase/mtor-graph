   {
    "data": {
     "source": "MTORC2",
     "target": "TISSUE_SKELETAL_MUSCLE",
     "interaction": "physiological_output",
     "effect": "modulates",
     "mechanism": "Muscle-specific Rictor deletion is close to phenotypically silent, in contrast to Raptor deletion, which causes dystrophy; the residual mTORC2 contribution is limited to loss of AKT Ser473 phosphorylation and a modest fall in insulin-stimulated glucose uptake.",
     "evidence": "established",
     "sites": [],
     "refs": [
      38
     ],
     "context": "skeletal muscle",
     "direction": "downstream_of_mTORC2",
     "notes": "Negative result, retained because the asymmetry between the complexes in muscle is what predicts the tissue's drug response.",
     "module": "mtorc2_regulation_and_outputs",
     "sign": 0,
     "key": "physiological_output:a9ced558dac8d5e3"
    }
   },
   {
    "data": {
     "source": "MTORC2",
     "target": "TISSUE_T_LYMPHOCYTE",
     "interaction": "physiological_output",
     "effect": "required_for",
     "mechanism": "mTORC2 supports Th2 effector differentiation and AKT-dependent survival in T lymphocytes; with mTORC1 it governs the metabolic reprogramming of effector activation and restrains Treg commitment.",
     "evidence": "established",
     "sites": [],
     "refs": [
      133,
      134
     ],
     "context": null,
     "direction": "downstream_of_mTORC2",
     "notes": null,
