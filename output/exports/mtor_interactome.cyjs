   {
    "data": {
     "source": "ABCB1",
     "target": "RAPAMYCIN",
     "interaction": "transport",
     "effect": "inhibits",
     "mechanism": "P-glycoprotein effluxes sirolimus at the apical membrane of enterocytes, which together with first-pass CYP3A metabolism keeps oral bioavailability low: approximately 14% for the oral solution, with tablet exposure about 27% higher and not bioequivalent to it. The same transporter handling underlies the extensive drug-interaction profile of the drug.",
     "evidence": "established",
     "sites": [],
     "refs": [
      373
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": null,
     "module": "pharmacology",
     "sign": -1,
     "key": "transport:ac584fdc440c698e"
    }
   },
   {
    "data": {
     "source": "ABCB1",
     "target": "TEMSIROLIMUS",
     "interaction": "transport",
     "effect": "inhibits",
     "mechanism": "Temsirolimus and the sirolimus it yields are P-glycoprotein substrates, so efflux limits their distribution into tissues, most consequentially across the blood-brain barrier. Because temsirolimus is administered intravenously, intestinal efflux does not contribute to its systemic exposure.",
     "evidence": "established",
     "sites": [],
     "refs": [
      373
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": null,
     "module": "pharmacology",
     "sign": -1,
     "key": "transport:2e8709e9abee5c93"
    }
   },
   {
    "data": {
