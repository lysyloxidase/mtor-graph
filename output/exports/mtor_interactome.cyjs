     "sites": [],
     "refs": [
      71,
      381,
      573
     ],
     "context": "Alzheimer's disease",
     "direction": "pathophysiological",
     "notes": "In transgenic Alzheimer models, mTOR inhibition lowers brain amyloid-beta and improves cognition when started before substantial pathology has accumulated, and the benefit depends on intact autophagy; no controlled human efficacy data exist.",
     "module": "tissue_physiology_disease",
     "sign": 1,
     "key": "physiological_output:18bdb317a23c56c3"
    }
