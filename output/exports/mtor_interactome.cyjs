   {
    "data": {
     "source": "TORIN1",
     "target": "CAP_DEPENDENT_TRANSLATION",
     "interaction": "drug_inhibition",
     "effect": "inhibits",
     "mechanism": "ATP-competitive occupancy of the mTOR kinase cleft suppresses the rapamycin-resistant 4E-BP1 Thr37/Thr46 sites, so 4E-BP1 remains eIF4E-bound, eIF4F does not assemble, and cap-dependent initiation is blocked far more completely than with rapamycin.",
     "evidence": "established",
     "sites": [],
     "refs": [
      166,
      603,
      604
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": null,
