     ],
     "context": "chronic dosing; cell-type dependent",
     "direction": "pharmacological",
     "notes": "Cell-type variability in mTORC2 sensitivity is itself well replicated.",
     "module": "pharmacology",
     "sign": -1,
     "key": "drug_inhibition:aacf8eca6c992930"
    }
   },
   {
