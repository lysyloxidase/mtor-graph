    }
   },
   {
    "data": {
     "source": "MTORC1",
     "target": "PHENO_MYELINATION",
     "interaction": "physiological_output",
     "effect": "required_for",
     "mechanism": "Oligodendrocyte-lineage Raptor loss delays myelination onset and produces persistent hypomyelination with reduced sheath thickness, regionally worse in spinal cord.",
     "evidence": "established",
     "sites": [],
     "refs": [
      39,
      332
     ],
     "context": "oligodendrocyte lineage (rodent)",
     "direction": "downstream_of_mTORC1",
     "notes": "Established in rodents; effect of chronic low-dose inhibition on adult human white matter unresolved.",
     "module": "tissue_physiology_disease",
     "sign": 1,
     "key": "physiological_output:a4da477b702c13c8"
    }
   },
   {
    "data": {
     "source": "MTORC1",
     "target": "PHENO_PROTEINURIA",
     "interaction": "physiological_output",
     "effect": "modulates",
     "mechanism": "Podocytes require a calibrated level of mTORC1 activity: Raptor deletion in podocytes causes injury and proteinuria, while podocyte Tsc1 deletion causes proteinuric glomerulosclerosis, so both insufficient and excessive activity damage the filtration barrier.",
     "evidence": "established",
     "sites": [],
     "refs": [
      208,
      264
     ],
     "context": "kidney podocyte",
     "direction": "downstream_of_mTORC1",
     "notes": "Both limbs matter clinically: mTOR inhibitors themselves can cause proteinuria, while podocyte mTORC1 activation drives the glomerular lesion of diabetic nephropathy in mice.",
     "module": "tissue_physiology_disease",
     "sign": 0,
     "key": "physiological_output:340e83300586e9f7"
    }
   },
   {
    "data": {
