     "target": "AKT",
     "interaction": "scaffolding",
     "effect": "required_for",
     "mechanism": "mTORC2 selects AKT by distal docking: the basic surface of the AKT kinase N-lobe engages an acidic loop of the mSin1 CRIM domain and the C-lobe a Rictor–mSin1 mooring ~75 Å from the active site; residues flanking Ser473 are dispensable, and prior engagement of pThr450 by the same N-lobe residues builds in a proofreading step.",
     "evidence": "emerging",
     "sites": [],
     "refs": [
      74,
      483,
      597
     ],
     "context": null,
     "direction": "core",
     "notes": "The primary support is the 2025 enzyme-substrate structure [597]; the 'conserved tri-arginine cluster' formulation is inaccurate and should be avoided. The claim rests on this single structural study, with [74,483] as supporting cellular observations.",
     "module": "growth_factor_input",
     "sign": 1,
     "key": "scaffolding:ec425e8ee1ba35bc"
    }
   },
