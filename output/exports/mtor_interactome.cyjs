   {
    "data": {
     "source": "MECHANICAL_LOAD",
     "target": "PLD1",
     "interaction": "other",
     "effect": "activates",
     "mechanism": "Mechanical stretch and eccentric contraction were reported to raise phosphatidic acid in skeletal muscle through phospholipase D, independently of ERK and PI3K; later work from the same laboratory found that phospholipase D activity does not rise with loading and that the mechanically induced phosphatidic acid depends on diacylglycerol kinase zeta.",
     "evidence": "contested",
     "sites": [],
     "refs": [
      241,
      683
     ],
     "context": "skeletal muscle, resistance exercise",
     "direction": "upstream_of_mTORC1",
     "notes": "The phospholipase D and diacylglycerol kinase zeta routes are competing accounts of the same load-induced rise in phosphatidic acid in skeletal muscle.",
     "module": "growth_factor_input",
     "sign": 1,
     "key": "other:0fec69ed6a7b475c"
    }
   },
   {
    "data": {
     "source": "MECHANICAL_LOAD",
     "target": "TSC2",
     "interaction": "other",
     "effect": "inhibits",
     "mechanism": "Eccentric contractions increase TSC2 RxRxxS/T-motif phosphorylation and move TSC2 away from the lysosome while mTOR associates with it; responsible kinase not defined.",
     "evidence": "emerging",
     "sites": [],
     "refs": [
      272
     ],
     "context": "skeletal muscle",
     "direction": "upstream_of_mTORC1",
     "notes": "The mechanistic link between mechanical load and TSC2 relocalisation rests on a single laboratory; phosphatidic acid/PLD and focal-adhesion routes are the alternatives [241,683].",
     "module": "growth_factor_input",
     "sign": -1,
     "key": "other:c45958e3b861f7db"
    }
   },
   {
    "data": {
     "source": "RESISTANCE_EXERCISE",
     "target": "MTORC1",
     "interaction": "other",
     "effect": "activates",
     "mechanism": "Resistance exercise and mechanical overload activate mTORC1 in skeletal muscle, and rapamycin blocks the contraction-induced rise in human muscle protein synthesis. The proximal mechanism involves a rise in phosphatidic acid together with membrane perturbation and focal-adhesion signalling, but the enzyme generating that phosphatidic acid is disputed, with early work implicating phospholipase D and later work diacylglycerol kinase zeta.",
     "evidence": "established",
     "sites": [],
     "refs": [
      149,
      241,
      683
     ],
     "context": "skeletal muscle; resistance exercise",
     "direction": "upstream_of_mTORC1",
     "notes": "The net activation of mTORC1 by loading is reproducible while the proximal lipid step is unsettled; opposite in sign to the endurance-exercise input to AMPK, so exercise modality determines the net effect.",
     "module": "energy_stress_input",
     "sign": 1,
     "key": "other:03004b2b9849f790"
    }
   },
