   {
    "data": {
     "source": "MTORC1",
     "target": "KETOGENESIS",
     "interaction": "physiological_output",
     "effect": "inhibits",
     "mechanism": "Hepatic mTORC1 suppresses fasting-induced ketogenesis by promoting nuclear retention of NCoR1 and thereby inhibiting PPARalpha.",
     "evidence": "established",
     "sites": [],
     "refs": [
      212,
      326,
      542
     ],
     "context": "liver; fasting",
     "direction": "downstream_of_mTORC1",
     "notes": "Hepatic mTORC1 tone rises with age while ketogenic capacity falls, so listing ketogenesis among mTORC1-dependent hepatic outputs without a sign is ambiguous: the primary data show suppression rather than support.",
     "module": "tissue_physiology_disease",
     "sign": -1,
     "key": "physiological_output:29cad5f0c01bec37"
    }
   },
