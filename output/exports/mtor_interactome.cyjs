    "data": {
     "source": "DEPDC5",
     "target": "RAG_HETERODIMER",
     "interaction": "binding",
     "effect": "modulates",
     "mechanism": "DEPDC5 binds GTP-loaded RagA with high affinity in an inhibitory mode that restrains, rather than stimulates, GATOR1-mediated GTP hydrolysis; catalysis is executed through weaker NPRL2-NPRL3 contacts, and the DEPDC5 mode is proposed to keep GATOR1 from becoming hyperactive.",
     "evidence": "emerging",
     "sites": [],
     "refs": [
