     "context": "senescent cells",
     "direction": "downstream_of_mTORC1",
     "notes": "The MK2 route rests on a single study; independent work shows that mTOR also sustains the SASP by promoting IL1A translation.",
     "module": "tissue_physiology_disease",
     "sign": 1,
     "key": "translational_regulation:cb96b015d99d23c1"
