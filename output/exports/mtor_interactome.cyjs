    }
   },
   {
    "data": {
     "source": "TORIN1",
     "target": "EIF4EBP1",
     "interaction": "drug_inhibition",
     "effect": "activates",
     "mechanism": "By occupying the ATP site of mTOR, Torin1 blocks phosphorylation of 4E-BP1 at all four sites, including the priming sites Thr37 and Thr46 that resist rapamycin, and cellular phosphatases then remove the existing phosphates. Hypophosphorylated 4E-BP1 sequesters eIF4E, so the activation of the repressor is indirect, through inhibition of the mTOR kinase.",
     "evidence": "established",
     "sites": [
      "Ser65",
      "Thr37",
      "Thr46",
      "Thr70"
     ],
     "refs": [
      166,
      603
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": "Complete suppression of 4E-BP1 phosphorylation requires catalytic-site rather than allosteric inhibition. Other ATP-competitive mTOR inhibitors act the same way, among them PP242, KU-0063794 and AZD8055; sapanisertib and vistusertib belong to the same class.",
     "module": "mtorc1_output_translation_ribosome",
     "sign": 1,
     "key": "drug_inhibition:bc3539a69fb8934d"
    }
   },
   {
    "data": {
