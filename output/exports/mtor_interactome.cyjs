     "sign": 1,
     "key": "physiological_output:ba8690f14750a2e9"
    }
   },
   {
    "data": {
     "source": "MTORC2",
     "target": "TREG_DIFFERENTIATION",
     "interaction": "physiological_output",
     "effect": "inhibits",
     "mechanism": "Loss of total mTOR kinase activity abrogates Th1, Th2 and Th17 differentiation and favours Foxp3 induction, which underlies the preferential expansion of regulatory T cells under rapamycin; restraint of regulatory T cell differentiation is best documented for the AKT–mTORC1 arm, while deletion of Rictor alone has smaller and less consistent effects.",
     "evidence": "emerging",
     "sites": [],
     "refs": [
      33,
      133,
      134
     ],
     "context": "CD4+ T lymphocyte",
     "direction": "downstream_of_mTORC2",
     "notes": "Both complexes have been reported to restrain regulatory T cell differentiation, but loss of mTORC2 alone can leave suppressive function intact or even improved. This is the one tissue setting in which the consequence of inhibition is the desired therapeutic effect rather than a toxicity.",
     "module": "mtorc2_regulation_and_outputs",
     "sign": -1,
     "key": "physiological_output:ba550e5c21bda1f3"
    }
   },
   {
