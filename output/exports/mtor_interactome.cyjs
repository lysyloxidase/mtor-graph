   {
    "data": {
     "source": "RMC5552",
     "target": "EIF4EBP1",
     "interaction": "drug_inhibition",
     "effect": "activates",
     "mechanism": "RMC-5552 tethers an FKBP12-rapamycin moiety to an ATP-site moiety; FKBP12-mediated avidity confers mTORC1 selectivity while the ATP-site moiety blocks catalysis. Phosphorylation of 4E-BP1 at all four sites, including the rapamycin-resistant priming sites Thr37 and Thr46, is therefore suppressed, and hypophosphorylated 4E-BP1 binds eIF4E. The activation of the repressor is indirect, through inhibition of mTORC1 kinase activity.",
     "evidence": "established",
     "sites": [
      "Ser65",
      "Thr37",
      "Thr46",
      "Thr70"
     ],
     "refs": [
      69,
      339
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": "Whether complete suppression of 4E-BP1 phosphorylation translates into genotype-dependent clinical benefit is not yet established.",
     "module": "mtorc1_output_translation_ribosome",
     "sign": 1,
     "key": "drug_inhibition:bc9f744aa0a490c8"
    }
   },
