     "sites": [],
     "refs": [
      702
     ],
     "context": "microglia",
     "direction": "downstream_of_mTORC1",
     "notes": "both are needed.",
     "module": "tissue_physiology_disease",
     "sign": -1,
     "key": "physiological_output:b7b485eea6f4c539"
    }
   },
