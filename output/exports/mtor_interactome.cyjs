   {
    "data": {
     "source": "HYPOXIA",
     "target": "HIF1A",
     "interaction": "stabilisation",
     "effect": "activates",
     "mechanism": "Low O2 blocks PHD-mediated prolyl hydroxylation of HIF-1alpha; VHL no longer binds, ubiquitination ceases and HIF-1alpha accumulates to drive hypoxia-responsive genes including DDIT4 and BNIP3.",
     "evidence": "established",
     "sites": [
