     "target": "DISEASE_GATOR1_EPILEPSY",
     "interaction": "genetic_loss_of_function",
     "effect": "activates",
     "mechanism": "NPRL3 loss of function causes familial focal epilepsy of the GATOR1 spectrum through unopposed RagA/B-GTP loading and mTORC1 hyperactivity in the cortical lesion. Responses to add-on everolimus have differed between series: the single NPRL3 patient in the first case series worsened, whereas all four patients in a later NPRL2- and NPRL3-related series improved, two of them becoming seizure-free.",
     "evidence": "established",
     "sites": [],
     "refs": [
      22,
      84,
      417,
      494
     ],
     "context": "germline heterozygous",
     "direction": "pathophysiological",
     "notes": "The small open-label series do not establish NPRL3 genotype as a predictor of everolimus failure, and a controlled trial is required before mTOR inhibition becomes standard practice.",
     "module": "lysosomal_nutrient_sensing",
     "sign": 1,
     "key": "genetic_loss_of_function:6e44db045cac88a3"
    }
   },
