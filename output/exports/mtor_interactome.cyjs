    }
   },
   {
    "data": {
     "source": "CYP3A4",
     "target": "RAPAMYCIN",
     "interaction": "metabolic_conversion",
     "effect": "inhibits",
     "mechanism": "CYP3A4 in gut and liver demethylates and hydroxylates sirolimus, so CYP3A4 inducers and inhibitors shift its exposure several-fold; whole-blood trough monitoring, commonly in the range of 5-15 ng/mL in transplantation, is therefore standard.",
     "evidence": "established",
     "sites": [],
     "refs": [
      373
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": null,
     "module": "pharmacology",
     "sign": -1,
     "key": "metabolic_conversion:836c4dd3aa372865"
    }
   },
   {
    "data": {
     "source": "CYP3A4",
     "target": "TEMSIROLIMUS",
     "interaction": "metabolic_conversion",
     "effect": "inhibits",
     "mechanism": "Temsirolimus is cleared principally by hepatic CYP3A4, which hydroxylates and demethylates it, so CYP3A4 inhibitors and inducers markedly alter its exposure. The drug is given intravenously, so no intestinal first-pass step contributes, and its principal active metabolite sirolimus arises by hydrolysis of the temsirolimus ester rather than by CYP3A4.",
     "evidence": "established",
     "sites": [],
     "refs": [
      373,
      564
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": null,
     "module": "pharmacology",
     "sign": -1,
     "key": "metabolic_conversion:b66b770de485d2c3"
    }
   },
