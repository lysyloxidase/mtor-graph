   {
    "data": {
     "source": "EXERCISE",
     "target": "ENERGY_STRESS",
     "interaction": "other",
     "effect": "activates",
     "mechanism": "Muscle contraction consumes ATP faster than oxidative phosphorylation replenishes it, so ADP and, through adenylate kinase, AMP rise, and this energy-stress state activates AMPK in proportion to exercise intensity.",
     "evidence": "established",
     "sites": [],
     "refs": [
      654
     ],
     "context": "skeletal muscle contraction",
     "direction": "upstream_of_mTORC1",
