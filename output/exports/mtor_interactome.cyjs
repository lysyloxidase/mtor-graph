   {
    "data": {
     "source": "RAPAMYCIN",
     "target": "CAP_DEPENDENT_TRANSLATION",
     "interaction": "drug_inhibition",
     "effect": "inhibits",
     "mechanism": "Rapalogs suppress cap-dependent translation only partially. With FKBP12-rapamycin bound to the FRB domain, phosphorylation of 4E-BP1 at Ser65 and Thr70 is blocked while Thr37 and Thr46 remain largely phosphorylated, so eIF4F assembly continues at a substantial rate. The limitation is structural rather than a matter of dose.",
     "evidence": "established",
     "sites": [],
     "refs": [
      40,
      70,
      166,
      603
     ],
     "context": "rapalog exposure",
     "direction": "pharmacological",
     "notes": "ATP-competitive and bi-steric inhibitors suppress cap-dependent translation far more completely.",
     "module": "mtorc1_output_translation_ribosome",
     "sign": -1,
     "key": "drug_inhibition:6455d8a24b6b8557"
    }
   },
   {
    "data": {
     "source": "RAPAMYCIN",
     "target": "EIF4EBP1",
     "interaction": "drug_inhibition",
     "effect": "activates",
     "mechanism": "Rapamycin blocks phosphorylation of the late 4E-BP1 sites Ser65 and Thr70 while largely sparing the priming sites Thr37 and Thr46, so binding of 4E-BP1 to eIF4E is only partly restored and cap-dependent translation continues. The limitation is structural rather than a matter of dose.",
     "evidence": "established",
     "sites": [
      "Ser65",
      "Thr70"
     ],
     "refs": [
      40,
      70,
      111,
      166,
      603
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": "The degree of resistance varies with cell type, and 4E-BP1 phosphorylation can recover during prolonged exposure.",
     "module": "mtorc1_output_translation_ribosome",
     "sign": 1,
     "key": "drug_inhibition:ab7b2d8963cd5d11"
    }
   },
   {
    "data": {
     "source": "RAPAMYCIN",
     "target": "EIF4EBP1",
     "interaction": "drug_inhibition",
     "effect": "modulates",
     "mechanism": "Thr37/Thr46 phosphorylation is relatively rapamycin-resistant in many experimental settings, limiting restoration of 4E-BP1-mediated repression of eIF4E.",
     "evidence": "established",
     "sites": [
      "Thr37",
      "Thr46"
     ],
     "refs": [
      40,
      70,
      193,
      603
     ],
     "context": "rapamycin-resistant sites",
     "direction": "downstream_of_mTORC1",
     "notes": "Phosphosite sensitivity and the resulting translational response depend on cell type and exposure.",
     "module": "pharmacology",
     "sign": 0,
     "key": "drug_inhibition:f28da82e90ab7ad9"
    }
   },
   {
    "data": {
     "source": "RAPAMYCIN",
     "target": "RIBOSOME_BIOGENESIS",
     "interaction": "drug_inhibition",
     "effect": "inhibits",
     "mechanism": "Rapamycin lowers activating Ser44 phosphorylation of TIF-IA/RRN3 and raises the inhibitory Ser199 site, blocks the S6K1-dependent phosphorylation of the UBF carboxy-terminal activation domain, and relieves mTORC1 repression of MAF1 — collapsing Pol I 47S pre-rRNA synthesis and Pol III tRNA/5S output together.",
     "evidence": "established",
     "sites": [],
     "refs": [
      214,
      255,
      400,
      401,
      409,
      410,
      565
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": "Rapamycin acts on both polymerase arms: phosphorylation of TIF-IA and of the UBF carboxy-terminal activation domain falls rapidly, while MAF1 escapes mTORC1-dependent inactivation and continues to repress RNA polymerase III.",
     "module": "mtorc1_output_translation_ribosome",
     "sign": -1,
     "key": "drug_inhibition:e05549f5d9a673f7"
    }
   },
   {
    "data": {
     "source": "RAPAMYCIN",
     "target": "RPS6KB1",
     "interaction": "drug_inhibition",
     "effect": "inhibits",
     "mechanism": "FKBP12-rapamycin bound to the mTORC1 FRB domain abolishes S6K1 Thr389 phosphorylation completely, in contrast to its partial effect on 4E-BP1. This makes Thr389 the pharmacodynamic marker of mTORC1 engagement and the readout against which partial pathway inhibition is judged in dosing studies.",
     "evidence": "established",
     "sites": [
      "Thr389"
     ],
     "refs": [
      111,
      166,
      603
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": null,
     "module": "mtorc1_output_translation_ribosome",
     "sign": -1,
     "key": "drug_inhibition:964e8ad5afbc9028"
    }
   },
   {
    "data": {
     "source": "RAPAMYCIN",
     "target": "MTORC2",
     "interaction": "drug_inhibition",
     "effect": "inhibits",
     "mechanism": "Prolonged rapamycin exposure inhibits mTORC2 because FKBP12–rapamycin captures newly synthesised mTOR before assembly; mTORC1 selectivity is kinetic, not absolute.",
