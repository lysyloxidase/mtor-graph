   {
    "data": {
     "source": "MTORC1",
     "target": "PHENO_MALADAPTIVE_REMODELLING",
     "interaction": "physiological_output",
     "effect": "activates",
     "mechanism": "Sustained mTORC1 activity contributes to maladaptive cardiac remodelling, in contrast to the physiological hypertrophy the same complex supports, and partial inhibition attenuates pathological hypertrophy in several models.",
     "evidence": "established",
     "sites": [],
     "refs": [
      405,
      538
     ],
     "context": "cardiomyocyte",
     "direction": "downstream_of_mTORC1",
     "notes": "Cardiac mTOR also has protective roles, including after ischaemic injury, so the maladaptive arm is dose- and context-dependent rather than a uniform property of mTORC1 activity.",
     "module": "tissue_physiology_disease",
     "sign": 1,
     "key": "physiological_output:96bf7004bdac3407"
    }
   },
