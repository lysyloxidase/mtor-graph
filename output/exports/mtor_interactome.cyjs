    }
   },
   {
    "data": {
     "source": "ABCB1",
     "target": "PHENO_CNS_DRUG_EXPOSURE",
     "interaction": "transport",
     "effect": "inhibits",
     "mechanism": "Efflux at the blood-brain barrier shields the CNS from systemic exposure but equally limits target engagement wherever the brain is the therapeutic object, decoupling central from peripheral exposure.",
     "evidence": "established",
     "sites": [],
     "refs": [
      594
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": "A dose titrated to a peripheral marker such as whole-blood S6K1 phosphorylation is not thereby titrated in brain.",
     "module": "pharmacology",
     "sign": -1,
     "key": "transport:a41a437415b0a4f1"
    }
   },
   {
    "data": {
     "source": "ABCB1",
     "target": "RAPAMYCIN",
     "interaction": "transport",
     "effect": "inhibits",
     "mechanism": "Sirolimus is an ABCB1 substrate, so central and peripheral exposure-response relationships cannot be assumed to coincide; a dose titrated to whole-blood S6K1 phosphorylation is not thereby titrated in brain.",
     "evidence": "established",
     "sites": [],
     "refs": [
      594
     ],
     "context": "blood-brain barrier",
     "direction": "pharmacological",
     "notes": null,
