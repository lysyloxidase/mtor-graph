   {
    "data": {
     "source": "TORIN2",
     "target": "MTOR",
     "interaction": "competitive_inhibition",
     "effect": "inhibits",
     "mechanism": "Torin2 occupies the mTOR ATP-binding cleft and inhibits both complexes, including the rapamycin-resistant 4E-BP1 sites. It is more potent and more orally bioavailable than Torin1 but also inhibits the related PIKK family members ATM, ATR and DNA-PK, so selectivity for mTOR is incomplete at higher concentrations.",
     "evidence": "established",
     "sites": [],
     "refs": [
      166,
      358,
      603
     ],
     "context": null,
     "direction": "pharmacological",
     "notes": "Used as a laboratory tool compound rather than a clinical agent.",
     "module": "pharmacology",
     "sign": -1,
     "key": "competitive_inhibition:0bc29deeb3499ee5"
    }
   },
   {
    "data": {
     "source": "VAR_FRB_RESISTANCE",
     "target": "FRB_DOMAIN",
     "interaction": "genetic_loss_of_function",
     "effect": "inhibits",
     "mechanism": "Substitution of the critical serine contact in the FRB domain of human mTOR, Ser2035, abolishes docking of the FKBP12-rapamycin complex while leaving kinase activity intact. FRB substitutions selected under prolonged rapamycin exposure, Ala2034Val and Phe2108Leu, confer rapalog resistance by the same route, whereas the kinase-domain substitution Met2327Ile confers resistance to ATP-competitive inhibitors without preventing drug docking.",
     "evidence": "established",
     "sites": [
      "Ser2035"
     ],
     "refs": [
      98,
      365,
      501
     ],
     "context": "acquired and engineered rapamycin resistance",
     "direction": "pharmacological",
     "notes": "Bivalent agents that engage the FRB and the ATP site together retain activity against these substitutions.",
     "module": "pharmacology",
     "sign": -1,
     "key": "genetic_loss_of_function:3453387e35fc20b2"
    }
   },
