   {
    "data": {
     "source": "EIF4EBP2",
     "target": "LTP_LATE_PHASE",
     "interaction": "translational_regulation",
     "effect": "modulates",
     "mechanism": "4E-BP2 represses cap-dependent translation at the synapse: in its absence a single train that normally yields only early-phase potentiation induces late-phase LTP, so the induction threshold falls, yet late-phase LTP elicited by repeated high-frequency trains is impaired and hippocampus-dependent memory is deficient. Both excessive and deficient translational signalling are deleterious in brain.",
     "evidence": "established",
     "sites": [],
     "refs": [
      26
     ],
     "context": "forebrain neuron",
     "direction": "downstream_of_mTORC1",
     "notes": "The lowered threshold for late-phase LTP in 4E-BP2-null hippocampus coexists with impaired late-phase LTP after strong stimulation and with deficient hippocampus-dependent memory.",
     "module": "tissue_physiology_disease",
     "sign": 0,
     "key": "translational_regulation:21e1cb9f8414f1d9"
    }
   },
   {
    "data": {
     "source": "EIF4EBP2",
     "target": "PHENO_AUTISM_LIKE_BEHAVIOUR",
     "interaction": "translational_regulation",
     "effect": "inhibits",
     "mechanism": "Loss of the translational repressor 4E-BP2 produces autism-like behaviour with an increased excitation-to-inhibition ratio, the upper arm of the neuronal requirement for calibrated translational signalling; the accompanying synaptic phenotype is a lowered threshold for late-phase LTP rather than uniformly enhanced potentiation.",
     "evidence": "established",
     "sites": [],
     "refs": [
      195
     ],
     "context": "CNS neuron",
