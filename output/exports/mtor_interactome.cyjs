   },
   {
    "data": {
     "source": "CYP3A4",
     "target": "PHENO_CNS_DRUG_EXPOSURE",
     "interaction": "metabolic_conversion",
     "effect": "inhibits",
     "mechanism": "In mice, CYP3A acts together with plasma carboxylesterase to clear everolimus systemically and so sets the blood concentration from which central exposure derives; restriction of brain penetration itself is attributed chiefly to P-glycoprotein at the blood-brain barrier.",
     "evidence": "emerging",
     "sites": [],
     "refs": [
