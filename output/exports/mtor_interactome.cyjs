     "interaction": "transport",
     "effect": "inhibits",
     "mechanism": "Sirolimus and everolimus are ABCB1 substrates; brain accumulation of everolimus rises when the transporter is absent or pharmacologically inhibited.",
     "evidence": "established",
     "sites": [],
     "refs": [
      594
     ],
     "context": "blood-brain barrier",
     "direction": "pharmacological",
     "notes": "Shields CNS from systemic exposure but limits efficacy wherever CNS target engagement is the object.",
