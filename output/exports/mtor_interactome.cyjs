     "target": "EVEROLIMUS",
     "interaction": "metabolic_conversion",
     "effect": "inhibits",
     "mechanism": "Everolimus is likewise a CYP3A4 substrate, giving extensive interaction potential with azoles, macrolides, rifampicin and anticonvulsants and requiring exposure-guided dosing.",
     "evidence": "established",
     "sites": [],
     "refs": [
