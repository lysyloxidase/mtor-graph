   {
    "data": {
     "source": "MTORC1",
     "target": "PHENO_MUSCLE_HYPERTROPHY",
     "interaction": "physiological_output",
     "effect": "activates",
     "mechanism": "mTORC1 activity is required for load-induced hypertrophy: rapamycin blocks the hypertrophic response to IGF-1, mechanical overload and chronic stimulation. Sustained mTORC1 activation is not by itself sufficient, since constitutive activation by Tsc1 deletion in muscle fails to produce hypertrophy and instead causes a late-onset myopathy with blocked autophagy.",
     "evidence": "established",
     "sites": [],
     "refs": [
      50
     ],
     "context": "skeletal muscle",
     "direction": "pathophysiological",
     "notes": null,
     "module": "tissue_physiology_disease",
