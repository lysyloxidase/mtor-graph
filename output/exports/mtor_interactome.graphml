<key id="d16" for="edge" attr.name="refs" attr.type="string"/>
<key id="d15" for="edge" attr.name="sites" attr.type="string"/>
<key id="d14" for="edge" attr.name="evidence" attr.type="string"/>
<key id="d13" for="edge" attr.name="mechanism" attr.type="string"/>
<key id="d12" for="edge" attr.name="effect" attr.type="string"/>
<key id="d11" for="edge" attr.name="interaction" attr.type="string"/>
<key id="d10" for="edge" attr.name="target" attr.type="string"/>
<key id="d9" for="edge" attr.name="source" attr.type="string"/>
<key id="d8" for="node" attr.name="aliases" attr.type="string"/>
<key id="d7" for="node" attr.name="gene" attr.type="string"/>
<key id="d6" for="node" attr.name="description" attr.type="string"/>
<key id="d5" for="node" attr.name="layer" attr.type="long"/>
<key id="d4" for="node" attr.name="module" attr.type="string"/>
<key id="d3" for="node" attr.name="type" attr.type="string"/>
<key id="d2" for="node" attr.name="label" attr.type="string"/>
<key id="d1" for="node" attr.name="id" attr.type="string"/>
<key id="d0" for="graph" attr.name="name" attr.type="string"/>
<graph edgedefault="directed"><data key="d0">mTOR signalling interactome</data>
<node id="AKG">
  <data key="d1">AKG</data>
  <data key="d2">alpha-Ketoglutarate</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">TCA-cycle intermediate produced by glutaminolysis; promotes GTP loading of RagB and lysosomal mTORC1 translocation, reportedly through prolyl hydroxylase activity.</data>
  <data key="d7"></data>
  <data key="d8">2-oxoglutarate; aKG</data>
</node>
<node id="AMINO_ACIDS">
  <data key="d1">AMINO_ACIDS</data>
  <data key="d2">Amino acids (pool)</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Products of autophagolysosomal protein degradation that replenish lysosomal and cytosolic pools and reactivate mTORC1, making the autophagy-mTORC1 system oscillatory rather than switch-like.</data>
  <data key="d7"></data>
  <data key="d8">AA; amino acid sufficiency</data>
</node>
<node id="AMINO_ACID_STARVATION">
  <data key="d1">AMINO_ACID_STARVATION</data>
  <data key="d2">Amino-acid starvation</data>
  <data key="d3">stimulus</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Deprivation of one or more amino acids; beyond Rag/GATOR sensing it activates GCN2 via uncharged tRNA, driving ATF4-dependent Sestrin2 induction that sustains mTORC1 suppression.</data>
  <data key="d7"></data>
  <data key="d8">amino-acid deprivation</data>
</node>
<node id="ARGININE">
  <data key="d1">ARGININE</data>
  <data key="d2">Arginine</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Amino acid sensed in the cytosol by CASTOR1 and in the lysosomal lumen by SLC38A9; both routes converge on the Rag heterodimer.</data>
  <data key="d7"></data>
  <data key="d8">Arg; L-arginine</data>
</node>
<node id="CHOLESTEROL">
  <data key="d1">CHOLESTEROL</data>
  <data key="d2">Cholesterol (lysosomal)</data>
  <data key="d3">lipid</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Lysosomal sterol pool that activates mTORC1 through an SLC38A9-NPC1 signalling complex; this arm is an emerging mechanism.</data>
  <data key="d7"></data>
  <data key="d8">lysosomal cholesterol</data>
</node>
<node id="GDP">
  <data key="d1">GDP</data>
  <data key="d2">GDP</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Guanine nucleotide whose binding to RagC/D is required for the active, mTORC1-recruiting configuration of the Rag heterodimer.</data>
  <data key="d7"></data>
  <data key="d8">guanosine diphosphate</data>
</node>
<node id="GLUTAMINE">
  <data key="d1">GLUTAMINE</data>
  <data key="d2">Glutamine</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Most abundant free amino acid; signals to mTORC1 both through Rag-independent Arf1-dependent routes and through glutaminolytic production of alpha-ketoglutarate.</data>
  <data key="d7"></data>
  <data key="d8">Gln; L-glutamine</data>
</node>
<node id="GTP">
  <data key="d1">GTP</data>
  <data key="d2">GTP</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Guanine nucleotide whose binding to RagA/B produces the Raptor-binding competent state of the heterodimer.</data>
  <data key="d7"></data>
  <data key="d8">guanosine triphosphate</data>
</node>
<node id="LEUCINE">
  <data key="d1">LEUCINE</data>
  <data key="d2">Leucine</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Branched-chain essential amino acid and the most potent single amino-acid activator of mTORC1; the ligand at the centre of the competing Sestrin2, LARS1, SAR1B and lysosomal-efflux sensing models.</data>
  <data key="d7"></data>
  <data key="d8">L-leucine; Leu</data>
</node>
<node id="METHIONINE">
  <data key="d1">METHIONINE</data>
  <data key="d2">Methionine</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Essential amino acid and a well-established longevity-modifying dietary variable; signals to mTORC1 indirectly through its conversion to S-adenosylmethionine.</data>
  <data key="d7"></data>
  <data key="d8">L-methionine; Met</data>
</node>
<node id="SAM">
  <data key="d1">SAM</data>
  <data key="d2">S-adenosylmethionine</data>
  <data key="d3">metabolite</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Universal methyl donor whose cellular concentration tracks methionine availability; the direct ligand of SAMTOR.</data>
  <data key="d7"></data>
  <data key="d8">AdoMet; SAM</data>
</node>
<node id="VAR_NPRL2_LOF">
  <data key="d1">VAR_NPRL2_LOF</data>
  <data key="d2">NPRL2 loss-of-function variants</data>
  <data key="d3">gene_variant</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">0</data>
  <data key="d6">Loss-of-function NPRL2 variants removing the catalytic arginine-finger subunit of GATOR1, causing GATOR1-related focal epilepsy with cortical dysplasia.</data>
  <data key="d7">NPRL2</data>
  <data key="d8"></data>
</node>
<node id="ANDROGEN">
  <data key="d1">ANDROGEN</data>
  <data key="d2">Androgens</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Testosterone/DHT; via the androgen receptor increase mTORC1 activity in prostate cancer cells; AR and PI3K–AKT are reciprocally cross-regulated in PTEN-deficient prostate cancer.</data>
  <data key="d7"></data>
  <data key="d8">DHT; testosterone</data>
</node>
<node id="ESTROGEN">
  <data key="d1">ESTROGEN</data>
  <data key="d2">Estrogen (17β-estradiol)</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Steroid hormone; via ERα engages non-genomic PI3K–AKT signalling and promotes survival/metastasis of TSC2-null cells (relevant to lymphangioleiomyomatosis).</data>
  <data key="d7"></data>
  <data key="d8">17β-estradiol; E2</data>
</node>
<node id="IGF1">
  <data key="d1">IGF1</data>
  <data key="d2">IGF-1</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Insulin-like growth factor 1; growth-hormone-dependent ligand of IGF-1R that activates PI3K–AKT and mTORC1 (muscle hypertrophy, growth).</data>
  <data key="d7">IGF1</data>
  <data key="d8">insulin-like growth factor 1</data>
</node>
<node id="INFLAMMATION">
  <data key="d1">INFLAMMATION</data>
  <data key="d2">Chronic inflammation</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Inflammatory (NF-κB-axis) signalling that activates IKKβ, suppressing TSC1 and raising mTORC1 activity; proposed link between inflammation and anabolic dysregulation of ageing tissue.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="INSULIN">
  <data key="d1">INSULIN</data>
  <data key="d2">Insulin</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Pancreatic β-cell peptide hormone; principal physiological ligand of INSR, driving IRS–PI3K–AKT signalling to TSC2/PRAS40 and thus mTORC1.</data>
  <data key="d7">INS</data>
  <data key="d8">INS</data>
</node>
<node id="LEPTIN">
  <data key="d1">LEPTIN</data>
  <data key="d2">Leptin</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Adipose-derived satiety hormone whose anorectic action requires intact hypothalamic mTOR signalling.</data>
  <data key="d7">LEP</data>
  <data key="d8"></data>
</node>
<node id="MECHANICAL_LOAD">
  <data key="d1">MECHANICAL_LOAD</data>
  <data key="d2">Mechanical load</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Resistance exercise / eccentric contraction / stretch; activates mTORC1 in muscle through PLD–PA, membrane perturbation and focal-adhesion signalling, largely independently of ERK and PI3K.</data>
  <data key="d7"></data>
  <data key="d8">mechanical overload; resistance exercise</data>
</node>
<node id="RESISTANCE_EXERCISE">
  <data key="d1">RESISTANCE_EXERCISE</data>
  <data key="d2">Resistance exercise / mechanical overload</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Mechanical loading of skeletal muscle (resistance exercise, overload, chronic stimulation) that activates mTORC1 through phospholipase D-derived phosphatidic acid, membrane perturbation and focal adhesion signalling.</data>
  <data key="d7"></data>
  <data key="d8">mechanical overload; resistance training</data>
</node>
<node id="TNF">
  <data key="d1">TNF</data>
  <data key="d2">TNFα</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Inflammatory cytokine that activates IKK-beta, which phosphorylates and suppresses TSC1, raising mTORC1 output; a molecular link between chronic inflammation and anabolic dysregulation.</data>
  <data key="d7">TNF</data>
  <data key="d8">TNF-α; tumour necrosis factor</data>
</node>
<node id="VAR_TBC1D7_LOF">
  <data key="d1">VAR_TBC1D7_LOF</data>
  <data key="d2">TBC1D7 loss of function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Biallelic truncating TBC1D7 variants causing macrocephaly/megalencephaly with intellectual disability and elevated mTORC1 signalling in patient cells.</data>
  <data key="d7">TBC1D7</data>
  <data key="d8"></data>
</node>
<node id="WNT">
  <data key="d1">WNT</data>
  <data key="d2">Wnt ligands</data>
  <data key="d3">stimulus</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">0</data>
  <data key="d6">Canonical Wnt signalling inhibits GSK3, removing GSK3-dependent activation of TSC2 and thereby stimulating mTORC1 independently of β-catenin.</data>
  <data key="d7"></data>
  <data key="d8">Wnt</data>
</node>
<node id="A769662">
  <data key="d1">A769662</data>
  <data key="d2">A-769662</data>
  <data key="d3">drug</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Thienopyridone direct AMPK activator binding the ADaM site at the alpha-kinase/beta-CBM interface; beta1-selective; allosterically activates AMPK and protects Thr172 from dephosphorylation.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="ADP">
  <data key="d1">ADP</data>
  <data key="d2">ADP</data>
  <data key="d3">metabolite</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Adenosine diphosphate; binds AMPK gamma CBS sites and protects pThr172 from dephosphorylation without allosteric activation; physiologically relevant because cellular ADP exceeds AMP.</data>
  <data key="d7"></data>
  <data key="d8">adenosine diphosphate</data>
</node>
<node id="AICAR">
  <data key="d1">AICAR</data>
  <data key="d2">AICAR (acadesine)</data>
  <data key="d3">drug</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Cell-permeable nucleoside converted to ZMP, an AMP mimetic that binds AMPK gamma and activates AMPK; classical experimental AMPK activator with known off-target effects.</data>
  <data key="d7"></data>
  <data key="d8">ZMP precursor; acadesine</data>
</node>
<node id="AMP">
  <data key="d1">AMP</data>
  <data key="d2">AMP</data>
  <data key="d3">metabolite</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Adenosine monophosphate; rises disproportionately when ATP falls (adenylate kinase equilibrium) and is the primary low-energy signal that allosterically activates AMPK and promotes net Thr172 phosphorylation.</data>
  <data key="d7"></data>
  <data key="d8">adenosine monophosphate</data>
</node>
<node id="ATP">
  <data key="d1">ATP</data>
  <data key="d2">ATP</data>
  <data key="d3">metabolite</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Adenosine triphosphate; competes with AMP/ADP for AMPK gamma nucleotide sites, keeping AMPK inactive when energy charge is high.</data>
  <data key="d7"></data>
  <data key="d8">adenosine triphosphate</data>
</node>
<node id="CALCIUM">
  <data key="d1">CALCIUM</data>
  <data key="d2">Ca2+ (cytosolic calcium)</data>
  <data key="d3">metabolite</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Lysosomal calcium released through TRPML1 into a local microdomain, activating calcineurin adjacent to the lysosomal surface.</data>
  <data key="d7"></data>
  <data key="d8">Ca2+/CaM; calcium</data>
</node>
<node id="CALORIC_RESTRICTION">
  <data key="d1">CALORIC_RESTRICTION</data>
  <data key="d2">Caloric restriction</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Sustained reduction in energy intake that lowers mTORC1 signalling; its effect on hepatic mTOR signalling is time-of-day dependent, so feeding schedule confounds comparison between dietary-restriction studies.</data>
  <data key="d7"></data>
  <data key="d8">CR; dietary restriction</data>
</node>
<node id="DNA_DAMAGE">
  <data key="d1">DNA_DAMAGE</data>
  <data key="d2">DNA damage</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Genotoxic stress (ionising radiation, etoposide, ROS) activating ATM/ATR-CHK2 and p53; p53 transcriptional targets (sestrins, REDD1, PTEN, TSC2, AMPK beta1) collectively suppress mTORC1.</data>
  <data key="d7"></data>
  <data key="d8">genotoxic stress</data>
</node>
<node id="ENERGY_STRESS">
  <data key="d1">ENERGY_STRESS</data>
  <data key="d2">Energy stress (high AMP/ATP)</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Any state in which ATP consumption exceeds production (glucose deprivation, hypoxia, mitochondrial inhibition, exercise), raising AMP/ADP:ATP and engaging the LKB1-AMPK checkpoint on mTORC1.</data>
  <data key="d7"></data>
  <data key="d8">low energy charge; metabolic stress</data>
</node>
<node id="ER_STRESS">
  <data key="d1">ER_STRESS</data>
  <data key="d2">ER stress (unfolded protein response)</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Endoplasmic-reticulum stress; one of the two mechanisms (with suppressed autophagy) by which chronic mTORC1 hyperactivation drives beta-cell dedifferentiation and failure.</data>
  <data key="d7"></data>
  <data key="d8">UPR; unfolded protein response</data>
</node>
<node id="EXERCISE">
  <data key="d1">EXERCISE</data>
  <data key="d2">Exercise</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Physical activity; endurance/contractile activity activates muscle AMPK (energy turnover), while resistance loading activates muscle mTORC1 through phosphatidic acid and mechanotransduction - opposite inputs by modality.</data>
  <data key="d7"></data>
  <data key="d8">physical activity</data>
</node>
<node id="FBP">
  <data key="d1">FBP</data>
  <data key="d2">Fructose-1,6-bisphosphate</data>
  <data key="d3">metabolite</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Glycolytic intermediate whose concentration reports glucose availability. FBP occupancy of aldolase prevents the apo-aldolase conformation that nucleates the lysosomal v-ATPase–Ragulator–AXIN–LKB1 platform, so falling FBP activates AMPK before any change in the AMP:ATP ratio.</data>
  <data key="d7"></data>
  <data key="d8">FBP; fructose 1,6-bisphosphate</data>
</node>
<node id="GLUCOSE">
  <data key="d1">GLUCOSE</data>
  <data key="d2">Glucose</data>
  <data key="d3">metabolite</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Principal energy substrate; glucose sufficiency is relayed to mTORC1 through Rag GTPases (largely AMPK-independent, DHAP proposed as the sensed glycolytic intermediate) and keeps AMPK inactive by sustaining ATP and FBP.</data>
  <data key="d7"></data>
  <data key="d8">D-glucose</data>
</node>
<node id="GLUCOSE_DEPRIVATION">
  <data key="d1">GLUCOSE_DEPRIVATION</data>
  <data key="d2">Glucose deprivation</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Glucose withdrawal; activates AMPK through AMP/ADP rise and through an AMP-independent aldolase-FBP route at the lysosome, inhibits mTORC1 via Rag GTPases and HK2-Raptor binding, and induces REDD1 via ATF4.</data>
  <data key="d7"></data>
  <data key="d8">glucose starvation; low glucose</data>
</node>
<node id="GLYCOGEN">
  <data key="d1">GLYCOGEN</data>
  <data key="d2">Glycogen</data>
  <data key="d3">metabolite</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Storage polysaccharide sensed directly by the carbohydrate-binding module of the AMPK β-subunit; branched glycogen with single α-1,6 branch points inhibits AMPK, coupling cellular carbohydrate reserves to the energy-sensing arm upstream of mTORC1.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="HYPOXIA">
  <data key="d1">HYPOXIA</data>
  <data key="d2">Hypoxia</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Low oxygen tension; inhibits mTORC1 through HIF-1-driven REDD1 induction and TSC activation, through AMPK activation secondary to falling ATP, and through BNIP3-Rheb binding.</data>
  <data key="d7"></data>
  <data key="d8">low oxygen</data>
</node>
<node id="OXIDATIVE_STRESS">
  <data key="d1">OXIDATIVE_STRESS</data>
  <data key="d2">Oxidative stress (ROS)</data>
  <data key="d3">stimulus</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Reactive oxygen species (H2O2, mitochondrial ROS); activate cytoplasmic ATM-LKB1-AMPK, a peroxisomal TSC pool and AMPK (directly or via ATP depletion), collectively repressing mTORC1 and inducing autophagy.</data>
  <data key="d7"></data>
  <data key="d8">H2O2; ROS</data>
</node>
<node id="VAR_STRADA_LOF">
  <data key="d1">VAR_STRADA_LOF</data>
  <data key="d2">STRADA biallelic loss of function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">0</data>
  <data key="d6">Homozygous 7-kb LYK5/STRADA deletion (Old Order Mennonite founder) or other biallelic loss; impairs LKB1-AMPK signalling and causes PMSE syndrome with neuronal mTORC1 hyperactivation.</data>
  <data key="d7">STRADA</data>
  <data key="d8">LYK5; LYK5 deletion</data>
</node>
<node id="LYSOSOMAL_STRESS">
  <data key="d1">LYSOSOMAL_STRESS</data>
  <data key="d2">Lysosomal stress</data>
  <data key="d3">stimulus</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">0</data>
  <data key="d6">Lysosomal damage or stress that triggers TRPML1-mediated local calcium release and calcineurin-dependent TFEB dephosphorylation. Together with mTORC1 inhibition, it is a trigger of TFEB nuclear entry.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="LIGHT">
  <data key="d1">LIGHT</data>
  <data key="d2">Light (photic input)</data>
  <data key="d3">stimulus</data>
  <data key="d4">circadian</data>
  <data key="d5">0</data>
  <data key="d6">Photic signal reaching the suprachiasmatic nucleus via the retinohypothalamic tract; the dominant entraining stimulus for the central clock and an acute activator of SCN signalling cascades including mTORC1.</data>
  <data key="d7"></data>
  <data key="d8">light pulse; photic stimulation</data>
</node>
<node id="SLEEP_DEPRIVATION">
  <data key="d1">SLEEP_DEPRIVATION</data>
  <data key="d2">Sleep deprivation</data>
  <data key="d3">stimulus</data>
  <data key="d4">circadian</data>
  <data key="d5">0</data>
  <data key="d6">Acute sleep loss</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="VAR_BMAL1_LOF">
  <data key="d1">VAR_BMAL1_LOF</data>
  <data key="d2">Bmal1 loss of function (Bmal1-null)</data>
  <data key="d3">gene_variant</data>
  <data key="d4">circadian</data>
  <data key="d5">0</data>
  <data key="d6">Germline deletion of Bmal1 in mice: arrhythmic behaviour, elevated mTORC1 activity in multiple tissues and premature ageing phenotypes whose lifespan cost is substantially corrected by rapamycin.</data>
  <data key="d7">ARNTL</data>
  <data key="d8">Arntl knockout; Bmal1-/-</data>
</node>
<node id="VAR_PER2_LOF">
  <data key="d1">VAR_PER2_LOF</data>
  <data key="d2">PER2 loss of function (Per2-null)</data>
  <data key="d3">gene_variant</data>
  <data key="d4">circadian</data>
  <data key="d5">0</data>
  <data key="d6">Per2-deficient allele; the genetic test of PER2-dependent restraint of mTORC1 reported with reference [662].</data>
  <data key="d7"></data>
  <data key="d8">Per2 knockout; Per2-/-</data>
</node>
<node id="AGEING">
  <data key="d1">AGEING</data>
  <data key="d2">Ageing</data>
  <data key="d3">stimulus</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Chronological ageing as an input: raises basal mTORC1 tone while attenuating acute responsiveness, impairs stress-responsive autophagy and drives immunosenescence.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="EXERCISE_RESISTANCE">
  <data key="d1">EXERCISE_RESISTANCE</data>
  <data key="d2">Resistance exercise / mechanical overload</data>
  <data key="d3">stimulus</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Mechanical loading of skeletal muscle; activates mTORC1 through phospholipase D-derived phosphatidic acid, membrane perturbation and focal adhesion signalling, and is the stimulus whose protein-synthetic response rapamycin blocks in humans.</data>
  <data key="d7"></data>
  <data key="d8">load-bearing contraction; mechanical overload</data>
</node>
<node id="MTORC2_ACTIVATOR">
  <data key="d1">MTORC2_ACTIVATOR</data>
  <data key="d2">Small-molecule mTORC2 activator</data>
  <data key="d3">drug</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Unnamed small molecule reported in [280] to raise mTORC2 activity; enhances L-LTP and long-term memory in wild-type animals and reverses age-associated memory impairment in mice and flies.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="VAR_CLASS_DISTAL_NETWORK">
  <data key="d1">VAR_CLASS_DISTAL_NETWORK</data>
  <data key="d2">Distal-network lesion class</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Lesions raising flux into a branched network in which mTORC1 is one effector among several and AKT retains output to GSK3beta, FOXO and MDM2.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="VAR_CLASS_PROXIMAL_BRAKE">
  <data key="d1">VAR_CLASS_PROXIMAL_BRAKE</data>
  <data key="d2">Proximal-brake lesion class</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Lesions acting on or immediately above the kinase that remove a constitutive restraint and leave mTORC1 as the sole effector, creating genuine dependency.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="VAR_DEPDC5_LOF">
  <data key="d1">VAR_DEPDC5_LOF</data>
  <data key="d2">DEPDC5 loss-of-function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Germline heterozygous loss-of-function variant in the GATOR1 component DEPDC5; in an open-label case series the three patients with DEPDC5 truncating/LoF variants responded to everolimus, whereas a DEPDC5 missense variant responded less and the single NPRL3 patient worsened.</data>
  <data key="d7">DEPDC5</data>
  <data key="d8">DEPDC5 FFEVF variants</data>
</node>
<node id="VAR_MTOR_E1799K">
  <data key="d1">VAR_MTOR_E1799K</data>
  <data key="d2">MTOR E1799K</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Recurrent germline MTOR gain-of-function substitution accounting for roughly half of Smith–Kingsmore syndrome cases.</data>
  <data key="d7">MTOR</data>
  <data key="d8">E1799K</data>
</node>
<node id="VAR_MTOR_GOF">
  <data key="d1">VAR_MTOR_GOF</data>
  <data key="d2">MTOR gain-of-function (somatic mosaic)</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Germline activating MTOR substitutions causing Smith–Kingsmore syndrome (E1799K accounts for roughly half of cases); patient variants dampen cellular circadian amplitude as well as driving overgrowth and epilepsy.</data>
  <data key="d7">MTOR</data>
  <data key="d8">E1799K; MTOR GOF; MTOR gain of function</data>
</node>
<node id="VAR_NPRL3_LOF">
  <data key="d1">VAR_NPRL3_LOF</data>
  <data key="d2">NPRL3 loss-of-function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Heterozygous germline loss of a GATOR1 subunit causing familial focal epilepsy; the single reported NPRL3 patient worsened on everolimus.</data>
  <data key="d7">NPRL3</data>
  <data key="d8"></data>
</node>
<node id="VAR_STK11_LOF">
  <data key="d1">VAR_STK11_LOF</data>
  <data key="d2">STK11 (LKB1) loss-of-function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Germline (Peutz-Jeghers syndrome) or somatic (lung adenocarcinoma, cervical cancer) STK11 inactivation; removes AMPK Thr172 phosphorylation under energy stress and deregulates mTORC1.</data>
  <data key="d7">STK11</data>
  <data key="d8">LKB1 loss; Peutz-Jeghers</data>
</node>
<node id="VAR_TSC1_LOF">
  <data key="d1">VAR_TSC1_LOF</data>
  <data key="d2">TSC1 loss-of-function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Loss-of-function alteration of TSC1, a proximal-brake lesion; identified in exceptional responders to everolimus in urothelial carcinoma and present in roughly 8% of bladder cancers.</data>
  <data key="d7">TSC1</data>
  <data key="d8">Tsc1 knockout; Tsc2 knockout; hamartin loss</data>
</node>
<node id="VAR_TSC2_LOF">
  <data key="d1">VAR_TSC2_LOF</data>
  <data key="d2">TSC2 loss-of-function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">0</data>
  <data key="d6">Germline (+ second hit) or somatic TSC2 loss; abolishes Rheb GAP activity; tuberous sclerosis, LAM, PEComa (AMPECT response enriched); proximal-brake lesion.</data>
  <data key="d7">TSC2</data>
  <data key="d8">tuberin loss</data>
</node>
<node id="ALPELISIB">
  <data key="d1">ALPELISIB</data>
  <data key="d2">Alpelisib</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">PI3K-alpha-selective inhibitor; SOLAR-1 demonstrated benefit in a population prospectively selected for PIK3CA mutation, an example of genomic selection succeeding upstream of the mTOR node.</data>
  <data key="d7"></data>
  <data key="d8">BYL719; Piqray</data>
</node>
<node id="APITOLISIB">
  <data key="d1">APITOLISIB</data>
  <data key="d2">Apitolisib</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Dual class I PI3K and mTOR kinase inhibitor; clinical development limited by metabolic and general toxicity rather than by lack of target engagement.</data>
  <data key="d7"></data>
  <data key="d8">GDC-0980</data>
</node>
<node id="AZD8055">
  <data key="d1">AZD8055</data>
  <data key="d2">AZD8055</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Potent, selective, orally bioavailable ATP-competitive mTOR kinase inhibitor active against both complexes; the chemical precursor of vistusertib.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="CAPIVASERTIB">
  <data key="d1">CAPIVASERTIB</data>
  <data key="d2">Capivasertib</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">ATP-competitive pan-AKT inhibitor; CAPItello-291 demonstrated benefit in AKT-pathway-altered breast cancer, the second upstream node at which genomic selection succeeded.</data>
  <data key="d7"></data>
  <data key="d8">AZD5363; Truqap</data>
</node>
<node id="CYCLOSPORINE">
  <data key="d1">CYCLOSPORINE</data>
  <data key="d2">Cyclosporine A</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Cyclic peptide immunosuppressant that binds cyclophilin A; the complex inhibits calcineurin. Comparator for the diabetogenic risk of mTOR inhibitors after transplantation.</data>
  <data key="d7"></data>
  <data key="d8">CsA; ciclosporin</data>
</node>
<node id="DACTOLISIB">
  <data key="d1">DACTOLISIB</data>
  <data key="d2">Dactolisib</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Imidazoquinoline dual pan-PI3K and mTOR kinase inhibitor developed partly to pre-empt feedback reactivation of AKT; limited clinically by a toxicity ceiling.</data>
  <data key="d7"></data>
  <data key="d8">BEZ235; NVP-BEZ235</data>
</node>
<node id="DEXAMETHASONE">
  <data key="d1">DEXAMETHASONE</data>
  <data key="d2">Dexamethasone (topical)</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Corticosteroid used as a mouthwash to prevent rapalog-associated stomatitis (SWISH trial).</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="EVEROLIMUS">
  <data key="d1">EVEROLIMUS</data>
  <data key="d2">Everolimus</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">First-generation allosteric rapalog, a 40-O-(2-hydroxyethyl) derivative of sirolimus. Pharmacokinetics (node attributes, not edges): oral bioavailability approximately 30%, half-life near 30 h; CYP3A4 and P-glycoprotein substrate, with brain accumulation restricted by ABCB1. Used at immunosuppressive and oncology exposures and, at much lower exposures (0.5 mg daily or 5 mg weekly), as an immunological geroscience intervention.</data>
  <data key="d7"></data>
  <data key="d8">Afinitor; RAD001; Zortress</data>
</node>
<node id="KU0063794">
  <data key="d1">KU0063794</data>
  <data key="d2">KU-0063794</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Selective ATP-competitive mTOR tool inhibitor that blocks both complexes without inhibiting related PI3K-family kinases at comparable concentrations.</data>
  <data key="d7"></data>
  <data key="d8">KU0063794</data>
</node>
<node id="METFORMIN">
  <data key="d1">METFORMIN</data>
  <data key="d2">Metformin</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Biguanide antidiabetic; inhibits mitochondrial complex I (raising AMP/ADP), binds PEN2 to activate lysosomal AMPK at low doses, and also inhibits mTORC1 independently of AMPK via Rag GTPases and p53-REDD1.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="NAB_SIROLIMUS">
  <data key="d1">NAB_SIROLIMUS</data>
  <data key="d2">nab-Sirolimus</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Nanoparticle albumin-bound intravenous formulation of sirolimus, approved for advanced malignant perivascular epithelioid cell tumour on the AMPECT trial, where response was enriched in TSC2-mutant tumours.</data>
  <data key="d7"></data>
  <data key="d8">ABI-009; Fyarro; albumin-bound sirolimus</data>
</node>
<node id="OSI027">
  <data key="d1">OSI027</data>
  <data key="d2">OSI-027</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">ATP-competitive mTOR kinase inhibitor with activity against mTORC1 and mTORC2; evaluated in early-phase oncology studies.</data>
  <data key="d7"></data>
  <data key="d8">OSI027</data>
</node>
<node id="PP242">
  <data key="d1">PP242</data>
  <data key="d2">PP242</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">ATP-competitive mTOR active-site tool inhibitor used to define the rapamycin-resistant outputs of mTORC1 and mTORC2.</data>
  <data key="d7"></data>
  <data key="d8">Torkinib</data>
</node>
<node id="RAPALINK1">
  <data key="d1">RAPALINK1</data>
  <data key="d2">RapaLink-1</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">First bi-steric mTOR inhibitor: a rapamycin (FKBP12-binding) moiety tethered to an ATP-site moiety, achieving mTORC1 selectivity through FKBP12-mediated avidity and overcoming FRB resistance mutations.</data>
  <data key="d7"></data>
  <data key="d8">RapaLink; RapaLink1</data>
</node>
<node id="RAPAMYCIN">
  <data key="d1">RAPAMYCIN</data>
  <data key="d2">Rapamycin (sirolimus)</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">First-generation allosteric rapalog. Binds FKBP12 with sub- to low-nanomolar affinity; the binary complex engages the FRB domain of assembled mTORC1. Pharmacokinetics (node attributes, not edges): oral bioavailability approximately 14% for the tablet formulation, terminal half-life near 62 h; CYP3A4 and P-glycoprotein substrate; therapeutic drug monitoring with troughs typically 4-12 ng/mL in transplantation. Compounded rapamycin, widely used off-label, delivers substantially lower and more variable systemic exposure per milligram than the branded product, which is both a safety consideration and a major confounder in trials that used it. Off-label use for healthspan is not endorsed by any professional body.</data>
  <data key="d7"></data>
  <data key="d8">AY-22989; Rapamune; sirolimus</data>
</node>
<node id="RIDAFOROLIMUS">
  <data key="d1">RIDAFOROLIMUS</data>
  <data key="d2">Ridaforolimus</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Non-prodrug rapalog with a phosphine oxide substituent at C43; investigated in sarcoma and other solid tumours but not approved.</data>
  <data key="d7"></data>
  <data key="d8">AP23573; MK-8669; deforolimus</data>
</node>
<node id="RMC5552">
  <data key="d1">RMC5552</data>
  <data key="d2">RMC-5552</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Bi-steric mTORC1-selective inhibitor that fully suppresses 4E-BP1; phase 1 reported a complete response in PTEN/PIK3CA-altered endometrial cancer with treatment-related hyperglycaemia in only 4% of patients.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="RTB101">
  <data key="d1">RTB101</data>
  <data key="d2">RTB101</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">ATP-competitive PI3K/mTOR inhibitor (BEZ235/dactolisib) studied at low doses for immune function in older adults; the phase 3 respiratory-illness endpoint was not met.</data>
  <data key="d7"></data>
  <data key="d8">BEZ235; dactolisib</data>
</node>
<node id="SAPANISERTIB">
  <data key="d1">SAPANISERTIB</data>
  <data key="d2">Sapanisertib</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Second-generation ATP-competitive mTOR kinase inhibitor active against both mTORC1 and mTORC2, including the rapamycin-resistant 4E-BP1 sites.</data>
  <data key="d7"></data>
  <data key="d8">INK128; MLN0128; TAK-228</data>
</node>
<node id="TACROLIMUS">
  <data key="d1">TACROLIMUS</data>
  <data key="d2">Tacrolimus (FK506)</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Macrolide immunosuppressant that binds FKBP12; the FKBP12-FK506 complex inhibits calcineurin rather than mTOR. Also used topically as mouthwash prophylaxis against mTOR-inhibitor mucositis.</data>
  <data key="d7"></data>
  <data key="d8">FK-506; FK506; Prograf</data>
</node>
<node id="TEMSIROLIMUS">
  <data key="d1">TEMSIROLIMUS</data>
  <data key="d2">Temsirolimus</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">First-generation rapalog given intravenously as a prodrug converted to sirolimus. CYP3A4 and P-glycoprotein substrate. Approved for advanced poor-prognosis renal cell carcinoma on the basis of the Global ARCC trial; also used as CCI-779 in preclinical neurodegeneration models.</data>
  <data key="d7"></data>
  <data key="d8">CCI-779; Torisel</data>
</node>
<node id="TORIN1">
  <data key="d1">TORIN1</data>
  <data key="d2">Torin1</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">ATP-competitive mTOR kinase inhibitor that fully suppresses rapamycin-resistant 4E-BP1 Thr37/Thr46 phosphorylation and TOP mRNA translation.</data>
  <data key="d7"></data>
  <data key="d8">Torin 1; Torin-1</data>
</node>
<node id="TORIN2">
  <data key="d1">TORIN2</data>
  <data key="d2">Torin2</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Second-generation ATP-competitive mTOR kinase inhibitor and tool compound</data>
  <data key="d7"></data>
  <data key="d8">Torin 2</data>
</node>
<node id="VAR_FRB_RESISTANCE">
  <data key="d1">VAR_FRB_RESISTANCE</data>
  <data key="d2">mTOR FRB resistance mutation</data>
  <data key="d3">gene_variant</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Substitutions in the FRB domain (the Ser2035 contact in the original yeast and mammalian studies; M2327I in a patient relapsing on a rapalog) that abolish FKBP12-rapamycin binding and confer resistance.</data>
  <data key="d7">MTOR</data>
  <data key="d8">M2327I; Ser2035 FRB mutants</data>
</node>
<node id="VISTUSERTIB">
  <data key="d1">VISTUSERTIB</data>
  <data key="d2">Vistusertib</data>
  <data key="d3">drug</data>
  <data key="d4">pharmacology</data>
  <data key="d5">0</data>
  <data key="d6">Second-generation ATP-competitive mTOR kinase inhibitor from the AZD8055 programme, with improved pharmaceutical properties; evaluated in several solid-tumour indications.</data>
  <data key="d7"></data>
  <data key="d8">AZD2014</data>
</node>
<node id="CASTOR1">
  <data key="d1">CASTOR1</data>
  <data key="d2">CASTOR1</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Cellular arginine sensor for mTORC1; binds arginine through tandem ACT domains and in the apo state sequesters GATOR2.</data>
  <data key="d7">CASTOR1</data>
  <data key="d8">GATSL3</data>
</node>
<node id="CASTOR2">
  <data key="d1">CASTOR2</data>
  <data key="d2">CASTOR2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">CASTOR paralogue that heterodimerises with CASTOR1 and binds GATOR2 but does not itself bind arginine with high affinity.</data>
  <data key="d7">CASTOR2</data>
  <data key="d8">GATSL2</data>
</node>
<node id="EIF2AK4">
  <data key="d1">EIF2AK4</data>
  <data key="d2">GCN2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Kinase activated by uncharged tRNA on amino-acid deprivation; drives ATF4 translation and thereby SESN2 induction, providing a slower transcriptional arm of amino-acid sensing.</data>
  <data key="d7">EIF2AK4</data>
  <data key="d8"></data>
</node>
<node id="LARS1">
  <data key="d1">LARS1</data>
  <data key="d2">Leucyl-tRNA synthetase 1 (LARS1)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Cytoplasmic leucyl-tRNA synthetase proposed to act as a leucine-responsive RagD GAP; the assignment is contested because the yeast orthologue acts on the RagA/B counterpart with opposite polarity.</data>
  <data key="d7">LARS1</data>
  <data key="d8">LARS; LeuRS</data>
</node>
<node id="MAT2A">
  <data key="d1">MAT2A</data>
  <data key="d2">MAT2A (methionine adenosyltransferase 2A)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Enzyme converting methionine and ATP into S-adenosylmethionine; it generates the ligand actually sensed by SAMTOR, so methionine availability reaches mTORC1 only through MAT2A-produced SAM.</data>
  <data key="d7">MAT2A</data>
  <data key="d8">MATII</data>
</node>
<node id="NPC1">
  <data key="d1">NPC1</data>
  <data key="d2">NPC1</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Lysosomal cholesterol export protein that physically associates with SLC38A9; its loss traps cholesterol in the lumen and hyperactivates mTORC1.</data>
  <data key="d7">NPC1</data>
  <data key="d8">Niemann-Pick C1</data>
</node>
<node id="OGT">
  <data key="d1">OGT</data>
  <data key="d2">O-GlcNAc transferase (OGT)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Sole enzyme adding O-linked GlcNAc from UDP-GlcNAc; the hexosamine pathway flux it reports is the proposed means by which glucose gates LARS1 function.</data>
  <data key="d7">OGT</data>
  <data key="d8">uridine diphospho-N-acetylglucosamine transferase</data>
</node>
<node id="SAMTOR">
  <data key="d1">SAMTOR</data>
  <data key="d2">SAMTOR</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">S-adenosylmethionine sensor (Kd about 7 uM) that, unlike Sestrin2 and CASTOR1, acts directly on the GATOR1-KICSTOR assembly, linking dietary methionine to mTORC1.</data>
  <data key="d7">SAMTOR</data>
  <data key="d8">BMT2; C7orf60</data>
</node>
<node id="SAR1B">
  <data key="d1">SAR1B</data>
  <data key="d2">SAR1B</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">COPII-associated small GTPase reported to bind leucine and regulate mTORC1; a single-laboratory finding awaiting independent replication.</data>
  <data key="d7">SAR1B</data>
  <data key="d8">SARA2</data>
</node>
<node id="SESN1">
  <data key="d1">SESN1</data>
  <data key="d2">Sestrin1</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Sestrin family member that binds GATOR2 and is a p53 target; expressed in a tissue-restricted pattern that may determine which leucine-sensing mechanism dominates in a given tissue.</data>
  <data key="d7">SESN1</data>
  <data key="d8">PA26</data>
</node>
<node id="SESN2">
  <data key="d1">SESN2</data>
  <data key="d2">Sestrin2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Stress-inducible sestrin transcribed by p53 (DNA damage) and ATF4 (ER stress, amino-acid starvation via GCN2); apo-Sestrin2 sequesters GATOR2 to inhibit mTORC1 and was reported to activate AMPK; also a leucine sensor.</data>
  <data key="d7">SESN2</data>
  <data key="d8">Hi95; SEST2</data>
</node>
<node id="SESN3">
  <data key="d1">SESN3</data>
  <data key="d2">Sestrin3</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Third Sestrin paralogue that also binds GATOR2; differential tissue expression across SESN1/2/3 underlies context-dependent leucine sensing.</data>
  <data key="d7">SESN3</data>
  <data key="d8">SEST3</data>
</node>
<node id="SLC1A5">
  <data key="d1">SLC1A5</data>
  <data key="d2">SLC1A5 (ASCT2)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Plasma-membrane glutamine importer whose accumulated glutamine is the exchange substrate that drives LAT1-mediated leucine uptake.</data>
  <data key="d7">SLC1A5</data>
  <data key="d8">ASCT2; ATB0</data>
</node>
<node id="SLC38A9">
  <data key="d1">SLC38A9</data>
  <data key="d2">SLC38A9</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Lysosomal transceptor: reports luminal arginine through its N-terminal domain, exports leucine and other essential amino acids to the cytosol, and cooperates with NPC1 to couple lysosomal cholesterol to mTORC1.</data>
  <data key="d7">SLC38A9</data>
  <data key="d8">SLC38A9.1</data>
</node>
<node id="SLC3A2">
  <data key="d1">SLC3A2</data>
  <data key="d2">SLC3A2 (CD98 heavy chain)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Heavy chain that disulphide-bonds to SLC7A5 to form the functional LAT1 transporter.</data>
  <data key="d7">SLC3A2</data>
  <data key="d8">4F2hc; CD98hc</data>
</node>
<node id="SLC7A5">
  <data key="d1">SLC7A5</data>
  <data key="d2">SLC7A5 (LAT1 light chain)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Bidirectional plasma-membrane antiporter that couples glutamine efflux to leucine influx, supplying the cytosolic leucine pool read by the sensors.</data>
  <data key="d7">SLC7A5</data>
  <data key="d8">CD98 light chain; L-type amino acid transporter 1; LAT1</data>
</node>
<node id="V_ATPASE">
  <data key="d1">V_ATPASE</data>
  <data key="d2">Lysosomal v-ATPase</data>
  <data key="d3">complex</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">1</data>
  <data key="d6">Vacuolar H+-ATPase that acidifies the lysosome and undergoes amino-acid-dependent conformational change, relaying luminal amino-acid content outward to Ragulator - the inside-out sensing mechanism.</data>
  <data key="d7">ATP6V1A, ATP6V0A1, ATP6V1B2</data>
  <data key="d8">V-ATPase; vacuolar H+-ATPase</data>
</node>
<node id="AR">
  <data key="d1">AR</data>
  <data key="d2">Androgen receptor</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Nuclear receptor whose activation raises mTORC1 output and cyclin D translation in prostate cancer; reciprocal feedback with PI3K–AKT (PTEN loss).</data>
  <data key="d7">AR</data>
  <data key="d8">AR</data>
</node>
<node id="EGFR">
  <data key="d1">EGFR</data>
  <data key="d2">EGFR</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Epidermal growth factor receptor; activates PI3K mainly via GAB1 (and ERBB3 heterodimers) and Ras via GRB2–SOS; frequently amplified/mutated in cancer.</data>
  <data key="d7">EGFR</data>
  <data key="d8">ErbB1; HER1</data>
</node>
<node id="ESR1">
  <data key="d1">ESR1</data>
  <data key="d2">Estrogen receptor α</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Nuclear receptor phosphorylated by S6K1 at Ser167, giving ligand-independent transcriptional activity.</data>
  <data key="d7">ESR1</data>
  <data key="d8">ERalpha; ERα</data>
</node>
<node id="IGF1R">
  <data key="d1">IGF1R</data>
  <data key="d2">IGF-1 receptor</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Receptor tyrosine kinase for IGF-1. Reported to be tyrosine-phosphorylated and activated by the intrinsic tyrosine kinase activity of mTOR within mTORC2, constituting a feed-forward arm from mTORC2 back onto the receptor tier. NOTE: this node may already exist in the growth_factor_input module; the assembler should deduplicate rather than create a second copy.</data>
  <data key="d7">IGF1R</data>
  <data key="d8">IGF-1R; IGF1R; type I IGF receptor</data>
</node>
<node id="INSR">
  <data key="d1">INSR</data>
  <data key="d2">Insulin receptor</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">α2β2 receptor tyrosine kinase; insulin binding triggers β-subunit autophosphorylation and IRS recruitment. Target of Grb10-mediated mTORC1 feedback.</data>
  <data key="d7">INSR</data>
  <data key="d8">IR</data>
</node>
<node id="IRS1">
  <data key="d1">IRS1</data>
  <data key="d2">IRS-1</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Insulin receptor substrate 1; tyrosine-phosphorylated docking protein whose pYXXM motifs recruit p85–PI3K. Inhibitory serine phosphorylation by S6K1 is the classical mTORC1 negative-feedback arm.</data>
  <data key="d7">IRS1</data>
  <data key="d8">IRS-1 adaptor; insulin receptor substrate 1</data>
</node>
<node id="NF1">
  <data key="d1">NF1</data>
  <data key="d2">Neurofibromin (NF1)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Ras GAP; its loss raises Ras·GTP and ERK/RSK input to TSC2. NF1 loss is a recurrent cancer lesion in this pathway.</data>
  <data key="d7">NF1</data>
  <data key="d8">neurofibromin</data>
</node>
<node id="PHOSPHATIDIC_ACID">
  <data key="d1">PHOSPHATIDIC_ACID</data>
  <data key="d2">Phosphatidic acid</data>
  <data key="d3">lipid</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Phospholipase D product that binds the FRB domain of mTOR in competition with FKBP12-rapamycin and promotes complex stability and signalling; a mechanical/nutrient-responsive lipid input.</data>
  <data key="d7"></data>
  <data key="d8">PA</data>
</node>
<node id="PI3K">
  <data key="d1">PI3K</data>
  <data key="d2">Class I PI3K (p110α/p85)</data>
  <data key="d3">complex</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Class IA phosphoinositide 3-kinase: p110α catalytic (PIK3CA) with p85 regulatory subunit; converts PIP2 to PIP3 on RTK/IRS/Ras input. PIK3CA hotspot mutations are frequent distal-network cancer lesions.</data>
  <data key="d7">PIK3CA; PIK3R1</data>
  <data key="d8">PIK3CA; p110alpha; p110α; phosphoinositide 3-kinase</data>
</node>
<node id="PIK3R1">
  <data key="d1">PIK3R1</data>
  <data key="d2">p85α (PIK3R1)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Regulatory subunit of class IA PI3K; stabilises p110, restrains its basal activity via nSH2/iSH2 contacts, and relieves that inhibition when its SH2 domains bind pYXXM motifs.</data>
  <data key="d7">PIK3R1</data>
  <data key="d8">p85α</data>
</node>
<node id="PIP2">
  <data key="d1">PIP2</data>
  <data key="d2">PI(4,5)P2</data>
  <data key="d3">lipid</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Phosphatidylinositol 4,5-bisphosphate; plasma-membrane substrate of class I PI3K and product of PTEN.</data>
  <data key="d7"></data>
  <data key="d8">PtdIns(4,5)P2</data>
</node>
<node id="PIP3">
  <data key="d1">PIP3</data>
  <data key="d2">PI(3,4,5)P3</data>
  <data key="d3">lipid</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Phosphatidylinositol-3,4,5-trisphosphate generated by PI3K; bound by the mSin1 PH domain, relieving its autoinhibition of mTORC2 and recruiting the complex to the plasma membrane.</data>
  <data key="d7"></data>
  <data key="d8">PtdIns(3,4,5)P3</data>
</node>
<node id="PLD1">
  <data key="d1">PLD1</data>
  <data key="d2">Phospholipase D1</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Phospholipase D isoform generating phosphatidic acid after mechanical stimulation of muscle; proposed mechanical input to mTORC1.</data>
  <data key="d7">PLD1</data>
  <data key="d8">PLD; phospholipase D</data>
</node>
<node id="PTEN">
  <data key="d1">PTEN</data>
  <data key="d2">PTEN</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">PIP3 3-phosphatase and tumour suppressor; the main negative regulator of PI3K–AKT. Loss (prostate, GBM, endometrium) raises PIP3/AKT flux; it acts as a distal-network lesion.</data>
  <data key="d7">PTEN</data>
  <data key="d8">MMAC1</data>
</node>
<node id="RAS">
  <data key="d1">RAS</data>
  <data key="d2">Ras (K/H/N-Ras)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Small GTPase activated by RTK–GRB2–SOS; Ras·GTP recruits RAF (ERK cascade) and binds the p110α RBD; its pathway converges on TSC2 and Raptor to raise mTORC1 output.</data>
  <data key="d7">HRAS</data>
  <data key="d8">HRAS; KRAS; NRAS; RAS</data>
</node>
<node id="RTK">
  <data key="d1">RTK</data>
  <data key="d2">Receptor tyrosine kinases (generic)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">1</data>
  <data key="d6">Growth-factor receptors (EGFR, ERBB2, PDGFR, MET, FGFR etc.) whose autophosphorylated tyrosines recruit PI3K (directly or via adaptors) and GRB2–SOS to Ras. Amplification converges on PI3K in cancer.</data>
  <data key="d7"></data>
  <data key="d8">receptor tyrosine kinase</data>
</node>
<node id="ALDOA">
  <data key="d1">ALDOA</data>
  <data key="d2">Aldolase A</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Glycolytic aldolase acting as a glucose sensor: when not occupied by fructose-1,6-bisphosphate it signals through the lysosomal v-ATPase to assemble the AXIN-LKB1-AMPK module and suppress Ragulator-dependent mTORC1 activation.</data>
  <data key="d7">ALDOA</data>
  <data key="d8">aldolase</data>
</node>
<node id="ATP6AP1">
  <data key="d1">ATP6AP1</data>
  <data key="d2">ATP6AP1 (v-ATPase accessory subunit 1)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Accessory subunit of the lysosomal v-ATPase and the binding partner of PEN2 in the low-dose metformin route; the PEN2–ATP6AP1 interaction inhibits v-ATPase and triggers lysosomal AMPK activation without a fall in cellular ATP.</data>
  <data key="d7">ATP6AP1</data>
  <data key="d8">Ac45</data>
</node>
<node id="AXIN1">
  <data key="d1">AXIN1</data>
  <data key="d2">AXIN1</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Scaffold that, under low energy or glucose, tethers LKB1 to AMPK (AXIN-AMPK-LKB1 complex) and to v-ATPase-Ragulator at the lysosome, while blocking Ragulator GEF activity toward RagA/B to switch mTORC1 off.</data>
  <data key="d7">AXIN1</data>
  <data key="d8">AXIN; axin</data>
</node>
<node id="CAB39">
  <data key="d1">CAB39</data>
  <data key="d2">MO25-alpha (CAB39)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Armadillo-repeat scaffold that binds the C-terminus of STRADA and stabilises the LKB1-STRADA-MO25 heterotrimer, increasing LKB1 activity about 10-fold beyond STRADA alone.</data>
  <data key="d7">CAB39</data>
  <data key="d8">MO25; calcium-binding protein 39</data>
</node>
<node id="CAMKK2">
  <data key="d1">CAMKK2</data>
  <data key="d2">CaMKK2 (CaMKK-beta)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Ca2+/calmodulin-dependent kinase kinase that phosphorylates AMPK Thr172 in response to rises in cytosolic Ca2+, independently of LKB1 and of the AMP:ATP ratio.</data>
  <data key="d7">CAMKK2</data>
  <data key="d8">CaMKK-beta</data>
</node>
<node id="EGLN1">
  <data key="d1">EGLN1</data>
  <data key="d2">PHD2 (EGLN1)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Prolyl-4-hydroxylase domain protein 2, the principal cellular oxygen sensor. Uses O2 and 2-oxoglutarate to hydroxylate HIF-1α at Pro402/Pro564, creating the pVHL recognition site; hypoxia inactivates it, stabilising HIF-1α and inducing REDD1 and BNIP3.</data>
  <data key="d7">EGLN1</data>
  <data key="d8">HIF prolyl hydroxylase 2; PHD2</data>
</node>
<node id="EIF2AK3">
  <data key="d1">EIF2AK3</data>
  <data key="d2">PERK (EIF2AK3)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">ER-resident eIF2alpha kinase activated by unfolded proteins (BiP release); phosphorylates eIF2alpha Ser51 to launch the integrated stress response and ATF4 translation.</data>
  <data key="d7">EIF2AK3</data>
  <data key="d8">PERK</data>
</node>
<node id="LKB1_COMPLEX">
  <data key="d1">LKB1_COMPLEX</data>
  <data key="d2">LKB1-STRADA-MO25 complex</data>
  <data key="d3">complex</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Heterotrimeric, constitutively active AMPK upstream kinase complex; AMP binding to AMPK gamma makes AMPK a better substrate rather than activating LKB1 itself. Also recruited to lysosomes by AXIN under glucose starvation.</data>
  <data key="d7">STK11; STRADA; CAB39</data>
  <data key="d8">LKB1 complex</data>
</node>
<node id="MITOCHONDRIAL_COMPLEX_I">
  <data key="d1">MITOCHONDRIAL_COMPLEX_I</data>
  <data key="d2">Mitochondrial complex I (NADH dehydrogenase)</data>
  <data key="d3">complex</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Entry point of the respiratory chain (approximately 45 subunits); its inhibition by metformin/phenformin or by hypoxia-limited respiration lowers ATP and raises AMP/ADP, activating AMPK.</data>
  <data key="d7">NDUFS1; NDUFV1; MT-ND1</data>
  <data key="d8">NADH:ubiquinone oxidoreductase</data>
</node>
<node id="PEN2">
  <data key="d1">PEN2</data>
  <data key="d2">PEN2 (PSENEN)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Gamma-secretase subunit identified as the direct low-dose metformin binding protein; metformin-bound PEN2 engages ATP6AP1 to inhibit v-ATPase, triggering AXIN-LKB1 recruitment and lysosomal AMPK activation.</data>
  <data key="d7">PSENEN</data>
  <data key="d8">presenilin enhancer 2</data>
</node>
<node id="PEX5">
  <data key="d1">PEX5</data>
  <data key="d2">PEX5 (peroxisomal import receptor)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Peroxisomal targeting-signal receptor reported to bind TSC1/TSC2 and localise a TSC complex pool to peroxisomes, where ROS activate TSC2 to repress mTORC1 and trigger autophagy.</data>
  <data key="d7">PEX5</data>
  <data key="d8">peroxin 5</data>
</node>
<node id="STK11">
  <data key="d1">STK11</data>
  <data key="d2">LKB1 (STK11)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Constitutively active master upstream kinase that phosphorylates AMPK Thr172 (and 12 AMPK-related kinases); requires STRADA and MO25 for activity and cytoplasmic localisation. Tumour suppressor lost in Peutz-Jeghers syndrome.</data>
  <data key="d7">STK11</data>
  <data key="d8">LKB1; serine/threonine kinase 11</data>
</node>
<node id="STRADA">
  <data key="d1">STRADA</data>
  <data key="d2">STRAD-alpha (STRADA)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">1</data>
  <data key="d6">Pseudokinase that binds the LKB1 kinase domain, induces its active conformation and retains LKB1 in the cytoplasm. Biallelic loss causes PMSE syndrome with impaired LKB1-AMPK signalling and neuronal mTORC1 hyperactivation.</data>
  <data key="d7">STRADA</data>
  <data key="d8">LYK5; STE20-related adaptor alpha</data>
</node>
<node id="GLS">
  <data key="d1">GLS</data>
  <data key="d2">glutaminase</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">1</data>
  <data key="d6">Mitochondrial glutaminase catalysing the first step of glutaminolysis (glutamine to glutamate), upstream of glutamate dehydrogenase and of alpha-ketoglutarate-dependent Rag GTP loading.</data>
  <data key="d7">GLS</data>
  <data key="d8">GLS1; KGA/GAC</data>
</node>
<node id="VAR_NF1_LOF">
  <data key="d1">VAR_NF1_LOF</data>
  <data key="d2">NF1 loss-of-function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">1</data>
  <data key="d6">Loss of the Ras GAP neurofibromin, raising RAS-ERK-RSK flux onto the TSC complex; one of the lesions enrolled in the negative everolimus basket study.</data>
  <data key="d7">NF1</data>
  <data key="d8"></data>
</node>
<node id="VAR_PIK3CA_GOF">
  <data key="d1">VAR_PIK3CA_GOF</data>
  <data key="d2">PIK3CA activating mutation</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">1</data>
  <data key="d6">Helical (E542K, E545K) and kinase (H1047R/L) hotspot gain-of-function mutations in ~30–40% of breast and 30% of endometrial cancers; distal-network lesion.</data>
  <data key="d7">PIK3CA</data>
  <data key="d8">PIK3CA hotspot mutation</data>
</node>
<node id="VAR_PTEN_LOF">
  <data key="d1">VAR_PTEN_LOF</data>
  <data key="d2">PTEN loss</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">1</data>
  <data key="d6">Loss of the PIP3 phosphatase; roughly 30% of prostate, 40% of glioblastoma and 35% of endometrial cancers, and germline in PTEN hamartoma tumour syndrome.</data>
  <data key="d7">PTEN</data>
  <data key="d8"></data>
</node>
<node id="VAR_RTK_AMP">
  <data key="d1">VAR_RTK_AMP</data>
  <data key="d2">Receptor tyrosine kinase amplification</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">1</data>
  <data key="d6">Amplification of receptor tyrosine kinases converging on PI3K; distal-network lesion with low predicted mTORC1 dependency.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="ABCB1">
  <data key="d1">ABCB1</data>
  <data key="d2">ABCB1 (P-glycoprotein)</data>
  <data key="d3">protein</data>
  <data key="d4">pharmacology</data>
  <data key="d5">1</data>
  <data key="d6">ATP-binding cassette efflux transporter at the gut and blood-brain barrier; sirolimus and everolimus are substrates, which limits oral bioavailability and CNS exposure.</data>
  <data key="d7">ABCB1</data>
  <data key="d8">MDR1; P-glycoprotein; P-gp</data>
</node>
<node id="CYP3A4">
  <data key="d1">CYP3A4</data>
  <data key="d2">CYP3A4</data>
  <data key="d3">protein</data>
  <data key="d4">pharmacology</data>
  <data key="d5">1</data>
  <data key="d6">Principal oxidative metabolising enzyme for sirolimus and everolimus; the basis of extensive drug-drug interaction potential and of therapeutic drug monitoring in transplantation.</data>
  <data key="d7">CYP3A4</data>
  <data key="d8">cytochrome P450 3A4</data>
</node>
<node id="FKBP12">
  <data key="d1">FKBP12</data>
  <data key="d2">FKBP12</data>
  <data key="d3">protein</data>
  <data key="d4">pharmacology</data>
  <data key="d5">1</data>
  <data key="d6">12 kDa peptidyl-prolyl isomerase immunophilin; its yeast orthologue FPR1 emerged from the original rapamycin-resistance screen. Binds rapamycin, and the binary complex then engages the mTOR FRB domain.</data>
  <data key="d7">FKBP1A</data>
  <data key="d8">FK506-binding protein 12; FKBP1A; FPR1</data>
</node>
<node id="FKBP12_RAPAMYCIN">
  <data key="d1">FKBP12_RAPAMYCIN</data>
  <data key="d2">FKBP12-rapamycin complex</data>
  <data key="d3">complex</data>
  <data key="d4">pharmacology</data>
  <data key="d5">1</data>
  <data key="d6">Binary complex of rapamycin with its intracellular receptor FKBP12; this composite surface, not either partner alone, is the species that binds the FRB domain of mTOR and inhibits mTORC1.</data>
  <data key="d7"></data>
  <data key="d8">FKBP12-rapalog complex; FKBP12-rapamycin; rapamycin-FKBP12</data>
</node>
<node id="PPIA">
  <data key="d1">PPIA</data>
  <data key="d2">Cyclophilin A (PPIA)</data>
  <data key="d3">protein</data>
  <data key="d4">pharmacology</data>
  <data key="d5">1</data>
  <data key="d6">The cyclosporine-cyclophilin A binary complex inhibits calcineurin; cyclophilin A has no role in rapalog action. Required to represent why cyclosporine causes post-transplant diabetes by a mechanism distinct from that of sirolimus.</data>
  <data key="d7">PPIA</data>
  <data key="d8">CypA; cyclophilin A</data>
</node>
<node id="ARF1">
  <data key="d1">ARF1</data>
  <data key="d2">Arf1</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">ADP-ribosylation factor 1, required for glutamine-induced activation of mTORC1 by a route that does not require the Rag GTPases.</data>
  <data key="d7">ARF1</data>
  <data key="d8">ADP-ribosylation factor 1</data>
</node>
<node id="C12ORF66">
  <data key="d1">C12ORF66</data>
  <data key="d2">C12orf66</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">KICSTOR subunit required for the integrity of the KICSTOR-GATOR1 assembly.</data>
  <data key="d7">C12orf66</data>
  <data key="d8">KICS2</data>
</node>
<node id="DEPDC5">
  <data key="d1">DEPDC5</data>
  <data key="d2">DEPDC5</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Largest GATOR1 subunit; binds the Rag heterodimer through its SABA/SHEN domains and inhibits mTORC1 independently of catalysis. Loss-of-function variants cause familial focal epilepsy.</data>
  <data key="d7">DEPDC5</data>
  <data key="d8">DEP domain containing 5</data>
</node>
<node id="FLCN">
  <data key="d1">FLCN</data>
  <data key="d2">Folliculin (FLCN)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Tumour suppressor with a longin GAP domain; with FNIP1/2 provides the GAP activity for RagC/D. Mutated in Birt-Hogg-Dube syndrome.</data>
  <data key="d7">FLCN</data>
  <data key="d8">BHD; folliculin</data>
</node>
<node id="FLCN_FNIP">
  <data key="d1">FLCN_FNIP</data>
  <data key="d2">FLCN-FNIP complex</data>
  <data key="d3">complex</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">GTPase-activating complex for RagC/D; drives the heterodimer into the RagA/B.GTP-RagC/D.GDP state and is required in particular for mTORC1 phosphorylation of TFEB/TFE3.</data>
  <data key="d7">FLCN, FNIP1, FNIP2</data>
  <data key="d8">folliculin-FNIP; lysosomal folliculin complex (LFC)</data>
</node>
<node id="FNIP1">
  <data key="d1">FNIP1</data>
  <data key="d2">FNIP1</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Folliculin-interacting protein that heterodimerises with FLCN to form the active RagC/D GAP; also reported to bind AMPK.</data>
  <data key="d7">FNIP1</data>
  <data key="d8">folliculin interacting protein 1</data>
</node>
<node id="FNIP2">
  <data key="d1">FNIP2</data>
  <data key="d2">FNIP2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Paralogue of FNIP1 that forms an equivalent FLCN-FNIP2 GAP complex.</data>
  <data key="d7">FNIP2</data>
  <data key="d8">FNIPL; MAPO1</data>
</node>
<node id="GATOR1">
  <data key="d1">GATOR1</data>
  <data key="d2">GATOR1 (DEPDC5-NPRL2-NPRL3)</data>
  <data key="d3">complex</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Trimeric GTPase-activating protein for RagA/B and therefore a negative regulator of mTORC1, active when amino acids are scarce; a tumour suppressor and the locus of familial focal epilepsies.</data>
  <data key="d7">DEPDC5, NPRL2, NPRL3</data>
  <data key="d8">GAP activity toward Rags complex 1</data>
</node>
<node id="GATOR2">
  <data key="d1">GATOR2</data>
  <data key="d2">GATOR2</data>
  <data key="d3">complex</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Octameric positive regulator of mTORC1 containing WDR24, WDR59, MIOS, SEH1L and SEC13; acts by inhibiting GATOR1 and is the common hub on which the Sestrin and CASTOR sensors converge.</data>
  <data key="d7">WDR24; WDR59; MIOS; SEH1L; SEC13</data>
  <data key="d8">GAP activity toward Rags complex 2</data>
</node>
<node id="ITFG2">
  <data key="d1">ITFG2</data>
  <data key="d2">ITFG2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">KICSTOR subunit required for assembly of the scaffold that localises GATOR1 to the lysosome.</data>
  <data key="d7">ITFG2</data>
  <data key="d8">C12orf35</data>
</node>
<node id="KICSTOR">
  <data key="d1">KICSTOR</data>
  <data key="d2">KICSTOR</data>
  <data key="d3">complex</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Tetrameric scaffold (KPTN, ITFG2, C12orf66, SZT2) that recruits GATOR1 to the lysosomal surface and is required for nutrients to regulate mTORC1; non-redundant in humans.</data>
  <data key="d7">KPTN, ITFG2, C12orf66, SZT2</data>
  <data key="d8">KPTN, ITFG2, C12orf66 and SZT2-containing regulator of mTORC1</data>
</node>
<node id="KPTN">
  <data key="d1">KPTN</data>
  <data key="d2">KPTN (kaptin)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">KICSTOR subunit; biallelic loss causes a macrocephaly-intellectual disability syndrome consistent with mTORC1 disinhibition.</data>
  <data key="d7">KPTN</data>
  <data key="d8">kaptin</data>
</node>
<node id="LAMTOR1">
  <data key="d1">LAMTOR1</data>
  <data key="d2">LAMTOR1 (p18)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Lipid-anchored Ragulator subunit whose N-terminal myristoylation and palmitoylation tether the entire complex to the lysosomal membrane; also contacts the v-ATPase.</data>
  <data key="d7">LAMTOR1</data>
  <data key="d8">C11orf59; p18</data>
</node>
<node id="LAMTOR2">
  <data key="d1">LAMTOR2</data>
  <data key="d2">LAMTOR2 (p14)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Roadblock-domain Ragulator subunit; forms a heterodimer with LAMTOR3 that contacts the Rag roadblock domains.</data>
  <data key="d7">LAMTOR2</data>
  <data key="d8">ROBLD3; p14</data>
</node>
<node id="LAMTOR3">
  <data key="d1">LAMTOR3</data>
  <data key="d2">LAMTOR3 (MP1)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Roadblock-domain Ragulator subunit partnering LAMTOR2; originally characterised as a MEK1/ERK scaffold.</data>
  <data key="d7">LAMTOR3</data>
  <data key="d8">MAP2K1IP1; MP1</data>
</node>
<node id="LAMTOR4">
  <data key="d1">LAMTOR4</data>
  <data key="d2">LAMTOR4 (C7orf59)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Roadblock-domain Ragulator subunit forming a heterodimer with LAMTOR5 that engages the Rag GTPase roadblock domains.</data>
  <data key="d7">LAMTOR4</data>
  <data key="d8">C7orf59</data>
</node>
<node id="LAMTOR5">
  <data key="d1">LAMTOR5</data>
  <data key="d2">LAMTOR5 (HBXIP)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Roadblock-domain Ragulator subunit partnering LAMTOR4 within the pentameric complex.</data>
  <data key="d7">LAMTOR5</data>
  <data key="d8">HBXIP</data>
</node>
<node id="MIOS">
  <data key="d1">MIOS</data>
  <data key="d2">MIOS</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">GATOR2 subunit (missing oocyte homologue) whose beta-propeller forms part of the binding surface for the amino-acid sensors Sestrin2 and CASTOR1.</data>
  <data key="d7">MIOS</data>
  <data key="d8">MIO; Sea4</data>
</node>
<node id="NPRL2">
  <data key="d1">NPRL2</data>
  <data key="d2">NPRL2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">GATOR1 subunit carrying the longin domain that supplies the catalytic arginine finger for GAP activity toward RagA/B.</data>
  <data key="d7">NPRL2</data>
  <data key="d8">TUSC4; nitrogen permease regulator 2-like</data>
</node>
<node id="NPRL3">
  <data key="d1">NPRL3</data>
  <data key="d2">NPRL3</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">GATOR1 subunit bridging NPRL2 and DEPDC5 and contributing to Rag binding; mutated in focal epilepsy.</data>
  <data key="d7">NPRL3</data>
  <data key="d8">CGTHBA; nitrogen permease regulator 3-like</data>
</node>
<node id="RAB1A">
  <data key="d1">RAB1A</data>
  <data key="d2">Rab1A</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Golgi-resident Rab GTPase reported to be required for amino-acid-dependent mTORC1 activation and to interact with Rheb; amplified in colorectal cancer.</data>
  <data key="d7">RAB1A</data>
  <data key="d8">Rab1</data>
</node>
<node id="RAGULATOR">
  <data key="d1">RAGULATOR</data>
  <data key="d2">Ragulator (LAMTOR1-5)</data>
  <data key="d3">complex</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Lysosomal pentamer anchoring the Rag heterodimer and acting as RagA/B GEF; with v-ATPase it also docks AXIN-LKB1 for lysosomal AMPK activation under glucose starvation, serving as a catabolism/anabolism switch.</data>
  <data key="d7">LAMTOR1; LAMTOR2; LAMTOR3; LAMTOR4; LAMTOR5</data>
  <data key="d8">LAMTOR complex; p18-p14-MP1-C7orf59-HBXIP</data>
</node>
<node id="RNF152">
  <data key="d1">RNF152</data>
  <data key="d2">RNF152</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Lysosome-associated RING-finger E3 ligase reported to K63-ubiquitinate Rheb, increasing its affinity for TSC2 and restraining Rheb–mTORC1 in the absence of growth factors.</data>
  <data key="d7">RNF152</data>
  <data key="d8">RING finger protein 152</data>
</node>
<node id="RUVBL1">
  <data key="d1">RUVBL1</data>
  <data key="d2">RUVBL1 (Pontin)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">AAA+ ATPase that, with RUVBL2, joins the TTT (Tel2-Tti1-Tti2) complex to form the TTT-RUVBL1/2 co-chaperone promoting mTORC1 dimerisation and lysosomal localisation.</data>
  <data key="d7">RUVBL1</data>
  <data key="d8">Pontin; TIP49a</data>
</node>
<node id="RUVBL2">
  <data key="d1">RUVBL2</data>
  <data key="d2">RUVBL2 (Reptin)</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">AAA+ ATPase partner of RUVBL1 in the TTT-RUVBL1/2 module that chaperones newly synthesised PIKKs including mTOR.</data>
  <data key="d7">RUVBL2</data>
  <data key="d8">Reptin; TIP49b</data>
</node>
<node id="SEC13">
  <data key="d1">SEC13</data>
  <data key="d2">SEC13</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">WD40 GATOR2 subunit also found in the COPII coat and the nuclear pore complex; a structural element of GATOR2.</data>
  <data key="d7">SEC13</data>
  <data key="d8">D3S1231E; SEC13L1</data>
</node>
<node id="SEH1L">
  <data key="d1">SEH1L</data>
  <data key="d2">SEH1L</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">WD40 GATOR2 subunit shared with the nuclear pore Nup107-160 complex; stabilises the GATOR2 assembly.</data>
  <data key="d7">SEH1L</data>
  <data key="d8">SEC13L; Seh1</data>
</node>
<node id="SH3BP4">
  <data key="d1">SH3BP4</data>
  <data key="d2">SH3BP4</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">SH3-domain binding protein that interacts with the inactive Rag heterodimer under amino-acid starvation and prevents formation of the active, mTORC1-recruiting state.</data>
  <data key="d7">SH3BP4</data>
  <data key="d8">TTP</data>
</node>
<node id="SKP2">
  <data key="d1">SKP2</data>
  <data key="d2">SKP2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">SCF E3 ligase substrate-recognition subunit reported to K63-ubiquitinate RagA, promoting GATOR1 binding as a brake on amino-acid-driven mTORC1 hyperactivation.</data>
  <data key="d7">SKP2</data>
  <data key="d8">FBXL1</data>
</node>
<node id="SZT2">
  <data key="d1">SZT2</data>
  <data key="d2">SZT2</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Very large KICSTOR subunit that binds GATOR1 directly and dictates GATOR control of mTORC1; biallelic mutation causes an infantile encephalopathy with epilepsy and dysmorphic corpus callosum.</data>
  <data key="d7">SZT2</data>
  <data key="d8">KIAA0467; seizure threshold 2</data>
</node>
<node id="VAR_FLCN_LOF">
  <data key="d1">VAR_FLCN_LOF</data>
  <data key="d2">FLCN loss-of-function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Germline loss-of-function variants in folliculin, abolishing RagC/D GAP activity and dysregulating mTORC1 in a tissue-dependent rather than uniformly increased manner.</data>
  <data key="d7">FLCN</data>
  <data key="d8">FLCN LOF</data>
</node>
<node id="VAR_SZT2_LOF">
  <data key="d1">VAR_SZT2_LOF</data>
  <data key="d2">SZT2 loss-of-function (biallelic)</data>
  <data key="d3">gene_variant</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">Biallelic SZT2 loss-of-function variants that disable the KICSTOR scaffold; the clinical proof that this scaffold is non-redundant in humans.</data>
  <data key="d7">SZT2</data>
  <data key="d8">SZT2 biallelic LOF</data>
</node>
<node id="WDR24">
  <data key="d1">WDR24</data>
  <data key="d2">WDR24</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">GATOR2 subunit with a beta-propeller and zinc-finger; required for GATOR2 to relieve GATOR1 inhibition and part of the sensor-binding surface.</data>
  <data key="d7">WDR24</data>
  <data key="d8">C8orf71</data>
</node>
<node id="WDR59">
  <data key="d1">WDR59</data>
  <data key="d2">WDR59</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">2</data>
  <data key="d6">GATOR2 subunit with beta-propeller and RING-like domains; contributes to the GATOR2 scaffold that contacts GATOR1.</data>
  <data key="d7">WDR59</data>
  <data key="d8">GM83</data>
</node>
<node id="AKT">
  <data key="d1">AKT</data>
  <data key="d2">AKT (PKB)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Central PI3K effector held in check by mTORC1-driven feedback (S6K1-IRS-1, Grb10, S6K1-Rictor); relief of this feedback on mTORC1 inhibition produces the clinically important AKT rebound.</data>
  <data key="d7">AKT1</data>
  <data key="d8">AKT1; AKT1/2/3; PKB; protein kinase B</data>
</node>
<node id="AKT3">
  <data key="d1">AKT3</data>
  <data key="d2">AKT3</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Brain-enriched AKT isoform; somatic mosaic activating AKT3 variants confined to malformed cortex cause hemimegalencephaly and focal cortical dysplasia type II.</data>
  <data key="d7">AKT3</data>
  <data key="d8">PKB-gamma</data>
</node>
<node id="CSNK1A1">
  <data key="d1">CSNK1A1</data>
  <data key="d2">CK1alpha</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Priming kinase that phosphorylates mTOR-primed DEPTOR to create the βTrCP degron; the missing step between mTORC1 phosphorylation of DEPTOR and its βTrCP-dependent destruction.</data>
  <data key="d7">CSNK1A1</data>
  <data key="d8">casein kinase 1 alpha</data>
</node>
<node id="DGKZ">
  <data key="d1">DGKZ</data>
  <data key="d2">DGKζ (diacylglycerol kinase ζ)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Diacylglycerol kinase whose PLD-independent production of phosphatidic acid is required for mechanical-load activation of mTORC1 in skeletal muscle.</data>
  <data key="d7">DGKZ</data>
  <data key="d8">DGKzeta</data>
</node>
<node id="ERK">
  <data key="d1">ERK</data>
  <data key="d2">ERK1/2</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Photic signal transducer in SCN neurons; the MEK–ERK arm that couples light to mTORC1 activity (S6K1 and 4E-BP1 phosphorylation) in the central clock. Shared node — likely already defined in growth_factor_input.</data>
  <data key="d7">MAPK1</data>
  <data key="d8">ERK2; MAPK1; MAPK1/3; MAPK3; p42 MAPK; p42/44 MAPK; p42/p44; p42/p44 MAPK</data>
</node>
<node id="FARNESYLTRANSFERASE">
  <data key="d1">FARNESYLTRANSFERASE</data>
  <data key="d2">Farnesyltransferase</data>
  <data key="d3">complex</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Prenylates the Rheb CAAX motif (Cys181); farnesylation is required for Rheb membrane localisation and mTORC1 activation.</data>
  <data key="d7">FNTA; FNTB</data>
  <data key="d8">FTase</data>
</node>
<node id="GRB2">
  <data key="d1">GRB2</data>
  <data key="d2">GRB2</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">SH2–SH3 adaptor that binds phosphotyrosines on activated receptor tyrosine kinases (directly on EGFR; via SHC or IRS-1 for the insulin and IGF-1 receptors) and brings the Ras GEF SOS1 to the membrane.</data>
  <data key="d7">GRB2</data>
  <data key="d8">Grb2; growth factor receptor-bound protein 2</data>
</node>
<node id="GSK3B">
  <data key="d1">GSK3B</data>
  <data key="d2">GSK3β</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Constitutively active kinase inhibited by AKT at Ser9; one of the AKT substrates that remains substantially phosphorylated when AKT carries Thr308 alone. Also phosphorylates Rictor, feeding back onto mTORC2.</data>
  <data key="d7">GSK3B</data>
  <data key="d8">GSK-3 beta; GSK-3beta; GSK-3β; GSK3B; GSK3beta</data>
</node>
<node id="HERC1">
  <data key="d1">HERC1</data>
  <data key="d2">HERC1</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">HECT/RLD-domain E3 ubiquitin ligase reported to bind and ubiquitinate TSC2 when TSC2 is not protected by TSC1.</data>
  <data key="d7">HERC1</data>
  <data key="d8"></data>
</node>
<node id="IKBKB">
  <data key="d1">IKBKB</data>
  <data key="d2">IKKβ</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Inhibitor of NF-kB kinase beta; downstream of TNF it phosphorylates TSC1 Ser487/Ser511, suppressing TSC1 and activating mTORC1 and VEGF-driven angiogenesis.</data>
  <data key="d7">IKBKB</data>
  <data key="d8">IKK-β; IKK2; IKKB</data>
</node>
<node id="MAPK14">
  <data key="d1">MAPK14</data>
  <data key="d2">p38α MAPK</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Stress-activated MAPK; one of the two upstream activators of MNK1 and therefore of eIF4E Ser209 phosphorylation.</data>
  <data key="d7">MAPK14</data>
  <data key="d8">p38</data>
</node>
<node id="MAPKAPK2">
  <data key="d1">MAPKAPK2</data>
  <data key="d2">MK2</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Kinase whose translation is controlled by mTOR; MK2 stabilises SASP transcripts via ZFP36L1, the second documented translational route from mTORC1 to the SASP.</data>
  <data key="d7">MAPKAPK2</data>
  <data key="d8">MAPKAPK2</data>
</node>
<node id="MEK">
  <data key="d1">MEK</data>
  <data key="d2">MEK1/2</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Dual-specificity MAP2Ks that phosphorylate ERK1/2 on the TEY motif.</data>
  <data key="d7">MAP2K1; MAP2K2</data>
  <data key="d8">MAP2K1/2</data>
</node>
<node id="PDK1">
  <data key="d1">PDK1</data>
  <data key="d2">PDK1</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">3-Phosphoinositide-dependent kinase 1; constitutively active PH-domain kinase that phosphorylates the activation loop of AKT (Thr308), RSK (NTKD) and S6K1 once PIP3 brings substrate and kinase together.</data>
  <data key="d7">PDPK1</data>
  <data key="d8">PDPK1</data>
</node>
<node id="PHLPP">
  <data key="d1">PHLPP</data>
  <data key="d2">PHLPP1/2</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">PH-domain leucine-rich repeat protein phosphatases that dephosphorylate AKT Ser473 (hydrophobic motif), terminating mTORC2-dependent AKT activation.</data>
  <data key="d7">PHLPP1; PHLPP2</data>
  <data key="d8">PHLPP</data>
</node>
<node id="PP2A">
  <data key="d1">PP2A</data>
  <data key="d2">PP2A (B55α holoenzyme)</data>
  <data key="d3">complex</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Protein phosphatase 2A; the B55α-containing holoenzyme dephosphorylates AKT Thr308, opposing PDK1.</data>
  <data key="d7">PPP2CA; PPP2R1A; PPP2R2A</data>
  <data key="d8">PP2A-B55α</data>
</node>
<node id="PRKDC">
  <data key="d1">PRKDC</data>
  <data key="d2">DNA-PKcs</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">DNA-dependent protein kinase catalytic subunit; alternative, mTORC2-independent AKT Ser473 kinase after DNA double-strand breaks.</data>
  <data key="d7">PRKDC</data>
  <data key="d8">DNA-PK</data>
</node>
<node id="RAF">
  <data key="d1">RAF</data>
  <data key="d2">RAF kinases</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Ras-effector MAP3Ks that phosphorylate and activate MEK1/2.</data>
  <data key="d7">RAF1; BRAF; ARAF</data>
  <data key="d8">B-Raf; c-Raf</data>
</node>
<node id="RSK">
  <data key="d1">RSK</data>
  <data key="d2">p90 RSK</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">p90 ribosomal S6 kinase downstream of ERK; phosphorylates Raptor at an activating cluster and contributes to DEPTOR phosphodegron formation, linking RAS-pathway activation to mTORC1 output.</data>
  <data key="d7">RPS6KA1</data>
  <data key="d8">RPS6KA; RSK1/2/3; p90 ribosomal S6 kinase; p90RSK</data>
</node>
<node id="SOS1">
  <data key="d1">SOS1</data>
  <data key="d2">SOS1 (Son of sevenless 1)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Ras guanine-nucleotide exchange factor held by GRB2 and relocated to activated receptors, where it loads Ras with GTP.</data>
  <data key="d7">SOS1</data>
  <data key="d8">SOS; Son of sevenless homolog 1</data>
</node>
<node id="TBC1D7">
  <data key="d1">TBC1D7</data>
  <data key="d2">TBC1D7</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Third subunit of the TSC complex (1 copy per 2:2 TSC1–TSC2); bridges TSC1 coiled-coils and stabilises TSC1–TSC2 association.</data>
  <data key="d7">TBC1D7</data>
  <data key="d8"></data>
</node>
<node id="TPT1">
  <data key="d1">TPT1</data>
  <data key="d2">TCTP</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Translationally controlled tumour protein; proposed Rheb GEF in Drosophila, not supported by later biochemical work (contested).</data>
  <data key="d7">TPT1</data>
  <data key="d8"></data>
</node>
<node id="TSC1">
  <data key="d1">TSC1</data>
  <data key="d2">TSC1 (hamartin)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Scaffold subunit of the TSC complex stabilising TSC2; phosphorylated at Ser487/Ser511 by IKK-beta, which suppresses the complex and raises mTORC1 under TNF/inflammatory signalling.</data>
  <data key="d7">TSC1</data>
  <data key="d8">hamartin</data>
</node>
<node id="TSC2">
  <data key="d1">TSC2</data>
  <data key="d2">TSC2 (tuberin)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">GAP subunit of the TSC1-TSC2-TBC1D7 complex acting on Rheb. Activated by AMPK (Ser1387/Ser1345) and GSK3 phosphorylation, released from 14-3-3 by REDD1, inhibited by AKT/ERK/RSK phosphorylation; a p53 transcriptional target.</data>
  <data key="d7">TSC2</data>
  <data key="d8">tuberin</data>
</node>
<node id="TSC_COMPLEX">
  <data key="d1">TSC_COMPLEX</data>
  <data key="d2">TSC complex (TSC1–TSC2–TBC1D7)</data>
  <data key="d3">complex</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">2</data>
  <data key="d6">Rheb GAP complex; recruited to the lysosomal surface in a Rag-dependent manner on amino-acid withdrawal, providing a second arm of amino-acid control over mTORC1 that acts on Rheb rather than on recruitment.</data>
  <data key="d7">TSC1/TSC2/TBC1D7</data>
  <data key="d8">TSC complex; TSC1-TSC2; TSC1/2; TSC1/2 complex; tuberous sclerosis complex</data>
</node>
<node id="AMPK">
  <data key="d1">AMPK</data>
  <data key="d2">AMPK (AMP-activated protein kinase)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Second catalytic α-subunit isoform of AMPK, carrying the activation-loop Thr172. Predominant α-isoform in skeletal muscle, heart and liver and the isoform most relevant to exercise, metformin and the inhibitory mTORC1 phosphorylation at Ser345.</data>
  <data key="d7">PRKAA1</data>
  <data key="d8">AMP-activated protein kinase; AMPK alpha; AMPK alpha2; PRKAA1; PRKAA2 (paralogue)</data>
</node>
<node id="ATM">
  <data key="d1">ATM</data>
  <data key="d2">ATM kinase</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">PIKK-family DNA-damage sensor kinase (activated by MRN at double-strand breaks and, independently, by direct oxidation under ROS); phosphorylates p53 Ser15 and signals via LKB1-AMPK-TSC2 to repress mTORC1.</data>
  <data key="d7">ATM</data>
  <data key="d8">ataxia telangiectasia mutated</data>
</node>
<node id="BNIP3">
  <data key="d1">BNIP3</data>
  <data key="d2">BNIP3</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">HIF-1-induced BH3-only mitochondrial protein mediating hypoxic mitophagy; reported to bind Rheb and reduce its GTP loading, inhibiting mTORC1 independently of TSC2.</data>
  <data key="d7">BNIP3</data>
  <data key="d8">BCL2 interacting protein 3</data>
</node>
<node id="DDIT4">
  <data key="d1">DDIT4</data>
  <data key="d2">REDD1 (DDIT4)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Stress-induced inhibitor of mTORC1 acting through the TSC complex; its transcript is rhythmically expressed in mouse peripheral tissues, offering a candidate clock-to-mTORC1 transcriptional route.</data>
  <data key="d7">DDIT4</data>
  <data key="d8">Dig2; REDD1; RTP801</data>
</node>
<node id="EIF2S1">
  <data key="d1">EIF2S1</data>
  <data key="d2">eIF2alpha (EIF2S1)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Alpha subunit of eIF2; Ser51 phosphorylation by PERK/GCN2/PKR/HRI lowers ternary-complex availability, repressing global initiation while selectively increasing ATF4 translation.</data>
  <data key="d7">EIF2S1</data>
  <data key="d8">eIF2alpha</data>
</node>
<node id="PPM1A">
  <data key="d1">PPM1A</data>
  <data key="d2">PP2Cα (PPM1A)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Mg2+/Mn2+-dependent protein phosphatase 2C family member that dephosphorylates AMPK Thr172 and terminates AMPK signalling; AMP binding to the γ-subunit protects Thr172 from this dephosphorylation, which is a major component of allosteric AMPK activation.</data>
  <data key="d7">PPM1A</data>
  <data key="d8">PP2C alpha</data>
</node>
<node id="PRKAB1">
  <data key="d1">PRKAB1</data>
  <data key="d2">AMPK beta1 (scaffold subunit)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Beta subunit of AMPK: myristoylated scaffold bridging alpha and gamma, carries the carbohydrate-binding module (glycogen sensing) and forms the ADaM drug-binding site with the alpha kinase domain. beta2 (PRKAB2) is the muscle paralogue.</data>
  <data key="d7">PRKAB1</data>
  <data key="d8">AMPK beta</data>
</node>
<node id="PRKAG1">
  <data key="d1">PRKAG1</data>
  <data key="d2">AMPK gamma1 (nucleotide-sensing subunit)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Gamma subunit of AMPK with four CBS motifs binding AMP, ADP or ATP competitively at sites 1 and 3; occupancy by AMP/ADP drives allosteric activation and protects pThr172 from phosphatases. gamma2/gamma3 paralogues exist.</data>
  <data key="d7">PRKAG1</data>
  <data key="d8">AMPK gamma</data>
</node>
<node id="TP53">
  <data key="d1">TP53</data>
  <data key="d2">p53</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Stress-activated transcription factor; after DNA damage or AMPK phosphorylation (Ser15) induces SESN1/2, DDIT4, PTEN, TSC2 and AMPK beta1, forming a coordinated brake on IGF-1/AKT/mTORC1 signalling.</data>
  <data key="d7">TP53</data>
  <data key="d8">TP53; tumour protein p53</data>
</node>
<node id="VHL">
  <data key="d1">VHL</data>
  <data key="d2">pVHL (VHL)</data>
  <data key="d3">protein</data>
  <data key="d4">energy_stress_input</data>
  <data key="d5">2</data>
  <data key="d6">Substrate-recognition component of the CUL2–elongin BC E3 ubiquitin ligase that binds prolyl-hydroxylated HIF-1α and targets it for proteasomal degradation in normoxia.</data>
  <data key="d7">VHL</data>
  <data key="d8">von Hippel-Lindau protein</data>
</node>
<node id="CDC37">
  <data key="d1">CDC37</data>
  <data key="d2">Cdc37</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">2</data>
  <data key="d6">Kinase-specific Hsp90 co-chaperone that delivers client protein kinases, including PIKK-family members, to the Hsp90 cycle.</data>
  <data key="d7">CDC37</data>
  <data key="d8">p50cdc37</data>
</node>
<node id="HSP90AA1">
  <data key="d1">HSP90AA1</data>
  <data key="d2">Hsp90</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">2</data>
  <data key="d6">ATP-dependent chaperone that, with the TTT/R2TP machinery and the kinase-specific co-chaperone Cdc37, matures newly synthesised mTOR; Hsp90 inhibition destabilises mTOR and reduces mTORC1 signalling.</data>
  <data key="d7">HSP90AA1</data>
  <data key="d8">HSP90</data>
</node>
<node id="TELO2">
  <data key="d1">TELO2</data>
  <data key="d2">Tel2</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">2</data>
  <data key="d6">Core subunit of the TTT (Tel2-Tti1-Tti2) co-chaperone module that binds nascent PIKKs including mTOR and, with R2TP/Hsp90, governs their folding, stability and assembly into complexes.</data>
  <data key="d7">TELO2</data>
  <data key="d8">TEL2; hCLK2</data>
</node>
<node id="TTI1">
  <data key="d1">TTI1</data>
  <data key="d2">Tti1</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">2</data>
  <data key="d6">Tel2-interacting protein 1; with Tel2 and Tti2 forms the TTT module required for mTOR protein stability and for assembly of both mTORC1 and mTORC2.</data>
  <data key="d7">TTI1</data>
  <data key="d8">KIAA0406</data>
</node>
<node id="TTI2">
  <data key="d1">TTI2</data>
  <data key="d2">Tti2</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">2</data>
  <data key="d6">Third TTT subunit; biallelic TTI2 variants cause intellectual disability, consistent with a non-redundant role in PIKK stability in humans.</data>
  <data key="d7">TTI2</data>
  <data key="d8">TELO2 interacting protein 2</data>
</node>
<node id="TTT_COMPLEX">
  <data key="d1">TTT_COMPLEX</data>
  <data key="d2">TTT complex (Tel2-Tti1-Tti2)</data>
  <data key="d3">complex</data>
  <data key="d4">core_complexes</data>
  <data key="d5">2</data>
  <data key="d6">Trimeric PIKK-dedicated co-chaperone that works with R2TP/Hsp90 to fold newly synthesised mTOR and promote its incorporation into mTORC1 and mTORC2.</data>
  <data key="d7">TELO2, TTI1, TTI2</data>
  <data key="d8">TTT</data>
</node>
<node id="PIK3C3">
  <data key="d1">PIK3C3</data>
  <data key="d2">VPS34</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">2</data>
  <data key="d6">Class III PI3-kinase proposed as an amino-acid-responsive activator of mTORC1 in parallel with the Rag route; the assignment conflicts with its established pro-autophagic role and is contested.</data>
  <data key="d7">PIK3C3</data>
  <data key="d8">PIK3C3; class III PI3K; hVps34</data>
</node>
<node id="PER2">
  <data key="d1">PER2</data>
  <data key="d2">PER2 (Period 2)</data>
  <data key="d3">protein</data>
  <data key="d4">circadian</data>
  <data key="d5">2</data>
  <data key="d6">Negative-limb clock protein. Beyond transcriptional repression of CLOCK–BMAL1, PER2 binds TSC1 and recruits it to the mTORC1 complex, suppressing mTORC1 in a time-of-day-dependent manner.</data>
  <data key="d7">PER2</data>
  <data key="d8">Period circadian regulator 2</data>
</node>
<node id="VAR_AKT1_GOF">
  <data key="d1">VAR_AKT1_GOF</data>
  <data key="d2">AKT1 activating mutation</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">2</data>
  <data key="d6">PH-domain E17K substitution causing constitutive membrane localisation and activation of AKT1 (breast, colorectal, ovarian cancers); distal-network lesion.</data>
  <data key="d7">AKT1</data>
  <data key="d8">AKT1 E17K</data>
</node>
<node id="VAR_AKT3_GOF">
  <data key="d1">VAR_AKT3_GOF</data>
  <data key="d2">AKT3 activating mutation</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">2</data>
  <data key="d6">Somatic mosaic gain-of-function AKT3 variants confined to malformed cortex cause hemimegalencephaly and focal cortical dysplasia type II.</data>
  <data key="d7">AKT3</data>
  <data key="d8"></data>
</node>
<node id="VAR_NF2_LOF">
  <data key="d1">VAR_NF2_LOF</data>
  <data key="d2">NF2 loss of function</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">2</data>
  <data key="d6">Loss-of-function NF2 (merlin) variant; co-occurred with the TSC1 lesion in the index everolimus exceptional responder and was one of the five selection genes in the negative prospective basket study.</data>
  <data key="d7">NF2</data>
  <data key="d8">merlin</data>
</node>
<node id="LYSOSOME">
  <data key="d1">LYSOSOME</data>
  <data key="d2">Lysosome</data>
  <data key="d3">organelle</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">3</data>
  <data key="d6">Organelle whose cytosolic surface is the platform for mTORC1 activation and whose lumen is the compartment sampled by the inside-out amino-acid sensing machinery; its dysfunction is an upstream cause of mTOR dysregulation.</data>
  <data key="d7"></data>
  <data key="d8">lysosomal membrane</data>
</node>
<node id="RAG_HETERODIMER">
  <data key="d1">RAG_HETERODIMER</data>
  <data key="d2">Rag GTPase heterodimer (RagA/B-RagC/D)</data>
  <data key="d3">complex</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">3</data>
  <data key="d6">Obligate heterodimer recruiting mTORC1 to the lysosome; relays glucose as well as amino-acid sufficiency to mTORC1 largely independently of AMPK, and mediates AMPK-independent mTORC1 inhibition by metformin.</data>
  <data key="d7">RRAGA, RRAGB, RRAGC, RRAGD</data>
  <data key="d8">Gtr1-Gtr2 (yeast); Rag GTPases; Rag heterodimer; RagA/B-RagC/D</data>
</node>
<node id="RRAGA">
  <data key="d1">RRAGA</data>
  <data key="d2">RagA</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">3</data>
  <data key="d6">Rag GTPase that, loaded with GTP, confers Raptor binding on the heterodimer. Target of GATOR1 GAP activity and of Ragulator/SLC38A9 GEF activity.</data>
  <data key="d7">RRAGA</data>
  <data key="d8">Gtr1 homologue</data>
</node>
<node id="RRAGB">
  <data key="d1">RRAGB</data>
  <data key="d2">RagB</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">3</data>
  <data key="d6">Paralogue of RagA with equivalent function; GTP-loaded RagB binds Raptor and is the substrate of GATOR1 GAP activity.</data>
  <data key="d7">RRAGB</data>
  <data key="d8"></data>
</node>
<node id="RRAGC">
  <data key="d1">RRAGC</data>
  <data key="d2">RagC</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">3</data>
  <data key="d6">Rag GTPase that must be GDP-loaded for the active heterodimer configuration; substrate of the FLCN-FNIP GAP and determinant of substrate-specific mTORC1 signalling to TFEB.</data>
  <data key="d7">RRAGC</data>
  <data key="d8"></data>
</node>
<node id="RRAGD">
  <data key="d1">RRAGD</data>
  <data key="d2">RagD</data>
  <data key="d3">protein</data>
  <data key="d4">lysosomal_nutrient_sensing</data>
  <data key="d5">3</data>
  <data key="d6">Paralogue of RagC; GDP-loaded RagD supports the active heterodimer. Proposed substrate of LARS1 GAP activity in the contested leucine-sensing model.</data>
  <data key="d7">RRAGD</data>
  <data key="d8"></data>
</node>
<node id="FKBP8">
  <data key="d1">FKBP8</data>
  <data key="d2">FKBP38 (FKBP8)</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">3</data>
  <data key="d6">Proposed endogenous mTORC1 inhibitor displaced by Rheb·GTP; the model is contested because independent laboratories did not reproduce it.</data>
  <data key="d7">FKBP8</data>
  <data key="d8">FKBP38</data>
</node>
<node id="RHEB">
  <data key="d1">RHEB</data>
  <data key="d2">Rheb</data>
  <data key="d3">protein</data>
  <data key="d4">growth_factor_input</data>
  <data key="d5">3</data>
  <data key="d6">Small GTPase resident on lysosomal/endomembrane surfaces; GTP-loaded Rheb binds the mTOR kinase domain and allosterically activates it, making lysosomal co-localisation the point of pathway convergence.</data>
  <data key="d7">RHEB</data>
  <data key="d8">Ras homolog enriched in brain; Ras homologue enriched in brain; Rheb1</data>
</node>
<node id="AKT1S1">
  <data key="d1">AKT1S1</data>
  <data key="d2">PRAS40</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">3</data>
  <data key="d6">Substoichiometric mTORC1 inhibitor carrying its own TOS motif; competes with substrates for the Raptor recognition surface. AKT phosphorylation at Thr246 releases it, giving feed-forward derepression by growth factors.</data>
  <data key="d7">AKT1S1</data>
  <data key="d8">AKT1 substrate 1; proline-rich Akt substrate of 40 kDa</data>
</node>
<node id="CUL1">
  <data key="d1">CUL1</data>
  <data key="d2">Cullin-1</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">3</data>
  <data key="d6">Scaffold subunit of the SCF E3 ubiquitin ligase that degrades DEPTOR.</data>
  <data key="d7">CUL1</data>
  <data key="d8">CUL-1</data>
</node>
<node id="DEPTOR">
  <data key="d1">DEPTOR</data>
  <data key="d2">DEPTOR</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">3</data>
  <data key="d6">Tandem DEP-domain plus PDZ-domain inhibitory subunit of both mTORC1 and mTORC2; binds the mTOR FAT region. Phosphorylated by active mTOR and by S6K1/RSK/CK1alpha, then degraded via SCF-betaTrCP, so active mTOR removes its own brake.</data>
  <data key="d7">DEPTOR</data>
  <data key="d8">DEPDC6</data>
</node>
<node id="FBXW11">
  <data key="d1">FBXW11</data>
  <data key="d2">beta-TrCP2 (FBXW11)</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">3</data>
  <data key="d6">Second beta-TrCP paralogue; redundant with BTRC as the substrate-recognition subunit for the DEPTOR phosphodegron.</data>
  <data key="d7">FBXW11</data>
  <data key="d8">HOS; beta-TrCP2</data>
</node>
<node id="SCF_BTRC">
  <data key="d1">SCF_BTRC</data>
  <data key="d2">SCF(beta-TrCP) E3 ubiquitin ligase</data>
  <data key="d3">complex</data>
  <data key="d4">core_complexes</data>
  <data key="d5">3</data>
  <data key="d6">Cullin-RING ligase (SKP1-CUL1-RBX1 with the F-box receptor beta-TrCP1/2) that recognises the phosphodegron of DEPTOR and targets it for proteasomal destruction, creating a positive-feedback loop on mTOR activity.</data>
  <data key="d7"></data>
  <data key="d8">SCF-betaTrCP; SKP1-CUL1-F-box</data>
</node>
<node id="SKP1">
  <data key="d1">SKP1</data>
  <data key="d2">SKP1</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">3</data>
  <data key="d6">Adaptor linking CUL1 to the F-box protein beta-TrCP in the SCF ligase acting on DEPTOR.</data>
  <data key="d7">SKP1</data>
  <data key="d8">S-phase kinase-associated protein 1</data>
</node>
<node id="MAM_ER_MITOCHONDRIA">
  <data key="d1">MAM_ER_MITOCHONDRIA</data>
  <data key="d2">Mitochondria-associated ER membranes</data>
  <data key="d3">organelle</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">3</data>
  <data key="d6">ER–mitochondria contact sites hosting a distinct pool of mTORC2–AKT signalling that controls MAM integrity, calcium transfer and mitochondrial physiology.</data>
  <data key="d7"></data>
  <data key="d8">MAM</data>
</node>
<node id="PLASMA_MEMBRANE">
  <data key="d1">PLASMA_MEMBRANE</data>
  <data key="d2">Plasma membrane</data>
  <data key="d3">organelle</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">3</data>
  <data key="d6">Site at which PIP3 is generated and to which PIP3 recruits both mTORC2 (via the mSin1 PH domain) and its membrane-targeted substrate AKT.</data>
  <data key="d7"></data>
  <data key="d8"></data>
</node>
<node id="ATP_SITE">
  <data key="d1">ATP_SITE</data>
  <data key="d2">mTOR kinase ATP cleft</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Nucleotide-binding cleft of the bilobed mTOR kinase domain</data>
  <data key="d7">MTOR</data>
  <data key="d8">kinase cleft; mTOR active site</data>
</node>
<node id="CRIM_DOMAIN">
  <data key="d1">CRIM_DOMAIN</data>
  <data key="d2">mSin1 CRIM domain</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Conserved-region-in-the-middle domain of mSin1; its acidic loop engages the basic surface of the AGC-kinase N-lobe and is the principal distal docking site (~75 A from the catalytic cleft) for Akt, SGK1 and PKC.</data>
  <data key="d7">MAPKAP1</data>
  <data key="d8">CRIM</data>
</node>
<node id="ETV7">
  <data key="d1">ETV7</data>
  <data key="d2">ETV7</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">ETS-family transcription factor reported as the defining subunit of a putative third, rapamycin-insensitive mTOR assembly (mTORC3) in cancer cells. Described by a single laboratory and not widely replicated, so the evidence remains weak.</data>
  <data key="d7">ETV7</data>
  <data key="d8">TEL2; TEL2 (ETS family); TELB</data>
</node>
<node id="FATC_DOMAIN">
  <data key="d1">FATC_DOMAIN</data>
  <data key="d2">mTOR FATC domain</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Extreme C-terminal FATC domain; packs against the kinase domain and is indispensable for catalytic activity - deletion of even a single residue abolishes mTOR kinase function.</data>
  <data key="d7">MTOR</data>
  <data key="d8">FATC</data>
</node>
<node id="FAT_DOMAIN">
  <data key="d1">FAT_DOMAIN</data>
  <data key="d2">mTOR FAT domain</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">FRAP-ATM-TRRAP domain, the alpha-helical clamp that wraps the kinase domain and holds it in a partially inactive conformation; the FAT-kinase interface is the target of activating cancer mutations and of Rheb-induced conformational change.</data>
  <data key="d7">MTOR</data>
  <data key="d8">FAT</data>
</node>
<node id="FRB_DOMAIN">
  <data key="d1">FRB_DOMAIN</data>
  <data key="d2">FRB domain of mTOR</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">~100-residue four-helix bundle between the FAT and kinase domains of mTOR forming the binding site for the FKBP12-rapamycin binary complex; solvent-exposed in mTORC1 and occluded by Rictor-mSin1 in mTORC2.</data>
  <data key="d7">MTOR</data>
  <data key="d8">FKBP12-rapamycin binding domain</data>
</node>
<node id="HEAT_REPEATS">
  <data key="d1">HEAT_REPEATS</data>
  <data key="d2">mTOR N-HEAT/M-HEAT solenoid</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">N-terminal alpha-solenoid of mTOR (horn and bridge), ~20 HEAT repeats; forms the mTORC1/mTORC2 dimer interface, the Raptor- and Rictor-binding surface and, together with the FAT domain, the Rheb-binding site.</data>
  <data key="d7">MTOR</data>
  <data key="d8">HEAT repeats; M-HEAT; N-HEAT; horn and bridge</data>
</node>
<node id="KINASE_DOMAIN">
  <data key="d1">KINASE_DOMAIN</data>
  <data key="d2">mTOR kinase domain (PIKK)</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">PI3K-like catalytic domain of mTOR with a deeply recessed active-site cleft walled by the FRB domain, the LBE (mLST8-binding element) and the activation loop; the catalytic unit of both complexes.</data>
  <data key="d7">MTOR</data>
  <data key="d8">PIKK domain; catalytic domain</data>
</node>
<node id="MAPKAP1">
  <data key="d1">MAPKAP1</data>
  <data key="d2">mSin1</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">522-residue mTORC2 subunit with four regions: N-terminal Rictor-binding segment, central CRIM domain that docks AGC substrates, a Ras-binding domain, and a C-terminal PH domain that binds PIP3 and autoinhibits the complex.</data>
  <data key="d7">MAPKAP1</data>
  <data key="d8">MAPKAP1; MIP1; SIN1; Sin1</data>
</node>
<node id="MLST8">
  <data key="d1">MLST8</data>
  <data key="d2">mLST8 (GbetaL)</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">WD40 beta-propeller shared by both complexes; contacts the mTOR kinase domain near the activation loop and stabilises the catalytic conformation.</data>
  <data key="d7">MLST8</data>
  <data key="d8">GBL; GbetaL; LST8</data>
</node>
<node id="MTOR">
  <data key="d1">MTOR</data>
  <data key="d2">mTOR</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">2549-residue ~289 kDa PIKK-family Ser/Thr kinase (1p36.22). N-HEAT/M-HEAT solenoid, FAT domain, FRB, bilobed kinase domain, C-terminal FATC required for catalysis; deep substrate cleft partially occluded by an inhibitory element.</data>
  <data key="d7">MTOR</data>
  <data key="d8">FRAP1; RAFT1; RAPT1; mechanistic target of rapamycin</data>
</node>
<node id="MTORC1">
  <data key="d1">MTORC1</data>
  <data key="d2">mTORC1</data>
  <data key="d3">complex</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Rapamycin-sensitive mTOR complex 1 (mTOR, Raptor, mLST8, PRAS40, DEPTOR); the convergence point of energy, oxygen and stress inputs via TSC-Rheb, Raptor phosphorylation and Rag GTPases; phosphorylates ULK1 Ser757 and AMPK alpha2 Ser345.</data>
  <data key="d7">MTOR/RPTOR/MLST8</data>
  <data key="d8">mTOR complex 1; mammalian target of rapamycin complex 1</data>
</node>
<node id="MTORC2">
  <data key="d1">MTORC2</data>
  <data key="d2">mTORC2</data>
  <data key="d3">complex</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">~1.0 MDa homodimer of mTOR, mLST8, Rictor and mSin1 with substoichiometric Protor-1/2 and DEPTOR; FRB occluded by Rictor-mSin1, hence acutely rapamycin-insensitive. Phosphorylates AGC kinases via distal docking.</data>
  <data key="d7">MTOR, RICTOR, MLST8, MAPKAP1, PRR5, PRR5L, DEPTOR</data>
  <data key="d8">TORC2; mTOR complex 2</data>
</node>
<node id="MTORC3">
  <data key="d1">MTORC3</data>
  <data key="d2">mTORC3 (putative)</data>
  <data key="d3">complex</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Putative third mTOR assembly containing ETV7, reported to be rapamycin-insensitive and to drive proliferation in cancer cells. Single-laboratory description, not widely replicated, so the evidence remains weak.</data>
  <data key="d7">MTOR, ETV7</data>
  <data key="d8">ETV7-mTOR complex</data>
</node>
<node id="PH_DOMAIN">
  <data key="d1">PH_DOMAIN</data>
  <data key="d2">mSin1 PH domain</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">C-terminal pleckstrin-homology domain of mSin1; in the basal state it folds back onto the mTOR kinase domain and suppresses catalysis, and binding of PtdIns(3,4,5)P3 releases this autoinhibition at the plasma membrane.</data>
  <data key="d7">MAPKAP1</data>
  <data key="d8">PH</data>
</node>
<node id="PRR5">
  <data key="d1">PRR5</data>
  <data key="d2">Protor-1</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Accessory mTORC2 subunit binding Rictor; dispensable for complex assembly but implicated in efficient mTORC2-dependent SGK1 activation, notably in kidney.</data>
  <data key="d7">PRR5</data>
  <data key="d8"></data>
</node>
<node id="PRR5L">
  <data key="d1">PRR5L</data>
  <data key="d2">Protor-2</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Accessory Rictor-binding mTORC2 subunit, paralogue of Protor-1; its degradation has been linked to enhanced mTORC2-dependent PKCδ phosphorylation and cell migration.</data>
  <data key="d7">PRR5L</data>
  <data key="d8"></data>
</node>
<node id="RAIP_MOTIF">
  <data key="d1">RAIP_MOTIF</data>
  <data key="d2">RAIP motif</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">N-terminal sequence of 4E-BP1 that binds Raptor and cooperates with the C-terminal TOS motif in substrate recruitment.</data>
  <data key="d7"></data>
  <data key="d8">RAIP</data>
</node>
<node id="RBD_DOMAIN">
  <data key="d1">RBD_DOMAIN</data>
  <data key="d2">mSin1 Ras-binding domain</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Ras-binding domain of mSin1, which engages Ras-family GTPases and couples Ras signalling to mTORC2; its functional contribution remains incompletely resolved.</data>
  <data key="d7">MAPKAP1</data>
  <data key="d8">RBD</data>
</node>
<node id="RICTOR">
  <data key="d1">RICTOR</data>
  <data key="d2">Rictor</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Defining, rapamycin-insensitive subunit of mTORC2; binds mSin1 through its N-terminal region, contributes to steric occlusion of the FRB domain, and forms part of the N-terminal mooring that engages the Akt kinase C-lobe.</data>
  <data key="d7">RICTOR</data>
  <data key="d8">PIA; mAVO3; rapamycin-insensitive companion of mTOR</data>
</node>
<node id="RPTOR">
  <data key="d1">RPTOR</data>
  <data key="d2">Raptor</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">1335-residue defining subunit of mTORC1: N-terminal caspase-like domain (non-proteolytic), HEAT-like central region, C-terminal WD40 beta-propeller. Wraps the mTOR N-HEAT solenoid and presents the outward-facing TOS-motif substrate surface.</data>
  <data key="d7">RPTOR</data>
  <data key="d8">KIAA1303; KOG1; raptor; regulatory-associated protein of mTOR</data>
</node>
<node id="TOS_MOTIF">
  <data key="d1">TOS_MOTIF</data>
  <data key="d2">TOS motif (TOR signalling motif)</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">4</data>
  <data key="d6">Five-residue F [DE] [IML] [DE] [LI] motif (S6K1 FDIDL, 4E-BP1 FEMDI, PRAS40 FVMDE, HIF-1alpha) that docks substrates and PRAS40 onto Raptor and so onto mTORC1; mutation of the motif abolishes mTORC1-dependent phosphorylation.</data>
  <data key="d7"></data>
  <data key="d8">TOS</data>
</node>
<node id="MCOLN1">
  <data key="d1">MCOLN1</data>
  <data key="d2">TRPML1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">4</data>
  <data key="d6">Lysosomal cation channel releasing local Ca2+ on mTORC1 inhibition or lysosomal stress, activating calcineurin; itself a CLEAR-network target gene, forming a feed-forward loop with TFEB.</data>
  <data key="d7">MCOLN1</data>
  <data key="d8">mucolipin-1</data>
</node>
<node id="MAPKAP1_ISOFORM5">
  <data key="d1">MAPKAP1_ISOFORM5</data>
  <data key="d2">mSin1 isoform 5 (mSin1.5, PH-domain-less)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">4</data>
  <data key="d6">Splice isoform of mSin1 lacking the C-terminal PH domain; assembles an mTORC2 species whose AKT Ser473 kinase activity is not gated by insulin/PIP3 (Frias et al. 2006).</data>
  <data key="d7">MAPKAP1</data>
  <data key="d8">SIN1 isoform 5; mSin1.5</data>
</node>
<node id="VAR_MTOR_FAT_GOF">
  <data key="d1">VAR_MTOR_FAT_GOF</data>
  <data key="d2">MTOR FAT-domain hotspot variants</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">4</data>
  <data key="d6">Activating MTOR substitutions in the FAT domain, including A1459P, C1483Y and E1799K; effects on substrate phosphorylation and inhibitor binding vary by variant.</data>
  <data key="d7">MTOR</data>
  <data key="d8"></data>
</node>
<node id="VAR_MTOR_KINASE_GOF">
  <data key="d1">VAR_MTOR_KINASE_GOF</data>
  <data key="d2">MTOR kinase-domain hotspot variants</data>
  <data key="d3">gene_variant</data>
  <data key="d4">tissue_physiology_disease</data>
  <data key="d5">4</data>
  <data key="d6">Activating substitutions in the MTOR kinase domain, including S2215Y and E2419K. FRB resistance substitutions such as F2108L are a distinct class.</data>
  <data key="d7">MTOR</data>
  <data key="d8"></data>
</node>
<node id="BTRC">
  <data key="d1">BTRC</data>
  <data key="d2">betaTrCP</data>
  <data key="d3">protein</data>
  <data key="d4">core_complexes</data>
  <data key="d5">5</data>
  <data key="d6">F-box substrate-recognition subunit of the SCF E3 ubiquitin ligase; binds phosphodegron-bearing DEPTOR and directs its polyubiquitination and proteasomal destruction.</data>
  <data key="d7">BTRC</data>
  <data key="d8">BTRCP; FBXW1; FBXW1A; SCF-betaTrCP; beta-TrCP</data>
</node>
<node id="EIF4EBP1">
  <data key="d1">EIF4EBP1</data>
  <data key="d2">4E-BP1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">Translational repressor of eIF4E, phosphorylated hierarchically by mTORC1 (Thr37/Thr46 first, then Thr70 and Ser65). Thr37/Thr46 are the rapamycin-resistant sites that define the limits of rapalog pharmacology.</data>
  <data key="d7">EIF4EBP1</data>
  <data key="d8">4EBP1; PHAS-I</data>
</node>
<node id="EIF4EBP2">
  <data key="d1">EIF4EBP2</data>
  <data key="d2">4E-BP2</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">4E-BP paralogue predominant in brain; mTORC1 substrate sharing 4E-BP1 phosphosites; its loss enhances LTP yet produces autism-like behaviour via excess eIF4E-dependent translation.</data>
  <data key="d7">EIF4EBP2</data>
  <data key="d8"></data>
</node>
<node id="LARP1">
  <data key="d1">LARP1</data>
  <data key="d2">LARP1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">La-related protein 1; DM15 domain binds the m7G cap and adjacent 5'TOP motif when mTORC1 is inactive, excluding eIF4F; mTORC1 phosphorylation releases TOP mRNAs. Also binds Raptor and PABP and stabilises TOP mRNAs.</data>
  <data key="d7">LARP1</data>
  <data key="d8">La-related protein 1</data>
</node>
<node id="MAF1">
  <data key="d1">MAF1</data>
  <data key="d2">MAF1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">Conserved RNA polymerase III repressor; mTORC1 phosphorylation at Ser60, Ser68 and Ser75 inactivates it, derepressing tRNA and 5S rRNA transcription.</data>
  <data key="d7">MAF1</data>
  <data key="d8">Maf1</data>
</node>
<node id="PPP2CA">
  <data key="d1">PPP2CA</data>
  <data key="d2">PP2A</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">Protein phosphatase 2A catalytic subunit; associates with S6K1 and dephosphorylates S6K1 Thr389 and TIF-IA Ser199 when mTORC1 is inhibited by rapamycin.</data>
  <data key="d7">PPP2CA</data>
  <data key="d8">PP2A-C</data>
</node>
<node id="RPS6KB1">
  <data key="d1">RPS6KB1</data>
  <data key="d2">S6K1 (p70 S6 kinase 1)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">AGC kinase activated by mTORC1 (Thr389) and PDK1 (Thr229); phosphorylates rpS6, eIF4B, PDCD4, SKAR, eEF2K, UBF, CBP80, mTOR Ser2448 and IRS-1. Controls cell size; fully rapamycin-sensitive.</data>
  <data key="d7">RPS6KB1</data>
  <data key="d8">S6K1; p70 S6 kinase; p70S6K</data>
</node>
<node id="RPS6KB2">
  <data key="d1">RPS6KB2</data>
  <data key="d2">S6K2 (p70 S6 kinase 2)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">S6K1 paralogue activated by mTORC1 at Thr388; predominantly nuclear; principal rpS6 kinase in S6K1-null cells; S6K1/S6K2 double knockout is perinatally lethal.</data>
  <data key="d7">RPS6KB2</data>
  <data key="d8">S6K2; p70S6Kbeta</data>
</node>
<node id="RRN3">
  <data key="d1">RRN3</data>
  <data key="d2">TIF-IA (RRN3)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">Pol I transcription initiation factor bridging initiation-competent Pol I to SL1; mTOR-dependent Ser44 phosphorylation and rapamycin-induced Ser199 dephosphorylation control its activity and nucleolar localisation.</data>
  <data key="d7">RRN3</data>
  <data key="d8">RRN3; TIF-IA</data>
</node>
<node id="UBTF">
  <data key="d1">UBTF</data>
  <data key="d2">UBF</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">5</data>
  <data key="d6">Upstream binding factor; HMG-box nucleolar transcription factor binding rDNA, recruiting SL1 and Pol I; its C-terminal activation domain is phosphorylated in an mTOR/S6K1-dependent manner.</data>
  <data key="d7">UBTF</data>
  <data key="d8">upstream binding transcription factor</data>
</node>
<node id="AMBRA1">
  <data key="d1">AMBRA1</data>
  <data key="d2">AMBRA1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Beclin-1-interacting autophagy activator and scaffold for TRAF6-mediated ULK1 ubiquitylation; mTORC1 phosphorylation holds it inactive, coupling nutrient status to ULK1 stability.</data>
  <data key="d7">AMBRA1</data>
  <data key="d8">activating molecule in BECN1-regulated autophagy 1</data>
</node>
<node id="ATG101">
  <data key="d1">ATG101</data>
  <data key="d2">ATG101</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">HORMA-domain subunit of the ULK1 initiation complex that stabilises ATG13 and is required for autophagy initiation.</data>
  <data key="d7">ATG101</data>
  <data key="d8">C12orf44</data>
</node>
<node id="ATG13">
  <data key="d1">ATG13</data>
  <data key="d2">ATG13</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Adaptor subunit of the ULK1 initiation complex, bridging ULK1 and FIP200; phosphorylated by mTORC1 as part of layered repression of phagophore initiation.</data>
  <data key="d7">ATG13</data>
  <data key="d8">KIAA0652</data>
</node>
<node id="ATG14">
  <data key="d1">ATG14</data>
  <data key="d2">ATG14L</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Autophagy-specific targeting subunit of the class III PI3K complex I; phosphorylated by mTORC1 (inhibitory) and by ULK1 at Ser29 (activating), setting VPS34 lipid-kinase activity at the phagophore.</data>
  <data key="d7">ATG14</data>
  <data key="d8">Barkor</data>
</node>
<node id="EP300">
  <data key="d1">EP300</data>
  <data key="d2">p300</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Acetyltransferase that acetylates ATG proteins to suppress autophagy and acetylates lipogenic regulators; phosphorylated by mTORC1, coupling nutrient status to acetylation-dependent autophagy and lipid output.</data>
  <data key="d7">EP300</data>
  <data key="d8">KAT3B</data>
</node>
<node id="GRB10">
  <data key="d1">GRB10</data>
  <data key="d2">Grb10</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Adaptor stabilised by mTORC1 phosphorylation that inhibits insulin and IGF-1 receptor signalling; a second feedback brake lost when mTORC1 is pharmacologically inhibited.</data>
  <data key="d7">GRB10</data>
  <data key="d8">GRB10 adaptor; growth factor receptor-bound protein 10</data>
</node>
<node id="LPIN1">
  <data key="d1">LPIN1</data>
  <data key="d2">Lipin1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Phosphatidate phosphatase and nuclear SREBP antagonist; mTORC1 phosphorylation retains it in the cytoplasm, which is how mTORC1 controls nuclear SREBP activity.</data>
  <data key="d7">LPIN1</data>
  <data key="d8">lipin 1</data>
</node>
<node id="PPP3">
  <data key="d1">PPP3</data>
  <data key="d2">calcineurin</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Calcium- and calmodulin-dependent serine/threonine phosphatase; the target of the FKBP12-FK506 and cyclophilin-cyclosporine complexes, and not a target of the FKBP12-rapamycin complex.</data>
  <data key="d7">PPP3CA, PPP3CB, PPP3R1</data>
  <data key="d8">PP2B; protein phosphatase 3</data>
</node>
<node id="RB1CC1">
  <data key="d1">RB1CC1</data>
  <data key="d2">FIP200</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Scaffold subunit of the ULK1 initiation complex, required for phagophore nucleation and for ULK1 kinase activity and stability.</data>
  <data key="d7">RB1CC1</data>
  <data key="d8">RB1-inducible coiled-coil 1</data>
</node>
<node id="RUBCNL">
  <data key="d1">RUBCNL</data>
  <data key="d2">Pacer</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Rubicon-like autophagy enhancer that promotes autophagosome-lysosome fusion by engaging HOPS and STX17; reported mTORC1 substrate linking nutrient status to maturation.</data>
  <data key="d7">RUBCNL</data>
  <data key="d8">KIAA0226L</data>
</node>
<node id="STAT3">
  <data key="d1">STAT3</data>
  <data key="d2">STAT3</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Transcription factor whose Ser727 transactivation-domain phosphorylation is rapamycin-sensitive and mTOR-dependent, linking mTORC1 to inflammatory and metabolic transcription.</data>
  <data key="d7">STAT3</data>
  <data key="d8">signal transducer and activator of transcription 3</data>
</node>
<node id="TFE3">
  <data key="d1">TFE3</data>
  <data key="d2">TFE3</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">MiT/TFE-family paralogue of TFEB, phosphorylated by mTORC1 at equivalent sites (Ser321) and similarly retained in the cytoplasm by 14-3-3.</data>
  <data key="d7">TFE3</data>
  <data key="d8">transcription factor E3</data>
</node>
<node id="TFEB">
  <data key="d1">TFEB</data>
  <data key="d2">TFEB</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Master transcription factor of the autophagy–lysosome (CLEAR) programme, inhibited by mTORC1-dependent phosphorylation and cytoplasmic retention; reported to feed back onto peripheral clock gene expression.</data>
  <data key="d7">TFEB</data>
  <data key="d8">transcription factor EB</data>
</node>
<node id="ULK1">
  <data key="d1">ULK1</data>
  <data key="d2">ULK1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Autophagy-initiating kinase (ULK1-ATG13-FIP200-ATG101). Activated by AMPK phosphorylation (Ser317/Ser555/Ser777) and inhibited by mTORC1 Ser757 phosphorylation, which disrupts ULK1-AMPK binding; feeds back on AMPK.</data>
  <data key="d7">ULK1</data>
  <data key="d8">ATG1; ATG1 homologue; ULK1-ATG13-FIP200 complex; Unc-51-like kinase 1</data>
</node>
<node id="UVRAG">
  <data key="d1">UVRAG</data>
  <data key="d2">UVRAG</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">Beclin-1 partner in class III PI3K complex II that promotes autophagosome and endosome maturation; mTORC1 phosphorylation at Ser498 restrains this maturation step.</data>
  <data key="d7">UVRAG</data>
  <data key="d8">UV radiation resistance-associated gene protein</data>
</node>
<node id="WIPI2">
  <data key="d1">WIPI2</data>
  <data key="d2">WIPI2</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">5</data>
  <data key="d6">PI(3)P effector that recruits the ATG12-ATG5-ATG16L1 conjugation machinery to the phagophore; mTORC1 phosphorylation promotes its ubiquitin-dependent degradation.</data>
  <data key="d7">WIPI2</data>
  <data key="d8">Atg18 homologue</data>
</node>
<node id="ARHGEF3">
  <data key="d1">ARHGEF3</data>
  <data key="d2">XPLN (ARHGEF3)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">Rho-family guanine nucleotide exchange factor reported as an endogenous mTORC2 inhibitor that binds Rictor and suppresses AKT Ser473 phosphorylation, GEF-independently. HGNC symbol not asserted here.</data>
  <data key="d7">ARHGEF3</data>
  <data key="d8">XPLN; exchange factor found in platelets, leukocytic and neuronal tissue</data>
</node>
<node id="PKC">
  <data key="d1">PKC</data>
  <data key="d2">Protein kinase C (generic)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">PKC family; mTORC2 supports maturation of selected isoforms through turn-motif/TOR-interaction-motif priming. Hydrophobic-motif phosphorylation can occur by PKC autophosphorylation.</data>
  <data key="d7">PRKCA</data>
  <data key="d8">PKC isoforms; PKCalpha</data>
</node>
<node id="PRKCA">
  <data key="d1">PRKCA</data>
  <data key="d2">PKCα</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">Conventional PKC isoform phosphorylated cotranslationally by ribosome-associated mTORC2 at turn and hydrophobic motifs, a requirement for its folding and stability.</data>
  <data key="d7">PRKCA</data>
  <data key="d8">PKC alpha; PKCa</data>
</node>
<node id="PRKCB">
  <data key="d1">PRKCB</data>
  <data key="d2">PKCβII</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">Conventional PKC isoform whose turn motif (Thr641) and hydrophobic motif (Ser660) are mTORC2-dependent priming sites required for a stable, signalling-competent enzyme.</data>
  <data key="d7">PRKCB</data>
  <data key="d8">PKC beta II</data>
</node>
<node id="PRKCD">
  <data key="d1">PRKCD</data>
  <data key="d2">PKCδ</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">Novel PKC isoform whose turn- and hydrophobic-motif phosphorylation by mTORC2 supports its stability and its contribution to migration signalling.</data>
  <data key="d7">PRKCD</data>
  <data key="d8">PKC delta</data>
</node>
<node id="PRKCE">
  <data key="d1">PRKCE</data>
  <data key="d2">PKCε</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">Novel PKC isoform among the mTORC2-primed PKCs; priming-site phosphorylation is required for maturation and stability.</data>
  <data key="d7">PRKCE</data>
  <data key="d8">PKC epsilon</data>
</node>
<node id="PRKCZ">
  <data key="d1">PRKCZ</data>
  <data key="d2">PKCζ</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">Atypical PKC; mTORC2-dependent turn-motif phosphorylation supports its stability, and as part of the Par3–Par6–aPKC module it establishes epithelial apicobasal polarity.</data>
  <data key="d7">PRKCZ</data>
  <data key="d8">aPKC zeta</data>
</node>
<node id="SGK1">
  <data key="d1">SGK1</data>
  <data key="d2">SGK1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc2_regulation_and_outputs</data>
  <data key="d5">5</data>
  <data key="d6">Serum- and glucocorticoid-induced kinase 1; mTORC2 substrate at hydrophobic-motif Ser422, governing distal nephron ion transport through ENaC, Na+/K+-ATPase and CLC-K, and phosphorylating NDRG1.</data>
  <data key="d7">SGK1</data>
  <data key="d8">SGK</data>
</node>
<node id="RIBOSOME">
  <data key="d1">RIBOSOME</data>
  <data key="d2">Ribosome</data>
  <data key="d3">complex</data>
  <data key="d4">core_complexes</data>
  <data key="d5">6</data>
  <data key="d6">Translating ribosome; a minor subset of mTORC2 associates with it, which both activates mTORC2 in a growth-factor-responsive manner and permits cotranslational turn-motif phosphorylation of nascent AGC kinases.</data>
  <data key="d7"></data>
  <data key="d8">80S ribosome; polysome</data>
</node>
<node id="BRF1">
  <data key="d1">BRF1</data>
  <data key="d2">Brf1 (TFIIIB)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">TFIIIB subunit required to recruit Pol III to tRNA and 5S promoters; direct binding target of MAF1-mediated repression.</data>
  <data key="d7">BRF1</data>
  <data key="d8">TFIIIB90</data>
</node>
<node id="CCND1">
  <data key="d1">CCND1</data>
  <data key="d2">Cyclin D1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">G1 cyclin encoded by a structured-5'UTR mRNA whose translation is eIF4E/4E-BP-dependent; a key oncogenic output of mTORC1.</data>
  <data key="d7">CCND1</data>
  <data key="d8">cyclin D1</data>
</node>
<node id="EEF2">
  <data key="d1">EEF2</data>
  <data key="d2">eEF2</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">GTPase catalysing ribosomal translocation during elongation; Thr56 phosphorylation by eEF2K prevents ribosome binding and halts elongation.</data>
  <data key="d7">EEF2</data>
  <data key="d8">elongation factor 2</data>
</node>
<node id="EEF2K">
  <data key="d1">EEF2K</data>
  <data key="d2">eEF2 kinase</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Ca2+/calmodulin-dependent alpha-kinase that phosphorylates eEF2 Thr56 to slow elongation; inhibited by S6K1/RSK phosphorylation at Ser366 and by mTOR-dependent Ser78 phosphorylation.</data>
  <data key="d7">EEF2K</data>
  <data key="d8">CaMKIII; eEF2K</data>
</node>
<node id="EIF3">
  <data key="d1">EIF3</data>
  <data key="d2">eIF3 complex</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Multisubunit 43S preinitiation-complex factor that scaffolds inactive S6K1 and recruits mTORC1 upon stimulation; bridged to eIF4F through eIF4G and bound by phospho-eIF4B.</data>
  <data key="d7">EIF3A;EIF3B;EIF3C;EIF3D;EIF3E</data>
  <data key="d8">eIF3</data>
</node>
<node id="EIF4A1">
  <data key="d1">EIF4A1</data>
  <data key="d2">eIF4A1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">DEAD-box RNA helicase of eIF4F that unwinds structured 5'UTRs; stimulated by eIF4B and inhibited by PDCD4.</data>
  <data key="d7">EIF4A1</data>
  <data key="d8">eIF4A</data>
</node>
<node id="EIF4B">
  <data key="d1">EIF4B</data>
  <data key="d2">eIF4B</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">RNA-binding cofactor that stimulates eIF4A helicase activity; S6K1/RSK phosphorylation at Ser422 enhances its recruitment to eIF3/preinitiation complexes and translation of structured 5'UTRs such as c-Myc.</data>
  <data key="d7">EIF4B</data>
  <data key="d8">eIF-4B</data>
</node>
<node id="EIF4E">
  <data key="d1">EIF4E</data>
  <data key="d2">eIF4E</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Cap-binding subunit of eIF4F and rate-limiting factor for cap-dependent translation; the point at which BMAL1-dependent and 4E-BP1-dependent circadian translational control converge.</data>
  <data key="d7">EIF4E</data>
  <data key="d8">cap-binding protein; eIF-4E; eukaryotic translation initiation factor 4E</data>
</node>
<node id="EIF4F">
  <data key="d1">EIF4F</data>
  <data key="d2">eIF4F complex</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Cap-binding initiation complex (eIF4E, eIF4G, eIF4A) whose assembly is gated by 4E-BP phosphorylation; drives selective translation of cyclin D1, c-Myc, VEGF, HIF-1alpha and Mcl-1 mRNAs.</data>
  <data key="d7">EIF4E;EIF4G1;EIF4A1</data>
  <data key="d8">eIF4F</data>
</node>
<node id="EIF4G1">
  <data key="d1">EIF4G1</data>
  <data key="d2">eIF4G1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Scaffold of eIF4F binding eIF4E (via the YxxxxLPhi motif shared with 4E-BPs), eIF4A, eIF3, PABP and MNK; carries rapamycin-sensitive C-terminal phosphosites.</data>
  <data key="d7">EIF4G1</data>
  <data key="d8">eIF4GI; p220</data>
</node>
<node id="EXON_JUNCTION_COMPLEX">
  <data key="d1">EXON_JUNCTION_COMPLEX</data>
  <data key="d2">Exon junction complex</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Protein complex deposited upstream of exon-exon junctions during splicing; SKAR-dependent recruitment of S6K1 couples splicing to enhanced translation of spliced mRNAs.</data>
  <data key="d7">EIF4A3;MAGOH;RBM8A;CASC3</data>
  <data key="d8">EJC</data>
</node>
<node id="GTF3C">
  <data key="d1">GTF3C</data>
  <data key="d2">TFIIIC</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Pol III promoter-recognition factor for tRNA and 5S genes; reported to associate with mTOR, which is found at tRNA and 5S rRNA genes.</data>
  <data key="d7">GTF3C1;GTF3C2</data>
  <data key="d8"></data>
</node>
<node id="HIF1A">
  <data key="d1">HIF1A</data>
  <data key="d2">HIF-1alpha</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Oxygen-labile transcription factor stabilised under hypoxia (loss of PHD/VHL-dependent degradation). Upstream of mTORC1 it induces REDD1 (DDIT4) and BNIP3; downstream it is an mTORC1 translational target (feedback).</data>
  <data key="d7">HIF1A</data>
  <data key="d8">HIF1-alpha; HIF1alpha; hypoxia-inducible factor 1 alpha</data>
</node>
<node id="MCL1">
  <data key="d1">MCL1</data>
  <data key="d2">Mcl-1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Anti-apoptotic BCL-2 family protein whose translation is 4E-BP/eIF4E-dependent; mediates mTORC1-dependent survival.</data>
  <data key="d7">MCL1</data>
  <data key="d8"></data>
</node>
<node id="MKNK1">
  <data key="d1">MKNK1</data>
  <data key="d2">MNK1/2</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">MAP kinase-interacting kinases activated by ERK/p38; dock on eIF4G to phosphorylate eIF4E Ser209, an mTORC1-independent modulation of eIF4E oncogenic activity.</data>
  <data key="d7">MKNK1</data>
  <data key="d8">MNK1; MNK2</data>
</node>
<node id="MYC">
  <data key="d1">MYC</data>
  <data key="d2">c-Myc</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Transcription factor with structured-5'UTR mRNA translated in an eIF4F/eIF4B-dependent manner downstream of mTORC1; master transcriptional driver of ribosome biogenesis genes.</data>
  <data key="d7">MYC</data>
  <data key="d8">MYC</data>
</node>
<node id="NCBP1">
  <data key="d1">NCBP1</data>
  <data key="d2">CBP80 (NCBP1)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">80 kDa subunit of the nuclear cap-binding complex bound to mRNAs during the pioneer round of translation; reported S6K1 substrate and S6K1/SKAR-associated factor on spliced mRNAs.</data>
  <data key="d7">NCBP1</data>
  <data key="d8">CBP80; nuclear cap-binding protein 1</data>
</node>
<node id="PABPC1">
  <data key="d1">PABPC1</data>
  <data key="d2">PABP</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Cytoplasmic poly(A)-binding protein 1; binds LARP1 and eIF4G, linking the 3' poly(A) tail to cap-dependent initiation and TOP mRNA stability.</data>
  <data key="d7">PABPC1</data>
  <data key="d8">PABP1</data>
</node>
<node id="PDCD4">
  <data key="d1">PDCD4</data>
  <data key="d2">PDCD4</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Programmed cell death 4; tumour suppressor whose MA3 domains bind eIF4A and block helicase activity; S6K1 phosphorylation at Ser67 creates a betaTrCP degron, triggering proteasomal degradation.</data>
  <data key="d7">PDCD4</data>
  <data key="d8">Pdcd4</data>
</node>
<node id="POLR1">
  <data key="d1">POLR1</data>
  <data key="d2">RNA polymerase I</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Nucleolar polymerase transcribing the 47S pre-rRNA; recruited to rDNA by UBF/SL1 and TIF-IA under mTORC1 control.</data>
  <data key="d7">POLR1A;POLR1B</data>
  <data key="d8">Pol I</data>
</node>
<node id="POLR3">
  <data key="d1">POLR3</data>
  <data key="d2">RNA polymerase III</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Polymerase transcribing tRNA and 5S rRNA genes; recruited by TFIIIB/TFIIIC and repressed by dephosphorylated MAF1.</data>
  <data key="d7">POLR3A;POLR3B</data>
  <data key="d8">Pol III</data>
</node>
<node id="PRE_RRNA_47S">
  <data key="d1">PRE_RRNA_47S</data>
  <data key="d2">47S pre-rRNA</data>
  <data key="d3">rna</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Pol I primary transcript processed into 18S, 5.8S and 28S rRNAs; its synthesis is the rate-limiting, mTORC1-scaled step of ribosome biogenesis.</data>
  <data key="d7"></data>
  <data key="d8">47S rRNA precursor; pre-rRNA</data>
</node>
<node id="RPS6">
  <data key="d1">RPS6</data>
  <data key="d2">Ribosomal protein S6</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">40S ribosomal protein phosphorylated by S6K1/2 at Ser235/236/240/244 (and by RSK at Ser235/236). Phosphorylation determines cell size and glucose homeostasis; its classical role in TOP mRNA translation is no longer accepted.</data>
  <data key="d7">RPS6</data>
  <data key="d8">eS6; rpS6</data>
</node>
