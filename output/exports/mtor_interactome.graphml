<edge source="RAPALINK1" target="VAR_FRB_RESISTANCE" id="other:8902e3bbbfece4d7">
  <data key="d9">RAPALINK1</data>
  <data key="d10">VAR_FRB_RESISTANCE</data>
  <data key="d11">other</data>
  <data key="d12">inhibits</data>
  <data key="d13">RapaLink-1 tethers rapamycin to an ATP-competitive mTOR inhibitor, so that FKBP12-rapamycin anchoring at the FRB domain delivers the active-site moiety with high avidity. Potency is therefore retained against FRB-domain substitutions such as A2034V and F2108L, which weaken FKBP12-rapamycin binding and confer rapalog resistance, and against the kinase-domain substitution M2327I, which confers resistance to ATP-competitive inhibitors used alone.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">501</data>
  <data key="d17">FRB-domain and kinase-domain mTOR resistance mutants</data>
  <data key="d18">pharmacological</data>
  <data key="d19"></data>
  <data key="d20">pharmacology</data>
  <data key="d21">-1</data>
</edge>
