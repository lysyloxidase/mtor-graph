  <data key="d10">PHENO_HYPERGLYCAEMIA</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">activates</data>
  <data key="d13">Hyperglycaemia at immunosuppressive exposures reflects hepatic, adipose and beta-cell physiology, chiefly through loss of mTORC2 signalling.</data>
  <data key="d14">established</data>
