  <data key="d10">TISSUE_KIDNEY_TUBULE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">mTORC2-dependent SGK1 activity governs ion handling in the distal nephron and therefore sodium balance and blood pressure; renal mTORC2 loss causes salt wasting and hypotension.</data>
  <data key="d14">established</data>
