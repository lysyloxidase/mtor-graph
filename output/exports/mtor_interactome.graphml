  <data key="d1">SKAR</data>
  <data key="d2">SKAR (POLDIP3)</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">S6K1 Aly/REF-like target; exon-junction-complex component phosphorylated by S6K1 (Ser383/Ser385) that recruits active S6K1 to newly spliced mRNAs to enhance pioneer-round translation.</data>
  <data key="d7">POLDIP3</data>
  <data key="d8">PDIP46; POLDIP3</data>
</node>
<node id="SL1_TIF_IB">
  <data key="d1">SL1_TIF_IB</data>
  <data key="d2">SL1/TIF-IB (TBP–TAF1A/TAF1B/TAF1C)</data>
  <data key="d3">complex</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Promoter selectivity factor of RNA polymerase I: a TBP-containing complex (TAF1A/TAF1B/TAF1C) that, together with UBF, nucleates the pre-initiation complex at the rDNA promoter. RRN3/TIF-IA bridges initiation-competent Pol I to promoter-bound SL1, which is the step at which the mTORC1–TIF-IA input is transduced into 47S pre-rRNA synthesis.</data>
  <data key="d7"></data>
  <data key="d8">SELECTIVITY_FACTOR_1; SL1; TIF-IB; selectivity factor 1</data>
</node>
<node id="TOP_MRNA">
  <data key="d1">TOP_MRNA</data>
  <data key="d2">5'TOP mRNAs</data>
  <data key="d3">rna</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">mRNAs with a 5'-terminal oligopyrimidine motif encoding ribosomal proteins, elongation factors and PABP; translationally repressed by LARP1 (and 4E-BPs) when mTORC1 is inactive.</data>
  <data key="d7"></data>
  <data key="d8">TOP mRNAs; terminal oligopyrimidine mRNAs</data>
</node>
<node id="TRNA">
  <data key="d1">TRNA</data>
  <data key="d2">tRNA</data>
  <data key="d3">rna</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Pol III-transcribed transfer RNAs whose supply is scaled with ribosome production via mTORC1-MAF1 signalling.</data>
  <data key="d7"></data>
  <data key="d8">transfer RNA</data>
</node>
<node id="VEGFA">
  <data key="d1">VEGFA</data>
  <data key="d2">VEGF-A</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Angiogenic growth factor transcriptionally induced by HIF-1alpha and translationally dependent on eIF4E, linking mTORC1 output to the tumour angiogenic programme.</data>
  <data key="d7">VEGFA</data>
  <data key="d8">VEGF</data>
</node>
<node id="ACACA">
  <data key="d1">ACACA</data>
  <data key="d2">Acetyl-CoA carboxylase 1</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">6</data>
  <data key="d6">SREBP1 target catalysing the committed, rate-limiting carboxylation of acetyl-CoA to malonyl-CoA in de novo lipogenesis.</data>
