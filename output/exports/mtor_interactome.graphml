  <data key="d10">PHENO_PROTEIN_AGGREGATES</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">CCI-779 (temsirolimus), the soluble ester analogue of rapamycin, induces autophagy and reduces polyglutamine aggregate burden and toxicity in fly and mouse models of Huntington disease.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">488</data>
