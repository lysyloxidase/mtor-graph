</edge>
<edge source="VISTUSERTIB" target="MTORC2" id="drug_inhibition:c932fc9e37074e77">
  <data key="d9">VISTUSERTIB</data>
  <data key="d10">MTORC2</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">Because the ATP site is shared by both complexes and is not occluded by Rictor or mSin1, vistusertib inhibits mTORC2 as completely as mTORC1, abolishing AKT Ser473 phosphorylation; this is the source of the added metabolic toxicity of the ATP-competitive class.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">112; 166; 473</data>
  <data key="d17"></data>
  <data key="d18">pharmacological</data>
  <data key="d19">Site is the AKT readout of mTORC2 activity.</data>
  <data key="d20">pharmacology</data>
  <data key="d21">-1</data>
</edge>
<edge source="VISTUSERTIB" target="PHENO_HYPERGLYCAEMIA" id="physiological_output:238f47870c8afa2a">
