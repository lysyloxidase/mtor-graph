  <data key="d10">DISEASE_RCC</data>
  <data key="d11">genetic_gain_of_function</data>
  <data key="d12">activates</data>
  <data key="d13">Activating MTOR mutations occur in renal cell carcinoma; domain assignment and functional activation must be established for each variant.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">201</data>
  <data key="d17">renal cell carcinoma</data>
  <data key="d18">pathophysiological</data>
