  <data key="d9">FAT_DOMAIN</data>
  <data key="d10">MTOR</data>
  <data key="d11">binding</data>
  <data key="d12">component_of</data>
  <data key="d13">The FAT (FRAP-ATM-TRRAP) alpha-helical domain wraps around the kinase domain and is a defining feature of the PIKK family.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">315; 588; 670</data>
  <data key="d17"></data>
