  <data key="d9">VAR_FLCN_LOF</data>
  <data key="d10">FLCN</data>
  <data key="d11">genetic_loss_of_function</data>
  <data key="d12">inhibits</data>
  <data key="d13">Germline FLCN loss abolishes RagC/D GAP activity, dysregulating mTORC1 in a tissue-dependent rather than uniformly increased manner</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">468; 534; 610</data>
  <data key="d17">human germline</data>
  <data key="d18">pathophysiological</data>
