<edge source="RAPAMYCIN" target="AUTOPHAGY" id="drug_inhibition:91d5cf6765900469">
  <data key="d9">RAPAMYCIN</data>
  <data key="d10">AUTOPHAGY</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">activates</data>
  <data key="d13">Pharmacological mTOR inhibition induces autophagy and accelerates clearance of misfolded aggregates in cellular and animal models; this is the whole basis of the neurodegeneration rationale.</data>
