<edge source="MTOR" target="PHENO_LIFESPAN_EXTENSION" id="physiological_output:d7a230d150902ff8">
  <data key="d9">MTOR</data>
  <data key="d10">PHENO_LIFESPAN_EXTENSION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Mice with genetically reduced mTOR expression live longer and show a segmental, tissue-specific slowing of ageing, indicating that the lifespan effect of rapamycin reflects on-target mTOR inhibition rather than an off-target drug action.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
