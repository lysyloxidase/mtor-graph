  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19"></data>
  <data key="d20">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d21">1</data>
</edge>
<edge source="RPS6KB1" target="BMAL1" id="phosphorylation:3be514d721af0430">
  <data key="d9">RPS6KB1</data>
  <data key="d10">BMAL1</data>
  <data key="d11">phosphorylation</data>
  <data key="d12">activates</data>
  <data key="d13">S6K1 phosphorylates BMAL1, licensing its association with the translational machinery and so coupling nutrient status and mTORC1 activity to rhythmic cap-dependent translation.</data>
  <data key="d14">established</data>
  <data key="d15">Ser42</data>
  <data key="d16">354</data>
  <data key="d17">mouse liver; nutrient-responsive</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">Site numbering is mouse BMAL1 (Ser42) as reported by Lipton 2015; confirm residue numbering against the human sequence before display.</data>
  <data key="d20">circadian</data>
  <data key="d21">1</data>
</edge>
<edge source="RPS6KB1" target="PHENO_INSULIN_RESISTANCE" id="physiological_output:754e47e4e24cf6d0">
  <data key="d9">RPS6KB1</data>
  <data key="d10">PHENO_INSULIN_RESISTANCE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">Chronic mTORC1 activation in obesity contributes to insulin resistance through S6K1-mediated inhibitory phosphorylation of IRS-1, and through lipotoxic consequences of constrained storage capacity.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">377</data>
  <data key="d17">adipose tissue; obesity</data>
  <data key="d18">feedback</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="RPS6KB1" target="PHENO_LIFESPAN_EXTENSION" id="physiological_output:7d8f76f121856147">
  <data key="d9">RPS6KB1</data>
  <data key="d10">PHENO_LIFESPAN_EXTENSION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Germline deletion of S6K1 extends median lifespan by about 19% in female mice, with no significant effect in males, placing one mTORC1 substrate arm within the longevity mechanism.</data>
  <data key="d14">emerging</data>
  <data key="d15"></data>
  <data key="d16">541</data>
  <data key="d17">female mice</data>
  <data key="d18">pathophysiological</data>
  <data key="d19">The lifespan effect comes from a single mouse cohort and has not been independently replicated; S6K1-null females also showed increased AMPK activation and a caloric restriction-like gene expression profile.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">-1</data>
</edge>
