  <data key="d16">275</data>
  <data key="d17">glutamine stimulation; Rag-independent</data>
  <data key="d18">upstream_of_mTORC1</data>
  <data key="d19">The Arf1-dependent, Rag-independent glutamine route has been reported by one laboratory lineage (Jewell 2015; Meng 2020) and has not been independently reproduced.</data>
  <data key="d20">lysosomal_nutrient_sensing</data>
  <data key="d21">1</data>
</edge>
