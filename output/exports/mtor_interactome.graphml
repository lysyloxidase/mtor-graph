</edge>
<edge source="MTORC1" target="TISSUE_OLIGODENDROCYTE" id="physiological_output:8bf2ba4f11a95656">
  <data key="d9">MTORC1</data>
  <data key="d10">TISSUE_OLIGODENDROCYTE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">Oligodendrocyte-lineage Raptor loss delays onset of myelination and produces persistent hypomyelination with reduced sheath thickness, whereas Rictor loss has modest and largely transient effects; the requirement is regional, with spinal cord affected more than corpus callosum.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">39; 332</data>
  <data key="d17">oligodendrocyte lineage; regional (spinal cord &gt; corpus callosum)</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="TISSUE_ORAL_EPITHELIUM" id="physiological_output:7263df6a0a795cf0">
  <data key="d9">MTORC1</data>
  <data key="d10">TISSUE_ORAL_EPITHELIUM</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">Rapidly renewing oral epithelium depends on mTORC1, which is why stomatitis affects roughly 30-60% of treated patients depending on indication and is substantially preventable with topical dexamethasone or tacrolimus prophylaxis.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
