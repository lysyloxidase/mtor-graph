<edge source="TSC2" target="RHEB" id="gap_activity:a6e1c1ef3ca78c12">
  <data key="d9">TSC2</data>
  <data key="d10">RHEB</data>
  <data key="d11">gap_activity</data>
  <data key="d12">inhibits</data>
  <data key="d13">TSC2 GAP domain accelerates Rheb GTP hydrolysis ~100-fold via an asparagine-thumb mechanism, converting Rheb·GTP to inactive Rheb·GDP; Rheb has no established GEF.</data>
  <data key="d14">established</data>
  <data key="d15">Asn1643 (TSC2 asparagine thumb)</data>
  <data key="d16">261; 390; 600; 673</data>
  <data key="d17"></data>
  <data key="d18">upstream_of_mTORC1</data>
  <data key="d19">GAP polarity: TSC2 is the GAP (negative regulator); loss of TSC1/TSC2 gives constitutive Rheb·GTP and mTORC1 activation.</data>
  <data key="d20">growth_factor_input</data>
  <data key="d21">-1</data>
</edge>
<edge source="TSC2" target="TSC_COMPLEX" id="complex_formation:7aa20ea0cb29bfd3">
  <data key="d9">TSC2</data>
  <data key="d10">TSC_COMPLEX</data>
  <data key="d11">complex_formation</data>
  <data key="d12">component_of</data>
  <data key="d13">Two TSC2 (tuberin) copies supply the Rheb-GAP domains presented at the apex of the arch.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">143; 673</data>
  <data key="d17"></data>
  <data key="d18">upstream_of_mTORC1</data>
