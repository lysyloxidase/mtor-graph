  <data key="d11">drug_inhibition</data>
  <data key="d12">activates</data>
  <data key="d13">Rapalog stomatitis follows from mTORC1 dependence of renewing oral epithelium and is substantially preventable with topical dexamethasone or tacrolimus prophylaxis.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">509</data>
  <data key="d17">oncology and off-label use</data>
  <data key="d18">pathophysiological</data>
  <data key="d19">The only self-reported adverse event significantly more frequent among off-label users.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="RAPAMYCIN" target="PHENO_STOMATITIS" id="physiological_output:3e5fabbe0da3b267">
  <data key="d9">RAPAMYCIN</data>
  <data key="d10">PHENO_STOMATITIS</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">Loss of mTORC1-dependent renewal in oral epithelium produces aphthous-type ulceration in roughly 30-60% of patients, the commonest dose-limiting rapalog toxicity in oncology.</data>
