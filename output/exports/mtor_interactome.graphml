  <data key="d16">693</data>
  <data key="d17">peroxisome</data>
  <data key="d18">upstream_of_mTORC1</data>
  <data key="d19">Pathogenic TSC2 mutations reduce PEX5 binding and abolish peroxisomal localisation, Rheb-GAP activity and reactive-oxygen-species-dependent suppression of mTORC1; reported by a single laboratory.</data>
  <data key="d20">energy_stress_input</data>
  <data key="d21">0</data>
</edge>
