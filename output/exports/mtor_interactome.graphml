  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">Altered hepatic and adipose lipid handling under inhibition of both complexes raises triglycerides and cholesterol in a dose-related manner; monitoring and statin therapy are the usual mitigation.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">568</data>
  <data key="d17">therapeutic exposures</data>
