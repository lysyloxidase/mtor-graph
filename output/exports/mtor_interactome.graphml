  <data key="d10">PHENO_SEIZURES</data>
  <data key="d11">genetic_loss_of_function</data>
  <data key="d12">activates</data>
  <data key="d13">Tsc1 deletion restricted to microglia produces severe early-onset spontaneous recurrent seizures, showing epileptogenesis is not cell-autonomous to neurons.</data>
