  <data key="d1">RRNA_5S</data>
  <data key="d2">5S rRNA</data>
  <data key="d3">rna</data>
  <data key="d4">mtorc1_output_translation_ribosome</data>
  <data key="d5">6</data>
  <data key="d6">Pol III-transcribed ribosomal RNA incorporated into the 60S subunit; transcription repressed by MAF1 and derepressed by mTORC1.</data>
  <data key="d7"></data>
  <data key="d8">5S ribosomal RNA</data>
</node>
