  <data key="d8">HK-II; HKII</data>
</node>
<node id="HMGCR">
  <data key="d1">HMGCR</data>
  <data key="d2">HMG-CoA reductase</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">6</data>
  <data key="d6">Rate-limiting enzyme of the mevalonate pathway and the principal SREBP2 target gene; the statin target, and the effector through which mTORC1–SREBP2 drives cholesterol synthesis.</data>
  <data key="d7">HMGCR</data>
  <data key="d8"></data>
</node>
<node id="IL1A">
  <data key="d1">IL1A</data>
  <data key="d2">IL-1alpha</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">6</data>
  <data key="d6">Interleukin-1 alpha; mTORC1-dependent translation of IL1A is one of the two defined mechanisms by which mTORC1 is required for the senescence-associated secretory phenotype.</data>
