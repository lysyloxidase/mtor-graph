  <data key="d9">MTOR</data>
  <data key="d10">PHENO_TREG_EXPANSION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Deletion of mTOR in naive T cells favoured Foxp3-positive regulatory differentiation in the tested mouse model.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">133</data>
  <data key="d17">de novo Treg differentiation; mouse T cells</data>
  <data key="d18">core</data>
  <data key="d19">This does not establish that mTOR universally inhibits mature Treg expansion or function.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">-1</data>
</edge>
