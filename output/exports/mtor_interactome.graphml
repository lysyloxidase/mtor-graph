  <data key="d10">PHENO_LIFESPAN_EXTENSION</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">activates</data>
  <data key="d13">Rapamycin substantially extends the lifespan of Bmal1-null mice, the key in vivo evidence that their shortened lifespan is mTORC1-dependent.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">304</data>
  <data key="d17">Bmal1-/- mice</data>
