<edge source="FRB_DOMAIN" target="KINASE_DOMAIN" id="binding:609bc42183f8f41a">
  <data key="d9">FRB_DOMAIN</data>
  <data key="d10">KINASE_DOMAIN</data>
  <data key="d11">binding</data>
  <data key="d12">modulates</data>
  <data key="d13">FRB sits at the entrance of the deep catalytic cleft and acts as a gatekeeper: its rapamycin-binding surface contacts substrates and gives them access to the recessed active site. FKBP12-rapamycin bound at FRB therefore restricts substrate access without occupying the ATP site.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">588; 670</data>
  <data key="d17"></data>
  <data key="d18">core</data>
  <data key="d19"></data>
  <data key="d20">core_complexes</data>
  <data key="d21">0</data>
</edge>
<edge source="FRB_DOMAIN" target="MTOR" id="binding:9c8ce4819c6b6ea7">
  <data key="d9">FRB_DOMAIN</data>
  <data key="d10">MTOR</data>
  <data key="d11">binding</data>
  <data key="d12">component_of</data>
  <data key="d13">The ~100-residue four-helix FRB bundle lies between the FAT and kinase domains of the mTOR polypeptide and forms the drug-binding surface.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">98; 315; 588; 670</data>
  <data key="d17"></data>
  <data key="d18">core</data>
  <data key="d19"></data>
  <data key="d20">core_complexes</data>
  <data key="d21">0</data>
</edge>
