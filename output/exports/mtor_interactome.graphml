  <data key="d10">RRAGA</data>
  <data key="d11">ubiquitination</data>
  <data key="d12">inhibits</data>
  <data key="d13">The lysosomal E3 ligase RNF152 attaches K63-linked ubiquitin chains to RagA in an amino-acid-sensitive manner, creating a docking site that recruits GATOR1 and so promotes RagA GTP hydrolysis and mTORC1 inactivation.</data>
  <data key="d14">emerging</data>
  <data key="d15">Lys142; Lys220; Lys230; Lys244</data>
  <data key="d16">135</data>
  <data key="d17">amino-acid starvation</data>
