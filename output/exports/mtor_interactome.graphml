<edge source="RAPAMYCIN" target="PHENO_LIFESPAN_EXTENSION" id="drug_inhibition:86ace68b5e5007a9">
  <data key="d9">RAPAMYCIN</data>
  <data key="d10">PHENO_LIFESPAN_EXTENSION</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">activates</data>
  <data key="d13">Encapsulated rapamycin begun at 600 days of age extended median and maximal lifespan of genetically heterogeneous mice at three independent sites, raising the age at 90% mortality by 9% in males and 14% in females; a threefold higher dose of 42 ppm increased median lifespan by 23% in males and 26% in females, and treatment begun at 20 months extends survival even when given for only three months or in alternating months.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">224; 413; 578</data>
  <data key="d17">genetically heterogeneous mice</data>
  <data key="d18">pharmacological</data>
  <data key="d19">Continuous exposure is not required for lifespan extension, although the benefit of brief or intermittent dosing is sex-dependent.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="RAPAMYCIN" target="PHENO_LIFESPAN_EXTENSION" id="physiological_output:075fefa7575e8e48">
  <data key="d9">RAPAMYCIN</data>
  <data key="d10">PHENO_LIFESPAN_EXTENSION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">Encapsulated rapamycin begun at 600 days of age raised age at 90% mortality by 9% in male and 14% in female genetically heterogeneous mice at three independent sites; a threefold higher dietary dose of 42 ppm raised median lifespan by 23% in males and 26% in females, and late-life intermittent regimens also extended survival.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">224; 413; 578</data>
  <data key="d17">genetically heterogeneous mice, Interventions Testing Program</data>
  <data key="d18">pathophysiological</data>
  <data key="d19">Genetic reduction of mTOR or S6K1 reproduces the effect, supporting on-target action; translation beyond rodents is unproven.</data>
  <data key="d20">pharmacology</data>
  <data key="d21">1</data>
</edge>
