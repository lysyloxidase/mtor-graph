</edge>
<edge source="RAPAMYCIN" target="PHENO_LEAN_MASS" id="physiological_output:9f2673d6c2d2688a">
  <data key="d9">RAPAMYCIN</data>
  <data key="d10">PHENO_LEAN_MASS</data>
  <data key="d11">physiological_output</data>
  <data key="d12">modulates</data>
  <data key="d13">In the PEARL trial, lean tissue mass increased rather than decreased in women receiving 10 mg weekly compounded rapamycin, against the anabolic-resistance concern that chronic mTORC1 inhibition should reduce muscle mass in older adults.</data>
  <data key="d14">emerging</data>
