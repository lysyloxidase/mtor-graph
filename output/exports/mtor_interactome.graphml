<edge source="RAPAMYCIN" target="PHENO_SARCOPENIA" id="drug_inhibition:deb3296b2ffe7aba">
  <data key="d9">RAPAMYCIN</data>
  <data key="d10">PHENO_SARCOPENIA</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">activates</data>
  <data key="d13">Chronic mTORC1 inhibition is predicted to impair the anabolic response of skeletal muscle and to promote sarcopenia; acute rapamycin blocks the contraction-induced rise in human muscle protein synthesis, whereas intermittent low-dose exposure has not produced measurable muscle loss and was associated with increased lean tissue mass in one randomised trial. Whether intermittent dosing preserves the acute anabolic response while lowering chronic tone is unresolved.</data>
  <data key="d14">contested</data>
  <data key="d15"></data>
  <data key="d16">149; 416</data>
  <data key="d17">chronic dosing in older adults</data>
  <data key="d18">pharmacological</data>
  <data key="d19">Human data conflict across exposures, and no trial has tested chronic dosing against a muscle-mass endpoint in older adults.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="RAPAMYCIN" target="PHENO_STOMATITIS" id="drug_inhibition:76ea687d433aedb2">
