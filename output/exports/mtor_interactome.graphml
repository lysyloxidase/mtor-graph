</edge>
<edge source="FKBP12_RAPAMYCIN" target="FRB_DOMAIN" id="binding:b3386087004d9a20">
  <data key="d9">FKBP12_RAPAMYCIN</data>
  <data key="d10">FRB_DOMAIN</data>
  <data key="d11">binding</data>
  <data key="d12">inhibits</data>
  <data key="d13">The ternary structure shows the drug sandwiched between FKBP12 and a hydrophobic FRB cleft; neither protein contacts the other substantially, so binding is strictly drug-dependent.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">24; 108</data>
  <data key="d17"></data>
  <data key="d18">pharmacological</data>
  <data key="d19">Ternary complex structure: Choi 1996, reference [108].</data>
  <data key="d20">pharmacology</data>
  <data key="d21">-1</data>
</edge>
<edge source="FKBP12_RAPAMYCIN" target="MTOR" id="sequestration:8c88a5035c6efb01">
  <data key="d9">FKBP12_RAPAMYCIN</data>
  <data key="d10">MTOR</data>
  <data key="d11">sequestration</data>
  <data key="d12">inhibits</data>
  <data key="d13">With prolonged exposure the drug-immunophilin complex captures newly synthesised mTOR before it is incorporated into mTORC2, depleting the complex rather than inhibiting the assembled one.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">527</data>
  <data key="d17">prolonged exposure</data>
  <data key="d18">pharmacological</data>
  <data key="d19">Kinetic, not structural, selectivity: acute experiments and chronic dosing study different pharmacology.</data>
  <data key="d20">pharmacology</data>
  <data key="d21">-1</data>
</edge>
<edge source="FKBP12_RAPAMYCIN" target="MTORC1" id="drug_inhibition:e5f8b27cb1e6aae2">
  <data key="d9">FKBP12_RAPAMYCIN</data>
  <data key="d10">MTORC1</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">Docking on the exposed FRB of assembled mTORC1 sterically restricts access of substrates to the already deep catalytic cleft rather than abolishing catalysis, giving partial, substrate-selective inhibition.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">24; 37; 108</data>
  <data key="d17"></data>
  <data key="d18">pharmacological</data>
  <data key="d19"></data>
  <data key="d20">pharmacology</data>
  <data key="d21">-1</data>
</edge>
