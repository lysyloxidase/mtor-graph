  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">mTORC2 supports Th2 effector differentiation and AKT-dependent survival in T lymphocytes; with mTORC1 it governs the metabolic reprogramming of effector activation and restrains Treg commitment.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">133; 134</data>
  <data key="d17"></data>
  <data key="d18">downstream_of_mTORC2</data>
