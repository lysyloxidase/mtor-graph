  <data key="d19">Ser65 phosphorylation additionally requires Ser101 (Wang 2003).</data>
  <data key="d20">mtorc1_output_translation_ribosome</data>
  <data key="d21">-1</data>
</edge>
<edge source="MTORC1" target="EIF4EBP2" id="phosphorylation:a58af6baa49e0bf3">
  <data key="d9">MTORC1</data>
  <data key="d10">EIF4EBP2</data>
