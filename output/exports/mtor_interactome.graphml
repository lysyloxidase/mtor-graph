  <data key="d10">TISSUE_LIVER</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">Hepatic mTORC2 restrains gluconeogenesis and supports glycolysis and lipogenesis; liver-specific Rictor deletion gives a type-2-diabetes-like phenotype.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">210; 327</data>
