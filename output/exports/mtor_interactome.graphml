  <data key="d9">MCOLN1</data>
  <data key="d10">CALCIUM</data>
  <data key="d11">transport</data>
  <data key="d12">activates</data>
  <data key="d13">TRPML1 releases lysosomal Ca2+ into a local microdomain on mTORC1 inhibition or lysosomal stress</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">406</data>
  <data key="d17">starvation / lysosomal stress</data>
  <data key="d18">downstream_of_mTORC1</data>
