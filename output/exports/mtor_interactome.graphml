<edge source="DEPDC5" target="RAG_HETERODIMER" id="binding:ef6cdf705e447ede">
  <data key="d9">DEPDC5</data>
  <data key="d10">RAG_HETERODIMER</data>
  <data key="d11">binding</data>
  <data key="d12">modulates</data>
  <data key="d13">DEPDC5 binds GTP-loaded RagA with high affinity in an inhibitory mode that restrains, rather than stimulates, GATOR1-mediated GTP hydrolysis; catalysis is executed through weaker NPRL2-NPRL3 contacts, and the DEPDC5 mode is proposed to keep GATOR1 from becoming hyperactive.</data>
  <data key="d14">emerging</data>
  <data key="d15"></data>
  <data key="d16">158; 555</data>
  <data key="d17"></data>
  <data key="d18">upstream_of_mTORC1</data>
  <data key="d19">DEPDC5 is the main Rag-binding subunit of GATOR1 but not its catalytic subunit; the role of the inhibitory binding mode in cells is still being defined.</data>
  <data key="d20">lysosomal_nutrient_sensing</data>
  <data key="d21">0</data>
</edge>
<edge source="FLCN" target="FLCN_FNIP" id="complex_formation:a6046c89494a18ba">
