  <data key="d11">binding</data>
  <data key="d12">component_of</data>
  <data key="d13">PRAS40 carries its own TOS motif (FVMDE, Phe129), which is required for Raptor binding and lets PRAS40 occupy the Raptor substrate-docking site in competition with S6K1 and 4E-BP1. PRAS40 is also itself an mTORC1 substrate at Ser183.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">441; 637</data>
  <data key="d17"></data>
  <data key="d18">core</data>
  <data key="d19"></data>
  <data key="d20">core_complexes</data>
  <data key="d21">0</data>
</edge>
<edge source="TOS_MOTIF" target="EIF4EBP1" id="binding:6428e45f12392502">
  <data key="d9">TOS_MOTIF</data>
  <data key="d10">EIF4EBP1</data>
  <data key="d11">binding</data>
  <data key="d12">component_of</data>
  <data key="d13">4E-BP1 carries a C-terminal TOS motif (FEMDI) required for Raptor binding and for efficient multisite phosphorylation by mTORC1.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">70; 109; 437; 532</data>
  <data key="d17"></data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19"></data>
  <data key="d20">core_complexes</data>
  <data key="d21">0</data>
</edge>
<edge source="TOS_MOTIF" target="HIF1A" id="binding:ea0f15bc6ef45a0a">
  <data key="d9">TOS_MOTIF</data>
  <data key="d10">HIF1A</data>
  <data key="d11">binding</data>
  <data key="d12">component_of</data>
  <data key="d13">HIF-1alpha is reported to carry an N-terminal TOS motif (Phe99) through which it binds Raptor. Mutating this motif impairs hypoxic HIF activity and p300/CBP binding.</data>
  <data key="d14">emerging</data>
  <data key="d15"></data>
  <data key="d16">328; 437; 532</data>
  <data key="d17"></data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">The HIF-1alpha TOS motif has been studied by one research group only, and mTORC1 also raises HIF-1alpha through 4E-BP1- and S6K1-dependent translation.</data>
  <data key="d20">core_complexes</data>
  <data key="d21">0</data>
</edge>
<edge source="TOS_MOTIF" target="RPS6KB1" id="binding:76c496c550262130">
  <data key="d9">TOS_MOTIF</data>
  <data key="d10">RPS6KB1</data>
  <data key="d11">binding</data>
  <data key="d12">component_of</data>
  <data key="d13">S6K1 carries an N-terminal TOS motif (FDIDL) that is necessary for Raptor binding and for Thr389 phosphorylation.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">437; 532</data>
  <data key="d17"></data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19"></data>
  <data key="d20">core_complexes</data>
  <data key="d21">0</data>
</edge>
<edge source="TOS_MOTIF" target="RPTOR" id="binding:8b2cc36bff6a06ed">
  <data key="d9">TOS_MOTIF</data>
  <data key="d10">RPTOR</data>
  <data key="d11">binding</data>
  <data key="d12">required_for</data>
  <data key="d13">Raptor recognises the five-residue TOS motif of its clients; point mutation of the motif's phenylalanine abolishes binding to Raptor and mTORC1-dependent phosphorylation, which is the molecular basis of substrate selection by mTORC1.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">437; 532</data>
  <data key="d17"></data>
  <data key="d18">core</data>
  <data key="d19"></data>
  <data key="d20">core_complexes</data>
  <data key="d21">1</data>
</edge>
