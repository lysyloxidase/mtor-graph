<edge source="RAPAMYCIN" target="FKBP12_RAPAMYCIN" id="complex_formation:a91b9495c86c889d">
  <data key="d9">RAPAMYCIN</data>
  <data key="d10">FKBP12_RAPAMYCIN</data>
  <data key="d11">complex_formation</data>
  <data key="d12">component_of</data>
  <data key="d13">Rapamycin contributes the second half of the composite surface, its effector domain projecting away from FKBP12 to contact the FRB domain of mTOR.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">24; 108</data>
  <data key="d17"></data>
  <data key="d18">pharmacological</data>
