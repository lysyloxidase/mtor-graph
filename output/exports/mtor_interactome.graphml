  <data key="d12">component_of</data>
  <data key="d13">mSin1 is a defining mTORC2 subunit; its N-terminal segment binds Rictor and it is required for complex integrity and kinase activity toward Akt.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">102; 177; 270; 360; 531; 669</data>
  <data key="d17"></data>
