  <data key="d10">POLR1</data>
  <data key="d11">recruitment</data>
  <data key="d12">activates</data>
  <data key="d13">UBF binds the rDNA promoter and enhancer, recruits SL1 and stabilises Pol I preinitiation complexes; its activity is mTOR/S6K1-dependent.</data>
