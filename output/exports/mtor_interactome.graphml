  <data key="d15"></data>
  <data key="d16">29; 202</data>
  <data key="d17">pancreatic beta-cell</data>
  <data key="d18">downstream_of_mTORC2</data>
  <data key="d19">Beta-cell Rictor deletion principally reduces beta-cell mass and proliferation, and the fall in insulin output has not been dissociated from that loss of mass.</data>
  <data key="d20">mtorc2_regulation_and_outputs</data>
  <data key="d21">1</data>
</edge>
