  <data key="d15"></data>
  <data key="d16">694; 695</data>
  <data key="d17">lysosomal surface</data>
  <data key="d18">upstream_of_mTORC1</data>
  <data key="d19">AXIN1 is a scaffold and does not itself phosphorylate Thr172. Evidence comes mainly from one laboratory.</data>
  <data key="d20">energy_stress_input</data>
  <data key="d21">1</data>
</edge>
