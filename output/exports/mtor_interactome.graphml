<edge source="ABCB1" target="EVEROLIMUS" id="transport:ae0dbaff1b643d24">
  <data key="d9">ABCB1</data>
  <data key="d10">EVEROLIMUS</data>
  <data key="d11">transport</data>
  <data key="d12">inhibits</data>
  <data key="d13">Everolimus is an ABCB1 (P-glycoprotein) substrate; brain accumulation is restricted by ABCB1 and rises when the transporter is absent or pharmacologically inhibited.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">594</data>
  <data key="d17">blood-brain barrier</data>
  <data key="d18">pharmacological</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">-1</data>
</edge>
<edge source="ABCB1" target="EVEROLIMUS" id="transport:80ebb770a53aeb63">
  <data key="d9">ABCB1</data>
  <data key="d10">EVEROLIMUS</data>
  <data key="d11">transport</data>
  <data key="d12">inhibits</data>
  <data key="d13">Everolimus is an ABCB1 substrate; brain accumulation is restricted by the transporter and rises when it is absent or pharmacologically inhibited.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">594</data>
  <data key="d17">blood-brain barrier</data>
  <data key="d18">pharmacological</data>
