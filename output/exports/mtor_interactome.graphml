  <data key="d8">MTHFD2 enzyme</data>
</node>
<node id="NADPH">
  <data key="d1">NADPH</data>
  <data key="d2">NADPH</data>
  <data key="d3">metabolite</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">6</data>
  <data key="d6">Reduced nicotinamide adenine dinucleotide phosphate; reductant generated by the oxidative pentose phosphate pathway and consumed by fatty-acid and sterol synthesis. It is a product of the mTORC1-SREBP-G6PD arm.</data>
