  <data key="d16">444; 568</data>
  <data key="d17">clinical, immunosuppressive and oncological exposures</data>
  <data key="d18">pharmacological</data>
  <data key="d19">Dyslipidaemia is the adipose and hepatic consequence of mTOR inhibition.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="RAPAMYCIN" target="PHENO_HYPERTRIGLYCERIDAEMIA" id="physiological_output:4f9dfd979dbb2b3c">
