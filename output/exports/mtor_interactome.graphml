<edge source="MTORC2" target="AKT" id="phosphorylation:82abd85f325dd7cd">
  <data key="d9">MTORC2</data>
  <data key="d10">AKT</data>
  <data key="d11">phosphorylation</data>
  <data key="d12">activates</data>
  <data key="d13">mTORC2 phosphorylates the hydrophobic motif Ser473; AKT docks on the mSin1 CRIM domain ~75 Å from the active site. Ser473 selectively enhances activity toward FOXO1/3 and BAD over GSK3β/TSC2.</data>
