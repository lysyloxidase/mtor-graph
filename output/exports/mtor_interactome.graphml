  <data key="d15"></data>
  <data key="d16">12; 292</data>
  <data key="d17">weekly or intermittent low-dose regimens</data>
  <data key="d18">pharmacological</data>
  <data key="d19">Evidence is emerging rather than established.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">0</data>
</edge>
