<edge source="SCF_BTRC" target="DEPTOR" id="degradation:b01fea987d569934">
  <data key="d9">SCF_BTRC</data>
  <data key="d10">DEPTOR</data>
  <data key="d11">degradation</data>
  <data key="d12">inhibits</data>
  <data key="d13">mTOR phosphorylates DEPTOR at Ser293 and Ser299 (and Thr295), priming CK1alpha to phosphorylate the Ser286/Ser287/Ser291 degron, which SCF(beta-TrCP) binds, polyubiquitinates and sends for proteasomal degradation. Active mTOR thereby removes its own inhibitor in a positive-feedback loop.</data>
  <data key="d14">established</data>
  <data key="d15">Ser286; Ser287; Ser291</data>
  <data key="d16">150; 186; 701</data>
  <data key="d17"></data>
  <data key="d18">core</data>
  <data key="d19">Ser293 and Ser299 are mTOR priming sites outside the beta-TrCP degron. One study attributes degron phosphorylation instead to S6K1 and RSK1.</data>
  <data key="d20">core_complexes</data>
  <data key="d21">-1</data>
</edge>
<edge source="SKP1" target="SCF_BTRC" id="complex_formation:7a168858b39b96b7">
  <data key="d9">SKP1</data>
  <data key="d10">SCF_BTRC</data>
  <data key="d11">complex_formation</data>
  <data key="d12">component_of</data>
  <data key="d13">SKP1 adapts the F-box protein beta-TrCP to the CUL1 scaffold.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">660; 703</data>
  <data key="d17"></data>
  <data key="d18">core</data>
  <data key="d19"></data>
  <data key="d20">core_complexes</data>
  <data key="d21">0</data>
