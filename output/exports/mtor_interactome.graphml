  <data key="d10">KINASE_DOMAIN</data>
  <data key="d11">autoinhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">The FAT clamp holds the kinase domain in a partially closed, low-activity conformation by distorting the active site; hyperactivating cancer mutations cluster at this FAT-kinase interface and Rheb binding relieves the restraint.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">201; 670; 672</data>
  <data key="d17">basal state</data>
  <data key="d18">core</data>
  <data key="d19"></data>
