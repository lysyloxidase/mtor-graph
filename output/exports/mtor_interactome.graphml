  <data key="d21">-1</data>
</edge>
<edge source="MTOR" target="PHENO_OLIGODENDROCYTE_DIFFERENTIATION" id="physiological_output:11362086963452cb">
  <data key="d9">MTOR</data>
  <data key="d10">PHENO_OLIGODENDROCYTE_DIFFERENTIATION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">mTOR signalling is required for oligodendrocyte differentiation and myelination. Loss of Raptor delays the onset of myelination, reduces sheath thickness and impairs differentiation in a region-dependent manner, most severely in spinal cord, whereas loss of Rictor has modest effects and combined loss is most severe, so mTORC1 is dominant and mTORC2 contributory.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">39; 332</data>
  <data key="d17">oligodendrocyte lineage; rodent conditional knockouts</data>
