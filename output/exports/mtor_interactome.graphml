<edge source="METFORMIN" target="AMPK" id="drug_activation:dc98f10ecbccdf86">
  <data key="d9">METFORMIN</data>
  <data key="d10">AMPK</data>
  <data key="d11">drug_activation</data>
  <data key="d12">activates</data>
  <data key="d13">Metformin activates AMPK indirectly: inhibition of mitochondrial complex I raises AMP and ADP relative to ATP, and at low, clinically relevant concentrations a lysosomal route through PEN2, the v-ATPase, AXIN and LKB1 has been reported by a single laboratory. LKB1 is required for the hepatic effect.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">172; 553; 705</data>
  <data key="d17">liver, skeletal muscle, tumour cells</data>
  <data key="d18">pharmacological</data>
  <data key="d19">Metformin also inhibits mTORC1 independently of AMPK, through the Rag GTPases and through p53-REDD1.</data>
  <data key="d20">energy_stress_input</data>
  <data key="d21">1</data>
</edge>
<edge source="METFORMIN" target="MITOCHONDRIAL_COMPLEX_I" id="drug_inhibition:b4c679f7a0a1ff61">
  <data key="d9">METFORMIN</data>
  <data key="d10">MITOCHONDRIAL_COMPLEX_I</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">Metformin accumulates in mitochondria and mildly inhibits complex I (NADH dehydrogenase), lowering ATP production and raising AMP/ADP:ATP, the proximal trigger for AMPK activation.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">159; 442</data>
  <data key="d17">hepatocytes</data>
  <data key="d18">pharmacological</data>
  <data key="d19"></data>
