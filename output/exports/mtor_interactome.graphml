<edge source="PDCD4" target="EIF4A1" id="competitive_inhibition:054545caaa870864">
  <data key="d9">PDCD4</data>
  <data key="d10">EIF4A1</data>
  <data key="d11">competitive_inhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">PDCD4 MA3 domains bind eIF4A, blocking its helicase activity and its interaction with eIF4G, thereby suppressing translation of structured-5'UTR mRNAs.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
