  <data key="d10">MTORC2</data>
  <data key="d11">complex_formation</data>
  <data key="d12">component_of</data>
  <data key="d13">mSin1 binds Rictor through its N-terminal segment and maintains Rictor–mTOR complex integrity; its loss abolishes AKT Ser473 phosphorylation.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
