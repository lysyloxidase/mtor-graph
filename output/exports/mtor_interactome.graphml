  <data key="d9">METFORMIN</data>
  <data key="d10">PEN2</data>
  <data key="d11">binding</data>
  <data key="d12">activates</data>
  <data key="d13">Low-dose metformin binds PEN2, which then engages ATP6AP1 to inhibit v-ATPase, triggering AXIN-LKB1 recruitment to Ragulator and lysosomal AMPK activation without a change in AMP:ATP.</data>
  <data key="d14">emerging</data>
  <data key="d15"></data>
  <data key="d16">372</data>
  <data key="d17">low (clinically relevant) metformin concentrations</data>
