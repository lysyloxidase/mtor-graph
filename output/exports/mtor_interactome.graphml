  <data key="d9">FKBP12_RAPAMYCIN</data>
  <data key="d10">FRB_DOMAIN</data>
  <data key="d11">binding</data>
  <data key="d12">inhibits</data>
  <data key="d13">The FKBP12-rapamycin binary complex engages the four-helix FRB bundle, forming the ternary complex resolved crystallographically.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">24; 56; 107; 108; 514; 515</data>
  <data key="d17"></data>
  <data key="d18">pharmacological</data>
