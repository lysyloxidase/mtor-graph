<edge source="AMINO_ACIDS" target="FLCN" id="recruitment:72ad08ead4d8e7d0">
  <data key="d9">AMINO_ACIDS</data>
  <data key="d10">FLCN</data>
  <data key="d11">recruitment</data>
  <data key="d12">modulates</data>
  <data key="d13">Amino-acid withdrawal recruits folliculin to lysosomes, where it binds RagA and is held in an inactive lysosomal complex; amino-acid restoration releases it and licenses RagC/D GTP hydrolysis, supporting Rag-dependent recruitment of mTORC1.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">331; 468</data>
  <data key="d17"></data>
  <data key="d18">upstream_of_mTORC1</data>
  <data key="d19">Lysosomal residence of FLCN rises when amino acids are withdrawn, whereas its RagC/D GAP activity is exerted when they are restored.</data>
  <data key="d20">lysosomal_nutrient_sensing</data>
  <data key="d21">0</data>
</edge>
<edge source="AMINO_ACIDS" target="MTORC1" id="recruitment:8993ac9300df46b5">
  <data key="d9">AMINO_ACIDS</data>
  <data key="d10">MTORC1</data>
  <data key="d11">recruitment</data>
