</edge>
<edge source="PDCD4" target="EIF4G1" id="competitive_inhibition:6fca614218918896">
  <data key="d9">PDCD4</data>
  <data key="d10">EIF4G1</data>
  <data key="d11">competitive_inhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">The tandem MA3 domains of PDCD4 bind eIF4A at the surface that eIF4G uses. PDCD4 therefore both inhibits eIF4A helicase activity and prevents eIF4A from being incorporated into eIF4F through eIF4G.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">147; 363; 572; 668</data>
  <data key="d17"></data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">PDCD4 also binds the middle region of eIF4G (residues 635-1039) and prevents eIF4A from binding the eIF4G C-terminal region (residues 1040-1560).</data>
  <data key="d20">mtorc1_output_translation_ribosome</data>
  <data key="d21">-1</data>
</edge>
<edge source="PDCD4" target="PHENO_CELL_PROLIFERATION" id="physiological_output:b4925ac08f6e4d89">
  <data key="d9">PDCD4</data>
  <data key="d10">PHENO_CELL_PROLIFERATION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">PDCD4 suppresses neoplastic transformation and inhibits eIF4A-dependent translation of mRNAs with structured 5'UTRs. Its S6K1- and βTrCP-dependent degradation after mitogenic stimulation is required for the full rise in protein synthesis and cell growth after mTORC1 activation, so its effect on proliferation is indirect.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">147; 668</data>
  <data key="d17"></data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19"></data>
  <data key="d20">mtorc1_output_translation_ribosome</data>
  <data key="d21">-1</data>
</edge>
