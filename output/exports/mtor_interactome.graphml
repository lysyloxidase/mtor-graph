  <data key="d17">Alzheimer's disease</data>
  <data key="d18">pathophysiological</data>
  <data key="d19">In transgenic Alzheimer models, mTOR inhibition lowers brain amyloid-beta and improves cognition when started before substantial pathology has accumulated, and the benefit depends on intact autophagy; no controlled human efficacy data exist.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
