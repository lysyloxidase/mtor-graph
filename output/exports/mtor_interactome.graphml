  <data key="d12">component_of</data>
  <data key="d13">beta-TrCP2 (FBXW11) is redundant with BTRC as the receptor for the DEPTOR phosphodegron.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">150; 186</data>
  <data key="d17"></data>
  <data key="d18">core</data>
