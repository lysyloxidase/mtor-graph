  <data key="d12">required_for</data>
  <data key="d13">Protor-1 knockout mice show reduced mTORC2-dependent SGK1 activation and NDRG1 phosphorylation in kidney, with AKT signalling preserved.</data>
  <data key="d14">emerging</data>
