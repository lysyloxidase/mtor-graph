<edge source="MTORC1" target="PHENO_FOOD_INTAKE" id="physiological_output:bb8ed5e15b343bd4">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_FOOD_INTAKE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Intracerebroventricular leucine raises hypothalamic S6K1 phosphorylation and suppresses food intake and body weight; rapamycin abolishes the effect.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">120</data>
  <data key="d17">hypothalamic arcuate nucleus (rodent)</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">Established in rodents; no human study separates central from peripheral contribution.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">-1</data>
</edge>
<edge source="MTORC1" target="PHENO_HEPATIC_STEATOSIS" id="physiological_output:6f8b0c803c6a256c">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_HEPATIC_STEATOSIS</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">SREBP1c-dependent lipogenesis driven by hepatic mTORC1 contributes to steatosis when insulin is chronically elevated.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">212; 326; 677</data>
  <data key="d17">liver, hyperinsulinaemia</data>
  <data key="d18">pathophysiological</data>
  <data key="d19">Hepatic mTORC1 is required for insulin-induced SREBP1c and lipogenesis, but mTORC1 activation alone is not sufficient: liver Tsc1 deletion lowers Akt signalling and protects against diet-induced steatosis, so intact Akt signalling, which also suppresses Insig2a, is required alongside it.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="PHENO_INSULIN_RESISTANCE" id="physiological_output:41f9efc4076cdcbf">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_INSULIN_RESISTANCE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">Chronic mTORC1 activation in obesity drives insulin resistance through S6K1-IRS-1 feedback and through lipotoxicity from constrained adipose storage capacity.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">377</data>
  <data key="d17">adipose tissue in obesity</data>
  <data key="d18">feedback</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="PHENO_LIFESPAN_EXTENSION" id="physiological_output:b2370f72909a0beb">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_LIFESPAN_EXTENSION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Reduced TOR signalling extends lifespan in Saccharomyces cerevisiae, Caenorhabditis elegans and Drosophila melanogaster, so TOR activity limits lifespan.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">289; 298; 476; 629</data>
  <data key="d17">yeast, worm and fly</data>
  <data key="d18">pathophysiological</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">-1</data>
</edge>
<edge source="MTORC1" target="PHENO_MALADAPTIVE_REMODELLING" id="physiological_output:96bf7004bdac3407">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_MALADAPTIVE_REMODELLING</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">Sustained mTORC1 activity contributes to maladaptive cardiac remodelling, in contrast to the physiological hypertrophy the same complex supports, and partial inhibition attenuates pathological hypertrophy in several models.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">405; 538</data>
  <data key="d17">cardiomyocyte</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">Cardiac mTOR also has protective roles, including after ischaemic injury, so the maladaptive arm is dose- and context-dependent rather than a uniform property of mTORC1 activity.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="PHENO_MICROGLIAL_ACTIVATION" id="physiological_output:1d8f3e6c2a468c2d">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_MICROGLIAL_ACTIVATION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">Microglial Tsc1 loss produces an amoeboid, highly proliferative and phagocytic phenotype without a pro-inflammatory cytokine signature, with reduced synapse density.</data>
  <data key="d14">emerging</data>
  <data key="d15"></data>
  <data key="d16">702</data>
  <data key="d17">microglia</data>
  <data key="d18">pathophysiological</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="PHENO_MUSCLE_DYSTROPHY" id="physiological_output:28400900db690db8">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_MUSCLE_DYSTROPHY</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Muscle-specific Raptor deletion produces progressive dystrophy, impaired oxidative capacity and shortened lifespan, so intact mTORC1 restrains the dystrophic phenotype; muscle-specific Rictor deletion is close to phenotypically silent.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">38</data>
  <data key="d17">skeletal muscle; Raptor conditional knockout</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">-1</data>
</edge>
<edge source="MTORC1" target="PHENO_MUSCLE_HYPERTROPHY" id="physiological_output:5c59ed4b6113f728">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_MUSCLE_HYPERTROPHY</data>
  <data key="d11">physiological_output</data>
  <data key="d12">activates</data>
  <data key="d13">mTORC1 activity is required for load-induced hypertrophy: rapamycin blocks the hypertrophic response to IGF-1, mechanical overload and chronic stimulation. Sustained mTORC1 activation is not by itself sufficient, since constitutive activation by Tsc1 deletion in muscle fails to produce hypertrophy and instead causes a late-onset myopathy with blocked autophagy.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">50</data>
  <data key="d17">skeletal muscle</data>
  <data key="d18">pathophysiological</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="PHENO_MYELINATION" id="physiological_output:a4da477b702c13c8">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_MYELINATION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">Oligodendrocyte-lineage Raptor loss delays myelination onset and produces persistent hypomyelination with reduced sheath thickness, regionally worse in spinal cord.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">39; 332</data>
  <data key="d17">oligodendrocyte lineage (rodent)</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">Established in rodents; effect of chronic low-dose inhibition on adult human white matter unresolved.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="PHENO_PROTEINURIA" id="physiological_output:340e83300586e9f7">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_PROTEINURIA</data>
  <data key="d11">physiological_output</data>
  <data key="d12">modulates</data>
  <data key="d13">Podocytes require a calibrated level of mTORC1 activity: Raptor deletion in podocytes causes injury and proteinuria, while podocyte Tsc1 deletion causes proteinuric glomerulosclerosis, so both insufficient and excessive activity damage the filtration barrier.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">208; 264</data>
  <data key="d17">kidney podocyte</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">Both limbs matter clinically: mTOR inhibitors themselves can cause proteinuria, while podocyte mTORC1 activation drives the glomerular lesion of diabetic nephropathy in mice.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">0</data>
</edge>
<edge source="MTORC1" target="PHENO_SPINE_DENSITY" id="physiological_output:b7b485eea6f4c539">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_SPINE_DENSITY</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Microglia-restricted Tsc1 deletion reduces synapse density alongside an amoeboid, highly proliferative and phagocytic microglial phenotype; the effect of pathway hyperactivation on synapses is therefore not cell-autonomous to neurons.</data>
  <data key="d14">emerging</data>
  <data key="d15"></data>
  <data key="d16">702</data>
  <data key="d17">microglia</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">both are needed.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">-1</data>
</edge>
<edge source="MTORC1" target="PHENO_TH1_TH17" id="physiological_output:16f1f8f2911fde8b">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_TH1_TH17</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">Rheb-mTORC1 is required for Th1 and Th17 differentiation; T cell-specific mTOR deletion abrogates Th1, Th2 and Th17 differentiation altogether.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">133; 134</data>
  <data key="d17">CD4 T lymphocyte</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="MTORC1" target="PHENO_TREG_EXPANSION" id="physiological_output:7b5c7b15e482876a">
  <data key="d9">MTORC1</data>
  <data key="d10">PHENO_TREG_EXPANSION</data>
  <data key="d11">physiological_output</data>
  <data key="d12">modulates</data>
  <data key="d13">In naive mouse CD4 cells without exogenous TGF-beta, combined inhibition of mTORC1 and mTORC2 promotes Foxp3 induction while inhibition of either complex alone is insufficient; established regulatory T cells conversely require mTORC1 for their metabolic programme and suppressive function.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">133; 134; 690</data>
  <data key="d17">de novo Treg differentiation in vitro; not mature Treg expansion</data>
  <data key="d18">downstream_of_mTORC1</data>
  <data key="d19">Differentiation, expansion and suppressive function are distinct endpoints; mature Tregs require mTORC1 for normal function.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">0</data>
</edge>
