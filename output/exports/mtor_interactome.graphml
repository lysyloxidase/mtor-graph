  <data key="d9">MTORC2</data>
  <data key="d10">PHENO_INSULIN_RESISTANCE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">inhibits</data>
  <data key="d13">Chronic mTORC2 loss produces peripheral insulin resistance, which is distinct from direct beta-cell toxicity; the two together account for new-onset diabetes after transplantation at immunosuppressive exposures.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">29; 325</data>
