  <data key="d10">RAPAMYCIN</data>
  <data key="d11">metabolic_conversion</data>
  <data key="d12">converts_to</data>
  <data key="d13">Temsirolimus is given intravenously as an ester prodrug and is hydrolysed to sirolimus, which accounts for much of its systemic exposure and activity.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">314; 373</data>
