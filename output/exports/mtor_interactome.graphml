  <data key="d9">MTORC1</data>
  <data key="d10">TISSUE_SKELETAL_MUSCLE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">Muscle-specific Raptor deletion produces progressive dystrophy, impaired oxidative capacity and shortened lifespan, establishing mTORC1 as the dominant complex in muscle.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">38</data>
