  <data key="d8">lactate dehydrogenase A</data>
</node>
<node id="MTHFD2">
  <data key="d1">MTHFD2</data>
  <data key="d2">MTHFD2</data>
  <data key="d3">protein</data>
  <data key="d4">mtorc1_output_autophagy_metabolism_feedback</data>
  <data key="d5">6</data>
