  <data key="d10">MTORC1</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">Torin1 inhibits mTORC1 catalysis directly at the ATP site and was the tool compound that revealed rapamycin-resistant mTORC1 functions.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">603</data>
  <data key="d17">tool compound</data>
  <data key="d18">pharmacological</data>
  <data key="d19"></data>
  <data key="d20">pharmacology</data>
  <data key="d21">-1</data>
</edge>
<edge source="TORIN1" target="MTORC2" id="drug_inhibition:209c082cced2c14d">
  <data key="d9">TORIN1</data>
  <data key="d10">MTORC2</data>
  <data key="d11">drug_inhibition</data>
  <data key="d12">inhibits</data>
  <data key="d13">Torin1 blocks mTORC2 as well, abolishing AKT Ser473 phosphorylation, and is used experimentally to separate complex-selective from pan-mTOR effects.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">603</data>
  <data key="d17">tool compound</data>
  <data key="d18">pharmacological</data>
  <data key="d19"></data>
  <data key="d20">pharmacology</data>
