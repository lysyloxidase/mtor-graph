  <data key="d13">A distinct mTORC2–AKT pool resides at ER–mitochondria contact sites and controls MAM integrity, Ca2+ transfer and mitochondrial physiology.</data>
  <data key="d14">emerging</data>
  <data key="d15"></data>
  <data key="d16">41</data>
  <data key="d17"></data>
