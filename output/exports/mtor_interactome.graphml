<edge source="VAR_MTOR_KINASE_GOF" target="DISEASE_UROTHELIAL_CARCINOMA" id="genetic_gain_of_function:021ea62af9c55dfb">
  <data key="d9">VAR_MTOR_KINASE_GOF</data>
  <data key="d10">DISEASE_UROTHELIAL_CARCINOMA</data>
  <data key="d11">genetic_gain_of_function</data>
  <data key="d12">activates</data>
  <data key="d13">Activating kinase-domain MTOR substitutions are recognised in urothelial carcinoma; a patient with a complete response to everolimus plus pazopanib carried two concurrent activating variants, E2014K and E2419K, shown to be activating in vitro.</data>
  <data key="d14">emerging</data>
  <data key="d15">E2419K</data>
  <data key="d16">201; 632</data>
  <data key="d17">somatic, urothelial carcinoma</data>
  <data key="d18">pathophysiological</data>
  <data key="d19">The response occurred during combined everolimus and pazopanib treatment.</data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="VAR_MTOR_KINASE_GOF" target="MTOR" id="genetic_gain_of_function:926a978559f8d4a5">
  <data key="d9">VAR_MTOR_KINASE_GOF</data>
  <data key="d10">MTOR</data>
  <data key="d11">genetic_gain_of_function</data>
  <data key="d12">activates</data>
  <data key="d13">Selected MTOR kinase-domain substitutions increase signalling. E2419K was functionally activating in a urothelial cancer exceptional responder; F2108L is an FRB resistance mutation, not a kinase-domain activating substitution.</data>
  <data key="d14">established</data>
  <data key="d15">E2419K; S2215Y</data>
  <data key="d16">201; 632</data>
  <data key="d17">somatic, renal cell and urothelial carcinoma</data>
  <data key="d18">pathophysiological</data>
  <data key="d19"></data>
  <data key="d20">tissue_physiology_disease</data>
  <data key="d21">1</data>
</edge>
<edge source="VAR_MTOR_KINASE_GOF" target="VAR_CLASS_PROXIMAL_BRAKE" id="other:171ca2be4eee0a6e">
  <data key="d9">VAR_MTOR_KINASE_GOF</data>
  <data key="d10">VAR_CLASS_PROXIMAL_BRAKE</data>
  <data key="d11">other</data>
  <data key="d12">component_of</data>
  <data key="d13">Activating MTOR variants in both the FAT and kinase domains belong to the proximal-brake class and are somatic.</data>
