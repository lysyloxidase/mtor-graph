</edge>
<edge source="MTORC1" target="TISSUE_T_LYMPHOCYTE" id="physiological_output:13a9615471d149f7">
  <data key="d9">MTORC1</data>
  <data key="d10">TISSUE_T_LYMPHOCYTE</data>
  <data key="d11">physiological_output</data>
  <data key="d12">required_for</data>
  <data key="d13">Both complexes are required for the glycolytic and glutaminolytic reprogramming of effector T cell activation, so partial inhibition is the pharmacological objective.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">134</data>
  <data key="d17">T lymphocyte activation</data>
  <data key="d18">downstream_of_mTORC1</data>
