  <data key="d16">456</data>
  <data key="d17">mouse kidney</data>
  <data key="d18">downstream_of_mTORC2</data>
  <data key="d19">Protor-1 loss leaves AKT and PKCalpha hydrophobic- and turn-motif phosphorylation intact, so the requirement is restricted to SGK1 and has been shown only in kidney.</data>
  <data key="d20">core_complexes</data>
  <data key="d21">1</data>
</edge>
