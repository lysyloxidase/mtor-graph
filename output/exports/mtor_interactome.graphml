  <data key="d10">MTOR</data>
  <data key="d11">other</data>
  <data key="d12">component_of</data>
  <data key="d13">The four-helix FRB domain lies between the FAT and kinase domains, above the substrate cleft, which is why an occupant of this site obstructs substrate entry.</data>
  <data key="d14">established</data>
  <data key="d15"></data>
  <data key="d16">315; 588; 670</data>
  <data key="d17"></data>
  <data key="d18">core</data>
  <data key="d19"></data>
