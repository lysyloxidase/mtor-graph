          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Recognised feature of Smith–Kingsmore syndrome in the 28-individual cohort [361]; mechanistically expected from hypothalamic mTORC1 nutrient sensing." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_PHOTIC_ENTRAINMENT" label="Photic entrainment">
