        </attvalues>
      </edge>
      <edge source="DEPTOR" target="MTORC1" id="694">
        <attvalues>
          <attvalue for="6" value="DEPTOR" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="DEPTOR associates substoichiometrically with mTORC1 as an inhibitory subunit." />
