      <edge source="TSC_COMPLEX" target="RHEB" id="607">
        <attvalues>
          <attvalue for="6" value="TSC_COMPLEX" />
          <attvalue for="7" value="RHEB" />
          <attvalue for="8" value="gap_activity" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The TSC1–TSC2–TBC1D7 complex (2:2:1) presents the TSC2 GAP domain at its apex to lysosomal Rheb and accelerates GTP hydrolysis ~100-fold; in the absence of insulin the complex is held on the lysosome through Rheb and is released when AKT phosphorylates TSC2." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="143; 261; 407; 600; 673" />
          <attvalue for="14" value="lysosomal surface" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The complex is the GAP and inactivates Rheb; loss of TSC1 or TSC2 leaves Rheb GTP-loaded and mTORC1 constitutively active. Lysosomal retention of the complex and its insulin-dependent release were shown by Menon and colleagues." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="gap_activity:3b00efdaa774e4d6" />
        </attvalues>
      </edge>
      <edge source="TSC_COMPLEX" target="MTORC2" id="608">
        <attvalues>
          <attvalue for="6" value="TSC_COMPLEX" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="The TSC1–TSC2 complex physically associates with mTORC2 and promotes its activity toward AKT, independently of its Rheb GAP function." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="249" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC2" />
          <attvalue for="16" value="Polarity is opposite to the TSC-mTORC1 relationship." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:57848355f3937bec" />
        </attvalues>
      </edge>
      <edge source="AMPK" target="MTORC1" id="609">
        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Activated AMPK inhibits mTORC1 by two routes: phosphorylation of TSC2, which enhances its GAP activity toward Rheb, and direct phosphorylation of Raptor at Ser722 and Ser792, which creates 14-3-3 binding sites and imposes a metabolic checkpoint." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="187; 207; 216; 226; 262" />
          <attvalue for="14" value="energy stress" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Net effect of the TSC2 and Raptor phosphorylation routes rather than a separate molecular event." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:19780ba05a14a845" />
        </attvalues>
      </edge>
      <edge source="AMPK" target="MTORC2" id="610">
        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="During acute energetic stress AMPK phosphorylates mTOR and Rictor within mTORC2, increasing mTORC2 activity toward AKT Ser473 and promoting cell survival, independently of its inhibition of mTORC1." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="300" />
          <attvalue for="14" value="acute energetic stress (glucose deprivation, AICAR)" />
          <attvalue for="15" value="upstream_of_mTORC2" />
          <attvalue for="16" value="Single-laboratory study. In vitro, AMPK phosphorylated mTOR at Ser1261 and Rictor at unmapped sites, but Ser1261 was not required for AMPK-induced mTORC2 signalling, so the functionally relevant sites are unknown." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="phosphorylation:3b0f0a72203f7d79" />
        </attvalues>
      </edge>
      <edge source="AMPK" target="RPTOR" id="611">
        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="RPTOR" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="AMPK directly phosphorylates Raptor at two conserved serines, creating 14-3-3 binding sites that reduce mTORC1 kinase activity; imposes a metabolic checkpoint (G2/M arrest) independent of TSC2." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser722; Ser792" />
          <attvalue for="13" value="187; 207; 216; 226; 262" />
          <attvalue for="14" value="energy stress" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Both Raptor sites, including Ser792, are needed for the full checkpoint." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="phosphorylation:028c01ca53886639" />
        </attvalues>
      </edge>
