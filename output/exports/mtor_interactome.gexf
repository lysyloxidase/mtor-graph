          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Truncating and missense DEPDC5 variants disrupt the Rag-binding subunit of GATOR1, so the complex can no longer be recruited to and act on RagA/B; missense variants are often hypomorphic rather than null." />
          <attvalue for="11" value="established" />
