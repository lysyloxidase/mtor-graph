          <attvalue for="12" value="" />
          <attvalue for="13" value="376" />
          <attvalue for="14" value="cancer" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The commonly quoted prevalence figures for PTEN loss require a primary epidemiological source before they are restated." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="-1" />
