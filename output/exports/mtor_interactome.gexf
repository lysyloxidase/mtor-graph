          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="mSin1 splice isoforms assemble distinct mTORC2 species; the isoform lacking the C-terminal PH domain yields a complex not gated by PIP3." />
