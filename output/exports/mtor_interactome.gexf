          <attvalue for="0" value="organelle" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Site at which PIP3 is generated and to which PIP3 recruits both mTORC2 (via the mSin1 PH domain) and its membrane-targeted substrate AKT." />
