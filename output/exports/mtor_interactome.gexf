          <attvalue for="7" value="DISEASE_NODAT" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Calcineurin inhibition in the pancreatic beta cell impairs insulin secretion and promotes beta-cell apoptosis, which is the principal mechanism of new-onset diabetes after transplantation in tacrolimus-based regimens." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
