          <attvalue for="7" value="TOP_MRNA" />
          <attvalue for="8" value="translational_regulation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Ribosome profiling attributes TOP mRNA sensitivity to mTORC1 largely to 4E-BPs, whereas LARP1 studies show 4E-BP-independent repression; both arms likely contribute." />
