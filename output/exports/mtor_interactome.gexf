      <edge source="LARS1" target="RRAGD" id="354">
        <attvalues>
          <attvalue for="6" value="LARS1" />
          <attvalue for="7" value="RRAGD" />
          <attvalue for="8" value="gap_activity" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="LARS1 was reported to act as a leucine-dependent GAP for RagD, driving it to the GDP state that supports mTORC1 recruitment" />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="51; 211; 338" />
          <attvalue for="14" value="mammalian cells" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Contested: the yeast orthologue acts on Gtr1, the RagA/B counterpart, with the opposite activity [51]; the mammalian and fungal models are unreconciled." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
