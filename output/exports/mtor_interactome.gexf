      <edge source="EIF4EBP2" target="LTP_LATE_PHASE" id="1005">
        <attvalues>
          <attvalue for="6" value="EIF4EBP2" />
          <attvalue for="7" value="LTP_LATE_PHASE" />
          <attvalue for="8" value="translational_regulation" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="4E-BP2 represses cap-dependent translation at the synapse: in its absence a single train that normally yields only early-phase potentiation induces late-phase LTP, so the induction threshold falls, yet late-phase LTP elicited by repeated high-frequency trains is impaired and hippocampus-dependent memory is deficient. Both excessive and deficient translational signalling are deleterious in brain." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="26" />
          <attvalue for="14" value="forebrain neuron" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="The lowered threshold for late-phase LTP in 4E-BP2-null hippocampus coexists with impaired late-phase LTP after strong stimulation and with deficient hippocampus-dependent memory." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="translational_regulation:21e1cb9f8414f1d9" />
        </attvalues>
      </edge>
      <edge source="EIF4EBP2" target="PHENO_AUTISM_LIKE_BEHAVIOUR" id="1006">
        <attvalues>
          <attvalue for="6" value="EIF4EBP2" />
          <attvalue for="7" value="PHENO_AUTISM_LIKE_BEHAVIOUR" />
          <attvalue for="8" value="translational_regulation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Loss of the translational repressor 4E-BP2 produces autism-like behaviour with an increased excitation-to-inhibition ratio, the upper arm of the neuronal requirement for calibrated translational signalling; the accompanying synaptic phenotype is a lowered threshold for late-phase LTP rather than uniformly enhanced potentiation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="195" />
          <attvalue for="14" value="CNS neuron" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="translational_regulation:4535af298af06533" />
        </attvalues>
      </edge>
