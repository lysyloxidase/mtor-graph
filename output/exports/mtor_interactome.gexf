      <edge source="ABCB1" target="EVEROLIMUS" id="460">
        <attvalues>
          <attvalue for="6" value="ABCB1" />
          <attvalue for="7" value="EVEROLIMUS" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Everolimus is an ABCB1 (P-glycoprotein) substrate; brain accumulation is restricted by ABCB1 and rises when the transporter is absent or pharmacologically inhibited." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="594" />
          <attvalue for="14" value="blood-brain barrier" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="transport:ae0dbaff1b643d24" />
        </attvalues>
      </edge>
      <edge source="ABCB1" target="EVEROLIMUS" id="461">
        <attvalues>
          <attvalue for="6" value="ABCB1" />
          <attvalue for="7" value="EVEROLIMUS" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Everolimus is an ABCB1 substrate; brain accumulation is restricted by the transporter and rises when it is absent or pharmacologically inhibited." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="594" />
          <attvalue for="14" value="blood-brain barrier" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="transport:80ebb770a53aeb63" />
        </attvalues>
      </edge>
      <edge source="ABCB1" target="PHENO_CNS_DRUG_EXPOSURE" id="462">
        <attvalues>
          <attvalue for="6" value="ABCB1" />
          <attvalue for="7" value="PHENO_CNS_DRUG_EXPOSURE" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Sirolimus and everolimus are ABCB1 substrates; brain accumulation of everolimus rises when the transporter is absent or pharmacologically inhibited." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="594" />
          <attvalue for="14" value="blood-brain barrier" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Shields CNS from systemic exposure but limits efficacy wherever CNS target engagement is the object." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="transport:1f859310a83b1d07" />
        </attvalues>
      </edge>
      <edge source="ABCB1" target="PHENO_CNS_DRUG_EXPOSURE" id="463">
        <attvalues>
          <attvalue for="6" value="ABCB1" />
          <attvalue for="7" value="PHENO_CNS_DRUG_EXPOSURE" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Efflux at the blood-brain barrier shields the CNS from systemic exposure but equally limits target engagement wherever the brain is the therapeutic object, decoupling central from peripheral exposure." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="594" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="A dose titrated to a peripheral marker such as whole-blood S6K1 phosphorylation is not thereby titrated in brain." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="transport:a41a437415b0a4f1" />
        </attvalues>
      </edge>
      <edge source="ABCB1" target="RAPAMYCIN" id="464">
        <attvalues>
          <attvalue for="6" value="ABCB1" />
          <attvalue for="7" value="RAPAMYCIN" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Sirolimus is an ABCB1 substrate, so central and peripheral exposure-response relationships cannot be assumed to coincide; a dose titrated to whole-blood S6K1 phosphorylation is not thereby titrated in brain." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="594" />
          <attvalue for="14" value="blood-brain barrier" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="transport:fd7def28ef5bfaea" />
        </attvalues>
      </edge>
      <edge source="ABCB1" target="RAPAMYCIN" id="465">
        <attvalues>
          <attvalue for="6" value="ABCB1" />
          <attvalue for="7" value="RAPAMYCIN" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="P-glycoprotein effluxes sirolimus at the apical membrane of enterocytes, which together with first-pass CYP3A metabolism keeps oral bioavailability low: approximately 14% for the oral solution, with tablet exposure about 27% higher and not bioequivalent to it. The same transporter handling underlies the extensive drug-interaction profile of the drug." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="373" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="transport:ac584fdc440c698e" />
        </attvalues>
      </edge>
      <edge source="ABCB1" target="TEMSIROLIMUS" id="466">
        <attvalues>
          <attvalue for="6" value="ABCB1" />
          <attvalue for="7" value="TEMSIROLIMUS" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Temsirolimus and the sirolimus it yields are P-glycoprotein substrates, so efflux limits their distribution into tissues, most consequentially across the blood-brain barrier. Because temsirolimus is administered intravenously, intestinal efflux does not contribute to its systemic exposure." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="373" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="transport:2e8709e9abee5c93" />
        </attvalues>
      </edge>
      <edge source="CYP3A4" target="EVEROLIMUS" id="467">
        <attvalues>
          <attvalue for="6" value="CYP3A4" />
          <attvalue for="7" value="EVEROLIMUS" />
          <attvalue for="8" value="metabolic_conversion" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Everolimus is likewise a CYP3A4 substrate, giving extensive interaction potential with azoles, macrolides, rifampicin and anticonvulsants and requiring exposure-guided dosing." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="314" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="metabolic_conversion:c444599cc1321974" />
        </attvalues>
      </edge>
      <edge source="CYP3A4" target="PHENO_CNS_DRUG_EXPOSURE" id="468">
        <attvalues>
          <attvalue for="6" value="CYP3A4" />
          <attvalue for="7" value="PHENO_CNS_DRUG_EXPOSURE" />
          <attvalue for="8" value="metabolic_conversion" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In mice, CYP3A acts together with plasma carboxylesterase to clear everolimus systemically and so sets the blood concentration from which central exposure derives; restriction of brain penetration itself is attributed chiefly to P-glycoprotein at the blood-brain barrier." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="594" />
          <attvalue for="14" value="mouse disposition study" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="metabolic_conversion:64b0ed304024f24c" />
        </attvalues>
      </edge>
      <edge source="CYP3A4" target="RAPAMYCIN" id="469">
        <attvalues>
          <attvalue for="6" value="CYP3A4" />
          <attvalue for="7" value="RAPAMYCIN" />
          <attvalue for="8" value="metabolic_conversion" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="CYP3A4 in gut and liver demethylates and hydroxylates sirolimus, so CYP3A4 inducers and inhibitors shift its exposure several-fold; whole-blood trough monitoring, commonly in the range of 5-15 ng/mL in transplantation, is therefore standard." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="373" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="metabolic_conversion:836c4dd3aa372865" />
        </attvalues>
      </edge>
      <edge source="CYP3A4" target="TEMSIROLIMUS" id="470">
        <attvalues>
          <attvalue for="6" value="CYP3A4" />
          <attvalue for="7" value="TEMSIROLIMUS" />
          <attvalue for="8" value="metabolic_conversion" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Temsirolimus is cleared principally by hepatic CYP3A4, which hydroxylates and demethylates it, so CYP3A4 inhibitors and inducers markedly alter its exposure. The drug is given intravenously, so no intestinal first-pass step contributes, and its principal active metabolite sirolimus arises by hydrolysis of the temsirolimus ester rather than by CYP3A4." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="373; 564" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="metabolic_conversion:b66b770de485d2c3" />
        </attvalues>
      </edge>
      <edge source="FKBP12" target="FKBP12_RAPAMYCIN" id="471">
        <attvalues>
          <attvalue for="6" value="FKBP12" />
          <attvalue for="7" value="FKBP12_RAPAMYCIN" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="FKBP12, a peptidyl-prolyl isomerase, is the intracellular receptor for rapamycin and contributes one half of the composite surface that binds FRB. Inhibition of mTOR is a gain of function of the drug-immunophilin complex, not a consequence of blocking isomerase activity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 37; 56; 107; 108; 229; 230; 514; 515" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="complex_formation:3e21801e38c8d103" />
        </attvalues>
      </edge>
      <edge source="FKBP12_RAPAMYCIN" target="FRB_DOMAIN" id="472">
        <attvalues>
          <attvalue for="6" value="FKBP12_RAPAMYCIN" />
          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The composite FKBP12-rapamycin surface wedges into the FRB domain adjacent to the catalytic cleft, narrowing substrate access; this gain-of-function mechanism explains why rapamycin is an allosteric, substrate-selective inhibitor rather than an ATP-competitive one." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 56; 107; 108; 514; 515" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
