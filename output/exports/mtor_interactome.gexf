      <edge source="MTORC1" target="TISSUE_OLIGODENDROCYTE" id="859">
        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="TISSUE_OLIGODENDROCYTE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Oligodendrocyte-lineage Raptor loss delays onset of myelination and produces persistent hypomyelination with reduced sheath thickness, whereas Rictor loss has modest and largely transient effects; the requirement is regional, with spinal cord affected more than corpus callosum." />
