      </edge>
      <edge source="SAMTOR" target="GATOR1" id="358">
        <attvalues>
          <attvalue for="6" value="SAMTOR" />
          <attvalue for="7" value="GATOR1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Unlike Sestrin2 and CASTOR1, apo-SAMTOR acts directly on GATOR1, promoting its activity and so inhibiting mTORC1 when SAM is low" />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="203" />
          <attvalue for="14" value="methionine/SAM deprivation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:8384f2b281801465" />
        </attvalues>
      </edge>
      <edge source="SAMTOR" target="KICSTOR" id="359">
        <attvalues>
          <attvalue for="6" value="SAMTOR" />
          <attvalue for="7" value="KICSTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="SAMTOR engages the GATOR1-KICSTOR assembly rather than GATOR2, which is why the methionine arm bypasses the Sestrin/CASTOR hub" />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="203" />
          <attvalue for="14" value="" />
