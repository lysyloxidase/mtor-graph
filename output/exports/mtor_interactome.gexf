          <attvalue for="7" value="RRAGA" />
          <attvalue for="8" value="gef_activity" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Ragulator was reported to act as a guanine nucleotide exchange factor for RagA/B (Bar-Peled 2012), but later reconstitution found that it chiefly triggers GTP release from RagC, with SLC38A9 acting as the GEF for RagA." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="27; 556" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Shen and Sabatini (2018) attribute the original RagA/B result to assay limitations, including possibly copurifying SLC38A9, while noting that Ragulator still alters the GTP affinity of RagA." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="gef_activity:891fd48eece01ea4" />
