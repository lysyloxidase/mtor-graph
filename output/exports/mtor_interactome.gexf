      <edge source="VAR_DEPDC5_LOF" target="DISEASE_GATOR1_EPILEPSY" id="111">
        <attvalues>
          <attvalue for="6" value="VAR_DEPDC5_LOF" />
          <attvalue for="7" value="DISEASE_GATOR1_EPILEPSY" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Germline heterozygous DEPDC5 loss of function disinhibits RagA/B and produces mTORC1 hyperactivity in the cortical lesion, causing familial focal epilepsy with variable foci and elevated risk of sudden unexpected death in epilepsy." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="22; 141; 417" />
          <attvalue for="14" value="germline heterozygous" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="In a small open-label series, the three patients with DEPDC5 truncating variants had the largest seizure reductions on everolimus while the patient with a missense variant responded less; the evidence is open-label and very small." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="genetic_loss_of_function:5dfe48e6c452b1d0" />
        </attvalues>
      </edge>
