          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Conserved-region-in-the-middle domain of mSin1; its acidic loop engages the basic surface of the AGC-kinase N-lobe and is the principal distal docking site (~75 A from the catalytic cleft) for Akt, SGK1 and PKC." />
          <attvalue for="4" value="MAPKAP1" />
          <attvalue for="5" value="CRIM" />
        </attvalues>
      </node>
      <node id="ETV7" label="ETV7">
