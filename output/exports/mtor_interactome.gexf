      <edge source="RAPAMYCIN" target="PHENO_HYPERPHAGIC_OBESITY" id="272">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_HYPERPHAGIC_OBESITY" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Hypothalamic mTORC1 acts as a nutrient sensor in the arcuate nucleus: rapamycin abolishes the anorectic response to intracerebroventricular leucine and partially corrects the hyperphagic obesity produced by Tsc1 deletion in POMC neurons. This raises the possibility that part of the metabolic toxicity attributed to liver, adipose and beta cell is centrally mediated." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="120; 419" />
          <attvalue for="14" value="rodent models; unresolved in humans" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="This makes tissue-level attribution of metabolic toxicity from peripheral measurements less secure than it appears." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:91160502e57ad26a" />
        </attvalues>
      </edge>
