          <attvalue for="7" value="ENERGY_STRESS" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Muscle contraction consumes ATP faster than oxidative phosphorylation replenishes it, so ADP and, through adenylate kinase, AMP rise, and this energy-stress state activates AMPK in proportion to exercise intensity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="654" />
          <attvalue for="14" value="skeletal muscle contraction" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Exercise converges on AMPK through the contraction-induced shift in adenylate charge." />
