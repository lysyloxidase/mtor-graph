        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="DISEASE_NODAT" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="In kidney transplant recipients without pre-existing diabetes sirolimus was independently associated with new-onset diabetes, adjusted hazard ratios roughly 1.4-1.7." />
