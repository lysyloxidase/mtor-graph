          <attvalue for="7" value="PHENO_FATIGUE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Treatment-related fatigue in 42% of patients in the first-in-human dose-escalation study." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="535" />
          <attvalue for="14" value="phase 1 dose escalation" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The frequency comes from one uncontrolled dose-escalation cohort and has not been independently replicated." />
