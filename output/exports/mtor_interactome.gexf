      <edge source="FKBP12_RAPAMYCIN" target="FRB_DOMAIN" id="474">
        <attvalues>
          <attvalue for="6" value="FKBP12_RAPAMYCIN" />
          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The ternary structure shows the drug sandwiched between FKBP12 and a hydrophobic FRB cleft; neither protein contacts the other substantially, so binding is strictly drug-dependent." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 108" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
