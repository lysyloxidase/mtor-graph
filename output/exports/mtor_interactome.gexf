          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="In kidney transplant recipients without pre-existing diabetes, sirolimus was independently associated with new-onset diabetes across regimens, with adjusted hazard ratios of roughly 1.4-1.7." />
