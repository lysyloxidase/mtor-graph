      <edge source="MAT2A" target="SAM" id="355">
        <attvalues>
          <attvalue for="6" value="MAT2A" />
          <attvalue for="7" value="SAM" />
          <attvalue for="8" value="metabolic_conversion" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="MAT2A converts methionine and ATP into S-adenosylmethionine, the metabolite bound by SAMTOR, and acute MAT2A loss attenuates methionine sensing by mTORC1 in cultured cells; MAT2A is the extrahepatic isoform, whereas MAT1A predominates in adult liver." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="203" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
