      <edge source="RTB101" target="MTOR" id="318">
        <attvalues>
          <attvalue for="6" value="RTB101" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="RTB101 (BEZ235/dactolisib) is an ATP-competitive PI3K/mTOR inhibitor. At the low exposures studied in older adults, the intended pharmacodynamic effect was preferential TORC1 inhibition." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="291; 385" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="The immune-function trials did not establish a lifespan benefit." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="competitive_inhibition:2f39a8deb907aaba" />
        </attvalues>
      </edge>
      <edge source="RTB101" target="PHENO_RESPIRATORY_INFECTION" id="319">
        <attvalues>
          <attvalue for="6" value="RTB101" />
          <attvalue for="7" value="PHENO_RESPIRATORY_INFECTION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In the 264-participant phase 2a trial, six weeks of RTB101 with low-dose everolimus reduced participant-reported infections during one year of follow-up." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="384" />
          <attvalue for="14" value="phase 2a; combination treatment; participant-reported infections" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="This does not isolate the contribution of either drug or establish efficacy in later trials." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="physiological_output:e5738188961fb60f" />
        </attvalues>
      </edge>
      <edge source="RTB101" target="PHENO_SYMPTOMATIC_RESPIRATORY_ILLNESS" id="320">
        <attvalues>
          <attvalue for="6" value="RTB101" />
          <attvalue for="7" value="PHENO_SYMPTOMATIC_RESPIRATORY_ILLNESS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="The 1024-participant phase 3 trial did not meet its clinically symptomatic respiratory-illness endpoint. Phase 2b had found a signal for laboratory-confirmed infections with RTB101 monotherapy, while its combination comparison was not significant." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="385" />
          <attvalue for="14" value="phase 3 monotherapy" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Different endpoints and study populations limit cross-trial comparisons; failure cannot be attributed to removal of everolimus." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="physiological_output:3be674e949cc3812" />
        </attvalues>
