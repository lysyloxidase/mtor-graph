      <edge source="MTORC1" target="TISSUE_HAEMATOPOIETIC" id="853">
        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="TISSUE_HAEMATOPOIETIC" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Proliferating haematopoietic progenitors require mTORC1, which accounts for the cytopenias seen during rapalog therapy. Restraint of mTORC1 by the TSC complex is conversely required to keep haematopoietic stem cells quiescent: Tsc1 deletion drives stem cells out of quiescence, increases mitochondrial biogenesis and reactive oxygen species, and impairs self-renewal, so the compartment requires calibrated rather than maximal activity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="99" />
          <attvalue for="14" value="bone marrow" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
