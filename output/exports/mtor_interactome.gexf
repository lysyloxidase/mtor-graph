      <edge source="MTORC2" target="PHENO_TREG_EXPANSION" id="939">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="PHENO_TREG_EXPANSION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Loss of both mTOR complexes in CD4 T cells favours Foxp3+ regulatory T cell differentiation; an independent contribution of mTORC2 to this restraint, acting through AKT, is supported but less consistently than the mTORC1 arm." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="134" />
          <attvalue for="14" value="de novo Treg differentiation in vitro; not mature Treg expansion" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Differentiation, expansion and suppressive function are distinct endpoints; mature Tregs require mTORC1 for normal function." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="physiological_output:37b51ac80a50a1fb" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="PHENO_T_CELL_SURVIVAL" id="940">
