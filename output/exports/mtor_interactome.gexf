      <edge source="RPTOR" target="EIF4EBP1" id="965">
        <attvalues>
          <attvalue for="6" value="RPTOR" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Raptor binds the C-terminal TOS motif of 4E-BP1 and, according to NMR data, the N-terminal RAIP motif at a separate site, tethering 4E-BP1 so that its phosphoacceptor region is presented to the mTOR active site." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="70; 437; 532; 533" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="A direct RAIP-Raptor contact is disputed: Beugnet et al. 2003 (J Biol Chem 278:40717-40722) found no Raptor binding by the RAIP-containing N-terminal fragment of 4E-BP1." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:f7e0680c2304f484" />
        </attvalues>
      </edge>
