          <attvalue for="8" value="metabolic_conversion" />
          <attvalue for="9" value="converts_to" />
          <attvalue for="10" value="Glycolytic flux converts glucose to fructose-1,6-bisphosphate, so FBP concentration tracks glucose availability and serves as the proximal signal in the aldolase-dependent glucose-sensing route." />
