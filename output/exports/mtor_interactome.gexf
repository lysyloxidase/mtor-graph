          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Part of the double-negative AKT -| TSC -| Rheb circuit. AKT phosphorylated only at Thr308 retains substantial activity toward TSC2 [387,388]." />
