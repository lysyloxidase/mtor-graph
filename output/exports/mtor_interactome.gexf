      <edge source="VAR_DEPDC5_LOF" target="PHENO_RAPALOG_SENSITIVITY" id="113">
        <attvalues>
          <attvalue for="6" value="VAR_DEPDC5_LOF" />
          <attvalue for="7" value="PHENO_RAPALOG_SENSITIVITY" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="In an open-label series of five patients treated with everolimus titrated to troughs of 5-15 ng/mL, the three with DEPDC5 loss-of-function variants showed substantial seizure reduction, while a DEPDC5 missense variant gave a smaller response." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="417" />
          <attvalue for="14" value="GATOR1-related focal epilepsy" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Genotype within GATOR1 appears to predict response; the evidence is emerging, in contrast to the established case of everolimus in TSC." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="genetic_loss_of_function:9853e05883d7f09f" />
        </attvalues>
      </edge>
