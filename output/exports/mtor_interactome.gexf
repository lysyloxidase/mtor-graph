          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="GTP-bound H-Ras and K-Ras (predominantly KRAS4A) bind the atypical Ras-binding domain of mSin1. Oncogenic Ras was reported to promote mTORC2 activity at the plasma membrane, but a Sin1 mutant unable to bind Ras supports normal mTORC2 assembly and activity in cells and mice, and Sin1 overexpression was reported to suppress Ras signalling." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="91; 318; 537" />
          <attvalue for="14" value="shown chiefly with oncogenic KRAS/HRAS in cultured cells" />
          <attvalue for="15" value="upstream_of_mTORC2" />
          <attvalue for="16" value="The consequence of Ras binding for mTORC2 activity is disputed between laboratories. The Ras-binding domain is one of the defined mSin1 regions, but no function has been firmly assigned to it." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:e721206028b087c3" />
