      </edge>
      <edge source="RAPALINK1" target="FKBP12" id="221">
        <attvalues>
          <attvalue for="6" value="RAPALINK1" />
          <attvalue for="7" value="FKBP12" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="The rapamycin end of the bi-steric molecule recruits FKBP12; the resulting avidity for the FRB-bearing complex is what confers mTORC1 selectivity on an otherwise non-selective ATP-site warhead." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="501" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:09491e559a4efc4e" />
        </attvalues>
      </edge>
      <edge source="RAPALINK1" target="FRB_DOMAIN" id="222">
        <attvalues>
          <attvalue for="6" value="RAPALINK1" />
          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="FKBP12-RapaLink-1 engages the FRB domain, providing the anchoring half of the bi-steric mechanism." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="501" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="binding:a58d4b3f58feb6a3" />
        </attvalues>
      </edge>
      <edge source="RAPALINK1" target="MTOR" id="223">
        <attvalues>
          <attvalue for="6" value="RAPALINK1" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Bivalent engagement of FRB and the ATP cleft on the same mTOR protomer gives an avidity-driven potency far above either moiety alone." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="501" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="competitive_inhibition:e9eb0a545da41a99" />
        </attvalues>
      </edge>
      <edge source="RAPALINK1" target="MTORC1" id="224">
        <attvalues>
          <attvalue for="6" value="RAPALINK1" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Bivalent engagement gives complete mTORC1 suppression and retains activity against FRB resistance mutations that abolish rapalog binding, establishing the bi-steric concept." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="501" />
          <attvalue for="14" value="including FRB-mutant, rapalog-resistant cells" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:b7a9a4dba9216500" />
        </attvalues>
      </edge>
      <edge source="RAPALINK1" target="PHENO_CNS_DRUG_EXPOSURE" id="225">
        <attvalues>
          <attvalue for="6" value="RAPALINK1" />
          <attvalue for="7" value="PHENO_CNS_DRUG_EXPOSURE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="RapaLink-1 crosses the blood-brain barrier and accumulates in intracranial tumour tissue to a degree the first- and second-generation agents do not, which is the basis of its preclinical activity in glioblastoma models." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="164" />
          <attvalue for="14" value="preclinical glioblastoma models; no human data" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Bears on the pharmacokinetic constraint that restricted CNS access limits every neurological indication." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:5447306ab2039277" />
        </attvalues>
      </edge>
      <edge source="RAPALINK1" target="VAR_FRB_RESISTANCE" id="226">
        <attvalues>
          <attvalue for="6" value="RAPALINK1" />
          <attvalue for="7" value="VAR_FRB_RESISTANCE" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="RapaLink-1 tethers rapamycin to an ATP-competitive mTOR inhibitor, so that FKBP12-rapamycin anchoring at the FRB domain delivers the active-site moiety with high avidity. Potency is therefore retained against FRB-domain substitutions such as A2034V and F2108L, which weaken FKBP12-rapamycin binding and confer rapalog resistance, and against the kinase-domain substitution M2327I, which confers resistance to ATP-competitive inhibitors used alone." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="501" />
          <attvalue for="14" value="FRB-domain and kinase-domain mTOR resistance mutants" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:8902e3bbbfece4d7" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="FKBP12" id="227">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="FKBP12" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Rapamycin has no direct activity on mTOR; it first binds the immunophilin FKBP12 and the binary complex is the active species. The yeast FPR1 screen established this genetically." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 37; 229; 230" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:9af3551da7a01f34" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="FKBP12" id="228">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="FKBP12" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Rapamycin binds the FKBP12 immunophilin with low-nanomolar affinity; the binary complex, not free drug, is the inhibitory species, so FKBP12 is obligatory for all rapalog action." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 37; 108" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:2f8b6e18dde6dcfc" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="FKBP12_RAPAMYCIN" id="229">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="FKBP12_RAPAMYCIN" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Rapamycin is the drug half of the composite inhibitor; neither partner alone binds FRB with meaningful affinity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 37; 229; 230" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="complex_formation:48a0d2e48f898e50" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="FKBP12_RAPAMYCIN" id="230">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="FKBP12_RAPAMYCIN" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Rapamycin contributes the second half of the composite surface, its effector domain projecting away from FKBP12 to contact the FRB domain of mTOR." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 108" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="complex_formation:a91b9495c86c889d" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="CAP_DEPENDENT_TRANSLATION" id="231">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="CAP_DEPENDENT_TRANSLATION" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rapalogs suppress cap-dependent translation only partially. With FKBP12-rapamycin bound to the FRB domain, phosphorylation of 4E-BP1 at Ser65 and Thr70 is blocked while Thr37 and Thr46 remain largely phosphorylated, so eIF4F assembly continues at a substantial rate. The limitation is structural rather than a matter of dose." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="40; 70; 166; 603" />
          <attvalue for="14" value="rapalog exposure" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="ATP-competitive and bi-steric inhibitors suppress cap-dependent translation far more completely." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:6455d8a24b6b8557" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="EIF4EBP1" id="232">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Rapamycin blocks phosphorylation of the late 4E-BP1 sites Ser65 and Thr70 while largely sparing the priming sites Thr37 and Thr46, so binding of 4E-BP1 to eIF4E is only partly restored and cap-dependent translation continues. The limitation is structural rather than a matter of dose." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser65; Thr70" />
          <attvalue for="13" value="40; 70; 111; 166; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="The degree of resistance varies with cell type, and 4E-BP1 phosphorylation can recover during prolonged exposure." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:ab7b2d8963cd5d11" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="EIF4EBP1" id="233">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Thr37/Thr46 phosphorylation is relatively rapamycin-resistant in many experimental settings, limiting restoration of 4E-BP1-mediated repression of eIF4E." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Thr37; Thr46" />
          <attvalue for="13" value="40; 70; 193; 603" />
          <attvalue for="14" value="rapamycin-resistant sites" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Phosphosite sensitivity and the resulting translational response depend on cell type and exposure." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="drug_inhibition:f28da82e90ab7ad9" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="RIBOSOME_BIOGENESIS" id="234">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="RIBOSOME_BIOGENESIS" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rapamycin lowers activating Ser44 phosphorylation of TIF-IA/RRN3 and raises the inhibitory Ser199 site, blocks the S6K1-dependent phosphorylation of the UBF carboxy-terminal activation domain, and relieves mTORC1 repression of MAF1 — collapsing Pol I 47S pre-rRNA synthesis and Pol III tRNA/5S output together." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="214; 255; 400; 401; 409; 410; 565" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Rapamycin acts on both polymerase arms: phosphorylation of TIF-IA and of the UBF carboxy-terminal activation domain falls rapidly, while MAF1 escapes mTORC1-dependent inactivation and continues to repress RNA polymerase III." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:e05549f5d9a673f7" />
