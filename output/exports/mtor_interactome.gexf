        </attvalues>
      </edge>
      <edge source="MTORC2" target="TH2_DIFFERENTIATION" id="918">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TH2_DIFFERENTIATION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Rictor-mTORC2 is required for Th2 differentiation, whereas Rheb-mTORC1 is required for Th1 and Th17; both complexes are additionally required for the glycolytic and glutaminolytic reprogramming of effector activation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="134" />
          <attvalue for="14" value="CD4+ T lymphocyte" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:1ffbcf53acdbc673" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TIAM1" id="919">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TIAM1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Conditional Rictor deletion in the postnatal forebrain lowers Tiam1 levels and Tiam1-dependent Rac1 activation; the step between the complex and Tiam1 is undefined." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="250" />
          <attvalue for="14" value="postnatal murine forebrain" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Tiam1 is not a known substrate of the complex, and the relationship rests on a single line of work in one tissue." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:c98b9360441f5c02" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TIAM1" id="920">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TIAM1" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Forebrain mTORC2 promotes Rac1 activation through Tiam1 and the resulting actin polymerisation in dendritic spines, rather than acting through translational control; conditional Rictor deletion in postnatal forebrain selectively impairs late-phase LTP and long-term memory while sparing early-phase LTP and short-term memory." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="250" />
          <attvalue for="14" value="postnatal murine forebrain" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="The structural, actin-dependent arm of this division of labour has been demonstrated chiefly by one laboratory, in mice and flies." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:d3e17d0744041cd7" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_ADIPOSE" id="921">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_ADIPOSE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Adipocyte Rictor deletion reduces insulin-stimulated glucose uptake, alters lipid handling and negatively controls whole-body growth." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="126; 595" />
          <attvalue for="14" value="adipose tissue" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:90404bb5307fbb50" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_ADIPOSE" id="922">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_ADIPOSE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Adipocyte Rictor deletion alters lipid handling and whole-body growth; as in liver the complexes diverge, so net metabolic effect depends on drug selectivity and exposure." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="126; 595" />
          <attvalue for="14" value="adipose tissue" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:c5bd3114df60fb42" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_BETA_CELL" id="923">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_BETA_CELL" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="β-cell Rictor deletion causes mild hyperglycaemia with reduced β-cell mass, decreased AKT Ser473 phosphorylation, nuclear FOXO1 accumulation and elevated p27." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="202" />
          <attvalue for="14" value="pancreatic β-cell" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:d927ab1a39f89de8" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_CNS_NEURON" id="924">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_CNS_NEURON" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Conditional deletion of Rictor in the postnatal murine forebrain reduces mTORC2 activity and selectively impairs late-phase long-term potentiation and long-term memory while sparing early-phase potentiation and short-term memory; the mechanism is Tiam1–Rac1-dependent actin polymerisation with reduced dendritic spine density, and raising mTORC2 activity pharmacologically enhances long-term memory and reverses its age-associated decline." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="250; 280" />
          <attvalue for="14" value="CNS" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="The rodent genetics are well supported; the inference that this creates a cognitive deficit missed by standard metabolic monitoring, and its extrapolation to chronic low-dose human dosing, are not." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:c2864eecc11f6536" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_HEART" id="925">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_HEART" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Cardiomyocyte mTORC2 limits apoptosis and tissue loss after ischaemic injury through AKT-dependent anti-apoptotic signalling, complementing the mTORC1 contribution to physiological growth, so agents that ablate both complexes are predicted to be more cardiotoxic than mTORC1-selective ones." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="631" />
          <attvalue for="14" value="cardiomyocyte" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Shown in a myocardial infarction model in which suppression of mTORC2 increased cardiomyocyte apoptosis and tissue damage." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:0a95febc605a37ed" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_KIDNEY_TUBULE" id="926">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_KIDNEY_TUBULE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="mTORC2-dependent SGK1 activity governs ion handling in the distal nephron and therefore sodium balance and blood pressure; renal mTORC2 loss causes salt wasting and hypotension." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="329" />
          <attvalue for="14" value="kidney" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:f5025e408186a15c" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_LIVER" id="927">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_LIVER" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Hepatic mTORC2 restrains gluconeogenesis and supports glycolysis and lipogenesis; liver-specific Rictor deletion gives a type-2-diabetes-like phenotype." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="210; 327" />
          <attvalue for="14" value="liver" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:306cee0686965154" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_LIVER" id="928">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_LIVER" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Liver-specific Rictor deletion produces glucose intolerance and a phenotype reminiscent of type 2 diabetes, so hepatic mTORC2 is required for normal glucose handling." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="210" />
          <attvalue for="14" value="liver" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:97d0bf3c0d2dfbe6" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_OLIGODENDROCYTE" id="929">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_OLIGODENDROCYTE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="mTORC2 contributes to oligodendrocyte differentiation but is not rate-limiting while mTORC1 is intact; the deficit becomes apparent only in the raptor/rictor double mutant." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
