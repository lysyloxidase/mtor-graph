          <attvalue for="6" value="ALDOA" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="sensing" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="FBP-unoccupied aldolase alters v-ATPase-Ragulator conformation, permitting AXIN-LKB1 docking and lysosomal AMPK Thr172 phosphorylation without an AMP rise; FBP-bound aldolase blocks the assembly." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="698" />
          <attvalue for="14" value="glucose starvation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The sensed ligand is fructose-1,6-bisphosphate; the signal starts when it dissociates from aldolase as glucose falls. Reported mainly by one laboratory, which later showed that TRPV channels relay the aldolase signal (Li et al. 2019)." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
