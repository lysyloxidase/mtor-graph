          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Mechanical loading of skeletal muscle; activates mTORC1 through phospholipase D-derived phosphatidic acid, membrane perturbation and focal adhesion signalling, and is the stimulus whose protein-synthetic response rapamycin blocks in humans." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="load-bearing contraction; mechanical overload" />
        </attvalues>
      </node>
      <node id="MTORC2_ACTIVATOR" label="Small-molecule mTORC2 activator">
        <attvalues>
