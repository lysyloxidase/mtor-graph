          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Loss-of-function alteration of TSC1, a proximal-brake lesion; identified in exceptional responders to everolimus in urothelial carcinoma and present in roughly 8% of bladder cancers." />
          <attvalue for="4" value="TSC1" />
          <attvalue for="5" value="Tsc1 knockout; Tsc2 knockout; hamartin loss" />
        </attvalues>
      </node>
