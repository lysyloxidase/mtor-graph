          <attvalue for="13" value="331; 468" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Lysosomal residence of FLCN rises when amino acids are withdrawn, whereas its RagC/D GAP activity is exerted when they are restored." />
