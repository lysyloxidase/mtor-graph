          <attvalue for="7" value="TSC2" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="14-3-3 binds AKT-phosphorylated TSC2 at Ser939 and Thr1462, with Ser981 and the MK2-generated site Ser1210 also contributing, and partitions TSC2 into the cytosol away from the membrane compartment where it acts on Rheb; whether TSC1-TSC2 association is lost or the intact complex is displaced from the lysosomal surface remains unresolved." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser1210; Ser939; Ser981; Thr1462" />
          <attvalue for="13" value="72; 139; 345; 407" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="REDD1 has been reported to displace 14-3-3 from TSC2 under hypoxia, but direct displacement remains disputed." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sequestration:7479364119e9b6db" />
