          <attvalue for="7" value="TFEB" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="FLCN-FNIP loads RagC/D with GDP, which is specifically required for mTORC1 to phosphorylate TFEB at Ser211 and keep it cytoplasmic; FLCN loss therefore leaves TFEB nuclear while S6K1 and 4E-BP1 phosphorylation are preserved." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="429; 610" />
          <attvalue for="14" value="Birt-Hogg-Dube kidney" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="The effect on TFEB is indirect, exerted through the Rag heterodimer, and explains the tissue-dependent rather than uniform mTORC1 phenotype of FLCN loss." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:13133b88789ccf01" />
