        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_OLIGODENDROCYTE" id="930">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_OLIGODENDROCYTE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Rictor loss has modest, largely transient effects; only the double mutant impairs differentiation, so mTORC2 contributes but is not rate-limiting while mTORC1 is intact." />
          <attvalue for="11" value="established" />
