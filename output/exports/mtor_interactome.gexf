          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Accessory Rictor-binding mTORC2 subunit, paralogue of Protor-1; its degradation has been linked to enhanced mTORC2-dependent PKCδ phosphorylation and cell migration." />
          <attvalue for="4" value="PRR5L" />
          <attvalue for="5" value="" />
        </attvalues>
