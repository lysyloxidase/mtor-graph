      <edge source="RAPAMYCIN" target="PHENO_LIFESPAN_EXTENSION" id="247">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_LIFESPAN_EXTENSION" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Encapsulated rapamycin begun at 600 days of age extended median and maximal lifespan of genetically heterogeneous mice at three independent sites, raising the age at 90% mortality by 9% in males and 14% in females; a threefold higher dose of 42 ppm increased median lifespan by 23% in males and 26% in females, and treatment begun at 20 months extends survival even when given for only three months or in alternating months." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="224; 413; 578" />
          <attvalue for="14" value="genetically heterogeneous mice" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Continuous exposure is not required for lifespan extension, although the benefit of brief or intermittent dosing is sex-dependent." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:86ace68b5e5007a9" />
        </attvalues>
