        <attvalues>
          <attvalue for="6" value="TEMSIROLIMUS" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Temsirolimus binds FKBP12 and the binary complex engages the exposed FRB domain of assembled mTORC1, sterically restricting substrate access; it is given intravenously as an ester prodrug converted to sirolimus, which contributes much of the effect in vivo." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 37; 108; 373" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
