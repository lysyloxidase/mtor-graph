      <edge source="ABETA" target="DISEASE_AD" id="1244">
        <attvalues>
          <attvalue for="6" value="ABETA" />
          <attvalue for="7" value="DISEASE_AD" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Progressive accumulation and aggregation of amyloid-beta is a defining neuropathological feature of Alzheimer's disease and is causally sufficient in the autosomal dominant forms caused by APP and presenilin mutations, although its primacy in sporadic disease remains debated; this aggregate burden is also the target of the autophagy-based rationale for mTOR inhibition." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="71; 381; 573" />
          <attvalue for="14" value="Alzheimer's disease" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="In transgenic Alzheimer models, mTOR inhibition lowers brain amyloid-beta and improves cognition when started before substantial pathology has accumulated, and the benefit depends on intact autophagy; no controlled human efficacy data exist." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:18bdb317a23c56c3" />
