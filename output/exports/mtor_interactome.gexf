          <attvalue for="7" value="PHENO_LIFESPAN_EXTENSION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Encapsulated rapamycin begun at 600 days of age raised age at 90% mortality by 9% in male and 14% in female genetically heterogeneous mice at three independent sites; a threefold higher dietary dose of 42 ppm raised median lifespan by 23% in males and 26% in females, and late-life intermittent regimens also extended survival." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="224; 413; 578" />
          <attvalue for="14" value="genetically heterogeneous mice, Interventions Testing Program" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Genetic reduction of mTOR or S6K1 reproduces the effect, supporting on-target action; translation beyond rodents is unproven." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:075fefa7575e8e48" />
        </attvalues>
      </edge>
