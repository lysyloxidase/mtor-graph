          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The FKBP12-rapamycin binary complex engages the four-helix FRB bundle, forming the ternary complex resolved crystallographically." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 56; 107; 108; 514; 515" />
          <attvalue for="14" value="" />
