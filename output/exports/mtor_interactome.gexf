          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Acute inhibition is complex-selective because only mTORC1 presents an accessible FRB; suppression is substrate-selective, complete for S6K1 and incomplete for 4E-BP1." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="37; 166; 603" />
          <attvalue for="14" value="acute exposure" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
