      <edge source="RPTOR" target="MTORC1" id="969">
        <attvalues>
          <attvalue for="6" value="RPTOR" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Raptor is the defining stoichiometric subunit of mTORC1, two copies per dimer, wrapped around the N-HEAT solenoid of each mTOR protomer." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="14; 305; 362; 503" />
          <attvalue for="14" value="" />
