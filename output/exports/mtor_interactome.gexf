          <attvalue for="12" value="" />
          <attvalue for="13" value="541" />
          <attvalue for="14" value="female mice" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The lifespan effect comes from a single mouse cohort and has not been independently replicated; S6K1-null females also showed increased AMPK activation and a caloric restriction-like gene expression profile." />
