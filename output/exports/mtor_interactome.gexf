          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="DISEASE_ENDOMETRIAL_CANCER" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="One patient with PTEN- and PIK3CA-altered endometrial cancer achieved a complete response ongoing beyond six months, with clearance of pathway variants from circulating tumour DNA." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
