          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Pharmacological mTORC1 inhibition reverses the consequences of unrestrained mTORC1 in Bmal1-null animals, delaying their premature-ageing phenotypes and substantially extending lifespan" />
