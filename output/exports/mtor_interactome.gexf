          <attvalue for="7" value="HIF1A" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In normoxia PHD2 hydroxylates HIF-1α at Pro402 and Pro564 using O2 as co-substrate, creating the pVHL-binding degron; the reaction rate is limited by oxygen tension, which is what makes HIF-1α an oxygen sensor." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Pro402; Pro564" />
          <attvalue for="13" value="162; 266; 395" />
          <attvalue for="14" value="normoxia" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Pro402 and Pro564 lie in two independent oxygen-dependent degradation domains, each of which recruits pVHL once hydroxylated; PHD1 and PHD3 can hydroxylate the same residues." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:ab971fd06f74153d" />
