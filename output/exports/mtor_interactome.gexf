      <edge source="RAPAMYCIN" target="PHENO_LEAN_MASS" id="276">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_LEAN_MASS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="In the PEARL trial, lean tissue mass increased rather than decreased in women receiving 10 mg weekly compounded rapamycin, against the anabolic-resistance concern that chronic mTORC1 inhibition should reduce muscle mass in older adults." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="221; 416" />
          <attvalue for="14" value="women, 10 mg weekly compounded sirolimus, 48 weeks; secondary endpoint, exposure not confirmed by trough measurement" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Lean-mass monitoring is one of the measurements a serious geroscience trial must include; the direction of effect is unresolved, hence 'modulates'." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="physiological_output:9f2673d6c2d2688a" />
        </attvalues>
