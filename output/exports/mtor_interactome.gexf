      <node id="VAR_NF1_LOF" label="NF1 loss-of-function">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Loss of the Ras GAP neurofibromin, raising RAS-ERK-RSK flux onto the TSC complex; one of the lesions enrolled in the negative everolimus basket study." />
          <attvalue for="4" value="NF1" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="VAR_PIK3CA_GOF" label="PIK3CA activating mutation">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Helical (E542K, E545K) and kinase (H1047R/L) hotspot gain-of-function mutations in ~30–40% of breast and 30% of endometrial cancers; distal-network lesion." />
          <attvalue for="4" value="PIK3CA" />
          <attvalue for="5" value="PIK3CA hotspot mutation" />
        </attvalues>
      </node>
      <node id="VAR_PTEN_LOF" label="PTEN loss">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
