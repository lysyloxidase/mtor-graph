          <attvalue for="7" value="DISEASE_LAM" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Sirolimus stabilises lung function in lymphangioleiomyomatosis, whose lesional cells carry biallelic TSC2 inactivation with constitutive mTORC1 activation as the principal driver; it also reduces serum VEGF-D and improves symptoms." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
