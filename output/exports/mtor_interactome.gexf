      <node id="VAR_BMAL1_LOF" label="Bmal1 loss of function (Bmal1-null)">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Germline deletion of Bmal1 in mice: arrhythmic behaviour, elevated mTORC1 activity in multiple tissues and premature ageing phenotypes whose lifespan cost is substantially corrected by rapamycin." />
          <attvalue for="4" value="ARNTL" />
          <attvalue for="5" value="Arntl knockout; Bmal1-/-" />
        </attvalues>
      </node>
      <node id="VAR_PER2_LOF" label="PER2 loss of function (Per2-null)">
