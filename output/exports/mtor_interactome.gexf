      <edge source="RAPAMYCIN" target="PHENO_HYPERCHOLESTEROLAEMIA" id="293">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_HYPERCHOLESTEROLAEMIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Inhibition of mTOR raises plasma cholesterol alongside triglycerides through reduced lipoprotein lipase activity, increased adipose lipolysis and impaired clearance of apolipoprotein B-containing lipoproteins; the effect is dose-related at therapeutic exposures and is managed by lipid monitoring and statin therapy." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="568" />
          <attvalue for="14" value="mTORC2 and mTORC1" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Hypercholesterolaemia and hypertriglyceridaemia arise from the same disturbance of hepatic and adipose lipid handling and usually occur together." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:c793df66b2cc8f86" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_IMPAIRED_WOUND_HEALING" id="294">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_IMPAIRED_WOUND_HEALING" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Suppressed angiogenesis and fibroblast proliferation delay surgical healing, which is why planned perioperative interruption is advised before elective surgery." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="444" />
          <attvalue for="14" value="perioperative" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:f88fa9b8f21cae83" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_INFECTION" id="295">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_INFECTION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Suppression of effector lymphocyte expansion raises infection risk at immunosuppressive exposures; dose, schedule and vaccination timing are the available levers." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="444" />
          <attvalue for="14" value="immunosuppressive exposures" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Contrasts with enhanced vaccine and CD8 memory responses at low, partial-inhibition exposures." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:7bc0255c9b18e388" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_INSULIN_RESISTANCE" id="296">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_INSULIN_RESISTANCE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Prolonged dosing disrupts mTORC2 in liver, muscle and adipose tissue, producing insulin resistance that is mechanistically separable from the longevity benefit in mice." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="325" />
          <attvalue for="14" value="chronic dosing" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:b5c2522a600134aa" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_MUSCLE_HYPERTROPHY" id="297">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_MUSCLE_HYPERTROPHY" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rapamycin blocks hypertrophy in response to IGF-1, mechanical overload and chronic stimulation, and blocks the contraction-induced rise in human muscle protein synthesis, showing that mTORC1 activity is required for load-induced muscle growth." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="50; 149" />
          <attvalue for="14" value="rodent overload models and human contraction studies" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Ageing muscle already responds less strongly to loading and to amino acids, so lean mass is the principal concern during chronic exposure in older adults." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:c45d510576caad66" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_PNEUMONITIS" id="298">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_PNEUMONITIS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Non-infectious pneumonitis occurs in roughly 5-15% of oncology patients treated with rapalogs and is the most serious and least well understood toxicity of the class. It is probably immune-mediated rather than a direct consequence of mTORC1 blockade in lung epithelium, and management rests on vigilance, dose interruption and discontinuation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="444; 648" />
          <attvalue for="14" value="complex attribution unclear" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Reported for both sirolimus and everolimus; the best-characterised series come from everolimus-treated renal cell carcinoma." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:8ea0a8db2c6edd27" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_PROTEIN_AGGREGATES" id="299">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_PROTEIN_AGGREGATES" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Induction of macroautophagy accelerates clearance of alpha-synuclein and polyglutamine-expanded huntingtin, reducing aggregate burden and improving outcomes in fly and mouse models." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="382; 488; 645" />
          <attvalue for="14" value="cellular and animal models" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="physiological_output:58194559d7bcd4f5" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PROTEIN_SYNTHESIS" id="300">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PROTEIN_SYNTHESIS" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Acute rapamycin blocks the contraction-induced rise in human muscle protein synthesis, and mTORC1 activation is required for the response to essential amino acids." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="144; 149" />
          <attvalue for="14" value="human skeletal muscle" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="The tissue most clearly requiring mTORC1 is also the one most at risk from chronic inhibition in older adults." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:c7f9418b4ef0c3c7" />
        </attvalues>
      </edge>
      <edge source="RIDAFOROLIMUS" target="FKBP12" id="301">
        <attvalues>
          <attvalue for="6" value="RIDAFOROLIMUS" />
          <attvalue for="7" value="FKBP12" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Ridaforolimus binds FKBP12, and the binary complex engages the exposed FRB domain of assembled mTORC1, inhibiting the kinase allosterically as for the other first-generation rapalogs." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 37; 108" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:9418fbc76aed5058" />
        </attvalues>
      </edge>
      <edge source="RIDAFOROLIMUS" target="MTORC1" id="302">
        <attvalues>
          <attvalue for="6" value="RIDAFOROLIMUS" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="FKBP12-ridaforolimus complex binds the exposed FRB domain of assembled mTORC1 and sterically restricts substrate access." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="24; 37; 108" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:0d2f1e1399278b0b" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="EIF4EBP1" id="303">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="RMC-5552 tethers an FKBP12-rapamycin moiety to an ATP-site moiety; FKBP12-mediated avidity confers mTORC1 selectivity while the ATP-site moiety blocks catalysis. Phosphorylation of 4E-BP1 at all four sites, including the rapamycin-resistant priming sites Thr37 and Thr46, is therefore suppressed, and hypophosphorylated 4E-BP1 binds eIF4E. The activation of the repressor is indirect, through inhibition of mTORC1 kinase activity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser65; Thr37; Thr46; Thr70" />
          <attvalue for="13" value="69; 339" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Whether complete suppression of 4E-BP1 phosphorylation translates into genotype-dependent clinical benefit is not yet established." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:bc9f744aa0a490c8" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="RPS6KB1" id="304">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="RPS6KB1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The bi-steric design tethers an FKBP12-rapamycin moiety to an ATP-site moiety; FKBP12-mediated avidity confers mTORC1 selectivity while the ATP-site moiety delivers complete catalytic inhibition, so both S6K1 Thr389 and 4E-BP1 are fully suppressed while mTORC2 is relatively spared." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Thr389" />
          <attvalue for="13" value="69; 339" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="RMC-5552 suppresses both S6K1 and 4E-BP1 phosphorylation fully while relatively sparing mTORC2. The effect on S6K1 is indirect, through inhibition of mTORC1 kinase activity." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:8fd68922cd8eaabc" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="DISEASE_ENDOMETRIAL_CANCER" id="305">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
