          <attvalue for="7" value="EIF4E" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Hypophosphorylated 4E-BP1 binds the dorsal surface of eIF4E through the canonical YXXXXLΦ motif shared with eIF4G and through a secondary site, sequestering eIF4E from eIF4F. Multisite phosphorylation releases eIF4E; in the paralogue 4E-BP2, phosphorylation of Thr37 and Thr46 folds the protein into a β-domain that buries this motif." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="19; 40; 109; 193; 209; 453; 463; 572" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sequestration:f578e663d7a352cb" />
