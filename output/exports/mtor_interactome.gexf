          <attvalue for="6" value="RPTOR" />
          <attvalue for="7" value="ULK1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Raptor mediates the nutrient-dependent association of mTORC1 with the ULK1-ATG13-FIP200 complex, presenting ULK1 for inhibitory phosphorylation at Ser758 (Ser757 in mouse), which prevents its activation by AMPK; the net effect of the interaction on ULK1 is inhibitory." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="242; 286; 309" />
          <attvalue for="14" value="nutrient-rich conditions" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="manual override: Raptor binds the ULK1 TOS motif to present ULK1 for inhibitory Ser757 phosphorylation by mTORC1; the net effect of the Raptor-ULK1 interaction on ULK1 activity is inhibitory, so a positive sign would mislead sign-aware path queries." />
