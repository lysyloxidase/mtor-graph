          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="PTEN is one of the most frequently mutated genes in endometrioid endometrial carcinoma, and a patient with PTEN- and PIK3CA-altered endometrial cancer had a complete response to the mTORC1-selective inhibitor RMC-5552 that was ongoing beyond six months." />
          <attvalue for="11" value="established" />
