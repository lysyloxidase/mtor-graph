          <attvalue for="7" value="ATP6AP1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Metformin-bound PEN2 binds the v-ATPase accessory subunit ATP6AP1 and inhibits the lysosomal v-ATPase, triggering AXIN–LKB1-dependent activation of lysosomal AMPK at clinically relevant metformin concentrations and without a fall in cellular ATP." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="372" />
          <attvalue for="14" value="low-dose metformin" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Completes the low-dose metformin route from PEN2 through v-ATPase inhibition to lysosomal AMPK activation; reported by a single laboratory (Ma T et al., Nature 2022;603:159-165)." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
