      <edge source="RPTOR" target="AKT1S1" id="964">
        <attvalues>
          <attvalue for="6" value="RPTOR" />
          <attvalue for="7" value="AKT1S1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="PRAS40 carries a bona fide TOS motif read by the same Raptor pocket as substrate TOS motifs, which is why it behaves as a competitive rather than allosteric inhibitor." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="437; 520; 532; 620; 637" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
