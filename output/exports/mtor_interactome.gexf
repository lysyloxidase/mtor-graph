          <attvalue for="7" value="SNCA" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Alpha-synuclein is degraded by both macroautophagy and the proteasome, and mTOR inhibition with rapamycin induces autophagy and lowers alpha-synuclein levels in cell models; rapamycin also protects dopaminergic neurons in rodent models of Parkinson disease." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
