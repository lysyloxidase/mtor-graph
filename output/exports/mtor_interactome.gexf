          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Accessory mTORC2 subunit binding Rictor; dispensable for complex assembly but implicated in efficient mTORC2-dependent SGK1 activation, notably in kidney." />
          <attvalue for="4" value="PRR5" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PRR5L" label="Protor-2">
