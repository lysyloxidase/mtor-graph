        <attvalues>
          <attvalue for="6" value="SESN3" />
          <attvalue for="7" value="GATOR2" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Sestrin3 also binds GATOR2 and negatively regulates the amino-acid sensing pathway upstream of mTORC1" />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="94" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
