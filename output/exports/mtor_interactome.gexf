      <edge source="PRR5" target="SGK1" id="946">
        <attvalues>
          <attvalue for="6" value="PRR5" />
          <attvalue for="7" value="SGK1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Protor-1 knockout mice show reduced mTORC2-dependent SGK1 activation and NDRG1 phosphorylation in kidney, with AKT signalling preserved." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="456" />
          <attvalue for="14" value="mouse kidney" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Protor-1 loss leaves AKT and PKCalpha hydrophobic- and turn-motif phosphorylation intact, so the requirement is restricted to SGK1 and has been shown only in kidney." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:a0478f7cbc331777" />
        </attvalues>
