        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="TISSUE_HYPOTHALAMUS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="In the arcuate nucleus mTORC1 operates as a nutrient sensor, which makes the hyperphagia of Smith-Kingsmore syndrome mechanistically expected rather than incidental." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="120; 419" />
          <attvalue for="14" value="hypothalamic arcuate nucleus, rodent" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Established in rodents and unresolved in humans, where the central and peripheral contributions have not been separated; some metabolic effects attributed to liver, adipose tissue and beta-cells may therefore be centrally mediated." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
