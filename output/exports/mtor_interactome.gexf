          <attvalue for="0" value="transcription_program" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Coordinated Lysosomal Expression And Regulation network of approximately 470 lysosomal and autophagy genes driven by TFEB/TFE3 through a palindromic E-box promoter motif." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="CLEAR network" />
        </attvalues>
      </node>
      <node id="GLUTAMINE_ANAPLEROSIS" label="glutamine anaplerosis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Replenishment of TCA-cycle intermediates from glutamine-derived alpha-ketoglutarate, supported downstream of mTORC1 by the S6K1-GDH axis and by c-Myc." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="glutaminolysis" />
        </attvalues>
      </node>
      <node id="GLUTATHIONE_SYNTHESIS" label="glutathione synthesis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="ATF4-dependent production of glutathione downstream of mTORC1, linking growth signalling to redox buffering alongside protein synthesis." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="GSH synthesis" />
        </attvalues>
      </node>
      <node id="GLYCOLYSIS" label="glycolysis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Glycolytic flux; supported by hepatic mTORC2 via AKT and glucokinase, and required (with glutaminolysis) for effector T-cell metabolic reprogramming." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Warburg-type glycolysis; glycolytic reprogramming" />
        </attvalues>
      </node>
      <node id="LIPOGENESIS" label="de novo lipogenesis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="SREBP1-driven fatty-acid synthesis downstream of mTORC1; in liver it is the basis of mTORC1-associated steatosis and of rapalog-associated dyslipidaemia." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="fatty acid synthesis" />
        </attvalues>
      </node>
      <node id="LYSOSOME_BIOGENESIS" label="lysosomal biogenesis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="TFEB/TFE3-driven expansion of lysosomal number and degradative capacity through the CLEAR network; suppressed by mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="MITOCHONDRIAL_BIOGENESIS" label="mitochondrial biogenesis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Expansion of mitochondrial mass and oxidative capacity supported by 4E-BP-dependent translation of nuclear-encoded mitochondrial mRNAs and by the YY1-PGC-1alpha transcriptional complex." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="ONE_CARBON_METABOLISM" label="one-carbon/folate metabolism">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Mitochondrial tetrahydrofolate cycle supplying formyl and methyl units for nucleotide synthesis and methylation reactions; coupled to mTORC1 through ATF4-MTHFD2." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="folate cycle" />
        </attvalues>
      </node>
      <node id="PENTOSE_PHOSPHATE_PATHWAY" label="pentose phosphate pathway">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Oxidative branch activated through SREBP-driven G6PD expression; supplies NADPH for reductive biosynthesis and ribose-5-phosphate for nucleotides." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="PPP" />
        </attvalues>
      </node>
      <node id="PURINE_SYNTHESIS" label="de novo purine synthesis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Purine nucleotide production driven by mTORC1 through ATF4-dependent control of the mitochondrial tetrahydrofolate cycle." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PYRIMIDINE_SYNTHESIS" label="de novo pyrimidine synthesis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Pyrimidine nucleotide production stimulated acutely by the S6K1-CAD Ser1859 axis downstream of mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="SASP" label="senescence-associated secretory phenotype">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Pro-inflammatory secretome of senescent cells, which requires mTORC1-driven translation (IL1A; MAPKAPK2); rapamycin suppresses the SASP without eliminating senescent cells, an example of geroprotective benefit without causal primacy." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="SASP" />
        </attvalues>
      </node>
      <node id="ACTIN_CYTOSKELETON" label="Actin cytoskeleton">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Actin filament organisation and polymerisation; the founding mTORC2-dependent output, driven through Rho-family GTPases, PKC isoforms and Tiam1–Rac1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="CELL_ADHESION" label="Cell adhesion">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Cell–matrix and cell–cell adhesion dynamics downstream of PKC and Rho-family signalling, reduced in mTORC2-deficient cells." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="CELL_MIGRATION" label="Cell migration">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Directed cell motility dependent on cytoskeletal remodelling; impaired when mTORC2-dependent PKC protein and Rho-family signalling are lost." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="CELL_SURVIVAL" label="Cell survival signalling">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Anti-apoptotic programme sustained by AKT phosphorylation of BAD and of FOXO transcription factors; the arm of AKT output most dependent on mTORC2-mediated Ser473 phosphorylation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="EPITHELIAL_POLARITY" label="Epithelial polarity">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Apicobasal organisation of epithelial sheets, established largely through atypical PKC in the Par3–Par6 module and therefore dependent on mTORC2-mediated PKC maturation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="GLUCOSE_UPTAKE" label="Insulin-stimulated glucose uptake">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="GLUT4-mediated glucose entry into muscle and adipose tissue following insulin; reduced by adipose Rictor deletion and by chronic mTORC2 loss." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="ION_TRANSPORT" label="Distal nephron ion transport">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Transepithelial sodium, potassium and chloride handling in the distal nephron, set by SGK1-dependent regulation of ENaC, the Na+/K+-ATPase and CLC-K channels." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="LIPOLYSIS" label="Lipolysis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Hydrolysis of stored triacylglycerol in adipocytes. An adipose mTORC2-dependent output alongside insulin-stimulated glucose uptake; adipocyte Rictor deletion alters lipid handling." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="LTP_LATE_PHASE" label="Late-phase LTP (L-LTP)">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Protein-synthesis-dependent late phase of hippocampal long-term potentiation and the long-term memory that depends on it; rapamycin-sensitive, whereas early-phase LTP and short-term memory are spared." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="L-LTP" />
        </attvalues>
      </node>
      <node id="MYELINATION" label="CNS myelination">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Formation and maintenance of oligodendrocyte myelin sheaths in the central nervous system. Oligodendrocyte-lineage deletion separates the complexes: Raptor loss causes persistent hypomyelination, Rictor loss has modest and largely transient effects, and only the double mutant impairs oligodendrocyte differentiation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TH2_DIFFERENTIATION" label="Th2 effector differentiation">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Differentiation of naive CD4+ T cells into Th2 effector cells. Selectively dependent on Rictor-mTORC2, in contrast to Th1/Th17 differentiation, which depends on Rheb-mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TREG_DIFFERENTIATION" label="Foxp3+ regulatory T cell differentiation">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Differentiation of naive CD4+ T cells into Foxp3+ regulatory T cells. Restrained by both mTOR complexes; loss of mTOR kinase activity promotes it, which is the basis of preferential Treg expansion under rapamycin." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Treg differentiation" />
        </attvalues>
      </node>
      <node id="CIRCADIAN_CLOCK" label="Circadian clock (transcription–translation feedback loop)">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Cell-autonomous ~24 h oscillator built from the CLOCK–BMAL1 activator limb and the PER/CRY repressor limb; entrained centrally by light and peripherally by feeding, and reciprocally coupled to mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="TTFL; molecular clock" />
        </attvalues>
      </node>
      <node id="GLUTAMINOLYSIS" label="Glutaminolysis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Glutamine catabolism supporting anaplerosis; part of the metabolic reprogramming of effector T-cell activation that requires both mTOR complexes." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="INSULIN_SECRETION" label="Insulin secretion">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Glucose-stimulated insulin release from pancreatic beta-cells. Insulin secretion and beta-cell survival are the mTORC2-dependent outputs of the beta-cell; reduced secretion is part of the mechanism of rapamycin-associated NODAT." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="KETOGENESIS" label="Ketogenesis">
        <attvalues>
          <attvalue for="0" value="process" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="Hepatic production of ketone bodies during fasting; a liver mTORC1-dependent output. mTORC1 suppresses fasting ketogenesis via PPARalpha/NCoR1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="DISEASE_BHD" label="Birt-Hogg-Dube syndrome">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Autosomal dominant syndrome of fibrofolliculomas, pulmonary cysts with pneumothorax and renal tumours caused by FLCN loss." />
          <attvalue for="4" value="FLCN" />
          <attvalue for="5" value="BHD" />
        </attvalues>
      </node>
      <node id="DISEASE_GATOR1_EPILEPSY" label="GATOR1-related focal epilepsy (FFEVF)">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Familial focal epilepsies caused by heterozygous loss-of-function variants in DEPDC5, NPRL2 or NPRL3, with elevated SUDEP risk; everolimus titrated to troughs of 5-15 ng/mL gave genotype-dependent, mixed results in small open-label series. Graded emerging, in explicit contrast to established everolimus in TSC." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="FFEVF; GATOR1 epilepsy" />
        </attvalues>
      </node>
      <node id="DISEASE_SZT2_ENCEPHALOPATHY" label="SZT2-related developmental and epileptic encephalopathy">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Infantile encephalopathy with epilepsy, intellectual disability, macrocephaly and a dysmorphic corpus callosum, caused by biallelic SZT2 mutations." />
          <attvalue for="4" value="SZT2" />
          <attvalue for="5" value="DEE18; SZT2 syndrome" />
        </attvalues>
      </node>
      <node id="PHENO_AGE_MEMORY_IMPAIRMENT" label="Age-associated memory impairment">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Decline in long-term memory with age; reversed in mice and flies by a small molecule that raises mTORC2 activity, which also enhances L-LTP in wild-type animals." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_BODY_GROWTH" label="Whole-body growth">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Organismal body size and growth trajectory. Adipose-tissue mTORC2 negatively controls whole-body growth, so adipocyte Rictor deletion increases body size - a direction of effect opposite to the usual anabolic framing of mTOR signalling." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_GLUCOSE_INTOLERANCE" label="Glucose intolerance / insulin resistance">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Impaired systemic glucose handling arising chiefly from mTORC2 loss: liver-specific Rictor deletion produces a type-2-diabetes-like phenotype, and chronic rapamycin reproduces it pharmacologically." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_HYPOTENSION" label="Hypotension">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Low systemic arterial pressure resulting from impaired distal nephron sodium reabsorption. Reported together with salt wasting on renal mTORC2 loss, downstream of failed SGK1-dependent activation of ENaC, Na+/K+-ATPase and CLC-K." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="low blood pressure" />
        </attvalues>
      </node>
      <node id="PHENO_LONG_TERM_MEMORY" label="Long-term memory consolidation">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Persistent memory formation requiring late-phase LTP; selectively impaired by forebrain Rictor deletion while short-term memory is spared." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_SALT_WASTING" label="Salt wasting and hypotension">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Distal-nephron phenotype of renal mTORC2 loss, mediated by failure of SGK1-dependent ENaC and Na+/K+-ATPase regulation; the predicted electrolyte disturbance of mTORC2 inhibition in kidney." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="renal salt wasting" />
        </attvalues>
      </node>
      <node id="TISSUE_BETA_CELL" label="Pancreatic β-cell">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Islet cell type in which both complexes are required; β-cell Rictor deletion causes mild hyperglycaemia with reduced β-cell mass, lower AKT Ser473 phosphorylation and nuclear FOXO1 accumulation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TISSUE_CNS_NEURON" label="CNS neuron">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Forebrain neurons in which mTORC2 supports actin-dependent consolidation of long-term memory and spine density; the only tissue where mTORC2 loss produces a cognitive rather than metabolic deficit." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TISSUE_HEART" label="Cardiomyocyte">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Cardiac muscle cell in which mTORC2 is cytoprotective during ischaemia–reperfusion through AKT-dependent anti-apoptotic signalling, so that dual inhibitors are predicted to be more cardiotoxic." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TISSUE_KIDNEY_TUBULE" label="Renal tubule (distal nephron)">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Aldosterone-sensitive distal nephron, where mTORC2–SGK1 signalling governs sodium handling; tubular mTORC2 loss produces salt wasting and hypotension." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TISSUE_SKELETAL_MUSCLE" label="Skeletal muscle">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Tissue in which mTORC1 is dominant and mTORC2 largely dispensable: muscle-specific Rictor deletion is close to phenotypically silent while Raptor deletion causes dystrophy." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="DISEASE_SKS" label="Smith–Kingsmore syndrome">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Germline gain-of-function MTOR mTORopathy with macrocephaly, intellectual disability and seizures; its phenotype has been extended to include sleep–wake and circadian disturbance, hyperphagia and hyperactivity." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="SKS" />
        </attvalues>
      </node>
      <node id="PHENO_CIRCADIAN_AMPLITUDE" label="Cellular circadian amplitude">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Amplitude of the cellular circadian oscillation, dampened by pathogenic MTOR variants in Smith-Kingsmore syndrome and improved by low-dose rapamycin in engineered U2OS cells expressing SKS-associated MTOR variants." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="clock amplitude" />
        </attvalues>
      </node>
      <node id="PHENO_CIRCADIAN_BEHAVIOUR_ABNORMALITY" label="Circadian behavioural abnormality">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Disrupted period, phase or consolidation of locomotor rhythms in rodent models of mTOR hyperactivation; rescued by reducing Bmal1 gene dosage, implicating BMAL1 proteostasis as the mediating lesion." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="abnormal locomotor rhythm" />
        </attvalues>
      </node>
      <node id="PHENO_CIRCADIAN_PERIOD" label="Circadian period length">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Free-running period of molecular and behavioural rhythms; lengthened by mTOR inhibition in SCN explants, fibroblasts and mice [484]." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="free-running period; tau" />
        </attvalues>
      </node>
      <node id="PHENO_DELAYED_SLEEP_WAKE_PHASE_DISORDER" label="Delayed sleep–wake phase disorder">
