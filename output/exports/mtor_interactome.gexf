          <attvalue for="7" value="NCBP1" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="S6K1 phosphorylates CBP80, the large subunit of the nuclear cap-binding complex, at residues that are also phosphorylated in cells in a growth-factor-dependent, rapamycin-sensitive manner, and S6K1 is found together with SKAR on CBP80-bound spliced mRNAs." />
