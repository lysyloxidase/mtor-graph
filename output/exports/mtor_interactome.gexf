      <edge source="SLC1A5" target="GLUTAMINE" id="370">
        <attvalues>
          <attvalue for="6" value="SLC1A5" />
          <attvalue for="7" value="GLUTAMINE" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="SLC1A5 (ASCT2) is an obligatory sodium-dependent antiporter for glutamine; in the original model its uptake supplies the intracellular glutamine that LAT1 effluxes to drive leucine import, although later work finds ASCT2 dispensable for glutamine accumulation and mTORC1 activation when SNAT1 and SNAT2 are expressed." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="55; 435" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The transport step itself is firmly established; the role of ASCT2 as the driver of leucine-dependent mTORC1 activation is disputed." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="transport:c424d493171ffef1" />
        </attvalues>
      </edge>
      <edge source="SLC38A9" target="AMINO_ACIDS" id="371">
        <attvalues>
          <attvalue for="6" value="SLC38A9" />
          <attvalue for="7" value="AMINO_ACIDS" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Arginine-activated SLC38A9 effluxes essential amino acids from the lysosomal lumen into the cytosol, which is how protein taken up by macropinocytosis or autophagy becomes usable nutrient; loss of SLC38A9 traps these amino acids in the lysosome." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="642; 664" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Lysosomal efflux through SLC38A9 is well supported, but its quantitative weight relative to cytosolic amino-acid sensing is undefined." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="transport:ab89e05c6ccf2b45" />
        </attvalues>
      </edge>
      <edge source="SLC38A9" target="LEUCINE" id="372">
        <attvalues>
          <attvalue for="6" value="SLC38A9" />
          <attvalue for="7" value="LEUCINE" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="SLC38A9 effluxes leucine and other essential amino acids from the lysosomal lumen in an arginine-dependent manner, supplying the cytosolic pool read by Sestrin2" />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="642; 664" />
          <attvalue for="14" value="protein- and autophagy-derived amino acids" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Lysosomal leucine efflux through SLC38A9 is well supported; its quantitative weight relative to cytosolic sensing is undefined." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="transport:1f8cead92a9fd3ac" />
        </attvalues>
      </edge>
      <edge source="SLC38A9" target="MTORC1" id="373">
        <attvalues>
          <attvalue for="6" value="SLC38A9" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Node-level summary: SLC38A9 activates mTORC1 through luminal arginine sensing and through lysosomal efflux of leucine and other essential amino acids; the cholesterol-sensing arm it shares with NPC1 is less firmly established and is carried separately." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="92; 288; 489; 642; 664" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Established for the arginine-sensing and transport arms; the cholesterol arm is emerging." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:016b6458b3711a00" />
        </attvalues>
      </edge>
      <edge source="SLC38A9" target="NPC1" id="374">
        <attvalues>
          <attvalue for="6" value="SLC38A9" />
          <attvalue for="7" value="NPC1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="SLC38A9 and NPC1 physically associate in the lysosomal cholesterol-sensing pathway. This binding edge does not assert inhibition of NPC1 transport by SLC38A9." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="92" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Reciprocal arm of the SLC38A9-NPC1 cholesterol switch; the cholesterol route is less firmly established than arginine sensing." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:2c710447f85e33d5" />
        </attvalues>
      </edge>
      <edge source="SLC38A9" target="RAGULATOR" id="375">
        <attvalues>
          <attvalue for="6" value="SLC38A9" />
          <attvalue for="7" value="RAGULATOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="SLC38A9 co-assembles with Ragulator and the Rag GTPases as part of the lysosomal amino-acid sensing machinery; this contact positions the transceptor, while the arginine-dependent activating signal is exerted on the Rag GTPases." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="288; 489" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
