          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Circadian rhythm sleep disorder in which habitual sleep onset and offset are shifted substantially later than conventional times; precipitated in some Smith–Kingsmore patients by high-dose rapamycin." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="DSWPD; delayed sleep-wake phase" />
        </attvalues>
      </node>
      <node id="PHENO_HYPERACTIVITY" label="Hyperactivity">
