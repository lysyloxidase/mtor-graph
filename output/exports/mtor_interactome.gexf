    <nodes>
      <node id="AKG" label="alpha-Ketoglutarate">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="TCA-cycle intermediate produced by glutaminolysis; promotes GTP loading of RagB and lysosomal mTORC1 translocation, reportedly through prolyl hydroxylase activity." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="2-oxoglutarate; aKG" />
        </attvalues>
      </node>
      <node id="AMINO_ACIDS" label="Amino acids (pool)">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Products of autophagolysosomal protein degradation that replenish lysosomal and cytosolic pools and reactivate mTORC1, making the autophagy-mTORC1 system oscillatory rather than switch-like." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="AA; amino acid sufficiency" />
        </attvalues>
      </node>
      <node id="AMINO_ACID_STARVATION" label="Amino-acid starvation">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Deprivation of one or more amino acids; beyond Rag/GATOR sensing it activates GCN2 via uncharged tRNA, driving ATF4-dependent Sestrin2 induction that sustains mTORC1 suppression." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="amino-acid deprivation" />
        </attvalues>
      </node>
      <node id="ARGININE" label="Arginine">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Amino acid sensed in the cytosol by CASTOR1 and in the lysosomal lumen by SLC38A9; both routes converge on the Rag heterodimer." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Arg; L-arginine" />
        </attvalues>
      </node>
      <node id="CHOLESTEROL" label="Cholesterol (lysosomal)">
        <attvalues>
          <attvalue for="0" value="lipid" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Lysosomal sterol pool that activates mTORC1 through an SLC38A9-NPC1 signalling complex; this arm is an emerging mechanism." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="lysosomal cholesterol" />
        </attvalues>
      </node>
      <node id="GDP" label="GDP">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Guanine nucleotide whose binding to RagC/D is required for the active, mTORC1-recruiting configuration of the Rag heterodimer." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="guanosine diphosphate" />
        </attvalues>
      </node>
      <node id="GLUTAMINE" label="Glutamine">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Most abundant free amino acid; signals to mTORC1 both through Rag-independent Arf1-dependent routes and through glutaminolytic production of alpha-ketoglutarate." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Gln; L-glutamine" />
        </attvalues>
      </node>
      <node id="GTP" label="GTP">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Guanine nucleotide whose binding to RagA/B produces the Raptor-binding competent state of the heterodimer." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="guanosine triphosphate" />
        </attvalues>
      </node>
      <node id="LEUCINE" label="Leucine">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Branched-chain essential amino acid and the most potent single amino-acid activator of mTORC1; the ligand at the centre of the competing Sestrin2, LARS1, SAR1B and lysosomal-efflux sensing models." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="L-leucine; Leu" />
        </attvalues>
      </node>
      <node id="METHIONINE" label="Methionine">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Essential amino acid and a well-established longevity-modifying dietary variable; signals to mTORC1 indirectly through its conversion to S-adenosylmethionine." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="L-methionine; Met" />
        </attvalues>
      </node>
      <node id="SAM" label="S-adenosylmethionine">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Universal methyl donor whose cellular concentration tracks methionine availability; the direct ligand of SAMTOR." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="AdoMet; SAM" />
        </attvalues>
      </node>
      <node id="VAR_NPRL2_LOF" label="NPRL2 loss-of-function variants">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Loss-of-function NPRL2 variants removing the catalytic arginine-finger subunit of GATOR1, causing GATOR1-related focal epilepsy with cortical dysplasia." />
          <attvalue for="4" value="NPRL2" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="ANDROGEN" label="Androgens">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Testosterone/DHT; via the androgen receptor increase mTORC1 activity in prostate cancer cells; AR and PI3K–AKT are reciprocally cross-regulated in PTEN-deficient prostate cancer." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="DHT; testosterone" />
        </attvalues>
      </node>
      <node id="ESTROGEN" label="Estrogen (17β-estradiol)">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Steroid hormone; via ERα engages non-genomic PI3K–AKT signalling and promotes survival/metastasis of TSC2-null cells (relevant to lymphangioleiomyomatosis)." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="17β-estradiol; E2" />
        </attvalues>
      </node>
      <node id="IGF1" label="IGF-1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Insulin-like growth factor 1; growth-hormone-dependent ligand of IGF-1R that activates PI3K–AKT and mTORC1 (muscle hypertrophy, growth)." />
          <attvalue for="4" value="IGF1" />
          <attvalue for="5" value="insulin-like growth factor 1" />
        </attvalues>
      </node>
      <node id="INFLAMMATION" label="Chronic inflammation">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Inflammatory (NF-κB-axis) signalling that activates IKKβ, suppressing TSC1 and raising mTORC1 activity; proposed link between inflammation and anabolic dysregulation of ageing tissue." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="INSULIN" label="Insulin">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Pancreatic β-cell peptide hormone; principal physiological ligand of INSR, driving IRS–PI3K–AKT signalling to TSC2/PRAS40 and thus mTORC1." />
          <attvalue for="4" value="INS" />
          <attvalue for="5" value="INS" />
        </attvalues>
      </node>
      <node id="LEPTIN" label="Leptin">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Adipose-derived satiety hormone whose anorectic action requires intact hypothalamic mTOR signalling." />
          <attvalue for="4" value="LEP" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="MECHANICAL_LOAD" label="Mechanical load">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Resistance exercise / eccentric contraction / stretch; activates mTORC1 in muscle through PLD–PA, membrane perturbation and focal-adhesion signalling, largely independently of ERK and PI3K." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="mechanical overload; resistance exercise" />
        </attvalues>
      </node>
      <node id="RESISTANCE_EXERCISE" label="Resistance exercise / mechanical overload">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Mechanical loading of skeletal muscle (resistance exercise, overload, chronic stimulation) that activates mTORC1 through phospholipase D-derived phosphatidic acid, membrane perturbation and focal adhesion signalling." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="mechanical overload; resistance training" />
        </attvalues>
      </node>
      <node id="TNF" label="TNFα">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Inflammatory cytokine that activates IKK-beta, which phosphorylates and suppresses TSC1, raising mTORC1 output; a molecular link between chronic inflammation and anabolic dysregulation." />
          <attvalue for="4" value="TNF" />
          <attvalue for="5" value="TNF-α; tumour necrosis factor" />
        </attvalues>
      </node>
      <node id="VAR_TBC1D7_LOF" label="TBC1D7 loss of function">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Biallelic truncating TBC1D7 variants causing macrocephaly/megalencephaly with intellectual disability and elevated mTORC1 signalling in patient cells." />
          <attvalue for="4" value="TBC1D7" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="WNT" label="Wnt ligands">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Canonical Wnt signalling inhibits GSK3, removing GSK3-dependent activation of TSC2 and thereby stimulating mTORC1 independently of β-catenin." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Wnt" />
        </attvalues>
      </node>
      <node id="A769662" label="A-769662">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Thienopyridone direct AMPK activator binding the ADaM site at the alpha-kinase/beta-CBM interface; beta1-selective; allosterically activates AMPK and protects Thr172 from dephosphorylation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="ADP" label="ADP">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Adenosine diphosphate; binds AMPK gamma CBS sites and protects pThr172 from dephosphorylation without allosteric activation; physiologically relevant because cellular ADP exceeds AMP." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="adenosine diphosphate" />
        </attvalues>
      </node>
      <node id="AICAR" label="AICAR (acadesine)">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Cell-permeable nucleoside converted to ZMP, an AMP mimetic that binds AMPK gamma and activates AMPK; classical experimental AMPK activator with known off-target effects." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="ZMP precursor; acadesine" />
        </attvalues>
      </node>
      <node id="AMP" label="AMP">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Adenosine monophosphate; rises disproportionately when ATP falls (adenylate kinase equilibrium) and is the primary low-energy signal that allosterically activates AMPK and promotes net Thr172 phosphorylation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="adenosine monophosphate" />
        </attvalues>
      </node>
      <node id="ATP" label="ATP">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Adenosine triphosphate; competes with AMP/ADP for AMPK gamma nucleotide sites, keeping AMPK inactive when energy charge is high." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="adenosine triphosphate" />
        </attvalues>
      </node>
      <node id="CALCIUM" label="Ca2+ (cytosolic calcium)">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Lysosomal calcium released through TRPML1 into a local microdomain, activating calcineurin adjacent to the lysosomal surface." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Ca2+/CaM; calcium" />
        </attvalues>
      </node>
      <node id="CALORIC_RESTRICTION" label="Caloric restriction">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Sustained reduction in energy intake that lowers mTORC1 signalling; its effect on hepatic mTOR signalling is time-of-day dependent, so feeding schedule confounds comparison between dietary-restriction studies." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="CR; dietary restriction" />
        </attvalues>
      </node>
      <node id="DNA_DAMAGE" label="DNA damage">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Genotoxic stress (ionising radiation, etoposide, ROS) activating ATM/ATR-CHK2 and p53; p53 transcriptional targets (sestrins, REDD1, PTEN, TSC2, AMPK beta1) collectively suppress mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="genotoxic stress" />
        </attvalues>
      </node>
      <node id="ENERGY_STRESS" label="Energy stress (high AMP/ATP)">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Any state in which ATP consumption exceeds production (glucose deprivation, hypoxia, mitochondrial inhibition, exercise), raising AMP/ADP:ATP and engaging the LKB1-AMPK checkpoint on mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="low energy charge; metabolic stress" />
        </attvalues>
      </node>
      <node id="ER_STRESS" label="ER stress (unfolded protein response)">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Endoplasmic-reticulum stress; one of the two mechanisms (with suppressed autophagy) by which chronic mTORC1 hyperactivation drives beta-cell dedifferentiation and failure." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="UPR; unfolded protein response" />
        </attvalues>
      </node>
      <node id="EXERCISE" label="Exercise">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Physical activity; endurance/contractile activity activates muscle AMPK (energy turnover), while resistance loading activates muscle mTORC1 through phosphatidic acid and mechanotransduction - opposite inputs by modality." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="physical activity" />
        </attvalues>
      </node>
      <node id="FBP" label="Fructose-1,6-bisphosphate">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Glycolytic intermediate whose concentration reports glucose availability. FBP occupancy of aldolase prevents the apo-aldolase conformation that nucleates the lysosomal v-ATPase–Ragulator–AXIN–LKB1 platform, so falling FBP activates AMPK before any change in the AMP:ATP ratio." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="FBP; fructose 1,6-bisphosphate" />
        </attvalues>
      </node>
      <node id="GLUCOSE" label="Glucose">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Principal energy substrate; glucose sufficiency is relayed to mTORC1 through Rag GTPases (largely AMPK-independent, DHAP proposed as the sensed glycolytic intermediate) and keeps AMPK inactive by sustaining ATP and FBP." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="D-glucose" />
        </attvalues>
      </node>
      <node id="GLUCOSE_DEPRIVATION" label="Glucose deprivation">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Glucose withdrawal; activates AMPK through AMP/ADP rise and through an AMP-independent aldolase-FBP route at the lysosome, inhibits mTORC1 via Rag GTPases and HK2-Raptor binding, and induces REDD1 via ATF4." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="glucose starvation; low glucose" />
        </attvalues>
      </node>
      <node id="GLYCOGEN" label="Glycogen">
        <attvalues>
          <attvalue for="0" value="metabolite" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Storage polysaccharide sensed directly by the carbohydrate-binding module of the AMPK β-subunit; branched glycogen with single α-1,6 branch points inhibits AMPK, coupling cellular carbohydrate reserves to the energy-sensing arm upstream of mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="HYPOXIA" label="Hypoxia">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Low oxygen tension; inhibits mTORC1 through HIF-1-driven REDD1 induction and TSC activation, through AMPK activation secondary to falling ATP, and through BNIP3-Rheb binding." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="low oxygen" />
        </attvalues>
      </node>
      <node id="OXIDATIVE_STRESS" label="Oxidative stress (ROS)">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Reactive oxygen species (H2O2, mitochondrial ROS); activate cytoplasmic ATM-LKB1-AMPK, a peroxisomal TSC pool and AMPK (directly or via ATP depletion), collectively repressing mTORC1 and inducing autophagy." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="H2O2; ROS" />
        </attvalues>
      </node>
      <node id="VAR_STRADA_LOF" label="STRADA biallelic loss of function">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Homozygous 7-kb LYK5/STRADA deletion (Old Order Mennonite founder) or other biallelic loss; impairs LKB1-AMPK signalling and causes PMSE syndrome with neuronal mTORC1 hyperactivation." />
          <attvalue for="4" value="STRADA" />
          <attvalue for="5" value="LYK5; LYK5 deletion" />
        </attvalues>
      </node>
      <node id="LYSOSOMAL_STRESS" label="Lysosomal stress">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Lysosomal damage or stress that triggers TRPML1-mediated local calcium release and calcineurin-dependent TFEB dephosphorylation. Together with mTORC1 inhibition, it is a trigger of TFEB nuclear entry." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="LIGHT" label="Light (photic input)">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Photic signal reaching the suprachiasmatic nucleus via the retinohypothalamic tract; the dominant entraining stimulus for the central clock and an acute activator of SCN signalling cascades including mTORC1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="light pulse; photic stimulation" />
        </attvalues>
      </node>
      <node id="SLEEP_DEPRIVATION" label="Sleep deprivation">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="0" />
