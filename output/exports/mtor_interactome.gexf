          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Kinetic rather than absolute selectivity: with prolonged exposure the FKBP12-rapalog complex captures newly synthesised mTOR before its incorporation into mTORC2, so chronic dosing inhibits mTORC2 in many cell types even though preassembled mTORC2 is spared acutely." />
          <attvalue for="11" value="established" />
