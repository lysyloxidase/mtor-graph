          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Small GTPase resident on lysosomal/endomembrane surfaces; GTP-loaded Rheb binds the mTOR kinase domain and allosterically activates it, making lysosomal co-localisation the point of pathway convergence." />
          <attvalue for="4" value="RHEB" />
          <attvalue for="5" value="Ras homolog enriched in brain; Ras homologue enriched in brain; Rheb1" />
