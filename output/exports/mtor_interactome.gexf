      <edge source="RMC5552" target="PHENO_STOMATITIS" id="316">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="PHENO_STOMATITIS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Mucositis occurred in 49% of 57 patients and grade 3 mucositis was dose-limiting at 10 mg or above, making it the characteristic limitation of the bi-steric generation." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="535" />
          <attvalue for="14" value="1.6-16 mg weekly intravenous, phase 1" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Single-arm dose-escalation data; the direction is consistent with the oral-epithelial toxicity seen with allosteric rapalogs." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:a2c1a88ba8e1b961" />
