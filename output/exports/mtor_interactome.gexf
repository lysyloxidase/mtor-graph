          <attvalue for="7" value="EIF4E" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The C-terminal DM15 region of LARP1 binds the m7G cap and the adjacent 5'TOP pyrimidine tract at the same time. This occludes the cap from eIF4E and excludes eIF4F from TOP mRNAs when mTORC1 is inactive." />
