      <edge source="VAR_DEPDC5_LOF" target="EVEROLIMUS" id="115">
        <attvalues>
          <attvalue for="6" value="VAR_DEPDC5_LOF" />
          <attvalue for="7" value="EVEROLIMUS" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Genotype within the GATOR1 complex appears to influence everolimus response in the familial focal epilepsies: in an open-label series, patients with DEPDC5 loss-of-function variants showed substantial seizure reduction, a patient with a DEPDC5 missense variant responded less, and the single NPRL3 patient worsened, whereas a later series in NPRL2- and NPRL3-related epilepsy reported seizure reduction in all four treated patients. The evidence is open-label and very small, and a controlled trial is required before this becomes practice." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="84; 417" />
          <attvalue for="14" value="genotype-directed therapy within GATOR1" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="other:9c4469b4944052cf" />
