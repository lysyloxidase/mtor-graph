        <attvalues>
          <attvalue for="6" value="RNF152" />
          <attvalue for="7" value="RHEB" />
          <attvalue for="8" value="ubiquitination" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The lysosomal E3 ligase RNF152 mono-ubiquitinates Rheb at Lys8, increasing its affinity for the TSC complex and suppressing mTORC1; EGF stimulation acts through AKT-phosphorylated USP4, which deubiquitinates Rheb and releases it from the complex." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="Lys8" />
          <attvalue for="13" value="136" />
          <attvalue for="14" value="growth-factor withdrawal" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Reported by a single laboratory and not independently replicated in vivo; the same group identified RNF152 as the E3 ligase for RagA." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="ubiquitination:3281827163423206" />
        </attvalues>
