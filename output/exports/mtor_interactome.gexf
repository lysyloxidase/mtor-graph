        <attvalues>
          <attvalue for="6" value="EIF4EBP1" />
          <attvalue for="7" value="PHENO_PHOTIC_ENTRAINMENT" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="4E-BP1 restrains entrainment: Eif4ebp1-null mice show accelerated re-entrainment to a shifted light schedule and larger photic phase shifts, mirroring their elevated VIP levels" />
          <attvalue for="11" value="emerging" />
