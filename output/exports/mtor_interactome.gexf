          <attvalue for="2" value="1" />
          <attvalue for="3" value="Cytoplasmic leucyl-tRNA synthetase proposed to act as a leucine-responsive RagD GAP; the assignment is contested because the yeast orthologue acts on the RagA/B counterpart with opposite polarity." />
          <attvalue for="4" value="LARS1" />
          <attvalue for="5" value="LARS; LeuRS" />
        </attvalues>
      </node>
      <node id="MAT2A" label="MAT2A (methionine adenosyltransferase 2A)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Enzyme converting methionine and ATP into S-adenosylmethionine; it generates the ligand actually sensed by SAMTOR, so methionine availability reaches mTORC1 only through MAT2A-produced SAM." />
          <attvalue for="4" value="MAT2A" />
          <attvalue for="5" value="MATII" />
        </attvalues>
      </node>
      <node id="NPC1" label="NPC1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Lysosomal cholesterol export protein that physically associates with SLC38A9; its loss traps cholesterol in the lumen and hyperactivates mTORC1." />
          <attvalue for="4" value="NPC1" />
          <attvalue for="5" value="Niemann-Pick C1" />
        </attvalues>
      </node>
      <node id="OGT" label="O-GlcNAc transferase (OGT)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Sole enzyme adding O-linked GlcNAc from UDP-GlcNAc; the hexosamine pathway flux it reports is the proposed means by which glucose gates LARS1 function." />
          <attvalue for="4" value="OGT" />
          <attvalue for="5" value="uridine diphospho-N-acetylglucosamine transferase" />
        </attvalues>
      </node>
      <node id="SAMTOR" label="SAMTOR">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="S-adenosylmethionine sensor (Kd about 7 uM) that, unlike Sestrin2 and CASTOR1, acts directly on the GATOR1-KICSTOR assembly, linking dietary methionine to mTORC1." />
          <attvalue for="4" value="SAMTOR" />
          <attvalue for="5" value="BMT2; C7orf60" />
        </attvalues>
      </node>
      <node id="SAR1B" label="SAR1B">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="COPII-associated small GTPase reported to bind leucine and regulate mTORC1; a single-laboratory finding awaiting independent replication." />
          <attvalue for="4" value="SAR1B" />
          <attvalue for="5" value="SARA2" />
        </attvalues>
      </node>
      <node id="SESN1" label="Sestrin1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Sestrin family member that binds GATOR2 and is a p53 target; expressed in a tissue-restricted pattern that may determine which leucine-sensing mechanism dominates in a given tissue." />
          <attvalue for="4" value="SESN1" />
          <attvalue for="5" value="PA26" />
        </attvalues>
      </node>
      <node id="SESN2" label="Sestrin2">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Stress-inducible sestrin transcribed by p53 (DNA damage) and ATF4 (ER stress, amino-acid starvation via GCN2); apo-Sestrin2 sequesters GATOR2 to inhibit mTORC1 and was reported to activate AMPK; also a leucine sensor." />
          <attvalue for="4" value="SESN2" />
          <attvalue for="5" value="Hi95; SEST2" />
        </attvalues>
      </node>
      <node id="SESN3" label="Sestrin3">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Third Sestrin paralogue that also binds GATOR2; differential tissue expression across SESN1/2/3 underlies context-dependent leucine sensing." />
          <attvalue for="4" value="SESN3" />
          <attvalue for="5" value="SEST3" />
        </attvalues>
      </node>
      <node id="SLC1A5" label="SLC1A5 (ASCT2)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Plasma-membrane glutamine importer whose accumulated glutamine is the exchange substrate that drives LAT1-mediated leucine uptake." />
          <attvalue for="4" value="SLC1A5" />
          <attvalue for="5" value="ASCT2; ATB0" />
        </attvalues>
      </node>
      <node id="SLC38A9" label="SLC38A9">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Lysosomal transceptor: reports luminal arginine through its N-terminal domain, exports leucine and other essential amino acids to the cytosol, and cooperates with NPC1 to couple lysosomal cholesterol to mTORC1." />
          <attvalue for="4" value="SLC38A9" />
          <attvalue for="5" value="SLC38A9.1" />
        </attvalues>
      </node>
      <node id="SLC3A2" label="SLC3A2 (CD98 heavy chain)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Heavy chain that disulphide-bonds to SLC7A5 to form the functional LAT1 transporter." />
          <attvalue for="4" value="SLC3A2" />
          <attvalue for="5" value="4F2hc; CD98hc" />
        </attvalues>
      </node>
      <node id="SLC7A5" label="SLC7A5 (LAT1 light chain)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Bidirectional plasma-membrane antiporter that couples glutamine efflux to leucine influx, supplying the cytosolic leucine pool read by the sensors." />
          <attvalue for="4" value="SLC7A5" />
          <attvalue for="5" value="CD98 light chain; L-type amino acid transporter 1; LAT1" />
        </attvalues>
      </node>
      <node id="V_ATPASE" label="Lysosomal v-ATPase">
        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Vacuolar H+-ATPase that acidifies the lysosome and undergoes amino-acid-dependent conformational change, relaying luminal amino-acid content outward to Ragulator - the inside-out sensing mechanism." />
          <attvalue for="4" value="ATP6V1A, ATP6V0A1, ATP6V1B2" />
          <attvalue for="5" value="V-ATPase; vacuolar H+-ATPase" />
        </attvalues>
      </node>
      <node id="AR" label="Androgen receptor">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Nuclear receptor whose activation raises mTORC1 output and cyclin D translation in prostate cancer; reciprocal feedback with PI3K–AKT (PTEN loss)." />
          <attvalue for="4" value="AR" />
          <attvalue for="5" value="AR" />
        </attvalues>
      </node>
      <node id="EGFR" label="EGFR">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Epidermal growth factor receptor; activates PI3K mainly via GAB1 (and ERBB3 heterodimers) and Ras via GRB2–SOS; frequently amplified/mutated in cancer." />
          <attvalue for="4" value="EGFR" />
          <attvalue for="5" value="ErbB1; HER1" />
        </attvalues>
      </node>
      <node id="ESR1" label="Estrogen receptor α">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Nuclear receptor phosphorylated by S6K1 at Ser167, giving ligand-independent transcriptional activity." />
          <attvalue for="4" value="ESR1" />
          <attvalue for="5" value="ERalpha; ERα" />
        </attvalues>
      </node>
      <node id="IGF1R" label="IGF-1 receptor">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Receptor tyrosine kinase for IGF-1. Reported to be tyrosine-phosphorylated and activated by the intrinsic tyrosine kinase activity of mTOR within mTORC2, constituting a feed-forward arm from mTORC2 back onto the receptor tier. NOTE: this node may already exist in the growth_factor_input module; the assembler should deduplicate rather than create a second copy." />
          <attvalue for="4" value="IGF1R" />
          <attvalue for="5" value="IGF-1R; IGF1R; type I IGF receptor" />
        </attvalues>
      </node>
      <node id="INSR" label="Insulin receptor">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="α2β2 receptor tyrosine kinase; insulin binding triggers β-subunit autophosphorylation and IRS recruitment. Target of Grb10-mediated mTORC1 feedback." />
          <attvalue for="4" value="INSR" />
          <attvalue for="5" value="IR" />
        </attvalues>
      </node>
      <node id="IRS1" label="IRS-1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Insulin receptor substrate 1; tyrosine-phosphorylated docking protein whose pYXXM motifs recruit p85–PI3K. Inhibitory serine phosphorylation by S6K1 is the classical mTORC1 negative-feedback arm." />
          <attvalue for="4" value="IRS1" />
          <attvalue for="5" value="IRS-1 adaptor; insulin receptor substrate 1" />
        </attvalues>
      </node>
      <node id="NF1" label="Neurofibromin (NF1)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Ras GAP; its loss raises Ras·GTP and ERK/RSK input to TSC2. NF1 loss is a recurrent cancer lesion in this pathway." />
          <attvalue for="4" value="NF1" />
          <attvalue for="5" value="neurofibromin" />
        </attvalues>
      </node>
      <node id="PHOSPHATIDIC_ACID" label="Phosphatidic acid">
        <attvalues>
          <attvalue for="0" value="lipid" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Phospholipase D product that binds the FRB domain of mTOR in competition with FKBP12-rapamycin and promotes complex stability and signalling; a mechanical/nutrient-responsive lipid input." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="PA" />
        </attvalues>
      </node>
      <node id="PI3K" label="Class I PI3K (p110α/p85)">
        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Class IA phosphoinositide 3-kinase: p110α catalytic (PIK3CA) with p85 regulatory subunit; converts PIP2 to PIP3 on RTK/IRS/Ras input. PIK3CA hotspot mutations are frequent distal-network cancer lesions." />
          <attvalue for="4" value="PIK3CA; PIK3R1" />
          <attvalue for="5" value="PIK3CA; p110alpha; p110α; phosphoinositide 3-kinase" />
        </attvalues>
      </node>
      <node id="PIK3R1" label="p85α (PIK3R1)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Regulatory subunit of class IA PI3K; stabilises p110, restrains its basal activity via nSH2/iSH2 contacts, and relieves that inhibition when its SH2 domains bind pYXXM motifs." />
          <attvalue for="4" value="PIK3R1" />
          <attvalue for="5" value="p85α" />
        </attvalues>
      </node>
      <node id="PIP2" label="PI(4,5)P2">
        <attvalues>
          <attvalue for="0" value="lipid" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Phosphatidylinositol 4,5-bisphosphate; plasma-membrane substrate of class I PI3K and product of PTEN." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="PtdIns(4,5)P2" />
        </attvalues>
      </node>
      <node id="PIP3" label="PI(3,4,5)P3">
        <attvalues>
          <attvalue for="0" value="lipid" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Phosphatidylinositol-3,4,5-trisphosphate generated by PI3K; bound by the mSin1 PH domain, relieving its autoinhibition of mTORC2 and recruiting the complex to the plasma membrane." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="PtdIns(3,4,5)P3" />
        </attvalues>
      </node>
      <node id="PLD1" label="Phospholipase D1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Phospholipase D isoform generating phosphatidic acid after mechanical stimulation of muscle; proposed mechanical input to mTORC1." />
          <attvalue for="4" value="PLD1" />
          <attvalue for="5" value="PLD; phospholipase D" />
        </attvalues>
      </node>
      <node id="PTEN" label="PTEN">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="PIP3 3-phosphatase and tumour suppressor; the main negative regulator of PI3K–AKT. Loss (prostate, GBM, endometrium) raises PIP3/AKT flux; it acts as a distal-network lesion." />
          <attvalue for="4" value="PTEN" />
          <attvalue for="5" value="MMAC1" />
        </attvalues>
      </node>
      <node id="RAS" label="Ras (K/H/N-Ras)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Small GTPase activated by RTK–GRB2–SOS; Ras·GTP recruits RAF (ERK cascade) and binds the p110α RBD; its pathway converges on TSC2 and Raptor to raise mTORC1 output." />
          <attvalue for="4" value="HRAS" />
          <attvalue for="5" value="HRAS; KRAS; NRAS; RAS" />
        </attvalues>
      </node>
      <node id="RTK" label="Receptor tyrosine kinases (generic)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Growth-factor receptors (EGFR, ERBB2, PDGFR, MET, FGFR etc.) whose autophosphorylated tyrosines recruit PI3K (directly or via adaptors) and GRB2–SOS to Ras. Amplification converges on PI3K in cancer." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="receptor tyrosine kinase" />
        </attvalues>
      </node>
      <node id="ALDOA" label="Aldolase A">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Glycolytic aldolase acting as a glucose sensor: when not occupied by fructose-1,6-bisphosphate it signals through the lysosomal v-ATPase to assemble the AXIN-LKB1-AMPK module and suppress Ragulator-dependent mTORC1 activation." />
          <attvalue for="4" value="ALDOA" />
          <attvalue for="5" value="aldolase" />
        </attvalues>
      </node>
      <node id="ATP6AP1" label="ATP6AP1 (v-ATPase accessory subunit 1)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Accessory subunit of the lysosomal v-ATPase and the binding partner of PEN2 in the low-dose metformin route; the PEN2–ATP6AP1 interaction inhibits v-ATPase and triggers lysosomal AMPK activation without a fall in cellular ATP." />
          <attvalue for="4" value="ATP6AP1" />
          <attvalue for="5" value="Ac45" />
        </attvalues>
      </node>
      <node id="AXIN1" label="AXIN1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Scaffold that, under low energy or glucose, tethers LKB1 to AMPK (AXIN-AMPK-LKB1 complex) and to v-ATPase-Ragulator at the lysosome, while blocking Ragulator GEF activity toward RagA/B to switch mTORC1 off." />
          <attvalue for="4" value="AXIN1" />
          <attvalue for="5" value="AXIN; axin" />
        </attvalues>
      </node>
      <node id="CAB39" label="MO25-alpha (CAB39)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Armadillo-repeat scaffold that binds the C-terminus of STRADA and stabilises the LKB1-STRADA-MO25 heterotrimer, increasing LKB1 activity about 10-fold beyond STRADA alone." />
          <attvalue for="4" value="CAB39" />
          <attvalue for="5" value="MO25; calcium-binding protein 39" />
        </attvalues>
      </node>
      <node id="CAMKK2" label="CaMKK2 (CaMKK-beta)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Ca2+/calmodulin-dependent kinase kinase that phosphorylates AMPK Thr172 in response to rises in cytosolic Ca2+, independently of LKB1 and of the AMP:ATP ratio." />
          <attvalue for="4" value="CAMKK2" />
          <attvalue for="5" value="CaMKK-beta" />
        </attvalues>
      </node>
      <node id="EGLN1" label="PHD2 (EGLN1)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Prolyl-4-hydroxylase domain protein 2, the principal cellular oxygen sensor. Uses O2 and 2-oxoglutarate to hydroxylate HIF-1α at Pro402/Pro564, creating the pVHL recognition site; hypoxia inactivates it, stabilising HIF-1α and inducing REDD1 and BNIP3." />
          <attvalue for="4" value="EGLN1" />
          <attvalue for="5" value="HIF prolyl hydroxylase 2; PHD2" />
        </attvalues>
      </node>
      <node id="EIF2AK3" label="PERK (EIF2AK3)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="ER-resident eIF2alpha kinase activated by unfolded proteins (BiP release); phosphorylates eIF2alpha Ser51 to launch the integrated stress response and ATF4 translation." />
          <attvalue for="4" value="EIF2AK3" />
          <attvalue for="5" value="PERK" />
        </attvalues>
      </node>
      <node id="LKB1_COMPLEX" label="LKB1-STRADA-MO25 complex">
        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Heterotrimeric, constitutively active AMPK upstream kinase complex; AMP binding to AMPK gamma makes AMPK a better substrate rather than activating LKB1 itself. Also recruited to lysosomes by AXIN under glucose starvation." />
          <attvalue for="4" value="STK11; STRADA; CAB39" />
          <attvalue for="5" value="LKB1 complex" />
        </attvalues>
      </node>
      <node id="MITOCHONDRIAL_COMPLEX_I" label="Mitochondrial complex I (NADH dehydrogenase)">
        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Entry point of the respiratory chain (approximately 45 subunits); its inhibition by metformin/phenformin or by hypoxia-limited respiration lowers ATP and raises AMP/ADP, activating AMPK." />
          <attvalue for="4" value="NDUFS1; NDUFV1; MT-ND1" />
          <attvalue for="5" value="NADH:ubiquinone oxidoreductase" />
        </attvalues>
      </node>
      <node id="PEN2" label="PEN2 (PSENEN)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Gamma-secretase subunit identified as the direct low-dose metformin binding protein; metformin-bound PEN2 engages ATP6AP1 to inhibit v-ATPase, triggering AXIN-LKB1 recruitment and lysosomal AMPK activation." />
          <attvalue for="4" value="PSENEN" />
          <attvalue for="5" value="presenilin enhancer 2" />
        </attvalues>
      </node>
      <node id="PEX5" label="PEX5 (peroxisomal import receptor)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Peroxisomal targeting-signal receptor reported to bind TSC1/TSC2 and localise a TSC complex pool to peroxisomes, where ROS activate TSC2 to repress mTORC1 and trigger autophagy." />
          <attvalue for="4" value="PEX5" />
          <attvalue for="5" value="peroxin 5" />
        </attvalues>
      </node>
      <node id="STK11" label="LKB1 (STK11)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Constitutively active master upstream kinase that phosphorylates AMPK Thr172 (and 12 AMPK-related kinases); requires STRADA and MO25 for activity and cytoplasmic localisation. Tumour suppressor lost in Peutz-Jeghers syndrome." />
          <attvalue for="4" value="STK11" />
          <attvalue for="5" value="LKB1; serine/threonine kinase 11" />
        </attvalues>
      </node>
      <node id="STRADA" label="STRAD-alpha (STRADA)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="energy_stress_input" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Pseudokinase that binds the LKB1 kinase domain, induces its active conformation and retains LKB1 in the cytoplasm. Biallelic loss causes PMSE syndrome with impaired LKB1-AMPK signalling and neuronal mTORC1 hyperactivation." />
          <attvalue for="4" value="STRADA" />
          <attvalue for="5" value="LYK5; STE20-related adaptor alpha" />
        </attvalues>
      </node>
