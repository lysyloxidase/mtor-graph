          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Indirect relay: ROS-activated cytoplasmic ATM acts through LKB1 to increase AMPK Thr172 phosphorylation, and AMPK then phosphorylates TSC2, represses mTORC1 and induces autophagy; the response is lost in ATM-deficient cells, and no direct phosphorylation of AMPK by ATM has been shown." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="5" />
          <attvalue for="14" value="oxidative stress (H2O2)" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Reported by one laboratory; the proposed ATM-LKB1 step is phosphorylation of LKB1 at Thr366." />
