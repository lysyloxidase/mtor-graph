          <attvalue for="7" value="DISEASE_PD" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rapamycin protects dopaminergic neurons in cellular and rodent models of Parkinson disease; in those models protection tracked with blocked production of the stress protein RTP801/REDD1 and preserved AKT phosphorylation, whereas the catalytic inhibitor Torin1 was not protective. Enhanced autophagic clearance of alpha-synuclein is a separate route shown in other model systems." />
          <attvalue for="11" value="emerging" />
