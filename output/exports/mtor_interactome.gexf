          <attvalue for="2" value="8" />
          <attvalue for="3" value="Carcinoma with PIK3CA mutation in roughly 30% and PTEN loss in roughly 35% of cases; site of the complete response to RMC-5552." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="DISEASE_FCD2" label="Focal cortical dysplasia type II">
