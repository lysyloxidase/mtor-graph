          <attvalue for="0" value="disease" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="TSC-associated (or sporadic LAM-associated) renal tumour; EXIST-2 indication, with 42% of everolimus-treated patients achieving at least 50% reduction." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="AML" />
        </attvalues>
      </node>
      <node id="DISEASE_BREAST_CANCER" label="HR+/HER2- advanced breast cancer">
