      <edge source="RICTOR" target="MTORC2" id="961">
        <attvalues>
          <attvalue for="6" value="RICTOR" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Rictor is the defining stoichiometric subunit of mTORC2, binding the mTOR solenoid and bridging to mSin1." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="102; 269; 525; 531" />
