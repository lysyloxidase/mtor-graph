          <attvalue for="13" value="81" />
          <attvalue for="14" value="Eif4ebp1-null mice" />
          <attvalue for="15" value="circadian" />
          <attvalue for="16" value="Accelerated re-entrainment and larger light-induced phase shifts in 4E-BP1-null mice come from a single genetic study and have not been independently replicated." />
