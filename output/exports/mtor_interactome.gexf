          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rictor packs against the FRB domain, occluding the FKBP12–rapamycin binding surface; this is the structural basis for rapamycin insensitivity of preassembled mTORC2." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="102; 531" />
          <attvalue for="14" value="" />
