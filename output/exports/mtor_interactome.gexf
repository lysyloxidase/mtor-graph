          <attvalue for="7" value="PHENO_LEAN_MASS" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="In PEARL, lean tissue mass increased rather than decreased in women on 10 mg weekly compounded rapamycin; a secondary, sex-restricted finding at very low exposure." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="416" />
          <attvalue for="14" value="48-week weekly dosing in adults aged 50-85" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Subgroup analysis; no trough concentrations measured. Reassuring but not evidence of efficacy." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="drug_inhibition:60c14c98f70edf29" />
