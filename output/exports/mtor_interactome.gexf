        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="~1.0 MDa homodimer of mTOR, mLST8, Rictor and mSin1 with substoichiometric Protor-1/2 and DEPTOR; FRB occluded by Rictor-mSin1, hence acutely rapamycin-insensitive. Phosphorylates AGC kinases via distal docking." />
          <attvalue for="4" value="MTOR, RICTOR, MLST8, MAPKAP1, PRR5, PRR5L, DEPTOR" />
          <attvalue for="5" value="TORC2; mTOR complex 2" />
