      <edge source="PRR5L" target="RICTOR" id="950">
        <attvalues>
          <attvalue for="6" value="PRR5L" />
          <attvalue for="7" value="RICTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Protor-2 (PRR5L), the paralogue of Protor-1, binds Rictor and thereby associates with mTORC2 without being required for complex integrity or kinase activity; a binding site shared with Protor-1 and strictly exclusive binding of the two paralogues have not been mapped." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="455; 601" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:b81a9f3cc9ee197f" />
        </attvalues>
      </edge>
      <edge source="PRR5L" target="PRKCD" id="951">
        <attvalues>
          <attvalue for="6" value="PRR5L" />
          <attvalue for="7" value="PRKCD" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Protor-2 acts within mTORC2 to restrain phosphorylation of PKC-delta by the complex; its degradation downstream of G-alpha-12 permits PKC-delta phosphorylation and promotes cell migration, with no evidence of direct binding to the kinase." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="182" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:173c43793903487c" />
        </attvalues>
      </edge>
      <edge source="RAIP_MOTIF" target="EIF4EBP1" id="952">
        <attvalues>
          <attvalue for="6" value="RAIP_MOTIF" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="4E-BP1 contains an N-terminal RAIP motif (Arg-Ala-Ile-Pro) that, together with the C-terminal TOS motif, is required for efficient mTORC1-dependent multisite phosphorylation; NMR places its contact on Raptor at a site separate from the TOS pocket." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="70; 109; 599" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Whether the RAIP motif contacts Raptor directly is disputed: Beugnet et al. 2003 (J Biol Chem 278:40717-40722) found that the RAIP-containing N-terminal fragment of 4E-BP1 does not bind Raptor." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:02ea409619ea73a7" />
        </attvalues>
      </edge>
      <edge source="RAIP_MOTIF" target="RPTOR" id="953">
        <attvalues>
          <attvalue for="6" value="RAIP_MOTIF" />
          <attvalue for="7" value="RPTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="NMR shows that the N-terminal RAIP motif of 4E-BP1 binds Raptor at a site separate from the TOS-binding pocket, so that the two motifs tether 4E-BP1 by avidity and orient its phosphoacceptor region toward the kinase site; mutation of either motif abolishes Raptor co-immunoprecipitation of 4E-BP1." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="70; 109" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Beugnet et al. 2003 (J Biol Chem 278:40717-40722) found no Raptor binding by the RAIP-containing N-terminal fragment and concluded that RAIP promotes phosphorylation independently of Raptor binding; a direct RAIP-mTOR contact has not been demonstrated." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:dc84e9c6f1b8a21d" />
        </attvalues>
      </edge>
      <edge source="RBD_DOMAIN" target="MAPKAP1" id="954">
        <attvalues>
          <attvalue for="6" value="RBD_DOMAIN" />
          <attvalue for="7" value="MAPKAP1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="mSin1 contains a Raf-like, atypical Ras-binding domain between its CRIM and PH domains that binds GTP-loaded H-Ras and K-Ras." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="91; 537" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:d36a2d70a2533f09" />
        </attvalues>
      </edge>
      <edge source="RICTOR" target="AKT" id="955">
        <attvalues>
          <attvalue for="6" value="RICTOR" />
          <attvalue for="7" value="AKT" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="The Akt kinase C-lobe engages an N-terminal mooring formed jointly by mSin1 and Rictor, completing the distal docking surface that selects the substrate." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="597" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="Supported by a single structural study using semisynthetic trapping probes [597]; not yet independently reproduced." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:f3f2f439e2a299a9" />
