          <attvalue for="7" value="DISEASE_NODAT" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Calcineurin inhibitors block calcineurin-NFAT signalling in the pancreatic beta cell, reducing insulin secretion and beta-cell mass and producing new-onset diabetes after transplantation, with tacrolimus carrying the higher risk of the two agents. This mechanism is distinct from the direct beta-cell toxicity and mTORC2-dependent peripheral insulin resistance associated with sirolimus." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="563" />
          <attvalue for="14" value="transplant immunosuppression exposures" />
