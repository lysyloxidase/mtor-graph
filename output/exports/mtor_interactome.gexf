      <edge source="AMPK" target="TP53" id="613">
        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="TP53" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Glucose deprivation-activated AMPK phosphorylates p53 Ser15, initiating a p53-dependent metabolic checkpoint (cell-cycle arrest) and transcription of sestrins, REDD1, PTEN and TSC2 that feed back on mTORC1." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser15" />
          <attvalue for="13" value="282" />
          <attvalue for="14" value="glucose deprivation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
