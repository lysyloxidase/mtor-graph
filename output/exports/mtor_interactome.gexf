      <edge source="TOS_MOTIF" target="HIF1A" id="976">
        <attvalues>
          <attvalue for="6" value="TOS_MOTIF" />
          <attvalue for="7" value="HIF1A" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="HIF-1alpha is reported to carry an N-terminal TOS motif (Phe99) through which it binds Raptor. Mutating this motif impairs hypoxic HIF activity and p300/CBP binding." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="328; 437; 532" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="The HIF-1alpha TOS motif has been studied by one research group only, and mTORC1 also raises HIF-1alpha through 4E-BP1- and S6K1-dependent translation." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:ea0f15bc6ef45a0a" />
        </attvalues>
