      <edge source="MTORC2" target="MYELINATION" id="895">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="MYELINATION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Oligodendrocyte-lineage Rictor deletion has modest and largely transient effects on myelination, whereas Raptor loss causes persistent hypomyelination; only the raptor/rictor double mutant impairs oligodendrocyte differentiation itself, indicating that mTORC2 contributes but is not rate-limiting while mTORC1 remains intact." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="39; 332" />
          <attvalue for="14" value="rodent; regional - spinal cord affected more than corpus callosum" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Effect is 'modulates', not 'required_for': the cited work shows mTORC2 is explicitly NOT rate-limiting. Encoding this as a requirement would misrepresent the source." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="physiological_output:8307fed79a2a1495" />
        </attvalues>
      </edge>
