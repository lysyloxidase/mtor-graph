      <edge source="AMPK" target="TSC2" id="614">
        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="TSC2" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Under energy stress AMPK phosphorylates TSC2 at Thr1271 and Ser1387, enhancing its GAP activity toward Rheb and lowering Rheb-GTP; this is required for energy-stress inhibition of mTORC1 and protects cells from apoptosis during energy deprivation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser1387; Thr1271" />
          <attvalue for="13" value="187; 207; 216; 226; 262" />
          <attvalue for="14" value="energy stress / glucose deprivation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Standard human TSC2 numbering (1807 residues); Inoki et al. 2003 [262] reported these residues as Thr1227 and Ser1345. AMPK phosphorylation at Ser1387 primes GSK3 phosphorylation at Ser1383 and Ser1379 (Ser1341 and Ser1337 in the Inoki numbering)." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="phosphorylation:1a24c98098a1dca6" />
        </attvalues>
      </edge>
      <edge source="AMPK" target="ULK1" id="615">
        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="ULK1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="AMPK associates with ULK1 in a nutrient-dependent manner; the association is required for AMPK-mediated activating phosphorylation of ULK1 and is disrupted when mTORC1 phosphorylates ULK1 at Ser757 (mouse numbering; Ser758 in human ULK1)." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="157; 309" />
          <attvalue for="14" value="energy stress / autophagy initiation" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Phosphorylation at Ser757 acts by disrupting the ULK1-AMPK interaction." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:1d7c9b1d8b1d2ef0" />
        </attvalues>
      </edge>
      <edge source="AMPK" target="ULK1" id="616">
        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="ULK1" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Under glucose starvation AMPK binds and phosphorylates ULK1 at multiple sites, activating it to initiate autophagy/mitophagy; this is prevented when mTORC1 phosphorylates ULK1 Ser757." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser317; Ser555; Ser777" />
          <attvalue for="13" value="157; 309" />
          <attvalue for="14" value="glucose starvation" />
