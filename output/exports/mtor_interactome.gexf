          <attvalue for="7" value="SESN2" />
          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="p53 induces SESN2 (Hi95) after genotoxic stress; Sestrin2 then inhibits mTORC1, principally by sequestering GATOR2, linking DNA damage to growth arrest." />
