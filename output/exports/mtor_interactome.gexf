          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The LKB1-STRADalpha-MO25 heterotrimer is the physiological AMPK kinase; STRADalpha and MO25 are required for LKB1 catalytic competence and cytoplasmic localisation." />
          <attvalue for="17" value="energy_stress_input" />
