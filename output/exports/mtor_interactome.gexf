      <edge source="EIF4EBP1" target="TFAM" id="1000">
        <attvalues>
          <attvalue for="6" value="EIF4EBP1" />
          <attvalue for="7" value="TFAM" />
          <attvalue for="8" value="translational_regulation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="4E-BP restrains translation of nuclear-encoded mitochondrial mRNAs including TFAM and respiratory chain components; mTORC1-dependent 4E-BP phosphorylation relieves this." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="420; 421" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="The primary evidence is translational profiling showing that mTOR inhibition lowers synthesis of TFAM and other nucleus-encoded mitochondrial proteins in wild-type cells but not in cells lacking 4E-BP1 and 4E-BP2." />
          <attvalue for="17" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="translational_regulation:c41de83edb914ed8" />
        </attvalues>
      </edge>
      <edge source="EIF4EBP1" target="VEGFA" id="1001">
        <attvalues>
          <attvalue for="6" value="EIF4EBP1" />
          <attvalue for="7" value="VEGFA" />
          <attvalue for="8" value="translational_regulation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Hypophosphorylated 4E-BP1 sequesters eIF4E and suppresses translation of VEGFA mRNA, which has a long structured 5′ untranslated region; mTORC1 phosphorylation of 4E-BP1 relieves this, adding a translational arm to HIF-1alpha-dependent VEGFA transcription." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="44; 145; 457; 572" />
          <attvalue for="14" value="" />
