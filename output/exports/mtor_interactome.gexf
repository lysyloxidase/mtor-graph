      <edge source="EIF4EBP2" target="EIF4E" id="1004">
        <attvalues>
          <attvalue for="6" value="EIF4EBP2" />
          <attvalue for="7" value="EIF4E" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="4E-BP2, the predominant brain 4E-BP, restrains eIF4F formation; its loss enhances LTP, impairs memory and produces autism-like behaviour via excess eIF4E-dependent translation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="26; 195" />
          <attvalue for="14" value="hippocampal neurons" />
