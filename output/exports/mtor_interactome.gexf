      </edge>
      <edge source="ETV7" target="MTOR" id="703">
        <attvalues>
          <attvalue for="6" value="ETV7" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="ETV7 is reported to interact with mTOR in the cytoplasm and to assemble a putative third complex, mTORC3, that lacks core mTORC1 and mTORC2 subunits and keeps mTOR activity in the presence of rapamycin. Tumour cells that lose this complex become rapamycin-sensitive." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="225" />
          <attvalue for="14" value="ETV7-expressing tumour cells" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="Reported by a single laboratory and not widely replicated; mTORC3 remains an emerging concept." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:53a511b3f5b8c81a" />
        </attvalues>
      </edge>
      <edge source="ETV7" target="MTORC3" id="704">
        <attvalues>
          <attvalue for="6" value="ETV7" />
          <attvalue for="7" value="MTORC3" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="The ETS repressor ETV7 is reported to nucleate the putative third complex and to confer rapamycin insensitivity on it." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="225" />
          <attvalue for="14" value="cancer cell lines" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="Not independently replicated." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="complex_formation:a2fb973a850922c4" />
        </attvalues>
      </edge>
      <edge source="ETV7" target="MTORC3" id="705">
        <attvalues>
          <attvalue for="6" value="ETV7" />
          <attvalue for="7" value="MTORC3" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="ETV7 is reported as the defining subunit of a putative third mTOR assembly, designated mTORC3, which is rapamycin-insensitive and supports proliferation in cancer cells." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="225" />
          <attvalue for="14" value="cancer cell lines" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="A contested claim: single-laboratory description, not widely replicated, and the supporting evidence is weak." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="complex_formation:e0824cdae5df34a3" />
        </attvalues>
      </edge>
      <edge source="FATC_DOMAIN" target="KINASE_DOMAIN" id="706">
        <attvalues>
          <attvalue for="6" value="FATC_DOMAIN" />
          <attvalue for="7" value="KINASE_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="The C-terminal FATC motif is integral to the kinase domain and packs against the activation loop and the mLST8-binding element. Deleting the conserved C-terminal residues, or substituting a conserved tryptophan within them, nearly abolishes mTOR kinase activity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="315; 588; 590; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:3d9bfbef0acdf4ad" />
        </attvalues>
      </edge>
      <edge source="FATC_DOMAIN" target="MTOR" id="707">
        <attvalues>
          <attvalue for="6" value="FATC_DOMAIN" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Extreme C-terminal FATC domain, the last structural element of mTOR, packing against the catalytic core." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="315; 588; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
