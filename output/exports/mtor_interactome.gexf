      <edge source="RMC5552" target="MTORC1" id="311">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="RMC-5552 was designed for mTORC1 selectivity with complete pathway suppression, exploiting FKBP12-mediated avidity for the complex whose FRB is exposed." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="69; 339" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:fa154de53efa3315" />
        </attvalues>
