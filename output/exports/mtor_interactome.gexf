          <attvalue for="12" value="" />
          <attvalue for="13" value="64; 65" />
          <attvalue for="14" value="DNA damage" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Induction by DNA damage is p53-dependent, whereas induction by prolonged hypoxia or oxidative stress is largely p53-independent." />
