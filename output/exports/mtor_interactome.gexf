          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Light-induced phase shifting and re-entrainment of behavioural rhythms; an mTOR-modulated output [79,484]." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="light entrainment; phase shifting" />
        </attvalues>
      </node>
      <node id="PHENO_PREMATURE_AGEING" label="Premature ageing phenotype">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Accelerated age-related pathology (cataracts, organ atrophy, shortened lifespan) seen in Bmal1-null mice and attributed in part to unrestrained mTORC1 signalling." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="accelerated ageing" />
        </attvalues>
      </node>
      <node id="PHENO_SLEEP_WAKE_DISTURBANCE" label="Sleep–wake disturbance">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Disturbed sleep timing, maintenance and quality; a recognised feature of Smith–Kingsmore syndrome and a proposed monitoring endpoint for mTOR-directed therapy." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="delayed sleep-wake phase disorder; sleep disturbance" />
        </attvalues>
      </node>
      <node id="SCN" label="Suprachiasmatic nucleus">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Hypothalamic master pacemaker; receives retinal photic input, synchronises peripheral clocks, and depends on VIP signalling for network synchrony. mTOR signalling here modulates photic entrainment and central clock function." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="SCN; master clock" />
        </attvalues>
      </node>
      <node id="DISEASE_AD" label="Alzheimer's disease">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Target of the autophagy-based mTOR-inhibition rationale; supported by 3xTg-AD mouse data but with no controlled human efficacy data - the ERAP phase IIa study of weekly oral rapamycin uses FDG-PET cerebral glucose metabolism as its primary outcome." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="AD" />
        </attvalues>
      </node>
      <node id="DISEASE_ANGIOMYOLIPOMA" label="Renal angiomyolipoma">
