          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Metformin inhibits mTORC1 independently of AMPK and TSC2 in a Rag GTPase-dependent manner; constitutively active Rag mutants blunt the effect, suggesting interference with Rag-mediated lysosomal recruitment." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="295" />
          <attvalue for="14" value="AMPK-null or TSC2-null cells" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="the Rag step is inferred from constitutively active Rag mutants rather than demonstrated directly." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:0965b8c9a0a344de" />
        </attvalues>
      </edge>
      <edge source="METFORMIN" target="MTORC1" id="211">
        <attvalues>
          <attvalue for="6" value="METFORMIN" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Metformin lowers mTORC1 activity indirectly and does not bind mTOR. One route is AMPK-dependent, through phosphorylation of Raptor at Ser792 and enhancement of TSC2 GAP activity; a second is AMPK-independent, requires the Rag GTPases and was demonstrated in cells lacking AMPK or TSC2. Because of the second route, suppression of mTORC1 cannot be inferred from AMPK activation alone." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="172; 243; 295" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The AMPK-independent, Rag-dependent route is dose-dependent and rests on a smaller body of work than the AMPK-dependent route." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:96334e3a9c66cf00" />
        </attvalues>
      </edge>
