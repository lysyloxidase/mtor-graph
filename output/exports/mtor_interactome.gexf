          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Scaffolding beta subunit (beta1 or beta2) bridging alpha and gamma; its C-terminus binds both, its CBM binds glycogen and contributes to the ADaM drug site." />
