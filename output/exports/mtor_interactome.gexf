          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Hormone receptor-positive, HER2-negative advanced breast cancer progressing on an aromatase inhibitor; the single disease in which the mTOR, PI3K and AKT nodes have been tested in separate randomised trials." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="breast cancer" />
        </attvalues>
      </node>
      <node id="DISEASE_CANCER" label="Cancer (advanced solid tumours)">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Mixed population of advanced solid tumours, 58% carrying pathogenic mTOR-pathway variants, enrolled in the first-in-human bi-steric inhibitor study." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="solid tumour" />
