      <edge source="MTORC1" target="PHENO_MUSCLE_HYPERTROPHY" id="844">
        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="PHENO_MUSCLE_HYPERTROPHY" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="mTORC1 activity is required for load-induced hypertrophy: rapamycin blocks the hypertrophic response to IGF-1, mechanical overload and chronic stimulation. Sustained mTORC1 activation is not by itself sufficient, since constitutive activation by Tsc1 deletion in muscle fails to produce hypertrophy and instead causes a late-onset myopathy with blocked autophagy." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="50" />
          <attvalue for="14" value="skeletal muscle" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:5c59ed4b6113f728" />
