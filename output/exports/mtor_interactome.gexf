        </attvalues>
      </edge>
      <edge source="EVEROLIMUS" target="DISEASE_TSC" id="186">
        <attvalues>
          <attvalue for="6" value="EVEROLIMUS" />
          <attvalue for="7" value="DISEASE_TSC" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In TSC, biallelic loss of a direct mTORC1 restraint makes the lesion fully mTORC1-dependent: roughly 35% achieved SEGA volume reduction, 42% angiomyolipoma reduction and 30-40% seizure reduction." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="47; 175; 176; 319" />
          <attvalue for="14" value="EXIST-1, EXIST-2 and EXIST-3" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="The case in which the rapalog mechanistic rationale is fully borne out, and the standard against which other indications should be judged." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:4ef6be856ea57440" />
