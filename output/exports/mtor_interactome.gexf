          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="CASTOR2 binds GATOR2 as part of the CASTOR1-CASTOR2 heterodimer, contributing to arginine-regulated control of the hub" />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
