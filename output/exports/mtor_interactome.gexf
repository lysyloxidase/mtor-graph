          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="5" />
          <attvalue for="3" value="F-box substrate-recognition subunit of the SCF E3 ubiquitin ligase; binds phosphodegron-bearing DEPTOR and directs its polyubiquitination and proteasomal destruction." />
          <attvalue for="4" value="BTRC" />
          <attvalue for="5" value="BTRCP; FBXW1; FBXW1A; SCF-betaTrCP; beta-TrCP" />
