        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Cullin-RING ligase (SKP1-CUL1-RBX1 with the F-box receptor beta-TrCP1/2) that recognises the phosphodegron of DEPTOR and targets it for proteasomal destruction, creating a positive-feedback loop on mTOR activity." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="SCF-betaTrCP; SKP1-CUL1-F-box" />
        </attvalues>
