          <attvalue for="7" value="AKT" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="An acidic loop of the mSin1 CRIM domain engages the basic AKT N-lobe surface ~75 Å from the catalytic site, encoding substrate choice by distal docking rather than local sequence." />
