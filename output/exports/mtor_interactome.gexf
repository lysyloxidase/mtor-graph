          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="ETS-family transcription factor reported as the defining subunit of a putative third, rapamycin-insensitive mTOR assembly (mTORC3) in cancer cells. Described by a single laboratory and not widely replicated, so the evidence remains weak." />
          <attvalue for="4" value="ETV7" />
          <attvalue for="5" value="TEL2; TEL2 (ETS family); TELB" />
        </attvalues>
      </node>
      <node id="FATC_DOMAIN" label="mTOR FATC domain">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Extreme C-terminal FATC domain; packs against the kinase domain and is indispensable for catalytic activity - deletion of even a single residue abolishes mTOR kinase function." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="FATC" />
        </attvalues>
      </node>
      <node id="FAT_DOMAIN" label="mTOR FAT domain">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="FRAP-ATM-TRRAP domain, the alpha-helical clamp that wraps the kinase domain and holds it in a partially inactive conformation; the FAT-kinase interface is the target of activating cancer mutations and of Rheb-induced conformational change." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="FAT" />
        </attvalues>
      </node>
      <node id="FRB_DOMAIN" label="FRB domain of mTOR">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="~100-residue four-helix bundle between the FAT and kinase domains of mTOR forming the binding site for the FKBP12-rapamycin binary complex; solvent-exposed in mTORC1 and occluded by Rictor-mSin1 in mTORC2." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="FKBP12-rapamycin binding domain" />
        </attvalues>
      </node>
      <node id="HEAT_REPEATS" label="mTOR N-HEAT/M-HEAT solenoid">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="N-terminal alpha-solenoid of mTOR (horn and bridge), ~20 HEAT repeats; forms the mTORC1/mTORC2 dimer interface, the Raptor- and Rictor-binding surface and, together with the FAT domain, the Rheb-binding site." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="HEAT repeats; M-HEAT; N-HEAT; horn and bridge" />
        </attvalues>
      </node>
