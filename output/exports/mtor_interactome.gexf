          <attvalue for="7" value="DISEASE_UROTHELIAL_CARCINOMA" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Exceptional-responder literature: a durable complete remission in metastatic urothelial carcinoma with a loss-of-function TSC1 mutation alongside an NF2 nonsense mutation, with TSC1 mutations subsequently found in about 8% of 109 further bladder cancers and correlated with everolimus sensitivity; a second complete responder carried two activating MTOR mutations. A prospective basket study selected for proximal-brake lesions was nonetheless negative." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="138; 267; 632" />
          <attvalue for="14" value="case-level responses; prospective biomarker selection not validated" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Genotype-directed rapalog therapy outside TSC remains preliminary, and as a basis for routine biomarker selection it is contested." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="drug_inhibition:02f94d44eb1b50d7" />
        </attvalues>
      </edge>
      <edge source="EVEROLIMUS" target="EIF4EBP1" id="194">
        <attvalues>
          <attvalue for="6" value="EVEROLIMUS" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Everolimus lowers mTORC1-dependent phosphorylation of 4E-BP1 and so favours sequestration of eIF4E, but suppression is site-selective: Ser65 and Thr70, which require prior priming and sustained mTORC1 activity, are suppressed, whereas the priming sites Thr37 and Thr46 remain largely phosphorylated. Cap-dependent translation of messages with structured 5' untranslated regions is therefore only partly inhibited." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser65; Thr70" />
          <attvalue for="13" value="37; 40; 70" />
          <attvalue for="14" value="partial suppression only; Thr37/Thr46 resistant" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Indirect activation of the translational repressor through reduced mTORC1-dependent phosphorylation; the drug does not directly activate 4E-BP1." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:e8f7300b82307b7e" />
        </attvalues>
      </edge>
