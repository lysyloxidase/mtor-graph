      <node id="DEPTOR" label="DEPTOR">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Tandem DEP-domain plus PDZ-domain inhibitory subunit of both mTORC1 and mTORC2; binds the mTOR FAT region. Phosphorylated by active mTOR and by S6K1/RSK/CK1alpha, then degraded via SCF-betaTrCP, so active mTOR removes its own brake." />
          <attvalue for="4" value="DEPTOR" />
          <attvalue for="5" value="DEPDC6" />
        </attvalues>
