          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In the assembled mTORC2 cryo-EM structures Rictor packs against the FRB bundle, sterically denying access to the FKBP12-rapamycin complex." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="102; 531" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sequestration:62ad8de5c615cd2d" />
