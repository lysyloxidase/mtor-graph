          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Rheb-mTORC1 is required for Th1 and Th17 differentiation; T cell-specific mTOR deletion abrogates Th1, Th2 and Th17 differentiation altogether." />
