        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="DISEASE_ALLOGRAFT_REJECTION" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Suppression of mTORC1-dependent effector lymphocyte expansion prevents renal allograft rejection; this was the first approved indication and is given at continuous, trough-monitored exposures." />
