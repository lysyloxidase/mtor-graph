          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Oligodendrocyte-lineage Raptor loss delays myelination onset and produces persistent hypomyelination with reduced sheath thickness, regionally worse in spinal cord." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="39; 332" />
          <attvalue for="14" value="oligodendrocyte lineage (rodent)" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Established in rodents; effect of chronic low-dose inhibition on adult human white matter unresolved." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:a4da477b702c13c8" />
