      <edge source="RAPAMYCIN" target="RPS6KB1" id="235">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="RPS6KB1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="FKBP12-rapamycin bound to the mTORC1 FRB domain abolishes S6K1 Thr389 phosphorylation completely, in contrast to its partial effect on 4E-BP1. This makes Thr389 the pharmacodynamic marker of mTORC1 engagement and the readout against which partial pathway inhibition is judged in dosing studies." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Thr389" />
          <attvalue for="13" value="111; 166; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:964e8ad5afbc9028" />
