          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Germline (Peutz-Jeghers syndrome) or somatic (lung adenocarcinoma, cervical cancer) STK11 inactivation; removes AMPK Thr172 phosphorylation under energy stress and deregulates mTORC1." />
          <attvalue for="4" value="STK11" />
          <attvalue for="5" value="LKB1 loss; Peutz-Jeghers" />
        </attvalues>
      </node>
