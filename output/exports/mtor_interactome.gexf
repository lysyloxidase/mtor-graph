          <attvalue for="1" value="circadian" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Recognised feature of Smith–Kingsmore syndrome in the same cohort [361], reported alongside sleep–wake disturbance." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_HYPERPHAGIA" label="Hyperphagia">
