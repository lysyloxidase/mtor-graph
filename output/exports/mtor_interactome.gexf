          <attvalue for="7" value="PHENO_HYPOTENSION" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Renal mTORC2 loss causes salt wasting and hypotension through failure of SGK1-dependent activation of ENaC, the Na+/K+-ATPase and CLC-K in the distal nephron." />
