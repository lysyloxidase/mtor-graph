          <attvalue for="0" value="disease" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Progressive cystic lung disease driven by TSC2-deficient smooth-muscle-like cells, sporadic or TSC-associated; an approved sirolimus indication." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="LAM" />
