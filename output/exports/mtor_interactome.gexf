        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="PHENO_AGE_MEMORY_IMPAIRMENT" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="A small molecule that raises mTORC2 activity reverses age-associated long-term memory impairment in aged mice and flies, and enhancing mTORC2-dependent actin polymerisation likewise improves long-term memory." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="280" />
          <attvalue for="14" value="mouse and Drosophila" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Pharmacological gain-of-function evidence from a single report in mice and flies, with no independent replication and no human data." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="physiological_output:ccada256d0371f8a" />
        </attvalues>
      </edge>
