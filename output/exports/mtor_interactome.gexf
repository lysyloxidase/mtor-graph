          <attvalue for="2" value="4" />
          <attvalue for="3" value="Nucleotide-binding cleft of the bilobed mTOR kinase domain" />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="kinase cleft; mTOR active site" />
