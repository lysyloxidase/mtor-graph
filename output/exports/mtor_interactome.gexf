          <attvalue for="7" value="PPP3" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The FKBP12-FK506 complex binds and inhibits the calcineurin phosphatase, blocking NFAT dephosphorylation and IL-2 transcription; this is a distinct mechanism from mTOR inhibition." />
