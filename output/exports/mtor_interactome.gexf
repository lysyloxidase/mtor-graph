          <attvalue for="3" value="Rag GTPase that, loaded with GTP, confers Raptor binding on the heterodimer. Target of GATOR1 GAP activity and of Ragulator/SLC38A9 GEF activity." />
          <attvalue for="4" value="RRAGA" />
          <attvalue for="5" value="Gtr1 homologue" />
        </attvalues>
      </node>
      <node id="RRAGB" label="RagB">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Paralogue of RagA with equivalent function; GTP-loaded RagB binds Raptor and is the substrate of GATOR1 GAP activity." />
          <attvalue for="4" value="RRAGB" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="RRAGC" label="RagC">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Rag GTPase that must be GDP-loaded for the active heterodimer configuration; substrate of the FLCN-FNIP GAP and determinant of substrate-specific mTORC1 signalling to TFEB." />
          <attvalue for="4" value="RRAGC" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="RRAGD" label="RagD">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Paralogue of RagC; GDP-loaded RagD supports the active heterodimer. Proposed substrate of LARS1 GAP activity in the contested leucine-sensing model." />
          <attvalue for="4" value="RRAGD" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="FKBP8" label="FKBP38 (FKBP8)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="growth_factor_input" />
          <attvalue for="2" value="3" />
