      <edge source="MTORC2" target="PHENO_LONG_TERM_MEMORY" id="904">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="PHENO_LONG_TERM_MEMORY" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Conditional Rictor deletion in the postnatal murine forebrain selectively impairs long-term memory while sparing short-term memory; conversely, a compound that raises mTORC2 activity converts early-phase into late-phase potentiation, enhances long-term memory in wild-type animals and reverses age-associated memory impairment in mice and flies." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="250; 280" />
          <attvalue for="14" value="rodent and Drosophila" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="The requirement is bidirectional and pharmacologically accessible, which is what underlies concern about cognitive effects of inhibitors that reach mTORC2." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:478b817c944741eb" />
        </attvalues>
      </edge>
