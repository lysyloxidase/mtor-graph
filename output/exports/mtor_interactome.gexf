          <attvalue for="7" value="TSC2" />
          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="p53 transcriptionally induces TSC2 in a stress-, cell-type- and tissue-specific manner, raising Rheb-GAP capacity and reinforcing mTORC1 suppression after genotoxic stress." />
