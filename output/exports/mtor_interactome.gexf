          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Adaptor linking CUL1 to the F-box protein beta-TrCP in the SCF ligase acting on DEPTOR." />
          <attvalue for="4" value="SKP1" />
          <attvalue for="5" value="S-phase kinase-associated protein 1" />
        </attvalues>
      </node>
      <node id="MAM_ER_MITOCHONDRIA" label="Mitochondria-associated ER membranes">
