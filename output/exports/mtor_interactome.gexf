          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Under low energy, AMP-bound AMPK, AXIN and LKB1 assemble into a complex in which AXIN tethers LKB1 to AMPK, enhancing Thr172 phosphorylation; AXIN knockdown in mouse liver impairs AMPK activation after starvation." />
