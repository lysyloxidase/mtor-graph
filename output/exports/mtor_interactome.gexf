          <attvalue for="7" value="STK11" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="ATM phosphorylates LKB1 at Thr366 (Thr363 in mouse) in response to ionising radiation and oxidative stress; the modification does not change LKB1 catalytic activity in vitro, but a non-phosphorylatable LKB1 mutant failed to restore ROS-induced mTORC1 repression in LKB1-deficient cells." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="Thr366" />
          <attvalue for="13" value="5; 524" />
          <attvalue for="14" value="DNA damage; oxidative stress" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Two laboratories have reported ATM phosphorylation of Thr366, but its requirement for mTORC1 repression rests on a single study." />
