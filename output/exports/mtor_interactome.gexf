      <edge source="VAR_NPRL2_LOF" target="DISEASE_GATOR1_EPILEPSY" id="27">
        <attvalues>
          <attvalue for="6" value="VAR_NPRL2_LOF" />
          <attvalue for="7" value="DISEASE_GATOR1_EPILEPSY" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="NPRL2 loss of function causes familial focal epilepsy of the GATOR1 spectrum through unopposed RagA/B-GTP loading and mTORC1 hyperactivity, with a focal cortical malformation in a minority of patients. In a small open-label series of NPRL2- and NPRL3-related epilepsy, add-on everolimus reduced seizures in all four patients treated, two of whom became seizure-free, although stomatitis led one patient to stop treatment." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="22; 84; 494" />
          <attvalue for="14" value="germline heterozygous" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The therapeutic evidence is open-label and very small; a controlled trial is required before mTOR inhibition becomes standard practice in these epilepsies." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="genetic_loss_of_function:d2230e926e7ec3de" />
        </attvalues>
      </edge>
