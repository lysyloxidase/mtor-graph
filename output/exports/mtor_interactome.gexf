      <edge source="RICTOR" target="MTOR" id="960">
        <attvalues>
          <attvalue for="6" value="RICTOR" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Rictor binds the mTOR N-HEAT solenoid and is required for mTORC2 assembly and integrity; with mSin1 it occludes the FRB domain and forms the N-terminal mooring that docks the AKT C-lobe, whereas the mSin1 CRIM domain provides the principal substrate-docking surface." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="102; 525; 531; 597; 670" />
          <attvalue for="14" value="" />
