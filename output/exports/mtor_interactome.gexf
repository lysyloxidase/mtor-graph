          <attvalue for="7" value="PHENO_CYTOPENIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Haematopoietic progenitors require mTORC1 for proliferation, so suppression produces anaemia, thrombocytopenia and neutropenia; dose reduction is the standard response." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="444" />
