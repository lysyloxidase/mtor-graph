      <edge source="RAPAMYCIN" target="MTORC2" id="236">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Prolonged rapamycin exposure inhibits mTORC2 because FKBP12–rapamycin captures newly synthesised mTOR before assembly; mTORC1 selectivity is kinetic, not absolute." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="527" />
          <attvalue for="14" value="chronic or continuous dosing" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:b62e657543074ed2" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="MTORC2" id="237">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Chronic dosing lowers mTORC2 output, including AKT Ser473, in many but not all cell types, by blocking assembly of new complexes; selectivity for mTORC1 is therefore kinetic rather than absolute." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="527" />
          <attvalue for="14" value="chronic dosing; cell-type dependent" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Cell-type variability in mTORC2 sensitivity is itself well replicated." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:aacf8eca6c992930" />
