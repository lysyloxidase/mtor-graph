          <attvalue for="7" value="DISEASE_RCC" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In renal cell carcinoma progressing after VEGFR-directed therapy, everolimus extended median progression-free survival from 1.9 to 4.9 months in the final analysis of RECORD-1, without an overall survival benefit, consistent with a cytostatic effect on HIF-dependent translation and the angiogenic programme rather than on a cell-autonomous mTORC1 dependency." />
