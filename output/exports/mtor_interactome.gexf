          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Contractile activity raises AMP/ADP:ATP and creatine/phosphocreatine turnover in muscle fibres, increasing LKB1-dependent AMPK Thr172 phosphorylation in an intensity-dependent manner." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
