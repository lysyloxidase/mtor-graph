          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Germline activating MTOR substitutions causing Smith–Kingsmore syndrome (E1799K accounts for roughly half of cases); patient variants dampen cellular circadian amplitude as well as driving overgrowth and epilepsy." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="E1799K; MTOR GOF; MTOR gain of function" />
        </attvalues>
      </node>
      <node id="VAR_NPRL3_LOF" label="NPRL3 loss-of-function">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Heterozygous germline loss of a GATOR1 subunit causing familial focal epilepsy; the single reported NPRL3 patient worsened on everolimus." />
          <attvalue for="4" value="NPRL3" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="VAR_STK11_LOF" label="STK11 (LKB1) loss-of-function">
