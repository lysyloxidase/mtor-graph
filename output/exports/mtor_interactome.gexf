      <edge source="PPM1A" target="AMPK" id="627">
        <attvalues>
          <attvalue for="6" value="PPM1A" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="dephosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="PP2C-family phosphatases dephosphorylate AMPK Thr172 and switch the kinase off; AMP, and roughly ten-fold less potently ADP, binds the gamma-subunit CBS sites and protects Thr172 from dephosphorylation. This protection is distinct from the direct allosteric activation of the already phosphorylated kinase and is the main route by which a falling energy charge sustains AMPK activity." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="Thr172" />
          <attvalue for="13" value="130; 200" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Graded emerging because protection from dephosphorylation is established for the PP2C class while the physiological phosphatase isoform (PPM1A, PPM1B, PPM1E or PPM1F) remains unresolved." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="dephosphorylation:635282cf4a4ecf03" />
        </attvalues>
      </edge>
