        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="WD40 beta-propeller shared by both complexes; contacts the mTOR kinase domain near the activation loop and stabilises the catalytic conformation." />
          <attvalue for="4" value="MLST8" />
          <attvalue for="5" value="GBL; GbetaL; LST8" />
        </attvalues>
      </node>
      <node id="MTOR" label="mTOR">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="2549-residue ~289 kDa PIKK-family Ser/Thr kinase (1p36.22). N-HEAT/M-HEAT solenoid, FAT domain, FRB, bilobed kinase domain, C-terminal FATC required for catalysis; deep substrate cleft partially occluded by an inhibitory element." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="FRAP1; RAFT1; RAPT1; mechanistic target of rapamycin" />
        </attvalues>
      </node>
      <node id="MTORC1" label="mTORC1">
        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Rapamycin-sensitive mTOR complex 1 (mTOR, Raptor, mLST8, PRAS40, DEPTOR); the convergence point of energy, oxygen and stress inputs via TSC-Rheb, Raptor phosphorylation and Rag GTPases; phosphorylates ULK1 Ser757 and AMPK alpha2 Ser345." />
          <attvalue for="4" value="MTOR/RPTOR/MLST8" />
          <attvalue for="5" value="mTOR complex 1; mammalian target of rapamycin complex 1" />
        </attvalues>
      </node>
