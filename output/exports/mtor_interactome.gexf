      <edge source="TOS_MOTIF" target="RPTOR" id="978">
        <attvalues>
          <attvalue for="6" value="TOS_MOTIF" />
          <attvalue for="7" value="RPTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Raptor recognises the five-residue TOS motif of its clients; point mutation of the motif's phenylalanine abolishes binding to Raptor and mTORC1-dependent phosphorylation, which is the molecular basis of substrate selection by mTORC1." />
          <attvalue for="11" value="established" />
