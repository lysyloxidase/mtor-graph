      <edge source="VAR_STK11_LOF" target="MTORC1" id="131">
        <attvalues>
          <attvalue for="6" value="VAR_STK11_LOF" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Loss-of-function STK11/LKB1 lesions abolish energy-stress-induced Thr172 phosphorylation of AMPK, removing both the TSC2-GAP and the Raptor Ser792 brakes, so mTORC1 is no longer restrained when ATP falls; Ca2+-driven Thr172 phosphorylation by CaMKK2 is retained, and growth-factor and amino-acid control of mTORC1 persists." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="138; 375; 546; 624" />
          <attvalue for="14" value="STK11-mutant tumours; Peutz-Jeghers syndrome" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="A single-arm trial of everolimus in advanced solid tumours selected for TSC1, TSC2, NF1, NF2 or STK11 mutations showed no meaningful single-agent activity, so such a lesion marks an enriched population rather than demonstrated dependence on the kinase." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:6df23304c94db020" />
        </attvalues>
      </edge>
