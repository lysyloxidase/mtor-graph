      <edge source="RAPAMYCIN" target="PHENO_AMYLOID_BETA" id="292">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_AMYLOID_BETA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rapamycin reduces brain amyloid-beta and improves cognition in 3xTg-AD mice, with benefit dependent on intact autophagy and largely confined to treatment initiated before substantial pathology accumulates." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="71; 381; 573" />
          <attvalue for="14" value="3xTg-AD mice; benefit requires intact autophagy and early initiation; no controlled human efficacy data" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="No controlled human efficacy data exist." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
