      <edge source="RPS6KB1" target="UBTF" id="1037">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="UBTF" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="S6K1 activity is required for mTOR-dependent phosphorylation of the UBF carboxy-terminal activation domain, which enhances UBF binding to SL1 and Pol I transcription of rDNA. Rapamycin causes rapid dephosphorylation of this domain, and a constitutively active, rapamycin-resistant S6K1 reverses it. Direct phosphorylation of UBF by S6K1 has not been shown, so the relationship is S6K1-dependent rather than a proven kinase-substrate interaction." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="214" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Rapamycin-sensitive; whether S6K1 phosphorylates UBF directly or via an intermediate kinase is not fully resolved." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:450dfb4b54972cef" />
        </attvalues>
      </edge>
