      <edge source="RICTOR" target="FRB_DOMAIN" id="959">
        <attvalues>
          <attvalue for="6" value="RICTOR" />
          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Cryo-EM shows Rictor, together with mSin1, covering the FRB surface of mTOR within mTORC2, which is the structural basis for the rapamycin insensitivity of preassembled mTORC2." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="102; 531" />
          <attvalue for="14" value="assembled mTORC2" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="mSin1 (MAPKAP1) contributes to the same occlusion" />
