      <edge source="PH_DOMAIN" target="KINASE_DOMAIN" id="941">
        <attvalues>
          <attvalue for="6" value="PH_DOMAIN" />
          <attvalue for="7" value="KINASE_DOMAIN" />
          <attvalue for="8" value="autoinhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In the basal state the mSin1 PH domain folds back onto the mTOR kinase domain and suppresses catalysis; this is the autoinhibited resting conformation of mTORC2." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="360" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="The mSin1 PH domain is not resolved in published mTORC2 cryo-EM maps, so the autoinhibited conformation rests on biochemical and mutational evidence [360]." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="autoinhibition:f38ed5c4b5655222" />
