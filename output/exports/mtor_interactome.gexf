      <edge source="EIF4EBP1" target="MYC" id="999">
        <attvalues>
          <attvalue for="6" value="EIF4EBP1" />
          <attvalue for="7" value="MYC" />
          <attvalue for="8" value="translational_regulation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Hypophosphorylated 4E-BP1 binds eIF4E and restrains cap-dependent translation of MYC mRNA, whose structured 5′ untranslated region makes it highly dependent on eIF4F; mTORC1 phosphorylation of 4E-BP1 releases eIF4E and raises c-Myc protein." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="44; 457; 572" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc1_output_autophagy_metabolism_feedback" />
