          <attvalue for="7" value="RIBOSOME_BIOGENESIS" />
          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="S6K activity controls a ribosome-biogenesis transcriptional programme (rRNA processing factors, Pol I/III cofactors) in addition to rDNA transcription." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="97; 255; 458" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="The mammalian evidence comes mainly from liver and cells lacking both S6K1 and S6K2, in which the feeding-induced ribosome-biogenesis transcriptional programme fails. The requirement for S6K1 in UBF-dependent rDNA transcription is a separate and better-supported arm." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="transcriptional_regulation:886092f64a80ce81" />
        </attvalues>
