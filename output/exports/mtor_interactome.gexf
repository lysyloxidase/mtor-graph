      </node>
      <node id="EVEROLIMUS" label="Everolimus">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="First-generation allosteric rapalog, a 40-O-(2-hydroxyethyl) derivative of sirolimus. Pharmacokinetics (node attributes, not edges): oral bioavailability approximately 30%, half-life near 30 h; CYP3A4 and P-glycoprotein substrate, with brain accumulation restricted by ABCB1. Used at immunosuppressive and oncology exposures and, at much lower exposures (0.5 mg daily or 5 mg weekly), as an immunological geroscience intervention." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Afinitor; RAD001; Zortress" />
        </attvalues>
      </node>
      <node id="KU0063794" label="KU-0063794">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Selective ATP-competitive mTOR tool inhibitor that blocks both complexes without inhibiting related PI3K-family kinases at comparable concentrations." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="KU0063794" />
        </attvalues>
      </node>
      <node id="METFORMIN" label="Metformin">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Biguanide antidiabetic; inhibits mitochondrial complex I (raising AMP/ADP), binds PEN2 to activate lysosomal AMPK at low doses, and also inhibits mTORC1 independently of AMPK via Rag GTPases and p53-REDD1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="NAB_SIROLIMUS" label="nab-Sirolimus">
