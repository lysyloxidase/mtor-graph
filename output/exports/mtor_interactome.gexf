      <edge source="RMC5552" target="MTORC2" id="312">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="mTORC2 is relatively spared because engagement depends on an accessible FRB; the clinical correlate is treatment-related hyperglycaemia in only 4% despite complete mTORC1 blockade." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="69; 339; 535" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Sparing is relative, not absolute, and rests on a single-arm phase 1 dataset." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="drug_inhibition:1a75873679054ab1" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="PHENO_FATIGUE" id="313">
        <attvalues>
