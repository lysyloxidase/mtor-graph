          <attvalue for="7" value="PHENO_GLUCOSE_INTOLERANCE" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Chronic rapamycin exposure disrupts mTORC2 and causes insulin resistance, an effect uncoupled from its longevity benefit." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="325" />
          <attvalue for="14" value="continuous high exposure in rodents" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Whether intermittent dosing, which allows mTORC2 to recover between doses, spares glucose metabolism remains unsettled; the supporting evidence is preliminary [12]." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:d8ac084c97ba1163" />
