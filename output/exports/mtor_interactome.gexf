      <edge source="TOS_MOTIF" target="AKT1S1" id="974">
        <attvalues>
          <attvalue for="6" value="TOS_MOTIF" />
          <attvalue for="7" value="AKT1S1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="PRAS40 carries its own TOS motif (FVMDE, Phe129), which is required for Raptor binding and lets PRAS40 occupy the Raptor substrate-docking site in competition with S6K1 and 4E-BP1. PRAS40 is also itself an mTORC1 substrate at Ser183." />
          <attvalue for="11" value="established" />
