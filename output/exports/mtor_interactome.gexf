          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Caloric restriction lowers hepatic mTORC1 activity at some times of day while having no effect, or the opposite effect, at others, so the measured response depends on when liver is sampled relative to the feeding schedule." />
