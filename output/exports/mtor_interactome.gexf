          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="NPRL3 loss of function causes familial focal epilepsy of the GATOR1 spectrum through unopposed RagA/B-GTP loading and mTORC1 hyperactivity in the cortical lesion. Responses to add-on everolimus have differed between series: the single NPRL3 patient in the first case series worsened, whereas all four patients in a later NPRL2- and NPRL3-related series improved, two of them becoming seizure-free." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="22; 84; 417; 494" />
          <attvalue for="14" value="germline heterozygous" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The small open-label series do not establish NPRL3 genotype as a predictor of everolimus failure, and a controlled trial is required before mTOR inhibition becomes standard practice." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="genetic_loss_of_function:6e44db045cac88a3" />
        </attvalues>
      </edge>
