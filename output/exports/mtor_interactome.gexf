        <attvalues>
          <attvalue for="6" value="RPTOR" />
          <attvalue for="7" value="HIF1A" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="HIF-1alpha carries a TOS motif recognised by the Raptor substrate pocket, the same surface that reads the S6K1, 4E-BP1 and PRAS40 motifs; Raptor binding through this motif is required for mTORC1-dependent HIF-1alpha activity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="328; 437; 532" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="The HIF-1alpha TOS motif and its Raptor binding were characterised by a single laboratory (Land and Tee 2007)." />
          <attvalue for="17" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:9ea1c318d9cb3edc" />
