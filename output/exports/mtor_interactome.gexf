          <attvalue for="7" value="HIF1A" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="HIF-1alpha carries a TOS motif recognised by Raptor, coupling mTORC1 directly to hypoxia-responsive transcription." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="328; 437; 532" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="The HIF-1alpha TOS motif and its Raptor binding were characterised by a single laboratory (Land and Tee 2007)." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:b625893bf8e8752d" />
