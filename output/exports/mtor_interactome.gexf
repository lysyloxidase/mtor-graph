      <edge source="RUVBL1" target="TTT_COMPLEX" id="515">
        <attvalues>
          <attvalue for="6" value="RUVBL1" />
          <attvalue for="7" value="TTT_COMPLEX" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="RUVBL1 (Pontin) binds the Tel2-Tti1-Tti2 module as part of the R2TP co-chaperone, whose PIH1D1 subunit recognises CK2-phosphorylated Tel2. The ATP-dependent TTT-RUVBL1/2 assembly is needed for mTOR stability, mTORC1 dimerisation and mTORC1 binding to the Rag GTPases." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="239; 311" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="RUVBL1 is not a subunit of TTT itself, which comprises Tel2, Tti1 and Tti2; energy depletion disassembles the TTT-RUVBL1/2 complex." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:dab4af04a734c231" />
        </attvalues>
      </edge>
      <edge source="RUVBL1" target="MTORC1" id="516">
