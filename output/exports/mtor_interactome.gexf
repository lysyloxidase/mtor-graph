      </edge>
      <edge source="ATP_SITE" target="MTOR" id="700">
        <attvalues>
          <attvalue for="6" value="ATP_SITE" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="The ATP-binding cleft lies in the bilobed kinase domain of mTOR and is identical in mTORC1 and mTORC2, which is why agents that occupy it inhibit both complexes, unlike allosteric agents acting at the FRB domain." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="315; 588; 670" />
          <attvalue for="14" value="" />
