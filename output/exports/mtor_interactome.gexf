          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Two TSC1 (hamartin) copies form the coiled-coil scaffold of the 2:2:1 arch-shaped TSC1–TSC2–TBC1D7 complex." />
