          <attvalue for="4" value="" />
          <attvalue for="5" value="FK-506; FK506; Prograf" />
        </attvalues>
      </node>
      <node id="TEMSIROLIMUS" label="Temsirolimus">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="First-generation rapalog given intravenously as a prodrug converted to sirolimus. CYP3A4 and P-glycoprotein substrate. Approved for advanced poor-prognosis renal cell carcinoma on the basis of the Global ARCC trial; also used as CCI-779 in preclinical neurodegeneration models." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="CCI-779; Torisel" />
        </attvalues>
