          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="pThr246-PRAS40 binds 14-3-3, which displaces PRAS40 from Raptor/mTORC1 and so derepresses substrate access." />
