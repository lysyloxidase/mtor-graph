          <attvalue for="7" value="RPS6KB1" />
          <attvalue for="8" value="dephosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="PP2A associates with S6K1 and dephosphorylates it when mTORC1 is inhibited by rapamycin; mTORC1 activity restrains PP2A action on S6K1." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="Thr389" />
