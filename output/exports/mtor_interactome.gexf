      <edge source="MTORC1" target="PHENO_HEPATIC_STEATOSIS" id="838">
        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="PHENO_HEPATIC_STEATOSIS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="SREBP1c-dependent lipogenesis driven by hepatic mTORC1 contributes to steatosis when insulin is chronically elevated." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="212; 326; 677" />
          <attvalue for="14" value="liver, hyperinsulinaemia" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Hepatic mTORC1 is required for insulin-induced SREBP1c and lipogenesis, but mTORC1 activation alone is not sufficient: liver Tsc1 deletion lowers Akt signalling and protects against diet-induced steatosis, so intact Akt signalling, which also suppresses Insig2a, is required alongside it." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:6f8b0c803c6a256c" />
