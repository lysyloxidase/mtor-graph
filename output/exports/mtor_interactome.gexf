        <attvalues>
          <attvalue for="0" value="complex" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Putative third mTOR assembly containing ETV7, reported to be rapamycin-insensitive and to drive proliferation in cancer cells. Single-laboratory description, not widely replicated, so the evidence remains weak." />
          <attvalue for="4" value="MTOR, ETV7" />
          <attvalue for="5" value="ETV7-mTOR complex" />
        </attvalues>
      </node>
      <node id="PH_DOMAIN" label="mSin1 PH domain">
