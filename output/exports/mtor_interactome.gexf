      <edge source="RPTOR" target="MTOR" id="968">
        <attvalues>
          <attvalue for="6" value="RPTOR" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Raptor wraps the N-HEAT solenoid and projects a substrate-recognition surface outward; because the mTOR cleft is deep and partially occluded, recruitment by Raptor is obligatory, not incidental." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="14; 305; 362; 670" />
