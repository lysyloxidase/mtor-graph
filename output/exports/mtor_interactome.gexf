      <edge source="RAPAMYCIN" target="PHENO_HYPERTRIGLYCERIDAEMIA" id="274">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_HYPERTRIGLYCERIDAEMIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Altered hepatic and adipose lipid handling under inhibition of both complexes raises triglycerides and cholesterol in a dose-related manner; monitoring and statin therapy are the usual mitigation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="568" />
          <attvalue for="14" value="therapeutic exposures" />
