      <edge source="RPS6KB1" target="RICTOR" id="1024">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="RICTOR" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="mTORC1-activated S6K1 directly phosphorylates Rictor at Thr1135, creating a 14-3-3 binding site without altering mTORC2 assembly or in vitro kinase activity. Two studies found that a T1135A mutant raises AKT Ser473 phosphorylation, indicating feedback inhibition, whereas two others saw no major change in mTORC2 activity or AKT phosphorylation." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="Thr1135" />
          <attvalue for="13" value="53; 142; 285; 607" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="Boulbès et al. 2010 [53] detected Thr1135 phosphorylation in mTORC2-deficient cells, suggesting that it may also regulate functions of Rictor outside mTORC2." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="phosphorylation:265ff1996d671131" />
        </attvalues>
      </edge>
