          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Low-dose rapamycin given during acute viral infection increases both the quantity and the functional quality of memory CD8 T cells, T cell-intrinsically and across infection models and in primates." />
