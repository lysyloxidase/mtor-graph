          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Second most frequent treatment-related adverse event (44%) in the 57-patient first-in-human dose-escalation study." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="535" />
          <attvalue for="14" value="phase 1 dose escalation, intravenous weekly dosing" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The frequency comes from one uncontrolled dose-escalation cohort and has not been independently replicated." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:dd27d9ca234a277b" />
        </attvalues>
