      <edge source="RAPALINK1" target="ATP_SITE" id="220">
        <attvalues>
          <attvalue for="6" value="RAPALINK1" />
          <attvalue for="7" value="ATP_SITE" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The tethered ATP-site moiety delivers complete catalytic inhibition once the molecule is anchored through FKBP12, so inhibition does not depend on the allosteric effect alone." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="501" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="competitive_inhibition:a9b427a95b8ac930" />
