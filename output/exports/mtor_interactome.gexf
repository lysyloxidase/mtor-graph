          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Microglial Tsc1 loss produces an amoeboid, highly proliferative and phagocytic phenotype without a pro-inflammatory cytokine signature, with reduced synapse density." />
