          <attvalue for="12" value="" />
          <attvalue for="13" value="694; 695" />
          <attvalue for="14" value="lysosomal surface" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="AXIN1 is a scaffold and does not itself phosphorylate Thr172. Evidence comes mainly from one laboratory." />
