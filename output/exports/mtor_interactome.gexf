        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="INSULIN_SECRETION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Insulin secretion and beta-cell survival depend on mTORC2 in the islet, so both complexes are required there, unlike the opposing arrangement in liver and adipose tissue; reduced insulin output contributes to the dysglycaemia seen at immunosuppressive exposures of mTOR inhibitors." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="29; 202" />
          <attvalue for="14" value="pancreatic beta-cell" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Beta-cell Rictor deletion principally reduces beta-cell mass and proliferation, and the fall in insulin output has not been dissociated from that loss of mass." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:829283b5119f9174" />
        </attvalues>
      </edge>
