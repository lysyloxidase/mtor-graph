      <edge source="DEPTOR" target="MTORC2" id="695">
        <attvalues>
          <attvalue for="6" value="DEPTOR" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="DEPTOR is a substoichiometric inhibitory subunit of mTORC2 as well as of mTORC1." />
          <attvalue for="11" value="established" />
