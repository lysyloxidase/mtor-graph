          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="ATP-competitive mTOR active-site tool inhibitor used to define the rapamycin-resistant outputs of mTORC1 and mTORC2." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Torkinib" />
        </attvalues>
