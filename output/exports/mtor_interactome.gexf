          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Reduced TOR signalling extends lifespan in Saccharomyces cerevisiae, Caenorhabditis elegans and Drosophila melanogaster, so TOR activity limits lifespan." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="289; 298; 476; 629" />
          <attvalue for="14" value="yeast, worm and fly" />
