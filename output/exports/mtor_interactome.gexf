        <attvalues>
          <attvalue for="6" value="TOS_MOTIF" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="4E-BP1 carries a C-terminal TOS motif (FEMDI) required for Raptor binding and for efficient multisite phosphorylation by mTORC1." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="70; 109; 437; 532" />
          <attvalue for="14" value="" />
