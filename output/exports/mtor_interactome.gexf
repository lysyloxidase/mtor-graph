          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Docking on the exposed FRB of assembled mTORC1 sterically restricts access of substrates to the already deep catalytic cleft rather than abolishing catalysis, giving partial, substrate-selective inhibition." />
