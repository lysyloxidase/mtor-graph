      <edge source="MTORC2" target="SREBF1" id="916">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="SREBF1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Hepatic mTORC2 supports lipogenesis through SREBP1c and glycolysis through glucokinase; the effect on SREBP1c is relayed by AKT and no direct action of the complex on the transcription factor has been shown." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="210" />
          <attvalue for="14" value="liver" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:2b050f362e2ff9cc" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="SREBF1" id="917">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="SREBF1" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Hepatic mTORC2 phosphorylates AKT at Ser473, and AKT-dependent glucokinase induction and SREBP1c processing drive lipogenesis; SREBP1 is therefore an indirect output of this complex, and the same transcription factor is driven by both complexes in liver." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="210" />
          <attvalue for="14" value="liver" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
