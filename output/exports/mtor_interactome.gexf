      <node id="RAIP_MOTIF" label="RAIP motif">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="N-terminal sequence of 4E-BP1 that binds Raptor and cooperates with the C-terminal TOS motif in substrate recruitment." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="RAIP" />
        </attvalues>
      </node>
      <node id="RBD_DOMAIN" label="mSin1 Ras-binding domain">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Ras-binding domain of mSin1, which engages Ras-family GTPases and couples Ras signalling to mTORC2; its functional contribution remains incompletely resolved." />
          <attvalue for="4" value="MAPKAP1" />
          <attvalue for="5" value="RBD" />
        </attvalues>
      </node>
      <node id="RICTOR" label="Rictor">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Defining, rapamycin-insensitive subunit of mTORC2; binds mSin1 through its N-terminal region, contributes to steric occlusion of the FRB domain, and forms part of the N-terminal mooring that engages the Akt kinase C-lobe." />
          <attvalue for="4" value="RICTOR" />
          <attvalue for="5" value="PIA; mAVO3; rapamycin-insensitive companion of mTOR" />
        </attvalues>
      </node>
      <node id="RPTOR" label="Raptor">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="1335-residue defining subunit of mTORC1: N-terminal caspase-like domain (non-proteolytic), HEAT-like central region, C-terminal WD40 beta-propeller. Wraps the mTOR N-HEAT solenoid and presents the outward-facing TOS-motif substrate surface." />
          <attvalue for="4" value="RPTOR" />
          <attvalue for="5" value="KIAA1303; KOG1; raptor; regulatory-associated protein of mTOR" />
        </attvalues>
      </node>
      <node id="TOS_MOTIF" label="TOS motif (TOR signalling motif)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Five-residue F [DE] [IML] [DE] [LI] motif (S6K1 FDIDL, 4E-BP1 FEMDI, PRAS40 FVMDE, HIF-1alpha) that docks substrates and PRAS40 onto Raptor and so onto mTORC1; mutation of the motif abolishes mTORC1-dependent phosphorylation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="TOS" />
        </attvalues>
      </node>
      <node id="MCOLN1" label="TRPML1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Lysosomal cation channel releasing local Ca2+ on mTORC1 inhibition or lysosomal stress, activating calcineurin; itself a CLEAR-network target gene, forming a feed-forward loop with TFEB." />
          <attvalue for="4" value="MCOLN1" />
          <attvalue for="5" value="mucolipin-1" />
        </attvalues>
      </node>
      <node id="MAPKAP1_ISOFORM5" label="mSin1 isoform 5 (mSin1.5, PH-domain-less)">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="mtorc2_regulation_and_outputs" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="Splice isoform of mSin1 lacking the C-terminal PH domain; assembles an mTORC2 species whose AKT Ser473 kinase activity is not gated by insulin/PIP3 (Frias et al. 2006)." />
          <attvalue for="4" value="MAPKAP1" />
          <attvalue for="5" value="SIN1 isoform 5; mSin1.5" />
        </attvalues>
