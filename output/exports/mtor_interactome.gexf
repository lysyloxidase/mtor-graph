          <attvalue for="12" value="" />
          <attvalue for="13" value="177" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="Alternative splicing of mSin1 generates three mTORC2 species; the assignment comes from a single biochemical study and has not been independently reproduced, although the behaviour of the complex built on the isoform lacking the C-terminal PH domain is consistent with later work showing that the PH domain autoinhibits the complex until PIP3 binds." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="complex_formation:3672a04c5f3a8cba" />
