          <attvalue for="7" value="SESN1" />
          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="p53 binds response elements in SESN1 (PA26) and induces it after DNA damage; Sestrin1 contributes to p53-dependent mTORC1 suppression via GATOR2 binding and AMPK." />
