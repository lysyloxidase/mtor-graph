          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Loss-of-function PTEN alterations are among the most common lesions of prostate cancer, glioblastoma and endometrial carcinoma, and raise flux through the PI3K-AKT network without creating dependency on the mTOR node." />
