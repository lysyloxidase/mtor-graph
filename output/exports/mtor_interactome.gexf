      <edge source="TSC2" target="RHEB" id="605">
        <attvalues>
          <attvalue for="6" value="TSC2" />
          <attvalue for="7" value="RHEB" />
          <attvalue for="8" value="gap_activity" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="TSC2 GAP domain accelerates Rheb GTP hydrolysis ~100-fold via an asparagine-thumb mechanism, converting Rheb·GTP to inactive Rheb·GDP; Rheb has no established GEF." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Asn1643 (TSC2 asparagine thumb)" />
          <attvalue for="13" value="261; 390; 600; 673" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="GAP polarity: TSC2 is the GAP (negative regulator); loss of TSC1/TSC2 gives constitutive Rheb·GTP and mTORC1 activation." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="gap_activity:a6e1c1ef3ca78c12" />
