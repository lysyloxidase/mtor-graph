          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Lipolysis and insulin-stimulated glucose uptake are the adipose outputs that depend on mTORC2; adipocyte Rictor deletion alters lipid handling, and pharmacological inhibition is expected to produce altered lipid handling and hypertriglyceridaemia." />
