          <attvalue for="7" value="PRKAB1" />
          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="p53 transcriptionally induces the AMPK β1 regulatory subunit, raising AMPK heterotrimer abundance as part of the same transcriptional programme that induces sestrins, TSC2 and PTEN." />
