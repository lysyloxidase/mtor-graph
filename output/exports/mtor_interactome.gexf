          <attvalue for="7" value="PHENO_HYPERGLYCAEMIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Chronic exposure raises glucose through combined beta-cell dysfunction and mTORC2-dependent peripheral insulin resistance; attribution is mTORC2 greater than mTORC1." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="29; 325; 568" />
          <attvalue for="14" value="continuous therapeutic exposure" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Whether intermittent low-exposure regimens avoid this effect is unresolved." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:61acac61d03f0965" />
