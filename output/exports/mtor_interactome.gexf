      </edge>
      <edge source="LYSOSOMAL_STRESS" target="MCOLN1" id="87">
        <attvalues>
          <attvalue for="6" value="LYSOSOMAL_STRESS" />
          <attvalue for="7" value="MCOLN1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Lysosomal stress, including oxidative stress sensed directly by TRPML1 (MCOLN1), opens this lysosomal Ca2+ channel; the released Ca2+ activates calcineurin, which dephosphorylates TFEB and drives its nuclear translocation independently of mTORC1 inhibition." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="406; 697" />
          <attvalue for="14" value="lysosomal damage or stress" />
