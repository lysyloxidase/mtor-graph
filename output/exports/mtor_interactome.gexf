          <attvalue for="8" value="other" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Under nutrient sufficiency the TTT-RUVBL1/2 complex promotes mTORC1 dimerisation and its localisation to the Rag-Ragulator platform; energy stress disassembles it" />
