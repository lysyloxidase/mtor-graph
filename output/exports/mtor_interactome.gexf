          <attvalue for="7" value="TSC_COMPLEX" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Two TSC2 (tuberin) copies supply the Rheb-GAP domains presented at the apex of the arch." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
