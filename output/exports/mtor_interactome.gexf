          <attvalue for="6" value="DEPTOR" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="DEPTOR engages the FAT region of mTOR through its PDZ domain, suppressing kinase output toward substrates of both complexes." />
