          <attvalue for="13" value="168; 169" />
          <attvalue for="14" value="DNA damage; mouse tissues and cell lines" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Induction is conditional rather than general; the dominant p53 route to mTORC1 runs through sestrins and AMPK. Induction of the AMPK beta1 subunit is documented in the same studies." />
