          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Rapamycin substantially extends the lifespan of Bmal1-null mice, the key in vivo evidence that their shortened lifespan is mTORC1-dependent." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="304" />
          <attvalue for="14" value="Bmal1-/- mice" />
