          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="522-residue mTORC2 subunit with four regions: N-terminal Rictor-binding segment, central CRIM domain that docks AGC substrates, a Ras-binding domain, and a C-terminal PH domain that binds PIP3 and autoinhibits the complex." />
          <attvalue for="4" value="MAPKAP1" />
          <attvalue for="5" value="MAPKAP1; MIP1; SIN1; Sin1" />
        </attvalues>
      </node>
