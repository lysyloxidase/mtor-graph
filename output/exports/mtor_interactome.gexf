      <node id="RAPALINK1" label="RapaLink-1">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="First bi-steric mTOR inhibitor: a rapamycin (FKBP12-binding) moiety tethered to an ATP-site moiety, achieving mTORC1 selectivity through FKBP12-mediated avidity and overcoming FRB resistance mutations." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="RapaLink; RapaLink1" />
        </attvalues>
      </node>
      <node id="RAPAMYCIN" label="Rapamycin (sirolimus)">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="First-generation allosteric rapalog. Binds FKBP12 with sub- to low-nanomolar affinity; the binary complex engages the FRB domain of assembled mTORC1. Pharmacokinetics (node attributes, not edges): oral bioavailability approximately 14% for the tablet formulation, terminal half-life near 62 h; CYP3A4 and P-glycoprotein substrate; therapeutic drug monitoring with troughs typically 4-12 ng/mL in transplantation. Compounded rapamycin, widely used off-label, delivers substantially lower and more variable systemic exposure per milligram than the branded product, which is both a safety consideration and a major confounder in trials that used it. Off-label use for healthspan is not endorsed by any professional body." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="AY-22989; Rapamune; sirolimus" />
        </attvalues>
      </node>
      <node id="RIDAFOROLIMUS" label="Ridaforolimus">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Non-prodrug rapalog with a phosphine oxide substituent at C43; investigated in sarcoma and other solid tumours but not approved." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="AP23573; MK-8669; deforolimus" />
        </attvalues>
      </node>
      <node id="RMC5552" label="RMC-5552">
        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Bi-steric mTORC1-selective inhibitor that fully suppresses 4E-BP1; phase 1 reported a complete response in PTEN/PIK3CA-altered endometrial cancer with treatment-related hyperglycaemia in only 4% of patients." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
