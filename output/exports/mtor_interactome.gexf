      <edge source="SAR1B" target="GATOR2" id="360">
        <attvalues>
          <attvalue for="6" value="SAR1B" />
          <attvalue for="7" value="GATOR2" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In the absence of leucine SAR1B binds GATOR2 and blocks its inhibition of GATOR1, keeping mTORC1 off; leucine binding to SAR1B dissociates the SAR1B-GATOR2 complex." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="103" />
          <attvalue for="14" value="leucine deprivation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Single primary report; the leucine-sensing role of SAR1B awaits independent replication." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sequestration:80054a3238fa1bb3" />
        </attvalues>
      </edge>
      <edge source="SAR1B" target="MTORC1" id="361">
        <attvalues>
          <attvalue for="6" value="SAR1B" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Leucine-bound SAR1B was reported to regulate mTORC1 activity; the downstream connection to the Rag machinery is not firmly established" />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="103" />
          <attvalue for="14" value="leucine deprivation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Net effect of the SAR1B arm; the molecular step is the binding of apo-SAR1B to GATOR2, and the route from GATOR2 to the Rag GTPases was not defined in the primary report." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:14bcbea525be5e52" />
        </attvalues>
      </edge>
      <edge source="SESN1" target="GATOR2" id="362">
        <attvalues>
          <attvalue for="6" value="SESN1" />
          <attvalue for="7" value="GATOR2" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Sestrin1 interacts with GATOR2 in the same way as Sestrin2, contributing to negative regulation of the amino-acid sensing pathway" />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="94" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="SESN1/2/3 differ in tissue expression, so which sensing mechanism dominates is expected to vary between tissues." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sequestration:2df85482ccff0abf" />
        </attvalues>
      </edge>
      <edge source="SESN1" target="AMPK" id="363">
        <attvalues>
          <attvalue for="6" value="SESN1" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Sestrin1, like sestrin2, promotes AMPK activation and downstream TSC2 phosphorylation, forming the p53-dependent feedback loop that suppresses mTORC1 after genotoxic stress." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="65" />
          <attvalue for="14" value="DNA damage" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Whether AMPK mediates the effect of Sestrin1 on mTORC1 is disputed; later work places sestrin action primarily through GATOR2 and the Rag GTPases." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:d79bee5354e514ab" />
        </attvalues>
      </edge>
      <edge source="SESN2" target="AMPK" id="364">
        <attvalues>
          <attvalue for="6" value="SESN2" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Sestrins have been reported to activate AMPK and so to inhibit mTORC1 through TSC2, a route independent of GATOR2 sequestration; the molecular basis is undefined and Sestrin2 still suppresses mTORC1 in AMPK-null cells." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="65; 337" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The AMPK arm is reported rather than reproduced; the best-supported route from Sestrin2 to mTORC1 is sequestration of GATOR2." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:9671563fb5a9e207" />
        </attvalues>
      </edge>
      <edge source="SESN2" target="AMPK" id="365">
        <attvalues>
          <attvalue for="6" value="SESN2" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Sestrin1/2 were reported to bind AMPK (and TSC2) and promote AMPK-mediated TSC2 phosphorylation, mediating p53-dependent mTORC1 inhibition after genotoxic stress." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="65" />
          <attvalue for="14" value="DNA damage; genotoxic stress" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Later work (Chantranupong 2014, Peng 2014 Cell) shows sestrins inhibit mTORC1 primarily through GATOR2 and the Rag GTPases, independently of AMPK; the physiological contribution of the AMPK route is disputed." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:835685a5266d7a21" />
        </attvalues>
      </edge>
      <edge source="SESN2" target="GATOR2" id="366">
        <attvalues>
          <attvalue for="6" value="SESN2" />
          <attvalue for="7" value="GATOR2" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Apo-Sestrin2 binds GATOR2 across the WDR24 and SEH1L beta-propellers, with auxiliary contacts to MIOS, preventing GATOR2 from inhibiting GATOR1 so RagA/B remain GDP-bound and mTORC1 leaves the lysosome; leucine binding (Kd approximately 20 microM) releases GATOR2." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="94; 530; 581; 655" />
          <attvalue for="14" value="leucine deprivation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Established in vitro and structurally, while the physiological primacy of Sestrin2 as a leucine sensor is contested. Sestrin2 is itself induced by p53 and ATF4, so stress input converges on this step." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sequestration:8e5ea12c95e6f2b6" />
        </attvalues>
      </edge>
      <edge source="SESN2" target="RRAGA" id="367">
        <attvalues>
          <attvalue for="6" value="SESN2" />
          <attvalue for="7" value="RRAGA" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Alternative model in which Sestrin2 acts as a guanine-nucleotide dissociation inhibitor for RagA/B, locking them in the GDP state, rather than acting only by sequestering GATOR2. Published results conflict with the GATOR2-sequestration-only model." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="337; 460" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Contested: the guanine-nucleotide dissociation inhibitor model and the GATOR2-sequestration model of Sestrin action are in direct conflict and have not been reconciled." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:4b5390c1b33a4eb8" />
        </attvalues>
      </edge>
      <edge source="SESN2" target="WDR24" id="368">
        <attvalues>
          <attvalue for="6" value="SESN2" />
          <attvalue for="7" value="WDR24" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Sestrin2 binds the WDR24-SEH1L region of GATOR2; MIOS is the principal CASTOR1-binding subunit." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="581; 618" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="binding:e3ab2a3ce2797937" />
