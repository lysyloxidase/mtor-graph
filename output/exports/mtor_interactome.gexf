      </node>
      <node id="EIF4EBP1" label="4E-BP1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="mtorc1_output_translation_ribosome" />
          <attvalue for="2" value="5" />
          <attvalue for="3" value="Translational repressor of eIF4E, phosphorylated hierarchically by mTORC1 (Thr37/Thr46 first, then Thr70 and Ser65). Thr37/Thr46 are the rapamycin-resistant sites that define the limits of rapalog pharmacology." />
          <attvalue for="4" value="EIF4EBP1" />
          <attvalue for="5" value="4EBP1; PHAS-I" />
        </attvalues>
