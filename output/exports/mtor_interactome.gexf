      <edge source="PRR5" target="SGK1" id="947">
        <attvalues>
          <attvalue for="6" value="PRR5" />
          <attvalue for="7" value="SGK1" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Protor-1 is required for efficient mTORC2-mediated SGK1 activation, an effect most evident in kidney." />
          <attvalue for="11" value="emerging" />
