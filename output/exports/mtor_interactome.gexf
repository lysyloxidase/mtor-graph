      <edge source="RPTOR" target="ULK1" id="971">
        <attvalues>
          <attvalue for="6" value="RPTOR" />
          <attvalue for="7" value="ULK1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Raptor binds ULK1 in a nutrient-dependent manner, incorporating mTORC1 into the ULK1-ATG13-FIP200 complex and presenting ULK1 for inhibitory phosphorylation at Ser758 (Ser757 in mouse)." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="242; 286" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="manual override: Raptor binds the ULK1 TOS motif to present ULK1 for inhibitory Ser757 phosphorylation by mTORC1; the net effect of the Raptor-ULK1 interaction on ULK1 activity is inhibitory, so a positive sign would mislead sign-aware path queries." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="binding:7607461a56e4508c" />
        </attvalues>
