          <attvalue for="14" value="continuous immunosuppressive exposure" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The diabetogenic signal is clearest at high continuous exposures; extrapolation to intermittent low-dose use is not supported." />
