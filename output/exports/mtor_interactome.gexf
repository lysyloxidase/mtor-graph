      <edge source="RAPAMYCIN" target="AKT" id="286">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="AKT" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Two opposing effects: relief of S6K1-IRS-1 feedback raises PI3K-dependent Thr308 signalling, while prolonged mTORC2 depletion lowers Ser473. Net direction depends on exposure duration and cell type." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser473; Thr308" />
