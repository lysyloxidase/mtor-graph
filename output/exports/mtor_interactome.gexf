          <attvalue for="7" value="FLCN" />
          <attvalue for="8" value="recruitment" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Amino-acid withdrawal recruits folliculin to lysosomes, where it binds RagA and is held in an inactive lysosomal complex; amino-acid restoration releases it and licenses RagC/D GTP hydrolysis, supporting Rag-dependent recruitment of mTORC1." />
