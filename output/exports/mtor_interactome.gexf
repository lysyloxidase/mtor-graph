      <edge source="LYSOSOME" target="MTORC1" id="662">
        <attvalues>
          <attvalue for="6" value="LYSOSOME" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="mTORC1 is activated on the cytosolic face of the lysosomal membrane, which is the point at which nutrient, growth-factor and stress information is spatially integrated" />
