          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="When ATP consumption exceeds production, adenylate kinase (2 ADP &lt;-&gt; ATP + AMP) amplifies the AMP rise so AMP:ATP changes roughly as the square of ADP:ATP, making AMP the sensitive low-energy signal." />
