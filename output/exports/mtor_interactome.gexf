          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="C-terminal pleckstrin-homology domain of mSin1; in the basal state it folds back onto the mTOR kinase domain and suppresses catalysis, and binding of PtdIns(3,4,5)P3 releases this autoinhibition at the plasma membrane." />
          <attvalue for="4" value="MAPKAP1" />
          <attvalue for="5" value="PH" />
        </attvalues>
