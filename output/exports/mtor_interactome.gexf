          <attvalue for="6" value="EIF4EBP1" />
          <attvalue for="7" value="VIP" />
          <attvalue for="8" value="translational_regulation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="4E-BP1 represses translation of Vip mRNA in SCN neurons; 4E-BP1 loss raises VIP levels, accelerating re-entrainment and increasing network synchrony." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="81" />
          <attvalue for="14" value="mouse SCN, Eif4ebp1-null" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="PMID 23972597 (Cao R et al., Neuron 2013;79(4):712-724). Repression of VIP translation is supported by the Eif4ebp1-null phenotype in that paper." />
          <attvalue for="17" value="circadian" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="translational_regulation:dacb60052317961a" />
