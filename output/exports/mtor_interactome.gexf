      <node id="EIF2AK4" label="GCN2">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="lysosomal_nutrient_sensing" />
          <attvalue for="2" value="1" />
          <attvalue for="3" value="Kinase activated by uncharged tRNA on amino-acid deprivation; drives ATF4 translation and thereby SESN2 induction, providing a slower transcriptional arm of amino-acid sensing." />
