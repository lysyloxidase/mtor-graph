          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="The constitutively active LKB1–STRADα–MO25 heterotrimer is the upstream kinase that phosphorylates the AMPK activation loop at Thr172; STRADα and MO25 are required for LKB1 catalytic competence and cytoplasmic localisation." />
          <attvalue for="11" value="established" />
