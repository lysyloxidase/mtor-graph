      <edge source="RMC5552" target="PHENO_HYPERGLYCAEMIA" id="314">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="PHENO_HYPERGLYCAEMIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Treatment-related hyperglycaemia occurred in only 4% and was not dose-limiting despite complete mTORC1 pathway suppression: the dissociation of efficacy from metabolic toxicity predicted by mTORC2 sparing." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="535" />
          <attvalue for="14" value="phase 1, single arm" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The most direct available human evidence, but from a single uncontrolled study." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="physiological_output:c219f4f6671afdc9" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="PHENO_NAUSEA" id="315">
        <attvalues>
