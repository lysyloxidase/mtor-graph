          <attvalue for="7" value="IRS1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Inhibiting mTORC1 removes S6K1-mediated inhibitory serine phosphorylation of IRS-1, stabilising it and restoring insulin- and IGF-1-driven PI3K output: the feedback arm of AKT rebound." />
