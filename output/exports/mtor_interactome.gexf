          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Corticosteroid used as a mouthwash to prevent rapalog-associated stomatitis (SWISH trial)." />
