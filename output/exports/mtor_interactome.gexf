      <node id="AGEING" label="Ageing">
        <attvalues>
          <attvalue for="0" value="stimulus" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Chronological ageing as an input: raises basal mTORC1 tone while attenuating acute responsiveness, impairs stress-responsive autophagy and drives immunosenescence." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="EXERCISE_RESISTANCE" label="Resistance exercise / mechanical overload">
