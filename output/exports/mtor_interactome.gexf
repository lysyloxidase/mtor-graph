          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Unnamed small molecule reported in [280] to raise mTORC2 activity; enhances L-LTP and long-term memory in wild-type animals and reverses age-associated memory impairment in mice and flies." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="VAR_CLASS_DISTAL_NETWORK" label="Distal-network lesion class">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Lesions raising flux into a branched network in which mTORC1 is one effector among several and AKT retains output to GSK3beta, FOXO and MDM2." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
