      <edge source="RTB101" target="PI3K" id="321">
        <attvalues>
          <attvalue for="6" value="RTB101" />
          <attvalue for="7" value="PI3K" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="BEZ235 inhibits class I PI3K at sufficient concentrations; this biochemical target profile does not demonstrate substantial PI3K inhibition at the low doses used in the ageing trials." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="291; 385" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Target inhibition depends on exposure; the clinical studies described RTB101 as a TORC1 inhibitor." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="competitive_inhibition:84d90c890e294edc" />
        </attvalues>
