      <edge source="MTORC1" target="PHENO_MALADAPTIVE_REMODELLING" id="841">
        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="PHENO_MALADAPTIVE_REMODELLING" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Sustained mTORC1 activity contributes to maladaptive cardiac remodelling, in contrast to the physiological hypertrophy the same complex supports, and partial inhibition attenuates pathological hypertrophy in several models." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="405; 538" />
          <attvalue for="14" value="cardiomyocyte" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Cardiac mTOR also has protective roles, including after ischaemic injury, so the maladaptive arm is dose- and context-dependent rather than a uniform property of mTORC1 activity." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:96bf7004bdac3407" />
        </attvalues>
