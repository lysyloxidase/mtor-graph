      <edge source="RMC5552" target="ATP_SITE" id="307">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="ATP_SITE" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The ATP-competitive moiety occupies the kinase cleft, delivering complete catalytic inhibition of the FRB-anchored complex and thereby full suppression of both S6K1 and 4E-BP1 while mTORC2 is relatively spared." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="69; 339" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Explains the dissociation of complete mTORC1 pathway blockade from metabolic toxicity (hyperglycaemia 4%)." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="competitive_inhibition:fb199de3a3843d9d" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="DISEASE_CANCER" id="308">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="DISEASE_CANCER" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="In 57 patients with advanced solid tumours, disease control was reached in 64% at active doses and one PTEN- and PIK3CA-altered endometrial cancer achieved a complete response with clearance of variants from ctDNA." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="535" />
          <attvalue for="14" value="first-in-human phase 1, 58% with pathogenic mTOR-pathway variants" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="A single-arm disease-control rate is not an efficacy endpoint; the genotype-dependence prediction remains preliminary." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="drug_inhibition:3a357438ffacd376" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="FKBP12" id="309">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="FKBP12" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="The bi-steric agent carries an FKBP12-rapamycin moiety tethered by a linker to an ATP-site moiety; FKBP12 binding supplies the avidity that confers mTORC1 selectivity." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="69; 339" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:745bcf82b20e9db4" />
        </attvalues>
      </edge>
      <edge source="RMC5552" target="FRB_DOMAIN" id="310">
        <attvalues>
          <attvalue for="6" value="RMC5552" />
          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The FKBP12-bound moiety engages the exposed FRB domain of assembled mTORC1, anchoring the molecule and delivering the tethered ATP-site moiety to the kinase cleft of the same protomer." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="69; 339" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="binding:d9ad70770c959c1d" />
