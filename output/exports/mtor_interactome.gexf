          <attvalue for="7" value="PHENO_TREG_EXPANSION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="mTOR inhibition blocks Th1, Th2 and Th17 differentiation while permitting Foxp3+ regulatory T cell differentiation and expansion, which underlies the immunosuppressive use of the drug." />
