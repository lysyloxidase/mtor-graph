        <attvalues>
          <attvalue for="6" value="SLC7A5" />
          <attvalue for="7" value="GLUTAMINE" />
          <attvalue for="8" value="transport" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="LAT1/4F2hc is an obligatory antiporter: it effluxes intracellular glutamine in exchange for extracellular leucine, so SLC1A5-mediated glutamine uptake is the driving force for leucine import. This coupling is why glutamine deprivation blunts leucine-driven mTORC1 activation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="435" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Obligatory antiport: leucine import is coupled to glutamine efflux, so this route depletes rather than supplies the cytosolic glutamine pool, which is why glutamine deprivation blunts leucine-driven mTORC1 activation." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="transport:7a176d935e1bf94d" />
        </attvalues>
