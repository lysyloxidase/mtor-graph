          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Autophagic and lysosomal flux are under circadian control, so the magnitude of any mTORC1-dependent autophagy readout depends on sampling time — a confounder rarely addressed." />
