          <attvalue for="7" value="TISSUE_LIVER" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Hepatic mTORC1 drives insulin-stimulated SREBP1c-dependent lipogenesis and restrains fasting ketogenesis." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="212; 326; 677" />
