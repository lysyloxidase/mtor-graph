          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Intracerebroventricular leucine raises hypothalamic S6K1 phosphorylation and suppresses food intake and body weight; rapamycin abolishes the effect." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="120" />
          <attvalue for="14" value="hypothalamic arcuate nucleus (rodent)" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Established in rodents; no human study separates central from peripheral contribution." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="physiological_output:bb8ed5e15b343bd4" />
