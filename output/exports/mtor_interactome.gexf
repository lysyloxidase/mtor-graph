      <edge source="RAPAMYCIN" target="DISEASE_CANCER" id="255">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="DISEASE_CANCER" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Sirolimus-class agents have real but largely cytostatic antitumour activity: albumin-bound sirolimus is approved for advanced malignant perivascular epithelioid cell tumour, with response enriched in TSC2-mutant tumours, while no randomised trial of a rapalog in a solid tumour has shown a significant overall survival benefit. Separately, deferral of lethal neoplasia may account for part of the lifespan extension rapamycin produces in mice." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="432; 633" />
          <attvalue for="14" value="advanced solid tumours; mouse lifespan studies" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="What is disputed is the mechanism of murine lifespan extension, not the existence of antitumour activity." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:565da1689b69b360" />
        </attvalues>
      </edge>
