          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Cyclosporine binds cyclophilin A rather than FKBP12; the drug-immunophilin binary complex is the active species. This is the structural reason cyclosporine does not compete with rapamycin for FKBP12 whereas tacrolimus does." />
