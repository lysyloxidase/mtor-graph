          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="4E-BPs restrain translation of nuclear-encoded mitochondrial mRNAs including TFAM and mitochondrial ribosomal proteins; mTORC1 phosphorylation relieves this" />
          <attvalue for="11" value="established" />
