          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Overeating with weight gain produced by Tsc1 deletion in POMC neurons and partially corrected by rapamycin; mechanistically expected in Smith-Kingsmore syndrome." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="hyperphagia" />
        </attvalues>
      </node>
      <node id="PHENO_HYPERTRIGLYCERIDAEMIA" label="Hypertriglyceridaemia and hypercholesterolaemia">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Dose-related elevation of triglycerides and cholesterol on mTOR inhibitors, reflecting altered hepatic and adipose lipid handling by both complexes." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="dyslipidaemia" />
        </attvalues>
      </node>
      <node id="PHENO_IMMUNOSENESCENCE" label="Immunosenescence">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Thymic involution, naive repertoire contraction, PD-1+ exhausted-like cells and inflammaging; the most productive clinical testing ground for geroprotection." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="inflammaging" />
        </attvalues>
      </node>
      <node id="PHENO_INSULIN_RESISTANCE" label="Peripheral insulin resistance">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Reduced insulin-stimulated glucose disposal in peripheral tissues. Distinct from direct beta-cell toxicity: chronic mTORC2 loss produces peripheral insulin resistance, and the two mechanisms together account for rapamycin-associated new-onset diabetes at immunosuppressive exposures." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_ISG_EXPRESSION" label="Interferon-stimulated antiviral gene expression">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Upregulation of interferon-stimulated antiviral genes reported with RTB101 plus low-dose everolimus; the mechanistic correlate of the reduced laboratory-confirmed respiratory infections in that phase 2b." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="ISG" />
        </attvalues>
      </node>
      <node id="PHENO_LEAN_MASS" label="Lean tissue mass">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Fat-free body mass" />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_LIFESPAN_EXTENSION" label="Lifespan extension">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Increase in median and maximal lifespan in genetically heterogeneous mice given encapsulated rapamycin from 600 days of age, reproduced across three sites and dose- and sex-dependent." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="longevity; median lifespan" />
        </attvalues>
      </node>
      <node id="PHENO_MALADAPTIVE_REMODELLING" label="Maladaptive cardiac remodelling">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Pathological hypertrophic remodelling driven by sustained mTORC1 activity, distinct from the physiological hypertrophy that mTORC1 also supports; attenuated by partial inhibition in multiple models." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="pathological hypertrophy" />
        </attvalues>
      </node>
      <node id="PHENO_MICROGLIAL_ACTIVATION" label="Amoeboid phagocytic microglial phenotype">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Amoeboid, highly proliferative and phagocytic microglial state produced by Tsc1 loss, notably without a pro-inflammatory cytokine signature." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_MUSCLE_ATROPHY" label="Denervation muscle atrophy">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Loss of myofibre mass after denervation; prevented by constitutively active AKT, establishing sufficiency of the AKT-mTOR arm for maintenance of muscle mass." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_MUSCLE_DYSTROPHY" label="Muscular dystrophy (Raptor-null)">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Progressive dystrophy with impaired oxidative capacity and shortened lifespan after muscle-specific Raptor deletion; the phenotype against which near-silent Rictor deletion is contrasted." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_MUSCLE_HYPERTROPHY" label="Load-induced muscle hypertrophy">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Hypertrophic growth of skeletal muscle in response to IGF-1, mechanical overload or chronic stimulation; mTORC1 is necessary and sufficient and rapamycin blocks it, which is the basis of the anabolic-resistance safety concern for chronic geroprotective dosing." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_MYELINATION" label="Myelination">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Formation and thickness of myelin sheaths; requires oligodendrocyte mTORC1, with spinal cord affected more than corpus callosum." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_NEURODEGENERATION" label="Neurodegeneration">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Progressive neuronal loss with ubiquitin-positive inclusions and motor deficits, produced by neural Atg5 or Atg7 deletion alone." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_OLIGODENDROCYTE_DIFFERENTIATION" label="Oligodendrocyte differentiation">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Maturation of oligodendrocyte precursors; impaired only in the Raptor/Rictor double mutant, indicating that mTORC2 contributes but is not rate-limiting while mTORC1 remains intact." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_OSTEOBLAST_DIFFERENTIATION" label="Osteoblast differentiation">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Bone-forming cell differentiation requiring mTOR signalling." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_OSTEOCLAST_DIFFERENTIATION" label="Osteoclast differentiation">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Bone-resorbing cell differentiation also requiring mTOR, which is why the net skeletal effect of inhibition is context-dependent." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_PD1_T_CELLS" label="PD-1+ CD4 and CD8 T cell fraction">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Accumulation of PD-1-positive CD4 and CD8 T cells with age; fractions fell in older adults given low-dose everolimus before influenza vaccination." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_PROTEINURIA" label="Proteinuria">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Urinary protein loss on mTOR inhibitors, reflecting the podocyte requirement for mTORC1 and disrupted podocyte autophagic flux." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_RAPALOG_SENSITIVITY" label="Rapalog sensitivity">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Tumour responsiveness to allosteric mTORC1 inhibition; predicted by proximal-brake lesions as enrichment rather than individual prediction, and not by distal-network lesions." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_SARCOPENIA" label="Sarcopenia">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Age-related loss of muscle mass and function; the predicted consequence of chronic mTOR inhibition in skeletal muscle, and the central safety question for geroscience dosing." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_SEIZURES" label="Spontaneous recurrent seizures">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Epileptic seizures; the shared endpoint of the mTORopathies and of microglial Tsc1 loss, with elevated SUDEP risk in GATOR1 epilepsies." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="epilepsy" />
        </attvalues>
      </node>
      <node id="PHENO_SPINE_DENSITY" label="Dendritic spine density">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Density of dendritic spines, which falls when forebrain mTORC2 activity and Tiam1–Rac1-dependent actin polymerisation are reduced." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_SUDEP" label="Sudden unexpected death in epilepsy">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Elevated risk carried by the GATOR1-related familial focal epilepsies, which is part of why mTOR-directed therapy in this group is being pursued on limited evidence." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="SUDEP" />
        </attvalues>
      </node>
      <node id="PHENO_TH1_TH17" label="Th1 and Th17 differentiation">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Effector CD4 lineages requiring Rheb-mTORC1; their suppression is part of the immunosuppressive action of rapalogs." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_TREG_EXPANSION" label="Regulatory T cell expansion">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Preferential survival and expansion of CD4+CD25+Foxp3+ regulatory T cells under mTOR inhibition, while effector differentiation is blocked; the basis of the immunosuppressive use of rapamycin." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Treg; Treg expansion" />
        </attvalues>
      </node>
      <node id="PHENO_T_CELL_SURVIVAL" label="T-cell survival signalling">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="AKT-dependent survival output; the second mTORC2-dependent arm in T lymphocytes alongside Th2 differentiation." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_VACCINE_RESPONSE" label="Influenza vaccine antibody response">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Placebo-corrected rise in haemagglutination-inhibition titre after influenza vaccination in adults aged 65 and over; the endpoint demonstrating an inverted-U dose-response to mTOR inhibition." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="haemagglutination-inhibition titre" />
        </attvalues>
      </node>
      <node id="TISSUE_ADIPOSE" label="Adipose tissue">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Tissue in which adipocyte Rictor deletion reduces insulin-stimulated glucose uptake, alters ChREBP-driven lipogenesis and lipid handling, and negatively controls whole-body growth." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="adipocyte" />
        </attvalues>
      </node>
      <node id="TISSUE_BONE" label="Bone">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Skeletal tissue; mTOR signalling is required for both osteoblast and osteoclast differentiation, so the net effect of inhibition is context-dependent." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="osteoblast; osteoclast" />
        </attvalues>
      </node>
      <node id="TISSUE_HAEMATOPOIETIC" label="Haematopoietic compartment">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Marrow progenitor compartment whose proliferative mTORC1 requirement accounts for rapalog cytopenias; TSC-mTOR signalling also sets stem-cell quiescence." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="haematopoiesis" />
        </attvalues>
      </node>
      <node id="TISSUE_HYPOTHALAMUS" label="Hypothalamic arcuate neuron">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Arcuate neurons in which mTORC1 acts as a nutrient sensor rather than a growth regulator, integrating leucine and leptin into control of food intake." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="POMC neuron" />
        </attvalues>
      </node>
      <node id="TISSUE_KIDNEY_PODOCYTE" label="Kidney podocyte">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Glomerular epithelial cell with a calibrated Goldilocks requirement: both Tsc1 deletion and Raptor deletion produce injury and proteinuria." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="podocyte" />
        </attvalues>
      </node>
      <node id="TISSUE_LIVER" label="Liver">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Tissue in which the two complexes act in opposite directions on glucose output: mTORC1 drives SREBP1c lipogenesis while mTORC2 restrains gluconeogenesis through AKT–FOXO1." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="hepatocyte" />
        </attvalues>
      </node>
      <node id="TISSUE_MICROGLIA" label="Microglia">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Resident CNS macrophage; Tsc1 deletion restricted to microglia produces an amoeboid proliferative phagocytic phenotype and severe early-onset seizures." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TISSUE_OLIGODENDROCYTE" label="Oligodendrocyte">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Oligodendrocyte-lineage cells of the CNS. Conditional deletion cleanly separates the two complexes: mTORC1 is rate-limiting for myelination, mTORC2 contributes but is not rate-limiting while mTORC1 remains intact. The requirement is regional, spinal cord being affected more than corpus callosum." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="TISSUE_ORAL_EPITHELIUM" label="Oral epithelium">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Rapidly renewing mucosal epithelium whose mTORC1 dependence accounts for rapalog stomatitis and the dose-limiting mucositis of bi-steric agents." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="oral mucosa" />
        </attvalues>
      </node>
      <node id="TISSUE_T_LYMPHOCYTE" label="T lymphocyte">
        <attvalues>
          <attvalue for="0" value="tissue" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="T lymphocyte compartment. The only tissue in which inhibition of the pathway produces the desired rather than an adverse effect: partial mTORC1 inhibition expands Tregs and enhances CD8 memory, which is the basis of rapalog immunosuppression and of the immune-function geroscience hypothesis." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="T cell" />
        </attvalues>
      </node>
      <node id="DISEASE_ALLOGRAFT_REJECTION" label="Renal allograft rejection">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Alloimmune destruction of a transplanted kidney; the first approved indication for sirolimus, given at continuous immunosuppressive exposures with trough monitoring." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="transplant rejection" />
        </attvalues>
      </node>
      <node id="DISEASE_NODAT" label="New-onset diabetes after transplantation">
        <attvalues>
          <attvalue for="0" value="disease" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Diabetes arising at immunosuppressive mTOR-inhibitor exposures; mechanistically beta-cell toxicity plus mTORC2-dependent peripheral insulin resistance" />
          <attvalue for="4" value="" />
          <attvalue for="5" value="NODAT; post-transplant diabetes mellitus" />
        </attvalues>
      </node>
      <node id="PHENO_AMYLOID_BETA" label="Brain amyloid-beta burden">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Cerebral amyloid-beta accumulation, reduced by rapamycin in 3xTg-AD mice in an autophagy-dependent manner and largely only when treatment precedes substantial pathology." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="Abeta" />
        </attvalues>
      </node>
      <node id="PHENO_ANGIOMYOLIPOMA" label="Renal angiomyolipoma">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="TSC-associated renal tumour; 42% of patients achieved at least 50% reduction on everolimus (EXIST-2)." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_CNS_DRUG_EXPOSURE" label="CNS drug exposure">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Concentration of an mTOR inhibitor achieved in brain relative to blood; restricted and saturable for sirolimus and everolimus, so central and peripheral exposure-response relationships do not coincide." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="brain penetration" />
        </attvalues>
      </node>
      <node id="PHENO_FATIGUE" label="Fatigue">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Treatment-related fatigue, reported in 42% of patients in the RMC-5552 first-in-human dose-escalation study." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_HYPERCHOLESTEROLAEMIA" label="Hypercholesterolaemia">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Elevated plasma cholesterol during mTOR-inhibitor therapy; occurs alongside hypertriglyceridaemia and is attributed to altered hepatic and adipose lipid handling (mTORC2 and mTORC1)." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_HYPERGLYCAEMIA" label="Hyperglycaemia">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Elevated blood glucose on mTOR inhibitors, attributed chiefly to mTORC2 loss (peripheral insulin resistance) with a beta-cell contribution" />
          <attvalue for="4" value="" />
          <attvalue for="5" value="drug-induced hyperglycaemia" />
        </attvalues>
      </node>
      <node id="PHENO_IMPAIRED_WOUND_HEALING" label="Impaired wound healing">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Delayed surgical healing and lymphocele formation on mTOR inhibitors, attributed to suppressed angiogenesis and fibroblast proliferation; managed by perioperative interruption." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_INFECTION" label="Infection">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Increased infection risk at immunosuppressive exposures, following from suppression of effector lymphocyte expansion; dose- and schedule-dependent and not seen consistently at low intermittent exposures." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="opportunistic infection" />
        </attvalues>
      </node>
      <node id="PHENO_NAUSEA" label="Nausea">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Treatment-related nausea, the second most frequent adverse event (44%) in the RMC-5552 first-in-human dose-escalation study." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_PNEUMONITIS" label="Non-infectious pneumonitis">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Non-infectious interstitial lung inflammation in roughly 5-15% of oncology patients receiving everolimus; the most serious and least mechanistically understood rapalog toxicity." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="drug-induced pneumonitis" />
        </attvalues>
      </node>
      <node id="PHENO_PROTEIN_AGGREGATES" label="Misfolded protein aggregates">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Aggregation-prone substrates cleared by macroautophagy (alpha-synuclein, polyglutamine-expanded huntingtin), reduced by rapamycin or temsirolimus in fly and mouse models." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_RESPIRATORY_INFECTION" label="Respiratory tract infection">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Respiratory infections in older adults; ascertainment differs between participant-reported events in the phase 2a study and laboratory-confirmed events in phase 2b." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="PHENO_SEGA" label="Subependymal giant cell astrocytoma">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="TSC-associated brain tumour; approximately 35% of patients achieved at least 50% volume reduction on everolimus versus 0% on placebo (EXIST-1)." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="SEGA" />
        </attvalues>
      </node>
      <node id="PHENO_STOMATITIS" label="Stomatitis / mucositis">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Painful oral ulceration affecting roughly 30-60% of patients on rapalogs and 49% in the RMC-5552 phase 1 study; reflects mTORC1 dependence of renewing oral epithelium and is largely preventable." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="aphthous stomatitis; mucositis" />
        </attvalues>
      </node>
      <node id="PHENO_SYMPTOMATIC_RESPIRATORY_ILLNESS" label="Clinically symptomatic respiratory illness">
        <attvalues>
          <attvalue for="0" value="phenotype" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="8" />
          <attvalue for="3" value="Self-reported symptomatic respiratory illness; the subjective phase 3 endpoint that RTB101 monotherapy failed to meet in 1024 older adults." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
    </nodes>
