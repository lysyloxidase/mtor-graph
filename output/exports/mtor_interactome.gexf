      <edge source="RAG_HETERODIMER" target="FLCN_FNIP" id="664">
        <attvalues>
          <attvalue for="6" value="RAG_HETERODIMER" />
          <attvalue for="7" value="FLCN_FNIP" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="During amino-acid starvation Rag-Ragulator traps FLCN-FNIP2 in the inactive lysosomal folliculin complex (LFC), holding FLCN's catalytic arginine finger away from the RagC nucleotide pocket; amino-acid refeeding releases the complex and licenses RagC/D GTP hydrolysis. This checkpoint explains why FLCN GAP activity is nutrient-gated." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="331; 468; 557" />
          <attvalue for="14" value="amino-acid starvation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Two independent cryo-EM structures (Lawrence 2019; Shen 2019) show FLCN-FNIP2 bound to RagA-GDP with the FLCN catalytic arginine away from the RagC nucleotide; Shen 2019 interprets this state as an on-pathway intermediate rather than an inhibitory trap." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sequestration:193684a1e2bfc2cb" />
        </attvalues>
      </edge>
