          <attvalue for="7" value="PROTEIN_SYNTHESIS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="The protein-feeding dose-response shifts rightward with age, so a per-meal leucine threshold of roughly 3-4 g is proposed to maximise synthesis in older adults." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="161" />
          <attvalue for="14" value="older adults" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The per-meal leucine threshold is a practical proposal rather than an established requirement; a systematic review of postprandial post-exercise muscle protein synthesis found leucine dose to predict the response in older adults without identifying a discrete threshold." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:10a2958c0f8e702c" />
