          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Energy-replete conditions drive TTT-RUVBL1/2 assembly, which promotes mTORC1 dimerisation and lysosomal localisation; energy stress dissociates the module and the dimer, coupling nutrient state to the oligomeric state of the complex." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="311" />
