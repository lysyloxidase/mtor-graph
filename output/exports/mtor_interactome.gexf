          <attvalue for="7" value="TISSUE_SKELETAL_MUSCLE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Muscle-specific Rictor deletion is close to phenotypically silent, in contrast to Raptor deletion, which causes dystrophy; the residual mTORC2 contribution is limited to loss of AKT Ser473 phosphorylation and a modest fall in insulin-stimulated glucose uptake." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="38" />
          <attvalue for="14" value="skeletal muscle" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Negative result, retained because the asymmetry between the complexes in muscle is what predicts the tissue's drug response." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="physiological_output:a9ced558dac8d5e3" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TISSUE_T_LYMPHOCYTE" id="932">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TISSUE_T_LYMPHOCYTE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="mTORC2 supports Th2 effector differentiation and AKT-dependent survival in T lymphocytes; with mTORC1 it governs the metabolic reprogramming of effector activation and restrains Treg commitment." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="133; 134" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:ba8690f14750a2e9" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="TREG_DIFFERENTIATION" id="933">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="TREG_DIFFERENTIATION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Loss of total mTOR kinase activity abrogates Th1, Th2 and Th17 differentiation and favours Foxp3 induction, which underlies the preferential expansion of regulatory T cells under rapamycin; restraint of regulatory T cell differentiation is best documented for the AKT–mTORC1 arm, while deletion of Rictor alone has smaller and less consistent effects." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="33; 133; 134" />
          <attvalue for="14" value="CD4+ T lymphocyte" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="Both complexes have been reported to restrain regulatory T cell differentiation, but loss of mTORC2 alone can leave suppressive function intact or even improved. This is the one tissue setting in which the consequence of inhibition is the desired therapeutic effect rather than a toxicity." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="physiological_output:ba550e5c21bda1f3" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="GLYCOLYSIS" id="934">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="GLYCOLYSIS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Hepatic mTORC2 supports glycolysis via AKT and glucokinase; loss produces a phenotype reminiscent of type 2 diabetes." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="210" />
          <attvalue for="14" value="liver" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:a68fdceb79f8a8fd" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="LIPOGENESIS" id="935">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="LIPOGENESIS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Liver-specific Rictor deletion reduces glycolysis and lipogenesis; hepatic mTORC2 activates both through AKT, glucokinase and SREBP1c." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="210" />
          <attvalue for="14" value="liver" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:58183a7c334b1f15" />
        </attvalues>
      </edge>
      <edge source="MTORC2" target="PHENO_BETA_CELL_MASS" id="936">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="PHENO_BETA_CELL_MASS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Beta-cell Rictor deletion causes mild hyperglycaemia with reduced beta-cell mass, decreased AKT Ser473 phosphorylation, nuclear FOXO1 accumulation and elevated p27." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="202" />
          <attvalue for="14" value="pancreatic beta-cell" />
