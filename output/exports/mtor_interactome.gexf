        <attvalues>
          <attvalue for="0" value="drug" />
          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="ATP-competitive PI3K/mTOR inhibitor (BEZ235/dactolisib) studied at low doses for immune function in older adults; the phase 3 respiratory-illness endpoint was not met." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="BEZ235; dactolisib" />
        </attvalues>
      </node>
