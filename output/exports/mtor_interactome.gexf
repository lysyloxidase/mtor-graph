          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="MAF1 binds the TFIIIB subunit BRF1 and inhibits de novo assembly of TFIIIB-DNA complexes on Pol III promoters, which impairs Pol III recruitment." />
