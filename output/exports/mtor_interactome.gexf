          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="In nutrient sufficiency mTORC1 phosphorylates ULK1 at Ser757 (mouse numbering; human Ser758), disrupting the ULK1-AMPK interaction and preventing AMPK-mediated activating phosphorylation at Ser317, Ser555 and Ser777; AMPK and mTORC1 therefore toggle autophagy initiation." />
