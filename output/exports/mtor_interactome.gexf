      <edge source="SCF_BTRC" target="DEPTOR" id="698">
        <attvalues>
          <attvalue for="6" value="SCF_BTRC" />
          <attvalue for="7" value="DEPTOR" />
          <attvalue for="8" value="degradation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="mTOR phosphorylates DEPTOR at Ser293 and Ser299 (and Thr295), priming CK1alpha to phosphorylate the Ser286/Ser287/Ser291 degron, which SCF(beta-TrCP) binds, polyubiquitinates and sends for proteasomal degradation. Active mTOR thereby removes its own inhibitor in a positive-feedback loop." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser286; Ser287; Ser291" />
          <attvalue for="13" value="150; 186; 701" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="Ser293 and Ser299 are mTOR priming sites outside the beta-TrCP degron. One study attributes degron phosphorylation instead to S6K1 and RSK1." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="degradation:b01fea987d569934" />
        </attvalues>
      </edge>
      <edge source="SKP1" target="SCF_BTRC" id="699">
        <attvalues>
          <attvalue for="6" value="SKP1" />
          <attvalue for="7" value="SCF_BTRC" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="SKP1 adapts the F-box protein beta-TrCP to the CUL1 scaffold." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="660; 703" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
