          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Energy stress (2-deoxyglucose, glucose deprivation) induces REDD1 through ATF4; REDD1 is required for mTORC1 inhibition in this setting, partly independently of AMPK." />
