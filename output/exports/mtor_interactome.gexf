          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Complete response ongoing beyond six months, with clearance of pathway variants from circulating tumour DNA, in a patient with PTEN- and PIK3CA-altered endometrial cancer; 58% of enrolled patients carried pathogenic mTOR-pathway variants." />
