          <attvalue for="7" value="RPS6" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Active S6K1 phosphorylates 40S ribosomal protein S6 in ordered fashion (Ser236 first); phosphorylation influences cell size and glucose homeostasis." />
