        <attvalues>
          <attvalue for="6" value="BTRC" />
          <attvalue for="7" value="DEPTOR" />
          <attvalue for="8" value="degradation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Growth-factor-induced phosphorylation of the DEPTOR degron, primed by mTOR (or by S6K1 and RSK1) and completed by casein kinase 1 alpha, creates a betaTrCP binding site; SCF-betaTrCP then ubiquitinates DEPTOR and targets it for proteasomal degradation, so active mTOR removes its own inhibitor." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="150; 186; 701" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
