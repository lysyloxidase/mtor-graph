        <attvalues>
          <attvalue for="6" value="AMPK" />
          <attvalue for="7" value="RPTOR" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="AMPK phosphorylates Raptor at Ser722/Ser792, directly inhibiting mTORC1 in parallel with its action on TSC2 and imposing a metabolic checkpoint." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser722; Ser792" />
