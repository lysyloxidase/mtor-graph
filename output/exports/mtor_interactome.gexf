          <attvalue for="7" value="PHENO_LIFESPAN_EXTENSION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Germline deletion of S6K1 extends median lifespan by about 19% in female mice, with no significant effect in males, placing one mTORC1 substrate arm within the longevity mechanism." />
