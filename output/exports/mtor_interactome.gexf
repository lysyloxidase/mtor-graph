        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="mTOR autophosphorylates at Ser2481 within the assembled complex; in mTORC2 this autophosphorylation is a complex-specific readout of intrinsic catalytic activity and is rapamycin-insensitive under acute treatment, unlike the mTORC1-associated pool." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser2481" />
          <attvalue for="13" value="571" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="Ser2481 is an activity-associated readout; the cited study does not establish that phosphorylation at this site activates mTOR." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="phosphorylation:d60a01a2543e21fd" />
        </attvalues>
