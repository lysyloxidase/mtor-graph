          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="sequestration" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="With prolonged exposure the drug-immunophilin complex captures newly synthesised mTOR before it is incorporated into mTORC2, depleting the complex rather than inhibiting the assembled one." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="527" />
          <attvalue for="14" value="prolonged exposure" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Kinetic, not structural, selectivity: acute experiments and chronic dosing study different pharmacology." />
