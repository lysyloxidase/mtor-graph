          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="S6K1 carries an N-terminal TOS motif (FDIDL) that is necessary for Raptor binding and for Thr389 phosphorylation." />
          <attvalue for="11" value="established" />
