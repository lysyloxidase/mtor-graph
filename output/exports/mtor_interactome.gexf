      <edge source="MECHANICAL_LOAD" target="DGKZ" id="39">
        <attvalues>
          <attvalue for="6" value="MECHANICAL_LOAD" />
          <attvalue for="7" value="DGKZ" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Eccentric contraction or stretch increases DGKζ-dependent PA synthesis; DGKζ overexpression is sufficient to induce fibre hypertrophy." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="684" />
          <attvalue for="14" value="skeletal muscle" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:6c35ee4a71683c1f" />
        </attvalues>
      </edge>
      <edge source="MECHANICAL_LOAD" target="PLD1" id="40">
        <attvalues>
          <attvalue for="6" value="MECHANICAL_LOAD" />
          <attvalue for="7" value="PLD1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Mechanical stretch and eccentric contraction were reported to raise phosphatidic acid in skeletal muscle through phospholipase D, independently of ERK and PI3K; later work from the same laboratory found that phospholipase D activity does not rise with loading and that the mechanically induced phosphatidic acid depends on diacylglycerol kinase zeta." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="241; 683" />
          <attvalue for="14" value="skeletal muscle, resistance exercise" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The phospholipase D and diacylglycerol kinase zeta routes are competing accounts of the same load-induced rise in phosphatidic acid in skeletal muscle." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:0fec69ed6a7b475c" />
        </attvalues>
      </edge>
      <edge source="MECHANICAL_LOAD" target="TSC2" id="41">
        <attvalues>
          <attvalue for="6" value="MECHANICAL_LOAD" />
          <attvalue for="7" value="TSC2" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Eccentric contractions increase TSC2 RxRxxS/T-motif phosphorylation and move TSC2 away from the lysosome while mTOR associates with it; responsible kinase not defined." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="272" />
          <attvalue for="14" value="skeletal muscle" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The mechanistic link between mechanical load and TSC2 relocalisation rests on a single laboratory; phosphatidic acid/PLD and focal-adhesion routes are the alternatives [241,683]." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:c45958e3b861f7db" />
        </attvalues>
      </edge>
      <edge source="RESISTANCE_EXERCISE" target="MTORC1" id="42">
        <attvalues>
          <attvalue for="6" value="RESISTANCE_EXERCISE" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Resistance exercise and mechanical overload activate mTORC1 in skeletal muscle, and rapamycin blocks the contraction-induced rise in human muscle protein synthesis. The proximal mechanism involves a rise in phosphatidic acid together with membrane perturbation and focal-adhesion signalling, but the enzyme generating that phosphatidic acid is disputed, with early work implicating phospholipase D and later work diacylglycerol kinase zeta." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="149; 241; 683" />
          <attvalue for="14" value="skeletal muscle; resistance exercise" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The net activation of mTORC1 by loading is reproducible while the proximal lipid step is unsettled; opposite in sign to the endurance-exercise input to AMPK, so exercise modality determines the net effect." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:03004b2b9849f790" />
        </attvalues>
      </edge>
      <edge source="TNF" target="IKBKB" id="43">
        <attvalues>
          <attvalue for="6" value="TNF" />
          <attvalue for="7" value="IKBKB" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="TNF-alpha engagement of TNFR1 activates the IKK complex, including IKK-beta, through the receptor-proximal adaptors TRADD, TRAF2 and TAK1; the relationship is indirect rather than a direct contact between TNF-alpha and IKK-beta." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="334" />
          <attvalue for="14" value="inflammation, tumour angiogenesis" />
