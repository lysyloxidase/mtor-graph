      <edge source="RAPAMYCIN" target="PHENO_SARCOPENIA" id="279">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_SARCOPENIA" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Chronic mTORC1 inhibition is predicted to impair the anabolic response of skeletal muscle and to promote sarcopenia; acute rapamycin blocks the contraction-induced rise in human muscle protein synthesis, whereas intermittent low-dose exposure has not produced measurable muscle loss and was associated with increased lean tissue mass in one randomised trial. Whether intermittent dosing preserves the acute anabolic response while lowering chronic tone is unresolved." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="149; 416" />
          <attvalue for="14" value="chronic dosing in older adults" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Human data conflict across exposures, and no trial has tested chronic dosing against a muscle-mass endpoint in older adults." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:deb3296b2ffe7aba" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_STOMATITIS" id="280">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_STOMATITIS" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Rapalog stomatitis follows from mTORC1 dependence of renewing oral epithelium and is substantially preventable with topical dexamethasone or tacrolimus prophylaxis." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="509" />
          <attvalue for="14" value="oncology and off-label use" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="The only self-reported adverse event significantly more frequent among off-label users." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:76ea687d433aedb2" />
        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_STOMATITIS" id="281">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_STOMATITIS" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Loss of mTORC1-dependent renewal in oral epithelium produces aphthous-type ulceration in roughly 30-60% of patients, the commonest dose-limiting rapalog toxicity in oncology." />
          <attvalue for="11" value="established" />
