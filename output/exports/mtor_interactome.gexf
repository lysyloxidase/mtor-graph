          <attvalue for="9" value="activates" />
          <attvalue for="10" value="p53 binds a PTEN promoter element and induces PTEN; higher PTEN lowers PIP3-AKT, relieving AKT inhibition of TSC2 and reducing mTORC1 as one arm of the coordinated p53-mTOR response." />
          <attvalue for="11" value="established" />
