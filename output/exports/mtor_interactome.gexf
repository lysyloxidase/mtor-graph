      <edge source="RAPAMYCIN" target="PHENO_HYPERGLYCAEMIA" id="269">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_HYPERGLYCAEMIA" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Hyperglycaemia at immunosuppressive exposures reflects hepatic, adipose and beta-cell physiology, chiefly through loss of mTORC2 signalling." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="281; 568" />
          <attvalue for="14" value="continuous high exposure" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Contrast RMC-5552, where hyperglycaemia occurred in only 4% despite complete mTORC1 blockade." />
          <attvalue for="17" value="tissue_physiology_disease" />
