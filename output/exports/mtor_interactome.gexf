      <edge source="SAPANISERTIB" target="AKT" id="322">
        <attvalues>
          <attvalue for="6" value="SAPANISERTIB" />
          <attvalue for="7" value="AKT" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="ATP-competitive mTOR inhibition regulates AKT biphasically. Catalytic blockade of mTORC2 abolishes Ser473 phosphorylation and suppresses AKT activity acutely; relief of S6K1-IRS-1 and Grb10 feedback then drives receptor tyrosine kinase-dependent PI3K signalling, so Thr308 phosphorylation and AKT activity rebound while Ser473 phosphorylation remains suppressed." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser473; Thr308" />
          <attvalue for="13" value="500" />
          <attvalue for="14" value="class effect of ATP-competitive mTOR inhibitors" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="The rebound is a principal reason why superior pathway suppression did not translate into clinical efficacy for this class." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="other:2b7fc90cd46e9631" />
        </attvalues>
      </edge>
      <edge source="SAPANISERTIB" target="EIF4EBP1" id="323">
        <attvalues>
          <attvalue for="6" value="SAPANISERTIB" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="ATP-competitive occupancy of the mTOR kinase cleft suppresses phosphorylation of all four principal 4E-BP1 sites, including Thr37 and Thr46, which allosteric rapalogs leave largely intact. Hypophosphorylated 4E-BP1 is the active form, so eIF4E is sequestered and cap-dependent translation of mRNAs with structured 5' untranslated regions is blocked." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser65; Thr37; Thr46; Thr70" />
          <attvalue for="13" value="166; 246; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Indirect activation of the translational repressor through reduced mTORC1-dependent phosphorylation; the drug does not directly activate 4E-BP1." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:ea63df52f7e34445" />
        </attvalues>
      </edge>
      <edge source="SAPANISERTIB" target="MTORC1" id="324">
        <attvalues>
          <attvalue for="6" value="SAPANISERTIB" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Occupying the ATP cleft blocks catalysis outright, suppressing all mTORC1 outputs including the rapamycin-resistant 4E-BP1 Thr37/Thr46 sites." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="112; 166; 189; 246; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:4599c8fd7cd4a9e1" />
        </attvalues>
      </edge>
      <edge source="SAPANISERTIB" target="MTORC2" id="325">
        <attvalues>
          <attvalue for="6" value="SAPANISERTIB" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Because the kinase cleft is identical in both complexes and is not occluded by Rictor or mSin1, ATP-competitive agents abolish mTORC2 output including AKT Ser473." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="112; 166; 189; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:ef22d7ec4a0289d3" />
        </attvalues>
      </edge>
      <edge source="SAPANISERTIB" target="PHENO_HYPERGLYCAEMIA" id="326">
        <attvalues>
          <attvalue for="6" value="SAPANISERTIB" />
          <attvalue for="7" value="PHENO_HYPERGLYCAEMIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Complete inhibition of both complexes adds mTORC2-dependent hyperglycaemia and insulin resistance to the rapalog toxicity profile, which is the toxicity ceiling that limited this generation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="325; 568" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Attribution of the glycaemic component to mTORC2 rests chiefly on reference [325]." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:b875523b4e4fb650" />
        </attvalues>
      </edge>
      <edge source="SAPANISERTIB" target="PHENO_INSULIN_RESISTANCE" id="327">
        <attvalues>
          <attvalue for="6" value="SAPANISERTIB" />
          <attvalue for="7" value="PHENO_INSULIN_RESISTANCE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Catalytic inhibition of mTORC2 removes AKT Ser473 phosphorylation in liver, adipose tissue and skeletal muscle. Reduced AKT output releases FOXO1-driven hepatic gluconeogenesis and impairs insulin-stimulated glucose uptake, so insulin resistance and hyperglycaemia are added to the metabolic profile of the allosteric agents." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="325; 568" />
          <attvalue for="14" value="mTORC2-attributable" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:b4547897ee615f2a" />
        </attvalues>
      </edge>
      <edge source="SAPANISERTIB" target="RPS6KB1" id="328">
        <attvalues>
          <attvalue for="6" value="SAPANISERTIB" />
          <attvalue for="7" value="RPS6KB1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="ATP-competitive inhibition of the mTOR catalytic site abolishes phosphorylation of S6K1 at the Thr389 hydrophobic motif completely, in contrast with the partial and substrate-selective suppression achieved by allosteric agents." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Thr389" />
          <attvalue for="13" value="166; 603" />
