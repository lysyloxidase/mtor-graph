      <edge source="TBC1D7" target="TSC_COMPLEX" id="601">
        <attvalues>
          <attvalue for="6" value="TBC1D7" />
          <attvalue for="7" value="TSC_COMPLEX" />
          <attvalue for="8" value="stabilisation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="TBC1D7 binding to the TSC1 coiled-coil stabilises the TSC1-TSC2 association that presents the Rheb-GAP domain; its depletion weakens that association and reduces Rheb-GAP activity, raising mTORC1 signalling, without lowering TSC2 levels or altering TSC2 localisation to the lysosome." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="143; 673" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="stabilisation:f57aa07c098cbc58" />
        </attvalues>
      </edge>
      <edge source="TPT1" target="RHEB" id="602">
        <attvalues>
          <attvalue for="6" value="TPT1" />
          <attvalue for="7" value="RHEB" />
          <attvalue for="8" value="gef_activity" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="TCTP was proposed as a Rheb guanine-nucleotide exchange factor in Drosophila; subsequent biochemical studies found no GEF activity." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="247; 491; 639" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Rheb's high intrinsic GTP loading makes a guanine-nucleotide exchange factor dispensable, and TSC2 GAP activity is treated as the sole regulator of its nucleotide state. Graded contested because the original Drosophila report is directly contradicted by later biochemistry." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="gef_activity:9c4ca7fad64fa8e3" />
        </attvalues>
