          <attvalue for="7" value="PHENO_T_CELL_SURVIVAL" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="mTORC2 phosphorylates AKT at Ser473 in activated T lymphocytes, supporting AKT-dependent survival signalling alongside Th2 differentiation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="134" />
          <attvalue for="14" value="T lymphocyte" />
          <attvalue for="15" value="downstream_of_mTORC2" />
