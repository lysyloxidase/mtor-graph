        <attvalues>
          <attvalue for="6" value="VAR_PTEN_LOF" />
          <attvalue for="7" value="PTEN" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="PTEN loss removes PIP3 hydrolysis and raises AKT activity; it is a frequent distal-network lesion in prostate, glioblastoma and endometrial cancer." />
