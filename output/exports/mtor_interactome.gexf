      <edge source="FAT_DOMAIN" target="KINASE_DOMAIN" id="708">
        <attvalues>
          <attvalue for="6" value="FAT_DOMAIN" />
          <attvalue for="7" value="KINASE_DOMAIN" />
          <attvalue for="8" value="autoinhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The FAT clamp holds the kinase domain in a partially closed, low-activity conformation by distorting the active site; hyperactivating cancer mutations cluster at this FAT-kinase interface and Rheb binding relieves the restraint." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="201; 670; 672" />
          <attvalue for="14" value="basal state" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="autoinhibition:26e30538776eaccf" />
        </attvalues>
      </edge>
      <edge source="FAT_DOMAIN" target="MTOR" id="709">
        <attvalues>
          <attvalue for="6" value="FAT_DOMAIN" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="The FAT (FRAP-ATM-TRRAP) alpha-helical domain wraps around the kinase domain and is a defining feature of the PIKK family." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="315; 588; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:86a0909159eaa13d" />
        </attvalues>
      </edge>
      <edge source="FRB_DOMAIN" target="KINASE_DOMAIN" id="710">
        <attvalues>
          <attvalue for="6" value="FRB_DOMAIN" />
          <attvalue for="7" value="KINASE_DOMAIN" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="FRB sits at the entrance of the deep catalytic cleft and acts as a gatekeeper: its rapamycin-binding surface contacts substrates and gives them access to the recessed active site. FKBP12-rapamycin bound at FRB therefore restricts substrate access without occupying the ATP site." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="588; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:609bc42183f8f41a" />
        </attvalues>
      </edge>
      <edge source="FRB_DOMAIN" target="MTOR" id="711">
        <attvalues>
          <attvalue for="6" value="FRB_DOMAIN" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="The ~100-residue four-helix FRB bundle lies between the FAT and kinase domains of the mTOR polypeptide and forms the drug-binding surface." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="98; 315; 588; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:9c8ce4819c6b6ea7" />
        </attvalues>
      </edge>
      <edge source="FRB_DOMAIN" target="MTOR" id="712">
        <attvalues>
          <attvalue for="6" value="FRB_DOMAIN" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="The four-helix FRB domain lies between the FAT and kinase domains, above the substrate cleft, which is why an occupant of this site obstructs substrate entry." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="315; 588; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="other:fd797d55d15c9d4f" />
        </attvalues>
      </edge>
      <edge source="HEAT_REPEATS" target="MTOR" id="713">
        <attvalues>
          <attvalue for="6" value="HEAT_REPEATS" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="The N-terminal HEAT repeats, arranged as N-HEAT (horn) and M-HEAT (bridge) segments, fold into an elongated alpha-solenoid. The solenoid contributes to the dimer interface and provides the docking surface for Raptor in mTORC1 and Rictor in mTORC2." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="14; 588; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="Domain-level decomposition of mTOR" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:521bf264a9eca6e5" />
        </attvalues>
      </edge>
      <edge source="KINASE_DOMAIN" target="MTOR" id="714">
        <attvalues>
          <attvalue for="6" value="KINASE_DOMAIN" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="PI3K-like catalytic domain carrying the ATP site in a deeply recessed cleft; it is the catalytic unit shared by mTORC1, mTORC2 and the putative mTORC3." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="315; 588; 670" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:717076bca7f5292f" />
        </attvalues>
      </edge>
      <edge source="MAPKAP1" target="AKT" id="715">
        <attvalues>
          <attvalue for="6" value="MAPKAP1" />
          <attvalue for="7" value="AKT" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="mTORC2 selects AKT by distal docking: the basic surface of the AKT kinase N-lobe engages an acidic loop of the mSin1 CRIM domain and the C-lobe a Rictor–mSin1 mooring ~75 Å from the active site; residues flanking Ser473 are dispensable, and prior engagement of pThr450 by the same N-lobe residues builds in a proofreading step." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
