        <attvalues>
          <attvalue for="6" value="DEPDC5" />
          <attvalue for="7" value="RAG_HETERODIMER" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="DEPDC5 binds GTP-loaded RagA with high affinity in an inhibitory mode that restrains, rather than stimulates, GATOR1-mediated GTP hydrolysis; catalysis is executed through weaker NPRL2-NPRL3 contacts, and the DEPDC5 mode is proposed to keep GATOR1 from becoming hyperactive." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="158; 555" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="DEPDC5 is the main Rag-binding subunit of GATOR1 but not its catalytic subunit; the role of the inhibitory binding mode in cells is still being defined." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:ef6cdf705e447ede" />
