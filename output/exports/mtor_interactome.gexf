      <edge source="OGT" target="LARS1" id="357">
        <attvalues>
          <attvalue for="6" value="OGT" />
          <attvalue for="7" value="LARS1" />
          <attvalue for="8" value="O_GlcNAcylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="OGT O-GlcNAcylates LARS1 at Ser1042 during glucose starvation, which blocks LARS1 binding to RagD and promotes ULK1 phosphorylation of its leucine-binding site, lowering leucine-induced mTORC1 activity." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="Ser1042" />
          <attvalue for="13" value="313" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="OGT knockdown or inhibition suppresses LARS1 O-GlcNAcylation; why glucose starvation increases this modification is unresolved. Reported by a single laboratory." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="O_GlcNAcylation:8b70fd2d35a28fe8" />
