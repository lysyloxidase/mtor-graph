          <attvalue for="7" value="DISEASE_TSC" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Everolimus is approved for TSC-associated SEGA, renal angiomyolipoma and refractory focal seizures on the basis of the EXIST programme; biallelic inactivation of a direct mTORC1 restraint in lesions driven by nothing else is the condition under which a rapalog does what its mechanism predicts." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="47; 175; 176; 319" />
          <attvalue for="14" value="tuberous sclerosis complex" />
