        <attvalues>
          <attvalue for="6" value="EIF4EBP1" />
          <attvalue for="7" value="EIF4F" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="4E-BP1 and eIF4G share the eIF4E-binding motif, so 4E-BP1 binding to eIF4E is mutually exclusive with eIF4G and blocks eIF4F assembly on the cap." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="374; 389; 572" />
          <attvalue for="14" value="" />
