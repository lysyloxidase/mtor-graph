          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="4E-BPs mediate mTORC1 control of proliferation but not cell size: 4E-BP1/2-null cells are resistant to the antiproliferative effect of mTORC1 inhibition." />
