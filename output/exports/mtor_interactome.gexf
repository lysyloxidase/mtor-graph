        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="4" />
          <attvalue for="3" value="PI3K-like catalytic domain of mTOR with a deeply recessed active-site cleft walled by the FRB domain, the LBE (mLST8-binding element) and the activation loop; the catalytic unit of both complexes." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="PIKK domain; catalytic domain" />
        </attvalues>
      </node>
