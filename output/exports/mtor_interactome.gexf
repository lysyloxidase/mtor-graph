          <attvalue for="7" value="GRB10" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="mTORC1 phosphorylation stabilises Grb10, an inhibitor of insulin and IGF-1 receptor signalling; drug-induced loss of that stabilisation removes a second brake on upstream flux." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="248; 687" />
          <attvalue for="14" value="" />
