          <attvalue for="1" value="core_complexes" />
          <attvalue for="2" value="3" />
          <attvalue for="3" value="Substoichiometric mTORC1 inhibitor carrying its own TOS motif; competes with substrates for the Raptor recognition surface. AKT phosphorylation at Thr246 releases it, giving feed-forward derepression by growth factors." />
          <attvalue for="4" value="AKT1S1" />
          <attvalue for="5" value="AKT1 substrate 1; proline-rich Akt substrate of 40 kDa" />
