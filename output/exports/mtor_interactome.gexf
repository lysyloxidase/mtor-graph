      <edge source="RICTOR" target="RPTOR" id="963">
        <attvalues>
          <attvalue for="6" value="RICTOR" />
          <attvalue for="7" value="RPTOR" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rictor, with mSin1, occupies a surface on the mTOR N-HEAT solenoid that overlaps the Raptor footprint, so Raptor and Rictor binding to mTOR are mutually exclusive and the two complexes partition a common mTOR pool." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="102; 525; 531" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
