      <edge source="DEPTOR" target="MTORC1" id="693">
        <attvalues>
          <attvalue for="6" value="DEPTOR" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="DEPTOR binding restrains mTORC1; its loss raises S6K1 and 4E-BP1 phosphorylation, and its overexpression in myeloma suppresses mTORC1 while relieving feedback onto PI3K-AKT." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="466" />
          <attvalue for="14" value="" />
