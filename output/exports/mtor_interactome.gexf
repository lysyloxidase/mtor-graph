          <attvalue for="6" value="MITOCHONDRIAL_COMPLEX_I" />
          <attvalue for="7" value="ATP" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Complex I oxidises NADH and pumps protons, sustaining the proton-motive force that ATP synthase uses, so complex I activity is required for maximal oxidative ATP production rather than converting a substrate into ATP. Biguanide inhibition of complex I therefore lowers ATP and raises AMP and ADP, the classical high-dose route to AMPK activation." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="235; 442" />
          <attvalue for="14" value="biguanide exposure" />
