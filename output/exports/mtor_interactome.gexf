      <edge source="MTORC2" target="PHENO_INSULIN_RESISTANCE" id="902">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="PHENO_INSULIN_RESISTANCE" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Chronic mTORC2 loss produces peripheral insulin resistance, which is distinct from direct beta-cell toxicity; the two together account for new-onset diabetes after transplantation at immunosuppressive exposures." />
