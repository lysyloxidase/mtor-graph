        </attvalues>
      </edge>
      <edge source="MTORC2" target="PHENO_CARDIOPROTECTION" id="937">
        <attvalues>
          <attvalue for="6" value="MTORC2" />
          <attvalue for="7" value="PHENO_CARDIOPROTECTION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Cardiomyocyte mTORC2 is cytoprotective in myocardial ischaemia through AKT-dependent anti-apoptotic signalling: loss of Rictor increases cardiomyocyte apoptosis and infarct damage, whereas shifting signalling from mTORC1 towards mTORC2 reduces it." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="631" />
          <attvalue for="14" value="cardiomyocyte, myocardial ischaemia" />
