        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="mtorc1_output_translation_ribosome" />
          <attvalue for="2" value="5" />
          <attvalue for="3" value="4E-BP paralogue predominant in brain; mTORC1 substrate sharing 4E-BP1 phosphosites; its loss enhances LTP yet produces autism-like behaviour via excess eIF4E-dependent translation." />
          <attvalue for="4" value="EIF4EBP2" />
          <attvalue for="5" value="" />
        </attvalues>
      </node>
      <node id="LARP1" label="LARP1">
        <attvalues>
          <attvalue for="0" value="protein" />
          <attvalue for="1" value="mtorc1_output_translation_ribosome" />
          <attvalue for="2" value="5" />
          <attvalue for="3" value="La-related protein 1; DM15 domain binds the m7G cap and adjacent 5'TOP motif when mTORC1 is inactive, excluding eIF4F; mTORC1 phosphorylation releases TOP mRNAs. Also binds Raptor and PABP and stabilises TOP mRNAs." />
