          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Germline heterozygous loss-of-function variant in the GATOR1 component DEPDC5; in an open-label case series the three patients with DEPDC5 truncating/LoF variants responded to everolimus, whereas a DEPDC5 missense variant responded less and the single NPRL3 patient worsened." />
          <attvalue for="4" value="DEPDC5" />
          <attvalue for="5" value="DEPDC5 FFEVF variants" />
        </attvalues>
      </node>
      <node id="VAR_MTOR_E1799K" label="MTOR E1799K">
        <attvalues>
          <attvalue for="0" value="gene_variant" />
          <attvalue for="1" value="tissue_physiology_disease" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Recurrent germline MTOR gain-of-function substitution accounting for roughly half of Smith–Kingsmore syndrome cases." />
          <attvalue for="4" value="MTOR" />
          <attvalue for="5" value="E1799K" />
        </attvalues>
      </node>
      <node id="VAR_MTOR_GOF" label="MTOR gain-of-function (somatic mosaic)">
