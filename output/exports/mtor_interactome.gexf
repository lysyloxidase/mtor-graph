          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Reduced energy intake lowers cellular energy charge and insulin, reported to increase AMPK activity in liver and muscle, converging with metformin and exercise on the AMPK-TSC2/Raptor brake on mTORC1." />
