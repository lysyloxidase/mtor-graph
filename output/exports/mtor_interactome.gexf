        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="PHENO_PROTEINURIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Podocytes require a calibrated level of mTORC1 activity: Raptor deletion in podocytes causes injury and proteinuria, while podocyte Tsc1 deletion causes proteinuric glomerulosclerosis, so both insufficient and excessive activity damage the filtration barrier." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="208; 264" />
          <attvalue for="14" value="kidney podocyte" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Both limbs matter clinically: mTOR inhibitors themselves can cause proteinuria, while podocyte mTORC1 activation drives the glomerular lesion of diabetic nephropathy in mice." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="physiological_output:340e83300586e9f7" />
        </attvalues>
      </edge>
