      <edge source="TORIN1" target="CAP_DEPENDENT_TRANSLATION" id="339">
        <attvalues>
          <attvalue for="6" value="TORIN1" />
          <attvalue for="7" value="CAP_DEPENDENT_TRANSLATION" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="ATP-competitive occupancy of the mTOR kinase cleft suppresses the rapamycin-resistant 4E-BP1 Thr37/Thr46 sites, so 4E-BP1 remains eIF4E-bound, eIF4F does not assemble, and cap-dependent initiation is blocked far more completely than with rapamycin." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="166; 603; 604" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:7ef509b96a5a4eb5" />
        </attvalues>
      </edge>
      <edge source="TORIN1" target="EIF4EBP1" id="340">
        <attvalues>
          <attvalue for="6" value="TORIN1" />
          <attvalue for="7" value="EIF4EBP1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="By occupying the ATP site of mTOR, Torin1 blocks phosphorylation of 4E-BP1 at all four sites, including the priming sites Thr37 and Thr46 that resist rapamycin, and cellular phosphatases then remove the existing phosphates. Hypophosphorylated 4E-BP1 sequesters eIF4E, so the activation of the repressor is indirect, through inhibition of the mTOR kinase." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser65; Thr37; Thr46; Thr70" />
          <attvalue for="13" value="166; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Complete suppression of 4E-BP1 phosphorylation requires catalytic-site rather than allosteric inhibition. Other ATP-competitive mTOR inhibitors act the same way, among them PP242, KU-0063794 and AZD8055; sapanisertib and vistusertib belong to the same class." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:bc3539a69fb8934d" />
        </attvalues>
      </edge>
      <edge source="TORIN1" target="RPS6KB1" id="341">
        <attvalues>
          <attvalue for="6" value="TORIN1" />
          <attvalue for="7" value="RPS6KB1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="ATP-competitive mTOR inhibition abolishes S6K1 Thr389 phosphorylation together with the rapamycin-resistant outputs of mTORC1, so mTORC1 signalling is suppressed completely rather than partially. The effect on S6K1 is indirect, through inhibition of the mTOR kinase." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Thr389" />
          <attvalue for="13" value="166; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:bad1a50a06da50f7" />
        </attvalues>
      </edge>
      <edge source="TORIN1" target="MTORC1" id="342">
        <attvalues>
          <attvalue for="6" value="TORIN1" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Torin1 inhibits mTORC1 catalysis directly at the ATP site and was the tool compound that revealed rapamycin-resistant mTORC1 functions." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="603" />
          <attvalue for="14" value="tool compound" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:67b5b13b2db24fa5" />
        </attvalues>
      </edge>
      <edge source="TORIN1" target="MTORC2" id="343">
        <attvalues>
          <attvalue for="6" value="TORIN1" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Torin1 blocks mTORC2 as well, abolishing AKT Ser473 phosphorylation, and is used experimentally to separate complex-selective from pan-mTOR effects." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="603" />
          <attvalue for="14" value="tool compound" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:209c082cced2c14d" />
        </attvalues>
      </edge>
      <edge source="TORIN2" target="MTOR" id="344">
        <attvalues>
          <attvalue for="6" value="TORIN2" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Torin2 occupies the mTOR ATP-binding cleft and inhibits both complexes, including the rapamycin-resistant 4E-BP1 sites. It is more potent and more orally bioavailable than Torin1 but also inhibits the related PIKK family members ATM, ATR and DNA-PK, so selectivity for mTOR is incomplete at higher concentrations." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="166; 358; 603" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Used as a laboratory tool compound rather than a clinical agent." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="competitive_inhibition:0bc29deeb3499ee5" />
        </attvalues>
      </edge>
      <edge source="VAR_FRB_RESISTANCE" target="FRB_DOMAIN" id="345">
        <attvalues>
          <attvalue for="6" value="VAR_FRB_RESISTANCE" />
          <attvalue for="7" value="FRB_DOMAIN" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Substitution of the critical serine contact in the FRB domain of human mTOR, Ser2035, abolishes docking of the FKBP12-rapamycin complex while leaving kinase activity intact. FRB substitutions selected under prolonged rapamycin exposure, Ala2034Val and Phe2108Leu, confer rapalog resistance by the same route, whereas the kinase-domain substitution Met2327Ile confers resistance to ATP-competitive inhibitors without preventing drug docking." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser2035" />
          <attvalue for="13" value="98; 365; 501" />
          <attvalue for="14" value="acquired and engineered rapamycin resistance" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Bivalent agents that engage the FRB and the ATP site together retain activity against these substitutions." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="genetic_loss_of_function:3453387e35fc20b2" />
        </attvalues>
      </edge>
      <edge source="VISTUSERTIB" target="MTOR" id="346">
        <attvalues>
          <attvalue for="6" value="VISTUSERTIB" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="competitive_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Vistusertib competes with ATP at the mTOR kinase cleft, inhibiting mTORC1 and mTORC2; it was selected from the AZD8055 series for improved pharmaceutical properties." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="112; 166; 473" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="competitive_inhibition:72cc908e959956b7" />
        </attvalues>
      </edge>
      <edge source="VISTUSERTIB" target="MTORC1" id="347">
        <attvalues>
          <attvalue for="6" value="VISTUSERTIB" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Vistusertib occupies the mTOR ATP cleft, which is common to both complexes, and therefore suppresses mTORC1 output completely, including the 4E-BP1 phosphorylation sites that allosteric agents leave only partly suppressed." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="112; 166; 473" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:8e8ec25c3c999b7f" />
        </attvalues>
      </edge>
      <edge source="VISTUSERTIB" target="MTORC2" id="348">
        <attvalues>
          <attvalue for="6" value="VISTUSERTIB" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Because the ATP site is shared by both complexes and is not occluded by Rictor or mSin1, vistusertib inhibits mTORC2 as completely as mTORC1, abolishing AKT Ser473 phosphorylation; this is the source of the added metabolic toxicity of the ATP-competitive class." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="112; 166; 473" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Site is the AKT readout of mTORC2 activity." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="drug_inhibition:c932fc9e37074e77" />
        </attvalues>
      </edge>
      <edge source="VISTUSERTIB" target="PHENO_HYPERGLYCAEMIA" id="349">
        <attvalues>
          <attvalue for="6" value="VISTUSERTIB" />
          <attvalue for="7" value="PHENO_HYPERGLYCAEMIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Complete inhibition of mTORC2 by ATP-competitive agents produces hyperglycaemia through combined beta-cell dysfunction and peripheral insulin resistance, with mTORC2 contributing more than mTORC1; this metabolic ceiling limited clinical development of the class." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="325; 568" />
          <attvalue for="14" value="class-level attribution; vistusertib-specific incidence not reported" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Hyperglycaemia is reported across ATP-competitive mTOR inhibitors; no incidence specific to vistusertib is available." />
          <attvalue for="17" value="pharmacology" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="physiological_output:238f47870c8afa2a" />
        </attvalues>
      </edge>
