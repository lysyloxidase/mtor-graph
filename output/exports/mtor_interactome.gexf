          <attvalue for="7" value="IGF1R" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="The intrinsic tyrosine kinase activity of mTOR within mTORC2 has been reported to phosphorylate and activate the type I IGF receptor and the insulin receptor, constituting a feed-forward arm from mTORC2 back onto the receptor tier that would amplify PI3K-PIP3 input to mTORC2 itself." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="receptor tyrosine residues" />
          <attvalue for="13" value="678" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="Graded emerging: the claim that mTOR has tyrosine kinase activity is not independently replicated as widely as the serine/threonine activity and should not be presented as settled." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="phosphorylation:ace1d285860e236d" />
        </attvalues>
