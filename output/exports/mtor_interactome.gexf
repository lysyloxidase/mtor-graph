        </attvalues>
      </edge>
      <edge source="RAPAMYCIN" target="PHENO_PROTEINURIA" id="278">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="PHENO_PROTEINURIA" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Podocytes require mTORC1 for maintenance and autophagic flux, so inhibition can produce proteinuria; urinalysis monitoring is the recommended surveillance." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="114; 208; 264" />
          <attvalue for="14" value="therapeutic exposures" />
