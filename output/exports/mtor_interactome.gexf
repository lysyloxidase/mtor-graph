      <edge source="RAPAMYCIN" target="SASP" id="284">
        <attvalues>
          <attvalue for="6" value="RAPAMYCIN" />
          <attvalue for="7" value="SASP" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Rapamycin suppresses the SASP without eliminating senescent cells, so a drug can give geroprotective benefit by attenuating consequences of a process it did not cause." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="232; 322" />
          <attvalue for="14" value="senescent cells" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Suppression of the SASP by rapamycin shows that an intervention is effective, which does not by itself establish causal primacy." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="-1" />
