      <edge source="GLUCOSE_DEPRIVATION" target="AMPK" id="69">
        <attvalues>
          <attvalue for="6" value="GLUCOSE_DEPRIVATION" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="sensing" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Withdrawal of glucose activates AMPK through LKB1-dependent phosphorylation of Thr172: the canonical route follows the fall in ATP and the rise in AMP and ADP, while a parallel route in which unoccupied aldolase senses the loss of fructose-1,6-bisphosphate has been reported to act before adenine nucleotide ratios change." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="517; 698" />
          <attvalue for="14" value="glucose starvation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The aldolase route is reported by a single laboratory, whereas activation of AMPK by glucose withdrawal itself is reproduced widely." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="sensing:7d0eb64b86700872" />
        </attvalues>
      </edge>
      <edge source="GLUCOSE_DEPRIVATION" target="MTORC1" id="70">
        <attvalues>
          <attvalue for="6" value="GLUCOSE_DEPRIVATION" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Glucose withdrawal suppresses mTORC1 even in AMPK-null cells, so an AMPK-independent arm operates in parallel with the LKB1-AMPK route; the proposed effectors, Rag-GTPase-dependent release of mTORC1 from the lysosome and hexokinase-II binding to Raptor, each rest on a single report." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="155; 496" />
          <attvalue for="14" value="AMPK-independent arm" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The existence of an AMPK-independent arm is well supported; the molecular identity of that arm is not." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:30b9314538d882f6" />
        </attvalues>
      </edge>
      <edge source="GLUCOSE_DEPRIVATION" target="RAG_HETERODIMER" id="71">
        <attvalues>
          <attvalue for="6" value="GLUCOSE_DEPRIVATION" />
          <attvalue for="7" value="RAG_HETERODIMER" />
          <attvalue for="8" value="sensing" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Glucose withdrawal shifts the Rag heterodimer to its inactive nucleotide state, releasing mTORC1 from the lysosomal surface; mice expressing GTP-locked RagA cannot execute this switch and die of neonatal glucose-starvation failure." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="155" />
          <attvalue for="14" value="glucose deprivation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The in vivo genetic evidence comes from mice expressing GTP-locked RagA, which cannot inactivate the heterodimer and die of neonatal starvation." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="sensing:77c8ec4da4d5b965" />
        </attvalues>
      </edge>
      <edge source="GLYCOGEN" target="PRKAB1" id="72">
        <attvalues>
          <attvalue for="6" value="GLYCOGEN" />
          <attvalue for="7" value="PRKAB1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The carbohydrate-binding module of the AMPK β-subunit binds glycogen, and branched glycogen with exposed α-1,6 branch points inhibits AMPK activity and Thr172 phosphorylation, so cellular carbohydrate reserves restrain the energy-stress arm independently of the AMP:ATP ratio." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="403" />
          <attvalue for="14" value="muscle and liver glycogen stores" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Glycogen reserves restrain AMPK independently of the AMP:ATP ratio, which is why glycogen depletion is a determinant of AMPK activation during exercise." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="binding:b7ed3b71bdc57417" />
        </attvalues>
      </edge>
      <edge source="HYPOXIA" target="AMPK" id="73">
        <attvalues>
          <attvalue for="6" value="HYPOXIA" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="sensing" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Limited oxidative phosphorylation lowers ATP and raises AMP/ADP, activating LKB1-AMPK, which phosphorylates TSC2 and Raptor; a REDD1-independent arm of hypoxic mTORC1 inhibition." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="357" />
          <attvalue for="14" value="hypoxia" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="the REDD1-TSC route acts without AMPK or LKB1. Mitochondrial ROS have also been proposed to activate AMPK in hypoxia independently of the AMP:ATP ratio." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="sensing:d700c193cc6e2d1d" />
        </attvalues>
      </edge>
      <edge source="HYPOXIA" target="DDIT4" id="74">
        <attvalues>
          <attvalue for="6" value="HYPOXIA" />
          <attvalue for="7" value="DDIT4" />
          <attvalue for="8" value="transcriptional_regulation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Hypoxia induces REDD1 (via HIF-1 and, under severe hypoxia/ER stress, ATF4); REDD1 is required for hypoxic mTORC1 inhibition, which is lost in REDD1-/- and TSC2-/- cells." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="58; 139" />
          <attvalue for="14" value="hypoxia" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="transcriptional_regulation:4865493c168022dc" />
        </attvalues>
      </edge>
      <edge source="HYPOXIA" target="EGLN1" id="75">
        <attvalues>
          <attvalue for="6" value="HYPOXIA" />
          <attvalue for="7" value="EGLN1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Falling O2 tension limits the prolyl-hydroxylase reaction, inactivating PHD2 and allowing HIF-1α to escape hydroxylation and degradation; this is the molecular basis of the HIF-1α stabilisation that drives REDD1 and BNIP3 induction." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="162; 293" />
          <attvalue for="14" value="hypoxia" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:71555f634fc53331" />
        </attvalues>
      </edge>
      <edge source="HYPOXIA" target="HIF1A" id="76">
        <attvalues>
          <attvalue for="6" value="HYPOXIA" />
          <attvalue for="7" value="HIF1A" />
          <attvalue for="8" value="stabilisation" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Low O2 blocks PHD-mediated prolyl hydroxylation of HIF-1alpha; VHL no longer binds, ubiquitination ceases and HIF-1alpha accumulates to drive hypoxia-responsive genes including DDIT4 and BNIP3." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Pro402; Pro564" />
          <attvalue for="13" value="266; 268" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="HIF-1alpha is itself a translational output of mTORC1, so hypoxic signalling through HIF-1alpha closes a feedback loop onto the pathway." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="stabilisation:da946ad3e70d8a9d" />
        </attvalues>
      </edge>
      <edge source="HYPOXIA" target="MTORC1" id="77">
        <attvalues>
          <attvalue for="6" value="HYPOXIA" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Hypoxia suppresses mTORC1 by two indirect routes: HIF-1alpha-dependent induction of REDD1 with consequent TSC activation, which proceeds without AMPK or LKB1, and, when hypoxia is severe enough to lower ATP, activation of AMPK." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="58; 139; 357" />
          <attvalue for="14" value="hypoxia" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="A summary of two indirect routes rather than a direct interaction." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="other:01a9b0f351730f85" />
        </attvalues>
      </edge>
      <edge source="OXIDATIVE_STRESS" target="AMPK" id="78">
        <attvalues>
          <attvalue for="6" value="OXIDATIVE_STRESS" />
          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="sensing" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="H2O2/mitochondrial ROS increase AMPK Thr172 phosphorylation; proposed direct oxidation of AMPK alpha Cys299/Cys304 versus indirect activation through ATP depletion and AMP/ADP rise." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="233; 707" />
          <attvalue for="14" value="oxidative stress" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Direct redox activation at AMPK alpha Cys299/Cys304 is disputed; the opposing account holds that mitochondria-derived reactive oxygen species act indirectly through the cellular energy state." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="sensing:131158f51f8c97fb" />
        </attvalues>
      </edge>
      <edge source="OXIDATIVE_STRESS" target="ATM" id="79">
        <attvalues>
          <attvalue for="6" value="OXIDATIVE_STRESS" />
          <attvalue for="7" value="ATM" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="H2O2 oxidises ATM Cys2991, forming disulfide-linked active dimers independently of DNA breaks and MRN; this cytoplasmic ATM pool drives the LKB1-AMPK-TSC2 response to ROS." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Cys2991" />
          <attvalue for="13" value="5; 205" />
          <attvalue for="14" value="oxidative stress" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:ad4f4e4f3b752213" />
        </attvalues>
      </edge>
      <edge source="OXIDATIVE_STRESS" target="TSC_COMPLEX" id="80">
        <attvalues>
          <attvalue for="6" value="OXIDATIVE_STRESS" />
          <attvalue for="7" value="TSC_COMPLEX" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="ROS act on a peroxisome-localised TSC1-TSC2 pool, activating TSC2 GAP activity to suppress Rheb-GTP and mTORC1 and to induce autophagy (pexophagy)." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="693" />
          <attvalue for="14" value="oxidative stress; peroxisome" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:471e5622d772a115" />
        </attvalues>
      </edge>
      <edge source="VAR_STRADA_LOF" target="DISEASE_PMSE" id="81">
        <attvalues>
          <attvalue for="6" value="VAR_STRADA_LOF" />
          <attvalue for="7" value="DISEASE_PMSE" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Autosomal recessive STRADA loss causes polyhydramnios, megalencephaly and symptomatic (intractable) epilepsy through impaired LKB1-AMPK signalling and mTORC1 hyperactivation; rapamycin reduces seizures." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="450; 480" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Rapamycin efficacy in PMSE rests on preclinical work together with small clinical studies." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:b91512278ea490b2" />
        </attvalues>
      </edge>
      <edge source="VAR_STRADA_LOF" target="DISEASE_PMSE" id="82">
        <attvalues>
          <attvalue for="6" value="VAR_STRADA_LOF" />
          <attvalue for="7" value="DISEASE_PMSE" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Autosomal recessive STRADA loss impairs LKB1-AMPK signalling and causes PMSE syndrome with megalencephaly and intractable epilepsy." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="450; 480" />
          <attvalue for="14" value="autosomal recessive" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Rapamycin supported by preclinical and small clinical evidence." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="genetic_loss_of_function:e1451ed0a08246e9" />
        </attvalues>
      </edge>
      <edge source="VAR_STRADA_LOF" target="LKB1_COMPLEX" id="83">
        <attvalues>
          <attvalue for="6" value="VAR_STRADA_LOF" />
          <attvalue for="7" value="LKB1_COMPLEX" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Biallelic STRADA loss removes the pseudokinase subunit required for LKB1 activity and cytoplasmic localisation, so the LKB1–STRADα–MO25 heterotrimer cannot assemble and LKB1–AMPK signalling is impaired." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="450; 480" />
          <attvalue for="14" value="PMSE syndrome" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Impaired LKB1-AMPK signalling is the complex-level consequence of losing the pseudokinase subunit." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="genetic_loss_of_function:6ff8433d7fb20c2d" />
        </attvalues>
      </edge>
      <edge source="VAR_STRADA_LOF" target="MTORC1" id="84">
        <attvalues>
          <attvalue for="6" value="VAR_STRADA_LOF" />
          <attvalue for="7" value="MTORC1" />
          <attvalue for="8" value="other" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Loss of LKB1-AMPK restraint in STRADA-null neurons produces constitutive mTORC1 hyperactivity, the shared mechanism of the mTORopathies; rapamycin rescues aberrant cortical lamination and heterotopia in STRADA-depleted preclinical models, and the human experience is a small open-label series reporting reduced seizure frequency." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="450; 480" />
          <attvalue for="14" value="PMSE syndrome; cortical neurons" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="Evidence for benefit in affected patients is preclinical together with a small uncontrolled series, not a controlled trial." />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="other:9634c1136c0246ad" />
        </attvalues>
      </edge>
      <edge source="VAR_STRADA_LOF" target="STRADA" id="85">
        <attvalues>
          <attvalue for="6" value="VAR_STRADA_LOF" />
          <attvalue for="7" value="STRADA" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Biallelic STRADA (LYK5) deletion removes the LKB1 pseudokinase activator; LKB1 is mislocalised/inactive, AMPK Thr172 phosphorylation falls and neuronal mTORC1 becomes hyperactive." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="450; 480" />
          <attvalue for="14" value="PMSE syndrome; neurons" />
          <attvalue for="15" value="pathophysiological" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="energy_stress_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="genetic_loss_of_function:3df04911ed5698e7" />
        </attvalues>
      </edge>
      <edge source="VAR_STRADA_LOF" target="STK11" id="86">
        <attvalues>
          <attvalue for="6" value="VAR_STRADA_LOF" />
          <attvalue for="7" value="STK11" />
          <attvalue for="8" value="genetic_loss_of_function" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="Biallelic STRADA loss impairs LKB1-AMPK signalling, removing energy-stress restraint of mTORC1 in PMSE syndrome." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="450; 480" />
