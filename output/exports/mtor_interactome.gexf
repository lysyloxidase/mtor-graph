          <attvalue for="6" value="PPP2CA" />
          <attvalue for="7" value="RRN3" />
          <attvalue for="8" value="dephosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="PP2A dephosphorylates the activating Ser44 site of TIF-IA/RRN3, reducing Pol I transcription; phosphatase inhibition attenuates rapamycin-induced Ser44 dephosphorylation." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="Ser44" />
          <attvalue for="13" value="400" />
          <attvalue for="14" value="mTOR inhibition by rapamycin" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="PP2A treatment inactivates TIF-IA in vitro, and calyculin A or okadaic acid prevents rapamycin-induced Ser44 dephosphorylation in cells. Because these inhibitors also act on PP1, PP2A is the most likely cellular phosphatase but not a proven one, and no phosphatase has been identified for Ser199." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="dephosphorylation:2c8ce22569c882dd" />
        </attvalues>
      </edge>
      <edge source="RPS6KB1" target="IRS1" id="1018">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="IRS1" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="S6K1 phosphorylates IRS-1 on inhibitory serines, uncoupling it from INSR/PI3K and promoting its degradation — blunting PI3K–AKT output (negative feedback)." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser1101; Ser307; Ser636; Ser639" />
          <attvalue for="13" value="222; 547; 608; 616" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="Sites are human IRS-1 numbering: Ser307 corresponds to mouse Ser302 and Ser636/Ser639 to rat Ser632/Ser635. Human Ser312 (mouse Ser307) is phosphorylated by JNK and IKK rather than by S6K1. This feedback explains the rebound AKT activation seen on acute mTORC1 inhibition [500]." />
          <attvalue for="17" value="growth_factor_input" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="phosphorylation:4eec79a2a322ec09" />
        </attvalues>
      </edge>
      <edge source="RPS6KB1" target="IRS1" id="1019">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="IRS1" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="S6K1 phosphorylates IRS-1 on inhibitory serines, promoting its degradation and blunting PI3K-AKT output from the insulin receptor." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser1101; Ser307; Ser636; Ser639" />
          <attvalue for="13" value="222; 608; 616" />
          <attvalue for="14" value="chronic insulin stimulation, obesity" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="Sites are human IRS-1 numbering; the primary reports use the mouse and rat equivalents Ser302 and Ser632/Ser635. Underlies mTORC1-associated insulin resistance and the paradoxical protection from steatosis seen after liver Tsc1 deletion." />
          <attvalue for="17" value="mtorc1_output_autophagy_metabolism_feedback" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="phosphorylation:95d8f70718953e77" />
        </attvalues>
      </edge>
      <edge source="RPS6KB1" target="DEPTOR" id="1020">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="DEPTOR" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="S6K1, together with RSK1, was reported to phosphorylate the DEPTOR betaTrCP degron (Ser286, Ser287, Ser291) after growth-factor stimulation, promoting SCF-betaTrCP-dependent DEPTOR degradation. Another laboratory found that S6K inhibition or knockdown does not change DEPTOR turnover and attributed degron phosphorylation to mTOR and CK1alpha." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="701" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="Opposing evidence: Gao et al. 2011, Mol Cell 44:290-303 (PMID 22017875)." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="phosphorylation:185b05a5c6d7d46e" />
        </attvalues>
      </edge>
      <edge source="RPS6KB1" target="MAPKAP1" id="1021">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="MAPKAP1" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="S6K1 phosphorylates mSin1 at Thr86 and Thr398, impairing mTORC2 complex integrity and suppressing downstream AKT signalling." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="Thr398; Thr86" />
          <attvalue for="13" value="359" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="Yang et al. 2015 (Cell Rep 12:937-943; PMID 26235620) reported that AKT-mediated phosphorylation of mSin1 Thr86 enhances mTORC2 activity, the opposite sign at the same residue." />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="phosphorylation:74a633b5c02df633" />
        </attvalues>
      </edge>
      <edge source="RPS6KB1" target="MAPKAP1" id="1022">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="MAPKAP1" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="S6K1-dependent mSin1 Thr86/Thr398 phosphorylation was reported to disrupt mTORC2 and reduce AKT Ser473 phosphorylation." />
          <attvalue for="11" value="contested" />
          <attvalue for="12" value="Thr398; Thr86" />
          <attvalue for="13" value="359" />
          <attvalue for="14" value="reported in tumour cell lines" />
          <attvalue for="15" value="feedback" />
          <attvalue for="16" value="Liu et al. reported negative regulation involving Thr86/Thr398; Yang et al. reported positive AKT-dependent regulation specifically at Thr86." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="-1" />
