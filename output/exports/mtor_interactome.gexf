          <attvalue for="7" value="SLC38A9" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="NPC1 associates with SLC38A9 and exports lysosomal cholesterol; loss of NPC1 traps cholesterol in the lumen and hyperactivates mTORC1 through this complex" />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="92" />
          <attvalue for="14" value="Niemann-Pick type C cells" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="The inhibitory sign reflects NPC1 removing the activating sterol; the cholesterol arm remains an emerging mechanism." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="binding:0e7fd0a0f7623b75" />
