        <attvalues>
          <attvalue for="6" value="RICTOR" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="complex_formation" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="Rictor is the defining subunit that distinguishes mTORC2 from mTORC1 and is raptor-independent." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="269; 455; 525; 531" />
