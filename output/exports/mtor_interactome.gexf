          <attvalue for="19" value="other:e7288a7fb751d099" />
        </attvalues>
      </edge>
      <edge source="CRIM_DOMAIN" target="AKT" id="701">
        <attvalues>
          <attvalue for="6" value="CRIM_DOMAIN" />
          <attvalue for="7" value="AKT" />
          <attvalue for="8" value="recruitment" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="The mSin1 CRIM domain is a ubiquitin-like fold whose acidic loop binds AGC-kinase substrates at a site distal to the catalytic cleft; the basic surface of the AKT kinase N-lobe engages this loop about 75 Å from the mTOR active site. CRIM-dependent recruitment also applies to SGK and PKC, although different AGC kinases differ in their sensitivity to perturbation of mSin1." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="74; 483; 596; 597" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC2" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="recruitment:5dd9431fc4de3cad" />
        </attvalues>
      </edge>
      <edge source="CRIM_DOMAIN" target="MAPKAP1" id="702">
        <attvalues>
          <attvalue for="6" value="CRIM_DOMAIN" />
          <attvalue for="7" value="MAPKAP1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="component_of" />
          <attvalue for="10" value="The CRIM domain is the central substrate-recruitment module of mSin1." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="74; 483" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="" />
          <attvalue for="17" value="core_complexes" />
          <attvalue for="18" value="0" />
          <attvalue for="19" value="binding:a1d95725b4993221" />
