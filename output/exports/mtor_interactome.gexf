          <attvalue for="3" value="Well-differentiated pancreatic, gastrointestinal and lung neuroendocrine tumours; a lineage dependency without a defined pathway lesion, treated with everolimus on RADIANT-3 and RADIANT-4." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="NET; gastrointestinal and lung NET; pNET; pancreatic NET" />
