          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="Intermittent dosing allows mTORC2 to recover between doses; preclinical data and low-exposure human cohorts without dysglycaemia support this but no powered trial has tested it." />
