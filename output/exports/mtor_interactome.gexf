      <edge source="RPS6KB1" target="PDK1" id="1032">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="PDK1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Phosphorylation of the S6K1 hydrophobic motif at Thr389 by mTORC1 creates a docking site for the PIF pocket of PDK1, which then phosphorylates the S6K1 activation loop at Thr229. The mTORC1 and PDK1 inputs to S6K1 are therefore sequential rather than independent." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Thr389" />
          <attvalue for="13" value="46; 179; 378; 481" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Thr389 lies in the hydrophobic motif of S6K1, the docking partner; PDK1 itself is not phosphorylated in this interaction." />
          <attvalue for="17" value="mtorc1_output_translation_ribosome" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="binding:ac46a78928e8fa2d" />
