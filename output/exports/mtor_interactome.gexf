          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Expression of interferon-stimulated antiviral genes rose in older adults given RTB101 with low-dose everolimus for six weeks in a 264-participant phase 2a trial, the arm in which infection rates over the following year were also lower." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="384" />
          <attvalue for="14" value="phase 2a; 264 older adults; six weeks of dosing" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Antiviral transcript changes are a biomarker, not proof of clinical benefit." />
          <attvalue for="17" value="tissue_physiology_disease" />
