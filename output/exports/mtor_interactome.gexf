          <attvalue for="14" value="liver, skeletal muscle, tumour cells" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Metformin also inhibits mTORC1 independently of AMPK, through the Rag GTPases and through p53-REDD1." />
