      <edge source="RNF152" target="RRAGA" id="513">
        <attvalues>
          <attvalue for="6" value="RNF152" />
          <attvalue for="7" value="RRAGA" />
          <attvalue for="8" value="ubiquitination" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="The lysosomal E3 ligase RNF152 attaches K63-linked ubiquitin chains to RagA in an amino-acid-sensitive manner, creating a docking site that recruits GATOR1 and so promotes RagA GTP hydrolysis and mTORC1 inactivation." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="Lys142; Lys220; Lys230; Lys244" />
          <attvalue for="13" value="135" />
          <attvalue for="14" value="amino-acid starvation" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Reported by a single laboratory (Deng 2015)." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
          <attvalue for="19" value="ubiquitination:1a0387b582f4a15e" />
