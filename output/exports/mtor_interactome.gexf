          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="Nanoparticle albumin-bound intravenous formulation of sirolimus, approved for advanced malignant perivascular epithelioid cell tumour on the AMPECT trial, where response was enriched in TSC2-mutant tumours." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="ABI-009; Fyarro; albumin-bound sirolimus" />
        </attvalues>
      </node>
