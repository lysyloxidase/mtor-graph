        <attvalues>
          <attvalue for="6" value="MTORC1" />
          <attvalue for="7" value="PHENO_TREG_EXPANSION" />
          <attvalue for="8" value="physiological_output" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="In naive mouse CD4 cells without exogenous TGF-beta, combined inhibition of mTORC1 and mTORC2 promotes Foxp3 induction while inhibition of either complex alone is insufficient; established regulatory T cells conversely require mTORC1 for their metabolic programme and suppressive function." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="133; 134; 690" />
          <attvalue for="14" value="de novo Treg differentiation in vitro; not mature Treg expansion" />
          <attvalue for="15" value="downstream_of_mTORC1" />
          <attvalue for="16" value="Differentiation, expansion and suppressive function are distinct endpoints; mature Tregs require mTORC1 for normal function." />
          <attvalue for="17" value="tissue_physiology_disease" />
