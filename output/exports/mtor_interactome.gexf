          <attvalue for="7" value="RPS6KB1" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="Raptor recognises the S6K1 TOR signalling motif, consensus Phe-Asp/Glu-Phi-Asp/Glu-Phi, and this binding is required for mTORC1 to phosphorylate the kinase." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
