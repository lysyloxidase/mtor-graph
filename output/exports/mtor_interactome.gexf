          <attvalue for="10" value="Sestrin1 binds leucine to a similar extent as Sestrin2, through the C-terminal pocket conserved between them, and leucine releases endogenous Sestrin1 from GATOR2." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="C-terminal leucine-binding pocket" />
          <attvalue for="13" value="655" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="upstream_of_mTORC1" />
          <attvalue for="16" value="Sestrin3 binds leucine very weakly and its GATOR2 binding is leucine-insensitive (Wolfson 2016)." />
          <attvalue for="17" value="lysosomal_nutrient_sensing" />
          <attvalue for="18" value="-1" />
