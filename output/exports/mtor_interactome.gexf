      <edge source="RPS6KB1" target="MTOR" id="1023">
        <attvalues>
          <attvalue for="6" value="RPS6KB1" />
          <attvalue for="7" value="MTOR" />
          <attvalue for="8" value="phosphorylation" />
          <attvalue for="9" value="modulates" />
          <attvalue for="10" value="S6K1 phosphorylates mTOR at Ser2448 in the negative regulatory domain; the site is a convenient activity marker but has no demonstrated effect on catalysis." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="Ser2448" />
          <attvalue for="13" value="106; 237" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="feedback" />
