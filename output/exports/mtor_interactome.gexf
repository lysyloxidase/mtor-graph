      <edge source="DEPTOR" target="MTORC2" id="696">
        <attvalues>
          <attvalue for="6" value="DEPTOR" />
          <attvalue for="7" value="MTORC2" />
          <attvalue for="8" value="binding" />
          <attvalue for="9" value="inhibits" />
          <attvalue for="10" value="DEPTOR binds mTORC2 and restrains its kinase activity, so DEPTOR loss increases phosphorylation of AKT Ser473 and SGK1. DEPTOR overexpression nevertheless activates AKT indirectly, by suppressing mTORC1 and relieving its feedback inhibition of PI3K." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="466" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
