      <edge source="RICTOR" target="AKT" id="956">
        <attvalues>
          <attvalue for="6" value="RICTOR" />
          <attvalue for="7" value="AKT" />
          <attvalue for="8" value="scaffolding" />
          <attvalue for="9" value="required_for" />
          <attvalue for="10" value="The AKT C-lobe engages an N-terminal mooring formed jointly by mSin1 and Rictor, completing the bipartite docking that positions Ser473 at the active site." />
          <attvalue for="11" value="emerging" />
          <attvalue for="12" value="N-terminal mooring (mSin1/Rictor)" />
          <attvalue for="13" value="597" />
          <attvalue for="14" value="" />
          <attvalue for="15" value="core" />
          <attvalue for="16" value="A docking surface remote from the catalytic cleft is in principle a druggable site for genuinely mTORC2-selective inhibitors, which do not presently exist. Rests on the single 2025 structural study [597]." />
          <attvalue for="17" value="mtorc2_regulation_and_outputs" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="scaffolding:a07575d65b53ead5" />
