          <attvalue for="7" value="AMPK" />
          <attvalue for="8" value="sensing" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Energy stress (rising AMP/ADP:ATP) activates AMPK through gamma-subunit nucleotide binding and LKB1-dependent Thr172 phosphorylation; AMPK then inhibits mTORC1 via TSC2 and Raptor." />
