          <attvalue for="7" value="PHENO_HYPERTRIGLYCERIDAEMIA" />
          <attvalue for="8" value="drug_inhibition" />
          <attvalue for="9" value="activates" />
          <attvalue for="10" value="Hypertriglyceridaemia and hypercholesterolaemia on mTOR inhibitors reflect altered hepatic and adipose lipid handling, with both complexes implicated." />
          <attvalue for="11" value="established" />
          <attvalue for="12" value="" />
          <attvalue for="13" value="444; 568" />
          <attvalue for="14" value="clinical, immunosuppressive and oncological exposures" />
          <attvalue for="15" value="pharmacological" />
          <attvalue for="16" value="Dyslipidaemia is the adipose and hepatic consequence of mTOR inhibition." />
          <attvalue for="17" value="tissue_physiology_disease" />
          <attvalue for="18" value="1" />
          <attvalue for="19" value="drug_inhibition:b2c08e84b99151f3" />
