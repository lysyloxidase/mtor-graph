          <attvalue for="1" value="pharmacology" />
          <attvalue for="2" value="0" />
          <attvalue for="3" value="ATP-competitive mTOR kinase inhibitor with activity against mTORC1 and mTORC2; evaluated in early-phase oncology studies." />
          <attvalue for="4" value="" />
          <attvalue for="5" value="OSI027" />
        </attvalues>
      </node>
